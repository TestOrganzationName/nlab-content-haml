                        %mo =
                        %mi 𝕊
                      %annotation{:encoding => "application/x-tex"} X = \mathbb{S}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo =
                      %annotation{:encoding => "application/x-tex"} E =
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/MU"} MU
                  = succeed "," do
                    %a.maruku-ref{:href => "#SecondPageOfEAdamsSpectralSequence"}
                  %a.maruku-ref{:href => "#ConvergenceOfEAdamsSpectralSequenceToECompletion"}
                  with example
                  = succeed "," do
                    %a.maruku-ref{:href => "#ExamplesOfEnilpotentLocalizations"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ext
                          %mrow
                            %msub
                              %mi MU
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi MU
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi MU
                          %mo *
                        %mo ,
                        %msub
                          %mi MU
                          %mo *
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ⇒
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝕊
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Ext_{MU_\ast(MU)}(MU_\ast, MU_\ast)
                        \\;\Rightarrow\;
                        \\pi_\bullet(\mathbb{S})
                        \\,.
                %p
                  This is the
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Adams-Novikov+spectral+sequence"} Adams-Novikov spectral sequence
          %h2#ClassicalAdamsSpectralSequence
            Classical Adams spectral sequence (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi H
                  %msub
                    %mi 𝔽
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E = H \mathbb{F}_2
            ,
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{S}
          %p
            We consider now the example of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msubsup
                    %mi E
                    %mi r
                    %mrow
                      %mi s
                      %mo ,
                      %mi t
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mi r
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{E_r^{s,t}(X,Y), d_r\}
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#AdamsEAdamsSpectralSequence"}
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo =
                      %mi H
                      %msub
                        %mi 𝔽
                        %mi p
                    %annotation{:encoding => "application/x-tex"} E = H \mathbb{F}_p
                is the
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
                (
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#OrthogonalEilenbergMacLaneRingSpectrum"}> def.
                ) with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Spectra)
                with its canonical struture of a
                %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
                induced (via
                = succeed ")" do
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidalStableHomotopyCategory"} this corollary
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+ring+spectrum"} orthogonal ring spectrum
                (from
                = succeed ");" do
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#OrthogonalEilenbergMacLaneRingSpectrum"} this def.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi Y
                      %mo =
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} X = Y = \mathbb{S}
                are both the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
          %p
            This example is called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
          %p
            The
            = succeed "-dual" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} H\mathbb{F}_p
            %a.maruku-ref{:href => "#HopfAlgebroidStructureOnDualEOperations"}
            turns out to be the classical dual
            %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒜
                    %mi p
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_p^\ast
            recalled
            %a{:href => "#TheClassicalDualSteenrodAlgebra"} below
            \.
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msub
                    %mi 𝔽
                    %mn 2
                %annotation{:encoding => "application/x-tex"} H \mathbb{F}_2
            satisfies the two assumptions needed to identify the second page of the
            = succeed "-Adams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} H\mathbb{F}_p
            = succeed ":" do
              %a.maruku-ref{:href => "#SecondPageOfEAdamsSpectralSequence"}
          #HFpSatisfiesConditionsForSecondPage.num_lemma
            %h6#lemma_16 Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} H\mathbb{F}_p
              is flat according to
              = succeed "," do
                %a.maruku-ref{:href => "#FlatE"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \mathbb{F}_p(\mathbb{S})
              is a
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi H
                      %msub
                        %mi 𝔽
                        %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(H \mathbb{F}_p)
          .proof
            %h6#proof_28 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} H \mathbb{F}_p
              is the
              %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
              itself, regarded as a graded commutative ring concentrated in degree 0 (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#StableHomotopyGroupsOfEMSpectrum"}> prop.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝔽
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(H\mathbb{F}_p)
                    \\simeq
                    \\mathbb{F}_p
                    \\,.
            %p
              Since this is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              over it are
              %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
              (
              %a{:href => "projective+module#ModuleOverAFieldIsProjective"}> prop.
              ), hence in particular
              %a.existingWikiWord{:href => "/nlab/show/flat+modules"} flat modules
              (
              %a{:href => "flat+module#ProjectiveModulesAreFlat"}> prop.
              ).
          #ClassicalAdamsSpectralSequenceEstablished.num_cor
            %h6#corollary_2 Corollary
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
              = succeed "-Adams" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed ")" do
                %a.maruku-ref{:href => "#AdamsEAdamsSpectralSequence"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} E = H \mathbb{F}_p
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#OrthogonalEilenbergMacLaneRingSpectrum"}> def.
              ) and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi Y
                      %mo =
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} X = Y = \mathbb{S}
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
              %a.existingWikiWord{:href => "/nlab/show/comodules"} comodules
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo ≃
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_p \simeq H\mathbb{F}_p(\mathbb{S})
              to itself, and converges completely (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EAdamsConvergingCompletely"}
              %a.existingWikiWord{:href => "/nlab/show/p-adic+completion"} p-adic completion
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdicCompletionOfAbelingGroups"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
              and in all other degrees to the
              = succeed "-primary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalTheoremOfFinitelyGeneratedAbelianGroups"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo ,
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ext
                      %mrow
                        %msubsup
                          %mi 𝒜
                          %mi p
                          %mo *
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_2^{s,t}(\mathbb{S},\mathbb{S})
                    \\;=\;
                    Ext^{s,t}_{\mathcal{A}_p^\ast}(\mathbb{F}_p, \mathbb{F}_p)
                    \\;\Rightarrow\;
                    (\pi_{\bullet}(\mathbb{S}))_p
                    \\,.
          .proof
            %h6#proof_29 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#HFpSatisfiesConditionsForSecondPage"}
              the conditions of theorem
              %a.maruku-ref{:href => "#SecondPageOfEAdamsSpectralSequence"}
              are satisfied, which implies the form of the second page.
            %p
              For the convergence statement, we check the assumptions in theorem
              = succeed ":" do
                %a.maruku-ref{:href => "#EAdamsConvergenceForCorepi0EBeingCyclicGroup"}
            %ol
              %li
                %p
                  By prop.
                  %a.maruku-ref{:href => "#FormingCoreOfARingIsIdempotent"}
                  and prop.
                  %a.maruku-ref{:href => "#ClassificationOfSolidRings"}
                  the ring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔽
                          %mi p
                        %mo =
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi H
                        %msub
                          %mi 𝔽
                          %mi p
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_p = \pi_0(H \mathbb{F}_p)
                  coincides with its
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/core+of+a+ring"} core
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %msub
                            %mi 𝔽
                            %mi p
                          %mo ≃
                          %msub
                            %mi 𝔽
                            %mi p
                        %annotation{:encoding => "application/x-tex"} c \mathbb{F}_p \simeq \mathbb{F}_p
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕊
                      %annotation{:encoding => "application/x-tex"} \mathbb{S}
                  is clearly a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective spectrum
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕊
                      %annotation{:encoding => "application/x-tex"} \mathbb{S}
                  is clearly a finite
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              %li
                %p
                  the groups
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝕊
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} [
                        %mi 𝕊
                        %mo ,
                        %mi 𝕊
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \pi_\bullet(\mathbb{S}) \simeq [\mathbb{S},\mathbb{S}]_\bullet
                  are degreewise finitely generated, by
                  = succeed "." do
                    %span.newWikiWord
                      Serre's finiteness theorem
                      %a{:href => "/nlab/new/Serre%27s+finiteness+theorem"} ?
            %p
              Hence theorem
              %a.maruku-ref{:href => "#EAdamsConvergenceForCorepi0EBeingCyclicGroup"}
              applies and gives the convergence as stated.
            %p
              Finally, by prop.
              %a.maruku-ref{:href => "#DualSteenrodAlgebrasIsHFpHopfAlgebra"}
              the dual
              = succeed "-Steenrod" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
          %p
            We now use the
            %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
            from corollary
            %a.maruku-ref{:href => "#ClassicalAdamsSpectralSequenceEstablished"}
            to compute the first dozen
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
          %h3#TheClassicalDualSteenrodAlgebra The dual Steenrod algebra
          #SteenrodAlgebraForHFp.num_defn
            %h6#definition_34 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
            %p
              The
              %strong
                mod
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒜
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}_{p}
              is the graded co-commutative
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
              which is
            %ul
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} p = 2
                  generated by elements denoted
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Sq
