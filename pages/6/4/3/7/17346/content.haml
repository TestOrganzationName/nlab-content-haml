              %a.maruku-ref{:href => "#ZpInfinity"}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mi lim
                      %mo ⟶
                    %mrow
                      %mo (
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
