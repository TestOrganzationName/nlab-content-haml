              be a left
              = succeed "-comodule." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the cobar complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet_\Gamma(N)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CobarComplex"}
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
