              such that it is an
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
              by itself of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
