                    %semantics
                      %mrow
                        %msub
                          %mi b
                          %mrow
                            %mi i
                            %mo ,
                            %mi n
                        %mo ≔
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi h
                          %mrow
                            %mi i
                            %mo ,
                            %mi n
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} b_{i,n} \coloneqq (h_{i,n})^2
            %p as well as the element
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
