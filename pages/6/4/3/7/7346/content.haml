                      %mo −
                      %mn 1
                      %mo }
                  %annotation{:encoding => "application/x-tex"} i \in \left\{ 0 , \dots , n-1 \right\}
              ”.)
          %p
          .proof
            %h6 Proof
            %p
              As for the first claim, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i \in n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭
                    %mo ∈
                    %mi supp
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathfrak{p} \in supp \left( M _ i \right) ,
              i.e., if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi i
                    %mo ⊗
                    %msub
                      %mi R
                      %mi 𝔭
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ≄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M _ i \otimes R _ { \mathfrak{p} } \ \,&amp;#x2244;\, \  0 ,
              then the elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∖
                    %mi 𝔭
                  %annotation{:encoding => "application/x-tex"} R \setminus \mathfrak{p}
              act nontrivially on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi i
                    %mo ⊗
                    %msub
                      %mi R
                      %mi 𝔭
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M _ i \otimes R _ { \mathfrak{p} } ,
              hence nontrivially on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi i
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M _ i ,
              hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ann
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mo ⊆
                    %mi 𝔭
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Ann \left( M _ i \right) \subseteq \mathfrak{p} .
              As for the second claim, recall that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo ⨂
                        %mrow
                          %mi i
                          %mo ∈
                          %mi n
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mo ⊗
                    %msub
                      %mi R
                      %mi 𝔭
                    %mo ≃
                    %munder
                      %mo ⨂
                      %mrow
                        %mi i
                        %mo ∈
                        %mi n
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mi i
                      %mo ⊗
                      %msub
                        %mi R
                        %mi 𝔭
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \left( \underset{ i \in n }{ \bigotimes } M _ i \right) \otimes R _ { \mathfrak{p} } \simeq \underset{ i \in n }{ \bigotimes } \left( M _ i \otimes R _ { \mathfrak{p} } \right) ,
              hence that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭
                    %mo ∈
                    %mi supp
                    %mrow
                      %mo (
                      %munder
                        %mo ⨂
                        %mrow
                          %mi i
                          %mo ∈
                          %mi n
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathfrak{p} \in supp \left( \underset{ i \in n }{ \bigotimes } M _ i \right) ,
              i.e., if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo ⨂
                        %mrow
                          %mi i
                          %mo ∈
                          %mi n
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mo ⊗
                    %msub
                      %mi R
                      %mi 𝔭
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ≄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \left( \underset{ i \in n }{ \bigotimes } M _ i \right) \otimes R _ { \mathfrak{p} } \ \,&amp;#x2244;\, \  0 ,
              then for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i \in n
              one must have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi i
                    %mo ⊗
                    %msub
                      %mi R
                      %mi 𝔭
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ≄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M _ i \otimes R _ { \mathfrak{p} } \ \,&amp;#x2244;\, \  0 ,
              i.e.,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭
                    %mo ∈
                    %mi supp
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mathfrak{p} \in supp \left( M _ i \right) .
          %p
            Our first, geometric incarnation of Nakayama’s lemma is just the assertion that if the modules in the statement of Prop.
            %a.maruku-ref{:href => "#GeneralNakayamaMotivation"}
            are finitely generated, then the inclusions in the same are equalities.
          %p
          #GeneralNakayamaLemma.num_prop
            %h6 Proposition
            %p
              %strong (“geometric Nakayama”)
              Given
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} R ,
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} n ,
              and
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
              of
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated"} finitely generated
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %msub
                          %mi M
                          %mi i
                        %mo )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi n
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \left( M _ i \right) _ { i \in n } ,
            %ol
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi n
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} i \in n ,
                  one has
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mrow
                          %mo (
                          %msub
                            %mi M
                            %mi i
                          %mo )
                        %mo =
                        %mi 𝒱
                        %mrow
                          %mo (
                          %mi Ann
                          %mrow
                            %mo (
                            %msub
                              %mi M
                              %mi i
                            %mo )
                          %mo )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} supp \left( M _ i \right) = \mathcal{V} \left( Ann \left( M _ i \right) \right) .
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mrow
                          %mo (
                          %munder
                            %mo ⨂
                            %mrow
                              %mi i
                              %mo ∈
                              %mi n
                          %msub
                            %mi M
                            %mi i
                          %mo )
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                          %mrow
                            %mi i
                            %mo ∈
                            %mi n
                        %mi supp
                        %mrow
                          %mo (
                          %msub
                            %mi M
                            %mi i
                          %mo )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} supp \left( \underset{ i \in n }{ \bigotimes } M _ i \right) = \bigcap _ { i \in n } supp \left( M _ i \right) .
            %p
              (Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              denotes the
              = succeed "," do
                %a{:href => "https://stacks.math.columbia.edu/tag/00DZ"} zero locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                  %annotation{:encoding => "application/x-tex"} supp
              denotes the
              = succeed "," do
                %a{:href => "https://stacks.math.columbia.edu/tag/00L1"} support
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ann
                  %annotation{:encoding => "application/x-tex"} Ann
              denotes the
              = succeed "." do
                %a{:href => "https://stacks.math.columbia.edu/tag/07T7"} annihilator
              %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} Von Neumann convention
              so that, e.g., the quantification “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i \in n
              ” is equivalent to “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mrow
                      %mo {
                      %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %mi n
                      %mo −
                      %mn 1
                      %mo }
                  %annotation{:encoding => "application/x-tex"} i \in \left\{ 0 , \dots , n-1 \right\}
              ”.)
          %p
            We give an “element-free” proof below. The two key ideas are that finitely-generated
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
          .proof
            %h6 Proof
            %p Recall the following seven basic facts (essentially two “induction principles”, three “interaction principles”, and two “base cases” of our “induction” up from cyclic modules):
            %ol
              %li
                %p
                  The middle term of a short exact sequence is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  iff its left and right terms are
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
              %li
                %p
                  The middle component of a morphism of short exact sequences is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  iff its left and right components are
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo .
                      %annotation{:encoding => "application/x-tex"} 0 .
              %li
                %p
                  Given prime
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔭
                        %mo ∈
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} \mathfrak{p} \in Spec (R) ,
                  the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ↦
                        %mi N
                        %mo ⊗
                        %msub
                          %mi R
                          %mi 𝔭
                      %annotation{:encoding => "application/x-tex"} N \mapsto N \otimes R _ { \mathfrak{p} }
                  is exact.
              %li
                %p
                  The (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  \-ary) functor of
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                            %mo (
                            %msub
                              %mi N
                              %mi i
                            %mo )
                          %mrow
                            %mi i
                            %mo ∈
                            %mi n
                        %mo ↦
                        %munder
                          %mo ⨂
                          %mrow
                            %mi i
                            %mo ∈
                            %mi n
                        %msub
                          %mi N
                          %mi i
                      %annotation{:encoding => "application/x-tex"} \left( N _ i \right) _ { i \in n } \mapsto \underset{ i \in n }{ \bigotimes } N _ i
                  is right exact in all arguments.
              %li
                %p
                  Given prime
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔭
                        %mo ∈
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{p} \in Spec (R)
                  and
                  = succeed "-tuple" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                            %mo (
                            %msub
                              %mi N
                              %mi i
                            %mo )
                          %mrow
                            %mi i
                            %mo ∈
                            %mi n
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} \left( N _ i \right) _ { i \in n } ,
                  one has
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %munder
                            %mo ⨂
                            %mrow
                              %mi i
                              %mo ∈
                              %mi n
                          %msub
                            %mi N
                            %mi i
                          %mo )
                        %mo ⊗
                        %msub
