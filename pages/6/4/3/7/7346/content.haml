                              %mi i
                              %mo ∈
                              %mi n
                          %msub
                            %mi M
                            %mi i
                          %mo )
                        %mo ⊗
                        %msub
                          %mi R
                          %mi 𝔭
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thinmathspace"}
                        %mi ≄
                        %mspace{:width => "thinmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mo .
                      %annotation{:encoding => "application/x-tex"} \left( \underset{ i \in n }{ \bigotimes } M _ i \right) \otimes R _ { \mathfrak{p} } \ \,&amp;#x2244;\, \  0 .
            %p
              Claims 1 and 2 of Prop.
              %a.maruku-ref{:href => "#GeneralNakayamaLemma"}
              are immediate from subarguments 2 and 3 and 2 and 4 above respectively.
          %p
            Prop.
            %a.maruku-ref{:href => "#GeneralNakayamaLemma"}
            immediately gives the following corollary, which we include for general interest:
          %p
          #SupportTensorIntersection.num_cor
            %h6 Corollary
            %p
              %strong (Bounds on the annihilator of a tensor product of finitely generated modules)
              Given commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} R ,
              natural
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} n ,
              and
              = succeed "-tuple" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %msub
                          %mi M
                          %mi i
                        %mo )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi n
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \left( M _ i \right) _ { i \in n } ,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi n
                    %mi Ann
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊆
                    %mspace{:width => "thickmathspace"}
                    %mi Ann
                    %mrow
                      %mo (
                      %munder
                        %mo ⨂
                        %mrow
                          %mi i
                          %mo ∈
                          %mi n
                      %msub
                        %mi M
                        %mi i
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊆
                    %mspace{:width => "thickmathspace"}
                    %mi rad
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ∈
                          %mi n
                      %mi Ann
                      %mrow
                        %mo (
                        %msub
                          %mi M
                          %mi i
                        %mo )
                      %mo )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \sum _ { i \in n } Ann \left( M _ i \right) \ \subseteq \ Ann \left( \underset{ i \in n }{ \bigotimes } M _ i \right) \ \subseteq \ rad \left( \sum _ { i \in n } Ann \left( M _ i \right) \right) .
            %p
              (Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ann
                  %annotation{:encoding => "application/x-tex"} Ann
              denotes the
              %a{:href => "https://stacks.math.columbia.edu/tag/07T7"} annihilator
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi rad
                  %annotation{:encoding => "application/x-tex"} rad
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/radical"} radical
              %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} Von Neumann convention
              so that, e.g., the quantification “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i \in n
              ” is equivalent to “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mrow
                      %mo {
                      %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %mi n
                      %mo −
                      %mn 1
                      %mo }
                  %annotation{:encoding => "application/x-tex"} i \in \left\{ 0 , \dots , n-1 \right\}
              ”.)
          %p
          .proof
            %h6 Proof
            %p
              The left inclusion follows from that each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ann
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mi i
                      %mo )
                  %annotation{:encoding => "application/x-tex"} Ann \left( M _ i \right)
              (manifestly) annihilates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⨂
                      %mrow
                        %mi i
                        %mo ∈
                        %mi n
                    %msub
                      %mi M
                      %mi i
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \underset{ i \in n }{ \bigotimes } M _ i .
              The right inclusion follows from that by claims 1 and 2 of Prop.
              %a.maruku-ref{:href => "#GeneralNakayamaLemma"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi 𝒱
                            %mrow
                              %mo (
                              %mi Ann
                              %mrow
                                %mo (
                                %munder
                                  %mo ⨂
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi n
                                %msub
                                  %mi M
                                  %mi i
                                %mo )
                              %mo )
                          %mtd
                            %mo =
                            %mi supp
                            %mrow
                              %mo (
                              %munder
                                %mo ⨂
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi n
                              %msub
                                %mi M
                                %mi i
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                              %mrow
                                %mi i
                                %mo ∈
                                %mi n
                            %mi supp
                            %mrow
                              %mo (
                              %msub
                                %mi M
                                %mi i
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                              %mrow
                                %mi i
                                %mo ∈
                                %mi n
                            %mi 𝒱
                            %mrow
                              %mo (
                              %mi Ann
                              %mrow
                                %mo (
                                %msub
                                  %mi M
                                  %mi i
                                %mo )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi 𝒱
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi n
                              %mi Ann
                              %mrow
                                %mo (
                                %msub
                                  %mi M
                                  %mi i
                                %mo )
                              %mo )
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{V} \left( Ann \left( \underset{ i \in n }{ \bigotimes } M _ i \right) \right)
                    \&amp; = supp \left( \underset{ i \in n }{ \bigotimes } M _ i \right) \\
                    \&amp; = \bigcap _ { i \in n } supp \left( M _ i \right) \\
                    \&amp; = \bigcap _ { i \in n } \mathcal{V} \left( Ann \left( M _ i \right) \right) \\
                    \&amp; = \mathcal{V} \left( \sum _ { i \in n } Ann \left( M _ i \right) \right) ,
                    \\end{aligned}
            %p
              hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi rad
                    %mrow
                      %mo (
                      %mi Ann
                      %mrow
                        %mo (
                        %munder
                          %mo ⨂
                          %mrow
                            %mi i
                            %mo ∈
                            %mi n
                        %msub
                          %mi M
                          %mi i
                        %mo )
                      %mo )
                    %mo =
                    %mi rad
                    %mrow
                      %mo (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ∈
                          %mi n
                      %mi Ann
                      %mrow
                        %mo (
                        %msub
                          %mi M
                          %mi i
                        %mo )
                      %mo )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    rad \left( Ann \left( \underset{ i \in n }{ \bigotimes } M _ i \right) \right)
                    \= rad \left( \sum _ { i \in n } Ann \left( M _ i \right) \right) .
          %p
            We now deduce more familiar forms of Nakayama’s lemma can as corollaries of the above. Sometimes, as for instance in the
            = succeed "," do
              %a{:href => "https://stacks.math.columbia.edu/tag/00DV"} Stacks Project
          %p
          #FirstSpecialVersion.num_cor
            %h6 Corollary
            %p
              %strong (Nakayama, version 1)
              Given commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} R ,
              finitely generated
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M ,
              and ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} I \subseteq R
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mi M
                    %mo =
                    %mi M
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} I M = M ,
              there exists element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f \in R
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f = 1 \ (mod \ I)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi M
                    %mo =
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} f M = 0 .
          .proof
            %h6 Proof
            %p
              From that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mi M
                    %mo =
                    %mi M
                  %annotation{:encoding => "application/x-tex"} I M = M
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊗
                    %mrow
                      %mo (
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mi I
                      %mo )
                    %mo ≃
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M \otimes \left( R / I \right) \simeq 0 ,
              i.e. that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mrow
                      %mo (
                      %mi M
                      %mo ⊗
                      %mrow
                        %mo (
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mi I
                        %mo )
                      %mo )
                    %mo =
                    %mi ∅
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} supp \left( M \otimes \left( R / I \right) \right) = \emptyset ,
              hence by claims 1 and 2 of Prop.
              %a.maruku-ref{:href => "#GeneralNakayamaLemma"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mrow
                      %mo (
                      %mi Ann
                      %mrow
                        %mo (
                        %mi M
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \mathcal{V} \left( Ann \left( M \right) \right)
              is disjoint from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mrow
                      %mo (
                      %mi I
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathcal{V} \left( I \right) ,
              i.e. that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ann
                    %mrow
                      %mo (
                      %mi M
                      %mo )
                  %annotation{:encoding => "application/x-tex"} Ann \left( M \right)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              are comaximal. The
              %a{:href => "https://stacks.math.columbia.edu/tag/00DT"} Chinese Remainder theorem
              then constructs the desired
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f \in R
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi mod
                    %mspace{:width => "thickmathspace"}
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f = 1\ (mod\ I)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi mod
                      %mspace{:width => "thickmathspace"}
                      %mi Ann
                      %mrow
                        %mo (
                        %mi M
                        %mo )
                      %mo )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} f = 0\ \left( mod\ Ann \left( M \right) \right) .
          %p Alternatively, Nakayama’s lemma is often understood as a means by which information about the fiber of a module at a point can be used to characterize that of its stalk at said point:
          %p
          #SecondSpecialVersion.num_cor
            %h6 Corollary
            %p
              %strong (Nakayama, version 2)
              Given
              %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              with maximal ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subseteq R
              and finitely generated
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M ,
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ≄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} M \ \,&amp;#x2244;\, \  0
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊗
                    %mrow
                      %mo (
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mi 𝔪
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ≄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} M \otimes \left( R / \mathfrak{m} \right) \ \,&amp;#x2244;\, \  0 .
          .proof
            %h6 Proof
            %p
              Observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ∈
                    %mi supp
                    %mrow
                      %mo (
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mi 𝔪
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \in supp \left( R / \mathfrak{m} \right) ,
              hence by claim 2 of Prop.
              %a.maruku-ref{:href => "#GeneralNakayamaLemma"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ∈
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \in supp (M)
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ∈
                    %mi supp
                    %mrow
                      %mo (
                      %mi M
                      %mo ⊗
                      %mrow
                        %mo (
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mi 𝔪
                        %mo )
                      %mo )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \in supp \left( M \otimes \left( R / \mathfrak{m} \right) \right) .
              Conclude by that an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ≄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \ \,&amp;#x2244;\, \  0
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              is in its support.
          %h2#examples_and_consequences Examples and consequences
          %p
            The finiteness hypotheses in the statements of Prop.
            %a.maruku-ref{:href => "#GeneralNakayamaLemma"}
            and Cor.
            %a.maruku-ref{:href => "#SupportTensorIntersection"}
            are necessary:
          %p
          #NoInfiniteNakayama.num_remark
            %h6 Example
            %p
              Viewing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q} / \mathbb{Z}
              as a
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mrow
                          %mo (
                          %mi ℚ
                          %mo{:stretchy => "false"} /
                          %mi ℤ
                          %mo )
                        %mo ⊊
                        %mi 𝒱
                        %mrow
                          %mo (
                          %mi Ann
                          %mrow
                            %mo (
                            %mi ℚ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo )
                          %mo )
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} supp \left( \mathbb{Q} / \mathbb{Z} \right) \subsetneq \mathcal{V} \left( Ann \left( \mathbb{Q} / \mathbb{Z} \right) \right) ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mrow
                          %mo (
                          %mrow
                            %mo (
                            %mi ℚ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo )
                          %mo ⊗
                          %mrow
                            %mo (
                            %mi ℚ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo )
                          %mo )
                        %mo ⊊
                        %mi supp
                        %mrow
                          %mo (
                          %mi ℚ
                          %mo{:stretchy => "false"} /
                          %mi ℤ
                          %mo )
                        %mo ∩
                        %mi supp
                        %mrow
                          %mo (
                          %mi ℚ
                          %mo{:stretchy => "false"} /
                          %mi ℤ
                          %mo )
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} supp \left( \left( \mathbb{Q} / \mathbb{Z} \right) \otimes \left( \mathbb{Q} / \mathbb{Z} \right) \right) \subsetneq supp \left( \mathbb{Q} / \mathbb{Z} \right) \cap supp \left( \mathbb{Q} / \mathbb{Z} \right) ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ann
                        %mrow
                          %mo (
                          %mrow
                            %mo (
                            %mi ℚ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo )
                          %mo ⊗
                          %mrow
                            %mo (
                            %mi ℚ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo )
                          %mo )
                        %mo ⊋
                        %mi rad
                        %mrow
                          %mo (
                          %mi Ann
                          %mrow
                            %mo (
                            %mi ℚ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo )
                          %mo +
                          %mi Ann
                          %mrow
                            %mo (
                            %mi ℚ
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo )
                          %mo )
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} Ann \left( \left( \mathbb{Q} / \mathbb{Z} \right) \otimes \left( \mathbb{Q} / \mathbb{Z} \right) \right) \supsetneq rad \left( Ann \left( \mathbb{Q} / \mathbb{Z} \right) + Ann \left( \mathbb{Q} / \mathbb{Z} \right) \right) ,
            %p
              contradicting claims 1 and 2 of Prop.
              %a.maruku-ref{:href => "#GeneralNakayamaLemma"}
              and Cor.
              %a.maruku-ref{:href => "#SupportTensorIntersection"}
              respectively sans the finiteness hypotheses.
          %p
            Likewise, the right inclusion in Cor.
            %a.maruku-ref{:href => "#SupportTensorIntersection"}
            can be tight even when the left one isn’t:
          %p
          #SupportTensorIntersectionTight.num_remark
            %h6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℤ
                    %mrow
                      %mo [
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %msub
                        %mi x
                        %mn 1
                      %mo ]
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} R = \mathbb{Z} \left[ x _ 0, x _ 1 \right] ,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 0
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M _ 0 = R / ( x _ 0 ) \oplus R / ( x _ 1 ) ,
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 1
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo −
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} M _ 1 = R / ( x _ 0 - x _ 1 ) .
              Then, viewing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} M _ 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} M _ 1
              as
              = succeed "-modules," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ann
                        %mrow
                          %mo (
                          %msub
                            %mi M
                            %mn 0
                          %mo )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} Ann \left( M _ 0 \right) = ( x _ 0 x_ 1 ) .
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ann
                        %mrow
                          %mo (
                          %msub
                            %mi M
                            %mn 1
                          %mo )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo −
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} Ann \left( M _ 1 \right) = ( x _ 0 - x _ 1 ) .
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ann
                        %mrow
                          %mo (
                          %msub
                            %mi M
                            %mn 0
                          %mo )
                        %mo +
                        %mi Ann
                        %mrow
                          %mo (
                          %msub
                            %mi M
                            %mn 1
                          %mo )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo −
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %msub
                          %mi x
                          %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo .
                      %annotation{:encoding => "application/x-tex"} Ann \left( M _ 0 \right) + Ann \left( M _ 1 \right) = ( x _ 0 - x _ 1 ) + ( x _ 0 , x_ 1 ) ^ 2 .
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi rad
                        %mrow
                          %mo (
                          %mi Ann
                          %mrow
                            %mo (
                            %msub
                              %mi M
                              %mn 0
                            %mo )
                          %mo +
                          %mi Ann
                          %mrow
                            %mo (
                            %msub
                              %mi M
                              %mn 1
                            %mo )
                          %mo )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} rad \left( Ann \left( M _ 0 \right) + Ann \left( M _ 1 \right) \right) = ( x _ 0 , x_ 1 ) .
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi M
                          %mn 0
                        %mo ⊗
                        %msub
                          %mi M
                          %mn 1
                        %mo ≃
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⊕
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} M _ 0 \otimes M _ 1 \simeq R / ( x _ 0 , x _ 1 ) \oplus R / ( x _ 0 , x _ 1 ) .
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ann
                        %mrow
                          %mo (
                          %msub
                            %mi M
                            %mn 0
                          %mo ⊗
                          %msub
                            %mi M
                            %mn 1
                          %mo )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo .
                      %annotation{:encoding => "application/x-tex"} Ann \left( M _ 0 \otimes M _ 1 \right) = ( x _ 0 , x_ 1 ) .
            %p In particular,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ann
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mn 0
                      %mo )
                    %mo +
                    %mi Ann
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mn 1
                      %mo )
                    %mo ⊊
                    %mi Ann
                    %mrow
                      %mo (
                      %msub
                        %mi M
                        %mn 0
                      %mo ⊗
                      %msub
                        %mi M
                        %mn 1
                      %mo )
                    %mo =
                    %mi rad
                    %mrow
                      %mo (
                      %mi Ann
                      %mrow
                        %mo (
                        %msub
                          %mi M
                          %mn 0
                        %mo )
                      %mo +
                      %mi Ann
                      %mrow
                        %mo (
                        %msub
                          %mi M
                          %mn 1
                        %mo )
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} Ann \left( M _ 0 \right) + Ann \left( M _ 1 \right) \subsetneq Ann \left( M _ 0 \otimes M _ 1 \right) = rad \left( Ann \left( M _ 0 \right) + Ann \left( M _ 1 \right) \right) ,
            %p exemplifying the claimed phenomenon.
          %p
            Cor.
            %a.maruku-ref{:href => "#SecondSpecialVersion"}
            has the following two notable consequences:
          %p
          #SpreadingEpicness.num_remark
            %h6 Example
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a local ring with maximal ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subseteq R
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} f \colon N \to M
              is an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mover
                      %mo →
                      %mi f
                    %mi M
                    %mover
                      %mo →
                      %mi p
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo →
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} N \stackrel{f}{\to} M \stackrel{p}{\to} M / N \to 0 .
            %p
              Tensoring with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} R / \mathfrak{m}
              is a right exact functor, so we have an exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi f
                        %mo ⊗
                        %msub
                          %mn 1
                          %mrow
                            %mi R
                            %mo{:stretchy => "false"} /
                            %mi 𝔪
                    %mi M
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi p
                        %mo ⊗
                        %msub
                          %mn 1
                          %mrow
                            %mi R
                            %mo{:stretchy => "false"} /
                            %mi 𝔪
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} N \otimes (R / \mathfrak{m}) \stackrel{f \otimes 1 _ { R / \mathfrak{m} }}{\to} M \otimes (R / \mathfrak{m}) \stackrel{p \otimes 1 _ { R / \mathfrak{m} }}{\to} (M / N) \otimes (R / \mathfrak{m}) \to 0 .
            %p
              Cor.
              %a.maruku-ref{:href => "#SecondSpecialVersion"}
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} M / N \simeq 0
              if(f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} (M / N) \otimes (R / \mathfrak{m}) \simeq 0 .
              Equivalently,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is epic if(f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⊗
                    %msub
                      %mn 1
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} f \otimes 1 _ { R / \mathfrak{m} }
              is epic. In particular, to check whether a finite set of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_{1}, \ldots, v_{n}
              generates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M ,
              it suffices to check whether the residue classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                    %mi 𝔪
                    %mi M
                  %annotation{:encoding => "application/x-tex"} v_i \mod \mathfrak{m} M
              generate the vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                    %mi M
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} M / \mathfrak{m} M ,
              which is a linear algebra calculation (as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} R / \mathfrak{m}
              is a field).
          %p
          #InverseFunctionTheorem.num_remark
            %h6 Example
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/Noetherian+ring"} Noetherian
              local ring with maximal ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ⊆
                    %mi R
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subseteq R .
              A typical example is the stalk at a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              of a Noetherian scheme as locally ringed space, and we will write as if we were in that situation. As
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is Noetherian,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              is finitely generated. Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi 𝔪
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi 𝔪
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \otimes (R / \mathfrak{m}) \cong \mathfrak{m} / \mathfrak{m}^2
              – the cotangent space – is a vector space of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo .
                  %annotation{:encoding => "application/x-tex"} n .
              We would like to know whether a collection of functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_1, \ldots, f_n
              that vanish at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              form a local coordinate system.
            %p
              For this, it suffices to check whether the differentials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi d
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} d f_1, \ldots, d f_n
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} ,
              belonging to the cotangent space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi 𝔪
                      %mn 2
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}/\mathfrak{m}^2 ,
              are linearly independent. (For then they span the cotangent space, and one concludes from Nakayama that the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              generate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              as an
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} .
          %p
            To cement this further, the following statement is offered in
            %a{:href => "#Harris"} Harris
            as a corollary of Nakayama’s lemma (corollary 14.10, page 179):
          %p
          #HarrisCorollary.num_prop
            %h6 Proposition
            %p
              %strong (Inverse Function Theorem)
              A map between complex projective varieties of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              which is a bijection and has injective derivative at every point is an isomorphism.
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stacks+Project"}> Stacks Project
                \:
                %a{:href => "https://stacks.math.columbia.edu/tag/07RC"} 07RC
            %li
              %p
                Wikipedia:
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Nakayama%27s_lemma"} Nakayama lemma
