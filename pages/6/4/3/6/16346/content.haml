                  \\,.
          #FromAdjunctionsToMonads.num_remark
            %h6#remark_8 Remark
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %munder
                        %mo ↪
                        %mi i
                      %mover
                        %mo ⟵
                        %mi L
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\stackrel{\overset{L}{\longleftarrow}}{\underset{i}{\hookrightarrow}}
                    \\mathbf{H}
            %p
              induces an
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ◯
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mo ∘
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\bigcirc \;\coloneqq\; i \circ L \;\colon\; \mathbf{H} \longrightarrow \mathbf{H}
            %p
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mo ◯
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon_X \;\colon\; X \longrightarrow \bigcirc X
            %p
              such that applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ◯
                  %annotation{:encoding => "application/x-tex"} \bigcirc
              again to that transformation it becomes an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              Dually, any
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %munder
                        %mo ⟵
                        %mi R
                      %mover
                        %mo ↪
                        %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\stackrel{\overset{i}{\hookrightarrow}}{\underset{R}{\longleftarrow}}
                    \\mathbf{H}
            %p
              induces an
              %a.existingWikiWord{:href => "/nlab/show/idempotent+comonad"} idempotent comonad
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mo ∘
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Box \;\coloneqq\; i \circ R \;\colon\; \mathbf{H} \longrightarrow \mathbf{H}
                    \\,.
            %p
              If moreover these two cases combine to an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mover
                        %mo ↪
                        %mo ⟵
                      %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\stackrel{\hookrightarrow}{\stackrel{\longleftarrow}{\hookrightarrow}}
                    \\mathbf{H}
            %p or of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mover
                        %mo ⟵
                        %mo ↪
                      %mo ⟵
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\stackrel{\longleftarrow}{\stackrel{\hookrightarrow}{\longleftarrow}}
                    \\mathbf{H}
            %p
              then these (co-)monads themselves are
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjoint
              to each other as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                    %mo ⊣
                    %mo ◯
                  %annotation{:encoding => "application/x-tex"}
                    \\Box \dashv \bigcirc
            %p or as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ◯
                    %mo ⊣
                    %mo □
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\bigcirc \dashv \Box
                    \\,,
            %p
              respectively, forming an “
              %a.existingWikiWord{:href => "/nlab/show/adjoint+cylinder"}> adjoint cylinder
              ”.
          %p Notice the following:
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The total composite labeled
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              in prop.
              %a.maruku-ref{:href => "#CoReflectionsOfToposes"}
              is indeed the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/locally+constant+sheaf"} locally constant sheaf
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SuperFormalSmooth
                      %mn 0
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} SuperFormalSmooth0Type
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be any object in image of this total functor, and let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %msub
                        %mi D
                        %mi s
                      %mo ∈
                      %mi CartSp
                      %mo ⋊
                      %mi SupeInfPoint
                    %annotation{:encoding => "application/x-tex"} U \times D_s \in CartSp \rtimes SupeInfPoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperFormalSmooth
                    %mn 0
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msub
                      %mi D
                      %mi s
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SuperFormalSmooth0Type(U\times D_s, X)
              is equivalently homs in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn 0
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} FormalSmooth0Type
              out of the dual of the Weil algebra which is the quotient of the original one by the ideal generated by its odd part. Hence this, in turn, is equivalently homs in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 0
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} Smooth0Type
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and that finally is equivalently homs in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              into the given set.
          #SystemOfModalities.num_cor
            %h6#corollary Corollary
            %p
              Passing, via remark
