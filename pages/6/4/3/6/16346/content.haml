            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modalities"} modalities
          #InfinitesimalDiskBundle.num_defn
            %h6#definition_9 Definition
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              %em infinitesimal disk bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi inf
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_{inf} X\to X
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
              of the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
              along itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mi inf
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T_{inf} X &amp;\stackrel{}{\longrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\longrightarrow&amp; \Im X
                    }
                    \\,.
            %p
              Given a point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo *
                      %mo →
                      %mi X
