                    %annotation{:encoding => "application/x-tex"} \mu(A)
          %p
            But an even closed
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
