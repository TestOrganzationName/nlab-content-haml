                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                  = succeed "." do
                    %em
                      %a{:href => "super+algebra#AdjointsToInclusionOfPlainAlgebra"} superalgebra – Adjoints to the inclusion of plain algebras
          #TheProcessOfModalities.num_prop
            %h6#proposition_2 Proposition
            %p
              Passing to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-categories of (∞,1)-sheaves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Kan+extension"} (∞,1)-Kan extension
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruples"} adjoint quadruples
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
