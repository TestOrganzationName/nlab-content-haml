              naturally act.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "spin+representation#Freed99"} Freed 99, page 48
          #BilinearPairingOnSpinors.num_remark
            %h6#remark_17 Remark
            %p
              The last column in prop.
              %a.maruku-ref{:href => "#RealSpinRepresentations"}
              implies that in each dimension there exists a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mo *
                    %mo ⊗
                    %msup
                      %mi S
                      %mo *
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma(-) \;\colon\; S^\ast \otimes S^\ast \longrightarrow \mathbb{R}^{d-1,1}
            %p which is
            %ol
              %li
                %p symmetric;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(V)
                  \-equivariant.
            %p
              This is what in the
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              literature is expressed in components by the Gamma matrices with “indices lowered” using the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
          .num_cor
            %h6#corollary_3 Corollary
            %p
              Given a real
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(\mathbb{R}^{d-1,1})
              representation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              structure on
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋊
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ⊕
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{so}(\mathbb{R}^{d-1,1})\rtimes\mathbb{R}^{d-1,1}
                    \\oplus N
            %p
              extending the
              %a.existingWikiWord{:href => "/nlab/show/Poincare+Lie+algebra"} Poincare Lie algebra
              whose odd-odd-bracket is the bilinear pairing of remark
              = succeed "." do
                %a.maruku-ref{:href => "#BilinearPairingOnSpinors"}
          #SuperPoincareAndSuperMinkowski.num_defn
            %h6#definition_24 Definition
            %p
              This is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℑ𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{Iso}(\mathbb{R}^{d-1,1|N})
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              to a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+group"} super Lie group
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+group"} super Poincaré group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Iso
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Iso(\mathbb{R}^{d-1,1|N})
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
              by the
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+Lie+algebra"} Lorentz Lie algebra
              is
              %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
              regarded as a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo ≔
                    %mi ℑ𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{d-1,1|N} \coloneqq \mathfrak{Iso}(\mathbb{R}^{d-1,1|N})/\mathfrak{so}(\mathbb{R}^{d-1,1|N})
                    \\,.
          .num_remark
            %h6#remark_18 Remark
            %p
              The space underlying the
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1|N}
              in def.
              %a.maruku-ref{:href => "#SuperPoincareAndSuperMinkowski"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo ,
                          %msub
                            %mi dim
                            %mi ℝ
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d,dim_{\mathbb{R}}(N)}
              = succeed "." do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
          %h4#GravitonAndGravitino Poincaré connections: Graviton and gravitino field
          %p
            We may now apply the general discussion of super Lie algebra valued super differential forms, def.
            = succeed "," do
              %a.maruku-ref{:href => "#SuperLieAlgValuedDiffForms"}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Poincare+Lie+algebra"} super Poincare Lie algebra
            = succeed "." do
              %a.maruku-ref{:href => "#SuperPoincareAndSuperMinkowski"}
          %p
            its
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi ℑ𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{Iso}(\mathbb{R}^{d-1,1|N}))
            is generated on
          %ul
            %li
              %p
                elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi e
                        %mi a
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{e^a\}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi ω
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\omega^{ a b}\}
                of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,even)
            %li
              %p
                and elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi ψ
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\psi^\alpha\}
                of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi odd
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,odd)
          %p with the differential defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi ω
                    %mrow
                      %mi a
                      %mi b
                  %mo =
                  %msup
                    %mi ω
                    %mi a
                  %msub
                    %mrow
                    %mi b
                  %mo ∧
                  %msup
                    %mi ω
                    %mrow
                      %mi b
                      %mi c
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} \, \omega^{a b} = \omega^a{}_b \wedge \omega^{b c}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi e
                    %mi a
                  %mo =
                  %msup
                    %mi ω
                    %mi a
                  %msub
                    %mrow
                    %mi b
                  %mo ∧
                  %msup
                    %mi e
                    %mi b
                  %mo +
                  %mfrac
                    %mi i
                    %mn 2
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %msup
                    %mi Γ
                    %mi a
                  %mi ψ
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} \, e^{a } = \omega^a{}_b \wedge e^b + \frac{i}{2}\bar \psi \Gamma^a \psi
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %mspace{:width => "thinmathspace"}
                  %mi ψ
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 4
                  %msup
                    %mi ω
                    %mrow
                      %mi a
                      %mi b
                  %msub
                    %mi Γ
                    %mrow
                      %mi a
                      %mi b
                  %mi ψ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} \, \psi = \frac{1}{4} \omega^{ a b} \Gamma_{a b} \psi
                  \\,.
          %p
            Accordingly its
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi ℑ𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{Iso}(\mathbb{R}^{d-1,1|N}))
            has these generators together with a further degree-shifted copy of each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t^a\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi r
                    %mrow
                      %mi a
                      %mi b
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{r^{a b}\}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi ρ
                    %mi α
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\rho^{\alpha}\}
            with differential given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi ω
                    %mrow
                      %mi a
                      %mi b
                  %mo =
                  %msup
                    %mi ω
                    %mi a
                  %msub
                    %mrow
                    %mi b
                  %mo ∧
                  %msup
                    %mi ω
                    %mrow
                      %mi b
                      %mi c
                  %mo +
                  %msup
                    %mi r
                    %mrow
                      %mi a
                      %mi b
                %annotation{:encoding => "application/x-tex"}
                  d_{W} \, \omega^{a b} = \omega^a{}_b \wedge \omega^{b c} + r^{a b}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi e
                    %mi a
                  %mo =
                  %msup
                    %mi ω
                    %mi a
                  %msub
                    %mrow
                    %mi b
                  %mo ∧
                  %msup
                    %mi e
                    %mi b
                  %mo +
                  %mfrac
                    %mi i
                    %mn 2
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %msup
                    %mi Γ
                    %mi a
                  %mi ψ
                  %mo +
                  %msup
                    %mi t
                    %mi a
                %annotation{:encoding => "application/x-tex"}
                  d_{W} \, e^{a } = \omega^a{}_b \wedge e^b + \frac{i}{2}\bar \psi \Gamma^a \psi + t^a
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %mspace{:width => "thinmathspace"}
                  %mi ψ
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 4
                  %msup
                    %mi ω
                    %mrow
                      %mi a
                      %mi b
                  %msub
                    %mi Γ
                    %mrow
                      %mi a
                      %mi b
                  %mi ψ
                  %mo +
                  %mi ρ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{W} \, \psi = \frac{1}{4} \omega^{ a b} \Gamma_{a b} \psi + \rho
                  \\,.
          %p
            Differential form data with values in this is a morphism of
            %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            from the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi ℑ𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{Iso}(\mathbb{R}^{d-1,1|N}))
            to the
            %a.existingWikiWord{:href => "/nlab/show/deRham+dg-algebra"} deRham dg-algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
            %a.maruku-ref{:href => "#SuperDeRhamComplex"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi ℑ𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(X)
                  \\leftarrow
                  W(\mathfrak{Iso}(\mathbb{R}^{d-1,1|N}))
                  \:
                  (A,F_A)
                  \\,.
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+valued+differential+form"} ∞-Lie algebroid valued differential form
            data with
            %a.existingWikiWord{:href => "/nlab/show/curvature"} ∞-Lie algebroid valued curvature
            that is explicitly given by:
          %ul
            %li
              %p connection forms / field configuration
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mi ℝ
                            %mrow
                              %mi d
                              %mo −
                              %mn 1
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} |
                              %mi N
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} E \in \Omega^1(X,\mathbb{R}^{d-1,1|N})
                    – the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
                    (part of the
                    = succeed ")" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
                        %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ω
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi 𝔰𝔬
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mi d
                              %mo −
                              %mn 1
                              %mo ,
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Omega \in \Omega^1(X, \mathfrak{so}(\mathbb{R}^{d-1,1}))
                    – the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/spin+connection"} spin connection
                    (part of the
                    = succeed ")" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
                        %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ψ
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi S
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Psi \in \Omega^ 1(X,S)
                    – the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
                    (the
                    %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                forms /
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                          %mo =
                          %mi d
                          %mi E
                          %mo +
                          %mi Ω
                          %mo ⋅
                          %mi E
                          %mo +
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi Ψ
                            %mo{:stretchy => "false"} ¯
                          %mo ∧
                          %mi Ψ
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mi ℝ
                            %mrow
                              %mi d
                              %mo −
                              %mn 1
                              %mo ,
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} T = d E + \Omega \cdot E + \Gamma(\bar \Psi \wedge \Psi) \in \Omega^2(X,\mathbb{R}^{d-1,1})
                    \- the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+metric+connection"} torsion
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo =
                          %mi d
                          %mi Ω
                          %mo +
                          %mo{:stretchy => "false"} [
                          %mi Ω
                          %mo ∧
                          %mi Ω
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi 𝔰𝔬
                          %mo{:stretchy => "false"} (
                          %mn 10
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} R = d \Omega + [\Omega \wedge \Omega] \in \Omega^2(X, \mathfrak{so}(10,1))
                    \- the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/Riemann+curvature"} Riemann curvature
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mo =
                          %mi d
                          %mi Ψ
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mi Ω
                          %mo ∧
                          %mi Ψ
                          %mo{:stretchy => "false"} )
                          %mo ∈
