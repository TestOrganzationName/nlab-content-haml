                      %mo ∧
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mi p
                      %mi Ψ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d} \left(
                    \\overline{\psi} \wedge \Gamma^{a_1 \cdots a_p} \psi
                    \\wedge e_{a_1} \wedge \cdots \wedge e_{a_p}
                    \\right)
                    \\propto
                    \\left(
