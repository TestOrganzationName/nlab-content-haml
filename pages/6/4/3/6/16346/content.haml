                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %a.maruku-ref{:href => "#VManifold"}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            Here we now consider a
            %a.existingWikiWord{:href => "/nlab/show/concrete+particular"} concrete particular
            choice for such a
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetimes"} super-Minkowski spacetimes
          %ol
            %li
              %p
                %em
                  %a{:href => "#DeRhamComplexOfSuperDifferentialForms"} Super differential forms
            %li
              %p
                %em
