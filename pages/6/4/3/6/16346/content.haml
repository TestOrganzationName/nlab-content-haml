                            %mi Ω
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi S
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \rho = d \Psi + (\Omega \wedge \Psi) \in \Omega^2(X, S)
                    – the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                      of the
                      %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
          %h4#CohomologyOfSuperMinkowskiSpacetime Cohomology of super-Minkowski spacetime
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            which in def.
            %a.maruku-ref{:href => "#CEAlgebra"}
            and def.
            %a.maruku-ref{:href => "#SuperLieAlgebraViaCE"}
            we used to
            %em characterize
            the corresponding (super) Lie algebras are of course traditionally introduced as the
            %a.existingWikiWord{:href => "/nlab/show/cochain+complexes"} cochain complexes
            whose
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
          #SiteCartSp.num_defn
            %h6#definition_25 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1|0}[n]
              for the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie (n+1)-algebra
              %a.existingWikiWord{:href => "/nlab/show/super+L-infinity+algebra"} super L-infinity algebra
              defined simply as the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              to the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z},\mathbb{Z}_2)
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mn 0
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mo =
                      %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathbb{R}^{1|0}[n]) \coloneqq
                    \\left(
                    \\wedge^\bullet \mathbb{R}^{1|0}[n],
                    \\;
                    d = 0
                    \\right)
            %p
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
              is freely generated from a single generator in degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n,even)
          #LieAlgebraCohomologAsHomomorphism.num_remark
            %h6#remark_19 Remark
            %p
              Recall that being a “
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"}> formal dual
              ” to a dg-algebra here simply means that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/super+L-infinity+algebras"} super L-infinity algebras
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \;\colon\; \mathfrak{g} \longrightarrow \mathbb{R}^{1|0}[n]
            %p
              are equivalently (by definition!) homomorphisms of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g})
                    \\longleftarrow
                    CE(\mathbb{R}^{1|0}[n])
                    \\,.
            %p
              Since the underlying graded algebra of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathbb{R}^{1|0}[n])
              is free on a single generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              in degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ↦
                    %mi μ
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c \mapsto \mu \in CE(\mathfrak{g})
                    \\,.
            %p
              Moreover, the condition that this map respects the differentials, and since the differential on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathbb{R}^{1|0}[n])
              vanishes by definition, this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %mo ↦
                          %mtd
                          %mtd
                          %mtd
                            %mi μ
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mrow
                                      %msup
                                        %mi ℝ
                                        %mrow
                                          %mn 1
                                          %mo{:stretchy => "false"} |
                                          %mn 0
                                      %mo{:stretchy => "false"} [
                                      %mi n
                                      %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mi 𝔤
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo ↦
                          %mtd
                            %mn 0
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mi d
                              %mi 𝔤
                            %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c &amp;\mapsto&amp; &amp;&amp; \mu
                    \\\
                    \\downarrow^{\mathrlap{d_{\mathbb{R}^{1|0}[n]}}}
                    \&amp;&amp; &amp;&amp;
                    \\downarrow^{\mathrlap{d_{\mathfrak{g}}}}
                    \\\
                    0 &amp;\mapsto&amp; 0 &amp;=&amp; d_{\mathfrak{g}}\mu
                    }
                    \\,.
            %p
              Hence such a moprhism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is equivalently a
              %em closed
              element of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} super Lie algebra cocycle
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %p
              This way
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie (n+1)-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1|0}[n]
              is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli object
              for degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
              Lie algebra cohomology in direct
              %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
              of how for instance the familiar
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℝ
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^{n+1}\mathbb{R} = K(\mathbb{Z},n+1)
              is the classifying space for degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          %p
            One advantange of conceptualizing Lie algebra cocycles as in remark
            %a.maruku-ref{:href => "#LieAlgebraCohomologAsHomomorphism"}
            is that it neatly connects to the formulation of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+forms"} Lie algebra valued forms
            according to def.
            = succeed "," do
              %a.maruku-ref{:href => "#LieAlgValuedFormsViaDgAlgHoms"}
            = succeed ":" do
              %a.maruku-ref{:href => "#SuperLieAlgValuedDiffForms"}
          .num_remark
            %h6#remark_20 Remark
            %p
              A
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mn 0
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1|0}[n]
              = succeed "-form:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ,
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi even
                        %mo ,
                        %mi closed
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1(\mathbb{R}^{p|q}, \mathbb{R}^{1|0}[n])
                    \\simeq
                    Hom(CE(\mathbb{R}^{1|0}[n]), \Omega^\bullet(\mathbb{R}^{p|q}))
                    \\simeq
                    \\Omega^{n+1}(\mathbb{R}^{p|q})_{even,closed}
                    \\,.
            %p
              Hence a super Lie algebra
              = succeed "-cocycle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              naturally determines a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi even
                        %mo ,
                        %mi closed
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(-)
                    \\colon
                    \\Omega^1(\mathbb{R}^{p|q},\mathfrak{g})
                    \\longrightarrow
                    \\Omega^{n+1}(\mathbb{R}^{p|q})_{even,closed}
            %p
              given by forming the composite with the morphism representing the cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} |
                          %mi q
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟵
                        %mi A
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ↦
                    %mrow
                      %mo (
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} |
                          %mi q
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟵
                        %mi A
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi μ
                            %mo *
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mn 0
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\Omega^\bullet(\mathbb{R}^{p|q})
                    \\stackrel{A}{\longleftarrow}
                    CE(\mathfrak{g})
                    \\right)
                    \\mapsto
                    \\left(
                    \\Omega^\bullet(\mathbb{R}^{p|q})
                    \\stackrel{A}{\longleftarrow}
                    CE(\mathfrak{g})
                    \\stackrel{\mu^\ast}{\longleftarrow}
                    CE(\mathbb{R}^{1|0}[n])
                    \\right)
            %p
              sending a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+form"} Lie algebra valued form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
