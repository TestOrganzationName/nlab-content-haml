                ,
                = succeed "," do
                  %em Spin 3/2 field and Cartan’s geometry
                %strong 2
                (1977) 43-47 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF00420670"}> doi:10.1007/BF00420670
                \&amp;rbrack;
            %li#Baaklini77b
              %p
