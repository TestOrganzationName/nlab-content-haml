            underlying the super translation group. Then the
            %a.existingWikiWord{:href => "/nlab/show/left-invariant+1-forms"} left invariant
            %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super-differential 1-forms
            are
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi ψ
                        %mi α
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi θ
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \psi^\alpha = \mathbf{d} \theta^\alpha
                \.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi a
                      %mo =
                      %mi d
                      %msup
                        %mi x
                        %mi a
                      %mo +
                      %mfrac
                        %mi i
                        %mn 2
                      %mover
                        %mi θ
                        %mo ¯
                      %msup
                        %mi Γ
                        %mi a
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} e^a = d x^a + \frac{i}{2} \overline{\theta} \Gamma^a \mathbf{d} \theta
                \.
          %p This means that there is one non-trivial differential on these:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi e
                            %mi a
                        %mtd
                          %mo =
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mi a
                          %mo +
                          %mfrac
                            %mi i
                            %mn 2
                          %mover
                            %mi θ
