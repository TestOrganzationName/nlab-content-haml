              ), the third is a further refinement given by supergeometry, which takes further “square roots” of all infinitesimal generators.
          .proof
            %h6#proof Proof
            %p
              All the sites are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+sites"} ∞-cohesive sites
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesive (infinity,1)-topos
              = succeed "," do
                %a{:href => "differential+cohesive+%28infinity%2C1%29-topos#PresentationOnInfinitesimalNeighbourhoodSites"} ∞-cohesive neighbourhood site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Gpd
                    %mo ↪
                    %mi SuperFormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth\infty Gpd\hookrightarrow SuperFormalSmooth\infty Grpd
              exhibits
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            %p
              With this the rightmost adjoint quadruple gives the
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℜ
                    %mo ⊣
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Re \dashv \Im
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                    %mo ⊣
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                  %annotation{:encoding => "application/x-tex"} \rightsquigarrow \dashv \R
              and the further opposition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇉
                      %mo ⊣
                      %mo ⇝
                    %annotation{:encoding => "application/x-tex"} \rightrightarrows \dashv \rightsquigarrow
          %p For convenience, from now on we notationally abbreviate:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
