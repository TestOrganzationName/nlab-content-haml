            %p
              Passing to the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triples"} adjoint triples
              of
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monads"} idempotent monads
              and
              %a.existingWikiWord{:href => "/nlab/show/idempotent+comonads"} idempotent comonads
              which this induces, then yields
            %ul
              %li
                %p
                  on the left the
                  %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∫
                        %annotation{:encoding => "application/x-tex"} \int
                  %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                      %annotation{:encoding => "application/x-tex"} \flat
                  and
                  %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
