                  \\mathfrak{Iso}(\mathbb{R}^{d-1,1})\oplus N
                  ,
                  [-,-]
                  \\right)
          %p
            that extends the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
