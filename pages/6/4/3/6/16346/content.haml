                      %mo{:stretchy => "false"} |
                      %msub
                        %mi q
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(\mathbb{R}^{p_1|q_1})
                  \\longleftarrow
                  C^\infty(\mathbb{R}^{p_2|q_2})
                  \\,.
          %p
            Notice then that from knowledge of an
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
            one obtains the corresponding
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            by the idea of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differentials"} Kähler differentials
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            is the
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            whose underlying
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi p
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℝ
                  %msup
                    %mo ∧
                    %mo •
                  %mo{:stretchy => "false"} ⟨
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi p
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(\mathbb{R}^p)
                  \=
                  C^\infty(\mathbb{R}^p) \otimes_{\mathbb{R}} \wedge^\bullet \langle \mathbf{d}x^1, \cdots, \mathbf{d}x^p\rangle
          %p
            and whose
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            is defined in degree-0 by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi f
                  %mo ≔
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi p
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi f
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d} f \coloneqq \sum_{i = 1}^p \frac{\partial f}{\partial x^i} \mathbf{d}x^i
          %p and extended from there to all degree by the graded Leibnitz rule.
          %p
            It is immediate to generalize this to the super-context, one just needs to be sure to apply the
            %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} sign rule
            throughout.
          #SuperDeRhamComplex.num_defn
            %h6#definition_18 Definition
            %p
              The de Rham complex of
              %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
              on a
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
              is the
              = succeed "-bigraded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z},\mathbb{Z}_2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} ⟨
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi p
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mi q
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(\mathbb{R}^{p|q})
                    \=
                    C^\infty(\mathbb{R}^{p|q})
                    \\otimes_{\mathbb{R}}
                    \\wedge^\bullet \langle
                    \\mathbf{d}x^1, \cdots, \mathbf{d}x^p,
                    \\;
                    \\mathbf{d}\theta^1, \cdots, \mathbf{d}\theta^q
                    \\rangle
            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is defined in degree-0 by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi f
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi p
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d} f \coloneqq \sum_{i = 1}^p \frac{\partial f}{\partial x^i} \mathbf{d}x^i
            %p and extended from there to all degree by the graded Leibnitz rule.
          .num_remark
            %h6#remark_14 Remark
            %p We may write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    (n,\sigma)\in \mathbb{Z} \times \mathbb{Z}_2
            %p for elements in this bigrading group.
            %p
              In this notation the grading of the elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
              is all induced by the fact that the de Rham differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}
              itself is a
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,even)
            %table
              %thead
                %tr
                  %th generator
                  %th bi-degree
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi x
                            %mi a
                        %annotation{:encoding => "application/x-tex"} x^a
                  %td{:style => "text-align: left;"} (0,even)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi θ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \theta^\alpha
                  %td{:style => "text-align: left;"} (0,odd)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}
                  %td{:style => "text-align: left;"} (1,even)
            %p Here the last line means that we have
            %table
              %thead
                %tr
                  %th generator
                  %th bi-degree
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi x
                            %mi a
                        %annotation{:encoding => "application/x-tex"} x^a
                  %td{:style => "text-align: left;"} (0,even)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi θ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \theta^\alpha
                  %td{:style => "text-align: left;"} (0,odd)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mi a
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}x^a
                  %td{:style => "text-align: left;"} (1,even)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi θ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}\theta^\alpha
                  %td{:style => "text-align: left;"} (1,odd)
            %p
              The formula for the “cohomologically- and super-graded commutativity” in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∧
                    %mi β
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mi α
                        %msub
                          %mi n
                          %mi β
                        %mo +
                        %msub
                          %mi σ
                          %mi α
                        %msub
                          %mi σ
                          %mi β
                    %mspace{:width => "thickmathspace"}
                    %mi β
                    %mo ∧
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha \wedge \beta
                    \=
                    \\;
                    (- 1)^{n_\alpha n_\beta + \sigma_\alpha \sigma_\beta}
                    \\;
                    \\beta \wedge \alpha
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ,
                    %mi β
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha,  \beta \in \Omega^\bullet(\mathbb{R}^{p|q})
              of homogeneous
              = succeed "-degree." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ×
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\times \mathbb{Z}_2
              %em two
              contributions to the sign picked up when exchanging two super-differential forms in the wedge product:
            %ol
              %li
                %p
                  there is a “cohomological sign” which for commuting a
                  = succeed "-forms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} n_1
                  = succeed "-form" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} n_2
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                              %msub
                                %mi n
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} (-1)^{n_1 n_2}
              %li
                %p
                  in addition there is a “super-grading” sich which for commuting a
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \sigma_1
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \sigma_2
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi σ
                                %mn 1
                              %msub
                                %mi σ
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} (-1)^{\sigma_1 \sigma_2}
          .num_example
            %h6#example_4 Example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    x^{a_1} (\mathbf{d}x^{a_2}) = + (\mathbf{d}x^{a_2}) x^{a_1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi θ
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi a
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi θ
                      %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\theta^\alpha (\mathbf{d}x^a) = + (\mathbf{d}x^a) \theta^\alpha
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\theta^{\alpha_1} (\mathbf{d}\theta^{\alpha_2})
                    \=
                    \- (\mathbf{d}\theta^{\alpha_2}) \theta^{\alpha_1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}x^{a_1}
                    \\wedge
                    \\mathbf{d} x^{a_2}
                    \=
                    \-
                    \\mathbf{d} x^{a_2}
                    \\wedge
                    \\mathbf{d} x^{a_1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi a
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mi α
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mi α
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}x^a
                    \\wedge
                    \\mathbf{d} \theta^{\alpha}
                    \=
                    \-
                    \\mathbf{d}\theta^{\alpha}
                    \\wedge
                    \\mathbf{d} x^a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 2
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi θ
                      %mrow
                        %msub
                          %mi α
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}\theta^{\alpha_1}
                    \\wedge
                    \\mathbf{d} \theta^{\alpha_2}
                    \=
                    +
                    \\mathbf{d}\theta^{\alpha_2}
                    \\wedge
                    \\mathbf{d} \theta^{\alpha_1}
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
            for further discussion, for literature, and for mentioning of
            %em another
            popular sign convention, which is different but in the end yields the same cohomology.
          %h4#SuperLieAlgebraValuedSuperDifferentialForms Super Lie algebra valued super differential forms
          %p
            We want to discuss the generalization of the concept of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+forms"} Lie algebra valued differential forms
            from ordinary
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            but further to
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          #CEAlgebra.num_defn
            %h6#definition_19 Definition
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              of a finite dimensional
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is the
              %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree
              graded-commutative
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              whose underlying graded algebra is the
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo =
                    %mi k
                    %mo ⊕
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ∧
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet \mathfrak{g}^*
                    
                    \=
                    k \oplus \mathfrak{g}^* \oplus (\mathfrak{g}^* \wedge \mathfrak{g}^* ) \oplus \cdots
            %p
              (with the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              and whose
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              (of degree +1) is on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              the dual of the Lie bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi 𝔤
                          %mo *
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo :
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo →
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ∧
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    d|_{\mathfrak{g}^*} := [-,-]^* : \mathfrak{g}^* \to \mathfrak{g}^* \wedge \mathfrak{g}^*
            %p
              extended uniquely as a graded
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^*
            %p
              That this differential indeed squares to 0,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∘
                      %mi d
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d \circ d = 0
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
          #CEAlgebraInTermsOfBasis.num_remark
            %h6#remark_15 Remark
            %p
              If in the situation of prop.
              %a.maruku-ref{:href => "#CEAlgebra"}
              we choose a dual basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t^a\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{C^a{}_{b c}\}
              be the structure constants of the Lie bracket in that basis, then the action of the differential on the basis generators is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msup
                      %mi t
                      %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mn 1
                      %mn 2
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msup
                      %mi t
                      %mi b
                    %mo ∧
                    %msup
                      %mi t
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    d t^a = - \frac{1}{2} C^a{}_{b c} t^b \wedge t^c
                    \\,,
            %p where here and in the following a sum over repeated indices is implicit.
          #CEIfFullyFaithful.num_prop
            %h6#proposition_10 Proposition
            %p
              The construction of Chevalley-Eilenberg algebras in def.
              %a.maruku-ref{:href => "#CEAlgebra"}
              yields a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi LieAlg
                    %mo ⟶
                    %msup
                      %mi dgAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    CE(-)
                    \\colon
                    LieAlg
                    \\longrightarrow
                    dgAlg^{op}
            %p
              embedding
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
              into
              %a.existingWikiWord{:href => "/nlab/show/formal+duals"} formal duals
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebras"} differential graded algebras
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semifree+dg-algebras"} semifree dg-algebras
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
              (forgetting the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              generated on a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
          #WeilForLInfinitityAlgebra.num_defn
            %h6#definition_20 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              is the
              %a.existingWikiWord{:href => "/nlab/show/semi-free+dga"} semi-free dga
              whose underlying graded-commutative algebra is the
              %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ⊕
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet (\mathfrak{g}^* \oplus \mathfrak{g}^*[1])
            %p
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              and a shifted copy of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is the sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mo +
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %annotation{:encoding => "application/x-tex"}
                    d_{W(\mathfrak{g})} = d_{CE(\mathfrak{g})} + \mathbf{d}
            %p
              of two graded
              %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
              of degree +1 defined by
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \mathbf{d}
                  acts by degree shift
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔤
                          %mo *
                        %mo →
                        %msup
                          %mi 𝔤
                          %mo *
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}^* \to \mathfrak{g}^*[1]
                  on elements in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔤
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
                  and by 0 on elements of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔤
                            %mo *
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*[1]
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{g})}
                  acts on unshifted elements in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔤
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
                  as the differential of the
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  and is extended uniquely to shifted generators by graded-commutattivity
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi d
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        [d_{CE(\mathfrak{g}}, \mathbf{d}] = 0
                %p
                  with
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                        %annotation{:encoding => "application/x-tex"} \mathbf{d}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                        %mi ω
                        %mo :
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                        %msub
                          %mi d
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mi ω
                      %annotation{:encoding => "application/x-tex"}
                        d_{CE(\mathfrak{g})} \mathbf{d} \omega :=
                        
                        \- \mathbf{d} d_{CE(\mathfrak{g})} \omega
                %p
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                          %mo ∈
                          %msup
                            %mo ∧
                            %mn 1
                          %msup
                            %mi 𝔤
                            %mo *
                        %annotation{:encoding => "application/x-tex"} \omega \in \wedge^1 \mathfrak{g}^*
          #LieAlgValuedFormsViaDgAlgHoms.num_prop
            %h6#proposition_11 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"} Lie algebra valued differential form
              on, say, a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(\mathbb{R}^p)
                    \\longleftarrow
                    W(\mathfrak{g})
                    \\colon
                    A
                    \\,,
            %p
              hence there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi p
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1(\mathbb{R}^p, \mathfrak{g})
                    \\simeq
                    Hom_{dgAlg}(W(\mathfrak{g}), \Omega^\bullet(\mathbb{R}^p))
                    \\,.
            %p
              The form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %em flat
              in that its
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                  %annotation{:encoding => "application/x-tex"} F_A
              vanishes, precisely if this morphism factors through the CE-algebra.
          .num_remark
            %h6#remark_16 Remark
            %p
              With a choice of basis as in remark
              = succeed "," do
                %a.maruku-ref{:href => "#CEAlgebraInTermsOfBasis"}
              %a.maruku-ref{:href => "#LieAlgValuedFormsViaDgAlgHoms"}
              is seen in components as follows:
            %p
              a dg-algebra homomorphism is first of all a homomorphism of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+algebras"} graded algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              is free as a graded algebra, such is entirely determined by what it does to the generators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi t
                              %mi a
                            %mo ,
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi A
                              %mi a
                          %mtd
                            %mo ∈
                            %msup
                              %mi Ω
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mi r
                              %mi a
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi F
                              %mi a
                          %mtd
                            %mo ∈
                            %msup
                              %mi Ω
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    t^a, &amp;\mapsto&amp; A^a &amp; \in \Omega^1(\mathbb{R}^n)
                    \\\
                    r^a &amp;\mapsto&amp; F^a &amp; \in \Omega^2(\mathbb{R}^n)
                    }
                    \\,.
            %p But being a dg-algebra homomorphism, this assignment needs to respect the differentials on both sides. For the original generators this gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi t
                              %mi a
                          %mtd
                            %mo ↦
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi A
                              %mi a
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mrow
                                      %mi W
                                      %mo{:stretchy => "false"} (
                                      %mi 𝔤
                                      %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi d
                                    %mi dR
                        %mtr
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mfrac
                              %mn 1
                              %mn 2
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msup
                              %mi t
                              %mi b
                            %mo ∧
                            %msup
                              %mi t
                              %mi c
                            %mo +
                            %msup
                              %mi r
                              %mi a
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mfrac
                              %mn 1
                              %mn 2
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msup
                              %mi A
                              %mi b
                            %mo ∧
                            %msup
                              %mi A
                              %mi c
                            %mo +
                            %msup
                              %mi F
                              %mi a
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                              %mi dR
                            %msup
                              %mi A
                              %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    t^a &amp;\mapsto&amp;&amp;&amp;  A^a
                    \\\
                    \\downarrow^{\mathrlap{d_{W(\mathfrak{g})}}} &amp;&amp;&amp;&amp; \downarrow^{\mathrlap{\mathbf{d}_{dR}}}
                    \\\
                    \- \frac{1}{2} C^a{}_{b c} t^b \wedge t^c
                    + r^a
                    \&amp;\mapsto&amp;
                    (- \frac{1}{2} C^a{}_{b c} A^b \wedge A^c + F^a)
                    \&amp;=&amp;
                    \\mathbf{d}_{dR} A^a
                    }
                    \\,.
            %p
              With this satisfied, then, by the very nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
          %p
            Now to pass this to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
          #SuperGrassmannAlgebra.num_defn
            %h6#definition_21 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mi V
                      %mi even
                    %mo ⊕
                    %msub
                      %mi V
                      %mi odd
                  %annotation{:encoding => "application/x-tex"} V = V_{even} \oplus V_{odd}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet V
              is the free
              = succeed "-bigraded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z},\mathbb{Z}_2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo ∧
                    %msub
                      %mi v
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                        %msub
                          %mi σ
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v_1 \wedge v_2 = (-1) (-1)^{\sigma_1 \sigma_2}
                    \\,.
          %p
            In the spirit of prop.
            %a.maruku-ref{:href => "#CEIfFullyFaithful"}
            we may then simply say that:
          #SuperLieAlgebraViaCE.num_defn
            %h6#definition_22 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              structure on a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of a
              = succeed "-bigraded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z},\mathbb{Z}_2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo (
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi V
                        %mo *
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) = \left(
                    \\wedge^\bullet V^\ast, \; d
                    \\right)
            %p
              (with differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              of degree (1,even)) such that the underlying graded algebra is the super Grassmann algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
              via def.
              = succeed "." do
                %a.maruku-ref{:href => "#SuperGrassmannAlgebra"}
            %p
              We call this again the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of the super Lie algebra dually defined thereby.
            %p
              Similarly, the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              is obtained from this by adding a generator in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,\sigma)
              for each previous generator in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,\sigma)
              and extending the differential as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#WeilForLInfinitityAlgebra"}
          %p Unwinding what this means, one finds that it is equivalent to the following more traditional definition:
          #SuperLieAlgebraTraditional.num_prop
            %h6#proposition_12 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              is equivalently
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                          %mo =
                          %msub
                            %mi 𝔤
                            %mi even
                          %mo ⊕
                          %msub
                            %mi 𝔤
                            %mi odd
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathfrak{g}_{even} \oplus \mathfrak{g}_{odd}
              %li
                %p equipped with a bilinear bracket
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo :
                        %mi 𝔤
                        %mo ⊗
                        %mi 𝔤
                        %mo →
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"}
                        [-,-] : \mathfrak{g}\otimes \mathfrak{g} \to \mathfrak{g}
                %p
                  which is
                  %em graded
                  skew-symmetric: it is skew symmetric on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔤
                          %mi even
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{even}
                  and
                  %em symmetric
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔤
                            %mi odd
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{odd}
              %li
                %p
                  that satisfied the
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                  %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                  in that for any three elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo ∈
                        %mi 𝕘
                      %annotation{:encoding => "application/x-tex"} x,y,z \in \mathbb{g}
                  of homogeneous super-degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi x
                        %mo ,
                        %msub
                          %mi σ
                          %mi y
                        %mo ,
                        %msub
                          %mi σ
                          %mi z
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_x,\sigma_y,\sigma_z)\in \mathbb{Z}_2
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mi x
                            %mo ⋅
                            %msub
                              %mi σ
                              %mi y
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [x, [y, z]] = [[x,y],z] + (-1)^{\sigma_x \cdot \sigma_y} [y, [x,z]]
                        \\,.
          %p
            But with def.
            %a.maruku-ref{:href => "#SuperLieAlgebraViaCE"}
            we immediately known, in view of prop.
            = succeed "," do
              %a.maruku-ref{:href => "#LieAlgValuedFormsViaDgAlgHoms"}
            %em super Lie algebra valued super differential forms
            should be:
          #SuperLieAlgValuedDiffForms.num_defn
            %h6#definition_23 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraViaCE"}
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
              is a
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z},\mathbb{Z}_2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(\mathbb{R}^{p|q})
                    \\longleftarrow
                    W(\mathfrak{g})
                    \\;\colon\;
                    A
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraViaCE"}
              = succeed "." do
                %a.maruku-ref{:href => "#SuperDeRhamComplex"}
            %p Accordingly we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1(\mathbb{R}^{p|q}, \mathfrak{g})
                    \\coloneqq
                    Hom_{dgAlg}(W(\mathfrak{g}), \Omega^\bullet(\mathbb{R}^{p|q}))
                    \\,.
          .num_example
            %h6#example_5 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \coloneqq \mathbb{R}^{1|0} = \mathbb{R}
              be the ordinary abelian
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/line+Lie+algebra"} line Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ,
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1(\mathbb{R}^{p|q}, \mathbb{R}^{1|0})
                    \\simeq
                    \\Omega^1(\mathbb{R}^{p|q})_{even}
            %p
              is the set of super-differential forms in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,even)
            %p
              Similarly with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathbb{R}^{0|1}
              the
              %a.existingWikiWord{:href => "/nlab/show/odd+line"} odd line
              regarded as an abelian super Lie algebra, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ,
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1(\mathbb{R}^{p|q}, \mathbb{R}^{0|1})
                    \\simeq
                    \\Omega^1(\mathbb{R}^{p|q})_{odd}
                    \\,.
            %p
              So generally for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              an ordinary Lie algebra regarded as a super Lie algebra, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1(\mathbb{R}^{p|q}, \mathfrak{g})
              is bigger than
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi p
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1(\mathbb{R}^p,\mathfrak{g})
            %p
              This is an issue to be dealt with when describing
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              in terms of Cartan fields on
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              manifold one cares about is just the
              %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic part
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi X
                        %mo ⇝
                    %annotation{:encoding => "application/x-tex"} \stackrel{\rightsquigarrow}{X}
              = succeed "." do
                %a{:href => "D%27Auria-Fre+formulation+of+supergravity#Rheonomy"} rheonomy
          %h4#SuperMinkowskiSpacetime Supersymmetry and Super-Minkowski spacetime
          %p
            We consider now very specific
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            = succeed "," do
