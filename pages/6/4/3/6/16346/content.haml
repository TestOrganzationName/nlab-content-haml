                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Stab_{GL(\mathbb{R}^{d-1,1|N})}([-,-], \phi)
                    \\simeq
                    Spin(d-1,1) \hookrightarrow GL(\mathbb{R}^{d-1,1|N})
                    \\,.
          %p
            This was highlighted by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/John+Huerta"} John Huerta
          .proof
            %h6#proof_5 Proof
            %p
              It is clear that the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              fixes the cocycle, and by the discussion at
              %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
              it preserves the bracket. Therefore it remains to be seen that the Spin group already exhausts the stabilizer group of bracket and cocycle. For that observe that the 3-cocycle is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\psi,\phi, v) \mapsto \eta( [\psi,\phi], v )
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta(-,-)
              is the given
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    [-,-]\colon S \otimes S\to V
            %p
              is surjective. This imples that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \in GL(\mathbb{R}^{d-1,1|N})
              preserves both the bracket and the cocycle for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \psi, \phi \in S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v \in V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi ψ
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta( [g(\psi),g(\phi)], g(v) )
                    \=
                    \\eta( g([\psi,\phi]), g(v) )
                    \=
                    \\eta( [\psi,\phi], v )
            %p
              then it preserves the Minkowski metric for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ,
                    %mi v
                  %annotation{:encoding => "application/x-tex"} w,v
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(g(w), g(v)) = \eta(w,v)
                    \\,.
          %p
            This means that for applications to
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            the inclusion of
            %a.existingWikiWord{:href => "/nlab/show/supergroups"} supergroups
            for the corresponding super Cartan geometry is not so much a choice made by hand, as rather being analogous to the
            %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-structure"} G₂-structure
            which is automatically imposed once one demands a differential form definite on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/associative+3-form"} associative 3-form
