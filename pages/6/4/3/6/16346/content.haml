            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p|q}
            depending on other field data may be understood as the
            %a.existingWikiWord{:href => "/nlab/show/WZW+term"} WZW term
            in a
            %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
            for the
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            of an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
