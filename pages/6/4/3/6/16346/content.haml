          .num_remark
            %h6#remark_21 Remark
            %p
              The term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi i
                      %mn 2
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
