                              %mi Y
                              %mo ,
                              %mi Z
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi Y
                                      %mi Z
                                    %mi I
                            %mtd
