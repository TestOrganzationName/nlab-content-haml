                              %mi Y
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mo
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi j
                                      %mrow
                                        %mo{:stretchy => "false"} [
                                        %mi X
                                        %mo ,
                                        %mi Y
                                        %mo{:stretchy => "false"} ]
                              %mo ↘
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi Y
                                      %mi Y
                                    %mi X
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\array{I &amp; \overset{j_Y}{\to} &amp; [Y,Y]\\
                      \&amp; _{\mathllap{j_{[X,Y]}}}\searrow &amp; \downarrow^{L^X_{Y Y}}\\
                      \&amp; &amp; [ [X,Y],[X,Y]]}
            %li
              %p
                The following diagram commutes for any
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X,Y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi X
                                      %mi Y
                                    %mi X
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi X
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mo
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi i
                                      %mrow
                                        %mo{:stretchy => "false"} [
                                        %mi X
                                        %mo ,
                                        %mi Y
                                        %mo{:stretchy => "false"} ]
                              %mo ↘
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mi j
                                    %mi X
