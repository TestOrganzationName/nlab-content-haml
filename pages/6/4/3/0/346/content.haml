                              %mo{:stretchy => "false"} [
                              %mi I
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi I
                              %mo ,
                              %mi Z
                              %mo{:stretchy => "false"} ]
