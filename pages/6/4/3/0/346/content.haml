                              %mo ,
                              %mi Z
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\array{[Y,Z] &amp; \overset{L^I_{Y Z}}{\to} &amp; [ [I,Y],[I,Z]]\\
                      \&amp; _{\mathllap{[1,i_Z]}}\searrow &amp; \downarrow^{[i_Y,1]}\\
                      \&amp; &amp; [Y,[I,Z]]}
            %li
              %p
                The following diagram commutes for any
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ,
                        %mi U
                        %mo ,
                        %mi V
                      %annotation{:encoding => "application/x-tex"} X,Y,U,V
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mi U
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi U
                                      %mi V
                                    %mi Y
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi Y
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi Y
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi U
                                      %mi V
                                    %mi X
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mn 1
                                  %mo ,
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi Y
                                      %mi V
                                    %mi X
                                  %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mi X
                                      %mo ,
                                      %mi U
                                      %mo{:stretchy => "false"} ]
                                      %mo ,
                                      %mo{:stretchy => "false"} [
                                      %mi X
                                      %mo ,
                                      %mi V
                                      %mo{:stretchy => "false"} ]
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mi X
                                      %mo ,
                                      %mi Y
                                      %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi Y
                                      %mi U
                                    %mi X
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} ]
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi Y
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\array{[U,V] &amp; \overset{L^Y_{U V}}{\to} &amp; [ [Y,U],[Y,V]]\\
                      ^{L^X_{U V}}\downarrow &amp;&amp; \\
                      [ [X,U],[X,V]] &amp; &amp;  \downarrow^{[1,L^X_{Y V}]} \\
                      ^{L^{[X,Y]}_{[X,U],[X,V]}}\downarrow &amp;&amp; \\
                      [ [ [X,Y],[X,U]],[ [X,Y],[X,V]]] &amp; \underset{[L^X_{Y U},1]}{\to} &amp; [ [Y,U],[ [X,Y],[X,V]]]}
            %li
              %p
                Finally, the map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma\colon C(X,Y) \to C(I,[X,Y])
                defined by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi j
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \mapsto [1,f](j_X)
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          %p
            Note that both a left-closed (non-symmetric) monoidal category and a right-closed (non-symmetric) monoidal category give rise to a closed category in this sense. See the discussion
            = succeed "." do
              %a{:href => "https://nforum.ncatlab.org/discussion/4632/closed-category/?Focus=66659#Comment_66659"} on the nForum
          %h3#the_eilenbergkelly_definition The Eilenberg-Kelly definition
          %p
            The above definition is the one used in
            %a{:href => "#LaPlaza77"} LaPlaza
            and
            = succeed "." do
              %a{:href => "#Manzyuk09"} Manzyuk
            = succeed "," do
              %a{:href => "#EK65"} Eilenberg &amp; Kelly 1965
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            but assumed an “underlying-set-functor”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U\colon C \to Set
            as part of the structure, with an axiom asserting that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U([X,Y]) = C(X,Y)
            (naturally, i.e. as a strict equality of functors
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo ×
                    %mi C
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} C^{op}\times C\to Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi U
                      %msub
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(X,X) = U([X,X]) \overset{U i_{[X,X]}}{\to} U([I,[X,X]]) = C(I,[X,X])
          %p
            sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi X
                %annotation{:encoding => "application/x-tex"} 1_X
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi X
                  %annotation{:encoding => "application/x-tex"} j_X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi X
                  %annotation{:encoding => "application/x-tex"} j_X
          %p
            The two are essentially equivalent, and the one given here is perhaps a little simpler, as well as obeying the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            %em isomorphic
            to one in the sense of
            = succeed "." do
              %a{:href => "#EK65"} Eilenberg &amp; Kelly 1965
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{C}(X,Y) \coloneqq C(I,[X,Y])
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(X) \coloneqq C(I,X)
            (note that this is different from
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{C}(I,X) = C(I,[I,X])
            %a{:href => "#Manzyuk09"} Manzyuk
            for the proof.
          %h3#omitting_units_prounital_closed_categories Omitting units: prounital closed categories
          %p
            The fact (discussed below) that closed categories, in the above sense, are equivalent to closed
            %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            with unit, suggests that there ought to be a version of closed categories that
            %em don’t
            necessarily have a unit object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "\u2018s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "\u2019s," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U:C\to Set
            corresponds to the nullary homsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo ;
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(;-)
            of a multicategory.
          %p
            A
            %strong prounital closed category
            is a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            together with the following data:
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo :
                        %msup
                          %mi C
                          %mi op
                        %mo ×
                        %mi C
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} [-,-] : C^{op} \times C \to C
                = succeed "-functor." do
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %li
              %p
                A functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo :
                        %mi C
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} U : C \to Set
            %li
              %p
                A transformation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi L
                          %mrow
                            %mi Y
                            %mi Z
                          %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} L^X_{Y Z} \colon  [Y,Z] \to [ [X,Y],[X,Z]]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                and extranatural in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                A transformation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ev
                        %mo :
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ev : U(X) \to C([X,Y], Y)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and extranatural in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
          %p which is required to satisfy the following axioms.
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U([X,Y]) = C(X,Y)
                strictly and naturally, i.e.
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∘
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U \circ [-,-] = C(-,-)
                as functors
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mi op
                        %mo ×
                        %mi C
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} C^{op}\times C\to Set
                %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
                by considering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo :
                      %mi C
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} U : C \to Set
                as a
                %a.existingWikiWord{:href => "/nlab/show/displayed+category"} displayed category
                over
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
            %li
              %p
                For any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in U(X)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f\in C(X,Y) = U([X,Y])
                we have
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ev
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(ev_x)(f) = U(f)(x)
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(Y)
            %li
              %p
                For any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} X,Y\in C
                we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi L
                          %mrow
                            %mi Y
                            %mi Y
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mn 1
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} U(L^X_{Y Y})(1_Y) = 1_{[X,Y]}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi L
                          %mrow
                            %mi Y
                            %mi Y
                          %mi X
                        %mo :
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} L^X_{Y Y} : [X,X] \to [ [X,Y],[X,Y]]
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi L
                          %mrow
                            %mi Y
                            %mi Y
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mn 1
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(L^X_{Y Y})(1_Y) : C(X,X) \to C([X,Y],[X,Y])
            %li
              %p
                For any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} X,Y\in C
                the composite
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo →
                        %mrow
                          %msubsup
                            %mi L
                            %mrow
                              %mi X
                              %mi Y
                            %mi X
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ev
                            %mrow
                              %msub
                                %mn 1
                                %mi X
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [X,Y] \xrightarrow{L^X_{X Y}} [ [X,X],[X,Y]] \xrightarrow{ev_{1_X}} [X,Y]
                is the identity.
            %li
              %p
                The following diagram commutes for any
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ,
                        %mi U
                        %mo ,
                        %mi V
                      %annotation{:encoding => "application/x-tex"} X,Y,U,V
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mi U
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi U
                                      %mi V
                                    %mi Y
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi Y
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi Y
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi U
                                      %mi V
                                    %mi X
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mn 1
                                  %mo ,
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi Y
                                      %mi V
                                    %mi X
                                  %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mi X
                                      %mo ,
                                      %mi U
                                      %mo{:stretchy => "false"} ]
                                      %mo ,
                                      %mo{:stretchy => "false"} [
                                      %mi X
                                      %mo ,
                                      %mi V
                                      %mo{:stretchy => "false"} ]
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mi X
                                      %mo ,
                                      %mi Y
                                      %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi Y
                                      %mi U
                                    %mi X
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} ]
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi Y
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\array{[U,V] &amp; \overset{L^Y_{U V}}{\to} &amp; [ [Y,U],[Y,V]]\\
                      ^{L^X_{U V}}\downarrow &amp;&amp; \\
                      [ [X,U],[X,V]] &amp; &amp;  \downarrow^{[1,L^X_{Y V}]} \\
                      ^{L^{[X,Y]}_{[X,U],[X,V]}}\downarrow &amp;&amp; \\
                      [ [ [X,Y],[X,U]],[ [X,Y],[X,V]]] &amp; \underset{[L^X_{Y U},1]}{\to} &amp; [ [Y,U],[ [X,Y],[X,V]]]}
            %li
              %p
                Some axiom(s) relating
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ev
                      %annotation{:encoding => "application/x-tex"} ev
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in U(X)
                the following diagram should commute:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mi Y
                              %mo ,
                              %mi Z
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msubsup
                                    %mi L
                                    %mrow
                                      %mi Y
                                      %mi Z
                                    %mi X
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Z
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mo
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mi ev
                                    %mi x
                                  %mo ,
                                  %mi Z
                                  %mo{:stretchy => "false"} ]
                              %mo ↘
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mo{:stretchy => "false"} [
                                  %mi X
                                  %mo ,
                                  %mi Y
                                  %mo{:stretchy => "false"} ]
                                  %mo ,
                                  %msub
                                    %mi ev
                                    %mi x
                                  %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mi Z
                              %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\array{ [Y,Z] &amp; \overset{L^X_{Y Z}}{\to} &amp; [ [X,Y],[X,Z]]\\
                      \&amp; _{[ev_x,Z]}\searrow &amp; \downarrow^{[ [X,Y],ev_x]} \\
                      \&amp;&amp; [ [X,Y],Z]}
          %p
            The third and fourth axioms, plus naturality of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                  %annotation{:encoding => "application/x-tex"} ev
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f:X\to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msubsup
                        %mi L
                        %mrow
                          %mi Y
                          %mi Z
                        %mi X
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi ev
                        %mi f
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [Y,Z] \xrightarrow{L^X_{Y Z}} [ [X,Y],[X,Z]] \xrightarrow{ev_f} [X,Z]
            equals the functorial action
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [f,Z]
          .standout
            %p I haven’t worked out exactly what axioms are required here.
          %h3#symmetric_and_cartesian_versions Symmetric and cartesian versions
          %p
            A
            %strong symmetric closed category
            is additionally equipped with natural isomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mi Z
                    %mrow
                      %mi X
                      %mi Y
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} C^{X Y}_Z : [X,[Y,Z]] \cong [Y,[X,Z]]
            satisfying appropriate axioms; see
            %a{:href => "#deSchipper75"} deSchipper75
            and
            = succeed "." do
              %a{:href => "#DayLaPlaza78"} DayLaPlaza78
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+multicategories"} symmetric multicategories
          %p
            Similarly, a “cartesian closed category” (there is an unfortunate terminological clash with
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi K
                    %mi Y
                    %mi X
                  %mo :
                  %mi Y
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} K^X_Y : Y\to [X,Y]
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi Y
                    %mi X
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} T^X_Y : [X,[X,Y]]\to [X,Y]
            satisfying appropriate axioms. They should correspond to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+multicategories"} cartesian multicategories
            %a.existingWikiWord{:href => "/nlab/show/combinatory+logic"} combinatory logic
            suggests that it should also be possible to axiomatize the cartesian case by replacing
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            with a single family of morphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mrow
                        %mi Y
                        %mi Z
                      %mi X
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} S^X_{Y Z} : [X,[Y,Z]]\to [ [X,Y],[X,Z]]
          .standout
            %p I don’t know of anywhere that the details are worked out for the cartesian case.
          %h2#examples Examples
          %ul
            %li
              %p
                Any
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                gives a closed category, by simply forgetting the tensor product and remembering only the internal-hom. Most examples seem to be of this sort (in fact, as discussed
                = succeed "," do
                  %a{:href => "#EmbedIntoCloseMon"} below
                %em every
                closed category arises as the full
                %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                of a closed monoidal category). However, as remarked above it, is often the case that the closed structure is “primary” and the tensor product is defined as a
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                to it (see below). For instance:
              %ul
                %li
                  %p
                    In the category
                    %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                    of
                    %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                    the internal-hom
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [X,Y]
                    is the set of group homomorphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo →
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X\to Y
                    with the pointwise addition, giving a closed category.
                %li
                  %p
                    More generally, for any
                    %a.existingWikiWord{:href => "/nlab/show/commutative+theory"} commutative theory
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi T
                          %annotation{:encoding => "application/x-tex"} T
                    = succeed "-algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi T
                          %annotation{:encoding => "application/x-tex"} T
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [X,Y]
                    that is the set of
                    = succeed "-algebra" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi T
                          %annotation{:encoding => "application/x-tex"} T
                    = succeed "-algebra" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi T
                          %annotation{:encoding => "application/x-tex"} T
                %li
                  %p
                    In the category
                    %a.existingWikiWord{:href => "/nlab/show/2Cat"} 2Cat
                    of
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [X,Y]
                    can be taken to be the category of strict 2-functors
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo →
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X\to Y
                    and
                    %a.existingWikiWord{:href => "/nlab/show/lax+natural+transformation"} pseudo, lax, or oplax natural transformations
                    between them, giving three closed categories.
                %li
                  %p
                    In the category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Unif
                        %annotation{:encoding => "application/x-tex"} Unif
                    of
                    %a.existingWikiWord{:href => "/nlab/show/uniform+spaces"} uniform spaces
                    the internal-hom
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [X,Y]
                    can be taken to be the set of uniformly continuous functions
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo →
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X\to Y
                    with either the uniformity of uniform convergence or of pointwise convergence, giving two closed categories.
              %p
                In all these examples there is a corresponding tensor product, but its construction is much less intuitive, being essentially defined by a sort of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
                or
                %a.existingWikiWord{:href => "/nlab/show/initial+lift"} initial lift
                that gives little information about what it actually looks like.
            %li
              %p
                Any
                %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
                which has a unit, i.e. an object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo ;
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ;
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(;Y) \cong C(I;Y)
                naturally, and is closed in the sense that for any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ,
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Y,Z
                there is an object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Y
                      %mo ,
                      %mi Z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [Y,Z]
                with natural isomorphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                        %mo ,
                        %mi Y
                        %mo ;
                        %mi Z
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %mi C
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                        %mo ;
                        %mo{:stretchy => "false"} [
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C(X_1,\dots,X_n,Y;Z) \cong C(X_1,\dots,X_n; [Y,Z])
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                        %mo ;
                        %mi Z
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi X
                          %mi n
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C(X_1,\dots,X_n; Z) = C(I, [X_1,\dots,[X_n,Z]])
          %h2#properties Properties
          %h3#the_closed_enrichment_context The closed enrichment context
          %p
            The closed structure on a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒱
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathcal{V}_0
            is an enrichment context
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            relative to which we can define a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+V-enriched+categories"} category of V-enriched categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒱
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathcal{V}_0
            is self-enriched, that is, isomorphic to the underlying category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒱
                    %mn 0
                    %mi e
                %annotation{:encoding => "application/x-tex"} \mathcal{V}^e_0
            of some
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒱
                      %mi e
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}^e
            %a.existingWikiWord{:href => "/nlab/show/category+of+V-enriched+categories"} category of V-enriched categories
            for details.
          %h3#reconstruction_of_monoidal_structure Reconstruction of monoidal structure
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a closed category such that the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} [A,[B,-]] : C \to C
            is
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            as a
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\otimes B
            and a
            = succeed "-natural" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ⊗
                  %mi B
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} [A,[B,X]] \cong [A\otimes B,X].
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a (closed) monoidal category. See
            %a{:href => "#EK65"} Eilenberg–Kelly (1965)
            for details.
          %p
            Note that although this is analogous to the fact that a monoidal category with right adjoints to tensor product is a closed category, the requisite hypothesis is stronger. When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is given as monoidal, we need only
            = succeed "-natural" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊗
                  %mi B
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(A\otimes B,X) \cong C(A,[B,X])
            to make it closed, whereas when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is closed we need the above
            = succeed "-natural" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %em internal
            hom-objects to make it monoidal.
          %p
            However, in the case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %em symmetric
            closed category, this stronger condition is unnecessary: to make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (symmetric) monoidal it suffices to have external natural isomorphisms of hom-sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊗
                  %mi B
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} C(A, [B,X]) \cong C(A\otimes B, X).
          %p
            Put differently, any symmetric closed category has an underlying (symmetric)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal category
            = succeed "." do
              %a{:href => "#DayLaPlaza78"} Day-Laplaza, Proposition 2.3
          %h3#EmbedIntoCloseMon Embedding into closed monoidal categories
          %p
            By a result due to Miguel LaPlaza
            = succeed "," do
              %a{:href => "#LaPlaza77"} (1977)
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully and faithfully
            into a
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
            by a strong
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+functor"} closed functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mi y
                  %mo ∘
                  %mi p
                %annotation{:encoding => "application/x-tex"} q = y \circ p
            of the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi C
                  %mo →
                  %msup
                    %mi E
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                %annotation{:encoding => "application/x-tex"} p : C \to E^\op
          %p
            sending an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} X \in C
            to the object (endofunctor)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi E
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,-] \in E = [C,C]
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %msup
                      %mi E
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} y : E^\op \to [E, Set]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [E,Set]
            is given by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves#presheaves_over_a_monoidal_category"} closed monoidal structure on presheaves over a monoidal category
          %p
            An alternative embedding was also sketched by Day
            = succeed "," do
              %a{:href => "#Day74"} (1974)
            %a{:href => "#DayLaPlaza78"} (1978)
            in the case of symmetric closed categories. This embedding is based on the fact that the construction of a closed monoidal category of presheaves does not actually require the base category to be monoidal: it suffices for it to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/promonoidal+category#notes"} promonoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [ [C,C],Set]
            as in (LaPlaza 1977), the embedding in (Day 1974) and (Day and LaPlaza 1978) uses
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C,Set]
            itself. One can then restrict to a small subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C,Set]
            and compose further with a restricted version of its Yoneda embedding in order to obtain an embedding of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            into a closed monoidal category that also preserves certain colimits in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#monadicity_and_2categories Monadicity and 2-categories
          %p
            Since the notion of closed category involves a contravariant functor and extranatural transformations, it cannot be expected to be
            %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monadic
            over the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cat
                    %mi g
                %annotation{:encoding => "application/x-tex"} Cat_g
            of categories, functors, and natural isomorphisms, the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ClCat
                %annotation{:encoding => "application/x-tex"} ClCat
            of closed categories, strong
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+functors"} closed functors
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+natural+transformations"} closed natural transformations
          %h2#extension_systems Extension systems
          %p
            There is a notion that is related to a
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            in the same way that a closed category is related to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            of a closed category. It has a set of “objects”, for any two objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                %annotation{:encoding => "application/x-tex"} A,B
            a category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}(A,B)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+bicategory"} closed bicategory
            %a{:href => "#Street74"} Street
            under the name
            = succeed "," do
              %strong extension system
            %a.existingWikiWord{:href => "/nlab/show/extension+system"} extension system
            is about an unrelated concept with the same name.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/closed+functor"} closed functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dual+object+in+a+closed+category"} dual object in a closed category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dualizing+object+in+a+closed+category"} dualizing object in a closed category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/lax+closed+category"}> lax
                \/
                %a.existingWikiWord{:href => "/nlab/show/skew+closed+category"} skew closed category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kelly%E2%80%93Mac+Lane+graph"} Kelly–Mac Lane graph
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
          %h2#references References
          %p Closed categories were first defined in:
          %ul
            %li#EK65
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G.+Max+Kelly"} G. Max Kelly
              = succeed "," do
                %em Closed Categories
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} S. Eilenberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/D.+K.+Harrison"} D. K. Harrison
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/S.+MacLane"} S. MacLane
              %a.existingWikiWord{:href => "/nlab/show/H.+R%C3%B6hrl"} H. Röhrl
              (eds.):
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Proceedings+of+the+Conference+on+Categorical+Algebra+-+La+Jolla+1965"} Proceedings of the Conference on Categorical Algebra - La Jolla 1965
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-642-99902-4"} doi:10.1007/978-3-642-99902-4
          %p
            Their
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorem"} coherence theorem
            was considered in terms of
            %a.existingWikiWord{:href => "/nlab/show/Kelly-Mac+Lane+graphs"} Kelly-Mac Lane graphs
            in
          %ul
            %li#KM71
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
              = succeed "," do
                %em Coherence in closed categories
              = succeed ")" do
                %a{:href => "http://www.sciencedirect.com/science/article/pii/0022404971900132"} web
          %p
            The relationship to
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            was studied more deeply in:
          %ul
            %li
              Jan Pavelka,
              = succeed "," do
                %em A note on closed categories
              = succeed "," do
                %a{:href => "https://dml.cz/handle/10338.dmlcz/105692"} 10338.dmlcz/105692
              = succeed "&rbrack;" do
                %a{:href => "https://dml.cz/bitstream/handle/10338.dmlcz/105692/CommentatMathUnivCarol_017-1976-2_5.pdf"} pdf
          %p
            They were shown to be equivalent to closed unital
            %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            here:
          %ul
            %li
              Oleksandr Manzyuk,
              = succeed "," do
                %em Closed categories vs. closed multicategories
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/0904.3137"} arXiv
              %a{:href => "http://www.tac.mta.ca/tac/volumes/26/5/26-05abs.html"} TAC 26, 2012
          %p
            You can get some of the idea from a
            = succeed "." do
              %a{:href => "http://golem.ph.utexas.edu/category/2009/02/monoidal_closed_categories_and.html#c022133"}
                post by Owen Biesel at the
                = succeed "-Caf\u00E9" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p LaPlaza’s theorem on embedding closed categories in closed monoidal categories is given in
          %ul
            %li#LaPlaza77
              Miguel LaPlaza,
              = succeed "," do
                %a{:href => "http://www.jstor.org/pss/1997823"}
                  %em Embedding of Closed Categories Into Monoidal Closed Categories
          %p The alternative embedding of closed categories based on promonoidal Day convolution is discussed in
          %ul
            %li#Day74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
                , An embedding theorem for closed categories,
                %em Lecture Notes in Mathematics
                420 (1974), 55-64.
            %li#DayLaPlaza78
              %p
                B. J. Day and M. L. Laplaza, On Embedding Closed Categories,
                %em Bull. Austral. Math. Soc.
                18 (1978), 357-371.
          %p The latter uses the notion of symmetric closed category, which was first defined in
          %ul
            %li#deSchipper75
              W.J. de Schipper,
              %em Symmetric closed categories
              (Mathematical Centre Tracts, 64. Mathematisch Centrum, Amsterdam, 1975)
          %p The generalization to a bicategory-like notion (“extension systems”) appears in
          %ul
            %li#Street74
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "," do
                %em Elementary cosmoi I
