                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+weak+homotopy+equivalence"} simplicial weak homotopy equivalence
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
                  if the underlying morphism is a fibration in the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
                  if it has the
                  %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                  with respect to all
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
          %p
            (
            %a{:href => "#Quillen67"}> Quillen 67, II 3.7
