          %h3#relation_to_reduced_simplicial_sets Relation to reduced simplicial sets
          #QuillenEquivalenceWithReducedSimplicialSets.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence+between+simplicial+groups+and+reduced+simplicial+sets"}> Quillen equivalence between simplicial groups and reduced simplicial sets
                )
            %p
              Forming
