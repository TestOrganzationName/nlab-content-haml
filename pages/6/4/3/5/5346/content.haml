                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    sGrp &amp;\hookrightarrow&amp; sSet\text{-}Grpd
                    \\\
                    \\mathcal{G} &amp;\mapsto&amp; \mathbf{B}\mathcal{G}
                    \\mathrlap{\,.}
                    }
            %p
              With respect to the above model structure (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelStructureOnSimplicialGroups"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groupoids"} model structure on simplicial groupoids
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and thus fails to be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
