          %h2#idea Idea
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/HalfM5.jpg", :width => "380"}/
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            of
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            on
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mspace{:width => "negativethinmathspace"}
                  %mo ⫽
                  %mspace{:width => "negativethinmathspace"}
                  %msub
                    %mi G
                    %mi HW
                  %mo ×
                  %mi ℍ
                  %mspace{:width => "negativethinmathspace"}
                  %mo ⫽
                  %mspace{:width => "negativethinmathspace"}
                  %msub
                    %mi G
                    %mi ADE
                %annotation{:encoding => "application/x-tex"}
                  S^1 \!\sslash\! G_{HW} \times \mathbb{H}\!\sslash\! G_{ADE}
          %p
            which are, locally, the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            of
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifolded
                by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi HW
                      %mo ≃
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_{HW} \simeq \mathbb{Z}_2
                as in
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Horava-Witten+theory"} Horava-Witten theory
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifolded
                by a
                %a.existingWikiWord{:href => "/nlab/show/finite+subgroup+of+SU%282%29"} finite subgroup of SU(2)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi ADE
                      %annotation{:encoding => "application/x-tex"} G_{ADE}
          %p
            (
            %a{:href => "#Sen97"}> Sen 97, Sec 3
            ,
            = succeed "," do
              %a{:href => "#FLO99"} Faux-Lüst-Ovrut 99
            = succeed "," do
              %a{:href => "#KSTY99"} Kaplunovsky-Sonnenschein-Theisen-Yankielowicz 99
            = succeed "," do
              %a{:href => "#FLO00a"} Faux-Lüst-Ovrut 00a
            = succeed "," do
              %a{:href => "#FLO00b"} 00b
            = succeed ")" do
              %a{:href => "#FLO00c"} 00c
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "#HSS18"} HSS18, Example 2.2.7
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi ADE
                  %mo =
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} G_{ADE} = \mathbb{Z}_2
            this subsumes M-theory on
            %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            times
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo ⫽
                  %msub
                    %mi G
                    %mi HW
                %annotation{:encoding => "application/x-tex"} S^1 \sslash G_{HW}
            (
            %a{:href => "#SeibergWitten96"}> Seiberg-Witten 96
            )
          %p
            %br/
          %h2#DualStringTheoryPerspectives Dual string theory perspectives
          %p
            Under
            %a.existingWikiWord{:href => "/nlab/show/duality+in+string+theory"} duality in string theory
            (specifically:
            %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} duality between M-theory and type IIA string theory
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+heterotic+string+theory"} duality between M-theory and heterotic string theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝕊
                    %mn 1
                  %mo ⫽
                  %msubsup
                    %mi ℤ
                    %mn 2
                    %mi HW
                  %mo ×
                  %msup
                    %mi 𝕋
                    %mn 4
                  %mo ⫽
                  %msup
                    %mi G
                    %mi ADE
                %annotation{:encoding => "application/x-tex"} \mathbb{S}^{1}\sslash \mathbb{Z}_2^{HW} \times \mathbb{T}^{4}\sslash G^{ADE}
            appears through the following
            = succeed "-perspectives" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ol
            %li
              %p
                %a{:href => "#HetEWithADESingularities"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi HET
                          %mi E
                      %annotation{:encoding => "application/x-tex"} HET_{E}
                  \-Theory on ADE-singularities
            %li
              %p
                %a{:href => "#TypeIPrimeWithD6OnO8"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi I
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} I'
                  \-Theory with D6-branes on O8-planes
            %li
              %p
                %a{:href => "#IPrimeTheoryOnADESingularitiesIntersectingO8Planes"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi I
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} I'
                  \-Theory on ADE-singularities intersecting O8-planes
          %p
            The following graphics shows how the three perspectives arise from
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            on three different choices of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            and their string theoretic images at
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            %a.existingWikiWord{:href => "/nlab/show/D4-branes"} D4-branes
            with
            %a.existingWikiWord{:href => "/nlab/show/geometric+engineering+of+QFTs"} geometrically engineer
            %a.existingWikiWord{:href => "/nlab/show/D%3D6+N%3D%281%2C0%29+SCFTs"} D=6 N=(1,0) SCFTs
            (see
            = succeed ")." do
              %a{:href => "#GeometricEngineeringOfDIs6NIs1SCFTs"} further below
          %center
            %img{:src => "https://ncatlab.org/nlab/files/MTheoryOnS1HWxT4ADE-Reductions.jpg", :width => "740"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "#SatiSchreiber19"} SS19
          %h3#HetEWithADESingularities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi HET
                    %mi E
                %annotation{:encoding => "application/x-tex"} HET_{E}
            \-Theory on ADE-singularities
          %p (…)
          %p
            %a.existingWikiWord{:href => "/nlab/show/Horava-Witten+theory"}> Horava-Witten theory
            , hence
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            %a.existingWikiWord{:href => "/nlab/show/ADE-singularities"} ADE-singularities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℍ
                  %mo ⫽
                  %msub
                    %mi G
                    %mi ADE
                %annotation{:encoding => "application/x-tex"} \mathbb{H} \sslash G_{ADE}
          %p
            (
            %a{:href => "#Witten99"}> Witten 99
            ,…)
          %p (…)
          %h3#TypeIPrimeWithD6OnO8
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi I
                  %mo ′
                %annotation{:encoding => "application/x-tex"} I'
            \-Theory with D6-branes on O8-planes
          %p
            %img{:src => "https://ncatlab.org/nlab/files/HalfNS5.jpg", :width => "650"}/
          %blockquote
            %p
              from
              %a{:href => "#GKSTY02"} GKSTY 02
          %p
            If in addition the
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            %a.existingWikiWord{:href => "/nlab/show/NS5-brane"} NS5-brane
            sits at an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/O8-plane"} O8-plane
            %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifold
            = succeed "-locus," do
              %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            it appears as a “
            %a.existingWikiWord{:href => "/nlab/show/half-brane"}> half-brane
            ” – the
            %a.existingWikiWord{:href => "/nlab/show/half+M5-brane"} half M5-brane
            – with only one copy of
            %a.existingWikiWord{:href => "/nlab/show/D6-branes"} D6-branes
            ending on it:
          %p
            %img{:src => "https://ncatlab.org/nlab/files/HalfNS5II.jpg", :width => "400"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "#GKSTY02"} GKSTY 02
          %p
            (In
            %a{:href => "#HananyZaffaroni99"} Hanany-Zaffaroni 99
            this is interpreted in terms of the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft-Polyakov+monopole"} 't Hooft-Polyakov monopole
          %p#LiftToMTheortyOfNS5Halfbrane
            The lift to
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            of this situation is an
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            %a.existingWikiWord{:href => "/nlab/show/brane+intersection"} intersecting
            an
            %a.existingWikiWord{:href => "/nlab/show/M9-brane"} M9-brane
            (see at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/M-theory+on+S1%2FG_HW+times+H%2FG_ADE"} M-theory on S1/G_HW times H/G_ADE
          %p
            %img{:src => "https://ncatlab.org/nlab/files/M9KK6Intersection.jpg", :width => "650"}/
          %blockquote
            %p
              from
              %a{:href => "#GKSTY02"} GKSTY 02
          %p
            Alternatively the
            %a.existingWikiWord{:href => "/nlab/show/O8-plane"} O8-plane
            may
            %a.existingWikiWord{:href => "/nlab/show/brane+intersection"} intersect
            the
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            %a.existingWikiWord{:href => "/nlab/show/D6-branes"} D6-branes
            away from the
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/NS5-brane"} NS5-brane
          %p
            %img{:src => "https://ncatlab.org/nlab/files/D6D8Intersection.jpg", :width => "650"}/
          %blockquote
            %p
              from
              %a{:href => "#HKLY15"} HKLY 15
          %p
            In general, some of the NS5 sit away from the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/O8-plane"} O8-plane
          %p
            %img{:src => "https://ncatlab.org/nlab/files/NS5D6O8.jpg", :width => "500"}/
          %blockquote
            %p
              from
              %a{:href => "#HananyZaffaroni98"} Hanany-Zaffaroni 98
          %h3#IPrimeTheoryOnADESingularitiesIntersectingO8Planes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi I
                  %mo ′
                %annotation{:encoding => "application/x-tex"} I'
            \-theory on ADE-singularities intersecting O8-planes
          %p
            (
            %a{:href => "#BergmanRodriguezGomez12"}> Bergman &amp; Rodriguez-Gomez 12, Sec. 3
            )
          %p (…)
          %h2#GeometricEngineeringOfDIs6NIs1SCFTs
            Geometric engineering of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 6
                %annotation{:encoding => "application/x-tex"} D = 6
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N=(1,0)
            SCFTs on M5-branes
          %p
            The
            = succeed "-configurations" do
              %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            %a{:href => "#DualStringTheoryPerspectives"} above
            are supposed to
            %a.existingWikiWord{:href => "/nlab/show/geometric+engineering+of+QFTs"} geometrically engineer
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D%3D6+N%3D%281%2C0%29+SCFTs"} D=6 N=(1,0) SCFTs
          %p
            See the references
            = succeed "," do
              %a{:href => "#ReferencesGeometricEngineeringOfDIs6NIs1SCFT"} below
            = succeed "," do
              %a{:href => "#DHTV14"} DHTV 14, Section 6
            = succeed "," do
              %a{:href => "#GaiottoTomasiello14"} Gaiotto-Tomasiello 14
            = succeed "." do
              %a{:href => "#HKLY15"} HKLY 15
          %h2#related_concepts Related concepts
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
                of
                %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+a+circle"} M-theory on a circle
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+8-manifolds"}> M-theory on 8-manifolds
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+Spin%287%29-manifolds"} on Spin(7)-manifolds
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G%E2%82%82-manifolds"} M-theory on G₂-manifolds
                %ul
                  %li
                    %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-MSSM"} G₂-MSSM
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+Sp%281%29-manifolds"} M-theory on Sp(1)-manifolds
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+hyperbolic+manifolds"} M-theory on hyperbolic manifolds
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/heterotic+M-theory+on+ADE-orbifolds"} heterotic M-theory on ADE-orbifolds
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+Calabi-Yau+manifolds"} M-theory on Calabi-Yau manifolds
                %ul
                  %li
                    %p
