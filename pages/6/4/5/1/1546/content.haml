              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#idea Idea
          %p
            The
            %strong Atiyah Lie groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi At
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} At(P)
            of a smooth
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are the
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            of the bundle, and whose
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+maps"} equivariant maps
            between the fibers.
          %p Schematically:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi At
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mrow
                    %mo {
                    %msub
                      %mi P
                      %mi x
                    %mover
                      %mo →
                      %mi α
                    %msub
                      %mi P
                      %mi y
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  At(P)
                  \\,=\,
                  \\left\{
                  P_x \stackrel{\alpha}{\to} P_y
                  | x,y \in X
                  \\right\}
                  \\,.
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            is the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+algebroid"} Atiyah Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi at
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} at(P)
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            Both the Atiyah Lie groupoid and its Lie algebroid are used to characterize and are characterized by
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connections
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %h2#definition Definition
          %p
            As generally for every
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} integrating
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+algebroid"} Atiyah Lie algebroid
          %p
            The Atiyah Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi at
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} at(P)
            of the
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            comes canonically with a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi at
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} at(X) \to T X
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
          %p
            The simplest
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of the tangent Lie algebroid is the
            %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \times X
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            (both coincide precisey if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+space"} simply connected space
          %p
            Accordingly, there is a version of the Atiyah Lie groupoid over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
          %h3#over_the_pair_groupoid Over the pair groupoid
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a Lie group and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p \colon P \to X
            a
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %strong Atiyah groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi At
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} At(P)
            – also called the
            %strong gauge groupoid
            or
            %strong transport groupoid
            – of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            with
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                of
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                is
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi At
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Obj(At(P)) \coloneqq X
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                of
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi At
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ×
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi G
                      %annotation{:encoding => "application/x-tex"} Mor(At(P)) = (P \times P)/G
                %a.existingWikiWord{:href => "/nlab/show/quotient+object"} quotient
                is taken with respect to the
                %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo ×
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P \times P
            %li
              %p
                the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/source"} source
                %a.existingWikiWord{:href => "/nlab/show/target"} target
                maps are those induced by the bundle projection
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              %p
                notice that a point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ×
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} f \colon * \to (P \times P)/G
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo =
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi x
                          %mn 2
                        %mo =
                        %mi t
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x_1 = s(f), x_2 = t(f))
                %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
                of a pair
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mn 1
                      %mo ,
                      %msub
                        %mi s
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi P
                      %mo ×
                      %mi P
                    %annotation{:encoding => "application/x-tex"} (s_1, s_2) \in P \times P
                is canonically identified with the unique
                = succeed "-equivariant" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi P
                        %mrow
                          %msub
                            %mi x
                            %mn 1
                      %mo →
                      %msub
                        %mi P
                        %mrow
                          %msub
                            %mi x
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} f \colon P_{x_1} \to P_{x_2}
                which sends
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} s_1
                to
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} s_2
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                is the given by ordinary composition of these functions.
          %h3#the_integrated_atiyah_sequence The integrated Atiyah sequence
          %p The Atiyah groupoid sits in a sequence of groupoids
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ad
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi At
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Ad(P) \to At(P) \to Pair(X)
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ad
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi P
                      %msub
                        %mo ×
                        %mi G
                      %mi G
                    %annotation{:encoding => "application/x-tex"} Ad(P) = P \times_G G
                is the
                %strong adjoint bundle
                of groups associated via the adjoint action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on itself; regarded as a smooth union
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi x
                          %mo ∈
                          %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi P
                        %mi x
                      %msub
                        %mo ×
                        %mi G
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \coprod_{x \in X} \mathbf{B} P_x \times_G G
                of one-object groupoids coming from
                = succeed "s;" do
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Pair
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi X
                      %mo ⇉
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Pair(X) = (X \times X \rightrightarrows X)
                is the
                %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ad
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi At
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ad(P) \to At(P)
                is the identity on objects and on morphisms given by the canonical identification
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi P
                          %mi x
                        %msub
                          %mo ×
                          %mi G
                        %mi G
                        %mover
                          %mo →
                          %mo ≃
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi P
                          %mi x
                        %mo ×
                        %msub
                          %mi P
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi G
                      %annotation{:encoding => "application/x-tex"} P_x \times_G G \stackrel{\simeq}{\to} (P_x \times P_x)/G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi P
                          %mi x
                        %mo ×
                        %msub
                          %mi P
                          %mi x
                      %annotation{:encoding => "application/x-tex"} P_x \times P_x
            %li
              %p
                the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi At
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Pair
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} At(P) \to Pair(X)
                is the unique one that is the identity on objects.
          %p
            Notice that a splitting (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/section"} section
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi At
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Pair(X) \to At(P)
          %p
            of the Atiyah groupoid is a trivialization of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \subset X
            we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pair(U) \simeq \Pi_1(U)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi At
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi U
                %annotation{:encoding => "application/x-tex"} Pair(U) \simeq \Pi_1(U) \to At(P)|_U
            is still a trivialization over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            but indicates now that one may want to interpret it as giving rise to a flat
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection"} connection
          %h3#over_a_path_groupoid Over a path groupoid
          %p
            We have the sequence of surjective and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
            %a.existingWikiWord{:href => "/nlab/show/path+category"} path categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  P_1(X) \to \Pi_1(X) \to Pair(X)
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(X)
            the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_1(X)
            the smooth
            %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
            and may refine the Atiyah groupoid by pulling back along these.
          %p
            Write therefore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi At
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi At
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi Pair
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} At'(P) := At(P) \times_{Pair(X)} \Pi_1(X)
            for the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi At
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi At
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi Pair
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  At'(P) &amp;\to&amp; \Pi_1(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  At(P) &amp;\to&amp; Pair(X)
                  }
                  \\,.
          %p
            A splitting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi At
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(X) \to At'(P)
            of the top row is now precisely a flat
            %a.existingWikiWord{:href => "/nlab/show/connection"} connection
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            If we pull back further to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ″
                %annotation{:encoding => "application/x-tex"} A''
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi At
                          %mo ″
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi P
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi At
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi At
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi Pair
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  At''(P) &amp;\to&amp; P_1(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  At'(P) &amp;\to&amp; \Pi_1(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  At(P) &amp;\to&amp; Pair(X)
                  }
                  \\,.
          %p
            then splittings of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi At
                  %mo ″
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_1(X) \to At''(X)
            are precisely (not necessarily flat) connections on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            All this is more well known in terms of the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            underlying the Atiyah Lie groupoid, i.e. the
            %strong Atiyah Lie algebroid
            sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ad
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi at
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  ad(P) \to at(P) \to T X
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ad
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi P
                      %msub
                        %mo ×
                        %mi g
                      %mi Lie
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ad(P) = P \times_g Lie(G)
                is the adjoint bundle of Lie algebras, associated via the adjoint action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on its Lie algebra;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi at
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} at(P) = (T P)/G
                is the
                %strong Atiyah Lie algebroid
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T X
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
          %p
            Indeed, a splitting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi flat
                  %mo :
                  %mi T
                  %mi X
                  %mo →
                  %mi at
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \nabla_{flat} : T X \to at(P)
            of this sequence in the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and integrates under
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            to the splitting of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi At
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} At'(P)
            discussed above.
          %p To get non-flat connections in the literature one often sees discussed splittings of the Atiyah Lie algebroid sequence in the category just of vector bundles. In that case one finds the curvature of the connection precisely as the obstruction to having a splitting even in Lie algebroids.
          %p
            One can describe non-flat connections without leaving the context of Lie algebroids by passing to higher Lie algebroids, namely
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity-algebroid"} algebroids
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higher+Atiyah+groupoid"} higher Atiyah groupoid
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+groupoid"}> Atiyah Lie groupoid
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+algebroid"} Atiyah Lie algebroid
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Courant+Lie+2-groupoid"}> Courant Lie 2-groupoid
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/Courant+Lie+2-algebroid"} Courant Lie 2-algebroid
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"}> quantomorphism group
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/quantomorphism+n-group"} quantomorphism n-group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Schauenburg+bialgebroid"} Schauenburg bialgebroid
                (analogue for affine noncommutative principal bundles)
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/higher+Atiyah+groupoid"} higher Atiyah groupoid
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/higher+Atiyah+groupoid"}> higher Atiyah groupoid
                    \:
                  %th
                    standard
                    %a.existingWikiWord{:href => "/nlab/show/higher+Atiyah+groupoid"} higher Atiyah groupoid
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/higher+Courant+groupoid"} higher Courant groupoid
                  %th
                    groupoid version of
                    %a.existingWikiWord{:href => "/nlab/show/quantomorphism+n-group"} quantomorphism n-group
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
                    for
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                  %td{:style => "text-align: left;"}
                    %math#mathml_25bb27a7b2a5a8fcca6d17f6a351b913ce28a816_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi 𝔾
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{G}
                  %td{:style => "text-align: left;"}
                    %math#mathml_25bb27a7b2a5a8fcca6d17f6a351b913ce28a816_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔾
                            %mi{:mathvariant => "normal"} conn
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}(\mathbf{B}\mathbb{G}_{\mathrm{conn}})
                  %td{:style => "text-align: left;"}
                    %math#mathml_25bb27a7b2a5a8fcca6d17f6a351b913ce28a816_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
