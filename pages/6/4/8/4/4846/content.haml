            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            %em
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fr%C3%A9+formulation+of+supergravity"} D'Auria-Fré formulation of supergravity
            \.
          %p
          #ModifiedWeilAlgebra.num_defn
            %h6 Definition
            %p
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 6
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} W\big(\mathfrak{sugra}_6(10,1)\big)
              for the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              of the supergravity Lie 6-algebra.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} g_4
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} g_7
              for the shifted generators of the Weil algebra corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} c_3
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 6
                    %annotation{:encoding => "application/x-tex"} c_6
            %p
              Define an
              %a.existingWikiWord{:href => "/nlab/show/adjusted+Weil+algebra"} adjusted Weil algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 6
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde W(\mathfrak{sugra}_6(10,1))
              by declaring it to have the same generators and differential as before, except that the differential for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} c_6
              is modified to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi c
                      %mn 6
                    %mo ≔
                    %msub
                      %mi d
                      %mi W
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi c
                      %mn 6
                    %mo +
                    %mn 15
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi g
                      %mn 4
                    %mo ∧
                    %msub
                      %mi c
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    d_{\tilde W} \, c_6
                    \\coloneqq
                    d_{W} \, c_6
                    +
                    15 \, g_4 \wedge c_3
            %p
              and hence the differential of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} g_7
              is accordingly modified in the unique way that ensures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_{\tilde W}^2 = 0
              (yielding the modified
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
              for
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 7
                    %annotation{:encoding => "application/x-tex"} g_7
            %p
          %p
            This ansatz appears in
            = succeed "." do
              %a{:href => "#CastellaniDAuriaFre"} Castellani, D’Auria &amp; Fré 1991 (III.8.24)
          %p
            Note that this amounts simply to a redefinition of
            %a.existingWikiWord{:href => "/nlab/show/curvatures"} curvatures
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi g
