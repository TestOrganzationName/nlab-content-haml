                    %mn 7
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi g
                    %mn 7
                  %mo +
                  %mn 15
                  %msub
                    %mi g
                    %mn 4
                  %mo ∧
                  %msub
                    %mi c
                    %mn 3
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tilde g_7
                  \\;\coloneqq\;
                  g_7 + 15 g_4 \wedge c_3
                  \\,.
          %p
          #SugraEOM.num_prop
            %h6 Proposition
            %p
            %p
              A field configuration of
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
              is given by
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid+of+%E2%88%9E-Lie+algebra+valued+forms"} L-∞ algebra valued differential forms
              with values in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔰𝔲𝔤𝔯𝔞
                        %mn 6
                    %annotation{:encoding => "application/x-tex"} \mathfrak{sugra}_6
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            %p A field configuration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 6
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(X)
                    \\leftarrow
                    \\tilde W(\mathfrak{sugra}_6)
                    \\;\colon\;
                    \\Phi
            %p solves the equations of motion precisely if
            %ol
              %li
                %p
                  all
                  %a.existingWikiWord{:href => "/nlab/show/curvatures"} curvatures
                  sit in the ideal of differential forms spanned by the 1-form fields
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mi a
                      %annotation{:encoding => "application/x-tex"} E^a
                  (
                  %a.existingWikiWord{:href => "/nlab/show/vielbein"}> vielbein
                  ) and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ψ
                      %annotation{:encoding => "application/x-tex"} \Psi
                  (
                  %a.existingWikiWord{:href => "/nlab/show/gravitino"}> gravitino
                  );
                %p more precisely if we have
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi τ
                            %mo =
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} \tau = 0
                    %p
                      (super-
                      %a.existingWikiWord{:href => "/nlab/show/torsion"}> torsion
                      );
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi G
                              %mn 4
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi G
                              %mn 4
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %mo ,
                                %mi ⋯
                                %msub
                                  %mi a
                                  %mn 4
                            %msup
                              %mi E
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msup
                              %mi E
                              %mrow
                                %msub
                                  %mi a
                                  %mn 4
                          %annotation{:encoding => "application/x-tex"} G_4 = (G_4)_{a_1, \cdots a_4} E^{a_1} \wedge \cdots \wedge E^{a_4}
                    %p
                      (
                      %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
                      of
                      = succeed ")" do
                        %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi G
                              %mn 7
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi G
                              %mn 7
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %mo ,
                                %mi ⋯
                                %msub
                                  %mi a
                                  %mn 7
                            %msup
                              %mi E
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msup
