          %h2#idea Idea
          %p
            The
            %em supergravity Lie 6-algebra
            (
            %a{:href => "#DauriaFre82"}> D’Auria &amp; Fré 1982, p. 18
            ) is (with hindsight, following
            = succeed ")" do
              %a{:href => "#FSS15"} FSS15
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
            such that
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra+valued+differential+forms"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              \-algebra valued differential forms
            (local
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} ∞-connections
            %a.existingWikiWord{:href => "/nlab/show/field+history"} field histories
            of
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
                field with a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/spin+connection"} spin connection
              %p
                hence the
                %a.existingWikiWord{:href => "/nlab/show/first+order+formulation+of+gravity"} first order formulation of gravity
                for a
                %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
                field
              %p in 10+1 dimensions;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
                field;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
              %p
                %em and
                its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/electric-magnetic+duality"} magnetic dual
          %p
            This is such that the
            %a.existingWikiWord{:href => "/nlab/show/field+strengths"} field strengths
            and
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            of these fields are governed by certain fermionic
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} super L-∞ algebraic cocycles
            as suitable for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
          %h2#definition Definition
          %blockquote
            %p
              Our normalization conventions entirely follow
              = succeed "," do
                %a{:href => "#CastellaniDAuriaFre"} Castellani, D’Auria &amp; Fré 1991, §III.8.3
              %a.existingWikiWord{:href => "/nlab/show/super-vielbein"} super-vielbein
              1-forms by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msup
                      %mi e
                      %mi a
                    %msubsup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mrow
                        %mi a
                        %mo =
                        %mn 0
                      %mn 10
                  %annotation{:encoding => "application/x-tex"} \big\{e^a\big\}_{a=0}^{10}
              instead of by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                      %msup
                        %mi V
                        %mi a
                      %msubsup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                        %mrow
                          %mi a
                          %mo =
                          %mn 0
                        %mn 10
                    %annotation{:encoding => "application/x-tex"} \big\{V^a\big\}_{a=0}^{10}
          #TheSevenCocycle.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"} supergravity Lie 3-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sugra}_3(10,1)
              carries an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} L-∞ algebra cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 7
                    %mo ∈
                    %mi CE
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mu_7 \in CE\big(\mathfrak{sugra}_3(10,1)\big)
              of degree 7, given in the standard generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi e
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e^a\}
              (
              %a.existingWikiWord{:href => "/nlab/show/vielbein"}> vielbein
              ),
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\omega^{a b}\}
              (
              %a.existingWikiWord{:href => "/nlab/show/spin+connection"}> spin connection
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ψ
                      %mi α
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\psi^\alpha\}
              (
              %a.existingWikiWord{:href => "/nlab/show/gravitino"}> gravitino
              ) and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi c
                      %mn 3
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{c_3\}
              (
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"}> supergravity C-field
              ) by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 7
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mi i
                      %mn 2
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 5
                    %mi ψ
                    %mo ∧
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi a
                          %mn 5
                    %mo +
                    %mn 15
                    %msub
                      %mi μ
                      %mn 4
                    %mo ∧
                    %msub
                      %mi c
                      %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_7
                    \\;\coloneqq\;
                    \\frac{i}{2}\bar \psi \wedge \Gamma^{a_1 \cdots a_5} \psi \wedge e_{a_1} \wedge \cdots \wedge e_{a_5}
                    +
                    15 \mu_4 \wedge c_3
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mn 2
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %msub
                          %mi a
                          %mn 2
                    %mi ψ
                    %mo ∧
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi a
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_4
                    \\;=\;
                    \\frac{1}{2}
                    \\overline{\psi}
                    \\Gamma^{a_1 a_2}
                    \\psi \wedge e_{a_1} \wedge e_{a_2}
            %p
              is the 4-cocycle which defines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sugra}_3(10,1)
              as an extension of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 10
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mstyle{:mathvariant => "bold"}
                            %mn 32
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{10,1\vert \mathbf{32}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} c_3
              is the generator that cancels the class of this cocycle,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi CE
                      %msub
                        %mi c
                        %mn 3
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi μ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} d_{CE} c_3 \,=\, \mu_4
          %p In other words, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi{:mathvariant => "normal"} d
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi μ
                          %mn 4
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                    %mtr
                      %mtd
                        %mi{:mathvariant => "normal"} d
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi μ
                          %mn 7
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 15
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi μ
                          %mn 4
                        %mo ∧
                        %msub
                          %mi μ
                          %mn 4
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  \\mathrm{d}
                  \\,
                  \\mu_4 \;=\; 0
                  \\\
                  \\mathrm{d}
                  \\,
                  \\mu_7
                  \\;=\;
                  15\,
                  \\mu_4 \wedge \mu_4
                  \\mathrlap{\,.}
                  \\end{array}
          %p
            which has the same structure as the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of the
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
                %annotation{:encoding => "application/x-tex"} G_4
            of the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            and its
            %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 7
                  %mo =
                  %mo *
                  %msub
                    %mi G
                    %mn 4
                %annotation{:encoding => "application/x-tex"} G_7 = \ast G_4
            in
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            (to which it is related
            = succeed ")" do
              %a{:href => "#eq:SuperMaxwellEquation"} below
          %p
            This appears (in the dual language of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            %a{:href => "#DAuriaFre"} DAuria &amp; FrFré 1982, page 18
            and
            = succeed "." do
              %a{:href => "#CastellaniDAuriaFre"} Castellani, D’Auria &amp; Fré 1991, §III.8.3
          .proof
            %h6#proof Proof
            %p One computes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %msub
                                  %mrow
                                  %mi CE
                            %msub
                              %mi μ
                              %mn 7
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mfrac
                              %mn 5
                              %mn 4
                            %mover
                              %mi ψ
                              %mo{:stretchy => "false"} ¯
                            %mo ∧
                            %msup
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi a
                                  %mn 4
                                %mi b
                            %mi ψ
                            %mo ∧
                            %msub
                              %mi e
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msub
                              %mi e
                              %mrow
                                %msub
                                  %mi a
                                  %mn 4
                            %mo ∧
                            %mover
                              %mi ψ
                              %mo{:stretchy => "false"} ¯
                            %mo ∧
                            %msub
                              %mi Γ
                              %mi b
                            %mi ψ
                        %mtr
                          %mtd
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %mn 15
                            %mo ∧
                            %msup
                              %mi Γ
                              %mrow
                                %mi a
                                %mi b
                            %msub
                              %mi e
                              %mi a
                            %mo ∧
                            %mover
                              %mi ψ
                              %mo{:stretchy => "false"} ¯
                            %mo ∧
                            %msub
                              %mi Γ
                              %mi b
                            %mi ψ
                            %mo ∧
                            %msub
                              %mi c
                              %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mfrac
                              %mn 15
                              %mn 4
                            %mover
                              %mi ψ
                              %mo{:stretchy => "false"} ¯
                            %mo ∧
                            %msub
                              %mi Γ
                              %mrow
                                %mi a
                                %mi b
                            %mi ψ
                            %mo ∧
                            %msup
                              %mi e
                              %mi a
                            %mo ∧
                            %msup
                              %mi e
                              %mi b
                            %mo ∧
                            %mover
                              %mi ψ
                              %mo{:stretchy => "false"} ¯
                            %mo ∧
                            %msub
                              %mi Γ
                              %mrow
                                %mi c
                                %mi d
                            %mi ψ
                            %mo ∧
                            %msup
                              %mi e
                              %mi c
                            %mo ∧
                            %msup
                              %mi e
                              %mi d
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_{{}_{CE}} \mu_7
                    \\;=\;
                    \&amp;
                    \- \frac{5}{4} \bar \psi \wedge \Gamma^{a_1 \cdots a_4 b} \psi \wedge e_{a_1} \wedge \cdots \wedge e_{a_4} \wedge \bar \psi \wedge \Gamma_b \psi
                    \\\
                    \&amp; - i 15 \wedge \Gamma^{a b} e_a \wedge \bar \psi \wedge \Gamma_b \psi \wedge c_3
                    \\\
                    \&amp; +
                    \\frac{15}{4} \bar \psi \wedge \Gamma_{a b} \psi \wedge e^a \wedge e^b \wedge \bar \psi \wedge \Gamma_{c d} \psi \wedge e^c \wedge e^d
                    \\end{aligned}
                    \\,.
            %p
              This expression vanishes due to the
              %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 4
                        %mi b
                    %mi ψ
                    %mo ∧
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mi b
                    %mi ψ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 3
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi a
                          %mn 1
                        %msub
                          %mi a
                          %mn 2
                    %mi ψ
                    %mo ∧
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 3
                        %msub
                          %mi a
                          %mn 4
                        %mo{:stretchy => "false"} ]
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"}
                    \\bar \psi \wedge
                    \\Gamma^{a_1 \cdots a_4 b} \psi \wedge \bar \psi \wedge \Gamma_b \psi
                    \\;=\;
                    3 \bar \psi \wedge \Gamma^{[a_1 a_2} \psi \wedge \bar \psi \wedge \Gamma^{a_3 a_4 ]} \psi
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ∧
                    %msup
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mi ψ
                    %mo ∧
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ∧
                    %msub
                      %mi Γ
                      %mi b
                    %mi ψ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar \psi \wedge \Gamma^{a b} \psi \wedge \bar \psi \wedge \Gamma_b \psi
                    \\;=\; 0
                    \\,.
          #TheDefinition.num_def
            %h6#definition_2 Definition
            %p
              The
              %em supergravity Lie 6-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 7
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sugra}_{7}(10,1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super Lie 7-algebra
              that is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi b
                        %mn 6
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} b^6 \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sugra}_3(10,1)
              classified by the cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} \mu_7
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TheSevenCocycle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mn 5
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 6
                    %mo →
                    %msub
                      %mi 𝔰𝔲𝔤𝔯𝔞
                      %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
