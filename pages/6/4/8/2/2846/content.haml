                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \kappa\in j(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            is a
            = succeed "-complete" do
