            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            are certain kinds of
            %a.existingWikiWord{:href => "/nlab/show/functor"} functors
            from the
            %a.existingWikiWord{:href => "/nlab/show/syntactic+site"} syntactic site
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
