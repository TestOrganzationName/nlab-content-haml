                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformations
            between these functors.
          %h2#definition Definition
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
            %strong elementary embedding
            between
            %a.existingWikiWord{:href => "/nlab/show/model"} structures
            (over a given
            %a.existingWikiWord{:href => "/nlab/show/signature"} signature
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            that preserves and reflects all of
            %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order logic
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
