            %a.existingWikiWord{:href => "/nlab/show/ultrafilter"} ultrafilter
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %a.existingWikiWord{:href => "/nlab/show/ultrapower"} ultrapower
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
