            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            is necessary for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi 𝒰
                %annotation{:encoding => "application/x-tex"} V^{\mathcal{U}}
            to be well-founded and thus have a transitive collapse.)
          %p
            Conversely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} j\colon V\to M
            is a nontrivial elementary embedding, it must have a
            = succeed "," do
              %em critical point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} j(\kappa)\neq \kappa
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi κ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j(\kappa)
            is some
            %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &gt;
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \gt \kappa
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
