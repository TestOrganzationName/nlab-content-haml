            implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is injective. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is (interpreted as) the inclusion of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is an
            %strong elementary substructure
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is an
            %strong elementary extension
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            More generally, when we consider structures in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            as in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+logic"} categorical logic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} f\colon M\to N
            between structures in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an
            %strong elementary embedding
            if for any formula
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi φ
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi M
                        %mtd
                          %mover
                            %mo →
                            %mrow
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi φ
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi N
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi M
                          %msub
                            %mi A
                            %mn 1
                          %mo ×
                          %mi …
                          %mo ×
                          %mi M
                          %msub
                            %mi A
                            %mi n
                        %mtd
                          %munder
                            %mo →
                            %mrow
                        %mtd
                          %mi N
                          %msub
                            %mi A
                            %mn 1
                          %mo ×
                          %mi …
                          %mo ×
                          %mi N
                          %msub
                            %mi A
                            %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\array{[\varphi]_M &amp; \overset{}{\to} &amp; [\varphi]_N\\
                  \\downarrow &amp;&amp; \downarrow\\
                  M A_1 \times\dots \times M A_n &amp; \underset{}{\to} &amp; N A_1 \times \dots \times N A_n}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} M A_i
            denotes the object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            interpreting the type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} A_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi φ
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi M
                %annotation{:encoding => "application/x-tex"} [\varphi]_M
            denotes the corresponding subobject in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            interpreting the truth value of the formula
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is an
            %strong elementary morphism
            if it does.
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              \: let me try to say this more explicitly, to check if I am following:
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/theory"} theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              that we are modelling is exhibited by its syntactic category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Syn
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Syn(T)
              with finite limits. A model of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              in a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with limits – equivalently a
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              – is a finite-limit preserving functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo :
                      %mi Syn
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} N : Syn(T) \to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi M
                    %mo →
                    %mi N
                    %mo :
                    %mi Syn
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f : M \to N : Syn(T) \to C
              of models is a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between such functors. We say that such a natural transformation is an
              %em elementary embedding
              if its naturality squares on certain morphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Syn
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Syn(T)
              are pullback squares.
            %p
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              \: Not quite. First of all, the definition officially happens at the more general level of structures rather than models, but we can of course consider those as models for the empty theory. And whether we need finite-limit categories and functors, or something else like regular ones, geometric ones, or Heyting ones, depends on what fragment of logic we consider our (possibly empty) theories as living in. Your rephrasing is correct if we mean finitary first-order theories and therefore
              %a.existingWikiWord{:href => "/nlab/show/Heyting+categories"} Heyting categories
              and Heyting functors. Otherwise, the syntactic category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Syn
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Syn(T)
              won’t have the structure required to construct
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi φ
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\varphi]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p I think I didn’t explain this very well, but I have to go now, I’ll try to come back to it later and rewrite it to make more sense.
            %p
              %a.existingWikiWord{:href => "/nlab/show/Peter+Arndt"}> Peter Arndt
              \: Regarding the statement “this square need not even commute”: this suggests that the upper arrow is something that we know to define, but the issue is rather that the restriction of the given morphism to the upper left corner might not factor through the upper right corner. For example given a ring homomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi R
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} f: R \to S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi R
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo ¬
                    %mo ∃
                    %mi y
                    %mo :
                    %mi xy
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi S
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo ¬
                    %mo ∃
                    %mi y
                    %mo :
                    %mi xy
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x \in R \mid \not \exists y: xy=1\} \to \{x \in S \mid  \not \exists y: xy=1 \}
              because non-units can become units in the codomain ring.
          %p
            In practice, it is also useful to separate out the weaker notion of
            = succeed "." do
              %strong embedding
          .num_defn
            %h6#definition_2 Definition
            %p
              Working over a fixed signature
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi M
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} f: M \to N
              is an
              %em embedding
              if for each relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} R \in \Sigma
              of arity
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi M
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi f
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %msub
                        %mi R
                        %mi N
                    %annotation{:encoding => "application/x-tex"} R_M = (f^n)^\ast R_N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi M
                  %annotation{:encoding => "application/x-tex"} R_M
              is obtained by pulling back the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi N
                    %mo ↪
                    %msup
                      %mi N
                      %mi n
                  %annotation{:encoding => "application/x-tex"} R_N \hookrightarrow N^n
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mi n
                      %mo :
                      %msup
                        %mi M
                        %mi n
                      %mo →
                      %msup
                        %mi N
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f^n: M^n \to N^n
          %p
            Notice this is
            %em stronger
            than just being an injective homomorphism (where we demand only that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi M
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msup
                      %mi R
                      %mi n
                  %annotation{:encoding => "application/x-tex"} R_M \hookrightarrow (f^n)^\ast R^n
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi M
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊢
                    %msub
                      %mi R
                      %mi N
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi …
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R_M(a_1, \ldots, a_n) \vdash R_N(f(a_1), \ldots, f(a_n))
          %p
            A
            %em substructure
            is an embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi M
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} f: M \to N
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a set-theoretic inclusion. (In
            = succeed "," do
