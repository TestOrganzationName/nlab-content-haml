          %h3#moufang_identities Moufang identities
          %p Further consequences of the composition algebra axioms include the Moufang laws which are important in the study of octonions.
          %p
            %strong Moufang identities
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mi u
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (u v)(w u) = (u(v w))u) = u((v w)u)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mi w
                      %mo =
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((u v)u)w = u(v(u w))
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mi v
                      %mo =
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((u v)w)v = u(v(w v))
          %p We will prove the first of these; the others are proven in similar style (see Springer-Veldkamp for details). (It may be tricky to remember how the bracketings go, but one thing to remember is that the bracketings shouldn’t lead to proofs of general associativity when interpreted in a division algebra!)
          .proof
            %h6#proof_14 Proof
            %p We have
