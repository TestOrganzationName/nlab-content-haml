                    %a{:href => "#possible_dimensions_are_1_2_4_and_8"} Possible dimensions are 1, 2, 4, and 8.
                %li
                  %a{:href => "#HurwitzTheoremSection"} Hurwitz’s Theorem
                %ul
                  %li
                    %a{:href => "#split_composition_algebras"} Split composition algebras
                %li
                  %a{:href => "#moufang_identities"} Moufang identities
              %li
                %a{:href => "#generalizations"} Generalizations
              %ul
                %li
                  %a{:href => "#from_ab_to_monoidal_categories"} From Ab to monoidal categories
                %li
                  %a{:href => "#from_vect_to_monoidal_categories"} From Vect to monoidal categories
              %li
