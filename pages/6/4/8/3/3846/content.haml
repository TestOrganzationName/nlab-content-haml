                              %mi v
                              %mo{:stretchy => "false"} ¯
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mn 2
