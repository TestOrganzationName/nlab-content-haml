                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
