                            %mo{:stretchy => "false"} ⟩
                            %mo −
                            %mo{:stretchy => "false"} ⟨
                            %mover
                              %mi u
                              %mo{:stretchy => "false"} ¯
                            %mover
                              %mi w
                              %mo{:stretchy => "false"} ¯
                            %mo ,
                            %mover
                              %mi u
                              %mo{:stretchy => "false"} ¯
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mn 2
                            %mo{:stretchy => "false"} ⟨
