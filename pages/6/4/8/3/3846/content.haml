                            %mo{:stretchy => "false"} ⟨
                            %mi u
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi u
                              %mo{:stretchy => "false"} ¯
                            %mover
                              %mi w
                              %mo{:stretchy => "false"} ¯
