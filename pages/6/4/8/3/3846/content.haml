            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a composition algebra object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            which is also a
            %a.existingWikiWord{:href => "/nlab/show/paraunital+algebra+object"} paraunital algebra object
            with respect to the morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi A
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \pi_A:A \otimes A \to A
            %strong unital composition algebra object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a composition algebra object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            which is also a
            %a.existingWikiWord{:href => "/nlab/show/unital+algebra+object"} unital algebra object
            with respect to the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi A
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \pi_A:A \otimes A \to A
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+categories"} cartesian monoidal categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mn 1
                    %mo ,
                    %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C, 1, \times)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ×
                  %mi V
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} V \times V \to 1
            exists and is unique by the universal property of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the
            %a.existingWikiWord{:href => "/nlab/show/trivial+monoid"} trivial monoid
            structure given by the identity function on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            and the (left or right)
            %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            respectively, and composition algebra objects are the same as
            %a.existingWikiWord{:href => "/nlab/show/magma"} magma
            objects.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+construction"} Cayley-Dickson construction
            %li
              %p
                %em> un-related
                \:
                %a.existingWikiWord{:href => "/nlab/show/composition+ring"} composition ring
          %h2#References References
          %p The term “composition algebra” refers to “composition of sums of squares”, as in
          %ul
            %li#Taussky70
              Olga Taussky, Section 6 of:
              = succeed "," do
                %em Sums of squares
              %strong 77
              8 (1970) 805-830
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              %a{:href => "https://doi.org/10.2307/2317016"} doi:10.2307/2317016
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p Monographs:
          %ul
            %li#SpringerVeltkamp00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tonny+Springer"}> Tonny Springer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ferdinand+Veldkamp"} Ferdinand Veldkamp
                = succeed "," do
                  %em Octonions, Jordan Algebras, and Exceptional Groups
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Conway"}> John Conway
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Derek+Smith"} Derek Smith
                = succeed "," do
                  %em On Quaternions and Octonions: Their Geometry, Arithmetic and Symmetry
                = succeed "," do
                  %a{:href => "https://www.routledge.com/On-Quaternions-and-Octonions/Conway-Smith/p/book/9781568811345"} ISBN:9781568811345
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1201/9781439864180"} doi:10.1201/9781439864180
          %p Survey:
          %ul
            %li#Elduque21
              %a.existingWikiWord{:href => "/nlab/show/Alberto+Elduque"}> Alberto Elduque
              ,
              = succeed "," do
                %em Composition algebras
              = succeed "," do
                %em Algebra and Applications I: Non-associative Algebras and Categories
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1810.09979"} arXiv:1810.09979
              = succeed "&rbrack;" do
                %a{:href => "https://www.wiley.com/en-ae/Algebra+and+Applications+1:+Non+associative+Algebras+and+Categories-p-9781789450170"} ISBN:978-1-789-45017-0
          %p
            A general abstract formulation of
            %a{:href => "#Rost96"} Rost 96
          %ul
            %li#Rost96
              Markus Rost,
              = succeed "," do
                %em On the dimension of a composition algebra
              %strong 1
              (1996), 209-214,
              %a{:href => "http://www.math.uni-bielefeld.de/documenta/vol-01/10.html"} files
              Abstract: “The possible dimensions of a composition algebra are 1, 2, 4, or 8. We give a tensor categorical argument.”
          %p
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
            in
            %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
            is in
          %ul
            %li#Street18
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              %em Vector product and composition algebras in braided monoidal additive categories
              (
              %a{:href => "https://arxiv.org/abs/1812.04143"}> arXiv:1812.04143
              )
          %p
            An exposition of the
            %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
            proof of the
            %a{:href => "HurwitzTheoremSection"} Hurwitz’ theorem
            on the classification of compositon algebras is given in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bruce+Westbury"}> Bruce Westbury
                ,
                %em Hurwitz’ theorem on composition algebras
                (
                %a{:href => "http://arxiv.org/abs/1011.6197"}> arXiv:1011.6197
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
                ‘s
                %a{:href => "http://golem.ph.utexas.edu/category/2010/03/division_algebras_and_supersym.html#c032790"} comment
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Conway"}> John Conway
                , Derek A. Smith,
                = succeed "," do
                  %em On Quaternions and Octonions
            %li
              %p
                T.A. Springer, F.D. Veldkamp,
                = succeed "," do
                  %em Octonions, Jordan algebras, and exceptional groups
            %li
              %p
                %a{:href => "http://en.wikipedia.org/wiki/Composition_algebra"} wikipedia
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/eom"}> eom
                \:
                %a{:href => "http://eom.springer.de/l/l058360.htm"} Lie-admissible algebra
          %p
            A proposed application of (non-unital) composition algebras in
            %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
            is described in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alessio+Marrani"}> Alessio Marrani
              , Daniele Corradetti, Francesco Zucconi.
              = succeed "." do
                %em Physics with non-unital algebras? An invitation to the Okubo algebra
              = succeed ")." do
                %a{:href => "https://arxiv.org/abs/2309.17435"} arXiv:2309.17435
