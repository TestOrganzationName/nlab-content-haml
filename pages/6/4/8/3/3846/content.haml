                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mi u
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} ⟩
