                            %mo ,
                            %mover
                              %mi u
                              %mo{:stretchy => "false"} ¯
                            %mo{:stretchy => "false"} ⟩
                            %mo{:stretchy => "false"} ⟨
                            %mi u
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} ⟩
                            %mo −
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo{:stretchy => "false"} )
