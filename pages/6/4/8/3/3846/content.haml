          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            with
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi char
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} char(k) \neq 2
            %strong unital composition algebra
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            consists of a
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            together with a
          %ul
            %li
              %p
                a nondegenerate symmetric
                %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                      %mo :
                      %mi V
                      %mo ⊗
                      %mi V
                      %mo →
                      %mi k
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\langle - , - \rangle: V \otimes V \to k
                      \\,,
            %li
              %p
                a multiplication map, i.e., a
                %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⋅
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi V
                      %mo ⊗
                      %mi V
                      %mo →
                      %mi V
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \- \cdot - \;\colon\; V \otimes V \to V
                      \\,,
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/unit"} unit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} e \in V
                for the multiplication, i.e., so that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ⋅
                        %mi v
                        %mo =
                        %mi v
                        %mo =
                        %mi v
                        %mo ⋅
                        %mi e
                      %annotation{:encoding => "application/x-tex"} e \cdot v = v = v \cdot e
          %p such that:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo ⋅
                  %mi v
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi u
                  %mo ⋅
                  %mi v
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} ⟨
                  %mi v
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\langle u\cdot v ,\, u \cdot v \rangle
                  \\;=\;
                  \\langle u,u \rangle
                  \\langle v,v \rangle
          %p
            The bilinear form defines a
            %em
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} N(u) = \langle u,u\rangle
          %p
            Beware that there are
            %em no
            assumptions on the multiplication such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutativity"} commutativity
          %p
            Examples of composition algebras include the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"}
              algebra of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              matrices
            over a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
          %p
            Since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi char
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} char(k) \neq 2
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            from the
            %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mfrac
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo +
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \langle u, v \rangle = \frac{N(u + v) - N(u) - N(v)}{2}
          %p
            Since the bilinear form is nondegenerate, we may infer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo =
                  %mi v
                %annotation{:encoding => "application/x-tex"} u = v
            whenever
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle u, w \rangle = \langle v, w \rangle
          %p and this will be frequently used in the sequel.
          %p
            Also since the form is nondegenerate, there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} v \in V
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N(v) \neq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(v) = N(e v) = N(e)N(v)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} N(e) = 1
          %h3#para_and_nonunital_composition_algebras Para- and non-unital composition algebras
          %p
            Frequently, one refers to
            %em unital
            composition algebras simply as composition algebras. However, this unital property can be weakened or removed altogether. A weakening of this condition leads to
            %strong para-unital
            composition algebras. This requires the existence of an involution
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"}
                  x\mapsto\bar{x}
          %p
            such that there exists a distinguished element
            = succeed "," do
              %strong 1
            = succeed "," do
              %strong para-unit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋅
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo ⋅
                  %mi x
                  %mo =
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"}
                  x\cdot \mathbf{1} = \mathbf{1}\cdot x = \bar{x}
          %p
            meaning
            %strong 1
            acts as a unit up to an involution.
          %p
            On the other hand, removing the existence of a unit altogether leads to the notion of
            %strong non-unital
            composition algebras.
          %p
            These two generalizations of composition algebras are intimately related to a generalization of the
            %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"} Hurwitz theorem
            (see
            %a{:href => "https://ncatlab.org/nlab/show/Hurwitz+theorem#generalized_hurwitz_theorem"} generalized Hurwitz theorem
            for the statement).
          %h2#properties Properties
          %h3#basic_identities Basic identities
          %p The arrangements of the proofs below are based in part on the treatments by Conway and Smith, and by Springer and Veldkamp (see references below).
          %p
          .num_prop
            %h6 Proposition
            %p
              (Scaling)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u v, u w \rangle = N(u)\langle v, w \rangle
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi w
                    %mo ,
                    %mi v
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle u w, v w \rangle = \langle u, v \rangle N(w)
          .proof
            %h6#proof Proof
            %p The left sides, and therefore the right sides of the equations below are equal:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo +
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo +
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(u(v + w)) = N(u)N(v + w) = N(u)(N(v) + 2\langle v, w \rangle + N(w))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo +
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(u v + u w) = N(u v) + 2\langle u v, u w \rangle + N(u w) = N(u)N(v) + 2\langle u v, u w \rangle + N(u)N(w)
            %p
              and the result follows by cancellation and division by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
          %p
          .num_prop
            %h6 Proposition
            %p
              (Exchange)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi w
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi x
                    %mo ,
                    %mi w
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u v, w x \rangle = 2\langle u, w \rangle \langle v, x \rangle - \langle u x, w v \rangle
          .proof
            %h6#proof_2 Proof
            %p From the scaling identity, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo +
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mi v
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo +
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo +
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi u
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi w
                    %mi v
                    %mo ,
                    %mi w
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle (u + w)v, (u + w)x \rangle = N(u + w)\langle v, x \rangle = N(u)\langle v, x \rangle + 2\langle u, w \rangle \langle v, x \rangle + N(w)\langle v, x \rangle = \langle u v, u x \rangle + 2\langle u, w \rangle \langle v, x \rangle + \langle w v, w x \rangle
            %p but the left-hand side is equal to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo +
                    %mi w
                    %mi v
                    %mo ,
                    %mi u
                    %mi x
                    %mo +
                    %mi w
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi u
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi w
                    %mi v
                    %mo ,
                    %mi u
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi w
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi w
                    %mi v
                    %mo ,
                    %mi w
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u v + w v, u x + w x \rangle = \langle u v, u x \rangle + \langle w v, u x \rangle + \langle u v, w x \rangle + \langle w v, w x \rangle
            %p and now we equate the right-hand sides and cancel to get the result.
          %h4#conjugation_identities Conjugation identities
          %p
            In any composition algebra, we may define a
            %strong conjugation
            operator by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo =
                  %mn 2
                  %mo{:stretchy => "false"} ⟨
                  %mi v
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} ⟩
                  %mi e
                  %mo −
                  %mi v
                %annotation{:encoding => "application/x-tex"} \bar{v} = 2\langle v, e \rangle e - v
          %p
            Observe that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo =
                  %mi v
                %annotation{:encoding => "application/x-tex"} \bar{v} = v
            just when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is a scalar multiple of the identity. By analogy with the classical case (composition algebras over
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "." do
              %strong real
          %p The next few propositions develop properties of conjugation.
          %p
          .num_prop
            %h6 Proposition
            %p
              (Adjointness)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u v, w \rangle = \langle v, \bar{u}w \rangle
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mi v
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi w
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle u v, w \rangle = \langle u, w\bar{v} \rangle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi w
                    %mo ,
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mi w
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle w, u v \rangle = \langle \bar{u} w, v \rangle
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi w
                      %mo ,
                      %mi u
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi w
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo .
                      %mi u
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle w, u v \rangle = \langle w\bar{v}. u \rangle
          .proof
            %h6#proof_3 Proof
            %p
              Put
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} x = e
              in the exchange identity to get the first equation in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} ⟩
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} ⟩
                    %mi e
                    %mo −
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u v, w \rangle = 2\langle u, w \rangle \langle v, e \rangle - \langle u, w v \rangle = \langle u, w(2\langle v, e\rangle e - v)\rangle = \langle u, w\bar{v} \rangle
            %p The second adjointness equation is proved similarly; the final two come from symmetry of the form.
          %p
          .num_prop
            %h6 Proposition
            %p
              (Involution)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mover
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} v = \bar{\bar{v}}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
          .proof
            %h6#proof_4 Proof
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mover
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u, v \rangle = \langle u\bar{v}, e \rangle = \langle u, \bar{\bar{v}} \rangle
            %p and the result follows from nondegeneracy.
          %p
          .num_prop
            %h6 Proposition
            %p
              (Unitarity)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo ,
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                      %mo ,
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle u, v \rangle = \langle \bar{v}, \bar{u} \rangle = \langle \bar{u}, \bar{v} \rangle
              %br/
          .proof
            %h6#proof_5 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi e
                    %mo ,
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u, v \rangle = \langle e, \bar{u}v \rangle = \langle \bar{v}, \bar{u} \rangle = \langle \bar{u}, \bar{v} \rangle
              where the last equation is symmetry of the bilinear form.
          %p
          .num_prop
            %h6 Proposition
            %p
              (Anti-automorphism)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo =
                      %mover
                        %mrow
                          %mi v
                          %mi u
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \bar{u} \bar{v} = \widebar{v u}
          .proof
            %h6#proof_6 Proof
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi v
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mrow
                        %mi v
                        %mi u
                      %mo ¯
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \bar{u}\bar{v}, w \rangle = \langle \bar{v}, u w \rangle = \langle \bar{v}\bar{w}, u \rangle = \langle \bar{w}, v u \rangle = \langle \widebar{v u}, w \rangle
            %p using involution and unitarity. The result follows from nondegeneracy of the form.
          %p
            By the involution and anti-automorphism properties, we see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mi v
                %annotation{:encoding => "application/x-tex"} \bar{v}v
            is fixed under conjugation: is “real”. Better yet,
          %p
          .num_prop
            %h6 Proposition
            %p
              (Reality)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mi v
                    %annotation{:encoding => "application/x-tex"} \bar{u} \cdot (u v) = N(u)v
          .proof
            %h6#proof_7 Proof
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                    %annotation{:encoding => "application/x-tex"} w
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mi v
                    %mo ,
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \bar{u}\cdot (u v), w \rangle = \langle u v, u w \rangle = N(u)\langle v, w \rangle = \langle N(u)v, w \rangle
            %p and the result follows from nondegeneracy.
          %p
            This last result has several interesting corollaries. Putting
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} v = e
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} N(u) \neq 0
                implies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                is invertible, with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi u
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} /
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} u^{-1} = \bar{u}/N(u)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} N(u) = 0
                implies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                is a zero divisor, with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ¯
                        %mi u
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \bar{u} u = 0
          %p
            In either case, we have from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ¯
                  %mo =
                  %mn 2
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} ⟩
                  %mi e
                  %mo −
                  %mi u
                %annotation{:encoding => "application/x-tex"} \bar{u} = 2\langle u, e \rangle e - u
            the identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ¯
                  %mi u
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} ⟩
                  %mi e
                  %mo −
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mi u
                  %mo =
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mi e
                %annotation{:encoding => "application/x-tex"} \bar{u} u = (2\langle u, e \rangle e - u)u = N(u)e
          %p
            so that every element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            of a composition algebra satisfies a quadratic equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mn 2
                  %mo −
                  %mn 2
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} ⟩
                  %mi u
                  %mo +
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mi e
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} u^2 - 2\langle u, e \rangle u + N(u)e = 0.
          %p
            This has as further consequence the fact that an algebra admits at most one norm making it a composition algebra (because the minimal monic polynomial of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            in a finite-dimensional algebra is uniquely determined; the norm of an element would the uniquely determined constant coefficient of its minimal polynomial).
          %p
            A final corollary of
            %strong Reality
            is
          %p
          .num_prop
            %h6 Proposition
            %p
              (Alternative law)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi u
                      %mn 2
                    %mo ⋅
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \cdot (u v) = u^2 \cdot v
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ⋅
                      %msup
                        %mi v
                        %mn 2
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi v
                    %annotation{:encoding => "application/x-tex"} u \cdot v^2 = (u v) \cdot v
          .proof
            %h6#proof_8 Proof
            %p
              We have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mi v
                  %annotation{:encoding => "application/x-tex"} w(u v) = (w u)v
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              is either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar{u}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is a linear combination of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar{u}
          %p
            These are the two axioms as given in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u (v u) = (u v) u
          %h3#cayleydickson_doubling_construction Cayley-Dickson doubling construction
          %p
            This is essentially the same as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+construction"} Cayley-Dickson construction
          %p We begin with a simple observation:
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a finite-dimensional vector space with a nondegenerate bilinear form, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              be a subspace such that the form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              restricts to a nondegenerate form on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi W
                    %mo ⊕
                    %msup
                      %mi W
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} V = W \oplus W^\perp
            %p
              and the form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              restricts to a nondegenerate form on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi W
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} W^\perp
          .proof
            %h6#proof_9 Proof
            %p
              The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ∩
                    %msup
                      %mi W
                      %mo ⊥
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} W \cap W^\perp = \{0\}
              is immediate from nondegeneracy of the form on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo +
                    %msup
                      %mi W
                      %mo ⊥
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} W + W^\perp = V
              follows from this and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi W
                      %mo ⊥
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(W) + dim(W^\perp) = dim(V)
              (use
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi W
                      %mo ⊥
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mi W
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(W^\perp) = dim((V/W)^*) = dim(V/W)
              and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} /
                      %mi W
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} dim(V) = dim(W) + dim(V/W)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %msup
                        %mi W
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} v \in W^\perp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi W
                    %mo :
                    %mi W
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \langle v, - \rangle |_W: W \to k
              is zero; if also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi W
                          %mo ⊥
                    %mo :
                    %msup
                      %mi W
                      %mo ⊥
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \langle v, - \rangle |_{W^\perp}: W^\perp \to k
              is zero, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi V
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \langle v, - \rangle: V \to k
              is zero because
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi W
                      %mo +
                      %msup
                        %mi W
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} V = W + W^\perp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} v = 0
              follows from nondegeneracy of the form on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %p
            Thus, given a composition algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and a composition subalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            (that is, a subspace closed under identity and multiplication, such that the norm on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            restricts to a nondegenerate form on
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∈
                  %msup
                    %mi W
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \alpha \in W^\perp
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N(\alpha) \neq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is invertible, so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ⋅
                  %mi W
                %annotation{:encoding => "application/x-tex"} \alpha \cdot W
            has the same dimension as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ,
                  %mi w
                  %mo ∈
                  %mi W
                %annotation{:encoding => "application/x-tex"} v, w \in W
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi α
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi α
                  %mo ,
                  %mi w
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \langle \alpha v, w \rangle = \langle \alpha, w \bar{v} \rangle = 0
          %p
            so that, by nondegeneracy of the form on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mi W
                    %mo ∩
                    %mi W
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \alpha W \cap W = \{0\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mi W
                %annotation{:encoding => "application/x-tex"} \alpha W
            is orthogonal to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo +
                  %mi α
                  %mi W
                %annotation{:encoding => "application/x-tex"} W + \alpha W
            has double the dimension of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %p
            Now let us fix such an
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda = N(\alpha)
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ,
                      %mi v
                      %mo ,
                      %mi w
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi W
                    %annotation{:encoding => "application/x-tex"} u, v, w, x \in W
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo +
                    %mi α
                    %mi v
                    %mo ,
                    %mi w
                    %mo +
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %mi λ
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \langle u + \alpha v, w + \alpha x \rangle = \langle u, w \rangle + \lambda \langle v, x \rangle.
          .proof
            %h6#proof_10 Proof
            %p This follows from the equations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo ,
                    %mi w
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi v
                    %mo ,
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u, \alpha x \rangle = \langle u \bar{x}, \alpha \rangle = 0 \qquad \langle \alpha v, w \rangle = \langle \alpha, w \bar{v} \rangle = 0 \qquad \langle \alpha v, \alpha x \rangle = N(\alpha)\langle v, x \rangle
            %p plus bilinearity of the form.
          %p
            Consequently, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo +
                  %mi α
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \langle u + \alpha v, w \rangle = 0
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %mi W
                  %annotation{:encoding => "application/x-tex"} w \in W
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} u = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo +
                  %mi α
                  %mi v
                  %mo ,
                  %mi α
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \langle u + \alpha v, \alpha x \rangle = 0
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi W
                  %annotation{:encoding => "application/x-tex"} x \in W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} v = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo +
                    %mi α
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W + \alpha W
          %p
            Now we want to show that the double
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo +
                  %mi α
                  %mi W
                %annotation{:encoding => "application/x-tex"} W + \alpha W
            is closed under multiplication, hence forms a composition subalgebra. It follows immediately from all this that, starting from the trivial composition subalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ⋅
                  %mi e
                %annotation{:encoding => "application/x-tex"} k \cdot e
            of dimension 1,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} dim(V)
            must be a power of 2, and in fact we will see later that the only possible dimensions are 1, 2, 4, and 8. Indeed, the possible structures of composition algebras are very tightly constrained.
          %p
          .num_prop
            %h6 Proposition
            %p
              (Conjugation on the double) We have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi u
                          %mo +
                          %mi α
                          %mi v
                        %mo ¯
                      %mo =
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                      %mo −
                      %mi α
                      %mi v
                    %annotation{:encoding => "application/x-tex"} \widebar{u + \alpha v} = \bar{u} - \alpha v
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mi v
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mover
                        %mrow
                          %mi α
                          %mi v
                        %mo ¯
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mover
                        %mi α
                        %mo{:stretchy => "false"} ¯
                      %mo =
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha v = - \widebar{\alpha v} = - \bar{v} \bar{\alpha} = \bar{v} \alpha
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi α
                        %mo ¯
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \widebar{\alpha} = -\alpha
              %br/
          .proof
            %h6#proof_11 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi α
                        %mi v
                      %mo ¯
                    %mo =
                    %mn 2
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi v
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} ⟩
                    %mi e
                    %mo −
                    %mi α
                    %mi v
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi α
                    %mi v
                  %annotation{:encoding => "application/x-tex"} \widebar{\alpha v} = 2\langle \alpha v, e \rangle e - \alpha v = -\alpha v
              \.
          %p
          .num_theorem
            %h6 Theorem
            %p
              (Closure under multiplication) For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ,
                      %mi v
                      %mo ,
                      %mi w
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi W
                    %annotation{:encoding => "application/x-tex"} u, v, w, x \in W
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo +
                      %mi α
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mo +
                      %mi α
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mi w
                      %mo −
                      %mi λ
                      %mi x
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mi v
                      %mo +
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ¯
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (u + \alpha v)(w + \alpha x) = (u w - \lambda x \bar{v}) + \alpha (w v + \bar{u} x)
          .proof
            %h6#proof_12 Proof
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} y \in V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi x
                    %mo ,
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mover
                      %mo =
                      %mi Ex
                    %mn 0
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi y
                    %mo ,
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi y
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle u (\alpha x), y \rangle = \langle \alpha x, \bar{u} y \rangle \stackrel{Ex}{=} 0 - \langle \alpha y, \bar{u} x \rangle = \langle y, \alpha (\bar{u} x) \rangle = \langle \alpha (\bar{u} x), y \rangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mi w
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi v
                    %mo ,
                    %mi y
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} ⟩
                    %mover
                      %mo =
                      %mi Conj
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mi α
                    %mo ,
                    %mi y
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} ⟩
                    %mover
                      %mo =
                      %mi Ex
                    %mn 0
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi y
                    %mi α
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %mi α
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mrow
                        %mi w
                        %mi v
                      %mo ¯
                    %mi α
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mover
                      %mo =
                      %mi Conj
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle (\alpha v)w, y \rangle = \langle \alpha v, y \bar{w} \rangle \stackrel{Conj}{=} \langle \bar{v} \alpha, y \bar{w} \rangle \stackrel{Ex}{=} 0 - \langle \bar{v}\bar{w}, y \alpha \rangle = \langle (\bar{v}\bar{w})\alpha, y \rangle = \langle \widebar{w v} \alpha, y \rangle \stackrel{Conj}{=} \langle \alpha (w v), y \rangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mover
                      %mo =
                      %mi Conj
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi v
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mover
                      %mo =
                      %mi Ex
                    %mn 0
                    %mo +
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mover
                      %mo =
                      %mi Conj
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mi x
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi λ
                    %mo{:stretchy => "false"} ⟨
                    %mi x
                    %mo ,
                    %mi y
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi λ
                    %mi x
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle (\alpha v)(\alpha x), y \rangle \stackrel{Conj}{=} -\langle \alpha v, y (\alpha x) \rangle \stackrel{Ex}{=} 0 + \langle \alpha (\alpha x), y v \rangle \stackrel{Conj}{=} -\langle \alpha x, \alpha (y v) \rangle = -\lambda \langle x, y v \rangle = \langle -\lambda x\bar{v}, y \rangle
            %p These identities, combined with nondegeneracy of the form, give the result.
          %h4#possible_dimensions_are_1_2_4_and_8 Possible dimensions are 1, 2, 4, and 8.
          %p The calculation expressed by the fundamental theorem just stated has some remarkable consequences:
          %ul
            %li
              Suppose
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi W
                      %mo +
                      %mi α
                      %mi W
                    %annotation{:encoding => "application/x-tex"} V = W + \alpha W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is an
              %em associative
              composition algebra.
          %p For, by starting from the identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo +
                  %mi α
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo +
                  %mi α
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mi w
                  %mo −
                  %mi λ
                  %mi x
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mi v
                  %mo +
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ¯
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(u + \alpha v)N(w + \alpha x) = N((u w - \lambda x \bar{v}) + \alpha (w v + \bar{u} x))
          %p and expanding, one obtains
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi λ
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi λ
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mn 2
                  %mi λ
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mi w
                  %mo ,
                  %mi x
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %msup
                    %mi λ
                    %mn 2
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} ⟨
                  %mi w
                  %mi v
                  %mo ,
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ¯
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ¯
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (N(u) + \lambda N(v))(N(w) + \lambda N(x)) = N(u w) - 2\lambda \langle u w, x\bar{v} \rangle + \lambda^2 N(x\bar{v}) + \lambda (N(w v) + 2\langle w v, \bar{u} x \rangle + N(\bar{u}x))
          %p
            Using the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is a homomorphism, plus unitarity
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(u) = N(\bar{u})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 2
                  %mi λ
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mi w
                  %mo ,
                  %mi x
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mn 2
                  %mi λ
                  %mo{:stretchy => "false"} ⟨
                  %mi w
                  %mi v
                  %mo ,
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ¯
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} 0 = -2\lambda \langle u w, x\bar{v} \rangle + 2\lambda \langle w v, \bar{u}x \rangle
          %p which, by adjointness, yields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mi v
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi u
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle (u w)v, x \rangle = \langle u(w v), x \rangle
          %p
            which by nondegeneracy on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mi v
                    %mo =
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (u w)v = u(w v)
          %ul
            %li
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi W
                    %mo +
                    %mi α
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V = W + \alpha W
              is an associative composition algebra. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is a
              %em commutative, associative
              composition algebra.
          %p
            For clearly the subalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            must be associative; it is also commutative via the following string of equations (using conjugation of the double):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mi w
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mi w
                  %mo =
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi w
                    %mo{:stretchy => "false"} ¯
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mover
                    %mi w
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mi α
                  %mo =
                  %mover
                    %mrow
                      %mi w
                      %mi v
                    %mo ¯
                  %mi α
                  %mo =
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(v w) = (\alpha v)w = (\bar{v}\alpha)w = \bar{v}(\alpha w) = \bar{v}(\bar{w} \alpha) = (\bar{v}\bar{w})\alpha = \widebar{w v}\alpha = \alpha (w v)
          %p
            and cancelling out
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          %p
            Conversely, a lengthy but straightforward calculation shows that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is commutative and associative, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is associative.
          %ul
            %li
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi W
                    %mo +
                    %mi α
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V = W + \alpha W
              is a commutative associative composition algebra. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is purely real, i.e., is the trivial 1-dimensional associative commutative algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ⋅
                      %mi e
                    %annotation{:encoding => "application/x-tex"} k \cdot e
          %p This results from
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mi w
                  %mover
                    %mo =
                    %mi Conj
                  %mover
                    %mi w
                    %mo{:stretchy => "false"} ¯
                  %mi α
                  %mover
                    %mo =
                    %mi comm
                  %mi α
                  %mover
                    %mi w
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \alpha w \stackrel{Conj}{=} \bar{w}\alpha \stackrel{comm}{=} \alpha \bar{w}
          %p
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo =
                  %mover
                    %mi w
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} w = \bar{w}
            for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %mi W
                  %annotation{:encoding => "application/x-tex"} w \in W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            is real. Conversely, from
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo +
                  %mi α
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo +
                  %mi α
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mi w
                  %mo −
                  %mi λ
                  %mi x
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mi v
                  %mo +
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ¯
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (u + \alpha v)(w + \alpha x) = (u w - \lambda x\bar{v}) + \alpha (w v + \bar{u} x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo +
                  %mi α
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo +
                  %mi α
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mi u
                  %mo −
                  %mi λ
                  %mi v
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mi x
                  %mo +
                  %mover
                    %mi w
                    %mo{:stretchy => "false"} ¯
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w + \alpha x)(u + \alpha v) = (w u - \lambda v\bar{x}) + \alpha (u x + \bar{w} v)
          %p
            together with commutativity and trivial conjugation in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p Hence the doubling process may be iterated three times at most.
          %p
            This same result can also be proven using
            %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
            calculus. See
            %a{:href => "http://math.ucr.edu/home/baez/Hurwitz.pdf"} this paper
            for a nice exposition of that route.
          %h3#HurwitzTheoremSection Hurwitz’s Theorem
          %p
            The classification of composition algebras over specific fields (e.g.,
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/local+fields"} local fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} k = \mathbb{R}
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"} Hurwitz theorem
          %p
            A fundamental dichotomy is whether or not the composition algebra has zero divisors, i.e., elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N(v) = 0
            %strong split
            composition algebra. We analyze each in turn.
          .num_prop
            %h6#proposition_3 Proposition
            %p In a division composition algebra, all nonzero elements have positive norm.
          .proof
            %h6#proof_13 Proof
            %p
              If all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              orthogonal to the identity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              have positive norm, the result is immediate since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mi v
                    %mo +
                    %mi s
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi r
                      %mn 2
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msup
                      %mi s
                      %mn 2
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N(r v + s e) = r^2 N(v) + s^2 \geq 0
            %p
              Otherwise, if some such element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              has
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi λ
                      %mo &lt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} N(v) = \lambda \lt 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mi v
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} |
                    %mi λ
                    %msup
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} u = v/|\lambda|^{1/2}
              so that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N(u) = -1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is orthogonal to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo +
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo +
                    %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N(u + e) = N(u) + N(e) = -1 + 1 = 0
            %p which contradicts the assumption that all nonzero elements are invertible.
          %p
            In particular, any division composition algebra is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a division composition algebra, with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi W
                    %mo +
                    %mi α
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V = W + \alpha W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≠
                    %mi α
                    %mo ∈
                    %msup
                      %mi W
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} 0 \neq \alpha \in W^\perp
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo =
                    %mi α
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi α
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} j = \alpha/N(\alpha)^{1/2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} N(j) = 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ⊥
                    %mi W
                  %annotation{:encoding => "application/x-tex"} j \perp W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi W
                    %mo +
                    %mi j
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V = W + j W
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} dim(V) = 2
                \. In that case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is purely real and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is a commutative field over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mi j
                          %mn 2
                        %mo =
                        %mi j
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ¯
                        %mo =
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} -j^2 = j\bar{j} = N(j) = 1
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo +
                      %mi j
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi s
                        %mn 2
                      %mo +
                      %msup
                        %mi t
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} N(s + j t) = s^2 + t^2
              %p
                the usual norm. The conjugate of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo +
                      %mi j
                      %mi t
                    %annotation{:encoding => "application/x-tex"} s + j t
                is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo −
                        %mi j
                        %mi t
                      %annotation{:encoding => "application/x-tex"} s - j t
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} dim(V) = 4
                \. In that case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is a 2-dimensional division composition algebra, hence isomorphic to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is an associative division algebra over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                given by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi ℂ
                        %mo +
                        %mi j
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} V = \mathbb{C} + j\mathbb{C}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi j
                          %mn 2
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} j^2 = -1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is not commutative because
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is not purely real.) By conjugation of the double, we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mi i
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j i = -i j
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                is an imaginary unit of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ,
                        %mi i
                        %mo ,
                        %mi j
                        %mo ,
                        %mi k
                        %mo =
                        %mi i
                        %mi j
                      %annotation{:encoding => "application/x-tex"} 1, i, j, k = i j
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo +
                      %mi b
                      %mi i
                      %mo +
                      %mi c
                      %mi j
                      %mo +
                      %mi d
                      %mi k
                      %mo ↦
                      %mi a
                      %mo −
                      %mi b
                      %mi i
                      %mo −
                      %mi c
                      %mi j
                      %mo −
                      %mi d
                      %mi k
                    %annotation{:encoding => "application/x-tex"} a + b i + c j + d k \mapsto a - b i - c j - d k
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 8
                    %annotation{:encoding => "application/x-tex"} dim(V) = 8
                \. In that case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is a 4-dimensional division composition algebra, hence isomorphic to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℍ
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is an alternative division algebra over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                given by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi ℍ
                        %mo +
                        %mi j
                        %mi ℍ
                      %annotation{:encoding => "application/x-tex"} V = \mathbb{H} + j\mathbb{H}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi j
                          %mn 2
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} j^2 = -1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is not associative because
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is not commutative.) The structure of multiplication is given by the theorem above and the resulting algebra is the algebra of octonions, with the standard norm and conjugation.
          %p
            Thus, we have established the
            %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"} Hurwitz theorem
          %p
          .num_theorem
            %h6 Theorem
            %p
              (Hurwitz) The only
              %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division
              composition algebras over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              are the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            %p
          %h4#split_composition_algebras Split composition algebras
          %p
            Now we turn to split composition algebras
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %em not
            specific to the field
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            as we describe them below.
          %p
            Suppose
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi W
                    %mo +
                    %mi α
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V = W + \alpha W
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi W
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \alpha \in W^\perp
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N(\alpha) \neq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo =
                    %mi α
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} |
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} j = \alpha/|N(\alpha)|^{1/2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} |N(j)| = 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi W
                    %mo +
                    %mi j
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V = W + j W
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} dim(V) = 2
                \. In this case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N(j) = -1
                (else
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                would be a division algebra, not a split composition algebra) and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mn 2
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} j^2 = 1
                (we are now using
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                to denote the identity). The elements
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 1
                      %mo =
                      %mfrac
                        %mrow
                          %mn 1
                          %mo +
                          %mi j
                        %mn 2
                      %mspace{:width => "2em"}
                      %msub
                        %mi e
                        %mn 2
                      %mo =
                      %mfrac
                        %mrow
                          %mn 1
                          %mo −
                          %mi j
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e_1 = \frac{1 + j}{2} \qquad e_2 = \frac{1-j}{2}
              %p
                are primitive idempotents, conjugate to one another, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ≅
                      %mi ℝ
                      %msub
                        %mi e
                        %mn 1
                      %mo ⊕
                      %mi ℝ
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} V \cong \mathbb{R} e_1 \oplus \mathbb{R} e_2
                as a product ring. The norm of an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mi e
                        %mn 1
                      %mo +
                      %mi y
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x e_1 + y e_2
                is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi x
                        %msub
                          %mi e
                          %mn 1
                        %mo +
                        %mi y
                        %msub
                          %mi e
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi x
                        %mi y
                      %annotation{:encoding => "application/x-tex"} N(x e_1 + y e_2) = x y
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} dim(V) = 4
                \. Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                be an imaginary unit of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi i
                        %mo{:stretchy => "false"} ¯
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                    %annotation{:encoding => "application/x-tex"} \bar{i} = -i
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} |N(i)| = 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N(i) = -1
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is split), or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N(i) = 1
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is isomorphic to
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} N(j) = -1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                would be a division algebra, and we may replace
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                by the split algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo ′
                      %mo =
                      %mi ℝ
                      %mo +
                      %mi ℝ
                      %mi i
                      %mi j
                    %annotation{:encoding => "application/x-tex"} W' = \mathbb{R} + \mathbb{R} i j
                and still have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi W
                        %mo ′
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi j
                        %mi W
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} V = W' + j W'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is split; therefore, there is up to isomorphism only one split composition algebra of dimension 4. This is the algebra of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ×
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 \times 2
                matrices
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(A) = det(A)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                is embedded as the subalgebra of diagonal matrices; the element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
                may be taken to be the matrix
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mn 11
                        %mo =
                        %msub
                          %mi a
                          %mn 22
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} a_{11} = a_{22} = 0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mn 12
                        %mo =
                        %msub
                          %mi a
                          %mn 21
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} a_{12} = a_{21} = 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi A
                          %mo{:stretchy => "false"} ¯
                        %mo =
                        %mi Tr
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mi I
                        %mo −
                        %mi A
