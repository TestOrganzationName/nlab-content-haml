                      \\end{aligned}
                      \\right)
              %p and multiplication is given by the following formula, highly reminiscent of matrix multiplication but with some cross-product cross terms:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
