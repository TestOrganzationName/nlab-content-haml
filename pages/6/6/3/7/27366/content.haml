                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi T
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %msub
                            %mi W
                            %mi b
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    T(W_b)\cdot
                    T\Big(
                    {\big\vert
                    [n]
                    \\big\rangle}
                    \\Big)
                    \&amp;\equiv&amp;
                    W_b \, W_a \,
                    e^{\pi \mathrm{i} \tfrac{1}{k}}
                    \\,
                    e^{\pi \mathrm{i} \tfrac{n^2}{k}}
                    {\big\vert
                    [n]
                    \\big\rangle}
                    \\\
                    \&amp;=&amp;
                    e^{\pi \mathrm{i}
                    \\tfrac{
                    n^2
                    +
                    2n
                    +
                    1
                    }{k}}
                    {\big\vert
                    [n + 1]
                    \\big\rangle}
                    \\\
                    \&amp;=&amp;
                    e^{\pi \mathrm{i}
                    \\tfrac{
                    (n+1)^2
                    }{k}}
                    {\big\vert
                    [n + 1]
                    \\big\rangle}
                    \\\
                    \&amp;=&amp;
                    T\Big(
                    W_b
                    {\big\vert
                    [n]
                    \\big\rangle}
                    \\Big)
                    \\mathrlap{\,.}
                    \\end{array}
            %p This completes the proof.
          %h3#AsQuotientsOfSurfaceBraidGroups As quotients of surface braid group
          %p
            The level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} =2
            Heisenberg extensions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℤ
                    %mrow
                      %mn 2
                      %mi g
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}^{2g}
            by the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mn 2
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mi g
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_{2(n+g-1)}
            arise as
            %a.existingWikiWord{:href => "/nlab/show/quotient+groups"} quotient groups
            of
            %a.existingWikiWord{:href => "/nlab/show/surface+braid+groups"} surface braid groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Br
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Br_n(\Sigma_{g})
            of the
            %a.existingWikiWord{:href => "/nlab/show/surface"} surface
            of
            %a.existingWikiWord{:href => "/nlab/show/genus+of+a+surface"} genus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n \geq 3
            \&amp;lbrack;
            %a{:href => "#BellingeriGervaisGuaschi08"}> Bellingeri, Gervais &amp; Guaschi 2008 (10)
            \&amp;rbrack;.
          %p
            Under the identification of these level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} =2
            Heisenberg groups with the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \pi_1
            of 2-
            %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
            %a.existingWikiWord{:href => "/nlab/show/cocycle+spaces"} cocycle spaces
            (see
            = succeed ")" do
              %a{:href => "cohomotopy#CohomotopyModuliOfSurfaces"} there
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(-)
            of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/cohomotopy+charge+map"} cohomotopy charge map
            %a.existingWikiWord{:href => "/nlab/show/scanning+map"} scanning map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Conf
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi Map
                    %mrow
                      %mi n
                      %mo +
                      %mi g
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Conf_n(\Sigma)
                  \\longrightarrow
                  Map_{n+g-1}(\Sigma, S^2)
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"}
              configuration space of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              points
            of the surface.
          %blockquote
            %p
              This observation is due to
              %a.existingWikiWord{:href => "/nlab/show/Martin+Palmer"} Martin Palmer
              (private communication, April 2025). It may be seen from the
              %a.existingWikiWord{:href => "/nlab/show/finitely+presented+group"} presentation
              given by
              = succeed ":" do
                %a{:href => "#BellingeriGervaisGuaschi08"} BGG08 (10)
              %a{:href => "braid+group#PresentationOfGeneralBraids"} Artin generator
