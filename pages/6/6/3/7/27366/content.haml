                            %mrow
                              %mo{:stretchy => "false"} [
                              %mover
                                %mover
                                  %mi n
                                  %mo ^
                                %mo ^
                              %mo{:stretchy => "false"} ]
                          %mspace{:width => "thinmathspace"}
                          %munder
                            %munder
                              %mrow
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mi k
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %mover
                                      %mi n
                                      %mo ^
                                    %mo{:stretchy => "false"} ]
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mi e
                                  %mrow
                                    %mn 2
                                    %mi π
                                    %mi{:mathvariant => "normal"} i
                                    %mstyle{:displaystyle => "false"}
