                            %mover
                              %mi n
                              %mo ^
                            %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi e
                        %mrow
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi π
                                %mi{:mathvariant => "normal"} i
                              %mi k
                          %mo{:stretchy => "false"} (
                          %msup
                            %mover
                              %mi n
                              %mo ^
                            %mn 2
                          %mo +
                          %mn 2
                          %mover
                            %mi n
                            %mo ^
