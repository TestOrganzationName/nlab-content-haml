              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi i
                  %annotation{:encoding => "application/x-tex"} b_i
              ).
          %p
            The analogous statement of surfaces with one
            %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+manifold"} boundary
            %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
