            %p
          %p
          #BasicIntHeisenbergAsUpperTriangularMatrices.num_remark
            %h6 Remark
            %p
              The basic integer Heisenberg group extension
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:BasicIntegerHeisenbergExtensionOfZ2"} (1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k = 0
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/matrix+group"} matrix group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                    %mo ×
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3 \times 3
              %a.existingWikiWord{:href => "/nlab/show/upper+triangular+matrices"} upper triangular matrices
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              entries and all “1”s on their diagonal, since
              %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
              gives:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mi a
                            %mtd
                              %mi c
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                            %mtd
                              %mi b
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                      %mo ]
                    %mo ⋅
                    %mrow
                      %mo [
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mi a
                              %mo ′
                            %mtd
                              %mi c
                              %mo ′
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                            %mtd
                              %mi b
                              %mo ′
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                      %mo ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mi a
                              %mo +
                              %mi a
                              %mo ′
                            %mtd
                              %mi c
                              %mo +
                              %mi c
                              %mo ′
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mi a
                              %mi b
                              %mo ′
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                            %mtd
                              %mi b
                              %mo +
                              %mi b
                              %mo ′
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\left[
                    \\begin{matrix}
                    1 &amp; a &amp; c
                    \\\
                    0 &amp; 1 &amp; b
                    \\\
                    0 &amp; 0 &amp; 1
                    \\end{matrix}
                    \\right]
                    \\cdot
                    \\left[
                    \\begin{matrix}
                    1 &amp; a' &amp; c'
                    \\\
                    0 &amp; 1 &amp; b'
                    \\\
                    0 &amp; 0 &amp; 1
                    \\end{matrix}
                    \\right]
                    \\;=\;
                    \\left[
                    \\begin{matrix}
                    1 &amp; a + a' &amp; c + c' + a b'
                    \\\
                    0 &amp; 1 &amp; b + b'
                    \\\
                    0 &amp; 0 &amp; 1
                    \\end{matrix}
                    \\right]
            %p
              In this matrix form the basic integer Heisenberg group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_3(\mathbb{Z})
              is commonly known in the pure
              = succeed "-literature" do
                %a.existingWikiWord{:href => "/nlab/show/group+theory"} group theory
              = succeed "," do
                %a{:href => "#DummitFoote06"} Dummit &amp; Foote 2006 p 35
              = succeed ")" do
                %a{:href => "#Budylin14"} Budylin 2014
          %p
            But the relation to the
            %em real
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
            (in both senses of “real”) is made by the second multiple of this basic extension (cf.
            = succeed "," do
              %a{:href => "#GelcaUribe10"} Gelca &amp; Uribe 2010 p. 7
            = succeed "," do
              %a{:href => "#GelcaHamilton12"} Gelca &amp; Hamilton 2012 Def 2.4
            = succeed "):" do
              %a{:href => "#GelcaHamilton15"} Gelca &amp; Hamilton 2015 Def 2.3
          %p
          #TwiceHeisenbergExtensionInSymplecticForm.num_prop
            %h6 Proposition
            %p
              Twice the basic integer Heisenberg extension
              %a.maruku-eqref{:href => "#eq:IntegerHeisenbergExtension"} (3)
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to
            #eq:TwiceOfBasicIntegerHeisInSymplecticForm.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi a
                            %mo ,
                            %mi b
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ∈
                            %mspace{:width => "thinmathspace"}
                            %mi ℤ
                            %mo ×
                            %mi ℤ
                            %mo ×
                            %msub
                              %mi ℤ
                              %mi k
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi a
                            %mo ,
                            %mi b
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ⋅
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi a
                            %mo ′
                            %mo ,
                            %mi b
                            %mo ′
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo ′
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi a
                            %mo +
                            %mi a
                            %mo ′
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi b
                            %mo +
                            %mi b
                            %mo ′
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo +
                            %mi n
                            %mo ′
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mstyle{:mathcolor => "red"}
                              %mi a
                              %mo ⋅
                              %mi b
                              %mo ′
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi a
                              %mo ′
                              %mo ⋅
                              %mi b
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo }
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\begin{array}{l}
                    \\big(a, b, [n]\big)
                    \\,\in\,
                    \\mathbb{Z} \times \mathbb{Z} \times \mathbb{Z}_{k}
                    \\,,
                    \\\
                    \\big(
                    a, b, [n]
                    \\big)
                    \\cdot
                    \\big(
                    a', b', [n']
                    \\big)
                    \\;=\;
                    \\big(
                    a + a'
                    ,\,
                    b + b'
                    ,\,
                    [n + n' + {\color{red} a \cdot b' - a' \cdot b}]
                    \\big)
                    \\end{array}
                    \\right\}
                    \\mathrlap{\,.}
            %p
          .proof
            %h6 Proof
            %p
              It is sufficient to see that the second red summand in
              %a.maruku-eqref{:href => "#eq:TwiceOfBasicIntegerHeisInSymplecticForm"} (5)
              is a
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group 2-cocycle
              cohomologous to the first red summand, which means equivalently that the 2-cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ′
                    %mo ,
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi a
                    %mo ′
                    %mo ⋅
                    %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    (a, b), (a', b')
                    \\big)
                    \\;\mapsto\;
                    a \cdot b' + a' \cdot b
            %p
              has a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi a
                    %mo ⋅
                    %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (a, b) \;\mapsto\; - a \cdot b
                    \\,,
            %p since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo −
                    %mi a
                    %mo ′
                    %mo ⋅
                    %mi b
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo +
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi a
                    %mo ′
                    %mo ⋅
                    %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \- a \cdot b - a' \cdot  b'
                    \\,+\,
                    (a + a') \cdot (b + b')
                    \\;=\;
                    a \cdot b' + a' \cdot b
                    \\,.
            %p
          %h2#properties Properties
          %h3#basic_properties Basic properties
          %p
          .num_prop
            %h6 Proposition
            %p
              The multiple=2 discrete Heisenberg group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi k
                    %mo →
                    %mover
                      %mrow
                        %msup
                          %mi ℤ
                          %mn 2
                      %mo ^
                    %mo →
                    %msup
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{k} \to \widehat{\mathbb{Z}^{2}} \to \mathbb{Z}^2
              %a.maruku-eqref{:href => "#eq:TwiceOfBasicIntegerHeisInSymplecticForm"} (5)
              is the following
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+group"} product group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi ℤ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} F(a,b) \times \mathbb{Z}_{k}
              with the
              %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(a,b)
              on two generators:
            #eq:HeisenbergAsQuotientOfFreeGroup.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msup
                          %mi ℤ
                          %mn 2
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi ℤ
                      %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi b
                    %mo ⋅
                    %mi a
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{\mathbb{Z}^2}
                    \\,\simeq\,
                    \\big(
                    F(a,b) \times \mathbb{Z}_{k}
                    \\big)
                    \\big/
                    \\big( a \cdot b = [2] \cdot b \cdot a \big)
                    \\,.
            %p
          %p
          .proof
            %h6 Proof
            %p The map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo ,
                              %mi b
                              %mo{:stretchy => "false"} )
                              %mo ×
                              %msub
                                %mi ℤ
                                %mi k
                            %mrow
                              %mi a
                              %mo ⋅
                              %mi b
                              %mo =
                              %mo{:stretchy => "false"} [
                              %mn 2
                              %mo{:stretchy => "false"} ]
                              %mo ⋅
                              %mi b
                              %mo ⋅
                              %mi a
                        %mtd
                          %mover
                            %mo →
                            %mspace{:width => "thickmathspace"}
                        %mtd
                          %mover
                            %mrow
                              %msup
                                %mi ℤ
                                %mn 2
                            %mo ^
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi a
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi b
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo ,
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\frac{
                    F(a,b)
                    \\times
                    \\mathbb{Z}_{k}
                    }{
                    a \cdot b = [2] \cdot b \cdot a
                    }
                    \&amp;\xrightarrow{\;}&amp;
                    \\widehat{\mathbb{Z}^2}
                    \\\
                    [a] &amp;\mapsto&amp; (1,0,0)
                    \\\
                    [b] &amp;\mapsto&amp; (0,1,0)
                    \\\
                    [n] &amp;\mapsto&amp; (0,0,[n])
                    \\end{array}
            %p
              is clearly a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              on
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              since the quotient relation
              %a.maruku-eqref{:href => "#eq:HeisenbergAsQuotientOfFreeGroup"} (6)
              is respected in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msup
                            %mi ℤ
                            %mn 2
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathbb{Z}^2}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:BasicGroupCommutator"} (4)
          %p
            (cf. also
            = succeed "," do
              %a{:href => "https://arxiv.org/abs/2203.08030"} arXiv:2203.08030
            = succeed ")" do
              %a{:href => "https://arxiv.org/pdf/2203.08030#page=21"} p 21
          %h3#LinearRepresentations Linear representations
          %p
          .num_remark
            %h6 Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
              of twice the
              = succeed "-Heisenberg" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mrow
                          %mn 2
                          %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{2k}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}^2
              %a.maruku-eqref{:href => "#eq:TwiceOfBasicIntegerHeisInSymplecticForm"} (5)
            #eq:IrrepOfIntegerHeisenbergGroup.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mover
                            %mrow
                              %msup
                                %mi ℤ
                                %mn 2
                            %mo ^
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mi W
                              %mspace{:width => "thickmathspace"}
                        %mtd
                          %mi{:mathvariant => "normal"} Aut
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi.mathscript ℋ
                            %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\widehat{\mathbb{Z}^2}
                    \&amp;
                    \\xrightarrow{\; W \;}
                    \&amp;
                    \\mathrm{Aut}\big(
                    \\mathscr{H}_1
                    \\big)
                    \\end{array}
            %p are given by:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript ℋ
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Span
                      %mi ℂ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mn 0
                      %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ⋯
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi k
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{H}_1
                    \\;\coloneqq\;
                    Span_{\mathbb{C}}\Big(
                    {\vert 0 \rangle}
                    ,\,
                    {\vert 1 \rangle}
                    ,\,
                    \\cdots
                    ,\,
                    {\vert k-1 \rangle},
                    \\Big)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center center center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi a
                        %mtd
                          %mo ≔
                        %mtd
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mtd
                          %mo ↦
                        %mtd
                          %msup
                            %mi ζ
                            %mrow
                              %mn 2
                              %mi n
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi b
                        %mtd
                          %mo ≔
                        %mtd
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mtd
                          %mo ↦
                        %mtd
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi mod
                            %mspace{:width => "thinmathspace"}
                            %mi k
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %mtr
                        %mtd
                          %mi ζ
                        %mtd
                          %mo ≔
                        %mtd
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mtd
                          %mo ↦
                        %mtd
                          %mi ζ
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccccccl}
                    W_a
                    \&amp; \coloneqq &amp;
                    W(1,0,0)
                    \&amp;\colon&amp;
                    {\big\vert n \big\rangle}
                    \&amp;\mapsto&amp;
                    \\zeta^{2n}
                    {\big\vert n \big\rangle}
                    \\\
                    W_b
                    \&amp;\coloneqq&amp;
                    W(0,1,0)
                    \&amp;\colon&amp;
                    {\big\vert n \big\rangle}
                    \&amp;\mapsto&amp;
                    {\big\vert (n + 1) \,mod\, k \big\rangle}
                    \\\
                    \\zeta
                    \&amp;\coloneqq&amp;
                    W(0,0,1)
                    \&amp;\colon&amp;
                    {\big\vert n \big\rangle}
                    \&amp;\mapsto&amp;
                    \\zeta
                    {\big\vert n \big\rangle}
                    \\mathrlap{\,,}
                    \\end{array}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} \zeta
              a
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 2k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/root+of+unity"} root of unity
            %p For instance:
            #eq:W11InTermsOfWab.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi a
                    %mo ⋅
                    %msub
                      %mi W
                      %mi b
                    %mo ⋅
                    %msup
                      %mi ζ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi W
                      %mi b
                    %mo ⋅
                    %msub
                      %mi W
                      %mi a
                    %mo ⋅
                    %msup
                      %mi ζ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W_a \cdot W_b \cdot \zeta^{-1}
                    \\;=\;
                    W(1,1,0)
                    \\;=\;
                    W_b \cdot W_a \cdot \zeta^{+1}
                    \\,.
            %p
          %strong Notation:
          In the following we write “
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
            %semantics
              %mrow
                %mo{:stretchy => "false"} [
                %mi n
                %mo{:stretchy => "false"} ]
              %annotation{:encoding => "application/x-tex"} [n]
          ” for “
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
            %semantics
              %mrow
                %mi n
                %mspace{:width => "thinmathspace"}
                %mi mod
                %mspace{:width => "thinmathspace"}
                %mi k
              %annotation{:encoding => "application/x-tex"} n \,mod\, k
          ” and “
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
            %semantics
              %mrow
                %msub
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
              %annotation{:encoding => "application/x-tex"} \sum_{[n]}
          ” for “
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
            %semantics
              %mrow
                %msubsup
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %mrow
                    %mi k
                    %mo −
                    %mn 1
              %annotation{:encoding => "application/x-tex"} \sum_{n =0}^{k-1}
          ”.
          .proof
            %h6 Proof
            %p
              To see that this is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              %a.maruku-eqref{:href => "#eq:HeisenbergAsQuotientOfFreeGroup"} (6)
              it is sufficient to check that the basic
              %a.existingWikiWord{:href => "/nlab/show/group+commutator"} group commutator
              is represented, in that
            #eq:RepresentationOfBasicGroupCommutator.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi a
                    %mo ⋅
                    %msub
                      %mi W
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ζ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi W
                      %mi b
                    %mo ⋅
                    %msub
                      %mi W
                      %mi a
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    W_a \cdot W_b \,=\,
                    \\zeta^2
                    \\,
                    W_b \cdot W_a
                    \\mathrlap{\,,}
            %p which is evidently the case, since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi a
                          %mo ⋅
                          %msub
                            %mi W
                            %mi b
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mtd
                          %mo =
                        %mtd
                          %msub
                            %mi W
                            %mi a
                          %mo ⋅
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %msup
                            %mi ζ
                            %mrow
                              %mn 2
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    W_a \cdot W_b {\big\vert [n] \big\rangle}
                    \&amp;=&amp;
                    W_a \cdot {\big\vert [n+1] \big\rangle}
                    \\\
                    \&amp;=&amp;
                    \\zeta^{2(n+1)}
                    \\,
                    {\big\vert [n+1] \big\rangle}
                    \\mathrlap{\,,}
                    \\end{array}
            %p while
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi b
                          %mo ⋅
                          %msub
                            %mi W
                            %mi a
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mtd
                          %mo =
                        %mtd
                          %msup
                            %mi ζ
                            %mrow
                              %mn 2
                              %mi n
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi W
                            %mi b
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
