                              %mo ,
                              %mn 0
                              %mo ,
                              %mn 0
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 1
                              %mo ,
                              %mn 0
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %mn 1
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %mo ,
