                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mover
                                      %mi n
                                      %mo ^
                                    %mspace{:width => "thinmathspace"}
                                    %mi n
                                  %mi k
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mo{:stretchy => "false"} [
                            %mover
                              %mi n
                              %mo ^
                            %mo{:stretchy => "false"} ]
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                        %mtd
