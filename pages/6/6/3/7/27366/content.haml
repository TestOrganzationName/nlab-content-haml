                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 1
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %mo{:stretchy => "false"} (
