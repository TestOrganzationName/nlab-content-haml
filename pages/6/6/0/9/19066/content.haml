                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\int_S \underset{s \in S}{\prod} sGrp
                    \&amp;\;\simeq\;&amp;
                    sSet\text{-}Grpd_{skl}
                    \&amp;\xhookrightarrow{\phantom{--}}&amp;
                    sSet\text{-}Grpd
                    \\\
                    \\big(\mathcal{G}_s\big)_{s \in S}
                    \&amp;\mapsto&amp;
                    \\underset{s \in S}{\coprod}
                    \\mathbf{B}\mathcal{G}_s
                    }
            %p
              Since (assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              in the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched groupoid
              is
              %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+equivalence"} DK-equivalent
              to a skeletal simplicial groupoid, the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion
              %a.maruku-eqref{:href => "#eq:InclusionOfSkeletalSimplicialGroupoids"} (3)
              is also a
              %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+equivalence"} Dwyer-Kan equivalence
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+categories"} sSet-enriched categories
            %p
              Moreover, if we consider on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mtext -
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} sSet\text{-}Grpd
              the usual
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groupoids"} model structure on simplicial groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
