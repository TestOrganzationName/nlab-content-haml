                    sSet\text{-}Grpd
            %p
              preserves
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to this functor (due to the choices involved in passing to a
              %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
              such an adjoint exists only as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
              = succeed ")" do
