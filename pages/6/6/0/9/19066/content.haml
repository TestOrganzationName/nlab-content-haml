          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            may be lifted from
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Grothendieck+construction"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-Grothendieck construction
          %h2#Definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            be a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            and
          #eq:ThePseudofunctor.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ℳ
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi Mod
                          %mi Cat
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo ↦
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mi f
                        %mtd
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %msup
                                %mo
                                %mrow
                                  %msub
                                    %mi f
                                    %mo !
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %msup
                            %mrow
                            %mo ⊣
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↑
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %mo ↦
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{M} &amp;\longrightarrow&amp; Mod Cat
                  \\\
                  X &amp;\mapsto&amp; F(X)
                  \\\
                  \\Big\downarrow\mathrlap{{}^{f}}
                  \&amp;&amp;
                  \\mathllap{^{f_!}}\Big\downarrow
                  {}^{\dashv}
                  \\Big\uparrow\mathrlap{{}^{f^\ast}}
                  \\\
                  Y &amp;\mapsto&amp; F(Y)
                  }
          %p
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            %a.existingWikiWord{:href => "/nlab/show/ModCat"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ModelCat
                  %annotation{:encoding => "application/x-tex"} ModelCat
            is the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
            (pointing in the direction of their
            %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
            %a.existingWikiWord{:href => "/nlab/show/conjugate+transformations+of+adjoints"} conjugate transformations of adjoints
            (
            %a.existingWikiWord{:href => "/nlab/show/mate"}> mate
            \-pairs of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
          %p We say that:
          %p
          #RelativePseudoFunctor.num_defn
            %h6 Definition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/relative+functor"} relative functor
              if for any
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_! \dashv f^*
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          %p
          #ProperPseudofunctor.num_defn
            %h6 Definition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is “
              %em> proper
              ”, if when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \colon A\to B
              is an
              %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibration"} acyclic cofibration
              (resp. an
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              (resp.
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
