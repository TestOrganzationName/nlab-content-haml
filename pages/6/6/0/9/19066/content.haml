                  %annotation{:encoding => "application/x-tex"} f_!, f^\ast
              are certainly
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
              but in fact are plain
              %a.existingWikiWord{:href => "/nlab/show/equivalences+of+categories"} equivalences of categories
              compatible with the model structure and hence also preserve all weak equivalences).
            %p
              Therefore with Prop.
              %a.maruku-ref{:href => "#ExistenceStatement"}
              the integral model structure on the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              exists. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              in this Grothendieck construction may be thought of as
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              of
              = succeed "-objects" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserving
              embedding
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo ↪
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} Set \hookrightarrow \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              as morphisms of such bundles covering possibly non-trivial maps of base sets:
            #eq:GrothConstForObjectsParameterizedOverSets.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi S
                        %mo ∈
                        %mi Set
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi 𝒞
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi s
                                %mo ∈
                                %mi S
                            %msub
                              %mi X
                              %mi s
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ϕ
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi t
                                %mo ∈
                                %mi T
                            %msub
                              %mi Y
                              %mi t
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi T
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{S \in Set}
                    \\underset{s \in S}{\prod} \mathcal{C}
                    \\;\;\;\;
                    \=
                    \\;\;\;\;
                    \\left\{
                    \\begin{array}{ccc}
                    \\underset{s \in S}{\coprod} X_s
                    \&amp;\overset{\phi}{\longrightarrow}&amp;
                    \\underset{t \in T}{\coprod} Y_t
                    \\\
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\\
                    S &amp;\underset{f}{\longrightarrow}&amp; T
                    \\end{array}
                    \\right\}
            %p
              Unwinding the definition
              %a.maruku-ref{:href => "#IntegralModelStructure"}
              of the integral model structure in this case, gives that such a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \phi_f
              in this Grothendieck construction is:
            %ul
              %li
                %p
                  a fibration iff all the components
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi s
                        %mo ⟶
                        %msub
                          %mi Y
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X_s \longrightarrow Y_{f(s)}
                  are fibrations in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                        %annotation{:encoding => "application/x-tex"} s \in S
              %li
                %p
                  a cofibration iff all the co-components
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mi s
                            %mo ∈
                            %msup
                              %mi f
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mi t
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi X
                          %mi s
                        %mo ⟶
                        %msub
                          %mi Y
                          %mi t
                      %annotation{:encoding => "application/x-tex"} \underset{s \in f^{-1}(\{t\})}{\coprod}  X_s \longrightarrow Y_t
                  are cofibrations in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo ∈
                          %mi T
                        %annotation{:encoding => "application/x-tex"} t \in T
              %li
                %p
                  a weak equivalence iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  of index sets and all the (co)components maps — which in this case are all of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi s
                        %mo ⟶
                        %msub
                          %mi X
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X_s \longrightarrow X_{f(s)}
                  — are weak equivalences in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %p
                  (here the composition with (co)fibrant replacements can be omitted, since, as above,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo !
                        %mo ,
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f_!, f^\ast
                  preserve such resolution weak equivalences).
            %p
          %p
          #CoFibrantObjectsInFreeCoproductCompletion.num_remark
            %h6 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+objects"} cofibrant objects
              in the integral model structure on a
              %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
              (Exp.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelStructureOnIndexedSetsOfObjects"}
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+objects"} cofibrant objects
              in the coefficient model structure
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
            %p
              To see this, observe that the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              of Exp.
              %a.maruku-ref{:href => "#ModelStructureOnIndexedSetsOfObjects"}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mo ∅
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo ∅
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Set
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mo ∅
                    %mi 𝒞
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0_{\varnothing}
                    \\;\coloneqq\;
                    \\Big(
                    \\varnothing \,\in\, Set
                    ,\;
                    0 \,\in\, \underset{\varnothing}{\prod} \mathcal{C}
                    \\Big)
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∅
                      %annotation{:encoding => "application/x-tex"} \varnothing
                  (the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  denotes the
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  in the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
                  %a{:href => "terminal+object#TerminalObjectIsEmptyLimit"} which is
                  the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  is in fact a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mo ∅
                        %mi 𝒞
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{\varnothing}{\prod} \mathcal{C}
                        \\;\simeq\;
                        \\{0\}
                        \\,.
            %p
              Now given any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒱
                      %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %mi S
                        %mo ∈
                        %mi Set
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathscr{V}_S \,\in\, \int_{S \in Set}\;\underset{s \in S}{\prod} \, \mathcal{C}
              observe that there is a unique morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mo ∅
                    %mo ⟶
                    %msub
                      %mi.mathscript 𝒱
                      %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0_{\varnothing} \longrightarrow \mathscr{V}_S
                    \\,.
            %p
              Namely, unwinding the definitions, such a morphism is a
              %a.existingWikiWord{:href => "/nlab/show/dependent+pair"} dependent pair
              consisting of
            %ol
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mo ∅
                        %mo ⟶
                        %mi S
                      %annotation{:encoding => "application/x-tex"} f \,\colon\,\varnothing \longrightarrow S
                  in
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ϕ
                          %mo ˜
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi f
                          %mo !
                        %mn 0
                        %mo ⟶
                        %mi.mathscript 𝒱
                      %annotation{:encoding => "application/x-tex"} \widetilde{\phi} \,\colon\, f_! 0 \longrightarrow  \mathscr{V}
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi s
                            %mo ∈
                            %mi S
                        %mspace{:width => "thinmathspace"}
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \underset{s \in S}{\prod} \, \mathcal{C}
            %p
              But both of these exist uniquely, by the fact that their respective
              %a.existingWikiWord{:href => "/nlab/show/domains"} domains
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo !
                    %annotation{:encoding => "application/x-tex"} f_!
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits"} being a left adjoint
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              and hence
              %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
            %p
              This shows that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mo ∅
                  %annotation{:encoding => "application/x-tex"} 0_{\varnothing}
              is the initial object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mi S
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} nathcal
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \int_S \,\prod_{s \in S}\, \nathcal{C}
              %a{:href => "Grothendieck+construction#CoLimitsInAGrothendieckConstruction"} colimits in a Grothendieck construction
              specialized to the
              %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %a.existingWikiWord{:href => "/nlab/show/trivial+model+structure"} trivial model structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              are cofibrations while the cofibrations in a
              %a{:href => "model+category#ProductModelStructure"} product model category
              are the
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of cofibrations) that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒱
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}_S
              is cofibant precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒱
                      %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}_s \,\in\, \mathcal{C}
              is so for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} s \in S
          %p
          .num_remark
            %h6 Example
            %p
              %strong (model structure on skeletal simplicial groupoids)
              As a special case of Exp.
              = succeed "," do
                %a.maruku-ref{:href => "#ModelStructureOnIndexedSetsOfObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ≔
                    %mi sGrpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \coloneqq sGrpd
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groups"} model structure on simplicial groups
            %p
              Notice that forming simplicial
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
              is a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              from
              %a.existingWikiWord{:href => "/nlab/show/sGrp"} sGrp
              to the
              %em
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoids"} enriched groupoids
              (Dwyer-Kan’s“
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoids"}> simplicial groupoids
              ”)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi sGrp
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi sSet
                            %mtext -
                            %mi Grpd
                        %mtr
                          %mtd
                            %mi 𝒢
                          %mtd
                            %mo ↦
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    sGrp &amp;\longrightarrow&amp; sSet\text{-}Grpd
                    \\\
                    \\mathcal{G} &amp;\mapsto&amp; \mathbf{B}\mathcal{G}
                    }
            %p
              which extends to identify the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              %a.maruku-eqref{:href => "#eq:GrothConstForObjectsParameterizedOverSets"} (2)
              in the present case with the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
              of simplicial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoids"} skeletal groupoids
            #eq:InclusionOfSkeletalSimplicialGroupoids.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
