                        %annotation{:encoding => "application/x-tex"} x \in g^{-1}(0) \cap V'
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
