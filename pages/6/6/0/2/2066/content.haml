                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fix(p)
              is an embedded submanifold of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          .num_remark
            %h6#remark Remark
            %p
              %a{:href => "#Law"} Lawvere
              comments on this fact as follows: “For example, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              is the category of all smooth maps between all open subsets of all Euclidean spaces, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \widebar{\mathbf{C}}
              = succeed "the" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
              is the category of all smooth manifolds. This powerful theorem justifies bypassing the complicated considerations of charts, coordinate transformations, and atlases commonly offered as a ”basic“ definition of the concept of manifold. For example the 2-sphere, a manifold but not an open set of any Euclidean space, may be fully specified with its smooth structure by considering any open set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in 3-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              which contains it but not its center (taken to be
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} e(x) = x/{|x|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} e'
              on the tangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi V
                  %annotation{:encoding => "application/x-tex"} A \times V
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              being the vector space of translations of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
          %h3#projective_modules_and_vector_bundles Projective modules and vector bundles
          %p The category of projective modules over any ring is the Karoubi envelope of its full subcategory of free modules.
          %p The category of (locally trivial, finite dimensional) vector bundles over any fixed paracompact space is the Karoubi envelope of its full subcategory of trivial bundles.
          %p
            Both examples are related by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Serre-Swan+theorem"} Serre-Swan theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the category of free modules over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(X)
            prove the Serre-Swan theorem itself.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Karoubian+category"}> Karoubian category
                ,
                %a.existingWikiWord{:href => "/nlab/show/pseudo-abelian+category"} pseudo-abelian category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/idempotent+complete+%28infinity%2C1%29-category"} idempotent complete (infinity,1)-category
          %p For Karoubi envelopes of Kleisli categories, see the references on:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} split idempotent
          %h2#References References
          %p The term “Karoubi envelope” appears to have been introduced in:
          %ul
            %li#Hayashi1985
              %a.existingWikiWord{:href => "/nlab/show/Susumu+Hayashi"}> Susumu Hayashi
              , Def. 1.2 in:
              = succeed "," do
                %em Adjunction of semifunctors: categorical structures in nonextensional lambda calculus
              %strong 41
              (1985) 95-104 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0304-3975(85)90062-3"}> doi:10.1016/0304-3975(85)90062-3
              \&amp;rbrack;
          %p
            and apparently in reference to the
            %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal construction
            of
            %a.existingWikiWord{:href => "/nlab/show/pseudo-abelian+categories"} pseudo-abelian categories
            (now also: “
            %span.newWikiWord>
              Karoubian categories
              %a{:href => "/nlab/new/Karoubian+categories"} ?
            ”) in:
          %ul
            %li#Karoubi78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                , Theorem 6.10 of:
                = succeed "," do
                  %em K-Theory – An introduction
                = succeed "," do
                  %strong 226
                = succeed "," do
                  %a{:href => "https://webusers.imj-prg.fr/~max.karoubi/K.book/MK.book.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/10.1007%2F978-3-540-79890-3"} doi:10.1007%2F978-3-540-79890-3
              %blockquote
                %p
                  (in the context of
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %p A classical account is for instance in
          %ul
            %li#BorceuxDejean
              %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"} Francis Borceux
              and D. Dejean,
              %em Cauchy completion in category theory
              Cahiers Topologie Géom. Différentielle Catégoriques, 27:133–146, (1986) (
              %a{:href => "http://www.numdam.org/item?id=CTGDC_1986__27_2_133_0"}> numdam
              )
          %p
            For more classical references see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy complete category
          %p
            Karoubi envelopes for
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (∞,1)-categories
            are discussed in section 4.4.5 of
          %ul#Lurie
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p Some discussion of the stable version is in section 4.1.2 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              , John Francis, David Nadler,
              %em Integral Transforms and Drinfeld Centers in Derived Algebraic Geometry
              (
              %a{:href => "http://arxiv.org/abs/0805.0157"}> arXiv
              ,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+infinity-function+theory"} nLab entry
          %p and section 2.3 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              , David Nadler,
              %em The Character Theory of a Complex Group
              (
              %a{:href => "http://arxiv.org/abs/0904.1247"}> arXiv
              )
          %p In section 3.1.2 of latter are also given references (to Neeman and Lurie) for an important result of Neeman’s about Karoubi closure and compact generators.
          %p
            The Karoubi envelope for the additive case (see also
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/additive+envelope"} additive envelope
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dror+Bar-Natan"}> Dror Bar-Natan
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Scott+Morrison"} Scott Morrison
              %em The Karoubi envelope and Lee’s degeneration of Khovanov homology
              (
              %a{:href => "http://arxiv.org/abs/math/0606542"}> arXiv
              )
          %p
            Discussion for
            %a.existingWikiWord{:href => "/nlab/show/triangulated+categories"} triangulated categories
            is in
          %ul
            %li
              Paul Balmer, Marco Schlichting,
              %em Idempotent completion of triangulated categories
              (
              %a{:href => "http://www.math.ucla.edu/~balmer/research/Pubfile/IdempCompl.pdf"}> pdf
              )
          %p The proof that idempotents split in the category of manifolds was adapted from this MO answer:
          %ul
            %li
              Zack (http://mathoverflow.net/users/300/zack), Idempotents split in category of smooth manifolds?, URL (version: 2014-04-06): http://mathoverflow.net/q/162556 (
              %a{:href => "http://mathoverflow.net/a/162556/2926"}> web
              )
          %p Which provides a solution to exercise 3.21 in
          %ul
            %li
              F. W. Lawvere,
              %em Perugia Notes - Theory of Categories over a Base Topos
              , Ms. Università di Perugia 1973.
          %p The accompanying above remark of Lawvere appears on page 267 of
          %ul#Law
            %li
              %a.existingWikiWord{:href => "/nlab/show/F.+William+Lawvere"}> F. William Lawvere
              ,
              = succeed "," do
                %em Qualitative distinctions between some toposes of generalized graphs
              = succeed ")" do
                %a{:href => "http://www.ams.org/books/conm/092/1003203/conm092-1003203.pdf"} pdf
          %p A comparison of the Karoubi envelope to other completions can be found here:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> Marta Bunge
              ,
              %em Tightly Bounded Completions
              , TAC
              %strong 28
              no. 8 (2013) pp.213-240. (
              %a{:href => "http://www.tac.mta.ca/tac/volumes/28/8/28-08.pdf"}> pdf
              )
          %p
            Formalization in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#Shulman14
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              %em
                %a{:href => "http://homotopytypetheory.org/2014/12/08/splitting-idempotents/"} Splitting idempotents
          %p
            A generalization of the Karoubi envelope for
            %a.existingWikiWord{:href => "/nlab/show/n-categories"} n-categories
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Theo+Johnson-Freyd"} Theo Johnson-Freyd
              = succeed "," do
                %em Condensations in higher categories
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1905.09566"} arXiv:1905.09566
