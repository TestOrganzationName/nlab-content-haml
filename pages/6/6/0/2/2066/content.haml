                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi V
                      %mo ′
                      %mo =
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi V
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} Fix(p) \cap V' = g^{-1}(0) \cap V'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fix(p)
              is locally diffeomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
