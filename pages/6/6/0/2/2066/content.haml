                %annotation{:encoding => "application/x-tex"} (p, j)
            formally splits the idempotent
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi c
                    %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} e: c \to c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi: (c, e) \to (c, e)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{C}
            splits through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c,\phi)
            %em choice
            of splitting for every idempotent.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be any category in which every idempotent
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi d
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} h: d \to d
            has a chosen splitting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mi h
                  %mo :
                  %mi d
                  %mo →
                  %msub
                    %mi d
                    %mi h
                  %mo ,
                  %msub
                    %mi j
                    %mi h
                  %mo :
                  %msub
                    %mi d
                    %mi h
                  %mo →
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p_h: d \to d_h, j_h: d_h \to d)
            (using identities to split identities), and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F: C \to D
            be a functor. Define an extension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ¯
                  %mo :
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \bar{F}: \bar{C} \to D
          %p
            by sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi e
                  %mo :
                  %mi c
                  %mo →
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c, e: c \to c)
            to the underlying object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(c)_{F(e)}
            of the splitting of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(e): F(c) \to F(c)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi e
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi: (c, e) \to (c', e')
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bar{F}(\phi)
            to be the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi j
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ′
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(c)_{F(e)} \overset{F(j_{F(e)})}{\to} F(c) \overset{F(\phi)}{\to} F(c') \overset{F(p_{F(e')})}{\to} F(c')_{F(e')}
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{F}
            is the unique extension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            which preserves chosen splittings. Thus the Karoubi envelope is universal among functors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            into categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            in which every idempotent has a chosen splitting.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a category in which every idempotent splits, then we can choose a splitting for each idempotent using the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            (AC); the extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{F}
            depends on how we do this but is unique up to unique
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{F}
            as an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{F}
            unique up to unique natural isomorphism. (It is key here that a splitting of an idempotent is unique up to a coherent isomorphism.)
          %p
            Essentially the same argument shows that for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            in which idempotents split, the restriction functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [E, D]: [\bar{C}, D] \to [C, D]
            is an equivalence. The details are spelled out
            = succeed "." do
              %a{:href => "http://ncatlab.org/toddtrimble/published/Karoubi+envelope"} here
          %h3#UnderTheYonedaEmbedding Under the Yoneda embedding
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\mathcal{C})
              for its
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                    %mo ↪
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde \mathcal{C} \hookrightarrow PSh(\mathcal{C})
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on those presheaves which are
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              of objects in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo →
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \to \tilde \mathcal{C}
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde \mathcal{C}
              as
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              idempotent completion of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            For instance (
            %a{:href => "#Lurie"}> Lurie, proof of prop. 5.1.4.2
            ).
          %h2#properties Properties
          %h3#Finality Finality of the completion
          .num_defn
            %h6#definition_3 Definition
            %p
              A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo →
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}\to \tilde \mathcal{C}
              exhibiting an idempotent completion, def.
              = succeed "," do
                %a.maruku-ref{:href => "#IdempotentCompletionAbstractly"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/final+functor"} final functor
          %p
            For instance (
            %a{:href => "#Lurie"}> Lurie, lemma 5.1.4.6
            ).
          %h3#monadicity_over_semicategories Monadicity over semicategories
          %p
            The functor that forms idempotent completion is the
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            induced from the
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            between categories and
            %a.existingWikiWord{:href => "/nlab/show/semicategories"} semicategories
            given by the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo →
                  %mi SemiCat
                %annotation{:encoding => "application/x-tex"} Cat \to SemiCat
            and its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "." do
              %em
                %a{:href => "semicategory#RelationToCategories"} Semicategory - Relation to categories
          %h2#examples Examples
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/category+of+Chow+motives"} category of Chow motives
          %h3#the_category_of_smooth_manifolds The category of smooth manifolds
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Man
                %annotation{:encoding => "application/x-tex"} Man
            be the category of
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+maps"} smooth maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} C^\infty
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            without boundary. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi Open
                  %mo ↪
                  %mi Man
                %annotation{:encoding => "application/x-tex"} i: Open \hookrightarrow Man
            be the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            whose objects are the
            %a.existingWikiWord{:href => "/nlab/show/open+subspaces"} open subspaces
            of finite-dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
          .num_theorem
            %h6#theorem Theorem
            %p
              The subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi Open
                    %mo ↪
                    %mi Man
                  %annotation{:encoding => "application/x-tex"} i: Open \hookrightarrow Man
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Man
                  %annotation{:encoding => "application/x-tex"} Man
              as an idempotent-splitting completion of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Open
                    %annotation{:encoding => "application/x-tex"} Open
          .proof
            %h6#proof_2 Proof
            %p
              By lemma
              = succeed "," do
                %a.maruku-ref{:href => "#def2"}
            %ul
              %li
                %p Every smooth manifold is a smooth retract of an open set in Euclidean space;
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo :
                        %mi U
                        %mo →
                        %mi U
                      %annotation{:encoding => "application/x-tex"} p : U \to U
                  is a smooth idempotent on an open set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo ⊆
                          %msup
                            %mi ℝ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} U \subseteq \mathbb{R}^n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Fix
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi U
                      %annotation{:encoding => "application/x-tex"} Fix(p) \hookrightarrow U
                  is an embedded submanifold.
            %p
              For the first statement, we use the fact that any manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              can be realized as a closed submanifold of some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %a.existingWikiWord{:href => "/nlab/show/tubular+neighborhood+theorem"} tubular neighborhood
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊆
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} U \subseteq \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              carries a structure of vector bundle over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              in such a way that the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ↪
                    %mi U
                  %annotation{:encoding => "application/x-tex"} M \hookrightarrow U
              is identified with the zero section, so that the bundle projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} U \to M
              provides a retraction, with right inverse given by the zero section.
            %p
              For the second statement, assume that the origin
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              is a fixed point of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_0(U) \cong \mathbb{R}^n
              be its tangent space (observe the presence of a
              %em canonical
              isomorphism to
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Id
                    %mo −
                    %mi d
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi T
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi T
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d p(0), Id-d p(0): T_0(U) \to T_0(U)
              where the latter factors through the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi T
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ker \; d p(0) \hookrightarrow T_0(U)
              via a projection map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo :
                      %msub
                        %mi T
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ker
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi: T_0(U) \to \ker \; d p(0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi U
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f: U \to \mathbb{R}^n
              that takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x \in U
              to
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo −
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x - p(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              denote the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mover
                      %mo →
                      %mi f
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ≅
                    %msub
                      %mi T
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi π
                    %mi ker
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} U \stackrel{f}{\to} \mathbb{R}^n \cong T_0(U) \stackrel{\pi}{\to} \ker\; d p(0).
            %p Now we make some easy observations:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Fix
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo ⊆
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Fix(p) \subseteq g^{-1}(0)
                  \.
              %li
                %p
                  The map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo :
                        %mi U
                        %mo →
                        %mi U
                      %annotation{:encoding => "application/x-tex"} p: U \to U
                  restricts to a map
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo :
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} p: g^{-1}(0) \to g^{-1}(0)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
              %li
                %p
                  The derivative
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi T
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi T
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi ker
                        %mspace{:width => "thickmathspace"}
                        %mi d
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %mi ker
                        %mspace{:width => "thickmathspace"}
                        %mi d
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d g(0): T_0(U) \to T_0(\ker \; d p(0)) \cong \ker \; d p(0)
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                      %annotation{:encoding => "application/x-tex"} \pi
                  again since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Id
                        %mo −
                        %mi d
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Id - d p(0)
                  is idempotent. Thus
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d g(0)
                  has full rank (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                  say), and so the restriction of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  to some neighborhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  has
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  as a regular value, and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi V
                      %annotation{:encoding => "application/x-tex"} g^{-1}(0) \cap V
                  is a manifold of dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                  by the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/implicit+function+theorem"} implicit function theorem
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} T_0(g^{-1}(0) \cap V)
                  is canonically identified with
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} im(d p(0))
              %li
                %p
                  There are smaller neighborhoods
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ″
                        %mo ⊆
                        %mi V
                        %mo ′
                        %mo ⊆
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V'' \subseteq V' \subseteq V
                  so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  restricts to maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo ,
                        %msub
                          %mi p
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} p_1, p_2
                  as in the following diagram (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ,
                        %mi i
                        %mo ′
                        %mo ,
                        %mi i
                        %mo ″
                      %annotation{:encoding => "application/x-tex"} i, i', i''
                  are inclusion maps, all taking a domain element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  to itself):
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo ∩
                                %mi V
                                %mo ″
                              %mtd
                                %mover
                                  %mo ↪
                                  %mrow
                                    %mi i
                                    %mo ″
                              %mtd
                                %msup
                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msub
                                  %mo
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi p
                                        %mn 2
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msub
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi p
                            %mtr
                              %mtd
                                %msup
                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo ∩
                                %mi V
                                %mo ′
                              %mtd
                                %mover
                                  %mo ↪
                                  %mrow
                                    %mi i
                                    %mo ′
                              %mtd
                                %msup
                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msub
                                  %mo
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi p
                                        %mn 1
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msub
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi p
                            %mtr
                              %mtd
                                %msup
                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo ∩
                                %mi V
                              %mtd
                                %mover
                                  %mo ↪
                                  %mi i
                              %mtd
                                %msup
                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        g^{-1}(0) \cap V'' &amp; \stackrel{i''}{\hookrightarrow} &amp; g^{-1}(0) \\
                        _\mathllap{p_2} \downarrow &amp; &amp; \downarrow _\mathrlap{p} \\
                        g^{-1}(0) \cap V' &amp; \stackrel{i'}{\hookrightarrow} &amp; g^{-1}(0) \\
                        _\mathllap{p_1} \downarrow &amp; &amp; \downarrow _\mathrlap{p} \\
                        g^{-1}(0) \cap V &amp; \stackrel{i}{\hookrightarrow} &amp; g^{-1}(0)
                        }
                %p
                  and such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo ,
                        %msub
                          %mi p
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} p_1, p_2
                  are diffeomorphisms by the
                  %a.existingWikiWord{:href => "/nlab/show/implicit+function+theorem"} inverse function theorem
                  (noting here that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %msub
                          %mi p
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d p_i(0): im(d p(0)) \to im(d p(0))
                  is the identity map, by idempotence of
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
              %li
                %p
                  Letting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mo :
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi V
                        %mo ′
                        %mo →
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi V
                        %mo ″
                      %annotation{:encoding => "application/x-tex"} q: g^{-1}(0) \cap V' \to g^{-1}(0) \cap V''
                  denote the smooth inverse to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi p
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} p_2
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo ′
                          %mo =
                          %mi p
                          %mo ∘
                          %mi i
                          %mo ″
                          %mo ∘
                          %mi q
                        %annotation{:encoding => "application/x-tex"} i' = p \circ i'' \circ q
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %msub
                          %mi p
                          %mn 1
                        %mo =
                        %mi p
                        %mi i
                        %mo ′
                        %mo =
                        %mi p
                        %mi p
                        %mi i
                        %mo ″
                        %mi q
                        %mo =
                        %mi p
                        %mi i
                        %mo ″
                        %mi q
                        %mo =
                        %mi i
                        %mo ′
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} i p_1 = p i' = p p i''q = p i'' q = i',
                %p
                  so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
