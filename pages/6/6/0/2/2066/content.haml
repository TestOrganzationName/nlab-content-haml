                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi π
                    %mi σ
                    %mo =
                    %msub
                      %mn 1
                      %mi E
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} (\pi s)(r \sigma) = \pi \sigma (\pi s)(r \sigma) = \pi \sigma = 1_E,
            %p as desired.
