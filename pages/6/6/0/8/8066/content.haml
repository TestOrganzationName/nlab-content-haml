          %h3#ReferencesViaModalLogic Via modal logic
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/epistemic+logic"} epistemic
            (
            %a.existingWikiWord{:href => "/nlab/show/S5+modal+logic"}> S5
            )
            %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
            in
            %a.existingWikiWord{:href => "/nlab/show/game+theory"} game theory
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/information+science"} information science
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+J.+Aumann"}> Robert J. Aumann
                ,
                = succeed "," do
                  %em Interactive epistemology I: Knowledge
                %strong 28
                (1999) 263–300
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1007/s001820050111"} doi:10.1007/s001820050111
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
