          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is its
            %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            to an ordinary
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            obtained by identifying 1-
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            that are connected by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is presented by a
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (for instance as the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %mi L
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = L C
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (where the weak equivalences are universally turned into
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ho(\mathcal{C}) \simeq Ho(C)
                  \\,.
          %h2#definition Definition
          %p
            The component-wise definition depend on the chosen model for
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"}> simplicially enriched category
                \/
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Segal+category"} Segal category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
          %h3#in_terms_of_simplicially_enriched_categories In terms of simplicially enriched categories
          %p
            The
            %strong homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mi C
                %annotation{:encoding => "application/x-tex"} h C
            of a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (equivalently of a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo :
                  %mi sSet
                  %mo →
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\pi_0 : sSet \to Set
                  \\,,
          %p
            which sends each
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            to its 0th
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy set
            of
            %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            components, i.e. to the set of
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/path+component"} path component
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mrow
                      %mi h
                      %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_{h C}(A,B) := \pi_0(Hom_C(A,B))
                  \\,.
          %p
            Sometimes it is useful to regard this after all as an enriched category, but now enriched over the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of the standard
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %em
              homotopy category of an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi h
                  %mo :
                  %mi sSet
                  %mo →
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi sSet
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{h}: sSet \to Ho(sSet)
            be the localization functor to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            (of a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            by the fact that the cartesian monoidal product is a left-
            %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            is cofibrant, it preserves weak equivalences in both arguments and hence descends to the homotopy category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi sSet
                          %mo ×
                          %mi sSet
                        %mtd
                          %mover
                            %mo →
                            %mo ×
                        %mtd
                          %mi sSet
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi h
                                %mo ×
                                %mstyle{:mathvariant => "bold"}
                                  %mi h
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mstyle{:mathvariant => "bold"}
                                %mi h
                      %mtr
                        %mtd
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi sSet
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi sSet
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi h
                              %mo{:stretchy => "false"} (
                              %mo ×
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi sSet
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  sSet \times sSet &amp;\stackrel{\times}{\to}&amp; sSet
                  \\\
                  \\downarrow^{\mathrlap{\mathbf{h} \times \mathbf{h}}}
                  \&amp;&amp;
                  \\downarrow^{\mathrlap{\mathbf{h}}}
                  \\\
                  Ho(sSet) \times Ho(sSet) &amp;\stackrel{\mathbf{h}(\times)}{\to}&amp;
                  Ho(sSet)
                  }
                  \\,.
          %p
            This inuces a canonical functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi sSet
                  %mi Cat
                  %mo →
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi sSet
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} h:sSet Cat\to Ho(sSet) Cat
            which is given by the identity on objects and:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Map
                      %mrow
                        %mi h
                        %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi h
                    %msub
                      %mi Map
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map_{h C}(A,B):=\mathbf{h} Map_{C}(A,B)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mi sSet
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 0
                    %mo ,
                    %msub
                      %mi Map
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_C(A,B)=Hom_{sSet}(\Delta^0,Map_{C}(A,B))
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi hC
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi h
                    %msup
                      %mi Δ
                      %mn 0
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi h
                    %msub
                      %mi Map
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi Map
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{hC}(A,B)=Hom_{Ho(sSet)}(\mathbf{h} \Delta^0, \mathbf{h} Map_C(A,B))=\pi_0 Map_C(A,B)
          %h3#in_terms_of_complete_segal_spaces_and_segal_categories In terms of complete Segal spaces and Segal categories
          %p
            Similar, but more complicated, definitions work for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Segal+category"} Segal categories
          %h3#in_terms_of_quasicategories In terms of quasi-categories
          %p
            For
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-categories
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
          %p
            Viewing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hC
                %annotation{:encoding => "application/x-tex"} hC
            can also be described as its
            %a.existingWikiWord{:href => "/nlab/show/fundamental+category"} fundamental category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_1(C)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            by the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mo :
                  %mi SSet
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \tau_1 : SSet \to Cat
            of the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
          %h2#properties Properties
          %h3#BrownRepresentability Brown representability
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
            characterizes
            %a.existingWikiWord{:href => "/nlab/show/representable+functors"} representable functors
            on homotopy categories of
            = succeed "-categories:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+%28%E2%88%9E%2C1%29-category"} generated
              by a set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi S
                      %mi i
                    %mo ∈
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\{S_i \in \mathcal{C}\}_{i \in I}
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+object+in+an+%28infinity%2C1%29-category"} compact objects
              (i.e. every object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              of the objects
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} S_i
            %p
              If each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} S_i
              admits the structure of a
              %a.existingWikiWord{:href => "/nlab/show/cogroup"} cogroup
              object in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\; Ho(\mathcal{C})^{op} \longrightarrow Set
            %p
              (from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              precisely if it satisfies these two conditions:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  sends small
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                  to
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/products"} products
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  sends
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pushouts"} (∞,1)-pushouts
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %munder
                          %mo ⊔
                          %mi Z
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \underset{Z}{\sqcup}Y
                  to
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
                  %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mrow
                          %mo (
                          %mi X
                          %munder
                            %mo ⊔
                            %mi Z
                          %mi Y
                          %mo )
                        %mover
                          %mo ⟶
                          %mi epi
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo ×
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi Z
                            %mo{:stretchy => "false"} )
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        F\left(X \underset{Z}{\sqcup}Y\right)
                        \\stackrel{epi}{\longrightarrow}
                        F(X) \underset{F(Z)}{\times} F(Y)
                %p
                  are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/surjections"} surjections
          %p
            (
            %a{:href => "#LurieHigherAlgebra"}> Lurie “Higher Algebra”, theorem 1.4.1.2
            )
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                %a{:href => "http://arxiv.org/PS_cache/math/pdf/0608/0608040v4.pdf#page=33"} Section 1.2.3, p. 33
                of
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
            %li#LurieHigherAlgebra
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , section 1.4.1 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
