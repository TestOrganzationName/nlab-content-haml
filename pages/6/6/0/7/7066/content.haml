          %title Contents
          %blockquote
            %p
              This entry is about polarization of
              %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
              (or of any
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"} canonical momenta
              %em
                %a.existingWikiWord{:href => "/nlab/show/polarization+identity"} polarization identity
              (such as in an
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
              or a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Jordan+algebra"} Jordan algebra
              %em
                %a.existingWikiWord{:href => "/nlab/show/wave+polarization"} wave polarization
              (such as polarized
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/light"} light
              %em
                %a.existingWikiWord{:href => "/nlab/show/polarized+algebraic+variety"} polarized algebraic variety
              is closely related.
