          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#MainTheoremOfRenormalization"} Main theorem of renormalization
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
