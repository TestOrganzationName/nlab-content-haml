                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Shv}^{\mathrm{htp}}(\mathrm{SepStk}) \xrightarrow{\mathrm{ev}} \mathrm{Psh}(\mathrm{Glo}^{\mathrm{Stk}}) \simeq \mathrm{Psh}(\mathrm{Glo}),
            %p
