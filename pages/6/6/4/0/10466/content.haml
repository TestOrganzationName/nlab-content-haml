                  %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
                %em Homotopy Theory of Orbispaces
                (
                %a{:href => "http://arxiv.org/abs/math/0701916"}> arXiv:math/0701916
                )
            %li#Lurie
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , Section 3 of
                %em Elliptic cohomology III: Tempered Cohomology
                (
                %a{:href => "http://www.math.harvard.edu/~lurie/papers/Elliptic-III-Tempered.pdf"}> pdf
                )
          %p
            Global unstable equivariant homotopy theory is discussed as a
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            of the category of “orthogonal spaces” (the unstable version of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
          %ul
            %li#Schwede17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                %em Orbispaces, orthogonal spaces, and the universal compact Lie group
                (
                %a{:href => "https://arxiv.org/abs/1711.06019"}> arXiv:1711.06019
                )
            %li#Schwede18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Global+homotopy+theory"} Global homotopy theory
                = succeed "," do
                  %strong 34
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781108349161"} doi:10.1017/9781108349161
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1802.09382"} arXiv:1802.09382
          %p see also
          %ul
            %li#May90
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              ,
              = succeed "," do
                %em Some remarks on equivariant bundles and classifying spaces
          %p
            Discussion of the global equivariant homotopy theory as a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            is in
          %ul
            %li#Rezk14
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Global+Homotopy+Theory+and+Cohesion"} Global Homotopy Theory and Cohesion
              (2014)
          %p
            and further equipped also with smooth structure as required for
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/orbifold+cohomology"} orbifold cohomology
          %ul
            %li#SatiSchreiber08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Proper+Orbifold+Cohomology"} Proper Orbifold Cohomology
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2008.01101"}> arXiv:2008.01101
                \&amp;rbrack;
            %li#CloughCnossenLinskens24
              %p
                %a.existingWikiWord{:href => "/nlab/show/Adrian+Clough"}> Adrian Clough
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bastiaan+Cnossen"} Bastiaan Cnossen
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Sil+Linskens"} Sil Linskens
                %em Global spaces and the homotopy theory of stacks
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2407.06877"}> arXiv:2407.06877
                \&amp;rbrack;
          %p Relatedly, this is developed via partially lax limits in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Sil+Linskens"}> Sil Linskens
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Denis+Nardin"} Denis Nardin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Luca+Pol"} Luca Pol
              %em Global homotopy theory via partially lax limits
              (
              %a{:href => "https://arxiv.org/abs/2206.01556"}> arXiv:2206.01556
              )
          %p
            Discussion of a model structure for global equivariance with respect to
            %a.existingWikiWord{:href => "/nlab/show/geometrically+discrete+%E2%88%9E-groupoid"} geometrically discrete
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            (globalizing the
            %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
            for
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Yonatan+Harpaz"}> Yonatan Harpaz
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Matan+Prasma"} Matan Prasma
              %em The Grothendieck construction for model categories
              (
              %a{:href => "http://arxiv.org/abs/1404.1852"}> arXiv:1404.1852
              )
          %p
            Discussion from a perspective of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            is in
          %ul
            %li#Shulman15
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              %em Univalence for inverse EI diagrams
              (
              %a{:href => "http://arxiv.org/abs/1508.02410"}> arXiv:1508.02410
              )
          %p
            The example of global equivariant
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              %em Global algebraic K-theory
              (
              %a{:href => "https://arxiv.org/abs/1912.08872"}> arXiv:1912.08872
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/orbifold+cohomology"} orbifold cohomology
            seen in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"} global equivariant homotopy theory
          %ul
            %li#Juran20
              %a.existingWikiWord{:href => "/nlab/show/Branko+Juran"}> Branko Juran
              ,
              %em Orbifolds, Orbispaces and Global Homotopy Theory
              (
              %a{:href => "https://arxiv.org/abs/2006.12374"}> arXiv:2006.12374
              )
          %p
            following the suggestion in
            = succeed "," do
              %a{:href => "#Schwede17"} Schwede 17, Intro
            = succeed "." do
              %a{:href => "#Schwede18"} Schwede 18, p. ix-x
          %p An ongoing project to develop global equivariant higher category theory and associated universal properties for global spaces and spectra:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bastiaan+Cnossen"}> Bastiaan Cnossen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tobias+Lenz"} Tobias Lenz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sil+Linskens"} Sil Linskens
                %em Parametrized stability and the universal property of global spectra
                (
                %a{:href => "https://arxiv.org/abs/2301.08240"}> arXiv:2301.08240
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bastiaan+Cnossen"}> Bastiaan Cnossen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tobias+Lenz"} Tobias Lenz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sil+Linskens"} Sil Linskens
                %em Partial parametrized presentability and the universal property of equivariant spectra
                (
                %a{:href => "https://arxiv.org/abs/2307.11001"}> arXiv:2307.11001
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bastiaan+Cnossen"}> Bastiaan Cnossen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tobias+Lenz"} Tobias Lenz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sil+Linskens"} Sil Linskens
                %em The Adams isomorphism revisited
                (
                %a{:href => "https://arxiv.org/abs/2311.04884"}> arXiv:2311.04884
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bastiaan+Cnossen"}> Bastiaan Cnossen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tobias+Lenz"} Tobias Lenz
                = succeed "," do
