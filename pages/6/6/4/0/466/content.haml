                  %mi y
                  %mo ,
                  %msub
                    %mi const
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (y,const_X)
            and applying the Yoneda lemma to find
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
