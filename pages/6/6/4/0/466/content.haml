                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} (
