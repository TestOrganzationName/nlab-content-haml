                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\alpha_{a'}(f) &amp;= \alpha_{a'}(\mathbf{y} a_{a,a'}(f)(1_a))\\
                  \&amp;= (\alpha_{a'} \circ \mathbf{y}a_{a,a'}(f))(1_a)\\
                  \&amp;= (F_{a,a'}(f) \circ \alpha_a)(1_a)\\
                  \&amp;= F_{a,a'}(f_(\alpha_a(1_a))\\
                  \&amp;= F_{a,a'}(f)(x).
                  \\end{aligned}
          %p
            Thus, both composites are equal to identities. The proof of naturality follows from this.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
