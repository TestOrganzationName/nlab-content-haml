            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi g
                  %mo :
                  %mi y
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
