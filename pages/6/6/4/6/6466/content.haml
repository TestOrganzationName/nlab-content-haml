                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}(\mathbb{Q}) \times \mathcal{P}(\mathbb{Q})
            consisting of all Dedekind cuts as defined above.
          %h3#in_a_pretopos_with_
            In a
            = succeed "-pretopos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
