                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mo ∀
                      %mi r
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo &lt;
                      %mi q
                      %mo ∧
                      %mi r
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi q
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \forall q\colon \mathbb{Q}.\, \forall r\colon \mathbb{Q}.\, ((r \lt q \wedge r \in U) \implies q \in U) .
            %li
              %p Outward-open:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
