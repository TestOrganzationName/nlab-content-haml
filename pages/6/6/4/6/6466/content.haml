            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+category"} Heyting category
            %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            using the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/stack+semantics"} stack semantics
          .num_defn
