          %h2#examples Examples
          %h3#in_
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
          %p
            The real numbers object in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            = succeed "," do
