                    %annotation{:encoding => "application/x-tex"} \lt
          .proof
            %h6#proof_6 Proof
            %p …
          .num_thm
            %h6#theorem_6 Theorem
            %p
              Any RNO
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              in a Heyting category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              with an NNO is the
              %a.existingWikiWord{:href => "/nlab/show/terminal"} terminal
              %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
              object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          .proof
            %h6#proof_7 Proof
            %p …
          %h2#constructions Constructions
          %p We can construct a real numbers object in the following cases (presumably among others):
          %ol
            %li in a topos with an NNO;
            %li
              in a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Pi
              %a.existingWikiWord{:href => "/nlab/show/Pi-pretopos"} pretopos
              with an NNO and
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/weak+countable+choice"} weak countable choice
            %li
              in a
              = succeed "-pretopos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Pi
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subset+collection"} subset collection
          %p (Actually, (1) is a special case of (3), but the usual construction in (1) is not available in (3). Thus, we still have three different constructions to consider.)
          %h3#in_a_topos_with_an_nno In a topos with an NNO
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            be an
            %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            with a natural numbers object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %strong Dedekind real numbers object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is the object of all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+cut"} Dedekind cuts
          %p
            We first construct an integers object as follows. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} a, b\colon E \to \mathbb{N} \times \mathbb{N}
            be the
            %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernel pair
            of the addition map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} {+}\colon \mathbb{N} \times \mathbb{N} \to \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo ,
                  %msub
                    %mi π
                    %mn 2
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2\colon \mathbb{N} \times \mathbb{N} \to \mathbb{N}
            be the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            projections. We define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            to be the
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo ∘
                    %mi a
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo ∘
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo ∘
                    %mi b
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo ∘
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (\pi_1 \circ a, \pi_2 \circ b), (\pi_1 \circ b, \pi_2 \circ a)\colon E \to \mathbb{N}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          %p
            We denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}(A)
            the
            %a.existingWikiWord{:href => "/nlab/show/power+object"} power object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %strong Dedekind cut
            is a
            %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L, U)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}(\mathbb{Q}) \times \mathcal{P}(\mathbb{Q})
            %a.existingWikiWord{:href => "/nlab/show/Mitchell-B%C3%A9nabou+language"} Mitchell-Bénabou language
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            and interpreted under
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Kripke-Joyal+semantics"} Kripke-Joyal semantics
          %ol
            %li
              %p Non-degenerate:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∃
                      %mi q
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mi q
                      %mo ∈
                      %mi L
                      %mo ;
                    %annotation{:encoding => "application/x-tex"} \exists q\colon \mathbb{Q}.\, q \in L ;
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∃
                      %mi r
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mi r
                      %mo ∈
                      %mi U
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \exists r\colon \mathbb{Q}.\, r \in U .
            %li
              %p Inward-closed:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi q
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mo ∀
                      %mi r
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo &lt;
                      %mi r
                      %mo ∧
                      %mi r
                      %mo ∈
                      %mi L
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi q
                      %mo ∈
                      %mi L
                      %mo{:stretchy => "false"} )
                      %mo ;
                    %annotation{:encoding => "application/x-tex"} \forall q\colon \mathbb{Q}.\, \forall r\colon \mathbb{Q}.\, ((q \lt r \wedge r \in L) \implies q \in L) ;
              .maruku-equation
