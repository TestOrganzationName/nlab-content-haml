                    %mrow
                      %mo ∀
                      %mi q
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo ∈
                      %mi L
                      %mo ⇒
                      %mo ∃
                      %mi r
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
