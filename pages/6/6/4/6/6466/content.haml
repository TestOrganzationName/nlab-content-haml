                      %mi r
                      %mo ∈
                      %mi L
                      %mo ∧
                      %mi q
                      %mo &lt;
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall q\colon \mathbb{Q}.\, (q \in L \implies \exists r\colon \mathbb{Q}.\, (r \in L \wedge q \lt r))
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi q
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
