                      %mo ∀
                      %mi r
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℚ
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo &lt;
                      %mi r
                      %mo ⇒
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo ∈
                      %mi L
                      %mo ∨
                      %mi r
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \forall q\colon \mathbb{Q}.\, \forall r\colon \mathbb{Q}.\, (q \lt r \implies (q \in L \vee r \in U)) .
