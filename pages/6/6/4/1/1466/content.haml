                  %annotation{:encoding => "application/x-tex"} F_X(\{1,2,3\})\rightarrow F_X(\{1,2\})\rightarrow F_X(\{2\})\leftarrow F_X(\{2,3\})\leftarrow F_X(\{1,2,3\})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\rightarrow Y
            of uniform structures is the same as to give a natural transformation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi X
