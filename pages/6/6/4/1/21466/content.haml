                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ⊗
                            %mi V
                            %mo ⊗
                            %mi V
                            %mo ,
                            %mi V
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi ⋮
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    MultEnd(V)_1 &amp; = V
                    \\\
                    MultEnd(V)_0 &amp; = Hom_k(V,V) = \mathfrak{gl}(V)
                    \\\
                    MultEnd(V)_{-1} &amp; =  Hom_k(V, Hom_k(V,V)) \simeq  Hom_k(V \otimes V, V)
                    \\\
                    MultEnd(V)_{-2} &amp; = Hom_k(V, Hom_k(V, Hom_k(V,V))) \simeq  Hom_k(V \otimes V \otimes V, V)
                    \\\
                    \\vdots
                    \\end{aligned}
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these component spaces as a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              with the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/even+number"} even number
              = succeed "-degrees" do
                %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd number
            %p
              On this
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              consider a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+bracket"} super Lie bracket
              defined
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recusively
              as follows:
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo ∈
                    %mi MultEnd
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_1, v_2 \in MultEnd(V)_1 = V
              we set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [v_1, v_2] \;=\; 0
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi MultEnd
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ≤
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} f \in MultEnd(V)_{n \leq 0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi MultEnd
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v \in MultEnd(V)_1 = V
              we set
            #eq:SuperLieBracketOnDegree0InSuperLieAlgebraInducedFromVectorSpace.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [f, v]
                    \\;\coloneqq\;
                    f(v)
            %p
              Finally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi MultEnd
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} f\in MultEnd(V)_{ deg(f) \leq 0 }
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi MultEnd
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} g\in MultEnd(V)_{deg(g) \leq 0}
              we set
            #eq:SuperLieBracketInSuperLieAlgebraInducedFromVectorSpace.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi f
                            %mo ,
                            %mi g
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thickmathspace"}
                            %mi v
                            %mspace{:width => "thickmathspace"}
                            %mo ↦
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} [
                            %mi f
                            %mo ,
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mi g
                            %mo ,
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                        %mtr
