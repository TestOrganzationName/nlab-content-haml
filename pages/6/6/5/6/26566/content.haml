            %strong coupling
            or
            %strong transport plan
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A},p)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B},q)
            is a probability space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo ,
                  %mi 𝒜
                  %mo ⊗
                  %mi ℬ
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X\times Y, \mathcal{A}\otimes\mathcal{B},r)
            where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                      %mo ⊗
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}\otimes\mathcal{B}
                is the
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                %a.existingWikiWord{:href => "/nlab/show/sigma-algebra"} sigma-algebra
                on the
                %a.existingWikiWord{:href => "/nlab/show/topological+product+space"} product space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\times Y
                (generated by the sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ×
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A\times B
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
                and
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ∈
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/measure"} measure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                has
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                as marginals, in the sense that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ∈
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      r(A\times Y) \,=\, p(A)
                      \\;\;
                      \\text{and}
                      \\;\;
                      r(X\times B) \,=\, q(B)
                      \\,.
          %h2#main_constructions Main constructions
          %h3#identity_coupling Identity coupling
          %p
            Given a probability space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝒜
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\mathcal{A},p)
            %strong identity coupling
            or
            %strong diagonal coupling
            is given by the following measure on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ⊗
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}\otimes\mathcal{A}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∩
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Delta_p (A\times A') = p(A\cap A')
          %p
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi A
                    %mo ′
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A,A'\in\mathcal{A}
          %p
            Intuitively, this is a copy of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            concentrated on the diagonal subset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %mo ∈
                    %mi X
                    %mo{:stretchy => "false"} }
                    %mo ⊆
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \{(x,x):x\in X\}\subseteq X\times X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A})
            is standard Borel, the diagonal subset is measurable, and so this intuition can be made precise.)
          %p
            This coupling gives the
            %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+couplings"} category of couplings
          %h3#independent_coupling Independent coupling
          %p
            Given probability spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A},p)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B},q)
            the
            %strong independent coupling
            or
            %strong product coupling
            or
            %strong constant coupling
            is given by the product measure
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⊗
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p\otimes q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ⊗
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (p\otimes q)(A\times B) = p(A)\,q(B)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
          %p
            In terms of transport plans, this arranges the mass from almost all points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to a distribution proportional to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
          %h3#composition_of_couplings Composition of couplings
          %p
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝒜
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\mathcal{A},p)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B},q)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo ,
                  %mi 𝒞
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Z,\mathcal{C},r)
            be
            %a.existingWikiWord{:href => "/nlab/show/standard+Borel"} standard Borel
            probability spaces, and consider transport plans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %strong composite transport plan
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∘
                  %mi s
                %annotation{:encoding => "application/x-tex"} t\circ s
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is defined as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ∘
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi Y
                  %mi s
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi t
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} |
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi dy
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (t\circ s)(A\times C) = \int_Y s'(A|y)\,t'(C|y) q(dy)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} C\in\mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ′
                %annotation{:encoding => "application/x-tex"} s'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ′
                %annotation{:encoding => "application/x-tex"} t'
            are the
            %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#regular_conditionals_from_a_joint_distribution"} regular conditional distributions
            associated to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            given
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and then according to the plan
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            This construction gives composition in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+couplings"} category of couplings
          %p
            In
            = succeed "," do
              %a{:href => "#non_borel"} Kozen-Silva-Voogd’23
          %h3#couplings_induced_by_functions Couplings induced by functions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:(X,\mathcal{A},p)\to(Y,\mathcal{B},q)
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measure-preserving+function"} measure-preserving function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi f
                %annotation{:encoding => "application/x-tex"} r_f
            as follows,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi A
                  %mo ∩
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  r_f(A\times B) = p\big(A\cap f^{-1}(B)\big)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to the point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
          %p
            Note that in general there may exist no measure-preserving function between two probability spaces, for example, on the real line, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a
            %a.existingWikiWord{:href => "/nlab/show/Dirac+measure"} Dirac delta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is not. A construction that always exists is in terms of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernels"} Markov kernels
          %h3#couplings_induced_by_kernels Couplings induced by kernels
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k:(X,\mathcal{A},p)\to(Y,\mathcal{B},q)
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#measurepreserving_kernels"} measure-preserving Markov kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi k
                %annotation{:encoding => "application/x-tex"} r_k
            as follows,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi A
                  %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi dx
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  r_k(A\times B) = \int_A k(B|x)\,p(dx)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to a measure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            proportional to the measure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ↦
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B\mapsto k(B|x)
          %p
            Note that in the formula above, the measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ↦
                  %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B\mapsto k(B|x)
            is invoked only for almost all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            on a
            = succeed "-measure-zero" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %em mass
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            In many cases, such as if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B})
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/standard+Borel"} standard Borel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi k
                %annotation{:encoding => "application/x-tex"} r_k
            for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+couplings#equivalence_of_the_definitions"} the discussion at "category of couplings"
          %h3#bayesian_inversion Bayesian inversion
          %p
            Couplings are in some sense undirected, meaning that every transport plan from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            can also be seen as (and canonically induces) a transport plan from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            This makes the
            %a.existingWikiWord{:href => "/nlab/show/category+of+couplings"} category of couplings
            canonically a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dagger+category"} dagger category
          %p
            For transport plans specified by kernels, this symmetry corresponds exactly to
            %a.existingWikiWord{:href => "/nlab/show/Bayesian+inversion"} Bayesian inversion
            of kernels.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/category+of+couplings"} category of couplings
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markov+kernel"} Markov kernel
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
            %li
              %p
                %span.newWikiWord
                  optimal transport
                  %a{:href => "/nlab/new/optimal+transport"} ?
          %h2#references References
          %ul
            %li#villani
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cedric+Villani"}> Cedric Villani
                ,
                = succeed "," do
                  %em Optimal transport: old and new
            %li
              %p
                Fredrik Dahlqvist, Vincent Danos, Ilias Garnier, and Alexandra Silva,
                = succeed "," do
                  %em Borel kernels and their approximation, categorically
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1803.02651"} arXiv
            %li#non_borel
              %p
                Dexter Kozen, Alexandra Silva, Erik Voogd,
                = succeed "," do
                  %em Joint Distributions in Probabilistic Semantics
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2309.06913"} arXiv
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"}> Paolo Perrone
                ,
                = succeed "," do
                  %em Lifting couplings in Wasserstein spaces
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2110.06591"} arXiv:2110.06591
          .property
            category:
            %a.category_link{:href => "/nlab/all_pages/probability"} probability
