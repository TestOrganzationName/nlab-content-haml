          %h2#idea Idea
          %p
            Local boundedness of a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            is a generalization of the notion of
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} local presentability
            that includes the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          %h2#context_2 Context
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
            with a proper
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/factorization+system"} factorization system
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            where every
            %a.existingWikiWord{:href => "/nlab/show/morphism"} map
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is an
            %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            and every map in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          %p
            The
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %strong union
            of a small family of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi j
                  %mo →
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi j
                      %mo ∈
                      %mi J
                %annotation{:encoding => "application/x-tex"} (A_j \to B)_{j \in J}
            is the unique
            = succeed "-subobject" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \to B
            containing the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi j
                %annotation{:encoding => "application/x-tex"} A_j
            and so that the induced map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi j
                  %msub
                    %mi A
                    %mi j
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \sum_j A_j \to A
            is in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            factorization to the canonical map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %msub
                      %mi A
                      %mi j
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \sum_j A_j \to B
          %p
            If the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
