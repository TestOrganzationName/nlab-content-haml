            #KnizhnikZamolodchikovConnectionIsFlat.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mi ZK
                    %annotation{:encoding => "application/x-tex"} \omega_{ZK}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#KnizhnikZamolodchikovConnection"}
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi ω
                        %mi ZK
                      %mo +
                      %msub
                        %mi ω
                        %mi ZK
                      %mo ∧
                      %msub
                        %mi ω
                        %mi ZK
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d \omega_{ZK} + \omega_{ZK} \wedge \omega_{ZK}
                      \\;=\;
                      0
                      \\,.
