                          %mi G
                        %annotation{:encoding => "application/x-tex"} pr_2 \colon \Gamma \rtimes_\alpha G \to G
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi ℬ
                        %mi Γ
                        %msup
