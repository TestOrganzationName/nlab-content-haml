              are equivalent to plain actions of the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
