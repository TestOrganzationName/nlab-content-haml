                            %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma \times U
                    \&amp;&amp;
                    \\underoverset
                    {\simeq}
                    {
                    (\gamma,u)
                    \\mapsto
                    [\gamma,\sigma(u)]
