            %p
          .proof
            %h6 Proof
            %p
              The first statement is the evident specialization of the second. It may help to go through the proof first in this special case of trivial
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              can tend to obscure the simple logic behind it.
            %p
              First consider the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo =
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H = G
              = succeed "-invariance" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ×
                    %mi G
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \\colon
                    G \times G
                    \\to
                    \\Gamma
              means that its value depends only on the difference of its arguments
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %msubsup
                      %mi g
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(g_1, g_2) = F'( g_1 g_2^{-1} )
            %p
              and functoriality then means equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \mapsto (F'(g), g)
              is a group homomorphism to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %msub
                        %mo ⋊
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \Gamma \rtimes_\alpha
            %p
              Similarly,
              = succeed "-invariance" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \eta \colon G \to \Gamma
              means that its components are fixed by its values on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} e \in G
              via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta( g^{-1} ) \;=\; \alpha(g)(\eta(e))
                    \\,.
            %p
              With this, the naturality square for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              commutes precisely if two sections
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \mapsto (F'(g), g)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mi e
                      %mo ∈
                      %mi Γ
                      %msub
                        %mo ⋊
                        %mi α
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \gamma_e \in \Gamma \rtimes_\alpha G
            %p
              This proves the equivalence in the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo =
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H = G
            %p
              Next to see the claim for general
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \subset G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ×
                    %mi H
                    %mo ⇉
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ×
                    %mi G
                    %mo ⇉
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H \times H \rightrightarrows H) \hookrightarrow (G \times G \rightrightarrows G)
              followed by the above equivalence (now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              replaced by
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              that fills up unspecified data by neutral elements. It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mi i
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} p \circ i = id
              and one checks that there is a homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi id
                    %mo ⇒
                    %mi i
                    %mo ∘
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (id \Rightarrow i \circ p )
              (which is straightforward if one chooses good diagrammatic notation…).
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              To the extent that passage to fixed loci commutes with realization (this would be guaranteed if we could use ordinary geometric realization in Prop.
              %a.maruku-ref{:href => "#RealizationOfMurayamaShimakawaGroupoidForDiscreteGIsClassifyingSpace"}
              which works as soon as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is compact Lie), Prop.
              %a.maruku-ref{:href => "#FixedLociOfcalBGammaForDiscreteG"}
              immediately implies the behaviour of equivariant classifying spaces under fixed loci according to
              %a{:href => "#Lashof82"} Lashof 82, Thm. 2.17
              and
              = succeed "." do
                %a{:href => "#LashofMay86"} Lashof &amp; May 86, Thm. 10
            %p
              Related discussion is in
              = succeed "." do
                %a{:href => "#GuillouMayMerling17"} Guillou, May &amp; Merling 17, pp. 15
          %p (…)
          %p
          #EquivariantClassifyingSpaceForAbelianCompactLieStructureGroup.num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              which is also
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
              (hence a
              %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
              of an
              %a.existingWikiWord{:href => "/nlab/show/n-torus"} n-torus
              with a abelian
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              = succeed "-action," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/G-space"} G-space
              for
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Map
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mi G
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi B
                      %mi Γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map(E G ,\, B\Gamma)
          This is
          = succeed "," do
            %a{:href => "#LashofMaySegal83"} Lashof, May &amp; Segal 1983, Lem. 1 with Thm. 2
          = succeed "." do
            %a{:href => "#May90"} May 1990, Thm. 10
          %p
            This implies that for abelian compact Lie structure groups
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
