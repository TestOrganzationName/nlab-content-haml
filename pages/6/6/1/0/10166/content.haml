                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi G
                        %mo →
                        %mi Γ
                        %msub
                          %mo ⋊
                          %mi α
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \phi \colon G \to \Gamma \rtimes_\alpha G
                  which are
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi pr
                          %mn 2
                        %mo ∘
                        %mi ϕ
                        %mo =
