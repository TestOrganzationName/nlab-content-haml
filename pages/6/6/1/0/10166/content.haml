                    {
                    \\longrightarrow
                    }
                    \&amp;&amp;
                    \\Big(
                    \\big(
                    \\Gamma \rtimes_\alpha G
                    \\big) / {\widehat H}
                    \\Big)_{\vert U}
                    \\\
