                      %annotation{:encoding => "application/x-tex"} pr_2 \circ \phi = id_G
                  ) of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi pr
                            %mn 2
                          %mo{:lspace => "verythinmathspace"} :
                          %mi Γ
                          %msub
