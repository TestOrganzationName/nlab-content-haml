          .proof
            %h6 Proof
            %p
              This follows immediately by the fact (
              %a{:href => "equivariant+group#ActionsOfEquivariantGroupsAsSemidirectProductGroupActions"}> this Prop.
              ) that
              = succeed "-equivariant" do
