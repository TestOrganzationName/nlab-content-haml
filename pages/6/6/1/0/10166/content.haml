          .proof
            %h6 Proof
            %p
              This is Theorem 3.1 in
              = succeed "," do
                %a{:href => "#MurayamaShimakawa95"} Murayama-Shimakawa 95
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
