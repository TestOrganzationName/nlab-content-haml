                    }
                    }
            %p
          %p
          .proof
            %h6 Proof
            %p
            %p
              Regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              as equipped with the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %msub
                        %mo ⋊
                        %mi α
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \Gamma \rtimes_\alpha G
              = succeed "." do
                %a.maruku-ref{:href => "#PrincipalBundlesInternalToGSpacesEquivalentTotomDieckBundles"}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %msub
                      %mi P
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} e \in P_{[H]}
              be any point in the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi H
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} [H] \in G/H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Stab
                      %mrow
                        %mi Γ
                        %msub
                          %mo ⋊
                          %mi α
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    {\widehat H} \;\coloneqq\; Stab_{\Gamma \rtimes_\alpha G}(e)
            %p
              to be its
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
              under the
              = succeed "-action." do
                %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi H
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} {\widehat H}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/closed+subgroup"} closed subgroup
                  because
                  %a{:href => "closed+subgroup#StabilizerSubgroupsOfContinuousActionsOnT1SpacesAreClosed"} stabilizer subgroups are closed subgroups
                  under the Hausdorff-ness assumption;
              %li
                %p
                  under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %msub
                          %mo ⋊
                          %mi α
                        %mi G
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi pr
                              %mn 2
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \Gamma \rtimes_\alpha G \overset{pr_2}{\longrightarrow} G
                  we have
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi H
                            %mo ^
                          %mo →
                          %mi H
                        %annotation{:encoding => "application/x-tex"} {\widehat H} \to H
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi h
                            %mo{:stretchy => "false"} ^
                          %mo ∈
                          %mover
                            %mi H
                            %mo ^
                        %annotation{:encoding => "application/x-tex"} \hat h \in \widehat H
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} [
                                %mi H
                                %mo{:stretchy => "false"} ]
                              %mtd
                                %mo =
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi h
                                  %mo{:stretchy => "false"} ^
                                %mo ⋅
                                %mi e
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %msub
                                  %mi pr
                                  %mn 2
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi h
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi e
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %msub
                                  %mi pr
                                  %mn 2
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi h
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mo{:stretchy => "false"} [
                                %mi H
                                %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        [H]
                        \&amp;= p(\hat h \cdot e)
                        \\\
                        \&amp; = pr_2(\hat h) \cdot p(e)
                        \\\
                        \&amp; = pr_2(\hat h) \cdot [H]
                        \\end{aligned}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi H
                          %mo ^
                        %mo →
                        %mi H
