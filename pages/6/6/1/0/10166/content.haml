                  is a
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
                  %a.existingWikiWord{:href => "/nlab/show/separable+metric+space"} separable metric space
                  such that for every
                  = succeed "-" do
