            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} U \subset G/H
            %ul
              %li
                %p It is clear by construction that the map is
                %ol
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/continuous+function"}> continuous
                      \.
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \Gamma
                      \-equivariant.
              %li
                %p
                  To see that map is an isomorphism it is sufficient to see that it is so over each
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                          %mo ∈
                          %mi U
                        %annotation{:encoding => "application/x-tex"} u \in U
                %ul
                  %li
                    %p
                      Injectivity here follows from the fact that
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi H
                              %mo ^
                          %annotation{:encoding => "application/x-tex"} {\widehat H}
                      is a lift of
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi H
                            %annotation{:encoding => "application/x-tex"} H
                      %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
                      is the neutral element.
                  %li
                    %p
                      To see that the map is surjective over each
                      = succeed ":" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi u
                              %mo ∈
                              %mi U
                            %annotation{:encoding => "application/x-tex"} u \in U
                    %p
                      That
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi γ
                            %mo ,
                            %mi g
                            %mo{:stretchy => "false"} ]
                            %mo ∈
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Γ
                            %msub
                              %mo ⋊
                              %mi α
                            %mi G
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:stretchy => "false"} /
                            %mover
                              %mi H
                              %mo ^
                          %annotation{:encoding => "application/x-tex"} [\gamma, g] \in \big( \Gamma \rtimes_\alpha G \big)/{\widehat H}
                      is in the fiber over
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi u
                          %annotation{:encoding => "application/x-tex"} u
                      means that
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi g
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mi u
                              %mo{:stretchy => "false"} )
                              %mo ∈
                              %mi H
                              %mo ⊂
                              %mi G
                            %annotation{:encoding => "application/x-tex"} g^{-1} \sigma(u) \in H \subset G
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi h
                              %mo{:stretchy => "false"} ^
                            %mo ∈
                            %mover
                              %mi H
                              %mo ^
                          %annotation{:encoding => "application/x-tex"} \hat h \in \widehat H
                      the unique element with
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi pr
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi h
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} pr_2(\hat h) = g^{-1} \sigma(u)
                      we see that
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi γ
                              %mo ,
                              %mi g
                              %mo{:stretchy => "false"} ]
                              %mo =
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                              %mo{:stretchy => "false"} (
                              %mi γ
                              %mo ,
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %mi q
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
