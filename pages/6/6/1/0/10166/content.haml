                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              )
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              – to be called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/equivariance+group"} equivariance group
              – we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Actions
                    %mo{:stretchy => "false"} (
                    %mi TopologicalSpaces
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Categories
                  %annotation{:encoding => "application/x-tex"}
                    G Actions(TopologicalSpaces)
                    \\;\in\;
                    Categories
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\rho)
                  are
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  equipped with
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/actions"} actions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ×
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                        %mi X
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ↔
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi G
                        %mover
                          %mo ⟶
                          %mi ρ
                        %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        G \times X \overset{}{\longrightarrow} X
                        \\;\;\;\;\;\;
                        \\leftrightarrow
                        \\;\;\;\;\;\;
                        G \overset{\rho}{\longrightarrow} Aut(X) \subset Maps(X,X)
                        \\,;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  between them (“maps”); i.e. for the category of “
                  %a.existingWikiWord{:href => "/nlab/show/G-spaces"}> G-spaces
                  ”, often denote “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi G
                        %mi Spaces
                      %annotation{:encoding => "application/x-tex"} G Spaces
                  ” or even
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mi Sp
                      %annotation{:encoding => "application/x-tex"} G Sp
                  or similar.
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              (
              %strong> further conditions on the equivariance group
              )
              %br/
              For purposes of
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
              one typically assumes the
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological
              %a.existingWikiWord{:href => "/nlab/show/equivariance+group"} equivariance group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              in Def.
              %a.maruku-ref{:href => "#TopologicalGSpaces"}
              to be that underlying a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              (as that guarantees that
              %a.existingWikiWord{:href => "/nlab/show/G-CW-complexes"} G-CW-complexes
              are well-behaved and that the
              %a.existingWikiWord{:href => "/nlab/show/equivariant+Whitehead+theorem"} equivariant Whitehead theorem
              holds). But for the plain
              %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
              of equivariant bundles, this condition is not necessary.
          %p
          #GSpacesAreCartesianMonoidal.num_remark
            %h6 Remark
            %p
              (
              %strong>
                %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
                are
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+monoidal+category"} cartesian monoidal
              ) The category of
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalGSpaces"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+monoidal+category"} Cartesian monoidal category
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of two
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi ρ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_i, \rho_i)
              is the underlying
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal action
              by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ρ
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (X_1, \rho_1)
                    \\times
                    (X_2, \rho_2)
                    \\;=\;
                    \\Big(
                    X_1 \times X_2,
                    \\,
                    \\rho_{1,2}(g)(x_1,x_2)
                    \\,=\,
                    \\big(
                    \\rho_1(x_1), \rho_2(x_2)
                    \\big)
                    \\Big)
                    \\,.
            %p
          In a
          %a.existingWikiWord{:href => "/nlab/show/Cartesian+monoidal+category"} Cartesian monoidal category
          there is a notion of
          %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
          = succeed ":" do
            %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
          %h3#equivariant_groups Equivariant groups
          %p
            We follow the terminology of
            = succeed ":" do
              %a{:href => "#SatiSchreiber21"} SS 2021, Def. 2.1.2
          %p
          #EquivariantTopologicalGroup.num_defn
            %h6 Definition
            %p
              (
              %strong> equivariant topological groups
              )
              %br/
              Given an
              %a.existingWikiWord{:href => "/nlab/show/equivariance+group"} equivariance group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicalGSpaces"}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-
                %a.existingWikiWord{:href => "/nlab/show/equivariant+topological+group"} equivariant topological group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma, \alpha)
              is a
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              to
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#TopologicalGSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Γ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi α
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Groups
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mi Actions
                    %mo{:stretchy => "false"} (
                    %mi TopologicalSpaces
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    \\Gamma,
                    \\,
                    \\alpha
                    \\big)
                    \\;\in\;
                    Groups
                    \\big(
                    G Actions
                    (
                    TopologicalSpaces
                    )
                    \\big)
                    \\,.
            %p
          (See Prop.
          %a.maruku-ref{:href => "#EquivariantGroupsAsSemidirectProductGroups"}
          below for the choice of notation used here.)
          %p
          #UnderlyingTopologicalGroupOfAnEquivariantTopologicalGroup.num_remark
            %h6 Remark
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              from
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalGSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mi Actions
                            %mo{:stretchy => "false"} (
                            %mi TopologicalSpaces
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi TopologicalSpaces
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G Actions
                    (
                    TopologicalSpaces
                    )
                    \&amp;
                    \\overset{
                    }{\longrightarrow}
                    \&amp;
                    TopologicalSpaces
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              (explicitly so by Remark
              = succeed ")," do
                %a.maruku-ref{:href => "#GSpacesAreCartesianMonoidal"}
              %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
              and hence sends
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ")" do
                %a.maruku-ref{:href => "#EquivariantTopologicalGroup"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
            #eq:ForgetfulFunctorFromEquivariantTopologicalGroupsToTopologicalGroups.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Groups
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi G
                            %mi Actions
                            %mo{:stretchy => "false"} (
                            %mi TopologicalSpaces
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Groups
                            %mo{:stretchy => "false"} (
                            %mi TopologicalSpaces
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Γ
                            %mo ,
                            %mi α
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi Γ
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Groups
                    \\big(
                    G Actions
                    (
                    TopologicalSpaces
                    )
                    \\big)
                    \&amp;
                    \\overset{
                    }{\longrightarrow}
                    \&amp;
                    Groups
                    (
                    TopologicalSpaces
                    )
                    \\\
                    \\big(
                    \\Gamma
                    ,
                    \\alpha
                    \\big)
                    \&amp;\mapsto&amp;
                    \\Gamma
                    \\,.
                    }
            %p
          %h3#equivariant_bundles Equivariant bundles
          %p
            We say that a
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to
            %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
            (
            %a{:href => "#SatiSchreiber21"}> SS 2021, Def. 2.1.3
            ).
          %p
            (Beware that, following tradition in equivariant bundle theory, we do not impose a
            %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivializability condition
            at this point, but add this as an extra clause later and then speak explicitly of
            %em locally trivial equivariant bundles
            – for more on this see at
            = succeed ".)" do
              %em
                %a{:href => "#NotionsOfEquivariantLocalTriviality"} Notions of equivariant local triviality
          %p
          #EquivariantPrincipalBundles.num_defn
            %h6 Definition
            %p
              (
              %strong>
                %a.existingWikiWord{:href => "/nlab/show/equivariant+principal+bundle"} equivariant principal bundle
              )
              %br/
              Given
            %ul
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/equivariance+group"} equivariance group
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo ∈
                          %mi Groups
                          %mo{:stretchy => "false"} (
                          %mi TopologicalSpaces
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} G \in Groups(TopologicalSpaces)
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+topological+group"} equivariant topological group
                  (Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EquivariantTopologicalGroup"}
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo ,
                        %mi α
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi Groups
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi G
                        %mi Actions
                        %mo{:stretchy => "false"} (
                        %mi TopologicalSpaces
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        (\Gamma, \alpha)
                        \\;\in\;
                        Groups\big(  G Actions(TopologicalSpaces) \big)
                %p
                  to be called the
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/structure+group"} structure group
            %p
              a
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-equivariant
                = succeed "-principal" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo ,
                        %mi α
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Gamma,\alpha)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\rho)
                is:
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mover
                          %mo →
                          %mi p
                        %mi X
                      %annotation{:encoding => "application/x-tex"} P \overset{p}{\to} X
                  in
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
                  of a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi Γ
