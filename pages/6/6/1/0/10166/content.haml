                    \\array{
                    G \times_H
                    (S \times \Gamma)
                    \\\
                    \\big\downarrow
                    \\\
                    G \times_H S
                    \\,.
                    }
            %p
              By Prop.
              %a.maruku-ref{:href => "#EquivariantPrincipalBundlesOverCosetSpacesAreSemidirectProductCosetsSpaceBundles"}
              and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha = 1
              we obtain from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              an equivariant principal bundle over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
              by taking the subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} {\widehat H}
              in
              %a.maruku-eqref{:href => "#eq:EquivariantBundleOfCosetSpaces"} (4)
              to be the
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              %a.maruku-eqref{:href => "#eq:LashofActionOfHOnGammaInProofLashofImpliestoDieck"} (8)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ×
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\widehat H}
                    \\;\coloneqq\;
                    graph(\phi)
                    \\;\subset\;
                    \\Gamma \times G
                    \\,.
            %p
              Observing that the
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              by a subgroup of this form coincindes with the quotient by the
              %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ×
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %msub
                      %mo ×
                      %mi H
                    %mi Γ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
