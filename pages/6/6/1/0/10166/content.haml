                  is a
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
                  %a.existingWikiWord{:href => "/nlab/show/separable+metric+space"} separable metric space
                  of
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                  %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+separable+metric+space"} dimension
                  and with a
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/orbit+types"} orbit types
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
