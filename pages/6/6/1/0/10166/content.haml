          #LashofLocalTrivializabilityImpliesTopDieckForTrivialAlpha.num_prop
            %h6 Proposition
            %p
              %strong
                (Lashof’s local trivializability implies tom Dieck’s for
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \alpha = 1
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha = 1
              (in Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#EquivariantTopologicalGroup"}
              = succeed ")" do
                %a.maruku-ref{:href => "#LashofEquivariantLocalTrivialization"}
              = succeed ")." do
                %a.maruku-ref{:href => "#tomDieckEquivariantLocalTrivialization"}
            %p
          %p
          .proof
            %h6 Proof
            %p
              It is sufficient to see that Lashof’s local model bundles in
              %a.maruku-eqref{:href => "#eq:LashofLocalTrivalityHomomorphism"} (7)
              are examples of tom Dieck’s local model bundles in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:tomDieckLocalTrivalityHomomorphism"} (6)
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subgroup"} closed subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/slice+theorem"} slice
              and
            #eq:LashofActionOfHOnGammaInProofLashofImpliestoDieck.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi H
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \colon H \to \Gamma
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              through which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              acts on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              in Lashof’s model for the equivariant bundle over the orbit of the slice.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
