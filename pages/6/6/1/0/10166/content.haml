                              %mo{:stretchy => "false"} (
                              %mi u
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ]
                            %annotation{:encoding => "application/x-tex"} [\gamma, g] = \big[ (\gamma,g) \cdot q \big] = [\cdots, \sigma(u)]
                    %p (Filling in the ellipses here, which is straightforward but unenlightning, actually gives the continuous inverse map.)
            %p
          %p In fact every equivariant principal bundle over a coset space is of this form:
          %p
          #EquivariantPrincipalBundlesOverCosetSpacesAreSemidirectProductCosetsSpaceBundles.num_prop
            %h6 Proposition
            %p
              %strong (equivariant principal bundle over coset spaces are semidirect product coset space bundles)
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subgroup"} closed subgroup
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma,\alpha)
              = succeed ")" do
                %a.maruku-ref{:href => "#EquivariantPrincipalBundles"}
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mover
                      %mo ⟶
                      %mi p
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    P \overset{p}{\longrightarrow} G/H
                    \\,,
            %p
              which is
              %a.existingWikiWord{:href => "/nlab/show/locally+trivial"} locally trivial
              as an ordinary
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            #eq:TrivializingBundleIosmorphismOverCosetSpace.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %msub
                              %mo ⋊
                              %mi α
                            %mi G
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mover
                              %mi H
                              %mo ^
                          %mtd
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi γ
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} ]
                                %mo ↦
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mi p
                          %mtd
                          %mtd
                            %mi P
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\Gamma \rtimes_\alpha G)/{\widehat H}
                    \&amp;&amp;
                    \\underoverset
                    {\simeq}
                    { [\gamma,g] \mapsto (\gamma,g)\cdot p }
                    {\longrightarrow}
                    \&amp;&amp;
                    P
                    \\\
                    \&amp;
                    \\searrow
                    \&amp;&amp;
                    \\swarrow
                    \\\
                    \&amp;&amp;
                    G/H
                    }
            %p
              to a
              = succeed "-bundle" do
                %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %msub
                      %mo ⋊
                      %mi α
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mover
                      %mi H
                      %mo ^
                    %mo ⟶
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} (\Gamma \rtimes_\alpha G)/{\widehat H} \longrightarrow G/H
              from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#EquivariantCosetSpaceBundles"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} {\widehat H}
              a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              to a
              %a.existingWikiWord{:href => "/nlab/show/closed+subgroup"} closed subgroup
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi H
                              %mo ^
                          %mtd
