          %h2#statement Statement
          #ParacompactHausdorffEquivalentToexistenceOfParititionsOfUnity.num_theorem
            %h6#theorem Theorem
            %p
              Assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              then:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a topological space that is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              (meaning
              %a.existingWikiWord{:href => "/nlab/show/singletons"} singletons
              are
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/separation+property"} separation property
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  is
                  %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
              %li
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  admits a subordinate
                  %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#PartitionOfUnity"}
          %p
            We give the
            %strong proof
            = succeed "." do
              %a{:href => "#ParacompactHausdorffEquivalentToexistenceOfParititionsOfUnityProof"} below
          %h2#background Background
          #LocallyFiniteCover.num_defn
            %h6#definition Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"}> locally finite cover
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em locally finite
              if for all point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              such that it
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersects
              only finitely many elements of the cover, hence such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ∩
                    %msub
                      %mi U
                      %mi i
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} U_x \cap U_i \neq \emptyset
              for only a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
          #RefinementOfOpenCovers.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            %p
              Then a
              %em
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of this open cover is a set of open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{V_j \subset X\}_{j \in J}
              which is still an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              in itself and such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j \in J
              there exists an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi j
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} V_j \subset U_i
