                subordinate to the cover
              is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi f
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{f_i\}_{i \in I}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ⟶
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        f_i \;\colon\; X \longrightarrow [0,1]
                %p
                  (where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ⊂
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} [0,1] \subset \mathbb{R}
                  is equipped with the
                  %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  regarded as the 1-dimensional
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  equipped with its
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            %p such that with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Supp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Cl
                    %mrow
                      %mo (
                      %msubsup
                        %mi f
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    Supp(f_i) \coloneqq Cl\left( f_i^{-1}( (0,1] ) \right)
            %p
              denoting the
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              (the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of the subset of points on which it does not vanish) then
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mrow
                          %mo (
                          %mi Supp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi f
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo ⊂
                          %msub
                            %mi U
                            %mi i
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\forall} \left( Supp(f_i) \subset U_i \right)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %mi Supp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo ⊂
                            %mi X
                            %mo }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \left\{ Supp(f_i) \subset X \right\}_{i \in I}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite cover
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#LocallyFiniteCover"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi x
                            %mo ∈
                            %mi X
                        %mrow
                          %mo (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi f
                            %mi i
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 1
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \underset{x \in X}{\forall} \left(  \underset{i \in I}{\sum} f_i(x) = 1 \right)
                  \.
          .num_remark
            %h6#remark Remark
            %p
              Due to the second clause in def.
              = succeed "," do
                %a.maruku-ref{:href => "#PartitionOfUnity"}
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              in the third clause involves only a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of elements not equal to zero, and therefore is well defined.
          %h2#proof Proof
          %p The non-trivial direction to be shown is:
          #OpenCoverOfParacompactHausdorffSpaceAdmitsPartitionOfUnity.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              there is a subordinate
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PartitionOfUnity"}
          %p
            We give the proof
            = succeed "." do
              %a{:href => "#OpenCoverOfParacompactHausdorffSpaceAdmitsPartitionOfUnityProof"} below
          %p
            The following says that if there exists a
            %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite
            %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
            of a cover, then in fact there exists one with the same index set as the original cover.
          #LocallyFiniteRefinementInducesLocallyFiniteWithSameIndexSet.num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi J
                      %mo →
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi V
                        %mi j
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\phi \colon J \to I), \{V_j \subset X\}_{j \in J})
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite cover
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi W
                          %mi i
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \left\{ W_i \subset X \right\}_{i \in I}
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %munder
                        %mo ∪
                        %mrow
                          %mi j
                          %mo ∈
                          %msup
                            %mi ϕ
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi V
                        %mi j
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    W_i
                    \\;\coloneqq\;
                    \\left\{
                    \\underset{j \in \phi^{-1}(\{i\})}{\cup} V_j
                    \\right\}
            %p
              is still a
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite cover
          .proof
            %h6#proof_2 Proof
            %p
              It is clear by construction that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi i
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} W_i \subset U_i
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
            %p
              Hence consider
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{V_j \subset X\}_{j \in J}
              is locally finite, it follows that there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              and a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi J
                  %annotation{:encoding => "application/x-tex"} K \subset J
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                        %mo \
                        %mi K
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mi x
                      %mo ∩
                      %msub
                        %mi V
                        %mi j
                      %mo =
                      %mi ∅
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{j \in J\backslash K}{\forall} \left( U_x \cap V_j = \emptyset \right)
                    \\,.
            %p Hence by construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                        %mo \
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mi x
                      %mo ∩
                      %msub
                        %mi W
                        %mi i
                      %mo =
                      %mi ∅
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I\backslash \phi(K)}{\forall} \left( U_x \cap W_i = \emptyset \right)
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \phi(K) \subset I
              is still a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{W_i \subset X\}_{i \in I}
              is locally finite.
          #PatchesOfOpenCoverOfNormalSpaceMayBeMadeSmallerSoThatTheirClosuresAreContained.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/shrinking+lemma"}> shrinking lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              which is
              %a.existingWikiWord{:href => "/nlab/show/normal+topological+space"} normal
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be a
              %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            %p
              Assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              then:
            %p
              There exists another open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{V_i \subset X\}_{i \in I}
              such that the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V_i)
              of its elements is contained in the original patches:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mrow
                      %mo (
                      %msub
                        %mi V
                        %mi i
                      %mo ⊂
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\forall}
                    \\left(
                    V_i \subset Cl(V_i) \subset U_i
                    \\right)
                    \\,.
          #OpenCoverOfParacompactHausdorffSpaceAdmitsPartitionOfUnityProof.proof
            %h6#proof_3 Proof
            %p
              of prop.
              %a.maruku-ref{:href => "#OpenCoverOfParacompactHausdorffSpaceAdmitsPartitionOfUnity"}
            %p
              By paracompactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              %a.maruku-ref{:href => "#LocallyFiniteRefinementInducesLocallyFiniteWithSameIndexSet"}
              we may assume that this has same index set. It is now sufficient to show that this locally finite cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              admits a subordinate partition of unity, since this will then also be subordinate to the original cover.
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+spaces+are+normal"} paracompact Hausdorff spaces are normal
              we may apply lemma
              %a.maruku-ref{:href => "#PatchesOfOpenCoverOfNormalSpaceMayBeMadeSmallerSoThatTheirClosuresAreContained"}
              to the given locally finite open cover
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi V
                        %mi i
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{V_i \subset X\}_{i \in I}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi W
                        %mi i
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{W_i \subset X\}_{i \in I}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mrow
                      %mo (
                      %msub
                        %mi W
                        %mi i
                      %mo ⊂
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi V
                        %mi i
                      %mo ⊂
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\forall}
                    \\left(
                    W_i \subset Cl(W_i) \subset V_i \subset Cl(V_i) \subset U_i
                    \\right)
                    \\,.
            %p
              It follows that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              we have two disjoint
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(W_i)
              and the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} X \backslash V_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi X
                    %mo \
                    %msub
                      %mi V
                      %mi i
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cl(W_i) \cap X\backslash V_i = \emptyset
                    \\,.
            %p
              Now since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+spaces+are+normal"} paracompact Hausdorff spaces are normal
              %a.existingWikiWord{:href => "/nlab/show/Urysohn%27s+lemma"} Urysohn's lemma
              says that there exist
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    h_i \;\colon\; X \longrightarrow [0,1]
            %p with the property that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AAA
                    %msub
                      %mi h
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo \
                    %msub
                      %mi V
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h_i( Cl(W_i) ) = \{1\}
                    \\,,
                    \\phantom{AAA}
                    h_i( X \backslash V_i ) = \{0\}
                    \\,.
            %p
              This means in particular that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi h
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} h_i^{-1}((0,1]) \subset V_i
              and hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Supp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi h
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi h
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi U
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Supp(h_i) =  Cl(h_i^{-1}((0,1])) \subset Cl(V_i) \subset U_i
                    \\,.
            %p
              By construction, the set of function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi h
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{h_i\}_{i \in I}
              already satisfies conditions 1) and 2) of the three conditions on a partition of unity subordinate to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#PartitionOfUnity"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    h \;\colon\; X \longrightarrow [0,1]
            %p
              defined on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi h
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h(x) \coloneqq \underset{i \in I}{\sum} h_i(x)
                    \\,.
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              on the right has only a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of non-zero summands, due to the local finiteness of the cover, so that this is well-defined.
            %p Moreover, notice that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mrow
                      %mo (
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{x \in X}{\forall} \left(  h(x) \neq 0  \right)
            %p
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{Cl(W_i) \subset X\}_{i \in I}
              is a cover so that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i_x \in I
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi i
                            %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in Cl(W_{i_x})
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi i
                            %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} h_i(Cl(W_{i_x})) = \{1\}
            %p Hence it makes sense to define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi h
                      %mi i
                    %mo{:stretchy => "false"} /
                    %mi h
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_i \;\coloneqq\;  h_i/h
                    \\,.
            %p
              This is now manifestly such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi f
                        %mi i
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\sum} f_i = 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi f
                          %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    f_i
                    \\right\}_{i \in I}
            %p is a partition of unity as required.
          #ParacompactHausdorffEquivalentToexistenceOfParititionsOfUnityProof.proof
            %h6#proof_4 Proof
            %p
              of theorem
              %a.maruku-ref{:href => "#ParacompactHausdorffEquivalentToexistenceOfParititionsOfUnity"}
            %p
              In one direction, assume that every open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              admits a subordinate partition of unity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi f
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{f_i\}_{i \in I}
              = succeed ")" do
                %a.maruku-ref{:href => "#PartitionOfUnity"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi Supp
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{ Int(Supp(f)_i)  \subset X\}_{i \in I}
              is a locally finite open cover refining the original one, so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is paracompact. Moreover, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x, y \in X
              there is a cover consisting of the open sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo ¬
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \neg \{x\}, \neg \{y\}
              (the
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              of the singletons). If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mo ,
                    %msub
                      %mi f
                      %mi y
                  %annotation{:encoding => "application/x-tex"} f_x, f_y
              is a subordinate partition of unity (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                  %annotation{:encoding => "application/x-tex"} f_x
              supported on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \neg \{x\}
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi y
                    %annotation{:encoding => "application/x-tex"} f_y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f_x(x) = 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi y
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} f_y(y) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mo +
                    %msub
                      %mi f
                      %mi y
                    %mo ≡
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f_x + f_y \equiv 1
              we derive
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f_x(y) = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi z
                    %mo ∈
                    %mi X
                    %mo :
                    %msub
                      %mi f
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{z \in X: f_x(z) \lt 1/2\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi z
                    %mo ∈
                    %mi X
                    %mo :
                    %msub
                      %mi f
                      %mi x
                    %mo{:stretchy => "false"} (
