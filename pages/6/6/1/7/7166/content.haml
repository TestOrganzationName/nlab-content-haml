                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo −
                        %mi r
                        %mi x
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                    %mo{:stretchy => "false"} )
