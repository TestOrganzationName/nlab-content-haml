                            %mrow
                              %mi p
                              %mo ,
                              %mi q
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo +
                              %mi j
                              %mo =
                              %mi n
                          %mrow
                            %mo (
                            %mfrac{:linethickness => "0"}
                              %mi p
                              %mi i
                            %mo )
                          %mrow
                            %mo (
                            %mfrac{:linethickness => "0"}
                              %mi q
