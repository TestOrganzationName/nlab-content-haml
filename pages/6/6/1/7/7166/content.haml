                  %annotation{:encoding => "application/x-tex"} k[x]_{(x)}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mi N
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi m
                      %mo +
                      %mi n
                      %mo =
                      %mi N
                  %msup
                    %mi x
                    %mi m
                  %mo ⊗
                  %msup
                    %mi x
                    %mi n
                  %mo .
                %annotation{:encoding => "application/x-tex"} \delta(x^N) = \sum_{m+n = N} x^m \otimes x^n.
          %p
            We may as well focus on a typical subcoalgebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (k[x]/(g(x)))^\ast
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mi x
                          %mi i
                      %mrow
                        %msup
                          %mi g
                          %mi rev
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \frac{x^i}{g^{rev}(x)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mrow
                      %msup
                        %mi x
                        %mi i
                    %mrow
                      %msup
                        %mi g
                        %mi rev
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta(\frac{x^i}{g^{rev}(x)})
            can be extracted from the multiplication table for residue classes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi j
                    %mrow
                      %mo{:lspace => "mediummathspace"} (
                      %mo{:rspace => "thinmathspace"} mod
                      %mi g
                      %mo{:rspace => "mediummathspace"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
