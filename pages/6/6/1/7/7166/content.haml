          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coalg
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Coalg(M)
            denote the category of coalgebras (i.e.,
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoids
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Coalg
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} U \colon Coalg(M) \to M
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %strong cofree coalgebra
            refers to a functor
            %em
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %h2#examples Examples
          %p
            For example, a cofree coalgebra over a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            consists of a coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(V)
            and a
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \varepsilon \colon C(V) \to V
            which is
            %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal
            in the sense that given a coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and linear map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} f \colon C \to V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g \colon C \to C(V)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi ε
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f = \varepsilon \circ g
          %h2#constructions Constructions
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Coalg
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} U \colon Coalg(M) \to M
            %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
            and
            %a.existingWikiWord{:href => "/nlab/show/reflected+colimit"} reflects
            (
            %a.existingWikiWord{:href => "/nlab/show/created+limit"}> creates
            ) any
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            which happen to exist, analogous to the fact that the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} Alg(M) \to M
            preserves and reflects
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            (which almost always obtain in cases of practical interest),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            will indeed have a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
          %h3#modules_over_a_commutative_ring Modules over a commutative ring
          %p
            The special
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            (SAFT) may be applied to show that for any commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mtext -Coalg
                  %mo →
                  %mi K
                  %mtext -Mod
                %annotation{:encoding => "application/x-tex"} K\text{-Coalg} \to K\text{-Mod}
          %p has a right adjoint. An argument is given by Michael Barr in
          %ul
            %li
              %a{:href => "http://www.math.mcgill.ca/barr/ftp/pdffiles/coalgebra.pdf"}> Coalgebras over a Commutative Ring
              ; see theorem 4.1.
          %p
            (This is somewhat at odds with an assertion made by Michiel Hazewinkel in
            = succeed "," do
              %a{:href => "http://arxiv.org/ftp/arxiv/papers/0804/0804.3888.pdf"} Witt Vectors, Part I
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"} Todd Trimble
          %h3#cofree_coalgebra_over_a_vector_space Cofree coalgebra over a vector space
          %p In what follows, we give an explicit construction of the cofree coalgebra cogenerated by a vector space.
          %p As a first step, recall the following result.
          #FundamentalTheorem.num_theorem
            %h6#theorem Theorem
            %p
              %strong (Fundamental theorem of coalgebras)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              over the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of its
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              subcoalgebras and inclusions between them.
          %p
            This seems to be due to (
            %a{:href => "#Sweedler69"}> Sweedler 69
            ). For a proof of this result, see for example (
            %a{:href => "#WM"}> Michaelis 03
            ). For more see at
            = succeed "." do
              %em
                %a{:href => "coalgebra#AsFilteredColimits"} coalgebra – As filtered colimits
          %p We repeat that colimits of coalgebras are created by taking colimits of their underlying vector spaces.
          %p
            Let for a vector space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V)
            be the
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            (or free algebra) generated by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V^\ast)
            as the algebra of (non-commutative) polynomial functions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V^\ast)
            is not a coalgebra, but in accordance with the fundamental theorem above, we may consider instead the colimit over a system of finite-dimensional coalgebras obtained by dualizing the system of finite-dimensional algebra quotients of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V^\ast)
            and surjections between them (compare
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/profinite+completion"} profinite completion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi V
                    %mo *
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} T(V^\ast)^\circ
            be this colimit coalgebra, embedded in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} T(V^\ast)^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo *
                  %mo ↪
                  %mi T
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V^\ast \hookrightarrow T(V^\ast)
            gives a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo →
                    %msup
                      %mi V
                      %mrow
                        %mo *
                        %mo *
                  %annotation{:encoding => "application/x-tex"} T(V^\ast)^\ast \to V^{\ast \ast}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo →
                    %msup
                      %mi V
                      %mrow
                        %mo *
                        %mo *
                  %annotation{:encoding => "application/x-tex"} T(V^\ast)^\circ \to V^{\ast \ast}
          %p
            For finite-dimensional
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mrow
                        %mo *
                        %mo *
                    %mo ≅
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V^{\ast \ast} \cong V
          .num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is finite-dimensional, then the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo →
                    %msup
                      %mi V
                      %mrow
                        %mo *
                        %mo *
                    %mo ≅
                    %mi V
                  %annotation{:encoding => "application/x-tex"} T(V^\ast)^\circ \to V^{\ast \ast} \cong V
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} T(V^\ast)^\circ
              as the cofree coalgebra over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          .proof
            %h6#proof Proof
            %p
              Suppose given a coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and a linear map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} f \colon C \to V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo ^
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo →
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} \widehat{f} \colon C \to T(V^\ast)^\circ
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} x \in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi x
                  %annotation{:encoding => "application/x-tex"} C_x
              containing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi C
                      %mi x
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} f_x \colon C_x \to T(V^\ast)^\circ
              is the restriction of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{f}(x)
              must match the value
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi f
                            %mi x
                        %mo ^
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widehat{f_x}(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to be finite-dimensional.
            %p
              In this case, the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi V
                      %mo *
                    %mo →
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast \colon V^\ast \to C^\ast
              extends uniquely to an algebra map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} T(V^\ast) \to C^\ast
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi onto
                    %mi Q
                    %mover
                      %mo →
                      %mi into
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} T(V^\ast) \stackrel{onto}{\to} Q \stackrel{into}{\to} C^\ast
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is a finite-dimensional algebra. The dual
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Q
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Q^\ast
              carries a coalgebra structure that embeds in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} T(V^\ast)^\circ
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %msup
                      %mi Q
                      %mo *
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} C \to Q^\ast \to T(V^\ast)^\circ
            %p
              that provide the desired lift. The uniqueness of the lift is evident from the uniqueness of the extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} T(V^\ast) \to C^\ast
              (or equivalently, of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo *
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi prof
                      %mo →
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} T(V^\ast)_{prof} \to C^\ast
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be an infinite-dimensional vector space. We may view
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            as the union or filtered colimit over the system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi V
                    %mi α
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{V_\alpha\}
            of its finite-dimensional subspaces. Applying the cofree coalgebra construction to these finite-dimensional subspaces, we get a system of coalgebras.
          #FreeCoalg.num_theorem
            %h6#theorem_2 Theorem
            %p The coalgebra colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %msub
                      %mi colim
                      %mrow
                        %msub
                          %mi V
                          %mi α
                        %mo ⊂
                        %mi V
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} K = colim_{V_\alpha \subset V} Cofree(V_\alpha),
            %p
              equipped with the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \varepsilon \colon K \to V
              that arises by applying the colimit functor to the system of universal maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cofree
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi α
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi V
                        %mi α
                    %annotation{:encoding => "application/x-tex"} Cofree(V_\alpha) \to V_\alpha
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          .num_remark
            %h6#remark Remark
            %p
              Happily, this colimit is computed as in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Vect
                    %annotation{:encoding => "application/x-tex"} Vect
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Vect \to Set
              also preserves and creates filtered colimits – this colimit is just a set-theoretic union of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cofree(V_\alpha)
              along the canonical inclusions between them.
          %p
          .proof
            %h6 Proof
            %p
              Indeed, suppose given a coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and a linear function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} f \colon C \to V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} C \to K
              which lifts
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the colimit of its finite-dimensional subcoalgebras
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi α
                    %annotation{:encoding => "application/x-tex"} C_\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi α
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} C_\alpha \to K
              indexed over these coalgebras
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi α
                    %annotation{:encoding => "application/x-tex"} C_\alpha
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi K
                    %annotation{:encoding => "application/x-tex"} C \to K
            %p
              The restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} f \colon C \to V
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi α
                  %annotation{:encoding => "application/x-tex"} C_\alpha
              factors through the image map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi α
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi C
                        %mi α
                      %mo →
                      %msub
                        %mi V
                        %mi α
                    %annotation{:encoding => "application/x-tex"} f_\alpha \colon C_\alpha \to V_\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi α
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_\alpha = f(C_\alpha)
              is a finite-dimensional subspace of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi α
                  %annotation{:encoding => "application/x-tex"} f_\alpha
              lifts uniquely to a coalgebra map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi f
                            %mi α
                        %mo ^
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi C
                        %mi α
                      %mo →
                      %mi Cofree
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widehat{f_\alpha} \colon C_\alpha \to Cofree(V_\alpha)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi α
                    %mover
                      %mo →
                      %mover
                        %mrow
                          %msub
                            %mi f
                            %mi α
                        %mo ^
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi K
                  %annotation{:encoding => "application/x-tex"} C_\alpha \stackrel{\widehat{f_\alpha}}{\to} Cofree(V_\alpha) \hookrightarrow K
            %p
              is the desired coalgebra map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi α
                      %mo →
                      %mi K
                    %annotation{:encoding => "application/x-tex"} C_\alpha \to K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} C \to K
              that is compatible with the maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} f \colon C \to V
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ε
                      %mo{:lspace => "verythinmathspace"} :
                      %mi K
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \varepsilon \colon K \to V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi ε
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (K, \varepsilon \colon K \to V)
              is weakly terminal in the comma category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} ↓
                      %mi V
                    %annotation{:encoding => "application/x-tex"} U \downarrow V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi CoAlg
                    %mo →
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} U \colon CoAlg \to Vect
              is the forgetful functor.
            %p
              It remains to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi ε
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (K, \varepsilon \colon K \to V)
              is actually the terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi U
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Cofree(V), U Cofree(V) \to V)
              (as observed above, this terminal a priori exists by an application of the special adjoint functor theorem). Since a weakly terminal subterminal object is terminal, it suffices to establish subterminality, i.e., that the unique coalgebra map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi K
                    %mo →
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i: K \to Cofree(V)
              that lifts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \varepsilon \colon K \to V
              is injective. But because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a union (a filtered colimit) of coalgebras of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cofree(V_\alpha)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi α
                  %annotation{:encoding => "application/x-tex"} V_\alpha
              ranges over finite-dimensional subspaces of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              to every such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cofree(V_\alpha)
              is injective. But (exploiting terminality of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cofree(V)
              in the comma category) this restriction can only be the coalgebra map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cofree(j): Cofree(V_\alpha) \to Cofree(V)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %msub
                      %mi V
                      %mi α
                    %mo ↪
                    %mi V
                  %annotation{:encoding => "application/x-tex"} j: V_\alpha \hookrightarrow V
              is the subspace inclusion. Note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cofree
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cofree(j)
              is injective because the right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cofree
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Vect
                    %mo →
                    %mi CoAlg
                  %annotation{:encoding => "application/x-tex"} Cofree \colon Vect \to CoAlg
              preserves the monomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
          %p
            It is easy to see that this description is equivalent to that described in a MathOverflow discussion
            = succeed "." do
              %a{:href => "http://mathoverflow.net/questions/31109/is-there-an-explicit-construction-of-a-free-coalgebra/31126#31126"} here
            = succeed "." do
              %a{:href => "https://nforum.ncatlab.org/discussion/3467"} here
          %h4#the_cofree_coalgebra_over_a_1dimensional_space The cofree coalgebra over a 1-dimensional space
          %p
            Specializing still further, we investigate the detailed structure of the cofree coalgebra over a 1-dimensional vector space (over a field)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            Here, the cofree coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi k
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} T(k)^\circ
            is the filtered colimit of finite-dimensional coalgebras of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi I
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} (k[x]/I)^\ast
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi I
                %annotation{:encoding => "application/x-tex"} k[x]/I
            is a (finite-dimensional) quotient of the polynomial algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[x]
            modulo a non-zero ideal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi I
                %annotation{:encoding => "application/x-tex"} k[x] \to k[x]/I
            is an embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi I
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo ↪
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                  %mo ≅
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi n
                  %mi k
                  %mo ⋅
                  %msup
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} (k[x]/I)^\ast \hookrightarrow k[x]^\ast \cong \prod_n k \cdot x^n
            into the space of formal power series in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
