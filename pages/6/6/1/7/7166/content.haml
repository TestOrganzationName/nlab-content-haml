                      %mi k
                      %mi n
                    %mo )
                  %msup
                    %mi r
                    %mi k
                  %msup
                    %mi x
                    %mi k
                %annotation{:encoding => "application/x-tex"} e_n(r) = \sum_{k \geq 0} \binom{k}{n} r^k x^k
          %p
