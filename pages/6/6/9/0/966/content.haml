            = succeed ")." do
              %a{:href => "#AdamekKoubekTrnkova"} AdámekKoubekTrnková01
          %h3#in_cocomplete_categories In cocomplete categories
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
