            %a.existingWikiWord{:href => "/nlab/show/small+colimits"} small colimits
            (i.e., is cocontinuous). The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
