                %semantics
                  %mrow
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \to
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              to be the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              of all the
              %a.existingWikiWord{:href => "/nlab/show/representable+functors"} representable functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mi κ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(G_\kappa,-)
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              from proper-
              %a.existingWikiWord{:href => "/nlab/show/class"}> class
              \-many of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
