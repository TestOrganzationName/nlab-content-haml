                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi i
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi s
                            %msubsup
                              %mi k
                              %mi s
                              %mn 1
                          %mtd
                            %mover
                              %mo →
