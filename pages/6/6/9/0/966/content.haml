            if and only if for any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} d\in D
            the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C^{op} \to Set
          %p that sends
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ↦
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c\mapsto D(F(c),d)
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/small+presheaf"} small presheaf
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            See the
            %a{:href => "https://mathoverflow.net/questions/346153/surmounting-set-theoretical-difficulties-in-algebraic-geometry/346162#346162"} MathOverflow answer
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ivan+Di+Liberti"} Ivan Di Liberti
          %h3#in_toposes In toposes
          .num_prop
            %h6#proposition Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              is a
              %a.existingWikiWord{:href => "/nlab/show/total+category"} total category
              and a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cototal+category"} cototal category
          %p
            See the discussion at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
          %p It follows that
          .num_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
