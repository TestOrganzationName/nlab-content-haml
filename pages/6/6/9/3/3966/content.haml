                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^k_{\rho}(P,V) \cong \Omega^k(M,P \times_{\rho}V)
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
