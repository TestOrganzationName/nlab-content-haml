              corresponds to a 2-form
              = succeed "," do
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
