                %annotation{:encoding => "application/x-tex"} \omega \in \Omega^1(P,\mathfrak{g})
            be a
            %a.existingWikiWord{:href => "/nlab/show/principal+connection"} connection
            on
            = succeed "." do
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo :
                  %mi T
                  %mi P
                  %mo →
                  %mi T
                  %mi P
                %annotation{:encoding => "application/x-tex"} H: T P \to T P
            be the horizontal projection given by
            = succeed "." do
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            We let
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a vector space, and
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mi G
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \rho: G \to \GL(V)
            be a
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            of
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed "." do
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi \in \Omega^k(P,V)
              is called:
            %ul
              %li
                %p
                  %strong> horizontal
                  , if
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ψ
                          %mi q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi v
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \psi_q(v_1,\dots,v_k)=0
                  whenever one of the vectors
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                      %annotation{:encoding => "application/x-tex"} v_i
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/vertical+vector+field"} vertical
              %li
                %p
                  %strong> equivariant
                  , if
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi r
                          %mi g
                          %mo *
                        %mi ψ
                        %mo =
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} r_g^{*}\psi = \rho(g^{-1},\psi)
                  for all
                  = succeed "," do
                    %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo ∈
                          %mi G
                        %annotation{:encoding => "application/x-tex"} g\in G
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi r
                          %mi g
                        %mo :
                        %mi P
                        %mo →
                        %mi P
                      %annotation{:encoding => "application/x-tex"} r_g: P \to P
                  denotes the right action of
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  on
                  = succeed "." do
                    %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
          %p
            We denote by
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi ρ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^k_{\rho}(P,V)
            the space of horizontal and equivariant forms. Note that
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega_{\rho}(P,V)
            is in general not closed under the ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
          .maruku-equation
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_35.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi ρ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi P
                  %msub
                    %mo ×
                    %mi ρ
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^k_{\rho}(P,V) \cong \Omega^k(M,P \times_{\rho}V),
          %p
            where
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %msub
                    %mo ×
                    %mi ρ
                  %mi V
                %annotation{:encoding => "application/x-tex"} P \times_{\rho}V
            is the vector bundle
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            to
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            via the representation
            = succeed "." do
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
          .num_defn
            %h6#definition_4 Definition
            %p
              The
              %strong exterior covariant derivative
              for forms on
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            .maruku-equation
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mo :
                    %msup
                      %mi Ω
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{d}_{\omega}: \Omega^k(P,V) \to \Omega^{k+1}(P,V)
            %p is defined by
            .maruku-equation
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_41.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mi ψ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi v
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} d
                    %mi φ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi H
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi H
                    %msub
                      %mi v
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathrm{d}_{\omega}\psi)_q(v_1,\dots,v_k) := (\mathrm{d}\varphi)_q(H v_1,\dots,H v_k).
          .num_prop
            %h6#proposition Proposition
            %p
              Every form in the image of
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_{\omega}
              is horizontal. If a form
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              is equivariant,
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_{\omega} \psi
              is also equivariant.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
              of
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_{\omega}
              to
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi ρ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^k_{\rho}(P,V)
              can be described in terms of the connection 1-form
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega\in \Omega^1(P,\mathfrak{g})
              and the derivative
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi ρ
                    %mo :
                    %mi 𝔤
                    %mo ×
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}\rho: \mathfrak{g} \times V \to V
              of the representation
              = succeed ":" do
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
            .maruku-equation
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_50.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} d
                    %mi ψ
                    %mo +
                    %mi ω
                    %msub
                      %mo ∧
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi ρ
                    %mi ψ
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{d}_{\omega}(\psi) = \mathrm{d}\psi + \omega \wedge_{\mathrm{d}\rho} \psi\text{.}
            %p
              Here we have used the following general notation: if
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ,
                    %mi V
                    %mo ,
                    %mi W
                  %annotation{:encoding => "application/x-tex"} U,V,W
              are vector spaces,
              = succeed "," do
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mo ∈
                      %msup
                        %mi Ω
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \varphi \in \Omega^p(M,V)
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi\in\Omega^q(M,W)
              and
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi V
                    %mo ×
                    %mi W
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} f: V \times W \to U
              is a linear map, we have
              = succeed "." do
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %msub
                        %mo ∧
                        %mi f
                      %mi ψ
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \varphi \wedge_{f} \psi \in \Omega^{p+q}(M,U)
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Unlike the usual
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
              %a.existingWikiWord{:href => "/nlab/show/nilpotent"} nilpotent
              in general. Instead, we have
            .maruku-equation
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_56.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Ω
                    %msub
                      %mo ∧
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi ρ
                    %mi ψ
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{d}_{\omega}(\mathrm{d}_{\omega}(\psi)) = \Omega \wedge_{\mathrm{d}\rho} \psi.
            %p
              In particular,
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mo ∘
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_{\omega} \circ \mathrm{d}_{\omega} = 0
              if
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is flat.
          .num_defn
            %h6#definition_5 Definition
            %p
              The
              %strong
                exterior covariant derivative for forms on
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
            .maruku-equation
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_60.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                    %mo :
                    %msup
                      %mi Ω
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi P
                    %msub
                      %mo ×
                      %mi ρ
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi P
                    %msub
                      %mo ×
                      %mi ρ
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{D}_{\omega}: \Omega^k(M,P \times_{\rho} V) \to \Omega^{k+1}(M,P \times_{\rho}V)
            %p
              is the map induced from
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_\omega
              under the isomorphism
              = succeed "." do
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi ρ
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msup
                        %mi Ω
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %mi P
                      %msub
                        %mo ×
                        %mi ρ
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^k_{\rho}(P,V) \cong \Omega^k(M,P \times_{\rho}V)
          %p
            Note that a connection on the principal bundle
            %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi P
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} p: P \to M
            %span.newWikiWord
              induces
              %a{:href => "/nlab/new/induced+connection"} ?
            a connection on the
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated vector bundle
            = succeed "." do
              %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi ρ
                    %mi V
                  %annotation{:encoding => "application/x-tex"} P \times_\rho V
            %a.maruku-ref{:href => "#DerivVect"}
            coincides with this exterior covariant derivative.
          .num_example
            %h6#example Example
            %p
              %code.maruku-mathml
            %ul
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
                  itself is not in
                  = succeed ":" do
                    %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi{:mathvariant => "normal"} Ad
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Omega_{\mathrm{Ad}}^1(P,\mathfrak{g})
              %li
                %p
                  The
                  %span.newWikiWord
                    curvature
                    %a{:href => "/nlab/new/curvature%23curvature_of_a_connection"} ?
                  of
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
                  is
                  = succeed "." do
                    %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ω
                          %mo :
                          %mo =
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi ω
                          %mo{:stretchy => "false"} (
                          %mi ω
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %msubsup
                            %mi Ω
                            %mi{:mathvariant => "normal"} Ad
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Omega := \mathrm{d}_\omega(\omega)\in \Omega^2_{\mathrm{Ad}}(P,\mathfrak{g})
                  = succeed "," do
                    %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi{:mathvariant => "normal"} d
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} Ad
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \mathrm{d}(\mathrm{Ad})=[-,-]
                .maruku-equation
                  %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_70.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mo =
                        %mi{:mathvariant => "normal"} d
                        %mi ω
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi ω
                        %mo ∧
                        %mi ω
                        %mo{:stretchy => "false"} ]
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        \\Omega = \mathrm{d}\omega + [\omega \wedge \omega]\text{.}
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
                  is
                  = succeed "." do
                    %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} d
                            %mi ω
                          %mi Ω
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \mathrm{d}_{\omega}\Omega=0
            %p
              Under the isomorphism
              = succeed "," do
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
