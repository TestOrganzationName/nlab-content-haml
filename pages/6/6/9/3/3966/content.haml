                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_{\omega} \in \Omega^2(M,\mathrm{Ad}(P))
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
              corresponds to
              = succeed "." do
                %math#mathml_c5350e08600968a15d34c07add55ea8e9f0ddac7_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
