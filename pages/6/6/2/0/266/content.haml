            the sharp Kan lemma can be simplified.
          %p
          .num_lemma
            %h6 Lemma
            %p
              %strong Tame Kan lemma.
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
