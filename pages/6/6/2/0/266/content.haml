          #CoendFormulaForPresheavesOfSets.num_example
            %h6#example Example
            %p
              %strong (coend formula for left Kan extension of presheaves)
            %p
              The coend formula for the left Kan extension is nicely understood when thinking of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              above as
              %a.existingWikiWord{:href => "/nlab/show/opposite+categories"} opposite categories
              and for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathcal{V} = Set
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
