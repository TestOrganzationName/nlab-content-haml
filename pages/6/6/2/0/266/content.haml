                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi c
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; c'
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    p(c_1) &amp;&amp; \stackrel{p(f)}{\longrightarrow} &amp;&amp; p(c_2)
                    \\\
                    c_1 &amp;&amp; \stackrel{f}{\longrightarrow} &amp;&amp; c_2
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; F
                    }
                    \\,.
            %p
              This is particularly suggestive in cases when we may think of the objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C'
              on the same footing, notably when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion. For in that case we may imagine that a representative pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi c
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c' \to p(c), c \to F)
              is a stand-in for the actual pullback of elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              via forming the composite “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi c
                    %mo ′
                    %mo →
                    %mi c
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} c'\to c \to F
              ”, only that this composite is not defined. But the above equivalence relation is precisely that under which this composite would be invariant.
          %h4#PointwiseByConicalLimits In terms of conical (co)limits
          %p
            In the case of functors between ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+small+categories"} locally small categories
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                %annotation{:encoding => "application/x-tex"} V =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
          .num_prop
            %h6#proposition Proposition
            %p Let
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  have all small
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %p
              Then the right Kan extension of a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F : C \to D
              of locally small categories along a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi C
                    %mo →
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} p : C \to C'
              exists and its value on an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ′
                    %mo ∈
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} c' \in C'
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ran
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo ←
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mrow
                          %mi c
                          %mo ′
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                      %mover
                        %mo →
                        %mi F
                      %mi D
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (Ran_p F)(c')
                    \\simeq
                    \\lim_\leftarrow \left((\Delta_{c'}/p) \to C \stackrel{F}{\to} D\right)
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mi c
                            %mo ′
                        %mo{:stretchy => "false"} /
                        %mi p
                      %annotation{:encoding => "application/x-tex"} \Delta_{c'}/p
                  is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mi c
                            %mo ′
                        %mo{:stretchy => "false"} /
                        %mi p
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \Delta_{c'}/p \to C
                  is the canonical
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %p
              Likewise, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              admits small
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo →
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi Δ
                        %mrow
                          %mi c
                          %mo ′
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                      %mover
                        %mo →
                        %mi F
                      %mi D
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Lan_p F)(c')
                    \\simeq
                    \\lim_\to \left((p/\Delta_{c'}) \to C \stackrel{F}{\to} D\right)
                    \\,.
          %p
            This appears for instance as (
            %a{:href => "#Borceux"}> Borceux, I, thm 3.7.2
            ). Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            is in (
            %a{:href => "#Kelly"}> Kelly, section 3.4
            ).
          %p
            A cartoon picture of the forgetful functor out of the
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Δ
                      %mrow
                        %mi c
                        %mo ′
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p/\Delta_{c'} \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi ϕ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi c
                            %mo ′
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %msub
                      %mi c
                      %mn 1
                    %mover
                      %mo →
                      %mi ϕ
                    %msub
                      %mi c
                      %mn 2
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  p(c_1) &amp;&amp;\stackrel{p(\phi)}{\to}&amp;&amp; p(c_2)
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp;  c'
                  }
                  \\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  \\left(
                  c_1 \stackrel{\phi}{\to} c_2
                  \\right)
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            here is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            of the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C'(p(-), c') : C^{op} \to Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi Δ
                    %mrow
                      %mi c
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi el
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (p/\Delta_{c'}) \simeq el( C'(p(-), c') )
                  \\,.
          .proof
            %h6#proof_2 Proof
            %p Consider the case of the left Kan extension, the other case works analogously, but dually.
            %p First notice that the above pointwise definition of values of a functor canonically extends to an actual functor:
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi c
                    %msub
                      %mo ′
                      %mn 1
                    %mo →
                    %mi c
                    %msub
                      %mo ′
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi : c'_1 \to c'_2
              any morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C'
              we get a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo *
                    %mo :
                    %mi p
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Δ
                      %mrow
                        %mi c
                        %msub
                          %mo ′
                          %mn 1
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Δ
                      %mrow
                        %mi c
                        %msub
                          %mo ′
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_* : p/\Delta_{c'_1} \to p/\Delta_{c'_2}
            %p
              of comma categories, by postcomposition. This morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %msub
                      %mo ′
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %msub
                      %mo ′
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Lan_p F)(c'_1) \to (Lan_p F)(c'_2)
                    \\,.
            %p
              Now for the universal property of the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Lan_p F
              defined this way. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ′
                    %mo ∈
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} c' \in C'
              denote the components of the colimiting
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Δ
                      %mrow
                        %mi c
                        %mo ′
                    %mo →
                    %mi C
                    %mover
                      %mo →
                      %mi F
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Lan_p F)(c') := \lim_{\to}( p/\Delta_{c'} \to C \stackrel{F}{\to} D)
              by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s_{(-)}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo →
                              %mi ϕ
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi h
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo →
                              %mi λ
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi h
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi s
                                    %mi ϕ
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi s
                                    %mi λ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Lan
                              %mi p
                            %mi F
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (p(c_1)\stackrel{\phi}{\to} c')
                    \&amp;&amp;\stackrel{p(h)}{\to}&amp;&amp;
                    (p(c_2)\stackrel{\lambda}{\to} c')
                    \\\
                    \\\
                    \\\
                    F(c_1) &amp;&amp;\stackrel{F(h)}{\to}&amp;&amp; F(c_2)
                    \\\
                    \&amp; {}_{\mathllap{s_\phi}}\searrow &amp;&amp; \swarrow_{\mathrlap{s_{\lambda}}}
                    \\\
                    \&amp;&amp; (Lan_p F)(c')
                    }
                    \\,.
            %p We now construct in components a natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi F
                    %mo :
                    %mi F
                    %mo →
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_F : F \to p^* Lan_p F
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Lan_p F
              defined as above, and show that it satisfies the required universal property. The components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \eta_F
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              are morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_F(c) : F(c) \to (Lan_p F)(p (c))
                    \\,.
            %p Take these to be given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi s
                      %mrow
                        %msub
                          %mi Id
                          %mrow
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_F(c) := s_{Id_{p(c)}}
            %p
              (this is similar to what happens in the proof of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          %h4#pointwiseVsWeak Comparing the definitions
          %p
            We have seen that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            has enough limits or colimits, then a pointwise Kan extension can be defined in terms of these limits, and will necessarily satisfy the universal property described first. However, not all Kan extensions are pointwise: that is, having a universal transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Lan
                    %mi p
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mi p
                %annotation{:encoding => "application/x-tex"} F \to (Lan_p F)p
            does not necessarily imply that the individual values of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Lan
                    %mi p
                  %mi F
                %annotation{:encoding => "application/x-tex"} Lan_p F
            are limits or colimits in its codomain. Non-pointwise Kan extensions can exist even when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            does not admit very many limits.
          %p
            It should be noted, though, that pointwise Kan extensions can still exist, and hence the particular requisite limits/colimits exist, even if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is not (co)complete. For instance, the Kan extensions that arise in the study of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            %a.existingWikiWord{:href => "/nlab/show/absolute+colimit"} absolute
            (preserved by
            %em all
            functors), even though their codomains are
            %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
            which generally do not admit all limits and colimits.
          %p
            Non-pointwise Kan extensions seem to be very rare in practice. However, the abstract notion of Kan extension (sometimes called simply “extension”) in a 2-category, and its dual notion of lifting, can be useful in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-category+theory"} 2-category theory
            %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
            such as
            %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
            admit all right extensions and right liftings; a bicategory with this property may be considered a
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
          %h3#AbsoluteKanExtension Absolute Kan extensions
          %p
            An
            %em absolute
            Kan extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Lan
                    %mi p
                  %mi F
                %annotation{:encoding => "application/x-tex"} Lan_p F
            is one which is
            %a{:href => "#Preservation"} preserved
            by all functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            out of the codomain of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Lan
                    %mi p
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Lan
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  G (Lan_p F) \simeq Lan_p(G F)
          %p (same for right Kan extensions).
          %p
            The most prominent example of absolute Kan extensions is given by
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functors
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (absolute vs pointwise)
              %br/
              Absolute Kan extensions are always pointwise, as the latter can be defined as those preserved by representables; there are (lots of) examples of pointwise Kan extensions which are not absolute.
            %p
              Note that in a general 2-category, absolute Kan extensions make perfect sense, while for defining pointwise ones more structure is needed:
              %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma objects
              and/or some structure which would let us work with (co)limits
              %em inside
              that 2-category (such as a
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+structure"} (co)Yoneda structure
              or a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/2-category+equipped+with+proarrows"} proarrow equipment
          %h3#of_functors
            Of
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The global definition of Kan extensions for functors in terms of left/right adjoints to pullbacks may be interpreted essentially verbatim in the context of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Kan+extension"} (∞,1)-Kan extension
          %h3#In2cat In a general 2-category
          %p
            The Kan extension of a functor may be regarded more abstractly as an extension-problem in the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            of categories. The same extension problem can be stated verbatim in any
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            and hence there is a corresponding more general notion of Kan extensions of
            %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            = succeed ")." do
              %a{:href => "#Lack09"} Lack 09, section 2.2
          %p
            The question of defining a
            %em pointwise
            Kan extension in a general 2-category is more subtle, and there are at least two distinct approaches. If the 2-category has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comma+objects"} comma objects
            %em conical
            colimits. On the other hand, in a
            %a.existingWikiWord{:href => "/nlab/show/2-category+equipped+with+proarrows"} 2-category equipped with proarrows
            we can define pointwise Kan extensions as particular weighted (co)limits using a representable weight; this generalizes the above definition as a weighted (co)limit.
          %p
            In some 2-categories such as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} V Cat
            the equipment-theoretic version gives the right notion of pointwise Kan extension, whereas the comma-object one is too strong.
          %p
            As a concrete example, let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} V=Cat
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mi Cat
                    %mo =
                    %mn 2
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} V Cat = 2 Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be the
            %a.existingWikiWord{:href => "/nlab/show/walking"} walking
            2-cell and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            the walking pair of parallel 1-morphisms, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mn 1
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:1\to B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mn 1
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} g:1\to M
            the inclusions of the common domain of the parallel 1-morphisms; then the equipment-theoretic-pointwise
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Lan
                    %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} Lan_f g
            is constant at the domain object, whereas the comma-object-pointwise
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Lan
                    %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} Lan_f g
            does not exist. See
            %a{:href => "#Roald13"} (Koudenburg, Example 2.24)
            for details.
          %h2#existence Existence
          %p
            The following reproduces a
            %a{:href => "https://mathoverflow.net/questions/365947/when-size-matters-in-category-theory-for-the-working-mathematician/365951#365951"} MathOverflow answer
            by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Ivan+Di+Liberti"} Ivan Di Liberti
          %p
          .num_lemma
            %h6 Lemma
            %p
              (Kan). Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                    %mover
                      %mo ←
                      %mi f
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi A
                    %mover
                      %mo →
                      %mi g
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathsf{B} \stackrel{f}{\leftarrow} \mathsf{A} \stackrel{g}{\to} \mathsf{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathsf{A}
              is
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathsf{C}
              is (small)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi lan
                      %mi f
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \mathsf{lan}_f g
              exists.
          %p
            Kan extensions are a useful tool in everyday practice, with applications in many different topics of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathsf{A}
              needs to be small (with respect to
              = succeed "!" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ob
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ob(\mathsf{C})
            There is no chance that the lemma is true when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathsf{A}
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/large+category"} large category
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            can be computed via Kan extensions, the lemma would imply that every (small)
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
            is large cocomplete, which is not allowed because
            = succeed "." do
              %a{:href => "complete+small+category#CompleteSmallCategoriesArePosets"} cocomplete small categories are posets
            = succeed "," do
              %em
                well, let’s just consider
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathsf{C}
                to be large-cocomplete
            = succeed "." do
              %a{:href => "complete+small+category#CompleteSmallCategoriesArePosets"} cocomplete small categories are posets
          %p
            This problem is hard to avoid because the size of the categories of our interest is
            %em as a fact
            always larger than the size of their inhabitants (this just means that most of the time
            %strong Ob
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathsf{C}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
          %p
            Notice that the Kan extension problem
            %strong
              recovers the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              one,
            because adjoints are computed via Kan extensions of identities of large categories. Indeed, in that case, the
            %a.existingWikiWord{:href => "/nlab/show/solution+set+condition"} solution set condition
            is precisely what is needed in order to cut down the size of some colimits that otherwise would be too large to compute, as can be synthesized by the sharp version of the Kan lemma.
          %p
          .num_lemma
            %h6 Lemma
            %p
              %strong Sharp Kan lemma.
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                    %mover
                      %mo ←
                      %mi f
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi A
                    %mover
                      %mo →
                      %mi g
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathsf{B} \stackrel{f}{\leftarrow} \mathsf{A} \stackrel{g}{\to} \mathsf{C}
              be a span where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo −
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{B}(f-,b)
              is a small presheaf for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} b \in \mathsf{B}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathsf{C}
              is (small) cocomplete. Then the left Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi lan
                      %mi f
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \mathsf{lan}_f g
              exists.
          %p
            Indeed this lemma allows
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathsf{A}
            to be large, but we must pay a tribute to its presheaf category:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            needs to be somehow
            %em locally small
            (with respect to
            %strong Ob
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathsf{C}
          %p
          .num_lemma
            %h6 Lemma
            %p
              %strong Kan lemma Fortissimo.
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi A
                    %mover
                      %mo →
                      %mi f
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathsf{A} \stackrel{f}{\to} \mathsf{B}
              be a functor. The following are equivalent:
            %ul
              %li
                for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
