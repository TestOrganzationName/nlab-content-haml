                    %mi C
                    %mo →
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} p \colon C \to C'
              to presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Lan_p F
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
