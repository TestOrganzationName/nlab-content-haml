                    %mo ,
                    %mi KanCplx
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    DL
                    \\;\colon\;
                    [CartSp^{op}, Ch_\bullet(Ab)]
                    \\stackrel{\simeq}{\to}
                    [CartSp^{op}, Ab^{\Delta^{op}}]
                    \\stackrel{forget}{\to}
                    [CartSp^{op}, KanCplx]
                    \\stackrel{}{\to}
                    L_{lhe}
                    [CartSp^{op}, KanCplx]
                    \\simeq
                    Smooth\infty Grpd
            %p
              where the first equivalence is the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              and the last map is the map to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
