                            %mi X
                            %mo )
                          %mo )
                        %mo ∨
                    %annotation{:encoding => "application/x-tex"}
                      i_! \;\colon\;
                      \\left(C_{i^\ast}\left(Q\right)\right)^{\vee}
                      \\to
                      \\left(C_\chi\left(X\right)\right)^\vee
              %p
                and then turn the above cospan into the following consecutive composite in
                %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mo !
                      %mi Th
                      %mrow
                        %mo (
                        %msub
                          %mi Q
                          %mrow
                            %msup
                              %mi i
                              %mo *
                            %mi χ
                        %mo )
                      %mi ξ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℂ
                      %mover
                        %mo →
                        %mi ξ
                      %msub
                        %mi C
                        %mrow
                          %msup
                            %mi i
                            %mo *
                          %mi χ
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mi Th
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mrow
                          %msup
                            %mi i
                            %mo *
                          %mi χ
                      %mo{:stretchy => "false"} (
                      %mi Q
