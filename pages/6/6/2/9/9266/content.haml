                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msup
                      %mi Ab
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi forget
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi KanCplx
                    %mo{:stretchy => "false"} ]
                    %mover
