                        %mn 1
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mi conn
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mi conn
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Omega (\mathbf{B}^n U(1)_{conn}^k) \simeq \mathbf{B}^{n-1} U(1)_{conn}^k
                  \.
          %p (…)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi field
                          %mi space
                        %mtd
                        %mtd
                          %msub
                            %mi τ
                            %mi n
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi delooped
                          %mi phase
                          %mi space
                        %mtd
                        %mtd
                          %msub
                            %mi τ
                            %mi n
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msup
                                %mi conn
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  field space
                  \&amp;&amp;
                  \\tau_n \exp(\mathfrak{a})_{conn}
                  \&amp;\to&amp;
                  \\mathbf{B}^n U(1)_{conn}
                  \\\
                  \&amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  delooped phase space &amp;&amp; \tau_n \exp(\mathfrak{a})
                  \&amp;\to&amp;
                  \\mathbf{B}^n U(1)_{conn^{n-1}}
                  }
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi τ
                            %mi n
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msup
                                %mi conn
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msub
                            %mi C
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C_0 &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\tau_n \exp(\mathfrak{a}) &amp;\to&amp; \mathbf{B}^n U(1)_{conn^{n-1}}
                  \\\
                  \\uparrow &amp;&amp; \uparrow
                  \\\
                  C_1 &amp;\to&amp; *
                  }
          %p
            under
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            this yields the phase space prequantum bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Phase
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 0
                  %mo ,
                  %msub
                    %mi C
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Phase(C_0, C_1) \to \mathbf{B}^{n-1}U(1)_{conn}
                  \\,.
          %p (…)
          %h2#the_setup The setup
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi π
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \pi)
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+mechanical+system"} quantum mechanical system
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{P}, \mathbf{\omega})
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie algebroid
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi ω
                %annotation{:encoding => "application/x-tex"} \mathbf{\omega}
            which is in
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            with the Poisson tensor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid+cohomology"} Lie algebroid cocycle
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cs
                      %mi π
                  %annotation{:encoding => "application/x-tex"} cs_\pi
          %h3#moduli_stack_of_fields Moduli stack of fields
          %p
            By the general construction of
            %a.existingWikiWord{:href => "/schreiber/show/infinity-Chern-Simons+theory"} infinity-Chern-Simons theory
            this means that there is a universal differential characteristic map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %msub
                    %mi ℝ
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{L}
                  \\;\colon\;
                  \\exp(\mathfrak{P})_{conn}
                  \\to
                  \\mathbf{B}^2 \mathbb{R}_{conn}
          %p
            and its truncation (
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"}> Lie integration
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi Γ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{L}
                  \\;\colon\;
                  \\tau_1 \exp(\mathfrak{P})_{conn}
                  \\to
                  \\mathbf{B}^2 (\mathbb{R}/\Gamma)_{conn}
                  \\,.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{P})_{conn}
            is the
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of fields of the 2d Poisson-Chern-Simons theory and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is the
            %a.existingWikiWord{:href => "/nlab/show/extended+Lagrangian"} extended Lagrangian
            of a
            %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            (
            %a.existingWikiWord{:href => "/schreiber/show/Higher+Chern-Weil+Derivation+of+AKSZ+Sigma-Models"}> FRS
            ). Infinitesimally this yields the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
          %p
            We discuss here the
            %a.existingWikiWord{:href => "/nlab/show/higher+geometric+quantization"} higher geometric quantization
            of this
            %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theory
            defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
          %h3#ThePhaseSpaceStack The Phase space stack
          %p There is the canonical universal forgetful map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\tau_1 \exp(\mathfrak{P})_{conn}
                  \\to
                  \\tau_1 \exp(\mathfrak{P})
          %p
            which forgets the conection data of fields and only retains their “
            %a.existingWikiWord{:href => "/nlab/show/instanton+sector"}> instanton sector
            ”. The
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{P})
            is the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            which is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓
                  %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔓
                %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            is integrable in the traditional sense of Lie groupoid theory.)
          %p
            Notice that this is equivalently
            %a.existingWikiWord{:href => "/nlab/show/differential+concretification"} differential concretification
            over the point:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{P})
            may be understood as the
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓
                  %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid+valued+differential+forms"} valued
            forms on the point.
          %p
            But moreover, we may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{P})
            as being the
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of the
            %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
            2d Poisson-Chern-Simons
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            for the space-filling
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            boundary condition: in this interpretation the
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{P})
            are the endpoints of open strings, the
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are solutions to the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange equations
            of motion along an interval (an initial spatial slice of string) and
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            is string concatenation.
          %p
            This is the point of view suggested in (
            %a{:href => "symplectic%20groupoid#CattaneoFelder01"}> Cattaneo-Felder 01
            ), there argued for by the observation that the space of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{P})
            is naturally the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+reduction"} symplectic reduction
            of (in our language) of that of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{P})
            for the
            %a.existingWikiWord{:href => "/nlab/show/moment+map"} moment map
            that characterizes the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            and
            %a.existingWikiWord{:href => "/nlab/show/gauge+symmetries"} gauge symmetries
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
          %h3#DBranes D-branes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℭ
                    %mn 0
                  %mo ,
                  %msub
                    %mi ℭ
                    %mn 1
                  %mo ↪
                  %mi 𝔓
                %annotation{:encoding => "application/x-tex"} \mathfrak{C}_0, \mathfrak{C}_1 \hookrightarrow \mathfrak{P}
            be two
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+dg-submanifold"} Lagrangian
            sub-
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
            of the given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            %a.existingWikiWord{:href => "/nlab/show/coisotropic+submanifolds"} coisotropic submanifolds
            of the underlying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
          %p
            Accoring to (
            %a{:href => "coisotropic+submanifold#CattaneoFelder03"}> Cattaneo-Felder 03
            ) we are two think of these as being two
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            inclusions for the
            %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
            Poisson-Chern-Simons model.
          %p
            Their
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            induces two Lagrangian sub-groupoids of the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi tau
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℭ
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℭ
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  tau_1 \exp(\mathfrak{C}_0)
                  \\to
                  \\tau_1 \exp(\mathfrak{P})
                  \\leftarrow
                  \\tau_1 \exp(\mathfrak{C}_1)
                  \\,.
          %p
            This means that the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            %a.existingWikiWord{:href => "/nlab/show/open+strings"} open strings
            with endpoints restricted to these two
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi ℭ
                                %mn 0
                              %mo ,
                              %msub
                                %mi ℭ
                                %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %msub
                            %mi τ
                            %mn 1
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ℭ
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi τ
                            %mn 1
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ℭ
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi τ
                            %mn 1
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔓
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; \mathbf{Fields}_{\mathfrak{C}_0, \mathfrak{C}_1}
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\tau_1 \exp(\mathfrak{C}_0) &amp;&amp; &amp;&amp; \tau_1 \exp(\mathfrak{C}_1)
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; \tau_1 \exp(\mathfrak{P})
                  }
                  \\,.
          %p
            One finds that this
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+reduction"} symplectic reduction
            considered in (
            %a{:href => "coisotropic+submanifold#CattaneoFelder03"}> Cattaneo-Felder 03, page 6, 7
            ).
          %p
            That for space-filling branes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℭ
                    %mn 0
                  %mo ,
                  %msub
                    %mi ℭ
                    %mn 1
                  %mo ≔
                  %mi 𝔓
                %annotation{:encoding => "application/x-tex"} \mathfrak{C}_0, \mathfrak{C}_1 \coloneqq \mathfrak{P}
            one recovers the original moduli stack
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mrow
                      %mi 𝔓
                      %mo ,
                      %mi 𝔓
                  %mo ≃
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}_{\mathfrak{P}, \mathfrak{P}}
                  \\simeq
                  \\tau_1 \exp(\mathfrak{P})
          %p is just the statement that the homotopy pullback of an equivalence is an equivalence.
          %h2#constructions Constructions
          %h3#moduli_of_2d_cs_fields_and_symplectic_groupoids Moduli of 2d CS fields and symplectic groupoids
          %p
            We discuss how the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of the
            %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            obtained by
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔓
                %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            be the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            corresponding to a
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            that comes from a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            associated to this is (by the discussion there) supposed to be the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(X)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped on its space of morphisms with the differential form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                    %mi ω
                    %mo −
                    %msubsup
                      %mi p
                      %mn 2
                      %mo *
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} p_1^* \omega - p_2^* \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %msub
                    %mi p
                    %mn 2
                %annotation{:encoding => "application/x-tex"} p_1,p_2
            are the two endpoint projections from paths in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            We demonstrate in the following how this is indeed the result of applying the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            to this situation.
          %p
            For simplicity we shall start with the simple situation where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            has a global
            %a.existingWikiWord{:href => "/nlab/show/Darboux+coordinate+chart"} Darboux coordinate chart
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x^i\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\omega_{i j}\}
            for the components of the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            in these coordinates, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\omega^{i j}\}
            for the components of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
          %p
            Then the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{P})
            is generated from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi x
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x^i\}
            in degree 0 and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mo ∂
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\partial_i\}
            in degree 1, with differential given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %msup
                    %mi x
                    %mi i
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mo ∂
                    %mi j
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} x^i = - \omega^{i j} \partial_j
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %msub
                    %mo ∂
                    %mi i
                  %mo =
                  %mfrac
                    %mrow
                      %mo ∂
                      %msup
                        %mi π
                        %mrow
                          %mi j
                          %mi k
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %msub
                    %mo ∂
                    %mi j
                  %mo ∧
                  %msub
                    %mo ∂
                    %mi k
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} \partial_i = \frac{\partial \pi^{j k}}{\partial x^i} \partial_j \wedge \partial_k = 0
                  \\,.
          %p
            The differential in the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            is hence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %msup
                    %mi x
                    %mi i
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mo ∂
                    %mi j
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"}
                  d_{W} x^i = - \omega^{i j} \partial_j + \mathbf{d}x^i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %msub
                    %mo ∂
                    %mi i
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msub
                    %mo ∂
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{W} \partial_i = \mathbf{d} \partial_i
                  \\,.
          %p
            By the discussion at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi ω
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi i
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msub
                    %mo ∂
                    %mi i
                  %mo ∈
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\omega} = \mathbf{d} x^i \wedge \mathbf{d} \partial_i \in W(\mathfrak{P})
                  \\,.
          %p Clearly it is useful to introduce a new basis of generators with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∂
                    %mi i
                  %mo :
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mo ∂
                    %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\partial^i := -\omega^{i j} \partial_j
                  \\,.
          %p In this new basis we have a manifest isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔗
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{P}) = CE(\mathfrak{T}X)
          %p
            with the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Therefore the
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔓
                %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            is the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi X
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tau_1 \exp(\mathfrak{P}) = \Pi_1(X) = (X \times X \stackrel{\overset{p_2}{\to}}{\underset{p_1}{\to}} X)
                  \\,.
          %p
            It remains to show that the symplectic form on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔓
                %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            makes this a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
          %p Notice that in the new basis the invariant polynomial reads
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi ω
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi ω
                            %mrow
                              %mi i
                              %mi j
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mi i
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mo ∂
                            %mi j
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ω
                            %mrow
                              %mi i
                              %mi j
                          %msup
                            %mo ∂
                            %mi i
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mi j
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathbf{\omega}
                  \&amp;=
                  \- \omega_{i j} \mathbf{d}x^i \wedge \mathbf{d} \partial^j
                  \\\
                  \&amp; = \mathbf{d}( \omega_{i j} \partial^i \wedge \mathbf{d}x^j)
                  \\end{aligned}
          %p
            and that we may regard this as a morphism of
            = succeed "-algebroids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi ω
                  %mo :
                  %mi 𝔗
                  %mi 𝔓
                  %mo →
                  %mi 𝔗
                  %msup
                    %mi b
                    %mn 3
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\omega}
                  \:
                  \\mathfrak{T}\mathfrak{P} \to \mathfrak{T}b^3 \mathbb{R}
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/infinity-Chern-Weil+theory"} infinity-Chern-Weil homomorphism
            that we need to compute is given by the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔓
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi diff
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mstyle{:mathvariant => "bold"}
                                %mi ω
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mi ℝ
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi dR
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi Δ
                                    %mo •
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi ℝ
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔓
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\exp(\mathfrak{P})_{diff}
                  \&amp;\stackrel{\exp(\mathbf{\omega})}{\to}&amp;
                  \\exp(b \mathbb{R})_{dR}
                  \&amp;\stackrel{\int_{\Delta^\bullet}}{\to}&amp;
                  \\mathbf{\flat}_{dR}\mathbf{B}^3 \mathbb{R}
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  \\exp(\mathfrak{P})
                  }
                  \\,.
          %p
            Over a test space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in degree 1 an element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi diff
                %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{P})_{diff}
            is a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi i
                  %mo ,
                  %msup
                    %mi η
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X^i, \eta^i)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi i
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %msup
                    %mi Δ
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X^i \in C^\infty(U \times \Delta^1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi η
                    %mi i
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi vert
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %msup
                    %mi Δ
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\eta^i \in \Omega^1_{vert}(U \times \Delta^1)
          %p
            subject to the verticality constraint, which says that along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Delta^1
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %msup
                    %mi X
                    %mi i
                  %mo +
                  %msubsup
                    %mi η
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                    %mi i
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{\Delta^1} X^i + \eta^i_{\Delta^1} = 0
                  \\,.
          %p
            The vertical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi diff
                  %mo →
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{P})_{diff} \to \exp(\mathfrak{P})
            has in fact a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            whose image is given by those pairs for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi η
                    %mi i
                %annotation{:encoding => "application/x-tex"} \eta^i
            has no leg along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{P})
            by evaluating the top morphism on pairs of this form.
          %p Such a pair is taken by the top morphism to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi X
                            %mi i
                          %mo ,
                          %msup
                            %mi η
                            %mi j
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↦
                          %msub
                            %mo ∫
                            %mrow
                              %msup
                                %mi Δ
                                %mn 1
                          %msub
                            %mi ω
                            %mrow
                              %mi i
                              %mi j
                          %msub
                            %mi F
                            %mrow
                              %msup
                                %mi X
                                %mi i
                          %mo ∧
                          %msub
                            %mi F
                            %mrow
                              %msup
                                %mo ∂
                                %mi j
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mo ∫
                            %mrow
                              %msup
                                %mi Δ
                                %mn 1
                          %msub
                            %mi ω
                            %mrow
                              %mi i
                              %mi j
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi dR
                          %msup
                            %mi X
                            %mi i
                          %mo +
                          %msup
                            %mi η
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msub
                            %mi d
                            %mi dR
                          %msup
                            %mi η
                            %mi j
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  (X^i, \eta^j)
                  \&amp; \mapsto
                  \\int_{\Delta^1}
                  \\omega_{i j} F_{X^i} \wedge F_{\partial^j}
                  \\\
                  \&amp; =
                  \\int_{\Delta^1}
                  \\omega_{i j} (d_{dR} X^i + \eta^i) \wedge d_{dR} \eta^j
                  \\in
                  \\Omega^3(U)
                  \\end{aligned}
                  \\,.
          %p
            Using the above verticality constraint and the condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi η
                    %mi i
                %annotation{:encoding => "application/x-tex"} \eta^i
            has no leg along
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %msub
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mi d
                    %mi U
                  %msup
                    %mi X
                    %mi i
                  %mo ∧
                  %msub
                    %mi d
                    %mi U
                  %msub
                    %mi d
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %msup
                    %mi X
                    %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots =
                  \\int_{\Delta^1}
                  \\omega_{i j}
                  d_U X^i
                  \\wedge
                  d_U d_{\Delta^1} X^j
                  \\,.
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes theorem
            the integration over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Delta^1
            yields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo =
                  %msub
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mi d
                    %mi dR
                  %msup
                    %mi x
                    %mi i
                  %mo ∧
                  %msup
                    %mi η
                    %mi j
                  %msub
                    %mo{:stretchy => "false"} |
                    %mn 0
                  %mo −
                  %msub
                    %mi ω
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mi d
                    %mi dR
                  %msup
                    %mi x
                    %mi i
                  %mo ∧
                  %msup
                    %mi η
                    %mi j
                  %msub
                    %mo{:stretchy => "false"} |
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \=
                  \\omega_{i j} d_{dR} x^i \wedge \eta^j|_{0}
                  \-
                  \\omega_{i j} d_{dR} x^i \wedge \eta^j|_{1}
                  \\,.
          %p This completes the proof.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi τ
                            %mn 1
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi 𝔓
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi ω
                        %mtd
                          %msub
                            %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\tau_1 \exp(\mathfrak{P})
                  \&amp;\stackrel{\omega}{\to}&amp;
                  \\flat_{dR} \mathbf{B}^3 U(1)
                  }
                  \\,.
          %h3#prequantum_2states Prequantum 2-states
          %p
            Generally, given a
            %a.existingWikiWord{:href => "/nlab/show/prequantum+line+2-bundle"} prequantum line 2-bundle
            the corresponding (local)
            %a.existingWikiWord{:href => "/nlab/show/prequantum+n-states"} prequantum n-states
            are the (local)
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of this
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/line+2-bundle"} line 2-bundle
            %a.existingWikiWord{:href => "/nlab/show/twisted+unitary+bundles"} twisted unitary bundles
            (maybe best known for the
            %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
            where these are the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+fields"} Chan-Paton gauge fields
            %a.existingWikiWord{:href => "/nlab/show/2-vector+space"} 2-vector space
            of prequantum 2-states. This is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
            over some
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
          %p
            A canonical way of constructing this algebra is as follows: present the
            %a.existingWikiWord{:href => "/nlab/show/line+2-bundle"} line 2-bundle
            as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            over the morphisms of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %a.existingWikiWord{:href => "/nlab/show/groupoid+algebra"} groupoid algebra
            (see there for details) of sections of this line bundle. A module over this is manifestly a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe+module"} bundle gerbe module
          %p More in detail:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{X}
            be a smooth groupoid and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi X
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{X} \to \mathbf{B}^2 U(1)
            the map modulating a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+2-group"} circle 2-group
            %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} P \to \mathbf{X}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi n
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\coprod_n \mathbf{B}U(n))//\mathbf{B}U(1) \to \mathbf{B}^2 U(1)
            the canonical
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-action"} 2-representation
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated 2-bundle
            are unitary
            %a.existingWikiWord{:href => "/nlab/show/twisted+bundles"} twisted bundles
            equivariant on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
          %p
            If we present the 2-bundle by a
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            exhibited as a multiplicative
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            over the space of morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}_1
            %a.existingWikiWord{:href => "/nlab/show/groupoid+algebra"} convolution algabra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            of sections of this line bundle. Twisted unitary vector bundles are equivalently projective
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over this algebra.
          %p This means that under the identification
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Alg
                    %mi k
                  %mover
                    %mo →
                    %mo ≃
                  %mn 2
                  %msub
                    %mi Vect
                    %mi k
                %annotation{:encoding => "application/x-tex"}
                  \\phi \colon Alg_k \stackrel{\simeq}{\to} 2 Vect_k
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of
            %a.existingWikiWord{:href => "/nlab/show/2-vector+spaces"} 2-vector spaces
            with that of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
            %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            and intertwiners (see at
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-vector+space"} n-vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %em is
            the 2-vector space of sections
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mrow
                    %mo (
                    %mi 𝒜
                    %mo )
                  %mo ≃
                  %msub
                    %mi Γ
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %mrow
                    %mo (
                    %mi P
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mrow
                          %mo (
                          %mn 1
                          %mo )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi n
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mrow
                      %mo (
                      %mi n
                      %mo )
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi\left(\mathcal{A}\right)
                  \\simeq
                  \\Gamma_{\mathbf{X}}\left(P \times_{\mathbf{B}U\left(1\right)} \coprod_n \mathbf{B}U\left(n\right) \right)
                  \\,.
          %h3#polarizations_and_branes Polarizations and branes
          %p
            The full generalization of the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
            from traditional
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            to
            %a.existingWikiWord{:href => "/nlab/show/higher+geometric+quantization"} higher geometric quantization
            may need more thinking, but in the case of 2d Chern-Simons theory we can apply the following plausible shortcut.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{P}, \mathbf{\omega})
            is a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
            %a.existingWikiWord{:href => "/nlab/show/dg-manifold"} dg-manifold
            (the dg-manifold whose
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            of functions is the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔓
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (CE(\mathfrak{P})
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi ω
                %annotation{:encoding => "application/x-tex"} \mathbf{\omega}
            constitutes a graded
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓
                  %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            %a.existingWikiWord{:href => "/nlab/show/real+polarization"} real polarization
            of an ordinary
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/foliation"} foliation
            by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifolds"} Lagrangian submanifolds
            %a.existingWikiWord{:href => "/nlab/show/real+polarization"} real polarization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{P}, \mathbf{\omega})
            to consist of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+dg-submanifolds"} Lagrangian dg-submanifolds
            %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
            these corespond to the
            %a.existingWikiWord{:href => "/nlab/show/coisotropic+submanifolds"} coisotropic submanifolds
            of the underlying
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \pi)
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization+of+symplectic+groupoids"} geometric quantization of symplectic groupoids
            (see there).
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            of the
            %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            should be those leaves of the foliation which satisfy an extra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/BS-leaf"} intrability condition
          %p
            Indeed, according to
            %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            of the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
            are supposed to be coisotropic submanifolds, see at
            = succeed "." do
              %a{:href => "Poisson+sigma-model#Branes"} Poisson sigma-model – Properties – Branes
          %h3#quantum_2states Quantum 2-states
          %p
            Summing up, the convolution subalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mi q
                  %mo ↪
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_q \hookrightarrow \mathcal{A}
            of polarized sections is under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            the actual 2-vector space of states.
          %p
            In
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization+of+symplectic+groupoids"} geometric quantization of symplectic groupoids
            it is show that this is the algebra of observables of the
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanical+system"} quantum mechanical system
            of the underlying
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            (its
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/strict+deformation+quantization"} strict deformation quantization
          %p
            In fact we have to quantize the whole
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            of the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mi τ
                    %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔓
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \to \tau_1 \exp(\mathfrak{P})
                  \\,.
          %p
            By the discussion at
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
            this yields a
            %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
          %h4#symplectic_case Symplectic case
          %p
            Consider the simple case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            is a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            and in fact a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
          %p
            Here the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            is the
            %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} Pair(X)_\bullet
            carrying the trivial twist. The
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            is the object inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \to Pair(X)
                  ,.
          %p
            Notice that this is equivalent (
            %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"}> Morita equivalent
            ) to just the terminal map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \to *
                  \\,.
          %p
            Accordingly, the
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pair
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} Pair(X)_\bullet
            is the
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} C-star-algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}(X)
            %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
            %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            from there to the ground field is (…)
          %p
            The
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid-principal+bundle"} groupoid-principal
            %a.existingWikiWord{:href => "/nlab/show/bibundle"} bibundle
            corresponding to this atlas regarded as a
            %a.existingWikiWord{:href => "/nlab/show/Morita+morphism"} Morita morphism
            is just the
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times X \stackrel{p_1}{\to} X
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
          %p
            In conclusion, up to equivalence the bimodule is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^2(X)
            regarded as a
            = succeed "-bimodule." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} C(X)-\mathbb{C}
          %p (…)
          %h2#References References
          %p The above discussion was inspired by
          %ul
            %li#Hawkins08
              %a.existingWikiWord{:href => "/nlab/show/Eli+Hawkins"}> Eli Hawkins
              ,
              = succeed "," do
                %em A Groupoid Approach to Quantization
              %strong 6
              1 (2008) 61-125 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0612363"}> arXiv:math/0612363
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://projecteuclid.org/journals/journal-of-symplectic-geometry/volume-6/issue-1/A-groupoid-approach-to-quantization/jsg/1215032733.full"} euclid
          %p and details have been written out in these two theses:
          %ul
            %li#Bongers
              %p
                Stefan Bongers,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/master+thesis+Bongers"} Geometric quantization of symplectic and Poisson manifolds
            %li#Nuiten13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joost+Nuiten"}> Joost Nuiten
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/master+thesis+Nuiten"} Cohomological quantization of local prequantum boundary field theory
          %p
            Here section 4 of
            %a{:href => "#Bongers"} Bongers (2013)
            recalls and makes explicit relevant details in the construction of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
            %a{:href => "#Nuiten13"} Nuiten (2013)
            essentially provides a re-casting of the quantization construction in
            %a{:href => "#Hawkins08"} Hawkins (2008)
            which gives it an invariant home and brings out the above holographic picture more explicitly.
          %p This reveals a general abstract nature of the construction which was meant to be further brought out in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Quantization+via+Linear+homotopy+types"} Quantization via Linear homotopy types
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1402.7041"}> arXiv:1402.7041
              \&amp;rbrack;
          %p
            where the above situation corresponds to “running example a)”, Example 7.3 (
            %a{:href => "https://arxiv.org/pdf/1402.7041.pdf#page=70"}> p. 70
            ).
