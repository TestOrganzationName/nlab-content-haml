                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \Omega (\mathbf{B} U(1)_{conn}) \simeq \flat \mathbf{B}^{n-1}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
