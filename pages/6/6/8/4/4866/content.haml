                      %mo ∈
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v \in \Gamma(T C)
                that is annihilated by (the symmetrization of) the
                %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                of the corresponding
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
          %p
            Similarly a
            %em Killing spinor
            is a covariantly constant
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \in \Gamma(T X)
            is called a
            %strong Killing vector field
            if it generates
            %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
            of the
            %a.existingWikiWord{:href => "/nlab/show/metric"} metric
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                vanishes:
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mi v
                        %mi g
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}_v g = 0
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/flow"} flow
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi X
                      %mo ×
                      %mi ℝ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \exp(v)  : X \times \mathbb{R} \to X
                is a flow by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
          %h2#properties Properties
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/flows"} flows
            of Killing vectors are
            %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
            of the Riemannian manifold onto itself.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Killing+tensor"} Killing tensor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Killing+spinor"} Killing spinor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Killing-Yano+tensor"} Killing-Yano tensor
