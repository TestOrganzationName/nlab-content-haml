                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \infty Grpd
          .un_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              are locally
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/petit+topos"} petit
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-toposes"} over-(∞,1)-toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
              are locally
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %p
              The two notions of fundamental
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              induced this way do agree, in that there is a natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_X(X \in \mathbf{H}/X) \simeq \Pi(X \in \mathbf{H})
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              By the general facts recalled at
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+geometric+morphism"} étale geometric morphism
              we have a composite
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mi X
                    %mo ⊣
                    %msub
                      %mi Δ
                      %mi X
                    %mo ⊣
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                              %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi X
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi X
                            %mo !
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mi Γ
                        %mover
                          %mo ←
                          %mi Δ
                      %mover
                        %mo →
                        %mi Π
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi_X \dashv \Delta_X \dashv \Gamma_X) :
                    \\mathbf{H}_{/X}
                    \\stackrel{\overset{X_!}{\to}}{\stackrel{\overset{X^*}{\leftarrow}}{\underset{\X_*}{\to}}}
                    \\mathbf{H}
                    \\stackrel{\overset{\Pi}{\to}}{\stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\to}}}
                    \\infty Grpd
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo !
                  %annotation{:encoding => "application/x-tex"} X_!
              is given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
