                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{\flat} \mathbf{B}^n A &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{B}^n A
                    \&amp;\stackrel{curv}{\to}&amp;
                    \\mathbf{\flat}_{dR} \mathbf{B}^{n+1} A
