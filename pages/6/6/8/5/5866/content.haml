                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher holonomy
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons functionals
          .un_prop
            %h6#definition_19 Definition
            %p
              We say an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Sigma \in \mathbf{H}
              has
              %strong
                %a.existingWikiWord{:href => "/nlab/show/cohomological+dimension"} cohomological dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \leq n \in \mathbb{N}
              if for all
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              coefficient objects and
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n++1)
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
              objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^{n+1}A
              the corresponding cohomology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is trivial
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi Σ
