                            %mi X
                            %mo ,
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}(X,\mathbf{\flat}\mathbf{B}^n A) &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{H}(X, \mathbf{B}^n A)
                    \&amp;\stackrel{curv_*}{\to}&amp;
                    \\mathbf{H}(X, \mathbf{\flat}_{dR}\mathbf{B}^{n+1} A)
