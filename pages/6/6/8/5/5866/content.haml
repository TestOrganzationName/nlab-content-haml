                          %mtd
                          %mtd
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; *
                    \\\
                    \&amp; {}^{\mathllap{Id}}\nearrow &amp; \downarrow^{\mathrlap{\Pi(i)}}
