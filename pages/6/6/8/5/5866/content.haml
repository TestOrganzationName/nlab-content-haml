                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Pi(X)
                    \\\
                    \\downarrow^{\mathrlap{(Id,\Pi(i))}} &amp; \searrow^{\mathrlap{\Pi(f)}}
                    \\\
                    \\Pi(X) \times \Pi(I) &amp;\stackrel{\Pi(\eta)}{\to}&amp; \Pi(Y)
                    \\\
                    \\uparrow^{\mathrlap{(Id,\Pi(o))}} &amp; \nearrow_{\mathrlap{\Pi(g)}}
                    \\\
