                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    H_{dR}^n(X,A)/H^{n-1}(X,A)
                    \\to
                    H_{diff}^n(X,A)
                    \\to
                    H^n(X,A)
                    \\to
                    0
                    \\,.
          .proof
            %h6#proof_21 Proof
            %p
              This is a general statement about the definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              we have a
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi dR
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X, \mathbf{B}^{n-1}A)
                    \\to
                    \\mathbf{H}_{dR}(X, \mathbf{B}^n A)
                    \\to
                    \\mathbf{H}_{diff}(X, \mathbf{B}^n A)
                    \\to
                    \\mathbf{H}(X, \mathbf{B}^n A)
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              using that by construction the last morphism is surjective on connected components (because in the defining
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi diff
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{diff}
              the right vertical morphism is by assumption surjective on connected components).
            %p
              To see that we do have the fiber sequence as claimed consider the pasting composite of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi dR
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi diff
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
