                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi F
                        %mi i
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [F_i]
          .un_def
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
