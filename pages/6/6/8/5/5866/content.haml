                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-)
              preserves the defining
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mi dR
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbf{\flat}_{dR} A
          %p
            Just for emphasis, notice the dual description of this situation: by the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
            that defines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi dR
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{dR} X
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            corresponds to a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Π
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi ω
                        %mtd
                          %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                  \\\
                  \\mathbf{\Pi}(X) &amp;\stackrel{\omega}{\to}&amp; A
                  }
                  \\,.
          %p
            The bottom horizontal morphism is a flat connection on the
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ω
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{\Pi}(X) \stackrel{\omega}{\to} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X \to * \to A
          #deRhamWithDiscCoeffsIsTrivial.un_prop
            %h6#proposition_11 Proposition
            %p
              The de Rham cohomology with coefficients in discrete objects is trivial: for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} S \in \infty Grpd
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mi Disc
                    %mi S
                    %mo ≃
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat}_{dR} Disc S \simeq *
                    \\,.
          .proof
            %h6#proof_13 Proof
            %p
              Using that in a
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              so that the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo →
                    %mi Γ
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Id \to \Gamma Disc
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              and using that by the
              %a.existingWikiWord{:href => "/nlab/show/zig-zag+identity"} zig-zag identity
              we have then that the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
              component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi Disc
                    %mi S
                    %mo :
                    %mo =
                    %mi Disc
                    %mi Γ
                    %mi Disc
                    %mi S
                    %mo →
                    %mi Disc
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat} Disc S := Disc \Gamma Disc S \to Disc S
              is also an equivalence, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi Disc
                            %mi S
                          %mtd
                            %mrow
                              %mo :
                              %mo =
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi Disc
                                %mi S
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi Disc
                            %mi S
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi Disc
                                %mi S
                            %mi Disc
                            %mi S
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{\flat}_{dR} Disc S
                    \&amp; {:=}
                    * \prod_{Disc S} \mathbf{\flat} Disc S
                    \\\
                    \&amp; \simeq * \prod_{Disc S} Disc S
                    \\\
                    \&amp; \simeq *
                    \\end{aligned}
                    \\,,
            %p since the pullback of an equivalence is an equivalence.
          .un_prop
            %h6#proposition_12 Proposition
            %p
              In a cohesive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %em
                %a{:href => "#PiecesHavePoints"} pieces have points
              precisely if for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{dR} X
              is
              %em
                globally
                %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              in that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi dR
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \pi_0 \mathbf{H}(*, \mathbf{\Pi}_{dR}X) = *
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has at least one point (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \pi_0(\Gamma X) \neq \emptyset
              ) and is geometrically connected (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \pi_0 (\Pi X) = {*}
              ) then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi{:mathvariant => "normal"} dR
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{\mathrm{dR}}(X)
              is also locally connected:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mn 0
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi{:mathvariant => "normal"} dR
                      %mi X
                      %mo ≃
                      %mo *
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \tau_0 \mathbf{\Pi}_{\mathrm{dR}}X \simeq {*} \in \mathbf{H}
          .proof
            %h6#proof_14 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi Γ
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi Γ
                                %mi X
                            %mi Γ
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi Γ
                                %mi X
                            %mi Π
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}(*, \mathbf{\Pi}_{dR}X)
                    \&amp; \simeq
                    \\Gamma \mathbf{\Pi}_{dR} X
                    \\\
                    \&amp; \simeq
                    * \coprod_{\Gamma X} \Gamma \mathbf{\Pi}X
                    \\\
                    \&amp; \simeq
                    * \coprod_{\Gamma X} \Pi X
                    \\end{aligned}
                    \\,,
            %p
              where in the last step we used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi X
                      %mo :
                      %mo =
                      %mi Γ
                      %mi Disc
                      %mi Π
                      %mi X
                      %mo ≃
                      %mi Π
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Gamma \mathbf{\Pi}X := \Gamma Disc \Pi X \simeq \Pi X
            %p
              To analyse this
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)pushout
              we present it by a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              in the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} sSet
                        %mi{:mathvariant => "normal"} Quillen
                    %annotation{:encoding => "application/x-tex"} \mathrm{sSet}_{\mathrm{Quillen}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Pi X
              any representatives in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} sSet
                      %mi{:mathvariant => "normal"} Quillen
                  %annotation{:encoding => "application/x-tex"} \mathrm{sSet}_{\mathrm{Quillen}}
              of the objects of the same name in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi{:mathvariant => "normal"} Grpd
                    %annotation{:encoding => "application/x-tex"} \infty \mathrm{Grpd}
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Γ
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi Γ
                                %mi X
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Π
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma X  &amp;\to&amp; (\Gamma X) \times \Delta[1] \coprod_{\Gamma X} {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Pi X &amp;\to &amp; Q
                    }
                    \\,,
            %p
              where on the right we have inserted the
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma X
              in order to turn the top morphism into a cofibration. From this ordinary pushout it is clear that the connected components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              are obtained from those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Pi X
              by identifying all those in the image of a connected component of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Gamma X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \pi_0(Q) = *
              %a{:href => "#PiecesHavePoints"} pieces have points
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %p
              For the local analysis we consider the same setup objectwise in the injective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi{:mathvariant => "normal"} op
                      %mo ,
                      %mi{:mathvariant => "normal"} sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi{:mathvariant => "normal"} inj
                          %mo ,
                          %mi{:mathvariant => "normal"} loc
                    %annotation{:encoding => "application/x-tex"} [C^{\mathrm{op}}, \mathrm{sSet}]_{\mathrm{inj},\mathrm{loc}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              we then have the pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi U
                  %annotation{:encoding => "application/x-tex"} Q_U
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi X
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} sSet
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Π
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Q
                              %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X(U) &amp;\to &amp; (X(U)) \times \Delta[1] \coprod_{X(U)} {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathrm{sSet}(\Gamma(U), \Pi X) &amp; \to &amp; Q_U
                    }
                    \\,,
            %p
              as a model for the value of the simplicial presheaf presenting
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi{:mathvariant => "normal"} dR
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{\mathrm{dR}}(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is geometrically connected then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi{:mathvariant => "normal"} sSet
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \pi_0 \mathrm{sSet}(\Gamma(U), \Pi(X)) = *
              and hence for the left morphism to be surjective on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
              it suffices that the top left object is not empty. Since the simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(U)
              contains at least the vertices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to * \to X
              of which there is by assumption at least one, this is the case.
          .un_remark
            %h6#remark_4 Remark
            %p
              In summary this means that in a cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{dR} X
              have the abstract properties of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+schematic+homotopy+type"} pointed geometric de Rham homotopy types
            %p
              In the
              %a{:href => "#Examples"} Examples
              we will see that, indeed, the intrinsic de Rham cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi dR
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo :
                      %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{dR}(X, A) {:=} \pi_0 \mathbf{H}(\mathbf{\Pi}_{dR} X, A)
              reproduces ordinary de Rham cohomology in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo &gt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} d\gt 1
            %p
              In degree 0 the intrinsic de Rham cohomology is necessrily trivial, while in degree 1 we find that it reproduces closed 1-forms, not divided out by exact forms. This difference to ordinary de Rham cohomology in the lowest two degrees may be interpreted in terms of the obstruction-theoretic meaning of de Rham cohomology by which we essentially characterized it above: we have that the intrinsic
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi dR
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{dR}^n(X,K)
              is the home for the obstructions to flatness of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo −
                          %mn 2
                      %mi K
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^{n-2}K
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              this are groupoid-principal bundles over the
              %em groupoid
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              as its space of objects. But the 1-form curvatures of groupoid bundles are not to be regarded modulo exact forms. More details on this are at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
          %h3#LieAlgebras
            Exponentiated
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          #ExponentiatedLieAsGeometricallyContractible.un_def
            %h6#definition_12 Definition
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\exp(\mathfrak{g})
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              that is
              %em geometrically contractible
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi (\mathbf{B}\exp(\mathfrak{g})) \simeq *
            %p
              we call its
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Ω
                      %mo *
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g}) := \Omega_* \mathbf{B}\exp(\mathfrak{g})
              the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
                of an
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .un_def
            %h6#definition_13 Definition
            %p Set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mi Lie
                    %mo :
                    %mo =
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mo ∘
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo :
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp Lie
                    \:=
                    \\mathbf{\Pi}_{dR} \circ \mathbf{\flat}_{dR}
                    \: */\mathbf{H} \to */\mathbf{H}
                    \\,.
          #LieAsALeftAdjoint.un_prop
            %h6#observation_7 Observation
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is cohesive, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
