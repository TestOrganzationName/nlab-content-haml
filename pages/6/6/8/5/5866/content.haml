                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{\flat}A
                    \\\
                    \&amp; {}^{\nabla}\nearrow&amp; \downarrow
                    \\\
                    X &amp;\stackrel{g}{\to}&amp; A
                    }
                    \\,.
          %p
            We call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ♭
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{\flat}A
            the
            = succeed "." do
              %strong
                coefficient object for flat
                = succeed "-connections" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
          .un_prop
            %h6#proposition_9 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mo =
                    %mi Disc
                    %msub
                      %mi G
                      %mn 0
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} G := Disc G_0 \in \mathbf{H}
              a
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-group
              the canonical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi flat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{flat}(X,\mathbf{B}G) \to \mathbf{H}(X,\mathbf{B}G)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
          .proof
            %h6#proof_9 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              we have that the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo →
                    %mi Γ
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Id \to \Gamma Disc
              is a natural equivalence. It follows that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Disc G_0
              also the counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi Γ
                    %mi Disc
                    %msub
                      %mi G
                      %mn 0
                    %mo →
                    %mi Disc
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Disc \Gamma Disc G_0 \to Disc G_0
              is a weak equivalence (since by the
              %a.existingWikiWord{:href => "/nlab/show/triangle+identity"} triangle identity
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %msub
                      %mi G
                      %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %mi Disc
                    %mi Γ
                    %mi Disc
                    %msub
                      %mi G
                      %mn 0
                    %mo →
                    %mi Disc
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Disc G_0 \stackrel{\simeq}{\to} Disc \Gamma Disc G_0 \to Disc G_0
              is the identity).
          .un_remark
            %h6#remark_3 Remark
            %p
              This says that for discrete structure
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              there is an essentially unique flat
              = succeed "-connection" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi flat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(\mathbf{\Pi}(X), \mathbf{B}G)
                    \\simeq
                    \\mathbf{H}_{flat}(X, \mathbf{B}G)
                    \\simeq
                    \\mathbf{H}(X, \mathbf{B}G)
            %p
              may be read as saying that the
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              of this unique
              = succeed "-connection." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %h3#deRhamCohomology de Rham cohomology
          %p
            In every
            %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            there is an intrinsic notion of
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
          .un_def
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              an object, write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mi X
                    %mo :
                    %mo =
                    %mo *
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi X
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{dR}X := * \coprod_X \mathbf{\Pi} X
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}(X) &amp;\to&amp; \mathbf{\Pi}_{dR}X
                    }
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} * \to A
              any
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mi A
                    %mo :
                    %mo *
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi A
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat}_{dR} A : * \prod_A \mathbf{\flat}A
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{\flat}_{dR} A &amp;\to&amp; \mathbf{\flat} A
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    * &amp;\to&amp; A
                    }
                    \\,.
          #DeRhamAdjunction.un_prop
            %h6#proposition_10 Proposition
            %p
              This construction yields a pair of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mo ⊣
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi dR
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi dR
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{\Pi}_{dR} \dashv \mathbf{\flat}_{dR} )
                    \:
                    */\mathbf{H}
                    \\stackrel{
                    \\overset{\mathbf{\Pi}_{dR}}{\leftarrow}
                    }{
                    \\underset{\mathbf{\flat}_{dR}}{\to}
                    }
                    \\mathbf{H}
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p We check the defining natural hom-equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {*}/\mathbf{H}(\mathbf{\Pi}_{dR}X,A)
                    \\simeq
                    \\mathbf{H}(X, \mathbf{\flat}_{dR}A)
                    \\,.
            %p
              The hom-space in the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} under-(∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} */\mathbf{H}
              is (as discussed there), computed by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi pt
                                  %mi A
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    */\mathbf{H}(\mathbf{\Pi}_{dR}X, A)
                    \&amp;\to&amp;
                    \\mathbf{H}(\mathbf{\Pi}_{dR}X, A)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    * &amp;\stackrel{pt_A}{\to}&amp; \mathbf{H}(*,A)
                    }
                    \\,.
            %p
              By the fact that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi op
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(-,-) : \mathbf{H}^{op} \times \mathbf{H} \to \infty Grpd
              preserves limits in both arguments we have a natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo :
                            %mo =
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi X
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi H
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi A
                                %mo{:stretchy => "false"} )
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}(\mathbf{\Pi}_{dR} X, A)
                    \&amp; :=
                    \\mathbf{H}( *\coprod_{X} \mathbf{\Pi}(X), A  )
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(*,A) \prod_{\mathbf{H}(X,A)}
                    \\mathbf{H}(\mathbf{\Pi}(X),A)
                    \\end{aligned}
                    \\,.
            %p We paste this pullback to the above pullback diagram to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                            %mo{:stretchy => "false"} /
