                  is the target space;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
                  is the background
                  %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mi conn
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}_{conn}(\Sigma,X)
                  is the space of
                  %em worldvolume field configurations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %mi Σ
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \phi : \Sigma \to X
                  or
                  %em trajectories
                  of the brane in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi S
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo ∫
                          %mi Σ
                        %msup
                          %mi ϕ
                          %mo *
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \exp(S_{\mathbf{c}}(\phi)) =  \int_\Sigma \phi^* \hat \mathbf{c}
                  is the value of the
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                  on the field configuration
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                        %annotation{:encoding => "application/x-tex"} \phi
          %p In suitable situations this construction refines to an internal construction.
          %p
            Assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            has a canonical
            %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
            and a
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i S(-))
            may lift to the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            with respect to the canonical
            %a{:href => "http://ncatlab.org/nlab/show/(infinity,1)-topos#ClosedMonoidalStructure"} cartesian closed monoidal structure
            on any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            to a morphism of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mi dim
                      %mi Σ
                  %msup
                    %mi 𝔸
                    %mn 1
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S_{\mathbf{c}}(-)) : [\Sigma,\mathbf{B}G_{conn}] \to
                  \\mathbf{B}^{n-dim \Sigma}\mathbb{A}^1/\mathbb{Z}
                  \\,.
          %p
            We call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Sigma, \mathbf{B}G_{conn}]
            the
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of the
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
            defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                %annotation{:encoding => "application/x-tex"} \mathbf{c}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i S_\mathbf{c}(-))
            the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            in
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mi dim
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n-dim\Sigma)
            defined on it.
          %p
            See
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
            for more discussion.
          %h2#references References
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category-theoretic
            definition of
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            was proposed by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"} Bill Lawvere
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          %p
            The observation that the further left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            in a
            %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
            defines an intrinsic notion of paths and
            %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} geometric homotopy groups in an (∞,1)-topos
            was suggested by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Richard+Williamson"} Richard Williamson
          %p
            The observation that the further right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi coDisc
                %annotation{:encoding => "application/x-tex"} coDisc
            in a
            %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local (∞,1)-topos
            serves to characterize
            %a.existingWikiWord{:href => "/nlab/show/concrete+sheaf"} concrete (∞,1)-sheaves
            was amplified by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/David+Carchedi"} David Carchedi
          %p Several aspects of the discussion here are, more or less explicitly, in
          %ul#SimpsonTeleman
            %li
              %a.existingWikiWord{:href => "/nlab/show/Carlos+Simpson"}> Carlos Simpson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
              %em
                deRham theorem for
                = succeed "-stacks" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (
              %a{:href => "http://math.berkeley.edu/~teleman/math/simpson.pdf"}> pdf
              )
          %p
            For instance something similar to the notion of
            %a.existingWikiWord{:href => "/nlab/show/infinity-connected+%28infinity%2C1%29-site"} ∞-connected site
            and the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            is the content of section 2.16. The
            %a{:href => "#LieTheory"} infinitesimal path ∞-groupoid adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi Red
                  %mo ⊣
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi inf
                  %mo ⊣
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi inf
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbf{Red} \dashv \mathbf{\Pi}_{inf} \dashv \mathbf{\flat}_{inf})
            is essentially discussed in section 3. The notion of geometric realization,
            = succeed "," do
              %a.maruku-ref{:href => "#GeometricRealization"}
          %ul#Simpson
            %li
              %a.existingWikiWord{:href => "/nlab/show/Carlos+Simpson"}> Carlos Simpson
              ,
              %em The topological realization of a simplicial presheaf
              ,
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/q-alg/9609004"} arXiv:q-alg/9609004
          %p
            But, more or less explicitly, the presentation of geometric realization of simplicial presheaves is much older, going back to Artin-Mazur. See
            %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} geometric homotopy groups in an (∞,1)-topos
            for a detailed commented list of literature.
          %p
            A characterization of infinitesimal extensions and formal smoothness by adjoint functors (discussed at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
          %ul#KontsevichRosenbergSpaces
            %li
              %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Rosenberg"} Alexander Rosenberg
              = succeed "," do
                %em Noncommutative spaces
              = succeed "," do
                %a{:href => "http://www.mpim-bonn.mpg.de/preprints/send?bid=2331"} ps
              = succeed ")" do
                %a{:href => "http://www.mpim-bonn.mpg.de/preprints/send?bid=2303"} dvi
          %p
            in the context of
            %em
              %a.existingWikiWord{:href => "/nlab/show/Q-categories"} Q-categories
            \.
          %p The material presented here is also in section 2 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              %em
                %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} differential cohomology in a cohesive topos
          %p A commented list of further related references is at
          %ul
            %li
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+an+%28%E2%88%9E%2C1%29-topos+--+references"} differential cohomology in a cohesive topos – references
