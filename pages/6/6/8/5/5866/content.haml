                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi i
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %msub
                              %mi A
                              %mi i
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}(\mathbf{\Pi}(X), {\lim_\to}_i A_i)
                    \&amp; \simeq
                    \\mathbf{H}(X, \mathbf{\flat}{\lim_\to}_i A_i)
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(X, {\lim_\to}_i \mathbf{\flat} A_i)
                    \\\
                    \&amp; \simeq
                    {\lim_\to}_i \mathbf{H}(X,  \mathbf{\flat} A_i)
                    \\end{aligned}
                    \\,,
            %p
              where in the last step we used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/small-projective"} small-projective
              by assumption.
          .un_def
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              we say that the
              %strong geometric Postnikov tower
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower+in+an+%28%E2%88%9E%2C1%29-category"} Postnikov tower in an (∞,1)-category
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Pi}(X) \to \cdots
                    \\to
                    \\mathbf{\Pi}_2(X) \to \mathbf{\Pi}_1(X) \to \mathbf{\Pi}_0(X)
                    \\,.
          %h3#Coverings Universal coverings and geometric Whitehead towers
          %p
            We discuss an intrinsic notion of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .un_def
            %h6#definition_8 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower+in+an+%28%E2%88%9E%2C1%29-topos"} geometric Whitehead tower
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the sequence of objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mo →
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X^{\mathbf{(\infty)}} \to \cdots \to X^{\mathbf{(2)}} \to X^{\mathbf{(1)}} \to X^{\mathbf{(0)}} \simeq X
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{(n+1)}
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the canonical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{\Pi}_{n+1} X
              to the
              %a{:href => "#Paths"} path n+1-groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              We call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(n+1)}}
              the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %strong
                %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(\infty)}}
              for the homotopy fiber of the untruncated constant path inclusion.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X^{\mathbf{(\infty)}} \to X \to \mathbf{\Pi}(X)
                    \\,.
            %p
              Here the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mi n
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(n+1)}} \to X^{\mathbf{n}}
              are those induced from this
              %a{:href => "http://ncatlab.org/nlab/show/limit+in+a+quasi-category#PushoutPasting"} pasting diagram of (∞,1)-pullbacks
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mstyle{:mathvariant => "bold"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi n
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mstyle{:mathvariant => "bold"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi n
                                  %mo −
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi π
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X^{\mathbf{(n)}} &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X^{\mathbf{(n-1)}} &amp; \to &amp; \mathbf{B}^n \mathbf{\pi}_n(X) &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\to&amp; \mathbf{\Pi}_n(X) &amp;\to&amp; \mathbf{\Pi}_{(n-1)}(X)
                    }
                    \\,,
            %p
              where the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbf{\pi}_n(X)
              is defined as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the bottom right morphism.
          .un_prop
            %h6#proposition_7 Proposition
            %p
              Every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              is covered by objects of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(\infty)}}
              for different choices of base points in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              over a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              whose vertices are of this form.
          .proof
            %h6#proof_7 Proof
            %p Consider the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mrow
                                %mi s
                                %mo ∈
                                %mi Π
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi i
                              %mo *
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mrow
                                %mi s
                                %mo ∈
                                %mi Π
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mo *
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi i
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    {\lim_\to}_{s \in \Pi(X)} (i^* *)
                    \&amp;\to&amp; {\lim_\to}_{s \in \Pi(X)} *
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    X &amp;\stackrel{i}{\to}&amp; \mathbf{\Pi}(X)
                    }
                    \\,.
            %p
              The bottom morphism is the constant path inclusion, the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ⊣
                      %mi Disc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence in an (∞,1)-category
              that is the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              of the decomposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %msub
                          %mi lim
                          %mo →
                      %mi S
                    %mo *
                    %mover
                      %mo →
                      %mo ≃
                    %mi S
                  %annotation{:encoding => "application/x-tex"} {\lim_\to}_S * \stackrel{\simeq}{\to} S
              of every
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              as the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              (see there) over itself of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              constant on the point.
            %p
              The left morphism is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              of this equivalence, hence itself an equivalence. By
              %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
              in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              the top left object is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              over the single
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mo *
                      %mi s
                  %annotation{:encoding => "application/x-tex"} i^* *_s
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(\infty)}}
              as indicated.
          .un_prop
