                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-)
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
