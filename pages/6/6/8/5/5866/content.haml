                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
          .proof
            %h6#proof_15 Proof
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is cohesive we have the
              %a{:href => "#TripleOfDeRhamAdjunctions"} de Rham triple of adjunction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi dR
                      %mo ⊣
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mi dR
                      %mo ⊣
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Γ
                        %mi dR
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbf{\Pi}_{dR} \dashv \mathbf{\flat}_{dR} \dashv \mathbf{\Gamma}_{dR})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                  %annotation{:encoding => "application/x-tex"} Lie
              is part of an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi exp
                    %mi Lie
                    %mo ⊣
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Γ
                      %mi dR
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\exp Lie \dashv \mathbf{\Gamma}_{dR}\mathbf{\flat}_{dR})
                    \\,.
          .un_example
            %h6#propositionexample Proposition/Example
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{dR}(X)
              is geometrically contractible.
          .proof
            %h6#proof_16 Proof
            %p
              Since on the
              %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              and
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Π
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                          %mtd
                            %mrow
                              %mo :
                              %mo =
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi Π
                                %mi X
                            %mi Π
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi Π
                                %mi X
                            %mi Π
                            %mi Disc
                            %mi Π
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi Π
                                %mi X
                            %mi Π
                            %mi X
                          %mtd
                            %mo ≃
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Pi \mathbf{\Pi}_{dR} X
                    \&amp; {:=}
                    \\Pi (*) \coprod_{\Pi X} \Pi \mathbf{\Pi} X
                    \\\
                    \&amp; \simeq
                    * \coprod_{\Pi X} \Pi Disc \Pi X
                    \\\
                    \&amp; \simeq
                    * \coprod_{\Pi X} \Pi X
                    \&amp; \simeq
                    *
                    \\end{aligned}
                    \\,,
            %p
              where we used that in the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"}> full and faithful
              \.
          .un_corollary
            %h6#corollary Corollary
            %p
              We have for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mi Lie
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp Lie \mathbf{B}G
              is geometrically contractible.
          %p
            We shall write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\exp(\mathfrak{g})
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mi Lie
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp Lie \mathbf{B}G
          #LieValuesofDeRham.un_prop
            %h6#proposition_13 Proposition
            %p
              Every
              %a{:href => "#deRhamCohomology"} de Rham cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \omega : \mathbf{\Pi}_{dR} X \to \mathbf{B}G
              factors through the ∞-Lie algebra of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi ω
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{B}\exp(\mathfrak{g})
                    \\\
                    \&amp; \nearrow &amp; \downarrow
                    \\\
                    \\mathbf{\Pi}_{dR}X
                    \&amp;\stackrel{\omega}{\to}&amp;
                    \\mathbf{B}G
                    }
                    \\,.
          .proof
            %h6#proof_17 Proof
            %p
              By the
              %a{:href => "http://ncatlab.org/nlab/show/adjoint+functor#UniversalArrows"} universality of the counit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mo ⊣
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{\Pi}_{dR} \dashv \mathbf{\flat}_{dR})
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              factors through the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mi Lie
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \exp Lie \mathbf{B}G \to \mathbf{B}G
          %p
            Therefore instead of speaking of a
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
          .un_prop
            %h6#corollary_2 Corollary
            %p
              Every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mi Lie
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp Lie \mathbf{B}H \to \mathbf{B}G
              from an exponentiated
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔥
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}\exp(\mathfrak{h}) &amp;\to&amp; \mathbf{B}\exp(\mathfrak{g})
                    \\\
                    \&amp; \searrow&amp; \downarrow
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
          .un_prop
            %h6#proposition_14 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is cohesive then we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mi Lie
                    %mo ∘
                    %mi exp
                    %mi Lie
                    %mo ≃
                    %mi exp
                    %mi Lie
                    %mo ∘
                    %mi Σ
                    %mo ∘
                    %mi Ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp Lie \circ \exp Lie \simeq \exp Lie \circ \Sigma \circ \Omega
                    \\,.
          .proof
            %h6#proof_18 Proof
            %p
              First observe that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} A \in */\mathbf{H}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mi A
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat} \mathbf{\flat}_{dR} A \simeq *
            %p This follows using
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                      %annotation{:encoding => "application/x-tex"} \mathbf{\flat}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  and hence preserves
                  = succeed "s;" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mo :
                        %mo =
                        %mi Disc
                        %mi Γ
                        %mi Disc
                        %mi Γ
                        %mo ≃
                        %mi Disc
                        %mi Γ
                        %mo =
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                      %annotation{:encoding => "application/x-tex"} \mathbf{\flat} \mathbf{\flat} := Disc \Gamma Disc \Gamma \simeq Disc \Gamma =: \mathbf{\flat}
                  by the fact that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Disc
                      %annotation{:encoding => "application/x-tex"} Disc
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              %li
                %p
                  the counit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mi A
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \mathbf{\flat} \mathbf{\flat} A \to \mathbf{\flat} A
                  is equivalent to the identity, by the
                  %a.existingWikiWord{:href => "/nlab/show/zig-zag-identity"} zig-zag-identity
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                  and using that equivalences satisfy
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
            %p by computing
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi A
                          %mtd
                            %mo *
                            %msub
                              %mo ×
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mo ♭
                                %mi A
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %msub
                              %mo ×
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mo ♭
                                %mi A
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{\flat} \mathbf{\flat}_{dR} A
                    \&amp;
                    * \times_{\mathbf{\flat}A} \mathbf{\flat}\mathbf{\flat}A
                    \\\
                    \&amp; \simeq
                    * \times_{\mathbf{\flat}A} \mathbf{\flat}A
                    \\\
                    \&amp; \simeq *
                    \\end{aligned}
                    \\,,
            %p
              using that the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              of an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              is an equivalence.
            %p From this we deduce that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo ∘
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo ∘
                    %mi Ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat}_{dR} \circ \mathbf{\flat}_{dR}
                    \\simeq \mathbf{\flat}_{dR} \circ \Omega
                    \\,.
            %p
              by computing for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mo ∘
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi A
                          %mtd
                            %mo ≃
                            %mo *
                            %msub
                              %mo ×
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mo ♭
                                  %mi dR
                                %mi A
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %msub
                              %mo ×
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mo ♭
                                  %mi dR
                                %mi A
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mo{:stretchy => "false"} (
                            %mo *
                            %msub
                              %mo ×
                              %mi A
                            %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi Ω
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{\flat}_{dR} \circ \mathbf{\flat}_{dR} A
                    \&amp; \simeq
                    * \times_{\mathbf{\flat}_{dR} A} \mathbf{\flat}\mathbf{\flat}_{dR} A
                    \\\
                    \&amp; \simeq
                    * \times_{\mathbf{\flat}_{dR} A} *
                    \\\
                    \&amp; \simeq
                    \\mathbf{\flat}_{dR}( * \times_A * )
                    \\\
                    \&amp; \simeq \mathbf{\flat}_{dR} \Omega A
                    \\end{aligned}
                    \\,.
            %p
              Also observe that by a
              %a{:href => "#deRhamWithDiscCoeffsIsTrivial"} proposition above
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi X
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat}_{dR} \mathbf{\Pi} X \simeq *
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            %p
              Finally to obtain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mi Lie
                    %mo ∘
                    %mi exp
                    %mi Lie
                  %annotation{:encoding => "application/x-tex"} \exp Lie \circ \exp Lie
              we do one more computation of this sort, using that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mi Lie
                        %mo :
                        %mo =
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi Π
                          %mi dR
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mo ♭
                          %mi dR
                      %annotation{:encoding => "application/x-tex"} \exp Lie := \mathbf{\Pi}_{dR} \mathbf{\flat}_{dR}
                  preserves the terminal object (since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected
              %li
                %p
                  and that it is a
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  by
                  = succeed "," do
                    %a{:href => "#LieAsALeftAdjoint"} the above
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
                  is assumed to be cohesive.
            %p We compute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi exp
                            %mi Lie
                            %mi exp
                            %mi Lie
                            %mi A
                          %mtd
                            %mo ≃
                            %mi exp
                            %mi Lie
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi exp
                                %mi Lie
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mo ♭
                                  %mi dR
                                %mi A
                            %mi exp
                            %mi Lie
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi exp
                                %mi Lie
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mo ♭
                                  %mi dR
                                %mi A
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi exp
                                %mi Lie
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mo ♭
                                  %mi dR
                                %mi A
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Π
                                  %mi dR
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mo ♭
                                  %mi dR
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mo ♭
                                  %mi dR
                                %mi A
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
