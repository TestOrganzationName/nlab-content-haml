                    \\to
                    \\mathbf{\flat} \mathbf{B}^{n+1} A
                    \\to
                    \\mathbf{B}^{n+1} A
            %p
              that
              %a{:href => "#CurvatureCharacteristics"} defines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
