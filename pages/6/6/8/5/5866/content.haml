                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi H
                              %mi dR
                            %mo{:stretchy => "false"} (
                            %mi X
