          #DiffCohomologyRestrictedToVanishingCurvature.un_prop
            %h6#proposition_15 Proposition
            %p
              When restricted to vanishing curvature, differential cohomology coincides with
              = succeed ":" do
                %a{:href => "#FlatDifferentialCohomology"} flat differential cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diff
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi F
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                    %mo ≃
                    %msub
                      %mi H
                      %mi flat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
