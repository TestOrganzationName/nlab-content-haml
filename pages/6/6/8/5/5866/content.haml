                  %annotation{:encoding => "application/x-tex"}
                    LConst(X) := \mathbf{H}(X, Disc Core \infty Grpd_\kappa)
                    \\,.
            %p
              We call this the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %strong
                %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"}> locally constant ∞-stack
                s
              on
              = succeed "." do
