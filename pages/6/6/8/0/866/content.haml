                    in its
                    %a.existingWikiWord{:href => "/nlab/show/Kripke+frames"} Kripke frames
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/K+modal+logic"} K modal logic
                  %td{:style => "text-align: left;"}
                    any
                    %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                %tr
                  %td{:style => "text-align: left;"}
                    %span.newWikiWord
                      K4 modal logic
                      %a{:href => "/nlab/new/K4+modal+logic"} ?
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive relation
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/T+modal+logic"} T modal logic
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive relation
                %tr
                  %td{:style => "text-align: left;"}
