              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete category
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/cartesian+functor"} cartesian functor
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/cartesian+logic"} cartesian logic
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/essentially+algebraic+theory"} essentially algebraic theory
