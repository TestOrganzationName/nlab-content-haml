                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} C \coloneqq \sum_{x:A} \sum_{y:B} R(x, y)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi z
                          %mo :
                          %mi C
                          %mo ⊢
                          %mi g
                          %mo{:stretchy => "false"} (
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi A
                        %annotation{:encoding => "application/x-tex"} z:C \vdash g(z):A
                    as
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi z
                            %mo{:stretchy => "false"} )
                            %mo ≔
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi z
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} g(z) \coloneqq \pi_1(z)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi z
                          %mo :
                          %mi C
                          %mo ⊢
                          %mi h
                          %mo{:stretchy => "false"} (
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi B
                        %annotation{:encoding => "application/x-tex"} z:C \vdash h(z):B
                    as
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo{:stretchy => "false"} (
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo ≔
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} h(z) \coloneqq \pi_1(\pi_2(z))
          %p The first and fifth definitions are interdefinable by the following
          %ul
            %li
              %p
                From every family of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
                one could get a family of types by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi B
                      %mo ⊢
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi B
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y:B \vdash \sum_{x:A} f(x) =_B y
                where
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mi B
                        %mi y
                      %annotation{:encoding => "application/x-tex"} A'(y) \coloneqq \sum_{x:A} f(x) =_B y
            %li
              %p
                From every family of types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi B
                      %mo ⊢
                      %mi A
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y:B \vdash A'(y)
                one could get a family of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi y
                          %mo :
                          %mi B
                      %mi A
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:\sum_{y:B} A'(y) \vdash \pi_1(x):B
                where
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ≔
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi y
                            %mo :
                            %mi B
                        %mi A
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \coloneqq \sum_{y:B} A'(y)
          %p
            If the dependent type theory has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
          %ul
            %li
              %p
                From every element of the function type
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f:A \to B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi f
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:A \vdash f'(x):B
                as
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi{:mathvariant => "normal"} ev
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f'(x) \coloneqq \mathrm{ev}(f, x)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi{:mathvariant => "normal"} ev
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A \to B, x:A \vdash \mathrm{ev}(f, x):B
                appears in the
                %a.existingWikiWord{:href => "/nlab/show/elimination+rules"} elimination rules
                for function types.
            %li
              %p
                From every family of elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ⊢
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi B
                      %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f':A \to B
                as
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo ≔
                        %mi x
                        %mo ↦
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f' \coloneqq x \mapsto f(x)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo ⊢
                      %mi x
                      %mo ↦
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:A, f(x):B \vdash x \mapsto f(x):A \to B
                appears in the
                %a.existingWikiWord{:href => "/nlab/show/introduction+rules"} introduction rules
                for function types.
          %h3#in_formal_category_theory In formal category theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+category+theory"} formal category theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+categories"} discrete categories
            %strong function
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                  %mo ⇒
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} x = y \Rightarrow f(x) = f(y) .
          %h3#for_classes For classes
          %p
            One can also speak of functions between proper
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classes"} classes
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/ZFC"} ZFC
            for example, proper classes are by design not formal objects in the theory; rather they are proxied by a formula in the language (for instance, the class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of all sets is proxied by the formula
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x = x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            as consisting of all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            satisfying that formula). Then functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f: A \to B
            between classes are again classes given by suitable formulas; see for example the MathOverflow discussion
            = succeed "." do
              %a{:href => "http://mathoverflow.net/questions/63265/what-are-maps-between-proper-classes"} what-are-maps-between-proper-classes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f, A, B)
            %a{:href => "/nlab/show/ordered+pair#class"} here
            for one possibility. Thus functors between categories whose objects and morphisms form proper classes can similarly be described in the language.
          %p
            Such technical hacks can be avoided by choosing a different foundations. For example, Mac Lane in his
            %a.existingWikiWord{:href => "/nlab/show/Categories+for+the+Working+Mathematician"} Categories for the Working Mathematician
            assumes ZFC with a
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            in which some sets are considered large, such as the set of small sets, so that a category like
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            (the category of small sets) is again a formal object of the theory.
          %h2#AlternativeTerminology Alternative terminology
          %p
            Useful terms, more or less synonymous with
            = succeed "," do
              %em function
            = succeed "," do
              %em assignment
            %em assignation
            or more specifically
            = succeed "." do
              %em assignation on objects
            %a.existingWikiWord{:href => "/nlab/show/functorial"} functorial
            extensions of this partial assignation (cf. e.g. Richard Garner, Homomorphisms of higher categories, Adv. Math. 224 (2010) 2269-2311 for many examples). In mathematical writing “assignment” is usually synonymous with
            %em
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/map"} map
            or “mapping”. For example one might speak of “assigning to each positive number its square root” to refer to the function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi ℝ
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \sqrt{(-)} \colon \mathbb{R}_{\geq 0} \to \mathbb{R}
          %p
            Authors may resort to verb forms such as “assigns” or “associates” or “sends” in informal writing, perhaps to avoid the bother of specifying an axiomatic framework in which a formal notion like “function” is ensconced. For example, according to Wikipedia, Jacobson defines a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F: C \to D
            between categories as a “mapping” that “associates” to each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(X)
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p
            Sometimes the word “assignment” is understood more generally as
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            = succeed ")." do
              %a{:href => "https://books.google.de/books?id=jYniBQAAQBAJ&pg=PA27&lpg=PA27&dq=function+map+assignment+mathematics&source=bl&ots=2aHFjcZ3c9&sig=1HkugZIeSQdnV70U5gjSx_H21ug&hl=en&sa=X&ved=0ahUKEwjpxuPey6nUAhWIfhoKHe9BDy0Q6AEIVTAJ#v=onepage&q=function%20map%20assignment%20mathematics&f=false"} here
          %h2#examples Examples
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/empty+function"} empty function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
          %p
            Many functions that carry special names map some
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            or
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            like the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            or
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            to itself:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/step+function"} step function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/trigonometric+function"} trigonometric function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hypergeometric+function"} hypergeometric function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/special+function"} special function
            %li
              %p …
          %p Special properties these may have:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"}> continuous function
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/analytic+function"} analytic function
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/periodic+function"} periodic function
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/map"}> map
                ,
                %a.existingWikiWord{:href => "/nlab/show/operation"} operation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/partial+function"}> partial function
                ,
                %a.existingWikiWord{:href => "/nlab/show/partial+recursive+function"} partial recursive function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/anafunction"} anafunction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tuple"}> tuple
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                %strong function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dependent+tuple"}> dependent tuple
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/dependent+sequence"} dependent sequence
                %a.existingWikiWord{:href => "/nlab/show/dependent+function"} dependent function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/function+algebra"}> function algebra
                ,
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+functions"} pullback of functions
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"}> continuous function
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/periodic+function"} periodic function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/linear+function"}> linear function
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quadratic+function"} quadratic function
                %a.existingWikiWord{:href => "/nlab/show/polynomial+function"} polynomial function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/bounded+function"} bounded function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/motivic+function"} motivic function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
                \/
                %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
