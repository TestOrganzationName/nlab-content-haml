          %h2#Idea Idea
          %p
            A
            %em function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} f \colon S \to T
            from a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (the
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            (the
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} s \in S
            to a unique element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi T
                  %annotation{:encoding => "application/x-tex"} f(s) \in T
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(s)
                is the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/value"} value
                of the function at
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi T
                    %annotation{:encoding => "application/x-tex"} f(s) \in T
                is
                = succeed "," do
                  %em
                    a function of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                        %annotation{:encoding => "application/x-tex"} s \in S
          %p
            and the process of assigning
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(s)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            is also called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/function+application"} function application
          %p
            For emphasis one sometimes speaks of
            %em total functions
            to distinguish from
            %em
              %a.existingWikiWord{:href => "/nlab/show/partial+functions"} partial functions
            which need not be defined for all
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            of their
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            Famous and historically important examples of functions map specifically between sets of
            %a.existingWikiWord{:href => "/nlab/show/numbers"} numbers
            (such as the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/trigonometric+functions"} trigonometric functions
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/zeta+functions"} zeta functions
            %em function theory
            is generally understood to refer specifically to
            %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            over the
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            or
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            (cf.
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/complex+analysis"} complex analysis
          %p
            Instead of “functions” one also speaks of
            %em
              %a.existingWikiWord{:href => "/nlab/show/maps"} maps
            or
            = succeed "," do
              %em mappings
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            (for instance
            %em
              %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            are functions that respect
            %a.existingWikiWord{:href => "/nlab/show/topology"} topological
            structure). See also
            %a{:href => "#AlternativeTerminology"} further alternative terminology
            below.
          %p
            Hence one may say that functions are
            = succeed "." do
              %em homomorphisms of plain sets
            %em
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %em
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            between
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            in any
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            may be thought of as a function in a generalized sense.
          %p
            This generalized use of the word is wide spread (and justified) in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/types"} types
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} S \to T
            such that the
            %a.existingWikiWord{:href => "/nlab/show/judgement"} judgement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} f \colon S \to T
            means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            %a.existingWikiWord{:href => "/nlab/show/term"} term
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
          %p
            Back in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            becomes the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            of all functions with given
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            of a
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            or generally a
            %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            of an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            (
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"}> exponential object
            ).
          %h2#foundations Foundations
          %p
            The formal definition of a function depends on the
            %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
            chosen.
          %h3#in_set_theory In set theory
          %ul
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is often defined to be a set of
                %a.existingWikiWord{:href => "/nlab/show/ordered+pairs"} ordered pairs
                such that for every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi f
                      %annotation{:encoding => "application/x-tex"} (x,y)\in f
                %a.existingWikiWord{:href => "/nlab/show/domain"} domain
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is then the set of all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                for which there exists some such
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f,A,B)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is the domain and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                the codomain.
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
                = succeed "," do
