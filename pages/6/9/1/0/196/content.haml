                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:A, y:B \vdash R(x, y)
                to be
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} (
