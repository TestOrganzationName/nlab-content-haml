                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/SEAR"} SEAR
          %p
          #FunctionsOfSetsAsTrees.num_remark
            %h6 Remark
            %p
              %strong (functions as trees)
              %br/
              Functions of sets may be identified with
              %a.existingWikiWord{:href => "/nlab/show/rooted+trees"} rooted trees
              of height 2 by treating the
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              as the
              %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              of height 2, the
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              as the vertices of height 1, and letting every height 2 vertex have a single
              %a.existingWikiWord{:href => "/nlab/show/edge"} edge
              to (have its parent be) the
              %a.existingWikiWord{:href => "/nlab/show/value"} value
              it is sent to by the function.
            %p
              This is a special case of the equivalence between rooted trees and
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              (see
              = succeed ")." do
                %a{:href => "tree#AsFunctors"} there
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            if it comes with an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and a family of identities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi a
                  %msub
                    %mo =
                    %mi A
                  %mi x
                %annotation{:encoding => "application/x-tex"} x:A \vdash c(x):a =_A x
            indicating that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
            %strong function
            between types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            could be defined as
          %ul
            %li
              a family of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
            %li
              a
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ;
                    %mi z
                    %mo :
                    %mi C
                    %mo ⊢
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo ;
                    %mi z
                    %mo :
                    %mi C
                    %mo ⊢
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C; z:C \vdash g(z):A; z:C \vdash h(z):B)
              for which the dependent type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \sum_{z:C} g(z) =_A x
              is a
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %li
              a
              %a.existingWikiWord{:href => "/nlab/show/multivalued+partial+function"} multivalued partial function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi x
                    %mo :
                    %mi A
                    %mo ,
                    %mi p
                    %mo :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⊢
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x:A \vdash P(x); x:A, p:P(x) \vdash f(x, p):B)
              for which the dependent type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(x)
              is a
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %li
              a
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ,
                    %mi y
                    %mo :
                    %mi B
                    %mo ⊢
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A, y:B \vdash R(x, y)
              for which the dependent type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi y
                        %mo :
                        %mi B
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{y:B} R(x, y)
              is a
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            %li
              a family of types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi B
                    %mo ⊢
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y:B \vdash A'(y)
            %li
              an element of the
              %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A \to B
          %p
            The first four definitions are interdefinable with each other in
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theories"} dependent type theories
            with
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
          %ul
            %li
              %p
                From every family of elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ⊢
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi B
                      %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
                %a.existingWikiWord{:href => "/nlab/show/span"} span
                by defining the type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                to be a
                %a.existingWikiWord{:href => "/nlab/show/copy"} copy
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ≔
                        %mi{:mathvariant => "normal"} Copy
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C \coloneqq \mathrm{Copy}(A)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo :
                      %mi C
                      %mo ⊢
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} z:C \vdash g(z):A
                to be
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(z) \coloneqq \pi_1(\alpha(x))
                since for all elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                      %annotation{:encoding => "application/x-tex"} z:C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi{:mathvariant => "normal"} copy
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi C
                      %mi z
                    %annotation{:encoding => "application/x-tex"} \sum_{x:A} \mathrm{copy}(x) =_C z
                is contractible and with
                %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                        %mo ⊢
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi{:mathvariant => "normal"} copy
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mi C
                        %mi z
                      %annotation{:encoding => "application/x-tex"} z:C \vdash \alpha(z):\sum_{x:A} \mathrm{copy}(x) =_C z
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi C
                      %mo ⊢
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:C \vdash h(x):B
                to be
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} h(x) \coloneqq f(g(x))
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                      %annotation{:encoding => "application/x-tex"} x:A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi z
                          %mo :
                          %mi C
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \sum_{z:C} g(z) =_A x
                is always a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            %li
              %p
                From every
                %a.existingWikiWord{:href => "/nlab/show/span"} span
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ;
                      %mi z
                      %mo :
                      %mi C
                      %mo ⊢
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                      %mo ;
                      %mi z
                      %mo :
                      %mi C
                      %mo ⊢
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (C; z:C \vdash g(z):A; z:C \vdash h(z):B)
                for which the dependent type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi z
                          %mo :
                          %mi C
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \sum_{z:C} g(z) =_A x
                is a
                %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                      %annotation{:encoding => "application/x-tex"} x:A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
                as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x) \coloneqq h(\pi_1(\alpha(x)))
                for all
                %a.existingWikiWord{:href => "/nlab/show/centers+of+contraction"} centers of contraction
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ⊢
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi z
                            %mo :
                            %mi C
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mi A
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x:A \vdash \alpha(x):\sum_{z:C} g(z) =_A x
            %li
              %p
                From every family of elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ⊢
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi B
                      %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
                %a.existingWikiWord{:href => "/nlab/show/multivalued+partial+function"} multivalued partial function
                by defining
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:A \vdash P(x)
                to be
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
