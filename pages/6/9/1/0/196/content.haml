                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi f
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:A, p:P(x) \vdash f'(x, p):B
                to be
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f'(x, p) \coloneqq f(x)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                      %annotation{:encoding => "application/x-tex"} x:A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
