                      %mi A
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ;
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x:A \vdash P(x); x:A, p:P(x) \vdash f(x, p):B)
                for which the dependent type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
