                    U
                    \&amp;\overset{
                    \\tilde \mu(\Phi_{(-)})}{\longrightarrow}&amp;
                    \\mathbb{R}
                    \\\
                    u &amp;\mapsto&amp; \langle \mu, \Phi_u\rangle
                    }
            %p
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi μ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \mu,-\rangle
              by definition is
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear
              and
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              (
              %a{:href => "#Hoermander90"}> Hörmander 90, theorem 2.1.3
              ).
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{(-)}
              is indeed a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              it remains that every
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    A \;\colon\; [\mathbb{R}^n,\mathbb{R}] \longrightarrow \mathbb{R}
            %p
              when restricted on
              %a.existingWikiWord{:href => "/nlab/show/global+elements"} global elements
              to a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    A(\ast) \;\colon\; C^\infty(\mathbb{R}^n) \longrightarrow \mathbb{R}
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
              structure from def.
              %a.maruku-ref{:href => "#TVSOfCompactlySupportedFunctions"}
              on the left.
            %p
              Now by definition of the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is actually “path-smooth” (
              %a{:href => "Frechet+space#PathSmoothFunction"}> this def.
              ) and hence the statement is implied by
              = succeed "." do
                %a{:href => "Frechet+space#PathSmoothLinearFunctionsOnFrechetSpaceAreContinuous"} this prop
            %p
              Finally to see that this argument generalizes to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+set"} FormalSmoothSet
              observe that the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              of every
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
              is a
              %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
              of an algebra of smooth functions on some
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              (by the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+lemma"} Hadamard lemma
          %h2#properties Properties
          %h3#fourierlaplace_transform Fourier-Laplace transform
          #FourierTransformOfCompactlySupportedDistribution.num_defn
            %h6#propositiondefinition Proposition/Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{E}'(\mathbb{R}^n)
              be a compactly supported distribution on
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %em
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              is the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi u
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %mi ζ
                          %mtd
                            %mo ↦
                          %mtd
                            %mi u
                            %mrow
                              %mo (
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi i
                                  %mo{:stretchy => "false"} ⟨
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo ,
                                  %mi ζ
                                  %mo{:stretchy => "false"} ⟩
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^n &amp;\overset{\hat u}{\longrightarrow}&amp; \mathbb{R}
                    \\\
                    \\zeta &amp;\mapsto&amp; u\left(e^{-i\langle -,\zeta \rangle} \right)
                    }
            %p
              where on the right we have the application of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} u \colon C^\infty(\mathbb{R}^n) \to \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
              applied to the canonical
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %p
              This same formula makes sense more generally for
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ζ
                      %mo ∈
                      %msup
                        %mi ℂ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \zeta \in \mathbb{C}^n
              %em
                %a.existingWikiWord{:href => "/nlab/show/Fourier-Laplace+transform"} Fourier-Laplace transform
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℂ
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi u
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %mi ζ
                          %mtd
                            %mo ↦
                          %mtd
                            %mi u
                            %mrow
                              %mo (
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi i
                                  %mo{:stretchy => "false"} ⟨
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo ,
                                  %mi ζ
                                  %mo{:stretchy => "false"} ⟩
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{C}^n &amp;\overset{\hat u}{\longrightarrow}&amp; \mathbb{R}
                    \\\
                    \\zeta &amp;\mapsto&amp; u\left(e^{-i\langle -,\zeta \rangle} \right)
                    }
            %p
              This is an
              %a.existingWikiWord{:href => "/nlab/show/entire+analytic+function"} entire analytic function
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℂ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}^n
          %p
            (
            %a{:href => "#Hoermander90"}> Hörmander 90, theorem 7.1.14
            )
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"}> Paley-Wiener-Schwartz theorem
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty_c(\mathbb{R}^n)
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              (
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"}> bump functions
              ) on
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is (algebraically and topologically)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              %a.existingWikiWord{:href => "/nlab/show/Fourier-Laplace+transform"} Fourier-Laplace transform
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#FourierTransformOfCompactlySupportedDistribution"}
              %a.existingWikiWord{:href => "/nlab/show/entire+functions"} entire functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^n
              which satisfy the following estimate: there is a
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              such that for every
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} N \gt 0
              there is a
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi N
                  %annotation{:encoding => "application/x-tex"} C_N
              such that:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi ξ
                        %mo ∈
                        %msup
                          %mi ℂ
                          %mi n
                    %mrow
                      %mo (
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi ξ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ‖
                      %mo ≤
                      %msub
                        %mi C
                        %mi N
                      %msup
                        %mrow
                          %mo (
                          %mn 1
                          %mo +
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi ξ
                            %mo{:stretchy => "false"} |
                          %mo )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi N
                      %msup
                        %mi e
                        %mrow
                          %mi B
                          %mspace{:width => "thinmathspace"}
                          %mo{:stretchy => "false"} |
                          %mi Im
                          %mo{:stretchy => "false"} (
                          %mi ξ
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\xi \in \mathbb{C}^n}{\forall}
                    \\left(
                    {\Vert  F(\xi) \Vert}
                    \\le C_N
                    \\left(
                    1 + {\vert \xi\vert }
                    \\right)^{-N} e^{B \, |Im(\xi)|}
                    \\right)
                    \\,.
            %p
              More generally, the space of
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+distribution"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is isomorphic via
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              to those
              %a.existingWikiWord{:href => "/nlab/show/entire+functions"} entire functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^n
              for which there exists positive
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi ξ
                        %mo ∈
                        %msup
                          %mi ℂ
                          %mi n
                    %mrow
                      %mo (
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi ξ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ‖
                      %mo ≤
                      %msub
                        %mi C
                        %mi N
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo +
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ξ
                        %mo{:stretchy => "false"} |
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi N
                      %msup
                        %mi e
                        %mrow
                          %mi B
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mi Im
                          %mo{:stretchy => "false"} (
                          %mi ξ
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\xi \in \mathbb{C}^n}{\forall}
                    \\left(
                    {\Vert F(\xi)  \Vert}
                    \\le
                    C_N (1 + {\vert \xi\vert })^{N} e^{ B \; |Im(\xi)|}
                    \\right)
                    \\,.
            %p
              (Notice that the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              of a
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              is guaranteed to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed ".)" do
                %a{:href => "Fourier+transform+of+distributions#FourierTransformOfCompactlySupportedDistributions"} this prop.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Hoermander90"} Hoermander 90, theorem 7.3.1
          #DecayPropertyOfFourierTransformOfCompactlySupportedFunctions.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (decay of
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compactly+supported+functions"} compactly supported functions
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{E}'(\mathbb{R}^n)
              is a
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#NonSingularCompactlySupportedDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
              via
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo ∫
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi dvol
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u(f) = \int b(x) f(x) dvol(x)
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+a+distribution"} Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u
              (
              %a{:href => "compactly+supported+distribution#FourierTransformOfCompactlySupportedDistribution"}> this def.
              ) satisfies the following decay property:
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi N
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} C_N \in \mathbb{R}_+
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \xi \in \mathbb{R}^n
              we have that the
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert \hat v(\xi)\vert}
              of the Fourier transform at that point is bounded by
            #eq:DecayEstimateForFourierTransformOfNonSingularDistribution.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi C
                      %mi N
                    %msup
                      %mrow
                        %mo (
                        %mn 1
                        %mo +
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi ξ
                          %mo{:stretchy => "false"} |
                        %mo )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert \hat v(\xi)\vert}
                    \\;\leq\;
                    C_N \left( 1 + {\vert \xi\vert} \right)^{-N}
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Hoermander90"} Hoermander 90, around (8.1.1)
          %h3#SingularSupportAndWaveFrontSet Singular support and Wave front set
          #SingularSupportOfCompactlySupportedDistribution.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{E}'(\mathbb{R}^n)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              %em
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              is the
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              of those points which have no
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              on which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              %a.existingWikiWord{:href => "/nlab/show/restriction+of+distributions"} restricts
              to a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi supp
                      %mi sing
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi u
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mo ¬
                      %mrow
                        %mo (
                        %munder
                          %mo ∃
                          %mrow
                            %mi U
                            %munder
                              %mo ⊃
                              %mtext nbhd
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                        %mrow
                          %mo (
                          %mi u
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi U
                          %mo ∈
                          %msubsup
                            %mi C
                            %mi cp
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mo )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    supp_{sing}(u)
                    \\;\coloneqq\;
                    \\left\{
                    u \in \mathbb{R}^n
                    \\,\vert\,
                    \\not \left(
                    \\underset{U \underset{\text{nbhd}}{\supset} \{x\}}{\exists}
                    \\left(
                    u\vert_U \in C^\infty_{cp}(U)
                    \\right)
                    \\right)
                    \\right\}
                    \\,.
          %p
            By prop.
            %a.maruku-ref{:href => "#DecayPropertyOfFourierTransformOfCompactlySupportedFunctions"}
            the
            %a.existingWikiWord{:href => "/nlab/show/singular+support+of+a+distribution"} singular support of a distribution
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SingularSupportOfCompactlySupportedDistribution"}
            %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of the distribution
            receives large high-
            %a.existingWikiWord{:href => "/nlab/show/frequency"} frequency
            (“UV”) contributions. But in fact prop.
            %a.maruku-ref{:href => "#DecayPropertyOfFourierTransformOfCompactlySupportedFunctions"}
            allows to say more precisely
            %em which
            high frequency Fourier modes make the distribution singular at a given point. These are said to be part of the
            %em wave front
            of the distribution, and the collection of all of them is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
            of the distribution:
          #WaveFrontSet.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/wavefront+set"}> wavefront set
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{E}'(\mathbb{R}^n)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
              a
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi u
                    %mo ∈
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b u \in \mathcal{E}'(\mathbb{R}^n)
              for the corresponding product (
              %a{:href => "product+of+distributions#ProductOfADistributionWithANonSingularDistribution"}> this example
              ).
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x\in supp(b) \subset \mathbb{R}^n
              %a.existingWikiWord{:href => "/nlab/show/covector"} covector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \in S((\mathbb{R}^n)^\ast)
              is
              %em regular
              if there exists a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \subset S((\mathbb{R}^n)^\ast)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              in the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi ξ
                    %mo ′
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} c \xi' \in (\mathbb{R}^n)^\ast
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}_+
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ′
                    %mo ∈
                    %mi U
                    %mo ⊂
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi' \in U \subset S((\mathbb{R}^n)^\ast)
              the decay estimate
              %a.maruku-eqref{:href => "#eq:DecayEstimateForFourierTransformOfNonSingularDistribution"} (3)
              is valid for the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{b u}
              of
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mi u
                    %annotation{:encoding => "application/x-tex"} b u
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mi ξ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} c \xi'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              is
              = succeed "." do
                %em non-regular
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi ξ
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi ξ
                      %mspace{:width => "thinmathspace"}
                      %mtext non-regular
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma(b u)
                    \\;\coloneqq\;
                    \\left\{
                    \\xi \in S((\mathbb{R}^n)^\ast)
                    \\;\vert\;
                    \\xi \, \text{non-regular}
                    \\right\}
            %p
              for the set of non-regular covectors of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mi u
                    %annotation{:encoding => "application/x-tex"} b u
            %p
              The
              %em
                wave front set at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              is the
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of these sets as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              ranges over
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
              whose
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              includes
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∩
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi b
                            %mo ∈
                            %msubsup
                              %mi C
                              %mi cp
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mi x
                            %mo ∈
                            %mi supp
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma_x(u)
                    \\;\coloneqq\;
                    \\underset{
                    { b \in C^\infty_{cp}(\mathbb{R}^n) }
                    \\atop
                    { x \in supp(b) }
                    }{\cap}
                    \\Sigma(b u)
                    \\,.
            %p
              Finally the
              %em
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is the subset of the
              %a.existingWikiWord{:href => "/nlab/show/sphere+bundle"} sphere bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(T^\ast \mathbb{R}^n)
              which over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
              consists of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msubsup
                        %mi T
                        %mi x
                        %mo *
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Sigma_x(U) \subset T^\ast_x \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∪
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                    %msub
                      %mi Σ
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    WF(u)
                    \\;\coloneqq\;
                    \\underset{x \in \mathbb{R}^n}{\cup}
                    \\Sigma_x(u)
                    \\;\subset\;
                    S(T^\ast \mathbb{R}^n)
            %p
              Usually this is considered as the full
              %a.existingWikiWord{:href => "/nlab/show/conical+set"} conical set
              inside the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              generated by the unit covectors under multiplication with
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %p
            (
            %a{:href => "#Hoermander90"}> Hörmander 90, def. 8.1.2
            )
          %p
            Hence the
            %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
            of a compactly supported distribution consists of all those
            %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
            of
            %a.existingWikiWord{:href => "/nlab/show/wave+vectors"} wave vectors
            along which the
            %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of the distribution
            is not a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rapidly+decreasing+function"} rapidly decreasing function
          #EmptyWaveFrontSetCorrespondsToOrdinaryFunction.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                corresponds to ordinary
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              is
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              precisely if the distribution is
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#NonSingularCompactlySupportedDistributions"}
          %p
            This is effectively the
            %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
            (
            %a{:href => "#Hoermander90"}> Hörmander 90, below (8.1.1)
            ).
          %h2#examples Examples
          #NonSingularCompactlySupportedDistributions.num_defn
            %h6#definition_6 Definition
            %p
              %strong (non-singular compactly supported distributions)
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mi b
                    %msub
                      %mi dvol
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\mathbb{R}^n} (-) b dvol_{\mathbb{R}^n}
                    \\;\colon\;
                    C^\infty(\mathbb{R}^n) \longrightarrow \mathbb{R}
            %p
              by
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              of smooth functions against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mi dvol
                    %annotation{:encoding => "application/x-tex"} b dvol
            %p This construction defines a linear inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty_{cp}(\mathbb{R}^n) \hookrightarrow \mathcal{E}'(\mathbb{R}^n)
                    \\,.
            %p
              The compactly supported distributions arising this way are called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/microcausal+functional"} microcausal functional
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+continuous+function"} compactly supported continuous function
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
          %h2#references References
          %h3#traditional Traditional
          %p Textbook accounts include
          %ul
            %li#Hoermander90
              %a.existingWikiWord{:href => "/nlab/show/Lars+H%C3%B6rmander"}> Lars Hörmander
              , section 2.3 of
              = succeed "," do
                %em The analysis of linear partial differential operators
          %p Lecture notes include
          %ul
            %li#Klainerman08
              %a.existingWikiWord{:href => "/nlab/show/Sergiu+Klainerman"}> Sergiu Klainerman
              ,
              %em Analysis
              2008 (
              %a{:href => "https://web.math.princeton.edu/~seri/homepage/courses/Analysis2008.pdf"}> pdf
              )
          %h3#in_terms_of_smooth_toposes In terms of smooth toposes
          %p
            Discussion of compactly supported distributions in terms morphisms out of
            %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
            in a
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
            is in
          %ul
            %li#MoerdijkReyes91
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gonzalo+Reyes"} Gonzalo Reyes
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} Models for Smooth Infinitesimal Analysis
          %p
            and specifically for the
            %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
            of
            %a.existingWikiWord{:href => "/nlab/show/formal+smooth+sets"} formal smooth sets
            in
          %ul
            %li#KockReyes03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gonzalo+Reyes"} Gonzalo Reyes
                = succeed "," do
                  %em Some calculus with extensive quantities: wave equation
                = succeed ")" do
                  %a{:href => "http://www.tac.mta.ca/tac/volumes/11/14/11-14abs.html"} TAC
            %li#Kock11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
                ,
                %em Commutative monads as a theory of distributions
                (
                %a{:href => "http://arxiv.org/abs/1108.5952"}> arxiv:1108.5952
                )
          %p using results of
          %ul
            %li#FroelicherKriegl88
              %a.existingWikiWord{:href => "/nlab/show/Alfred+Fr%C3%B6licher"}> Alfred Frölicher
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andreas+Kriegl"} Andreas Kriegl
              = succeed "," do
                %em Linear spaces and differentiation theory
              = succeed ")" do
                %a{:href => "http://www.fuw.edu.pl/~kostecki/scans/froelicherkriegl1988.pdf"} pdf
          %p
            and following the general conception of “
            %a.existingWikiWord{:href => "/nlab/show/intensive+and+extensive"}> intensive and extensive
            ” in
          %ul
            %li#Lawvere86
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
              , Introduction to
              %em
                %a.existingWikiWord{:href => "/nlab/show/Categories+in+Continuum+Physics"}> Categories in Continuum Physics
                , Lectures given at a Workshop held at SUNY, Buffalo 1982. Lecture Notes in Mathematics 1174. 1986
          %p Generalization to non-compactly supported distributions is in
          %ul
            %li#KockReyes04
              %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gonzalo+Reyes"} Gonzalo Reyes
              %em Categorical distribution theory; heat equation
              (
              %a{:href => "https://arxiv.org/abs/math/0407242"}> arXiv:math/0407242
              )
          %p
            and
            %a.existingWikiWord{:href => "/nlab/show/sheaf+theory"} sheaf theoretic
            discussion of distributions as morphisms of
            %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
            is in
          %ul
            %li#Paugam12
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9d%C3%A9ric+Paugam"}> Frédéric Paugam
              , section 3.2 of
              = succeed "," do
                %em Towards the mathematics of quantum field theory
              = succeed ")" do
                %a{:href => "https://webusers.imj-prg.fr/~frederic.paugam/documents/enseignement/master-mathematical-physics.pdf"} pdf
