                  %annotation{:encoding => "application/x-tex"} \widetilde{(-)}
              is well defined, we need to check that the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mover
                                  %mi μ
                                  %mo{:stretchy => "false"} ˜
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi Φ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %mi u
