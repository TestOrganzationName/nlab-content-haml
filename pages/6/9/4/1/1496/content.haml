                    %annotation{:encoding => "application/x-tex"} \hat{x}
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} x = {\|{x}\|}\, \hat{x}
                (this is what I'm calling
                = succeed ")." do
                  %em normalizability
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} ‖
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} {\|{\hat{x}}\|} = 1
            %li
              %p
                For each short vector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and short vector
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo −
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x - y
                %em distance
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d(x,y)
                to be
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mrow
                            %mfrac
                              %mn 1
                              %mn 2
                            %mi x
                            %mo −
                            %mfrac
                              %mn 1
                              %mn 2
                            %mi y
                          %mo{:stretchy => "false"} ‖
                      %annotation{:encoding => "application/x-tex"} 2 {\|{\frac 1 2 x - \frac 1 2 y}\|}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} a \geq 2
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi a
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mrow
                            %mfrac
                              %mn 1
                              %mi a
                            %mi x
                            %mo −
                            %mfrac
                              %mn 1
                              %mi a
                            %mi y
                          %mo{:stretchy => "false"} ‖
                      %annotation{:encoding => "application/x-tex"} d(x,y) = a {\|{\frac 1 a x - \frac 1 a y}\|}
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo ,
                      %msub
                        %mi x
                        %mn 3
                      %mo ,
                      %mi …
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_1, x_2, x_3, \ldots)
                is a
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
                (or
                %a.existingWikiWord{:href => "/nlab/show/net"} net
                in constructive mathematics), we require that the sequence converges. (We automatically get
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mrow
                          %mi n
                          %mo →
                          %mn ∞
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %msub
                        %mi a
                        %mi i
                      %msub
                        %mi x
                        %mi i
                      %mo =
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mn ∞
                      %msub
                        %mi a
                        %mi i
                      %msub
                        %mi x
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \lim _ { n \to \infty } \sum _ { i = 1 } ^ n a _ i x _ i = \sum _ { i = 1 } ^ \infty a _ i x _ i
                from what has come before, but not every Cauchy sequence takes this form.)
          %p
            We can then define a
            %em vector
            to be a formal scalar multiple of a short vector. Specifically, a vector is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
            of pairs
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is a scalar and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is a short vector, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,x)
            is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b,y)
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi a
                    %mi c
                  %mi x
                  %mo =
                  %mfrac
                    %mi b
                    %mi c
                  %mi y
                %annotation{:encoding => "application/x-tex"} \frac a c x = \frac b c y
            for some nonzero scalar
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mfrac
                      %mi a
                      %mi c
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mn 1
                %annotation{:encoding => "application/x-tex"} {|{\frac a c}|} \leq 1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mfrac
                        %mi b
                        %mi c
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} {|{\frac b c}|} \leq 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo{:stretchy => "false"} |
                    %mo ,
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi b
                      %mo{:stretchy => "false"} |
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c = \max ({|{a}|},{|{b}|},1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mfrac
                      %mi a
                      %mi c
                    %mi x
                    %mo +
                    %mfrac
                      %mi b
                      %mi c
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [(a,x)] + [(b,y)] = [(c,\frac a c x + \frac b c y)]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo =
                  %mi max
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo{:stretchy => "false"} |
                  %mo ,
                  %mfrac
                    %mn 1
                    %mn 2
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi b
                    %mo{:stretchy => "false"} |
                  %mo ,
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c = \max (\frac 1 2 {|{a}|},\frac 1 2 {|{b}|},\frac 1 2)
            or any other nonzero scalar such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mfrac
                        %mi a
                        %mi c
                      %mo{:stretchy => "false"} |
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mfrac
                        %mi b
                        %mi c
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} {|{\frac a c}|} + {|{\frac b c}|} \leq 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} b [(a,x)]
            even more easily as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [(a b,x)]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ‖
                    %mo ≔
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} {\|{[(a,x)]}\|} \coloneqq {|{a}|}\, {\|{x}\|}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [(1,x)]
          %h2#examples Examples
          %p
            Many examples of Banach spaces are parametrised by an exponent
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi p
                    %mo ≤
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} 1 \leq p \leq \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi p
                    %mo &lt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \leq p \lt 1
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                is a Banach space with
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} ‖
                          %mi p
                      %mo =
                      %mroot
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi i
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi x
                              %mi i
                            %msup
                              %mo{:stretchy => "false"} |
                              %mi p
                        %mi p
                      %mo .
                    %annotation{:encoding => "application/x-tex"} {\|(x_1,\ldots,x_n)\|_p} = \root p {\sum_i {|x_i|^p}} .
              %p
                (We can allow
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} p = \infty
                by taking a limit; the result is that
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %msub
                            %mo{:stretchy => "false"} ‖
                            %mn ∞
                        %mo =
                        %msub
                          %mi max
                          %mi i
                        %mrow
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi x
                            %mi i
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {\|x\|_\infty} = \max_i {|x_i|}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                and
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is irrelevant up to isomorphism.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/sequence+space"} sequence space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi l
                        %mi p
                    %annotation{:encoding => "application/x-tex"} l^p
                is the set of infinite
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                      %mo ,
                      %mi …
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_1,x_2,\ldots)
                of real numbers such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %msub
                          %mi x
                          %mn 2
                        %mo ,
                        %mi …
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} ‖
                          %mi p
                      %mo =
                      %mroot
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi i
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi x
                              %mi i
                            %msup
                              %mo{:stretchy => "false"} |
                              %mi p
                        %mi p
                    %annotation{:encoding => "application/x-tex"} {\|(x_1,x_2,\ldots)\|_p} = \root p {\sum_i {|x_i|^p}}
              %p
                exists as a finite real number. (The only question is whether the sum converges. Again
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} p = \infty
                is a limit, with the result that
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %msub
                            %mo{:stretchy => "false"} ‖
                            %mn ∞
                        %mo =
                        %msub
                          %mi sup
                          %mi i
                        %mrow
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi x
                            %mi i
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {\|x\|_\infty} = \sup_i {|x_i|}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi l
                        %mi p
                    %annotation{:encoding => "application/x-tex"} l^p
                is a Banach space with that norm. These are all versions of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^\infty
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes+of+Banach+spaces"} isomorphism classes of Banach spaces
            %li
              %p
                More generally, let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                be any
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi l
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} l^p(A)
                be the set of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi f
                        %msub
                          %mo{:stretchy => "false"} ‖
                          %mi p
                      %mo =
                      %mroot
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} |
                              %mi p
                        %mi p
                    %annotation{:encoding => "application/x-tex"} {\|f\|_p} = \root p {\sum_{x: A} {|f(x)|^p}}
              %p
                exists as a finite real number. (Again,
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi f
                          %msub
                            %mo{:stretchy => "false"} ‖
                            %mn ∞
                        %mo =
                        %msub
                          %mi sup
                          %mrow
                            %mi x
                            %mo{:lspace => "verythinmathspace"} :
                            %mi A
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {\|f\|_\infty} = \sup_{x\colon A} {|f(x)|}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi l
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} l^p(A)
                is a Banach space. (This example includes the previous examples, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                a countable set.)
            %li
              %p
                On any
                %a.existingWikiWord{:href => "/nlab/show/measure+space"} measure space
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/Lebesgue+space"} Lebesgue space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℒ
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}^p(X)
                is the set of measurable almost-everywhere-defined real-valued functions on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi f
                        %msub
                          %mo{:stretchy => "false"} ‖
                          %mi p
                      %mo =
                      %mroot
                        %mrow
                          %mo ∫
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi f
                            %msup
                              %mo{:stretchy => "false"} |
                              %mi p
                        %mi p
                    %annotation{:encoding => "application/x-tex"} {\|f\|_p} = \root p {\int {|f|^p}}
              %p
                exists as a finite real number. (Again, the only question is whether the integral converges. And again
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} p = \infty
                is a limit, with the result that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi f
                        %msub
                          %mo{:stretchy => "false"} ‖
                          %mn ∞
                    %annotation{:encoding => "application/x-tex"} {\|f\|_\infty}
                is the
                %a.existingWikiWord{:href => "/nlab/show/essential+supremum"} essential supremum
                of
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {|f|}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℒ
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}^p(X)
                is a complete pseudonormed vector space; but we identify functions that are equal almost everywhere to make it into a Banach space. (This example includes the previous examples, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a set with counting measure.)
            %li
              %p
                Any
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
                is Banach space; this includes all of the above examples for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} p = 2
          %h2#operations_on_banach_spaces Operations on Banach spaces
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ban
                %annotation{:encoding => "application/x-tex"} Ban
            of Banach spaces is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} small complete
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} small cocomplete
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+closed+category"} symmetric monoidal closed
            with respect to its standard internal hom (described at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
          %ul
            %li
              %p
                The category of Banach spaces admits small
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi α
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi α
                            %mo ∈
                            %mi A
                      %annotation{:encoding => "application/x-tex"} \{X_\alpha\}_{\alpha \in A}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ban
                    %annotation{:encoding => "application/x-tex"} Ban
                is the subspace of the vector-space product
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi α
                          %mo ∈
                          %mi A
                      %msub
                        %mi X
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \prod_{\alpha \in A} X_\alpha
              %p
                consisting of
                = succeed "-tuples" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi x
                        %mi α
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle x_\alpha \rangle
                which are
                %em uniformly
                bounded (i.e., there exists
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                such that
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∀
                        %mi α
                        %mo ∈
                        %mi A
                        %mo :
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %msub
                            %mi x
                            %mi α
                          %mo{:stretchy => "false"} ‖
                        %mo ≤
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \forall \alpha \in A: {\|x_\alpha\|} \leq C
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi x
                          %mi α
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle x_\alpha \rangle
                = succeed "-norm;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "-indexed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                is what is normally denoted as
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi l
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} l^{\infty}(A)
            %li
              %p
                The category of Banach spaces admits
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo :
                      %mi X
                      %mo ⇉
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f, g: X \rightrightarrows Y
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ban
                    %annotation{:encoding => "application/x-tex"} Ban
                is the
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo −
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f-g
                under the norm inherited from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (the kernel is closed since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo −
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f-g
                is continuous, and is therefore complete). In fact every equalizer is even a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                by the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Hahn-Banach+theorem"} Hahn-Banach theorem
                %a.existingWikiWord{:href => "/nlab/show/extremal+monomorphism"} extremal monomorphism
                is even already an equalizer (and a section): Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f\colon X \to Y
                be an extremal monomorphism,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℑ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \iota\colon \Im(f) \to Y
                the embedding of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Im(f)
                into the codomain of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f\prime \colon X \to Im(f)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                with restricted codomain. Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %annotation{:encoding => "application/x-tex"} f\prime
                is an epimorphism,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo =
                        %mi ι
                        %mi f
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %annotation{:encoding => "application/x-tex"} f=\iota f\prime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                extremal,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %annotation{:encoding => "application/x-tex"} f\prime
                is an isomorphism, thus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is an embedding.
            %li
              %p
                The category of Banach spaces admits small
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi α
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi α
                            %mo ∈
                            %mi A
                      %annotation{:encoding => "application/x-tex"} \{X_\alpha\}_{\alpha \in A}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ban
                    %annotation{:encoding => "application/x-tex"} Ban
                is the completion of the vector space coproduct
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                        %mrow
                          %mi α
                          %mo ∈
                          %mi A
                      %msub
                        %mi X
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \bigoplus_{\alpha \in A} X_\alpha
              %p with respect to the norm given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo ‖
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                          %mrow
                            %mi s
                            %mo ∈
                            %mi S
                        %msub
                          %mi x
                          %mi s
                        %mo ‖
                      %mo =
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msub
                          %mi x
                          %mi s
                        %mo{:stretchy => "false"} ‖
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} {\left\| \bigoplus_{s \in S} x_s \right\|} = \sum_{s \in S} {\|x_s\|} ,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi A
                    %annotation{:encoding => "application/x-tex"} S \subseteq A
                is finite and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msub
                          %mi x
                          %mi s
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} {\|x_s\|}
                denotes the norm of an element in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi s
                      %annotation{:encoding => "application/x-tex"} X_s
                = succeed "-norm;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed "-indexed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                is what is normally denoted as
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi l
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} l^1(A)
            %li#Coequalizers
              %p
                The category of Banach spaces admits
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coequalizers"} coequalizers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo :
                      %mi X
                      %mo ⇉
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f,g: X \rightrightarrows Y
                to be the
                %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo −
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f-g
                under the quotient norm (in which the norm of a coset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo +
                      %mi C
                    %annotation{:encoding => "application/x-tex"} y + C
                is the minimum norm attained by elements of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo +
                        %mi C
                      %annotation{:encoding => "application/x-tex"} y + C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is the
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo −
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f-g)(X)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                need not be closed (indeed, the inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %msub
                        %mi ℓ
                        %mn 1
                      %mo ↪
                      %msub
                        %mi c
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} i: \ell_1 \hookrightarrow c_0
                has dense image in
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} c_0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo −
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f-g)(X)
                suffices.
            %li
              %p
                To describe the tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mo ⊗
                        %mi Ban
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \otimes_{Ban} Y
                of two Banach spaces (making
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ban
                    %annotation{:encoding => "application/x-tex"} Ban
                symmetric monoidal closed with respect to its usual internal hom), let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(X \times Y)
                be the free vector space generated by the set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \times Y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo ‖
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi i
                            %mo ≤
                            %mi n
                        %msub
                          %mi a
                          %mi i
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi i
                        %mo ⊗
                        %msub
                          %mi y
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ‖
                      %mo =
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mn 1
                          %mo ≤
                          %mi i
                          %mo ≤
                          %mi n
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi a
                          %mi i
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} ‖
                      %mo ⋅
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msub
                          %mi y
                          %mi i
                        %mo{:stretchy => "false"} ‖
                      %mo .
                    %annotation{:encoding => "application/x-tex"} {\left\| \sum_{1 \leq i \leq n} a_i (x_i \otimes y_i) \right\|} = \sum_{1 \leq i \leq n} {|a_i|} {\|x_i\|} \cdot {\|y_i\|}.
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \overline{F}(X \times Y)
                denote its completion with respect to this norm. Then take the cokernel of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \overline{F}(X \times Y)
                by the closure of the subspace spanned by the obvious bilinear relations. This quotient is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %msub
                          %mo ⊗
                          %mi Ban
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \otimes_{Ban} Y
          %p
            In the literature on Banach spaces, tensor product above is usually called the
            %strong projective tensor product
            of Banach spaces; see other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+Banach+spaces"} tensor product of Banach spaces
            = succeed ";" do
              %strong direct sums
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/direct+sums+of+Banach+spaces"} direct sums of Banach spaces
          %p To be described:
          %ul
            %li
              duals (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                    %mo =
                    %mi p
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p + q = p q
              );
            %li
              completion (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ban
                  %annotation{:encoding => "application/x-tex"} Ban
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PsNVect
                  %annotation{:encoding => "application/x-tex"} PsNVect
              (pseudo-normed vector spaces)).
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ban
                  %annotation{:encoding => "application/x-tex"} Ban
              as a (somewhat larger) category with duals.
          %h2#integration_in_banach_spaces Integration in Banach spaces
          %p
            This paragraph describes some aspects of integration theory in Banach spaces that are relevant to understand the literature about
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/AQFT"} AQFT
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}
            are sometimes called vectors, a function or measure taking values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}
            are therefore called vector functions and vector measures. Functions and measures taking values in the
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            that the Banach space is defined upon as a vector space are called scalar functions and scalar measures.
          %p We will consider two types of integrals:
          %ul
            %li
              %p integrals of vector functions with respect to a scalar measure, specifically the Bochner integral,
            %li
              %p integrals of scalar functions with respect to a vector measure, specifically the spectral integral of a normal operator on a Hilbert space.
          %h3#bochner_integral Bochner integral
          %p
            The Bochner integral is a direct generalization of the Lesbegue integral to functions that take values in a Banach space. Whenever you encounter an integral of a function taking values in a Banach space in the
            %a.existingWikiWord{:href => "/nlab/show/AQFT"} AQFT
            literature, it is safe to assume that it is meant to be a Bochner integral. Two points already explained by Wikipedia are of interest:
          %ol
            %li A version of the dominated convergence theorem is true for the Bochner integral.
            %li There are theorems that are not valid for the Bochner integral, notably the Radon-Nikodym theorem does not hold in general.
          %ul
            %li
              %a{:href => "http://en.wikipedia.org/wiki/Bochner_integral"} Wikipedia
          %p
            %em> reference
            \: Joseph Diestel: “Sequences and Series in Banach Spaces” (
            %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:0542.46007&format=complete"}> ZMATH entry
            ), chapter IV.
          %h3#the_spectral_integral The spectral integral
          %p
            The integral with respect to the spectral measure of a bounded normal operator on a Hilbert space is an example of a Banach space integral with respect to a vector measure. In this paragraph we present a well known, but somewhat less often cited result, that is of use in some proofs in some approaches to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/AQFT"} AQFT
          %p
            Let A be a bounded normal operator on a Hilbert space and E be it’s spectral measure (the “resolution of identity” in the terms of Dunford and Schwartz). Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma(A)
            be the spectrum of A. For a bounded complex Borel function f we then have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mo ∫
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mo{:stretchy => "false"} )
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi λ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f(A) \coloneqq \int_{\sigma(A)} f(\lambda) E(d\lambda)
          .un_theorem
            %h6#theorem_dominated_convergence Theorem (dominated convergence)
            %p
              If the uniformly bounded sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{f_n\}
              of complex Borel functions converges at each point of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma(A)
              to the function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_n(A) \to f(A)
              in the strong operator topology.
          .proof
            %p See Dunford, Schwartz II, chapter X, corollary 8.
          %h2#properties Properties
          %h3#relation_to_bornological_spaces Relation to bornological spaces
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/inductive+limit"} inductive limit
            of
            %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bornological+vector+space"} bornological vector space
            = succeed ")" do
              %a{:href => "#AlpaySalomon13"} Alpay-Salomon 13, prop. 2.3
          %p
            Conversely, every
            %a.existingWikiWord{:href => "/nlab/show/bornological+vector+space"} bornological vector space
            is an inductive limit of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/normed+spaces"} normed spaces
            %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
            if it is quasi-complete (
            %a{:href => "#SchaeferWolff99"}> Schaefer-Wolff 99
            )
          %h3#further_properties Further properties
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Krein-Smulian+theorem"} Krein-Smulian theorem
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/reflexive+Banach+space"} reflexive Banach space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/projective+Banach+space"} projective Banach space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Banach+analytic+space"} Banach analytic space
          %div
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/algebra"} algebraic structure
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/group"} group
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/ring"} ring
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/field"} field
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    (submultiplicative)
                    %a.existingWikiWord{:href => "/nlab/show/norm"} norm
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/normed+group"} normed group
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/normed+ring"} normed ring
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/normed+field"} normed field
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/normed+vector+space"} normed vector space
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/normed+algebra"} normed algebra
                %tr
                  %td{:style => "text-align: left;"}
                    multiplicative
                    %a.existingWikiWord{:href => "/nlab/show/norm"} norm
                    (
                    %a.existingWikiWord{:href => "/nlab/show/absolute+value"}> absolute value
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/valuation"}> valuation
                    )
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/valued+field"} valued field
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/complete+space"} completeness
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/complete+normed+group"} complete normed group
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Banach+ring"} Banach ring
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/complete+field"} complete field
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Banach+vector+space"} Banach vector space
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Banach+algebra"} Banach algebra
          %h2#references References
          %p
            Named after
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Banach"} Stefan Banach
          %ul
            %li
              %p
                Walter Rudin,
                %em Functional analysis
            %li
              %p
                Dunford, Nelson; Schwartz, Jacob T.: “Linear operators. Part I: General theory.” (
                %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:0635.47001&format=complete"}> ZMATH entry
                ), “Linear operators. Part II: Spectral theory, self adjoint operators in Hilbert space.” (
                %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:0635.47002&format=complete"}> ZMATH entry
                )
            %li
              %p
                Z. Semadeni,
                = succeed "," do
                  %em Banach spaces of continuous functions
            %li#AlpaySalomon13
              %p
                Daniel Alpay, Guy Salomon,
                %em On algebras which are inductive limits of Banach spaces
                (
                %a{:href => "http://arxiv.org/abs/1302.3372"}> arXiv:1302.3372
                )
            %li#SchaeferWolff99
              %p
                H. H. Schaefer with M. P. Wolff,
                = succeed "," do
                  %em Topological vector spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Rosick%C3%BD"}> Jiří Rosický
                ,
                = succeed "," do
                  %em Are Banach spaces monadic?
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2011.07543"} arXiv:2011.07543
