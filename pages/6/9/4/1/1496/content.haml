          %h2#idea Idea
          %p
            A Banach space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}
            is both a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            (over a
            %a.existingWikiWord{:href => "/nlab/show/normed+field"} normed field
            such as
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/complete+space"} complete
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normed+vector+space"} normed vector space
          %p
            A source of simple Banach spaces comes from considering a
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            (or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} K^n
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is the normed field) with the norm:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mi p
                  %mo ≔
                  %mroot
                    %mrow
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %msup
                          %mo{:stretchy => "false"} |
                          %mi p
                    %mi p
                %annotation{:encoding => "application/x-tex"} {\|(x_1,\ldots,x_n)\|_p} \coloneqq \root p {\sum_{i = 1}^n {|x_i|^p}}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ≤
                  %mi p
                  %mo ≤
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} 1 \leq p \leq \infty
            (this doesn’t strictly make sense for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} p = \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo →
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} p \to \infty
            and reading
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn ∞
                  %mo =
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi n
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^\infty = \underset{\longrightarrow}{\lim}_n \mathbb{R}^n
            as the
            %a.existingWikiWord{:href => "/nlab/show/direct+limit"} direct limit
            (as opposed to the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mn ∞
                    %mo ≔
                    %msub
                      %mi max
                      %mi i
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi x
                        %mi i
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\|(x_1,\ldots,x_n)\|_\infty} \coloneqq \max_i {|x_i|}
          %p
            However, the theory of these spaces is not much more complicated than that of finite-dimensional vector spaces because they all have the same underlying topology. When we look at infinite-dimensional examples, however, things become trickier. Common examples are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+spaces"} Lebesgue spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sequence+spaces"} sequence spaces
          %p
            In the literature, one most often sees Banach spaces over the field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            of
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            are not much different, since they are also over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/p-adic+numbers"} p-adic numbers
            too.
            %em
              Unless otherwise stated, we assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              below.
          %h2#definitions Definitions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            over the field of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            somewhat.) A
            %strong pseudonorm
            (or
            = succeed ")" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/seminorm"} seminorm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mo −
                    %mo{:stretchy => "false"} ‖
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} {\| - \|}\colon V \to \mathbb{R}
          %p such that:
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mn 0
                      %mo{:stretchy => "false"} ‖
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\|0\|} \geq 0
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi r
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi r
                      %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} {\|r v\|} = {|r|} {\|v\|}
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              a
              %a.existingWikiWord{:href => "/nlab/show/scalar"} scalar
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              a vector);
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo +
                      %mi w
                      %mo{:stretchy => "false"} ‖
                    %mo ≤
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi w
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} {\|v + w\|} \leq {\|v\|} + {\|w\|}
              \.
          %p
            It follows from the above that
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\|v\|} \geq 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mn 0
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\|0\|} = 0
            %strong
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            is a pseudonorm that satisfies a converse to this:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} v = 0
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\|v\|} = 0
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is
            %strong complete
            if, given any infinite
            %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mn 2
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (v_1, v_2, \ldots)
            such that
          #eq:Cauchy.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi m
                      %mo ,
                      %mi n
                      %mo →
                      %mn ∞
                  %mrow
                    %mo ‖
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mi m
                      %mrow
                        %mi m
                        %mo +
                        %mi n
                    %msub
                      %mi v
                      %mi i
                    %mo ‖
                  %mo =
                  %mn 0
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \lim_{m,n\to\infty} {\left\| \sum_{i=m}^{m+n} v_i \right\|} = 0 ,
          %p
            there exists a (necessarily unique)
            %strong sum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            such that
          #eq:converge.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %mrow
                    %mo ‖
                    %mi S
                    %mo −
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi v
                      %mi i
                    %mo ‖
                  %mo =
                  %mn 0
                  %mo ;
                %annotation{:encoding => "application/x-tex"} \lim_{n\to\infty} {\left\| S - \sum_{i=1}^n v_i \right\|} = 0 ;
          %p we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mn ∞
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} S = \sum_{i=1}^\infty v_i
          %p (with the right-hand side undefined if no such sum exists).
          %p
            Then a
            %strong Banach space
            is simply a vector space equipped with a complete norm. As in the real line, we have in a Banach space that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo ‖
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi v
                      %mi i
                    %mo ‖
                  %mo ≤
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mn ∞
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} ‖
                  %mo ,
                %annotation{:encoding => "application/x-tex"} {\left\| \sum_{i=1}^\infty v_i \right\|} \leq \sum_{i=1}^\infty {\|v_i\|} ,
          %p
            with the left-hand side guaranteed to exist if the right-hand side exists as a finite real number (but the left-hand side may exist even if the right-hand side diverges, the usual distinction between
            %a.existingWikiWord{:href => "/nlab/show/absolute+convergence"} absolute convergence
            and
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/conditional+convergence"} conditional convergence
          %p
            If we do not insist on the space being complete, we call it a
            = succeed "." do
              %strong normed (vector) space
            %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
            such that the topology comes from a norm, but we do not make an actual choice of such a norm, then we talk of a
            = succeed "." do
              %strong normable space
          %h3#banach_spaces_as_metric_spaces Banach spaces as metric spaces
          %p
            The three axioms for a pseudonorm are very similar to the three axioms for a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pseudometric"} pseudometric
          %p
            Indeed, in any pseudonormed vector space, let the
            %strong distance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(v,w)
            be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi w
                    %mo −
                    %mi v
                    %mo{:stretchy => "false"} ‖
                  %mo .
                %annotation{:encoding => "application/x-tex"} d(v,w) = {\|w - v\|} .
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is a pseudometric, which is
            %strong translation-invariant
            in that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo +
                  %mi x
                  %mo ,
                  %mi w
                  %mo +
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(v+x,w+x) = d(v,w)
          %p
            always holds. Conversely, given any translation-invariant pseudometric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            on a vector space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi v
                    %mo{:stretchy => "false"} ‖
                %annotation{:encoding => "application/x-tex"} {\|v\|}
            be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi v
                    %mo{:stretchy => "false"} ‖
                  %mo =
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} {\|v\|} = d(0,v) .
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mo −
                    %mo{:stretchy => "false"} ‖
                %annotation{:encoding => "application/x-tex"} {\|-\|}
            satisfies the axioms (1–3) for a pseudonorm, except that it may satisfy (2) only for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                    %mo ,
                    %mo ±
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} r = 0, \pm 1
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/G-pseudonorm"} G-pseudonorm
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mi v
                  %mo ,
                  %mi r
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi r
                    %mo{:stretchy => "false"} |
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} d(r v,r w) = {|r|} d(v,w) .
          %p Thus pseudonorms correspond precisely to homogeneous translation-invariant pseudometrics.
          %p
            Similarly, norms correspond to homogenous translation-invariant metrics and complete norms correspond to complete homogeneous translation-invariant metrics. Indeed,
            %a.maruku-eqref{:href => "#eq:Cauchy"} (1)
            says that the sequence of partial sums is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
            %a.maruku-eqref{:href => "#eq:converge"} (2)
            says that the sequence of partial sums converges to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p Thus a Banach space may equivalently be defined as a vector space equipped with a complete homogeneous translation-invariant metric. Actually, one usually sees a sort of hybrid approach: a Banach space is a normed vector space whose corresponding metric is complete.
          %h3#morphisms Maps between Banach spaces
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            are pseudonormed vector spaces, then the
            %strong norm
            of a linear function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi W
                %annotation{:encoding => "application/x-tex"} f\colon V \to W
            may be defined in either of these equivalent ways:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mi sup
                    %mo{:stretchy => "false"} {
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mo ≤
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} {\|f\|} = \sup \{ {\|f v\|} \;|\; {\|v\|} \leq 1 \}
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mi inf
                    %mo{:stretchy => "false"} {
                    %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ∀
                    %mi v
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mo ≤
                    %mi r
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} }
