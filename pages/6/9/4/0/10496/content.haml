          %p Textbook accounts:
          %ul
            %li#Wen2007
              %p
                %a.existingWikiWord{:href => "/nlab/show/Xiao-Gang+Wen"}> Xiao-Gang Wen
                \:
                = succeed "," do
                  %em Topological and quantum order
                = succeed "," do
