          %title
          %p
            Co-founder of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ul
            %li
              %p
                %a{:href => "http://en.wikipedia.org/wiki/John_Henry_Schwarz"} Wikipedia entry
            %li
              %p
                %a{:href => "https://www.aip.org/history-programs/niels-bohr-library/oral-histories/45439"}> Interview by D. Zierler
                , AIP Oral History Interviews, July 2020
          %h2#selected_writings Selected writings
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/NSR+superstring"} NSR superstring
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Neveu"}> André Neveu
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
              = succeed "," do
                %em Factorizable dual model of pions
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0550-3213(71)90448-2"} doi:10.1016/0550-3213(71)90448-2
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Scherk-Schwarz+mechanism"} Scherk-Schwarz mechanism
          %ul
            %li#ScherkSchwarz79
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jo%C3%ABl+Scherk"}> Joël Scherk
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Spontaneous breaking of supersymmetry through dimensional reduction
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0370-2693(79)90425-8"} doi:10.1016/0370-2693(79)90425-8
            %li#ScherkSchwarz89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jo%C3%ABl+Scherk"}> Joël Scherk
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em How to get masses from extra dimensions
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/9789814542340_0083"} doi:10.1142/9789814542340_0083
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+superstring"} Green-Schwarz superstring
          %ul
            %li#GreenSchwarz81
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Supersymmetrical Dual String Theory
            %li#GreenSchwarz82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Supersymmetrical Dual String Theory. 2. Vertices and Trees
            %li#GreenSchwarz84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Covariant description of superstrings
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/193596"} spire:193596
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0370-2693(84)92021-5"} arXiv;10.1016/0370-2693(84)92021-5
            %li#GreenSchwarz84b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Properties of the Covariant Formulation of Superstring Theories
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/196623"} spire:196623
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(84)90030-0"} doi:10.1016/0550-3213(84)90030-0
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            of
            %a.existingWikiWord{:href => "/nlab/show/anomaly+cancellation"} anomaly cancellation
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
              = succeed "," do
                %em
                  Anomaly Cancellation in Supersymmetric
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mn 10
                      %annotation{:encoding => "application/x-tex"} D=10
                  Gauge Theory and Superstring Theory
              = succeed "," do
                %a{:href => "https://inspirehep.net/literature/15583"} spire:15583
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0370-2693(84)91565-X"} doi:10.1016/0370-2693(84)91565-X
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            and
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
            %a.existingWikiWord{:href => "/nlab/show/heterotic+superstring"} heterotic superstring
            to 6 dimensions (see also at
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/D%3D6+N%3D%281%2C0%29+SCFT"} D=6 N=(1,0) SCFT
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Green"}> Michael Green
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pete+West"} Pete West
              = succeed "," do
                %em Anomaly-free chiral theories in six dimensions
              %strong 254
              (1985) Pages 327-348 (
              %a{:href => "https://doi.org/10.1016/0550-3213(85)90222-6"}> doi:10.1016/0550-3213(85)90222-6
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/anomaly+cancellation"} anomaly cancellation
            in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+H.+Schwarz"}> John H. Schwarz
              ,
              %em Anomaly Cancellation: A Retrospective From a Modern Perspective
              (2001) &amp;lbrack;
              %a{:href => "https://doi.org/10.1142/9789812778185_0014"}> doi:10.1142/9789812778185_0014
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://cds.cern.ch/record/508470/files/0107059.pdf"} pdf
          %p
            Review of the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+superstring"} Green-Schwarz superstring
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ads
                    %mn 5
                  %mo ×
                  %msup
                    %mi S
                    %mn 5
                %annotation{:encoding => "application/x-tex"} Ads_5 \times S^5
            in light of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/AdS%2FCFT+correspondence"} AdS/CFT correspondence
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"}> John Schwarz
              ,
              %em
                The
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi AdS
                        %mn 5
                      %mo ×
