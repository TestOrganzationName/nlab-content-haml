                        %mi S
                        %mn 5
                    %annotation{:encoding => "application/x-tex"} AdS_5 \times S^5
                Superstring
              (
              %a{:href => "https://arxiv.org/abs/2004.09661"}> arXiv:2004.09661
              )
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/self-dual+string"} self-dual string
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"}> John Schwarz
              ,
              %em Self-Dual Superstring in Six Dimensions
