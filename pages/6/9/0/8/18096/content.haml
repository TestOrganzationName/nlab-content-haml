                      %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^{1/p}(X,\mu)
          %p
            (the unfortunate reciprocal in the grading is explained in the article
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+space"} Lebesgue space
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %strong normed
            *-algebra. That is, the canonical bilinear multiplication map
