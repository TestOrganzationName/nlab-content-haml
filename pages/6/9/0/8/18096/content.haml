          %p As a consequence, it implies that the canonical pairing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi L
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} L^{1/p}(X,\mu)\otimes L^{1/(1-p)}(X,\mu)\to L^1(X,\mu)\to \mathbf{C}
          %p
            exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^{1/(1-p)}(X,\mu)
            as the
            %a.existingWikiWord{:href => "/nlab/show/Banach+space"} Banach space
            dual of the
            %a.existingWikiWord{:href => "/nlab/show/Banach+space"} Banach space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^{1/p}(X,\mu)
          %h2#statements Statements
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \mu)
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measure+space"} measure space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} p \in \mathbf{C}
            a complex number with a nonnegative real part let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                %annotation{:encoding => "application/x-tex"} L^{1/p}
            denote
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^{1/p}(X, \mu)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with finite
            %a.existingWikiWord{:href => "/nlab/show/p-norm"} 1/p-norm
            modulo equality almost everywhere.
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ,
                  %mi q
                  %mo ,
                  %mi r
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} p,q,r\in \mathbf{C}
            have nonnegative real parts and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                    %mo =
                    %mi r
                  %annotation{:encoding => "application/x-tex"} p+q=r
            %strong Hölder’s inequality
            states that for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                  %annotation{:encoding => "application/x-tex"} f \in L^{1/p}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                %annotation{:encoding => "application/x-tex"} g \in L^{1/q}
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                  %mo ∈
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi r
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f g \in L^{1/r}(X,\mu)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ‖
                  %mi f
                  %mi g
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi r
                  %mo ≤
                  %mo{:stretchy => "false"} ‖
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo ⋅
                  %mo{:stretchy => "false"} ‖
                  %mi g
                  %msub
                    %mo{:stretchy => "false"} ‖
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %mo .
                %annotation{:encoding => "application/x-tex"} \|f g\|_{1/r}\le\|f\|_{1/p}\cdot \|g\|_{1/q}.
          %h2#duality Duality
          %p
            In particular, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} r=1
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mrow
                    %mo |
                    %mi f
                    %mi g
                    %mo |
                  %mo ≤
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi q
                %annotation{:encoding => "application/x-tex"} \int_X \left| f g \right| \leq {\|f\|_{1/p}} {\|g\|_{1/q}}
          %p
            (in particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            is an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn 1
                %annotation{:encoding => "application/x-tex"} L^1
            function).
          %p
            The “
            %a.existingWikiWord{:href => "/nlab/show/nPOV"}> nPOV
            ” meaning is this: in this situation there is a canonical pairing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, - \rangle
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                %annotation{:encoding => "application/x-tex"} L^{1/p}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi q
                  %annotation{:encoding => "application/x-tex"} L^{1/q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo ×
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %mo →
                  %mi ℂ
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} ⟨
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} ⟩
                  %mo ≔
                  %msub
                    %mo ∫
                    %mi X
                  %mi f
                  %mo ⋅
                  %mi g
                  %mo ,
                %annotation{:encoding => "application/x-tex"} L^{1/p} \times L^{1/q} \to \mathbb{C}: (f, g) \mapsto \langle f, g \rangle \coloneqq \int_X f \cdot g,
          %p which gives a bounded linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo ⊗
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} L^{1/p} \otimes L^{1/q} \to \mathbb{C}
          %p
            between Banach spaces. The point of Hölder’s inequality is that this pairing is a
            %em short
            map, i.e., a map of norm bounded above by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+closed+category"} symmetric monoidal closed category
            %a.existingWikiWord{:href => "/nlab/show/Ban"} Ban
            consisting of Banach spaces and short linear maps between them. Accordingly, the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo ⊗
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} L^{1/p} \otimes L^{1/q} \to \mathbb{C}
          %p
            induces (by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                %annotation{:encoding => "application/x-tex"} L^{1/p}
            to the Banach dual of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo −
                        %mi p
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^{1/(1-p)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} L^{1/p} \to (L^{1/q})^\ast \coloneqq [L^{1/q}, \mathbb{C}]
          %p
            (again a short map of course), and reciprocally a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi q
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} L^{1/q} \to (L^{1/p})^\ast
          %p
            It is a short step to prove that in fact the norm of the pairing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo ⊗
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} L^{1/p} \otimes L^{1/q} \to \mathbb{C}
            is
            %em exactly
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} L^{1/p} \to (L^{1/q})^\ast
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi q
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} L^{1/q} \to (L^{1/p})^\ast
            are in fact
            %a.existingWikiWord{:href => "/nlab/show/isometry"} isometric
            embeddings.
          %p
            If the real parts of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            are nonzero, then with a little more work (with the help of the
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Radon-Nikodym+theorem"} Radon-Nikodym theorem
            = succeed ")," do
              %a{:href => "https://www.math.ucdavis.edu/~hunter/measure_theory/measure_notes_ch7.pdf"} here
            %a.existingWikiWord{:href => "/nlab/show/surjective+map"} surjective
            and thus
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ban
                  %annotation{:encoding => "application/x-tex"} Ban
          .num_remark
            %h6#remark Remark
            %p
              It is true also that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi L
                        %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ≅
                      %msup
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} (L^1)^\ast \cong L^\infty
              %em but
              it is not true that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi L
                      %mn ∞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (L^\infty)^\ast
              is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} L^1
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ZFC"} ZFC
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dream+mathematics"} dream mathematics
          %h2#the_noncommutative_case The noncommutative case
          %p
            Remarkably,
            %a.existingWikiWord{:href => "/nlab/show/L%5Ep-spaces"} L^p-spaces
            can be defined for arbitrary
            %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebras"} von Neumann algebras
            (Haagerup, 1979) and the Hölder inequality continues to hold in this generality (Kosaki, 1984).
          %p
            The
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                  %annotation{:encoding => "application/x-tex"} L^{1/p}
            %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            over the underlying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
          %p
            If the real part of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is zero and the
            %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
            is commutative, than the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                %annotation{:encoding => "application/x-tex"} L^{1/p}
            is (noncanonically) isomorphic to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L^\infty
          %p
            In the noncommutative case this is no longer true, which is the starting point of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Tomita%E2%80%93Takesaki+theory"} Tomita–Takesaki theory
          %h2#proof_of_hlders_inequality_in_the_commutative_case Proof of Hölder’s inequality in the commutative case
          %p
            The proof is remarkably simple. First, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ,
                  %mi q
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} p, q \gt 0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mi p
                    %mo +
                    %mfrac
                      %mn 1
                      %mi q
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac1{p} + \frac1{q} = 1
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Young%27s+inequality"} Young's inequality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} a, b \gt 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi b
                  %mspace{:width => "thickmathspace"}
                  %mo ≤
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %msup
                        %mi a
                        %mi p
                    %mi p
                  %mo +
                  %mfrac
                    %mrow
                      %msup
                        %mi b
                        %mi q
                    %mi q
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  a b
                  \\;\leq\;
                  \\frac{a^p}{p}
                  +
                  \\frac{b^q}{q}
                  \\,,
          %p
            with equality precisely when
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mi p
                    %mo =
                    %msup
                      %mi b
                      %mi q
                  %annotation{:encoding => "application/x-tex"} a^p = b^q
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \leq t \leq 1
            implies
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mrow
                      %mi t
                      %mi x
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mi y
                  %mo ≤
                  %mi t
                  %msup
                    %mi e
                    %mi x
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo −
                  %mi t
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi e
                    %mi y
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  e^{t x + (1-t)y}
                  \\leq
                  t e^x + (1-t)e^y
                  \\,,
          %p
            where equality holds iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi x
                    %mo =
                    %msup
                      %mi e
                      %mi y
                  %annotation{:encoding => "application/x-tex"} e^x = e^y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %mfrac
                    %mn 1
                    %mi p
                %annotation{:encoding => "application/x-tex"} t = \frac{1}{p}
            and arrange
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                %annotation{:encoding => "application/x-tex"} x, y
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi x
                  %mo =
                  %msup
                    %mi a
                    %mi p
                %annotation{:encoding => "application/x-tex"} e^x = a^p
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi y
                    %mo =
                    %msup
                      %mi b
                      %mi q
                  %annotation{:encoding => "application/x-tex"} e^y = b^q
          %p
            Then, to prove
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} ⟨
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mi p
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi g
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mi q
                  %annotation{:encoding => "application/x-tex"} {|\langle f, g \rangle|} \leq {\|f\|_p} {\|g\|_q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                %annotation{:encoding => "application/x-tex"} f, g
            nonzero (so their norms are positive) and normalize them to unit vectors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mi p
                    %mo ,
                    %mi v
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi g
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mi q
                  %annotation{:encoding => "application/x-tex"} u = f/{\|f\|_p}, v = g/{\|g\|_q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi u
                    %mo{:stretchy => "false"} |
                  %mo ⋅
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi v
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} \int_X {|u|} \cdot {|v|} \leq 1.
          %p
            But since we are dealing with unit vectors, we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi u
                    %msup
                      %mo{:stretchy => "false"} |
                      %mi p
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \int_X {|u|^p} = 1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi X
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %msup
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \int_X {|v|^q} = 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi u
                    %mo{:stretchy => "false"} |
                  %mo ⋅
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi v
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %msub
                    %mo ∫
                    %mi X
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi u
                      %msup
                        %mo{:stretchy => "false"} |
                        %mi p
                    %mi p
                  %mo +
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %msup
                        %mo{:stretchy => "false"} |
                        %mi q
                    %mi q
                  %mo =
                  %mfrac
                    %mn 1
                    %mi p
                  %mo +
                  %mfrac
                    %mn 1
                    %mi q
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \int_X {|u|} \cdot {|v|} \leq \int_X \frac{|u|^p}{p} + \frac{|v|^q}{q} = \frac1{p} + \frac1{q} = 1
          %p and so the proof of Hölder’s inequality is complete.
          %p
            To prove that the norm of the pairing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, - \rangle
            is exactly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            (is not less than
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ∈
                  %msup
                    %mi L
                    %mi p
                %annotation{:encoding => "application/x-tex"} u \in L^p
            of norm
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi u
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} f = {|u|}
            is a nonnegative function of norm
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} /
                        %mi q
                  %annotation{:encoding => "application/x-tex"} g = f^{p-1} = f^{p/q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mi p
                  %mo =
                  %msup
                    %mi g
                    %mi q
                %annotation{:encoding => "application/x-tex"} f^p = g^q
            (almost) everywhere, where we then have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi g
                    %mo =
                    %mfrac
                      %mrow
                        %msup
                          %mi f
                          %mi p
                      %mi p
                    %mo +
                    %mfrac
                      %mrow
                        %msup
                          %mi g
                          %mi q
                      %mi q
                  %annotation{:encoding => "application/x-tex"} f g = \frac{f^p}{p} + \frac{g^q}{q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mi f
                  %mi g
                  %mo =
                  %msub
                    %mo ∫
                    %mi X
                  %mfrac
                    %mrow
                      %msup
                        %mi f
                        %mi p
                    %mi p
                  %mo +
                  %mfrac
                    %mrow
                      %msup
                        %mi g
                        %mi q
                    %mi q
                  %mo =
                  %mfrac
                    %mn 1
                    %mi p
                  %mo +
                  %mfrac
                    %mn 1
                    %mi q
                  %mo =
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} \int_X f g = \int_X \frac{f^p}{p} + \frac{g^q}{q} = \frac1{p} + \frac1{q} = 1.
          %p
            Actually these calculations do a little better: they show that upon
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msup
                          %mi L
                          %mi p
                      %mtd
                        %mo ⟶
                      %mtd
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi L
                          %mi q
                        %mo ,
                        %mi ℂ
                        %mo{:stretchy => "false"} ]
                    %mtr
                      %mtd
                        %mi f
                      %mtd
                        %mo ↦
                      %mtd
                        %mi λ
                        %mi g
                        %mo .
                        %mo{:stretchy => "false"} ⟨
                        %mi f
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  L^p
                  \&amp;\longrightarrow&amp;
                  [L^q, \mathbb{C}]
                  \\\
                  f
                  \&amp;\mapsto&amp;
                  \\lambda g. \langle f, g \rangle
                  \\end{array}
          %p
            preserves the norm, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi p
                %annotation{:encoding => "application/x-tex"} L^p
            %a.existingWikiWord{:href => "/nlab/show/isometry"} isometrically
            embeds into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi L
                      %mi q
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (L^q)^\ast
          %h2#properties Properties
          %h3#relation_to_minkowskis_inequality Relation to Minkowski’s inequality
          %p
            Recall that
            %a.existingWikiWord{:href => "/nlab/show/Minkowski%27s+inequality"} Minkowski's inequality
            is just the
            %a.existingWikiWord{:href => "/nlab/show/triangle+inequality"} triangle inequality
            in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-p+space"} L-p space
            %a.existingWikiWord{:href => "/nlab/show/functional+analysis"} functional analysis
            text, that allows one to deduce Minkowski’s inequality as a corollary of Hölder’s inequality. You can look it up for instance in the English Wikipedia,
            = succeed "." do
              %a{:href => "https://en.wikipedia.org/wiki/Minkowski_inequality"} here
          %p What seemingly most such presentations lack is motivation for the trick, so let us try to say something about this.
          %p
            First,
            %a.existingWikiWord{:href => "/nlab/show/Minkowski%27s+inequality"} Minkowski's inequality
            can be restated as asserting the convexity of the unit ball
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ∈
                  %msup
                    %mi L
                    %mi p
                  %mo :
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mi p
                  %mo ≤
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} B = \{f \in L^p: {\|f\|_p} \leq 1\}
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mi p
                  %annotation{:encoding => "application/x-tex"} L^p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi p
                %annotation{:encoding => "application/x-tex"} L^p
            = succeed "-valued" do
              %em real
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is the intersection of a collection of
            %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine
            half-spaces, say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi λ
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ∈
                  %msup
                    %mi L
                    %mi p
                  %mo :
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} H_\lambda = \{f \in L^p: \lambda(f) \leq 1\}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo :
                  %msup
                    %mi L
                    %mi p
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \lambda: L^p \to \mathbb{R}
            is a (continuous) linear functional. But with hindsight into the meaning of Hölder’s inequality, seen as paving the way to characterizing linear functionals on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi p
                %annotation{:encoding => "application/x-tex"} L^p
            as those of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ↦
                  %mo{:stretchy => "false"} ⟨
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda(g) = (f \mapsto \langle f, g \rangle)
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %msup
                      %mi L
                      %mi q
                  %annotation{:encoding => "application/x-tex"} g \in L^q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ′
                %annotation{:encoding => "application/x-tex"} B'
            of such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
