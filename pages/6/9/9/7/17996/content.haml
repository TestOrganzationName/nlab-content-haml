                                %mi F
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                        %mtd
                          %mi Fred
                          %mo{:stretchy => "false"} (
                          %mi.mathscript ℋ
                          %mo{:stretchy => "false"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcl}
                    S^2
                    \&amp;\overset{F_{(-)}}{\longrightarrow}&amp;
                    Fred(\mathscr{H})
                    \\mathrlap{\,,}
                    \\end{array}
            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/index+bundle"} index bundle
              represents the class of the basic line bundle in
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Atiyah-J%C3%A4nich+theorem"} Atiyah-Jänich theorem
            %div{:style => "margin: -40px 0px 20px 30px"}
              %img{:src => "/nlab/files/FredholmOperatorFromProjector-251013.jpg", :width => "180px"}/
            %p
              This is a Fredholm operator with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi P
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(F_P) = ker(P)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coker
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi P
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} coker(F_P) = 0
            %p
          %p
          #InEquivariantKTheory.num_remark
            %h6 Remark
            %p
              The first presentation in
              %a.maruku-eqref{:href => "#eq:SphereParameterizedHamiltonian"} (1)
              makes manifest that the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                    %mo ⟶
                    %mi End
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℂ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^2 \longrightarrow End(\mathbb{C}^2)
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(3)
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+map"} equivariant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(3)
              on the left and the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              by special unitary matrices in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2) \simeq Spin(3)
              on the right.
            %p
              From this it follows that also the corresponding parameterized Fredholm operator
              %a.maruku-eqref{:href => "#eq:AsAParameterizedFredholmOperator"} (2)
              is
              = succeed "-equivariant," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(3)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(3) \simeq SU(2)
              act on
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℂ
                      %mn 2
                    %mo ⊕
                    %msub
                      %mi ℓ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mi ℕ
                    %msup
                      %mi ℂ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{H}
                    \\,\simeq\,
                    \\mathbb{C}^2 \oplus \ell_2(\mathbb{N})
                    \\,\simeq\,
                    \\bigoplus_{\mathbb{N}} \mathbb{C}^2
            %p
              as the infinite direct sum of the defining representation of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
            %p
              The resulting
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(3)
              %a.existingWikiWord{:href => "/nlab/show/tautological+equivariant+line+bundle"} tautological equivariant line bundle
              in the
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S^2
