                    \-Sheaves on
                    = succeed "-Cohesive" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
                %li
                  %a{:href => "#aufhebung"} Aufhebung
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            An
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-cohesive site
            is a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            such that the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            over it is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          %h2#definition Definition
          #InfinityCohesiveSite.num_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-cohesive
              over
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              if it is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/strongly+%E2%88%9E-connected+site"} strongly ∞-connected site
              %li
                %p
                  and an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-local+site"} ∞-local site
            %p
              In detail this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/site"} site
                  – a
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  equipped with a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %li
                %p with the property that
                %ul
                  %li
                    %p
                      it has a
                      %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo *
                            %annotation{:encoding => "application/x-tex"} *
                  %li
                    %p
                      it is a
                      %a.existingWikiWord{:href => "/nlab/show/cosifted+category"} cosifted category
                    %p
                      (for instance in that it has all
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                      = succeed ");" do
                        %em
                          %a.existingWikiWord{:href => "/nlab/show/categories+with+finite+products+are+cosifted"} categories with finite products are cosifted
                  %li
                    %p
                      for every
                      %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                      family
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo →
                            %mi U
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
                      in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                          %annotation{:encoding => "application/x-tex"} C
                    %ul
                      %li
                        %p
                          the
                          %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                                %mo ∈
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi C
                                  %mi op
                                %mo ,
                                %mi sSet
                                %mo{:stretchy => "false"} ]
                              %annotation{:encoding => "application/x-tex"} C(U) \in [C^{op}, sSet]
                          is degreewise a
                          %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                          of
                          = succeed ";" do
                            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
                      %li
                        %p
                          the
                          %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                          obtained by replacing each copy of a representable by a point is
                          %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
                          (weakly equivalent to the point in the
                          = succeed ")" do
                            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                        .maruku-equation
                          %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ⟶
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                                %mover
                                  %mo →
                                  %mo ≃
                                %mo *
                              %annotation{:encoding => "application/x-tex"}
                                \\underset{\longrightarrow}{\lim} C(U) \stackrel{\simeq}{\to} *
                      %li
                        %p
                          the simplicial set of points in
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                              %annotation{:encoding => "application/x-tex"} C(U)
                          is weakly equivalent to the set of points of
                          = succeed ":" do
                            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                              %semantics
                                %mrow
                                  %mi U
                                %annotation{:encoding => "application/x-tex"} U
                        .maruku-equation
                          %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ⟵
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                                %mo =
                                %msub
                                  %mi Hom
                                  %mi C
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo ,
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                                %mover
                                  %mo →
                                  %mo ≃
                                %msub
                                  %mi Hom
                                  %mi C
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo ,
                                %mi U
                                %mo{:stretchy => "false"} )
                                %mspace{:width => "thinmathspace"}
                                %mo .
                              %annotation{:encoding => "application/x-tex"}
                                \\underset{\longleftarrow}{\lim}C(U)
                                \= Hom_C(*, C(U)) \stackrel{\simeq}{\to} Hom_C(*,U)
                                \\,.
          .num_remark
            %h6#remark Remark
            %p
              These conditions are stronger than for a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive site
            %p This definition is supposed to model the following ideas:
            %ul
              %li
                %p
                  every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  has an underlying set of points
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi C
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo ,
                          %mi U
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Hom_C(*,U)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  as specifying one way in which there can be cohesion on this underlying set of points;
              %li
                %p
                  in view of the
                  %a.existingWikiWord{:href => "/nlab/show/nerve+theorem"} nerve theorem
                  the condition that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi lim
                          %mo →
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lim_\to C(U)
                  is contractible means that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  itself is contractible, as seen by the
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                  %em local
                  aspect of cohesion: we only specify cohesive structure on contractible lumps of points;
              %li
                %p
                  in view of this, the remaining condition that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_C(*,C(U))
                  is contractible is the
                  = succeed "-analog" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  %a.existingWikiWord{:href => "/nlab/show/concrete+site"} concrete site
                  that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_C(*,\coprod_i U_i) \to Hom_C(*, U)
                  is surjective. This expresses that the notion of topology on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  and its concreteness over
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                  are consistent.
          %h2#examples Examples
          #Presheaves.num_example
            %h6#example Example
            %p
              The site for a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              = succeed "-cohesive," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %a.maruku-ref{:href => "#InfinityCohesiveSite"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
          .proof
            %h6#proof Proof
            %p
              All covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              consist of only the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi U
                      %mover
                        %mo →
                        %mi Id
                      %mi U
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U \stackrel{Id}{\to} U\}
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} {
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} C\{U\}
              is then the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              constant on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and hence satisfies its two conditions above trivially.
          .num_example
            %h6#example_2 Example
            %p
              The following
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              are
              = succeed "-cohesive," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed ":" do
                %a.maruku-ref{:href => "#InfinityCohesiveSite"}
            %ul
              %li
                %p
                  the category
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                  with covering families given by open covers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ↪
                        %mi U
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow U\}
                  by
                  %a.existingWikiWord{:href => "/nlab/show/geodesically+convex"} convex
                  subsets
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} U_i
                %p
                  we can take the morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi k
                        %mo →
                        %msup
                          %mi ℝ
                          %mi l
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^k \to \mathbb{R}^l
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CartSp
                      %annotation{:encoding => "application/x-tex"} CartSp
                  to be
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
                    %p
                      – in which case the sheaf topos over it models generalized
                      = succeed "s," do
                        %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                      %a.existingWikiWord{:href => "/nlab/show/2-sheaf"} 2-sheaf
                      %a.existingWikiWord{:href => "/nlab/show/2-topos"} 2-topos
                      contains for instance
                      = succeed "s;" do
                        %a.existingWikiWord{:href => "/nlab/show/topological+stack"} topological stack
                  %li
                    %p
                      or
                      %a.existingWikiWord{:href => "/nlab/show/smooth+maps"} smooth maps
                    %p
                      – in which case the sheaf topos models generalized
                      = succeed "s" do
                        %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
                      = succeed "s," do
                        %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                      %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
                      is that of
                      = succeed "s;" do
                        %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
              %li
                %p
                  the site
                  %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊂
                        %mi 𝕃
                      %annotation{:encoding => "application/x-tex"} \subset \mathbb{L}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
                  consisting of smooth loci of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi R
                          %mi n
                        %mo ×
                        %msubsup
                          %mi D
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mi l
                      %annotation{:encoding => "application/x-tex"} R^n \times D^l_{(k)}
                  with the second factor infinitesimal, where covering families are those of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ×
                        %msubsup
                          %mi D
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mi l
                        %mo →
                        %mi U
                        %mo ×
                        %msubsup
                          %mi D
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mi l
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \times D^l_{(k)} \to U \times D^l_{(k)}\}
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
                  a covering family in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CartSp
                      %annotation{:encoding => "application/x-tex"} CartSp
                  as above.
                %p
                  This is a site of definition for the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
            %p
              More discussion of these two examples is at
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
          .proof
            %h6#proof_2 Proof
            %p
              Since every
              %a.existingWikiWord{:href => "/nlab/show/star-shaped"} star-shaped
              region in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphic"} diffeomorphic
              to an
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              (see there for details) we have that the covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              on
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              by convex subsets are
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              in the strong sense that any finite non-empty intersection is
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphic"} diffeomorphic
              to an
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              and hence diffeomorphic to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(U)
              are degreewise coproducts of representables.
            %p
              The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \lim_\to C(U) \simeq *
              follows from the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/nerve+theorem"} nerve theorem
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
          %h2#Properties Properties
          %h3#sheaves_on_cohesive_sites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Sheaves on
            = succeed "-Cohesive" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be an
              = succeed "-cohesive" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              that satisfies the axiom “discrete objects are concrete” .
            %p
              If moreover for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(*,U)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-topos"} (n,1)-topos
            over a site for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            arises as the full
            %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
            of the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
            objects and since the definition of cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,1)
          .num_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be an
              = succeed "-cohesive" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-topos"} (n,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(n,1)}(C)
              is cohesive.
          %p To prove this, we need to show that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
                is a
                %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
                and a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
              %p
                This follows with the discussion at
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+site"} ∞-connected site
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local (∞,1)-topos
              %p
                This follows with the discussion at
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-local+site"} ∞-local site
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo :
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \Pi : Sh_{(\infty,1)}(C) \to \infty Grpd
                preserves finite
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-products"} (∞,1)-products
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma(U)
                is not empty for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U \in C
                %em pieces have points
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Sh
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
          %p The last two conditions we demonstrate now.
          .num_prop
            %h6#proposition Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi : Sh_{(\infty,1)}(C) \to \infty Grpd
              whose existence is guaranteed by the above proposition preserves
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(A \times B) \simeq \Pi(A) \times \Pi(B)
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+site"} ∞-connected site
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mo →
                      %mo :
                      %msub
                        %mi PSh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \lim_\to : PSh_{(\infty,1)}(C) \to \infty Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cosifted+%28%E2%88%9E%2C1%29-category"} cosifted (∞,1)-category
          %p
            Finally we prove that
            %em pieces have points
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
            if all objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            have points.
          .proof
            %h6#proof_4 Proof
            %p
              By the above discussion both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              are presented by left Quillen functors on the projective model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any simplicial presheaf that a cofibrant replacement is given by an object that in the lowest two degrees is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mover
                        %mo →
                        %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                        %mo →
                        %msub
                          %mi U
                          %mn 1
                        %mo →
                        %msub
                          %mi X
                          %mn 1
                    %mi U
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi U
                        %mo →
                        %msub
                          %mi X
                          %mn 0
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\stackrel{\to}{\stackrel{\to}{\to}}
                    \\coprod_{U_0 \to U_1 \to X_1} U
                    \\stackrel{\to}{\to}
                    \\coprod_{U \to X_0} U
                    \\,,
            %p
              where the coproduct is over all morphisms out of representable presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              as indicated.
            %p
              The model for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              sends this to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mover
                        %mo →
                        %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                        %mo →
                        %msub
                          %mi U
                          %mn 1
                        %mo →
                        %msub
                          %mi X
                          %mn 0
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %msub
                      %mi U
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi U
                        %mo →
                        %msub
                          %mi X
                          %mn 0
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\stackrel{\to}{\stackrel{\to}{\to}}\coprod_{U_0 \to U_1 \to X_0} C(*,U_0)
                    \\stackrel{\to}{\to}
                    \\coprod_{U \to X_0} C(*,U)
                    \\,,
            %p
              whereas the model for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              sends this to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mover
                        %mo →
                        %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                        %mo →
                        %msub
                          %mi U
                          %mn 1
                        %mo →
                        %msub
                          %mi X
                          %mn 0
                    %mo *
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi U
                        %mo →
                        %msub
                          %mi X
                          %mn 0
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\stackrel{\to}{\stackrel{\to}{\to}}\coprod_{U_0 \to U_1 \to X_0} *
                    \\stackrel{\to}{\to}
                    \\coprod_{U \to X_0} *
                    \\,.
            %p
              The morphism from the first to the latter is the evident one that componentwise sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
