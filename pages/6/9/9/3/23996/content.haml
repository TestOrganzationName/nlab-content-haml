                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} X \subset \mathbb{R}
            is an
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            (closed or open, such as the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            itself) and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
            %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
            in
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            degree is necessarily trivial,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
