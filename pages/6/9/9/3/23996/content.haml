                    %mi r
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\pi^n_{(f,r)}
                  \\;\coloneqq\;
                  image(\delta_r)
                  \\;\simeq\;
                  \\Big\{
                  [g/A_r]
                  \\,\in\,
                  \\pi^n(X/A_r)
                  \\,\big\vert\,
                  (X, A_r) \xrightarrow{ \exists \, g } (\mathbb{R}^n,\, \mathbb{R}^n \setminus B_r)
                  \\Big\}
                  \\,,
          %p
            hence that subgroup of the
            = succeed "-cohomotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi A
                    %mi r
                %annotation{:encoding => "application/x-tex"} X/A_r
            whose elements may be represented by
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            defined on all of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Notice that the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            itself canonically represents an element
          #eq:FunctionAsClassInThePersistenceCohomotopyRelativeToIt.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi r
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi π
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [f]_r
                  \\;\in\;
                  \\pi^n_{(f,r)}(X)
          %p
            which provides a base point, making this a
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            group.
          %p
            Moreover, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mn 1
                  %mo ≤
                  %msub
                    %mi r
                    %mn 2
                %annotation{:encoding => "application/x-tex"} r_1 \leq r_2
            we have the evident inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mrow
                      %msub
                        %mi r
                        %mn 2
                  %mover
                    %mo ↪
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi i
                        %mrow
                          %msub
                            %mi r
                            %mn 1
                          %mo ,
                          %msub
                            %mi r
                            %mn 2
                      %mspace{:width => "thickmathspace"}
                  %msub
                    %mi A
                    %mrow
                      %msub
                        %mi r
                        %mn 1
                %annotation{:encoding => "application/x-tex"}
                  A_{r_2} \xhookrightarrow{\; i_{r_1, r_2} \;}  A_{r_1}
          %p
            and thus a canonical comparison
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            of pointed groups:
