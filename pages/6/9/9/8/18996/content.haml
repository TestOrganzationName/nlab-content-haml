            %h6#example Example
            %p
              %strong (H-cohomology of odd symplectic form)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
              in degrees 0 and 1 and equipped with a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              of odd coordinate degree (e.g. the symplectic form on a
              %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
              when regarded as a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
            %p
              Then every H-cohomology-class (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HCohomologyInGradedCommutativeAlgebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} H = \omega
              has a unique representative which on any
              %a.existingWikiWord{:href => "/nlab/show/local+coordinate+chart"} local coordinate chart
              of
              %a.existingWikiWord{:href => "/nlab/show/Darboux+coordinates"} Darboux coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
