            %h6#definition_2 Definition
            %p
              %strong (H-cohomology)
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              or
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifold"} formal smooth manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/differential+3-form"} differential 3-form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H \in \Omega^3(X)
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a nilpotent operation, and hence defines the
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              of a
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
              whose entries are the
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mi even
                        %mo{:stretchy => "false"} /
                        %mi odd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{even/odd}(X)
              of all odd-graded or all even-graded
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi Ω
                      %mi even
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi H
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Ω
                      %mi odd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi H
                        %mo ∧
