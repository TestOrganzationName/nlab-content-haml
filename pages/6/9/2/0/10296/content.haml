              = succeed "," do
                %em
                  Dual pairs of Hopf
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
              %a{:href => "https://doi.org/10.1112/blms/25.3.209"} doi
          %p Hit-actions are recently studied in
          %ul
            %li
              M. Cohen, S. Westreich,
              = succeed "," do
                %em Hit-actions and commutators for Hopf algebras
              = succeed "(104)" do
                %strong 56
              %a{:href => "http://ssmr.ro/bulletin/pdf/56-3/articol_4.pdf"} pdf
          %p
            %a.existingWikiWord{:href => "/nlab/show/Cartier+duality"} Cartier duality
            and related earlier issues on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/linearly+compact+vector+space"} linearly compact vector space
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean+Dieudonn%C3%A9"}> Jean Dieudonné
              ,
              = succeed "," do
                %em Introduction to the theory of formal groups
          %p Some newer applications are in
          %ul
            %li
              Lowell Abrams,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"} Charles Weibel
              = succeed "," do
                %em Cotensor products of modules
              %a{:href => "https://arxiv.org/abs/math/9912211"} math.RA/9912211
          %p Duality of dg-algebras vs. dg-coalgebras is studied recently in great detail in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mathieu+Anel"}> Mathieu Anel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} André Joyal
              = succeed "," do
                %em Sweedler Theory for (co)algebras and the bar-cobar constructions
              = succeed ";" do
                %a{:href => "https://arxiv.org/abs/1309.6952"} arxiv/1309.6952
              %a{:href => "http://thales.math.uqam.ca/~anelm/mat/doc/boston.pdf"} slides
          %p Some special cases of finite duals are treated in
          %ul
            %li
              Stephen Donkin,
              = succeed "," do
                %em On the Hopf algebra dual of an enveloping algebra
              %a{:href => "https://doi.org/10.1017/S0305004100059260"} doi
            %li
