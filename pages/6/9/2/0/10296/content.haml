          %h2#literature Literature
          %p
            Related
            = succeed "Lab" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dual"} dual
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+double"} Heisenberg double
            %a.existingWikiWord{:href => "/nlab/show/gebra"} gebra
          %p Quite detailed treatment of duality of gebras is in
          %ul
            %li
              Sorin Dăscălescu, Constantin Năstăsescu, Serban Raianu,
              = succeed "," do
                %em Hopf algebras: an introduction
          %p
            and the entire Chapter VI (titled
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} ()^\circ
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Moss+E.+Sweedler"}> Moss E. Sweedler
              ,
              = succeed "," do
                %em Hopf algebras
          %p Other sources are
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Susan+Montgomery"}> Susan Montgomery
              ,
              = succeed "," do
                %em Hopf algebras and their actions on rings
            %li
              %a.existingWikiWord{:href => "/nlab/show/Shahn+Majid"}> Shahn Majid
              ,
              = succeed "," do
                %em Foundations of quantum group theory
            %li
              Eiichi Abe,
              = succeed "," do
                %em Hopf algebras
          %p and for gebras with involution
          %ul
            %li
