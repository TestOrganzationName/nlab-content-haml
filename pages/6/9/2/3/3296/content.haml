              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern+classes"}> Chern classes
                ,
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd+Chern+classes"} Conner-Floyd Chern classes
              %p
                %a.existingWikiWord{:href => "/nlab/show/Todd+class"}> Todd class
                ;
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G = \mathbf{B}U(1)
                the
                = succeed ":" do
