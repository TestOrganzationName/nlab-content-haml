                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^n(B G, A) = \pi_0 \mathbf{H}(B G, B^n A)
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            with coefficients in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo :
                  %mi B
                  %mi G
                  %mo →
                  %msup
                    %mi B
                    %mi n
                  %mi A
                %annotation{:encoding => "application/x-tex"} k : B G \to B^n A
            represents a characteristic class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
