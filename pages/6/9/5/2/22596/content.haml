          %h2#natural_numbers Natural numbers
          %h3#as_a_free_monoid As a free monoid
          %p
            Define a set of digits
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mo *
                %annotation{:encoding => "application/x-tex"} D^*
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            with unit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mo *
                %annotation{:encoding => "application/x-tex"} D^*
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mo *
                  %mo ,
                  %mi ϵ
                  %mo ,
                  %mi s
                %annotation{:encoding => "application/x-tex"} D^*,\epsilon,s
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
          %h3#long_division_algorithm Long division algorithm
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 9
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                %annotation{:encoding => "application/x-tex"} [0, 9]^*
            be the
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoid
            on the
            %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 9
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0, 9]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} len
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 9
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{len}:[0, 9]^* \to \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 9
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f:[0, 9]^* \to \mathbb{N}
            defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mrow
                      %mi{:mathvariant => "normal"} len
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mn 1
                  %msub
                    %mi a
                    %mi i
                  %msup
                    %mn 10
                    %mrow
                      %mi{:mathvariant => "normal"} len
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi i
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} f(a) \coloneqq \sum_{i = 0}^{\mathrm{len}(a) - 1} a_i 10^{\mathrm{len}(a) - i - 1}
          %p representing the numerical value of the list of digits.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/algorithm"} algorithm
            is as follows: Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 9
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                %annotation{:encoding => "application/x-tex"} a:[0, 9]^*
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 9
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                %annotation{:encoding => "application/x-tex"} b:[0, 9]^*
            be lists of digits, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(a)
            the dividend and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(b)
            the divisor. If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{len}(a) \lt \mathrm{len}(b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ÷
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(a) \div f(b) = 0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi %
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(a)\ \%\ f(b) = f(a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} len
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{len}(a)
            times before stopping:
          %p
            For each iteration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} i:[0, \mathrm{len}(a)]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mi i
                %annotation{:encoding => "application/x-tex"} q_i
            be the quotient extracted from the algorithm at iteration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                %annotation{:encoding => "application/x-tex"} d_i
            be the dividend at iteration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"} r_i
            be the remainder at iteration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi i
                %annotation{:encoding => "application/x-tex"} c_i
            be the next digit of the quotient, with the restriction that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≤
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"} 0 \leq r_i
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi i
                  %mo &lt;
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} r_i \lt f(b)
          %p We set initial conditions to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ≔
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q_{-1} \coloneqq 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ≔
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mrow
                      %mi{:mathvariant => "normal"} len
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mn 2
                  %msub
                    %mi a
                    %mi i
                  %msup
                    %mn 10
                    %mrow
                      %mi{:mathvariant => "normal"} len
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi i
                      %mo −
                      %mn 2
                %annotation{:encoding => "application/x-tex"} r_{-1} \coloneqq \sum_{i = 0}^{\mathrm{len}(b) - 2} a_i 10^{\mathrm{len}(b) - i - 2}
          %p The successive conditions are defined inductively as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ≔
                  %mn 10
                  %msub
                    %mi r
                    %mi i
                  %mo +
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mo +
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} len
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d_{i + 1} \coloneqq 10 r_i + a_{i + \len(b)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ≔
                  %msub
                    %mi d
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo −
                  %mi m
                  %msub
                    %mi c
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo =
                  %mn 10
                  %msub
                    %mi r
                    %mi i
                  %mo +
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mo +
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} len
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                  %mo −
                  %mi m
                  %msub
                    %mi c
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} r_{i + 1} \coloneqq d_{i + 1} - m c_{i + 1} =  10 r_i + a_{i + \len(b)} - m c_{i + 1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ≔
                  %mn 10
                  %msub
                    %mi q
                    %mi i
                  %mo −
                  %msub
                    %mi c
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} q_{i + 1} \coloneqq 10 q_{i} - c_{i + 1}
          %h2#order_theoretic_definitions Order theoretic definitions
          %h3#integers Integers
          %p work in progress…
          %h3#finite_decimals Finite decimals
          %p See below, but define in terms of an initial algebra instead of a terminal coalgebra.
          %h3#infinite_decimals Infinite decimals
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/intervals"} intervals
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Int
                  %annotation{:encoding => "application/x-tex"} Int
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi Int
                  %mo →
                  %mi Int
                %annotation{:encoding => "application/x-tex"} F: Int \to Int
          %p
            be the endofunctor which takes an interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi i
                        %mo &lt;
                        %mn 10
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \bigvee_{0 \leq i \lt 10} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and identifying the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            of the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            of the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi i
                    %mo &lt;
                    %mn 10
                  %annotation{:encoding => "application/x-tex"} 0 \lt i \lt 10
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 1]
            becomes a coalgebra if we identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo &lt;
                      %mn 10
                  %mi X
                %annotation{:encoding => "application/x-tex"} \bigvee_{0 \leq i \lt 10} X
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 10
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 10]
            and consider the multiplication-by-10 map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 10
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 1] \to [0, 10]
            as giving a coalgebra structure.
          .num_theorem
            %h6#theorem Theorem
            %p
              The interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0, 1]
              is terminal in the category of such coalgebras.
          .proof
            %h6#proof_sketch Proof (sketch)
            %p
              Given any coalgebra structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mn 0
                          %mo ≤
                          %mi i
                          %mo &lt;
                          %mn 10
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f: X \to \bigvee_{0 \leq i \lt 10} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
              lands either in the
              = succeed "-th" do
