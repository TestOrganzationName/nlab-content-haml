                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            of
            %strong
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            is the initial such system. By
            %a.existingWikiWord{:href => "/nlab/show/uncurrying"} uncurrying
            the function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi ℤ
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} i:\mathbb{Z} \times [0,1]\to \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℤ
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} (a,b):\mathbb{Z} \times [0,1]
            is called an
            = succeed "," do
              %strong infinite decimal representation
            %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
            in
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            or
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            is literally the
            %strong decimal separator
            commonly seen in non-English speaking countries.
          %p
            The arithmetic operations and topological properties on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            can be defined by the properties of the
            %a.existingWikiWord{:href => "/nlab/show/function+algebra"} function algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
          %h2#rig_theoretic_definitions Rig theoretic definitions
          %h3#integers_2 Integers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo ≅
                  %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mn 10
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∶−
                  %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo =
                  %mn 10
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \cong \mathbb{N}[10] \coloneq \mathbb{N}[x]/(x=10)
          %h3#finite_decimals_2 Finite decimals
          %p
            Localisation of the
            %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            of natural numbers at 10
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}[1/10]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}[1/10]
            %a.existingWikiWord{:href => "/nlab/show/group+completion"} group completion
            of the additive monoid to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/10]
          %h3#infinite_decimals_2 Infinite decimals
          %p
            %a.existingWikiWord{:href => "/nlab/show/function+algebra"} Sequence algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo →
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{N}\to\mathbb{Z}[1/10]
            and
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequences"} Cauchy sequences
          %h2#doubly_infinite_decimals Doubly infinite decimals
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/10\mathbb{Z}
            be the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            consisting of 10 elements, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} C_\bullet
            be a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            consisting of a sequence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/10\mathbb{Z}
            indexed by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} i:\mathbb{Z}
            are called
            = succeed "," do
              %strong place values
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %a.existingWikiWord{:href => "/nlab/show/cochains"} cochains
            are called
            = succeed "." do
              %strong digits
          %p
            A
            %strong 10-adic number
            is a cochain such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} c_i = 0
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo &lt;
                  %mi j
                %annotation{:encoding => "application/x-tex"} i \lt j
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %mn 9
                %annotation{:encoding => "application/x-tex"} c_i = 9
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo &lt;
                  %mi j
                %annotation{:encoding => "application/x-tex"} i \lt j
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} i,j:\mathbb{Z}
            %strong 10-adic integer
            is a cochain such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} c_i = 0
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo &lt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} i \lt 0
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %mn 9
                %annotation{:encoding => "application/x-tex"} c_ i = 9
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i \lt 0
            %strong real number
            is a cochain such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %msub
                    %mi c
                    %mi j
                %annotation{:encoding => "application/x-tex"} c_i = c_j
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo &gt;
                  %mi k
                %annotation{:encoding => "application/x-tex"} i \gt k
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo &gt;
                  %mi k
                %annotation{:encoding => "application/x-tex"} j \gt k
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ,
                    %mi k
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} i,j,k:\mathbb{Z}
            %strong decimal rational
            is a real 10-adic number, and an
            %strong integer
            is a real 10-adic integer.
          %h3#solenoid 10-adic solenoids
          %p
            The cochain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} C_\bullet
            defined in the previous section has a structure of an abelian group, making it into a
            = succeed "." do
              %strong
                10-adic
                %a.existingWikiWord{:href => "/nlab/show/solenoid"} solenoid
          %p
            A cyclic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            has a canonical
            %a.existingWikiWord{:href => "/nlab/show/cyclic+order"} cyclic order
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ×
                    %mi G
                    %mo ×
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} [(-),(-),(-)]:(G \times G \times G) \to \Omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/10\mathbb{Z}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mi n
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0,n,1]
            is false for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n:\mathbb{Z}/10\mathbb{Z}
          %p
            For each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} i:\mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi i
                  %mo ×
                  %msub
                    %mi C
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} f_i: (C_i \times C_i) \to C_{i + 1}
            called the
            %strong digitwise carry
            function at place value
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo :
                    %msub
                      %mi C
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a,b:C_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f_i(a,b) = 0
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mn 0
                  %mo ,
                  %mi a
                  %mo +
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,0,a+b]
            is false, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} f_i(a,b) = 1
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mn 0
                  %mo ,
                  %mi a
                  %mo +
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,0,a+b]
            is true.
          %p
            We define the
            %strong addition without carry
            on the cochain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mo •
                  %mo ×
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} (-)\oplus(-): (C_\bullet \times C_\bullet) \to C_\bullet
            as the addition of all digits using the abelian group operation, and we define the
            %strong carry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi carry
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mo •
                  %mo ×
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} carry: (C_\bullet \times C_\bullet) \to C_\bullet
            as the digitwise carry of all digits. Then,
            %strong addition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mo •
                  %mo ×
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} (-)+(-): (C_\bullet \times C_\bullet) \to C_\bullet
            is defined
            %a.existingWikiWord{:href => "/nlab/show/recursion"} recursively
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi b
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ⊕
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi carry
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a+b = (a\oplus b)+carry(a,b)
          %p
            The cochains consisting of all
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} n:\mathbb{Z}/10\mathbb{Z}
            are additive
            %a.existingWikiWord{:href => "/nlab/show/identity+elements"} identity elements
            of the addition operation defined above. As such, they are algebraically equal to the same chain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %strong zero
            %strong negation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi C
                    %mo •
                  %mo →
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} -(-): C_\bullet \to C_\bullet
            such that for all chains
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} c:C_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi c
                %annotation{:encoding => "application/x-tex"} -c
            are
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo =
                    %mn 9
                    %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi c
                      %mi i
                  %annotation{:encoding => "application/x-tex"} (-c)_i = 9 + -c_i
          %h3#analytic_completion Analytic completion of Laurent series
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            %strong one
            denote the cochain with all digits equal to zero except at place value
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is called the
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              \-th power of ten
            and is denoted as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 10
                      %mi i
                  %annotation{:encoding => "application/x-tex"} 10^i
          %p
            Let us define an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi act
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℕ
                    %mo +
                  %mo ×
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} act: (\mathbb{N}^+\times C_\bullet) \to C_\bullet
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi act
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} act(0,0) = 0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi act
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi act
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi c
                %annotation{:encoding => "application/x-tex"} act(n + 1,c) = act(n,c) + c
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                %annotation{:encoding => "application/x-tex"} n:\mathbb{N}^+
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} c:C_\bullet
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            One could also establish a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/10\mathbb{Z}
            and construct a multiplication operation on the chain complex such that the chain complex itself with the defined abelian group structure and multiplication should be equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
            of the
            %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mn 10
                    %mo{:stretchy => "false"} )
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %msup
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[[x,x^{-1}]]/(x-10)\mathbb{Z}[[x,x^{-1}]]
