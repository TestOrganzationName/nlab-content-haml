                    \\\
                    0 &amp;\to&amp; Z_{n-1} A &amp;\stackrel{f}{\to}&amp; Z_{n-1} B &amp;\stackrel{g}{\to}&amp; Z_{n-1} C
                    }
            %p
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequences"} exact sequences
              %a.existingWikiWord{:href => "/nlab/show/snake+lemma"} snake lemma
              to this, once more, yields the desired long exact sequence.
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              of the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
              induced from short exact sequences of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi A
                      %mrow
                        %mi n
                        %mi tor
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi n
                    %mi A
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A/A_{n tor} \stackrel{(-)\cdot n}{\to} A \to A/(n A)
            %p
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Bockstein+homomorphism"} Bockstein homomorphism
          %h2#properties Properties
          %h3#relation_to_homotopy_fiber_sequences Relation to homotopy fiber sequences
          %p
            The connecting homomorphism in a
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
            induced from a short exact sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                  %mover
                    %mo →
                    %mi f
                  %msub
                    %mi B
                    %mo •
                  %mo →
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} A_\bullet \stackrel{f}{\to} B_\bullet \to C_\bullet
            is equivalently the image under the
            %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
            functor of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
            induced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %em
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
            in the section
            = succeed "." do
              %em
                %a{:href => "mapping+cone#HomologyExactSequencesAndFiberSequences"} homology exact sequences
