                        %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#for_long_cohomology_exact_sequences"} For long (co)homology exact sequences
              %ul
                %li
                  %a{:href => "#OnHomologyInTermsOfElements"} In terms of elements
                %li
                  %a{:href => "#OnHomologyGeneralAbstract"} General abstract
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#relation_to_homotopy_fiber_sequences"} Relation to homotopy fiber sequences
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Generally, a
            %em connecting homomorphism
            is a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of the kind produced by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/snake+lemma"} snake lemma
          %p
            Specifically, when the
            %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            that goes into the snake lemma is regarded as part of a
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                  %mo →
                  %msub
                    %mi B
                    %mo •
                  %mo →
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} A_\bullet \to B_\bullet \to C_\bullet
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi n
                  %mo :
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta_n : H_n(C) \to H_{n-1}(A)
            on the
            %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
            of these chain complexes which exhibit the corresponding
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi δ
                        %mi n
                  %msub
                    %mi H
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to
                  H_n(A) \to H_n(B) \to H_n(C)
                  \\stackrel{\delta_n}{\to}
                  H_{n-1}(A) \to H_{n-1}(B) \to H_{n-1}(C)
                  \\to
                  \\cdots
                  \\,.
          %p
            This long exact sequence is the image under
            %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"}
                  H_0(-) : Ch_\bullet(\mathcal{A}) \to \mathcal{A}
          %p
            of the long
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            of chain complexes induced by the short exact sequence. Hence the connecting homomorphism is the image under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(-)
            of a
            %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
            inclusion on chain complexes.
          %h2#for_long_cohomology_exact_sequences For long (co)homology exact sequences
          %p
            In the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo ≃
                  %mi R
                %annotation{:encoding => "application/x-tex"} \mathcal{A} \simeq R
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            for some
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/homology+long+exact+sequences"} homology long exact sequences
            is easily described in terms of elements and checking its properties is elementary, see
            %em
              %a{:href => "#OnHomologyInTermsOfElements"} In terms of elements
            below. By the
            %a{:href => "abelian%20category#EmbeddingTheorems"} embedding theorems
            the general case can be reduced to this case. But there is also a general abstract description without recourse to elements, which we discuss further below in
            %em
              %a{:href => "#OnHomologyGeneralAbstract"} General abstract construction
            \.
          %h3#OnHomologyInTermsOfElements In terms of elements
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo =
                  %mi R
                %annotation{:encoding => "application/x-tex"} \mathcal{A} = R
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
            for the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mo •
                  %mover
                    %mo →
                    %mi i
                  %msub
                    %mi B
                    %mo •
                  %mover
                    %mo →
                    %mi p
                  %msub
                    %mi C
                    %mo •
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  0 \to A_\bullet \stackrel{i}{\to} B_\bullet \stackrel{p}{\to}  C_\bullet \to 0
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
          #ConnectingForHomologyInComponents.num_defn
            %h6#definition Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi n
                    %mo :
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_n : H_n(C) \to H_{n-1}(A)
                    \\,,
            %p
              called the
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                th connecting homomorphism
              of the short exact sequence, by sending
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi n
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_n : [c] \mapsto [\partial^B \hat c]_A
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %msub
                          %mi Z
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} c \in Z_n(C)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
                  representing a given
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ^
                        %mo ∈
                        %msub
                          %mi C
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat c \in C_n(B)
                  is any lift of that cycle to an element in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi B
                            %mi n
                        %annotation{:encoding => "application/x-tex"} B_n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
                  (but which no longer needs to be a cycle itself);
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mo ∂
                          %mi B
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ^
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi A
                      %annotation{:encoding => "application/x-tex"} [\partial^B \hat c]_A
                  is the
                  = succeed "-homology" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi B
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \partial^B \hat c
                  which is indeed in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ↪
                        %msub
                          %mi B
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} A_{n-1} \hookrightarrow B_{n-1}
                  by exactness (since
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∂
                            %mi B
                          %mover
                            %mi c
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msup
                            %mo ∂
                            %mi C
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi c
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msup
                            %mo ∂
                            %mi C
                          %mi c
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} p(\partial^B \hat c) = \partial^C p(\hat c) = \partial^C c = 0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Z
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %msub
                          %mi A
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} Z_{n-1}(A) \hookrightarrow A_{n-1}
                  since
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mo ∂
                            %mi A
                          %msup
                            %mo ∂
                            %mi B
                          %mover
                            %mi c
                            %mo{:stretchy => "false"} ^
                          %mo =
                          %msup
                            %mo ∂
                            %mi B
                          %msup
                            %mo ∂
                            %mi B
                          %mover
                            %mi c
                            %mo{:stretchy => "false"} ^
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \partial^A \partial^B \hat c = \partial^B \partial^B \hat c = 0
          .num_prop
            %h6#proposition Proposition
            %p
              Def.
              %a.maruku-ref{:href => "#ConnectingForHomologyInComponents"}
              is indeed well defined in that the given map is independent of the choice of lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat c
              involved and in that the group structure is respected.
          .proof
            %h6#proof Proof
            %p
              To see that the constructon is well-defined, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                    %mo ∈
                    %msub
                      %mi B
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \tilde c \in B_{n}
              be another lift. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo −
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p(\hat c - \tilde c) = 0
              and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo −
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ˜
                      %mo ∈
                      %msub
                        %mi A
                        %mi n
                      %mo ↪
                      %msub
                        %mi B
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \hat c - \tilde c \in A_n \hookrightarrow B_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi A
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi A
                  %annotation{:encoding => "application/x-tex"} [\partial^B\hat c]_A \simeq [\partial^B \tilde c]_A
              since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo −
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mo ∂
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo −
                      %msup
                        %mo ∂
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"}
                      \\partial^A(\hat c - \tilde c)
                      \=
                      \\partial^B \hat c - \partial^B \tilde c
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \delta_n
              is a group homomorphism, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [c] = [c_1] + [c_2]
              be a sum. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ≔
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo +
                    %msub
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat c \coloneqq \hat c_1 + \hat c_2
              is a lift and by linearity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mo ∂
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi A
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msup
                        %mo ∂
                        %mi B
                      %msub
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo +
                      %mo{:stretchy => "false"} [
                      %msup
                        %mo ∂
                        %mi B
                      %msub
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ^
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\partial^B \hat c]_A = [\partial^B \hat c_1] + [\partial^B \hat c_2]
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Under
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_\bullet(-)
              the morphisms in the short exact sequence together with the connecting homomorphisms yield the
              %a.existingWikiWord{:href => "/nlab/show/homology+long+exact+sequence"} homology long exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi δ
                          %mi n
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    H_n(A) \to H_n(B) \to H_n(C)
                    \\stackrel{\delta_n}{\to}
                    H_{n-1}(A) \to H_{n-1}(B) \to H_{n-1}(C)
                    \\to
                    \\cdots
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Consider first the exactness of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi H
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi H
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      H_n(A) \stackrel{H_n(i)}{\to} H_n(B)
                      \\stackrel{H_n(p)}{\to} H_n(C)
            %p
              It is clear that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in Z_n(A) \hookrightarrow Z_n(B)
              then the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [a] \in H_n(B)
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                      %mo ∈
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [p(a)] = 0 \in H_n(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [b] \in H_n(B)
              is in the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_n(p)
              if there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} c \in C_{n+1}
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi C
                      %mi c
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial^C c = p(b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is surjective let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat c \in B_{n+1}
              be any lift, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo −
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [b] =  [b - \partial^B \hat c]
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo −
                    %msup
                      %mo ∂
                      %mi B
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p(b - \partial^B c) = 0
              hence by exactness
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo −
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b - \partial^B \hat c \in Z_n(A) \hookrightarrow Z_n(B)
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [b]
              is in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_n(A) \to H_n(B)
            %p It remains to see that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_n(B) \to H_n(C)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi δ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \delta_n
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi H
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_{n-1}(A) \to H_{n-1}(B)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi δ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \delta_n
            %p
              This follows by inspection of the formula in def.
              = succeed "." do
                %a.maruku-ref{:href => "#ConnectingForHomologyInComponents"}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [c]
              is in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_n(B) \to H_n(C)
              we have a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat c
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial^B \hat c = 0
              and so
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi n
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msup
                        %mo ∂
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi A
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \delta_n[c] = [\partial^B \hat c]_A  = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat c
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi A
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [\partial^B \hat c]_A = 0
              this means there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} a \in A_n
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi A
                      %mi a
                      %mo ≔
                      %msup
                        %mo ∂
                        %mi B
                      %mi a
                      %mo =
                      %msup
                        %mo ∂
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \partial^A a \coloneqq \partial^B a = \partial^B \hat c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                    %mo ≔
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo −
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \tilde c \coloneqq \hat c - a
              is another possible lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial^B \tilde c = 0
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [c]
              is in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_n(B) \to H_n(C)
          .num_remark
            %h6#remark Remark
            %p
              Of course the situation for
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              is formally dual to this situation. For convenience we repeat the statement for dual chains:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo •
                    %mo →
                    %msup
                      %mi B
                      %mo •
                    %mo →
                    %msup
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A^\bullet \to B^\bullet \to C^\bullet
              be a short exact sequence of cochain complexes.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi C
                    %mo ∈
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [c]_C \in H^n(C)
              the class of a closed element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} B \to C
              there is an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \hat c \in B
              mapping to it. This need not be closed anymore, but of course
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} d_B \hat c
              is. By the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} B \to C
              is a chain map we have that the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} d_B \hat c
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              vanishes. Therefore by the exactness of the sequence the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} d_B \hat c
              may be regarded as a closed element of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi A
                  %annotation{:encoding => "application/x-tex"} [d_B \hat c]_A
              of this is what the connecting homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi δ
                      %mi n
                    %mo :
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\delta^n : H^n(C) \to H^{n+1}(A)
            %p
              assigns to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi c
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi C
                    %annotation{:encoding => "application/x-tex"} [c]_C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi C
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi B
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta : [c]_C \mapsto [d_B\hat c]_A
                    \\,.
            %p
              This is indeed well defined, in that it is independent of the choice of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \hat c'
              another choice, we have that the difference
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo −
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \hat c - \hat c'
              is in the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} B \to C
              hence is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo ′
                      %mo =
                      %msub
                        %mi d
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo +
                      %msub
                        %mi d
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo −
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_B \hat c' = d_B \hat c + d_A(\hat c - \hat c')
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi d
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi A
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi d
                        %mi B
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                      %mo ′
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi A
                    %annotation{:encoding => "application/x-tex"} [d_B \hat c]_A = [d_B \hat c']_A
          %h3#OnHomologyGeneralAbstract General abstract
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi A
                      %mo •
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi B
                      %mo •
                    %mover
                      %mo →
                      %mi g
                    %msub
                      %mi C
                      %mo •
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to A_\bullet \stackrel{f}{\to} B_\bullet \stackrel{g}{\to} C_\bullet \to 0
              be a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              in some
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              there are natural
              %em connecting homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo :
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
