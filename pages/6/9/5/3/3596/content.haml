                          %mo :
                          %mi 𝕀
                          %mo →
                          %mi A
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, z:\mathbb{I} \to A \vdash C(z) \; \mathrm{type} \quad t:\prod_{x:A} C(\lambda i:\mathbb{I}.x)}{\Gamma \vdash \mathrm{ind}_{\mathbb{I} \to A}(t):\prod_{z:\mathbb{I} \to A} C(z)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi z
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi t
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi 𝕀
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ind
                        %mrow
                          %mi 𝕀
                          %mo →
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ,
                      %mi λ
                      %mi i
                      %mo :
                      %mi 𝕀
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi 𝕀
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, z:\mathbb{I} \to A \vdash C(z) \; \mathrm{type} \quad t:\prod_{x:A} C(\lambda i:\mathbb{I}.x)}{\Gamma, x:A \vdash \mathrm{ind}_{\mathbb{I} \to A}(t, \lambda i:\mathbb{I}.x) \equiv t(x):C(\lambda i:\mathbb{I}.x)}
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that path induction for function types out of the interval type is true. Then the J-rule is true: given a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and given a type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(x, y, p)
              indexed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y:A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} p:x =_A y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo :
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t:\prod_{x:A} C(x, x, \mathrm{refl}_A(x))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mo =
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi y
                        %mo :
                        %mi A
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi p
                        %mo :
                        %mi x
                        %msub
                          %mo =
                          %mi A
                        %mi y
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{=, A}(t):\prod_{x:A} \prod_{y:A} \prod_{p:x =_A y} C(x, y, p)
            %p
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi x
                    %mo ,
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J(t, x, x, \mathrm{refl}_A(x)) \equiv t(x)
            %p
          %p
          .proof
            %h6 Proof
            %p
              By path induction on the type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(f(0), f(1), \mathrm{toId}_A(f))
              indexed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi f
                        %mo :
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{\mathbb{I} \to A}(t):\prod_{f:\mathbb{I} \to A} C(f(0), f(1), \mathrm{toId}_A(f))
            %p
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{\mathbb{I} \to A}(t, \lambda i:\mathbb{I}.x) \equiv t(x):C(\lambda i:\mathbb{I}.x)
            %p since by definition of constant function and reflexivity, one has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi i
                        %mo :
                        %mi 𝕀
                        %mo .
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi 𝓅
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lambda i:\mathbb{I}.x)(0) \equiv x \quad (\lambda i:\mathbb{I}.x)(1) \equiv x \quad \mathrm{ap}_{\lambda i:\mathbb{I}.x}(\mathcal{p}) \equiv \mathrm{refl}_A(x)
            %p We define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J(t, x, y, p) \equiv \mathrm{ind}_{\mathbb{I} \to A}(t, \mathrm{rec}_\mathbb{I}^A(x, y, p))
            %p
              since by interval recursion one has a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_\mathbb{I}^A(x, y, p):\mathbb{I} \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi y
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mi 𝕀
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi 𝓅
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(0) \equiv x \quad \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(1) \equiv y \quad \mathrm{ap}_{\mathrm{rec}_\mathbb{I}^{A}(x, y, p)}(0, 1, \mathcal{p}) \equiv p
            %p
          %p Thus, everything about identity types in Martin-Löf type theory could be proven in this theory.
          %p One has the following analogies between localization at a specific type and the type theoretic letter rule that it proves:
          %table
            %thead
              %tr
                %th localization rule
                %th type theoretic letter rule
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/I-localization"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi 𝕀
                        %annotation{:encoding => "application/x-tex"} \mathbb{I}
                    \-localization
                %td{:style => "text-align: left;"}
                  %strong J-rule
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/S1-localization"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} S^1
                    \-localization
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/K-rule"} K-rule
          %h3#kan_operations Kan operations
          %p
            Defining identity types in terms of an
            %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            gives the type theory a
            %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical
            flavor, although here the interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} \mathbb{I}
            is an actual type, rather than a pretype in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
            = succeed "." do
              %a{:href => "#Bentzen2019"} Bentzen2019
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given paths
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} g:\mathbb{I} \to A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} fill
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{fill}_A(f, g):(f(0) =_A g(0)) \to (f(1) =_A g(1))
            %p
          %p
            This is defined by double path induction by sending the constant path of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in each parameter to its filler of identifications, which is just the identity function on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi x
                %annotation{:encoding => "application/x-tex"} x =_A x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} fill
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi i
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi x
                  %mo ,
                  %mi λ
                  %mi i
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mrow
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi x
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash \mathrm{fill}_A(\lambda i:\mathbb{I}.x, \lambda i:\mathbb{I}.x) \equiv \mathrm{id}_{x =_A x}:(x =_A x) \to (x =_A x)
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
              and identification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} p:x =_A y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi y
                      %msub
                        %mo =
                        %mi A
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^{-1}:(y =_A x)
          %p
            By interval recursion, there are paths
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_\mathbb{I}^A(x, y, p):\mathbb{I} \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            at reflexivity of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} fill
                    %mi A
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi{:mathvariant => "normal"} rec
                    %mi 𝕀
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi λ
                  %mi i
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi x
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi y
                  %msub
                    %mo =
                    %mi A
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p^{-1} \equiv \mathrm{fill}_A(\mathrm{rec}_\mathbb{I}^A(x, y, p), \lambda i:\mathbb{I}.x, \mathrm{refl}_A(y)):(y =_A x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                      %mtd
                        %mi x
                      %mtd
                        %mover
                          %mo =
                          %mrow
                            %msub
                              %mi{:mathvariant => "normal"} refl
                              %mi A
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                      %mtd
                        %mi x
                      %mtd
                    %mtr
                      %mtd
                        %mi p
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} refl
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mtr
                      %mtd
                      %mtd
                        %mi y
                      %mtd
                        %munder
                          %mo =
                          %mrow
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                      %mtd
                        %mi x
                      %mtd
                    %mtr
                      %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccccc}
                  \&amp; x &amp; \overset{\mathrm{refl}_A(x)}= &amp; x &amp;  \\
                  p &amp; \Vert &amp;  &amp; \Vert &amp; \mathrm{refl}_A(x) \\
                  \&amp; y &amp; \underset{p^{-1}}= &amp; x &amp; \\
                  \\end{array}
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y:A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} z:A
              and identifications
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                  %annotation{:encoding => "application/x-tex"} p:x =_A y
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo :
                      %mi y
                      %msub
                        %mo =
                        %mi A
                      %mi z
                    %annotation{:encoding => "application/x-tex"} q:y =_A z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo •
                    %mi q
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \bullet q:(x =_A z)
              called the concatenation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
          %p
            By interval recursion, there is a path
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_\mathbb{I}^A(y, z, q):\mathbb{I} \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and the path of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo •
                  %mi q
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} fill
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi i
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi x
                  %mo ,
                  %msubsup
                    %mi{:mathvariant => "normal"} rec
                    %mi 𝕀
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p \bullet q \equiv \mathrm{fill}_A(\lambda i:\mathbb{I}.x, \mathrm{rec}_\mathbb{I}^A(y, z, q), p):(x =_A z)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                      %mtd
                        %mi x
                      %mtd
                        %mover
                          %mo =
                          %mi p
                      %mtd
                        %mi y
                      %mtd
                    %mtr
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} refl
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                        %mi q
                    %mtr
                      %mtd
                      %mtd
                        %mi x
                      %mtd
                        %munder
                          %mo =
                          %mrow
                            %mi p
                            %mo •
                            %mi q
                      %mtd
                        %mi z
                      %mtd
                    %mtr
                      %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccccc}
                  \&amp; x &amp; \overset{p}= &amp; y &amp;  \\
                  \\mathrm{refl}_A(x) &amp; \Vert &amp;  &amp; \Vert &amp; q \\
                  \&amp; x &amp; \underset{p \bullet q}= &amp; z &amp; \\
                  \\end{array}
          %h3#other_properties Other properties
          %p
            There are other things which can be defined similarly to cubical type theory. For example,
            %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            is provable:
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given dependent functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\prod_{x:A} B(x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g:\prod_{x:A} B(x)
              and a
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo :
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H:\prod_{x:A} f(x) =_{B(x)} g(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} funext
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi f
                    %msub
                      %mo =
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \mathrm{funext}(f, g, H):f =_{\prod_{x:A} B(x)} g
          %p
          .proof
            %h6 Proof
            %p This is defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} funext
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo .
                    %msubsup
                      %mi{:mathvariant => "normal"} topath
                      %mi 𝕀
                      %mrow
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{funext}(f, g, H) \equiv \mathrm{toId}_{\prod_{x:A} B(x)}(\lambda i:\mathbb{I}.\lambda x:A.\mathrm{topath}_\mathbb{I}^{B(x)}(f(x), g(x), H(x))(i))
            %p
          %p
            Similarly,
            %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} function application to identifications
            can be defined without the use of path induction:
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
              and an identification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} p:x =_A y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi B
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{ap}_f(x, y, p):f(x) =_B f(y)
          %p This is defined through the inference rules for identity types and function composition:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} toId
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∘
                  %msubsup
                    %mi{:mathvariant => "normal"} rec
                    %mi 𝕀
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi B
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_f(x, y, p) \equiv \mathrm{toId}_B(f \circ \mathrm{rec}_\mathbb{I}^A(x, y, p)):f(x) =_B f(y)
          %p
            This is sufficient to prove the recursion and uniqueness rules for the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
          %p
          .num_theorem
            %h6 Theorem
            %p The recursion principle of the interval type:
            %p
              Given a type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
              and equality
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} p:x =_{A} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p):\mathbb{I} \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi y
                    %mspace{:width => "1em"}
                    %msubsup
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mi 𝕀
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                      %mo =
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi 𝕀
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi 𝕀
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(0) \equiv x \quad \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(1) \equiv y \quad \mathrm{ap}_{\mathrm{rec}_\mathbb{I}^{A}(x, y, p)}^{=}(0, 1, \mathrm{toId}_\mathbb{I}(\mathrm{id}_\mathbb{I})) \equiv p
            %p
          %p
          .proof
            %h6 Proof
            %p We define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msubsup
                      %mi{:mathvariant => "normal"} topath
                      %mi 𝕀
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A(-)}(x, y, p) \equiv \mathrm{topath}_{\mathbb{I}}^{A(-)}(x, y, p)
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(0) \equiv x
              is given by the first computation rule of identity types and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi y
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(1) \equiv y
              is given by the second computation rules of identity types. Finally, by definition of function application to identification and the uniqueness rule of identity types, one has the following reduction:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mi 𝕀
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi 𝕀
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi 𝕀
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi 𝕀
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi 𝕀
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi 𝕀
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\mathrm{rec}_\mathbb{I}^{A}(x, y, p)}(0, 1, \mathrm{toId}_A(\mathrm{id}_\mathbb{I})) \equiv \mathrm{toId}_A(\mathrm{rec}_{\mathbb{I}}^{A}(x, y, p) \circ \mathrm{rec}_\mathbb{I}^\mathbb{I}(0, 1, \mathrm{toId}_\mathbb{I}(\mathrm{id}_\mathbb{I}))) \equiv \mathrm{toId}_A(\mathrm{rec}_{\mathbb{I}}^{A}(x, y, p) \circ \mathrm{id}_\mathbb{I})
            %p and by function composition and the third computation rule of identity types, one has the following reduction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi 𝕀
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathrm{toId}_A(\mathrm{rec}_{\mathbb{I}}^{A}(x, y, p) \circ \mathrm{id}_\mathbb{I}) \equiv \mathrm{toId}_A(\mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)) \equiv p
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p The uniqueness principle of the interval type:
            %p
              Given a type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
              and equality
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} p:x =_{A} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi y
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi 𝕀
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi 𝕀
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                  %annotation{:encoding => "application/x-tex"} f(0) \equiv x \quad f(1) \equiv y \quad \mathrm{ap}_{f}(0, 1, \mathrm{toId}_\mathbb{I}(\mathrm{id}_\mathbb{I})) \equiv p
            %p
              one has that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ≡
                      %msubsup
                        %mi{:mathvariant => "normal"} rec
                        %mi 𝕀
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \equiv \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)
          %p
          .proof
            %h6 Proof
            %p By definition of the recursor of the interval type,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msubsup
                      %mi{:mathvariant => "normal"} topath
                      %mi 𝕀
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p) \equiv \mathrm{topath}_{\mathbb{I}}^{A(-)}(x, y, p)
            %p and by the judgmental congruence rules for substitution, one has that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} topath
                      %mi 𝕀
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msubsup
                      %mi{:mathvariant => "normal"} topath
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{topath}_{\mathbb{I}}^{A(-)}(x, y, p) \equiv \mathrm{topath}_\mathbb{I}^A(f(0), f(1), \mathrm{toId}_A(f))
            %p and by the uniqueness rule for identity types, one has that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} topath
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \mathrm{topath}_\mathbb{I}^A(f(0), f(1), \mathrm{toId}_A(f)) \equiv f
            %p
          %p The recursion and uniqueness principles of the interval type are in turn sufficient to prove the induction principle of the interval type.
          %h2#definition_in_observational_type_theory Definition in observational type theory
          %p
            Identity types in
            %a.existingWikiWord{:href => "/nlab/show/observational+type+theory"} observational type theory
            and
            %a.existingWikiWord{:href => "/nlab/show/higher+observational+type+theory"} higher observational type theory
            are defined in a different manner than they are in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+type+theory"} Martin-Löf type theory
          %p In higher observational type theory, identity types have the same formation rule as Martin-Löf identity types do:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi Type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi A
                      %mo ⊢
                      %msub
                        %mi Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma \vdash A:Type}
                  {\Gamma, x:A, y:A \vdash Id_A(x,y):Type}
          %p
            However, it does not have global elimination or computation rules. Instead, it has a local computation rule for each particular type. For example, the identity type of the product type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \times B
            has the following computation rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mrow
                      %mi A
                      %mo ×
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 1
                  %mi s
                  %mo ,
                  %msub
                    %mi π
                    %mn 1
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi Id
                    %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 2
                  %mi s
                  %mo ,
                  %msub
                    %mi π
                    %mn 2
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Id_{A \times B} (s, t) \equiv Id_A(\pi_1 s, \pi_1 t) \times Id_B (\pi_2 s, \pi_2 t)
          %h3#for_types_in_universes For types in universes
          %p
            We are working in a
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            with Tarski-style
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universes"} universes
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            in a universe in higher observational type theory have the following formation rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi A
                      %mo :
                      %mi 𝒰
                      %mspace{:width => "1em"}
                      %mi a
                      %mo :
                      %msub
                        %mi 𝒯
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi b
                      %mo :
                      %msub
                        %mi 𝒯
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \frac{A:\mathcal{U} \quad a:\mathcal{T}_\mathcal{U}(A) \quad b:\mathcal{T}_\mathcal{U}(A)}{\mathrm{id}_A(a, b):\mathcal{U}}
          %p We define a general congruence term called ap
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi f
                      %mo :
                      %mi B
                      %mspace{:width => "1em"}
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %msup
                        %mi a
                        %mo ′
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mrow
                          %mi x
                          %mo .
                          %mi f
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi a
                        %mo ′
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{x:A \vdash f:B \quad p:\mathrm{id}_A(a, a^{'})}{\mathrm{ap}_{x.f}(p):\mathrm{id}_B(f[a/x], f[a^{'}/x])}
          %p and the reflexivity terms:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi a
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{a:A}{\mathrm{refl}_{a}:\mathrm{id}_A(a, a)}
          %p and computation rules for identity functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi x
                      %mo .
                      %mi x
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi p
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{x.x}(p) \equiv p
          %p
            and for constant functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi x
                      %mo .
                      %mi y
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi y
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{x.y}(p) \equiv \mathrm{refl}_{y}
          %p Thus, ap is a higher dimensional explicit substitution. There are judgmental equalities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi x
                      %mo .
                      %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{x.f}(\mathrm{refl}_{a}) \equiv \mathrm{refl}_{f[a/x]}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi y
                      %mo .
                      %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi x
                      %mo .
                      %mi f
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi x
                      %mo .
                      %mi g
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} /
                      %mi y
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{y.g}(\mathrm{ap}_{x.f}(p)) \equiv \mathrm{ap}_{x.g[f/y]}(p)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi x
                      %mo .
                      %mi t
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi t
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{x.t}(p) \equiv \mathrm{refl}_{t}
          %p
            for constant term
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %h3#for_universes For universes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ≅
                    %mi 𝒰
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \cong_\mathcal{U} B
            be the type of
            %a.existingWikiWord{:href => "/nlab/show/bijective+correspondences"} bijective correspondences
            between two terms of a universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} A:\mathcal{U}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} B:\mathcal{U}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi 𝒰
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{id}_\mathcal{U}(A, B)
            be the identity type between two terms of a universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} A:\mathcal{U}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} B:\mathcal{U}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi R
                      %mo :
                      %mi A
                      %msub
                        %mo ≅
                        %mi 𝒰
                      %mi B
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi P
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo ∇
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                      %msub
                        %mo ≅
                        %mi 𝒰
                      %mi B
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi R
                      %mo :
                      %mi A
                      %msub
                        %mo ≅
                        %mi 𝒰
                      %mi B
                    %mrow
                      %mo ∇
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi R
                %annotation{:encoding => "application/x-tex"} \frac{R:A \cong_\mathcal{U} B}{\Delta(R):\mathrm{id}_\mathcal{U}(A, B)} \qquad \frac{P:\mathrm{id}_\mathcal{U}(A, B)}{\nabla(P):A \cong_\mathcal{U} B} \qquad \frac{R:A \cong_\mathcal{U} B}{\nabla(\Delta(R)) \equiv R}
          %h3#identity_types_in_universes_and_singleton_contractibility Identity types in universes and singleton contractibility
          %p
            Given a term of a universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} A:\mathcal{U}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mrow
                      %msub
                        %mi 𝒯
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{id}_{\mathcal{T}_\mathcal{U}(A)} \equiv \pi_1(\nabla(\mathrm{refl}_A))
          %p
            with terms representing
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singleton+contractibility"} singleton contractibility
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %msub
                        %mi 𝒯
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi b
                        %mo :
                        %msub
                          %mi 𝒯
                          %mi 𝒰
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %msub
                          %mi 𝒯
                          %mi 𝒰
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \pi_1(\pi_2(\nabla(\mathrm{refl}_A)):\prod_{a:\mathcal{T}_\mathcal{U}(A)} \mathrm{isContr}\left(\sum_{b:\mathcal{T}_\mathcal{U}(A)} \mathrm{id}_{\mathcal{T}_\mathcal{U}(A)}(a, b)\right)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %msub
                        %mi 𝒯
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %msub
                          %mi 𝒯
                          %mi 𝒰
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %msub
                          %mi 𝒯
                          %mi 𝒰
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \pi_2(\pi_2(\nabla(\mathrm{refl}_A))):\prod_{b:\mathcal{T}_\mathcal{U}(A)} \mathrm{isContr}\left(\sum_{a:\mathcal{T}_\mathcal{U}(A)} \mathrm{id}_{\mathcal{T}_\mathcal{U}(A)}(a, b)\right)
          %h2#definition_in_cubical_type_theory Definition in cubical type theory
          %p
            The primary identity types are the nondependent
            %a.existingWikiWord{:href => "/nlab/show/cubical+path+types"} cubical path types
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
            %a.existingWikiWord{:href => "/nlab/show/cubical+path+type"} cubical path type
            for more information on the construction of the cubical path types.
          %p
            Some cubical type theories include a second identity type which satisfies the judgmental version of identification elimination. This is called
            = succeed "," do
              %span.newWikiWord
                Swan's identity type
                %a{:href => "/nlab/new/Swan%27s+identity+type"} ?
          %p
            Identity types in
            %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
            are called
            %strong path types
            and are defined using a primitive interval.
          %h2#categorical_semantics Categorical semantics
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for identity types in the extensional case, and identity types in the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics+of+homotopy+type+theory"} categorical semantics of homotopy type theory
            in the intensional case.
          %p
            In categorical models of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extensional+type+theory"} extensional type theory
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of the category is allowed to represent a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi A
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A\to A\times A
          %p
            By contrast, in models of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
            %a.existingWikiWord{:href => "/nlab/show/display+maps"} display maps
            or
            %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
            which are allowed to represent dependent types, and intensional identity types are represented by
            %a.existingWikiWord{:href => "/nlab/show/path+objects"} path objects
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi A
                    %mo →
                    %mi A
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"} P A \to A \times A
          %p
            Both of these cases apply in particular to models in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+contexts"} category of contexts
            of the type theory itself, i.e. the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/term+model"} term model
          %h3#prerequisites Prerequisites
          %p
            By the standard construction of
            %a.existingWikiWord{:href => "/nlab/show/mapping+path+spaces"} mapping path spaces
            out of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/path+space+objects"} path space objects
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
          %p
            Conversely, since any weak factorization system gives rise to
            %a.existingWikiWord{:href => "/nlab/show/path+objects"} path objects
            by factorization of
            = succeed "," do
              %span.newWikiWord
                diagonal maps
                %a{:href => "/nlab/new/diagonal+maps"} ?
            %a.existingWikiWord{:href => "/nlab/show/model"} model
            of type theory with identity types in a category equipped with a WFS
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
          %ol
            %li
              %p
                In order to handle the additional
                %a.existingWikiWord{:href => "/nlab/show/context"} context
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                in the explicit definition above, it turns out to be necessary to assume that
                = succeed "-maps" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                along
                = succeed "-maps" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "-objects." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %a.existingWikiWord{:href => "/nlab/show/dependent+products"} dependent products
                in a
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
            %li
              %p
                This enables us to define identity types with their elimination and computation rules “locally”, i.e. for each type individually. However, every construction in type theory is stable under
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/substitution"} substitution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Y
                      %mo ⊢
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} y\colon Y\vdash A(y)\colon Type
                is a dependent type and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f\colon X\to Y
                is a morphism, then the identity type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⊢
                      %msub
                        %mi Id
                        %mrow
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} x\colon X \vdash Id_{A(f(x))}(-,-)\colon Type
                is the same whether we first construct
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mrow
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Id_{A(y)}
                and then substitute
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x)
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                to obtain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(f(x))
                and then construct its identity type. In order for this to hold up to isomorphism, we need to require that the WFS have
                %em stable path objects
                — a choice of path object data in each slice category which is preserved by pullback. In
                %a{:href => "#Warren08"} Warren 2008
                it is shown that any
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                in which the
                %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                are the
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
                can be equipped with stable path objects, while
                %a{:href => "#vdBergGarner11"} Garner &amp; van den Berg 2011
                it is shown that the presence of internal path-categories also suffices.
            %li
              %p
                The eliminator term
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                of identity types in type theory is also preserved by substitution. This imposes an additional
                %em
                  %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
                requirement which is tricky to obtain categorically. See
                %a{:href => "#Warren08"} Warren 2008
                and
                %a{:href => "#vdBergGarner11"} Garner &amp; van den Berg 2011
                for methods that ensure this, such as by invoking an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+weak+factorization+system"} algebraic weak factorization system
                %em a la
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"} Voevodsky
                by using a (possibly
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalent
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            %li
              %p
                Finally, substitution in type theory is strictly functorial/
                %a.existingWikiWord{:href => "/nlab/show/associativity"}> associative
                , whereas it is modeled categorically by pullback which is generally not strictly so. This is a general issue with the categorical interpretation of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
                %a.existingWikiWord{:href => "/nlab/show/split+fibration"} split fibration
                which is equivalent to the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/universe"} universe
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/categorical+model+of+dependent+types"} categorical model of dependent types
          %h3#interpretation_in_a_typetheoretic_model_category Interpretation in a type-theoretic model category
          %p
            Assume then that a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            with suitable WFSs has been chosen, for instance a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type-theoretic+model+category"} type-theoretic model category
          %ul
            %li
              %p
                The interpretation of a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} \vdash A : Type
                is as a
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi Type
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\vdash A : Type]
                which we will just write “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                ” for short.
            %li
              %p
                %strong type formation
              %p
                The identity type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo :
                      %mi A
                      %mo ⊢
                      %msub
                        %mi Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} a, b : A \vdash Id_A(a,b) : Type
                is interpreted as
                %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi A
                                %mi I
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                              %mo ×
                              %mi A
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A^I
                      \\\
                      \\downarrow
                      \\\
                      A \times A
                      }
            %li
              %p
                %strong term introduction
              %p
                By definition of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mi A
                                %mi I
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi σ
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi A
                              %mo ×
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; A^I
                      \\\
                      \&amp; {}^{\mathllap{\sigma}}\nearrow&amp; \downarrow
                      \\\
                      A &amp;\stackrel{(id,id)}{\to}&amp; A \times A
                      }
                      \\,.
              %p
                By the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                this is equivalently a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                of the path space object along the
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                morphism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %mi id
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi A
                        %mo →
                        %mi A
                        %mo ×
                        %mi A
                      %annotation{:encoding => "application/x-tex"} (id,id) : A \to A \times A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi id
                              %mo ,
                              %mi id
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %msup
                                %mi A
                                %mi I
                            %mtd
                              %mo →
                            %mtd
                              %msup
                                %mi A
                                %mi I
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi σ
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo =
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi A
                              %mo ×
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; (id,id)^* A^I &amp;\to&amp; A^I
                      \\\
                      \&amp;{}^{\mathllap{\sigma}}\nearrow&amp; \downarrow &amp; &amp; \downarrow
                      \\\
                      A &amp;=&amp; A &amp;\stackrel{(id,id)}{\to}&amp; A \times A
                      }
                      \\,.
              %p
                Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi id
                      %mo ,
                      %mi id
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %msup
                        %mi A
                        %mi I
                    %annotation{:encoding => "application/x-tex"} (id, id)^* A^I
                is the interpretation of the
                %a.existingWikiWord{:href => "/nlab/show/substitution"} substitution
                %br/
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                      %mo ⊢
                      %msub
                        %mi Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} a : A \vdash Id_A (a,a) : Type
                in this sense
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                is now the interpretation of a term
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                        %mo ⊢
                        %msub
                          %mi r
                          %mi A
                        %mo :
                        %msub
                          %mi Id
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a : A \vdash r_A : Id_A (a,a)
            %li
              %p
                %strong term elimination
              %p A type depending on an identity type
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo :
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      a, b : A, p : Id_A(a,b) \vdash C(a,b,p)
              %p
                is interpreted as a
                %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msup
                                %mi A
                                %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C
                      \\\
                      \\downarrow
                      \\\
                      A^I
                      }
                      \\,.
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/substitution"} substitution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo ,
                      %msub
                        %mi r
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(a,a,r_a)
                is interpreted by the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi id
                              %mo ,
                              %mi id
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mi C
                            %mtd
                              %mo →
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi A
                              %mo ×
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (id,id)^* C &amp;\to&amp; C
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      A &amp;\stackrel{(id,id)}{\to}&amp; A \times A
                      }
                      \\,.
              %p
                Therefore a
                %a.existingWikiWord{:href => "/nlab/show/term"} term
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo ,
                      %msub
                        %mi r
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t : C(a,a,r_a)
                is interpreted as a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of this pullback
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi id
                              %mo ,
                              %mi id
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mi C
                            %mtd
                              %mo →
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi t
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo =
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi A
                              %mo ×
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; (id,id)^* C &amp;\to&amp; C
                      \\\
                      \&amp;{}^{\mathllap{t}}\nearrow&amp; \downarrow &amp;&amp; \downarrow
                      \\\
                      A &amp;=&amp; A &amp;\stackrel{(id,id)}{\to}&amp; A \times A
                      }
                      \\,.
              %p
                By the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the pullback, this is equivalently a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
                in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi t
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi A
                              %mo ×
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; C
                      \\\
                      \&amp; {}^{\mathllap{t}}\nearrow &amp; \downarrow
                      \\\
                      A &amp;\stackrel{(id,id)}{\to}&amp; A \times A
                      }
                      \\,.
              %p
                The elimination rule says that given such
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                      %annotation{:encoding => "application/x-tex"} t
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo →
                        %msup
                          %mi A
                          %mi I
                      %annotation{:encoding => "application/x-tex"} C \to A^I
                %em
                  %a.existingWikiWord{:href => "/nlab/show/lifting+problem"} lift
                in that diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo →
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi r
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msup
                                %mi A
                                %mi I
                            %mtd
                              %mo =
                            %mtd
                              %msup
                                %mi A
                                %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\to&amp; C
                      \\\
                      {}^{\mathllap{r}}\downarrow &amp;\nearrow&amp; \downarrow
                      \\\
                      A^I &amp;=&amp; A^I
                      }
                      \\,.
              %p
                In particular, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                itself is the pullback of a fibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} D \to B
                along a morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi A
                          %mi I
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A^I \to B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                has the left lifting property also against that fibration
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo →
                            %mtd
                              %mi C
                            %mtd
                              %mo →
                            %mtd
                              %mi D
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi r
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msup
                                %mi A
                                %mi I
                            %mtd
                              %mo =
                            %mtd
                              %msup
                                %mi A
                                %mi I
                            %mtd
                              %mo →
                            %mtd
                              %mi B
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\to&amp; C &amp;\to&amp; D
                      \\\
                      {}^{\mathllap{r}}\downarrow &amp;\nearrow&amp; \downarrow &amp;&amp; \downarrow
                      \\\
                      A^I &amp;=&amp; A^I &amp;\to&amp; B
                      }
                      \\,.
              %p
                So the term elimination rule says that the interpretation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %msup
                        %mi A
                        %mi I
                    %annotation{:encoding => "application/x-tex"} A \to A^I
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a : A \vdash r(a) : Id_A (a,a)
                has the
                %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                against all fibrations, hence that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %msup
                        %mi A
                        %mi I
                    %annotation{:encoding => "application/x-tex"} A \to A^I
                is to be interpreted as an acyclic cofibration.
          %h3#weak_groupoids
            Weak
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            Some of the first work noticing the homotopical / higher-categorical interpretation of identity types (see below) focused on the fact that the tower of iterated identity types of a type has the structure of an internal
            %em
              %a.existingWikiWord{:href => "/nlab/show/algebraic+definition+of+higher+categories"} algebraic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            In retrospect, this is roughly an algebraic version of the standard fact that every object of a model category (or more generally a
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            or a category with a weak factorization system) admits a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+resolution"} simplicial resolution
            which is an
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            = succeed "-groupoid." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-maps" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            = succeed "-maps)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h2#OfArbitraryArity Identity types of arbitrary arity
          %p
            The usual notion of identity types, binary identity types, represents the notion of when two elements of a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are equal or identified with each other. One can generalize this to the notion of when a family of elements of a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are equal or identified, that is,
            = succeed "." do
              %strong
                identity types of
                %a.existingWikiWord{:href => "/nlab/show/arbitrary+arity"} arbitrary arity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and an index type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            %a.existingWikiWord{:href => "/nlab/show/arity"} arity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is represented by a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo ¯
                    %mo :
                    %mi I
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A
          %p
            Closely related to identity types of arbitrary arity are the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bridge+types"} bridge types
          %ul
            %li
              %p
                they are reflexive type families that come with a notion of
                %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} function application to identifications
                (or
                %a.existingWikiWord{:href => "/nlab/show/bridges"} bridges
                for bridge types);
            %li
              %p
                they are used in the path constructors of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/higher+inductive+types"} higher inductive types
                %a.existingWikiWord{:href => "/nlab/show/induction+principle"} induction principle
                and
                %a.existingWikiWord{:href => "/nlab/show/recursion+principle"} recursion principle
                of said HITs;
            %li
              %p
                they are used to satisfy various notions of
                %a.existingWikiWord{:href => "/nlab/show/extensionality"} extensionality
                such as
                %a.existingWikiWord{:href => "/nlab/show/product+extensionality"} product extensionality
                and
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
          %p
            There are many different ways to define identity types of arity
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            are an
            %a.existingWikiWord{:href => "/nlab/show/inductive+family"} inductive family
            of
            %a.existingWikiWord{:href => "/nlab/show/types"} types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A \vdash \mathrm{Id}_{I, A}(\overline{x})
          %p
            generated by the family of elements called “reflexivity of arity
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash \mathrm{refl}_{I, A}(x):\mathrm{Id}_{I, A}(\lambda t.x)
          %p
            When the index type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the
            %a.existingWikiWord{:href => "/nlab/show/booleans+type"} booleans type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} \mathbb{2}
            and the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mrow
                      %mi 𝟚
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{x} \equiv \mathrm{rec}_{\mathbb{2}, A}(x, y)
            is given by the recursion principle of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/booleans+type"} booleans type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mrow
                      %mi 𝟚
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mrow
                      %mi 𝟚
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Id}_A(x, y) \equiv \mathrm{Id}_{\mathbb{2}, A}(\mathrm{rec}_{\mathbb{2}, A}(x, y))
          %p is precisely the usual identity types as defined above, which indicates the equality / identification of a family of two elements.
          %p
            When the index type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the standard
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi m
                        %mo :
                        %mi ℕ
                    %mi m
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \mathrm{Fin}(n) \coloneqq \sum_{m:\mathbb{N}} m \lt n
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-ary identity types
            and its elements can be called
            = succeed "." do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-ary identifications
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %ul
            %li
              %p
                The nullary identity type (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
                ) of type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is the
                %a.existingWikiWord{:href => "/nlab/show/positive+copy+type"} positive copy type
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                The unary identity types (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
                ) of type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                are the
                = succeed "-indexed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/positive+unit+types"} positive unit types
            %li
              %p
                The binary identity types (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n = 2
                ) of type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                are the usual identity types defined above.
          %h3#inference_rules_2 Inference rules
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
            for such identity types of arbitrary arity are given as follows:
          %p
            First the rule that defines the identity type itself, as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/type+formation"} type formation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi I
                      %mo :
                      %mi Type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi Type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi f
                      %mo :
                      %mi I
                      %mo →
                      %mi A
                      %mo ⊢
                      %msub
                        %mi Id
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash I:Type \quad \Gamma \vdash A:Type}{\Gamma, f:I \to A \vdash Id_{I, A}(f):Type}
          %p
            Now the basic “introduction” rule, which says that the elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            encoded in the
            %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi i
                  %mo :
                  %mi I
                  %mo .
                  %mi x
                %annotation{:encoding => "application/x-tex"} \lambda i:I.x
            which sends every element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi I
                %annotation{:encoding => "application/x-tex"} i:I
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            are equal in a canonical way.
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/term+introduction"} term introduction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi I
                      %mo :
                      %mi Type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %mi Type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash I:Type \quad \Gamma \vdash A:Type}{\Gamma, x:A \vdash r(x) : Id_{I, A}(\lambda i:I.x)}
          %h4#standard_jrule Standard J-rule
          %p Then we have the “elimination” rule:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi f
                      %mo :
                      %mi I
                      %mo →
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi f
                      %mo :
                      %mi I
                      %mo →
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msup
                        %mi J
                        %mrow
                          %munder
                            %mrow
                            %mo ̲
                          %mo .
                          %mi t
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma, f:I \to A, p:Id_{I, A}(f), \Delta(f,p) \vdash C(f,p):Type \quad \Gamma, x:A, \Delta(\lambda i:I.x,r(x)) \vdash t(x):C(\lambda i:I.x,r(x))}
                  {\Gamma, f:I \to A, p:Id_{I, A}(f) \vdash J^{\underline{ }.t}(f,p) : C(f,p)}
          %p The elimination rule then says that if:
          %ol
            %li
              for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi I
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:I \to A
              and any reason
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p:Id_A(f)
              why the family of elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              encoded in the functions are the same, we have a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(f,p)
            %li
              for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              we have a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t(x):C(\lambda i:I.x,r(x))
          %p
            we can construct a canonically defined term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mrow
                      %munder
                        %mrow
                        %mo ̲
                      %mo .
                      %mi t
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J^{\underline{ }.t}(f,p):C(f,p)
            for
            %em any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi Id
                      %mrow
                        %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p:Id_{I, A}(f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t(x)
            dependent upon the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            along the proof of equality
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi p
                  %annotation{:encoding => "application/x-tex"} f,p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi i
                    %mo :
                    %mi I
                    %mo .
                    %mi x
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda i:I.x,r(x)
          %p
            Finally, we have the “computation” or
            %a.existingWikiWord{:href => "/nlab/show/beta-reduction"} beta-reduction
            rule. There are two possible computation rules, which result in strict and weak identity types respectively. The computation rule for strict identity types says that if we substitute along a
            %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexivity
            proof, nothing happens.
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/computation+rule"} computation rule
              for strict identity types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi f
                      %mo :
                      %mi I
                      %mo →
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi b
                      %mo :
                      %mi 𝟚
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msup
                        %mi J
                        %mrow
                          %munder
                            %mrow
                            %mo ̲
                          %mo .
                          %mi t
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma, f:I \to A, p:Id_{I, A}(f), \Delta(f,p) \vdash C(f,p):Type \quad \Gamma, x:A, \Delta(\lambda i:I.x,r(x)) \vdash t(x):C(\lambda b:\mathbb{2}.x,r(x))}
                  {\Gamma, x:A, \Delta(\lambda i:I.x,r(x)) \vdash J^{\underline{ }.t}(\lambda i:I.x,r(x)) = t(x)}
          %p
            Note that the equality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo =
                %annotation{:encoding => "application/x-tex"} =
            in the conclusion of this computation rule is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
          %p
            The computation rule for weak identity types says that there is a witness that the substitution along a
            %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexivity
            proof is equal to the original
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t(x)
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/computation+rule"} computation rule
              for weak identity types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi f
                      %mo :
                      %mi I
                      %mo →
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msup
                        %mi β
                        %mrow
                          %munder
                            %mrow
                            %mo ̲
                          %mo .
                          %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mi i
                          %mo :
                          %mi I
                          %mo .
                          %mi x
                          %mo ,
                          %mi r
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi J
                        %mrow
                          %munder
                            %mrow
                            %mo ̲
                          %mo .
                          %mi t
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Gamma, f:I \to A, p:Id_{I, A}(f), \Delta(f,p) \vdash C(f,p):Type \quad \Gamma, x:A, \Delta(\lambda i:I.x,r(x)) \vdash t(x):C(\lambda i:I.x,r(x))}
                  {\Gamma, x:A, \Delta(\lambda i:I.x,r(x)) \vdash \beta^{\underline{ }.t}(x):Id_{C(\lambda i:I.x,r(x))}(J^{\underline{ }.t}(\lambda i:I.x,r(x)),t(x))}
          %p
            Note that in this rule, the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %mi I
                      %mo .
                      %mi x
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi J
                    %mrow
                      %munder
                        %mrow
                        %mo ̲
                      %mo .
                      %mi t
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi i
                  %mo :
                  %mi I
                  %mo .
                  %mi x
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
