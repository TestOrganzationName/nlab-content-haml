                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msubsup
                        %mi{:mathvariant => "normal"} topath
                        %mi 𝕀
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash x:A \quad \Gamma \vdash y:A \quad \Gamma \vdash p:x =_A y}{\Gamma \vdash \mathrm{topath}_\mathbb{I}^A(x, y, p):\mathbb{I} \to A}
          %p
            This is just another name for the recursor of the interval type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
