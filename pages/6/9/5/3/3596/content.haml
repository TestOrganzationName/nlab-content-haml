              = succeed "," do
                %a{:href => "https://www.cse.chalmers.se/research/group/logic/book/book.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/NordstromPeterssonSmith-TypeTheory.pdf", :title => "pdf"} pdf
          %p with early survey in §1.0.1 of:
          %ul
            %li#Warren08
              %a.existingWikiWord{:href => "/nlab/show/Michael+Warren"}> Michael Warren
              ,
              = succeed "," do
                %em Homotopy theoretic aspects of constructive type theory
              = succeed "," do
                %a{:href => "http://www.andrew.cmu.edu/user/awodey/students/warren.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Warren-HomotopyTypeTheory.pdf", :title => "pdf"} pdf
          %p For the two different ways of expressing the elimination and computation rules of identity types, see
          %ul
            %li#UFP13
