                        %annotation{:encoding => "application/x-tex"} \infty
              %em
                %a{:href => "https://conferences.cirm-math.fr/2689.html"} Logic and higher structures
              CIRM (Feb. 2022)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://emilyriehl.github.io/files/semantics.pdf"} pdf
              %a.existingWikiWord{:href => "/nlab/files/Riehl-InfinityToposSemantics.pdf", :title => "pdf"} pdf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            For more see the references at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
