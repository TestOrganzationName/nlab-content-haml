                      %mo ⊢
                      %mn 1
                      %mo :
                      %mi 𝕀
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash 0:\mathbb{I}} \quad \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash 1:\mathbb{I}}
          %p
            Usually, the
            %a.existingWikiWord{:href => "/nlab/show/recursion+principle"} recursion principle
            of the
            %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            is interpreted as a way to construct, from elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} y:A
            and identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
