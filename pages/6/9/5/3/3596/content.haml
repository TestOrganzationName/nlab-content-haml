                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi p
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash p:\mathbb{I} \to A}{\Gamma \vdash \mathrm{topath}_\mathbb{I}^A(p(0), p(1), \mathrm{toId}_A(p)) \equiv p:\mathbb{I} \to A}
          %h3#path_induction Path induction
          %p
            The associated path induction rule then says that the function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbb{I} \to A
            is a
            %a.existingWikiWord{:href => "/nlab/show/positive+copy"} positive copy
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
