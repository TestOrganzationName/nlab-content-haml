            are similarly defined as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/negative+types"} negative types
          %h3#inference_rules Inference rules
          %ul
            %li
              The formation rule of identity types state that given a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y:A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x =_A y
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, x:A, y:A \vdash x =_A y \; \mathrm{type}}
          %ul
            %li
              The introduction rule of identity types state that given a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and a path
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p:\mathbb{I} \to A
              %a.existingWikiWord{:href => "/nlab/show/identification"} identification
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} toId
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{toId}_A(p):p(0) =_A p(1)
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} toId
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash p:\mathbb{I} \to A}{\Gamma \vdash \mathrm{toId}_A(p):p(0) =_A p(1)}
          %p
            Normally, this would be
            %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} function application
            to the canonical identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝓅
                    %mo :
                    %mn 0
                    %msub
                      %mo =
                      %mi 𝕀
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{p}:0 =_\mathbb{I} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝓅
                %annotation{:encoding => "application/x-tex"} \mathcal{p}
            yet since we haven’t defined the identity type yet, and with this rule one can define said identification to be the identification of the identity function on the interval type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝓅
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} toId
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi 𝕀
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mn 0
                  %msub
                    %mo =
                    %mi 𝕀
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{p} \equiv \mathrm{toId}_\mathbb{I}(\mathrm{id}_\mathbb{I}):0 =_\mathbb{I} 1
          %p
            In addition, reflexivity of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            is given by sending the constant path of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            to its equality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} toId
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi i
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi x
                %annotation{:encoding => "application/x-tex"} \mathrm{refl}_A(x) \equiv \mathrm{toId}_{A}(\lambda i:\mathbb{I}.x):x =_A x
          %ul
            %li
              The elimination rule of identity types state that given a type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y:A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} p:x =_A y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi{:mathvariant => "normal"} topath
                        %mi 𝕀
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathrm{topath}_\mathbb{I}^A(x, y, p):\mathbb{I} \to A
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
