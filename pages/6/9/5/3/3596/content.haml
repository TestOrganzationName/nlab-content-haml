            %p
              By path induction on the type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo .
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} pts
                      %mi I
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\lambda i.f(\mathrm{pts}_I(i)), \mathrm{toId}_A(f))
              indexed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi f
                        %mo :
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo →
                        %mi A
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo .
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} pts
                      %mi I
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{\mathbb{I}_I \to A}(t):\prod_{f:\mathbb{I}_I \to A} C(\lambda i.f(\mathrm{pts}_I(i)), \mathrm{toId}_A(f))
            %p
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %msub
                      %mi 𝕀
                      %mi I
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{\mathbb{I}_I \to A}(t, \lambda i:\mathbb{I}.x) \equiv t(x):C(\lambda i:\mathbb{I}_I.x)
            %p since by definition of constant function and reflexivity, one has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi I
                    %mo ⊢
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %msub
                      %mi 𝕀
                      %mi I
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi i
                        %mo :
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo .
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi 𝓅
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i:I \vdash (\lambda i:\mathbb{I}_I.x)(i) \equiv x \quad \mathrm{ap}_{\lambda i:\mathbb{I}_I.x}(\mathcal{p}) \equiv \mathrm{refl}_A(x)
            %p We define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mover
                      %mi x
                      %mo ¯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J(t, \overline{x}, p) \equiv \mathrm{ind}_{\mathbb{I}_I \to A}(t, \mathrm{rec}_{\mathbb{I}_I, A}(\overline{x}, p))
            %p
              since by recursion of the walking identification of arity
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}_I, A}(\overline{x}, p):\mathbb{I} \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi I
                    %mo ⊢
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msub
                          %mi 𝕀
                          %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mover
                      %mi x
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} rec
                          %mrow
                            %msub
                              %mi 𝕀
                              %mi I
                            %mo ,
                            %mi A
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi x
                          %mo ¯
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} pts
                      %mi I
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} path
                      %mi I
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                  %annotation{:encoding => "application/x-tex"} i:I \vdash \mathrm{rec}_{\mathbb{I}_I, A}(\overline{x}, p)(i) \equiv \overline{x}(i) \quad \mathrm{ap}_{\mathrm{rec}_{\mathbb{I}_I, A}(\overline{x}, p)}(\mathrm{pts}_I, \mathrm{path}_I) \equiv p
            %p
          %p
            Thus, everything about identity types of arity
