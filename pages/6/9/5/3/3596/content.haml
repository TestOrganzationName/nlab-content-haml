                  %mi x
                %annotation{:encoding => "application/x-tex"} x = x
            (the “
            %a.existingWikiWord{:href => "/nlab/show/first+law+of+thought"}> first law of thought
            ”), in the same way that the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            are inductively generated by
            %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/successor"} successor
          %p
