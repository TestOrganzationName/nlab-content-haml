                      %mo ,
                      %mi z
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                      %mo ⊢
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi t
