                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi y
                      %mspace{:width => "1em"}
                      %msub
                        %mi{:mathvariant => "normal"} toId
                        %mi A
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi{:mathvariant => "normal"} topath
                        %mi 𝕀
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \mathrm{topath}_\mathbb{I}^A(x, y, p)(0) \equiv x \quad \mathrm{topath}_\mathbb{I}^A(x, y, p)(1) \equiv y \quad \mathrm{toId}_{A}(\mathrm{topath}_\mathbb{I}^A(x, y, p)) \equiv p
              %p
