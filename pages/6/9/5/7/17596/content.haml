                          %mrow
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} SU(N)
                %li
                  %a{:href => "#singularity_and_gauge_enhancement_2"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi D
                            %mi N
                        %annotation{:encoding => "application/x-tex"} D_{N}
                    \-singularity and
                    = succeed "-gauge" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi SO
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi N
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} SO(2N)
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#refrences"} Refrences
          %h2#idea Idea
          %p
            It is well understood that in
            %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
            there appears
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(N)
                %a.existingWikiWord{:href => "/nlab/show/enhanced+gauge+symmetry"} enhanced gauge symmetry
                on
                = succeed "-coincident" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(2N)
                enhanced gauge symmetry on
                = succeed "-coincident" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
                at an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/orientifold+plane"} orientifold plane
          %p
            The physical picture of this effect is that the gauge bosons of these
            %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            are the modes of the
            %a.existingWikiWord{:href => "/nlab/show/open+strings"} open strings
            stretching between these D-branes which become massless as the branes coincide.
          %p
            Now, as the situation is lifted to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D0-branes"} D0-branes
            %a.existingWikiWord{:href => "/nlab/show/D2-branes"} D2-branes
            and
            %a.existingWikiWord{:href => "/nlab/show/D4-branes"} D4-branes
            lift to
            %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            %a.existingWikiWord{:href => "/nlab/show/M-branes"} M-branes
            (as exhibited for the
            %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
            by the
            %a.existingWikiWord{:href => "/nlab/show/BLG-model"} BLG-model
            and
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/ABJM-model"} ABJM-model
          %p
            But for the
            %a.existingWikiWord{:href => "/nlab/show/D6-brane"} D6-brane
            the situation is different: the
            %a.existingWikiWord{:href => "/nlab/show/D6-brane"} D6-brane
            lifts not to an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M-brane"} M-brane
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+monopole"} Kaluza-Klein monopole
          %p#Picture
            Here we discuss the picture of how
            %a.existingWikiWord{:href => "/nlab/show/gauge+enhancement"} gauge enhancement
            on
            %a.existingWikiWord{:href => "/nlab/show/D6-branes"} D6-branes
            in
            %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
            is reflected on
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+monopoles"} Kaluza-Klein monopoles
            at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ADE-singularities"} ADE-singularities
            = succeed ")." do
              %a{:href => "#Sen97"} Sen 97
          %p
            %img{:alt => "ADE 2Cycle", :src => "http://ncatlab.org/nlab/files/ADESingularity.png", :width => "760"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "http://ncatlab.org/schreiber/show/Equivariant+homotopy+and+super+M-branes"} HSS18
          %h2#construction Construction
          %h3#singularity_and_gauge_enhancement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mrow
                      %mi N
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} A_{N-1}
            \-singularity and
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(N)
          %p
            The 11d multi-centered
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+monopole"} Kaluza-Klein monopole
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            has
            %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ds
                    %mn 2
                  %mo ≔
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi d
                  %msup
                    %mi t
                    %mn 2
                  %mo +
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 5
                    %mn 10
                  %mi d
                  %msup
                    %mi y
                    %mi n
                  %mi d
                  %msup
                    %mi y
                    %mi n
                  %mo +
                  %msubsup
                    %mi ds
                    %mi TN
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  ds^2
                  \\coloneqq
                  \- d t^2
                  + \underoverset{n = 5}{10}{\sum} d y^n d y^n
                  + ds^2_{TN}
                  \\,,
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ds
                    %mi TN
                    %mn 2
                  %mo ≔
                  %msup
                    %mi V
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msup
                    %mi x
                    %mn 4
                  %mo +
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} →
                  %mo ⋅
                  %mi d
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo +
                  %mi V
                  %mi d
                  %msup
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  ds^2_{TN}
                  \\coloneqq
                  V^{-1}( d x^4 + \vec \omega \cdot d \vec r )^2 + V d \vec r^2
          %p
            is the metric tensor of the multi-centered
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Taub-NUT+space"} Taub-NUT space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 4
                %annotation{:encoding => "application/x-tex"} x^4
            the canonical coordinate on a
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            and with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ≔
                  %mn 1
                  %mo +
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi I
                      %mo =
                      %mn 1
                    %mi N
                  %mfrac
                    %mrow
                      %mn 4
                      %mi m
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mo −
                      %msub
                        %mover
                          %mi r
                          %mo{:stretchy => "false"} →
                        %mi I
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"}
                  V \coloneqq 1 + \underoverset{I = 1}{N}{\sum} \frac{4m}{{\vert \vec r - \vec r_I\vert}}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo ∇
                    %mo{:stretchy => "false"} →
                  %mo ×
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} →
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mover
                    %mo ∇
                    %mo{:stretchy => "false"} →
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  \\vec \nabla \times \vec \omega = - \vec \nabla V
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi I
                  %msubsup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi I
                      %mo =
                      %mn 1
                    %mi N
                %annotation{:encoding => "application/x-tex"} \{\vec r_I\}_{I =1}^N
            the set of positions of the KK-monopoles of mass
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
          %p
            Notice that the radius
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 16
                  %mi π
                  %mi m
                  %msup
                    %mi V
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                %annotation{:encoding => "application/x-tex"} 16 \pi m V^{-1/2}
            of the
            = succeed "-circle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} x^4
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \vec r_I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi I
                %annotation{:encoding => "application/x-tex"} \vec r_I
            are distinct, then the above is a smooth spacetime also at the positions of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi I
                %annotation{:encoding => "application/x-tex"} \vec r_I
            – if the periodicity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 4
                %annotation{:encoding => "application/x-tex"} x^4
            is taken to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 16
                    %mi π
                    %mi m
                  %annotation{:encoding => "application/x-tex"} 16 \pi m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            monopole positions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi I
                %annotation{:encoding => "application/x-tex"} \vec r_I
            coincide, then the resulting metric has a
            %a.existingWikiWord{:href => "/nlab/show/conical+singularity"} conical singularity
            at that point, of
            %a.existingWikiWord{:href => "/nlab/show/ADE-singularity"} ADE-singularity
            type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mi N
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} A_{N-1}
          %div{:style => "float:left;margin:0 10px 10px 0;"}
            %img{:alt => "ADE 2Cycle", :src => "http://ncatlab.org/nlab/files/ADE2Cycle.jpeg", :width => "220"}/
          %p
            To see where the gauge enhancement arises from in this singular case, observe that in the non-singular configuration there are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} N-1
            linearly indepent 2-
            %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mi i
                      %mi j
                %annotation{:encoding => "application/x-tex"} S_{i j}
            in the multi-center KK-monopole spacetime, represented by the the
            %a.existingWikiWord{:href => "/nlab/show/2-spheres"} 2-spheres
            that are swept out by the circle fiber as it moves from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi i
                %annotation{:encoding => "application/x-tex"} \vec r_i
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi j
                %annotation{:encoding => "application/x-tex"} \vec r_j
            (remembering that the circle fiber radius vanishes precisely at the positions
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \vec r_I
          %p
            For the canonical choice of straight path between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi i
                %annotation{:encoding => "application/x-tex"} \vec r_i
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi j
                %annotation{:encoding => "application/x-tex"} \vec r_j
            (and arbitrary fixed position in the remaining 7 dimensions) then the
            %a.existingWikiWord{:href => "/nlab/show/surface"} surface
            %a.existingWikiWord{:href => "/nlab/show/area"} area
            of these
            %a.existingWikiWord{:href => "/nlab/show/2-spheres"} 2-spheres
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi vol
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 16
                  %mi π
                  %mi m
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mi i
                    %mo −
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mi j
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  vol(S_{i j}) = 16 \pi m  {\vert \vec r_i - \vec r_j\vert}
                  \\,.
          %p
            For any other choice of path the surface area will be larger. Hence an
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            with tension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mi M
                      %mn 2
                %annotation{:encoding => "application/x-tex"} T_{M2}
            %a.existingWikiWord{:href => "/nlab/show/wrapped+brane"} swrapping
            the 2-
            %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mi i
                      %mi j
                %annotation{:encoding => "application/x-tex"} S_{i j}
            has minimal tension energy when in the configuration of these spheres, namely
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mi j
                  %mo =
                  %mn 16
                  %mi π
                  %mi m
                  %msub
                    %mi T
                    %mrow
                      %mi M
                      %mn 2
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mi i
                    %mo −
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mi j
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  m_{i j} = 16 \pi m T_{M2} {\vert \vec r_i - \vec r_j\vert}
                  \\,.
          %p
            The type IIA limit is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} m \to 0
            %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
            wrapping the above cycles become the type IIA
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            %a.existingWikiWord{:href => "/nlab/show/KK-monopoles"} KK-monopoles
            become the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D6-branes"} D6-branes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mi i
                      %mi j
                %annotation{:encoding => "application/x-tex"} S_{i j}
            becomes an
            %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
            strentching between the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
          %p
            In the limit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} m \to 0
            the D6-branes coincide,the strings stretching between them become massless (in accord with the above formula for the wrapped M2-brane mass), and become the gauge bosons of an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(N)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
          %p
            (
            %a{:href => "Sen97"}> Sen 97, section 2
            )
          %h3#singularity_and_gauge_enhancement_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi N
                %annotation{:encoding => "application/x-tex"} D_{N}
            \-singularity and
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(2N)
          %p
            Now consider the above setupmodified by replacing the
            %a.existingWikiWord{:href => "/nlab/show/Taub-NUT+space"} Taub-NUT space
            with coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %msup
                    %mi x
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\vec r, x^4)
            by its
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            given by the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            with nontrivial operation given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %msup
                    %mi x
                    %mn 4
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mi x
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\vec r, x^4) \mapsto (- \vec r, - x^4)
          %p
            and in the Taub-NUT metric replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ≔
                  %mn 1
                  %mo −
                  %mfrac
                    %mrow
                      %mn 16
                      %mi m
                    %mi r
                  %mo +
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi N
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %mn 4
                        %mi m
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi r
                          %mo{:stretchy => "false"} →
                        %mo −
                        %msub
                          %mover
                            %mi r
                            %mo{:stretchy => "false"} →
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mo +
                    %mfrac
                      %mrow
                        %mn 4
                        %mi m
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi r
                          %mo{:stretchy => "false"} →
                        %mo +
                        %msub
                          %mover
                            %mi r
                            %mo{:stretchy => "false"} →
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V
                  \\coloneqq
                  1
                  \-
                  \\frac{16m}{r}
                  +
                  \\underoverset{i = 1}{N}{\sum}
                  \\left(
                  \\frac{4m}{\vert \vec r - \vec r_i\vert}
                  +
                  \\frac{4m}{\vert \vec r + \vec r_i\vert}
                  \\right)
                  \\,.
          %p
            The type IIA image of the origin of this configuration is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orientifold+plane"} orientifold plane
          %p
            Now as the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mi i
                %annotation{:encoding => "application/x-tex"} \vec r_i
            all approach 0 we get an 11d spacetime with a
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi N
                  %annotation{:encoding => "application/x-tex"} D_N
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ADE-singularity"} ADE-singularity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            D6-branes coincident on an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orientifold+plane"} orientifold plane
          %p
            (
