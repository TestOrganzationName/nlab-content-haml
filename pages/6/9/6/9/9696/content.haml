          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
                ,
                = succeed "," do
                  %em The Physics of Quantum Information
                = succeed "," do
                  %em The Physics of Quantum Information
                = succeed "&lbrack;" do
                  %a{:href => "https://arxiv.org/abs/2208.08064"} arXiv:2208.08064
            %li
