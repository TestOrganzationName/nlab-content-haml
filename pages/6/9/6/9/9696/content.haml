          %p and the outlook beyond:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
              \:
              = succeed "," do
                %em Beyond NISQ: The Megaquop Machine
              %em
                %a{:href => "https://q2b.qcware.com/2024-conferences/silicon-valley/"} Q2B 2024 Silicon Valley
              (Dec. 2024) &amp;lbrack;
              %a{:href => "https://www.preskill.caltech.edu/talks/Preskill-Q2B-2024.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://quantumfrontiers.com/2024/12/14/beyond-nisq-the-megaquop-machine/"} webpage
          %p
            On
