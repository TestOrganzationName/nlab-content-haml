          %h2#selected_writings Selected writings
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/magnetic+monopoles"} magnetic monopoles
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
              ,
              = succeed "," do
                %em Magnetic Monopoles
              %strong 34
              (1984) 461-530 &amp;lbrack;
              %a{:href => "https://doi.org/10.1146/annurev.ns.34.120184.002333"}> doi:10.1146/annurev.ns.34.120184.002333
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/topological+defects"} topological defects
            of higher
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            in
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            (cf.
            %a{:href => "QFT+with+defects#DefectsFromBrokenSymmetry"} here
            at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} QFT with defects
          %ul
            %li#PreskillVilenkin92
              %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Vilenkin"} Alexander Vilenkin
              = succeed "," do
                %em Decay of Metastable Topological Defects
              %strong 47
              (1993) 2324-2342 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-ph/9209210"}> arXiv:hep-ph/9209210
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1103/PhysRevD.47.2324"} doi:10.1103/PhysRevD.47.2324
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/vortex"} vortex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"} \;
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/anyons"} anyons
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hoi-Kwong+Lo"}> Hoi-Kwong Lo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
              = succeed "," do
                %em Non-Abelian vortices and non-Abelian statistics
              %strong 48
              (1993) 4821 &amp;lbrack;
              %a{:href => "https://doi.org/10.1103/PhysRevD.48.4821"}> doi:10.1103/PhysRevD.48.4821
              \&amp;rbrack;
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+quantum+computation"} topological quantum computation
          %ul
            %li
              R. Walter Ogburn,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
              = succeed "," do
                %em Topological Quantum Computation
              = succeed "," do
                %em Quantum Computing and Quantum Communications
              = succeed "," do
                %strong 1509
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/3-540-49208-9_31"} doi:10.1007/3-540-49208-9_31
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/quantum+error+correction"} quantum error correction
            for fault-tolerant/reliable
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
                ,
                = succeed "," do
                  %em Fault-tolerant quantum computation
                = succeed "," do
                  %em Introduction to Quantum Computation and Information
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/quant-ph/9712048"} arXiv:quant-ph/9712048
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/3724"} doi:10.1142/3724
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
                ,
                = succeed "," do
                  %em Reliable Quantum Computers
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/quant-ph/9705031"} arXiv:quant-ph/9705031
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1098/rspa.1998.0167"} doi:10.1098/rspa.1998.0167
            %li
              %p
                Panos Aliferis,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Gottesman"} Daniel Gottesman
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
                = succeed "," do
                  %em Quantum accuracy threshold for concatenated distance-3 codes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/quant-ph/0504218"} arXiv:quant-ph/0504218
          %p
            and via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+quantum+computation"} adiabatic quantum computation
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Childs"}> Andrew Childs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Farhi"} Edward Farhi
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
              = succeed "," do
                %em Robustness of adiabatic quantum computation
              %strong 65
              (2002) 012322 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/quant-ph/0108048"}> arXiv:quant-ph/0108048
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1103/PhysRevA.65.012322"} doi:10.1103/PhysRevA.65.012322
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Wilson+loops"} Wilson loops
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Beckman"}> David Beckman
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Gottesman"} Daniel Gottesman
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Kitaev"} Alexei Kitaev
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
              = succeed "," do
                %em Measurability of Wilson loop operators
              %strong 65
              (2002) 065022 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/0110205"}> arXiv:hep-th/0110205
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1103/PhysRevD.65.065022"} doi:10.1103/PhysRevD.65.065022
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/entanglement+entropy"} entanglement entropy
            as an indicator of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+phases+of+matter"} topological phases of matter
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexei+Kitaev"}> Alexei Kitaev
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
              = succeed "," do
                %em Topological entanglement entropy
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0510092"} arXiv:hep-th/0510092
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
                ,
                = succeed "," do
                  %em Quantum Computation
                = succeed ")" do
                  %a{:href => "http://theory.caltech.edu/~preskill/ph229/"} web
              %ul
                %li
                  %p
                    On
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/quantum+circuits"} quantum circuits
                  %p
                    %em Classical and quantum circuits
                    (
                    %a{:href => "http://theory.caltech.edu/~preskill/ph219/chap5_13.pdf"}> pdf
                    )
          %p
            Introducing the
            %a.existingWikiWord{:href => "/nlab/show/HaPPY+code"} HaPPY code
            %a.existingWikiWord{:href => "/nlab/show/tensor+network"} tensor network
            for discussion of
            %a.existingWikiWord{:href => "/nlab/show/holographic+entanglement+entropy"} holographic entanglement entropy
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+error+correction"} quantum error correction
          %ul
            %li#PYHP15
              %a.existingWikiWord{:href => "/nlab/show/Fernando+Pastawski"}> Fernando Pastawski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Beni+Yoshida"} Beni Yoshida
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Harlow"} Daniel Harlow
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
              = succeed "," do
                %em Holographic quantum error-correcting codes: Toy models for the bulk/boundary correspondence
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1503.06237"} arXiv:1503.06237
          %p Exposition:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
              ,
              = succeed "," do
                %em Is spacetime a quantum error-correcting code?
              = succeed "," do
                %a{:href => "http://theory.caltech.edu/~preskill/talks/Preskill-KITP-holographic-2015.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Preskill_SpacetimeQEC.pdf", :title => "pdf"} pdf
          %p
            Highlighting the role of
            %a.existingWikiWord{:href => "/nlab/show/quantum+entanglement"} quantum entanglement
            in
            %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
            and
            %a.existingWikiWord{:href => "/nlab/show/quantum+supremacy"} quantum supremacy
            (and introducing that term):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
              \:
              = succeed ":" do
                %em Quantum computing and the entanglement frontier
              = succeed "," do
                %em The Theory of the Quantum World – Proceedings of the 25th Solvay Conference on Physics
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1203.5813"} arXiv:1203.5813
              = succeed "," do
                %a{:href => "https://doi.org/10.1142/8674"} doi:10.1142/8674
              = succeed "&rbrack;" do
                %a{:href => "https://simons.berkeley.edu/sites/default/files/docs/394/preskilljohn.pdf"} pdf
          %p
            More on
            %a.existingWikiWord{:href => "/nlab/show/quantum+error+correcting+codes"} quantum error correcting codes
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/holographic+tensor+networks"} holographic tensor networks
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fernando+Pastawski"}> Fernando Pastawski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Preskill"} John Preskill
              = succeed "," do
                %em Code properties from holographic geometries
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1612.00017"} arXiv:1612.00017
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/noisy+intermediate-scale+quantum+computing"} noisy intermediate-scale quantum computing
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Preskill"}> John Preskill
              ,
              = succeed "," do
                %em Quantum Computing in the NISQ era and beyond
              = succeed "," do
