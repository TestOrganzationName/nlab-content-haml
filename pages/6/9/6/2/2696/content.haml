          %h2#classical_case Classical case
          %p
            The classical
            %strong Whitehead theorem
            asserts that:
          %p
          .num_theorem
            %h6 Theorem
            %p
              (
              %a{:href => "#Whitehead49"}> Whitehead 1949
              ) Every
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              between
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %p
            (See also the discussion at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/m-cofibrant+space"} m-cofibrant space
          %p
            Using the
            = succeed "-theorem" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
          .num_cor
            %h6#corollary Corollary
            %p
              In the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              every
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %h2#simplicial_version Simplicial version
          %p
          .num_theorem
            %h6 Theorem
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/simplicial+map"} simplicial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X\to Y
              between
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+equivalence"} simplicial homotopy equivalence
              if and only if for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              that make the following square commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi a
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi ι
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo ∃
                                %mi d
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi b
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial\Delta^n&amp;\stackrel{a}{\to}&amp;X\\
                    \\downarrow^\iota&amp;{}^{\exists d}\nearrow&amp;\downarrow^f\\
                    \\Delta^n &amp;\stackrel{b}{\to}&amp;Y\\
                    }
            %p
              there is a diagonal arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              that makes the upper triangle commutative and the lower triangle commutative up to a homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ×
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} h\colon \Delta^1\times\Delta^n\to Y
              that is constant on the boundary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                      %mo ×
                      %mo ∂
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta^1\times\partial\Delta^n
          %p Of course, this statement can be reformulated using homotopy groups like the version for topological spaces, but the above statement is more practical.
          %p
          .num_remark
            %h6 Remark
            %p In the above criterion, the boundary inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \partial\Delta^n\to\Delta^n
            %p
              can be replaced by any weakly equivalent
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
          %p
          .num_remark
            %h6 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is not a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %a.existingWikiWord{:href => "/nlab/show/barycentric+subdivisions"} barycentric subdivisions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \partial\Delta^n
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta^n
              %a.existingWikiWord{:href => "/nlab/show/simplicial+map"} simplicial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X\to Y
              between
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              if and only if for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k\ge0
              and for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              that make the following square commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Sd
                              %mi k
                            %mo ∂
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi a
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msup
                                  %mi Sd
                                  %mi k
                                %mi ι
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo ∃
                                %mi d
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi Sd
                              %mi k
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi b
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Sd^k \partial\Delta^n&amp;\stackrel{a}{\to}&amp;X\\
                    \\downarrow^{Sd^k \iota}&amp;{}^{\exists d}\nearrow&amp;\downarrow^f\\
                    Sd^k \Delta^n &amp;\stackrel{b}{\to}&amp;Y\\
                    }
            %p
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo ≥
                    %mi k
                  %annotation{:encoding => "application/x-tex"} l\ge k
              such that in the outer rectangle in the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Sd
                              %mi l
                            %mo ∂
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Sd
                              %mi k
                            %mo ∂
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi a
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msup
                                  %mi Sd
                                  %mi l
                                %mi ι
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msup
                                  %mi Sd
                                  %mi k
                                %mi ι
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi Sd
                              %mi l
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Sd
                              %mi k
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi b
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Sd^l \partial\Delta^n&amp;\to&amp;Sd^k \partial\Delta^n&amp;\stackrel{a}{\to}&amp;X\\
                    \\downarrow^{Sd^l \iota}&amp;&amp;\downarrow^{Sd^k \iota}&amp;&amp;\downarrow^f\\
                    Sd^l \Delta^n &amp;\to&amp;Sd^k \Delta^n &amp;\stackrel{b}{\to}&amp;Y\\
                    }
            %p we can find a diagonal arrow
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Sd
                      %mi l
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} d\colon Sd^l \Delta^n \to X
            %p that makes the upper triangle in the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Sd
                              %mi l
                            %mo ∂
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi a
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msup
                                  %mi Sd
                                  %mi l
                                %mi ι
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo ∃
                                %mi d
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi Sd
                              %mi l
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mi b
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Sd^l \partial\Delta^n&amp;\stackrel{a}{\to}&amp;X\\
                    \\downarrow^{Sd^l \iota}&amp;{}^{\exists d}\nearrow&amp;\downarrow^f\\
                    Sd^l \Delta^n &amp;\stackrel{b}{\to}&amp;Y\\
                    }
            %p commutative and the lower triangle commutative up to a homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Sd
                      %mi l
                    %mo{:stretchy => "false"} (
                    %msup
