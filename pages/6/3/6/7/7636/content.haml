          #SeelyEquivalence.num_theorem
            %h6#theorem_2 Theorem
            %p
              There are
              %a.existingWikiWord{:href => "/nlab/show/2-functors"} 2-functors
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
