          .num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Con
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Con(T)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
          %p
            (
            %a{:href => "#Seely"}> Seely, theorem 3.2
            )
          .proof
            %h6#proof_2 Proof
            %p
              Define the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Con
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
