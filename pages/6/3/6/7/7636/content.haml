            %a{:href => "#Seely"}> Seely, prop. 3.1
            )
          .proof
            %h6#proof Proof
            %p Constructions are straightforward. We indicated some of them.
            %p
              Notice that all
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              (as discussed there) are induced as soon as there are all
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Con
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Con(T)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
