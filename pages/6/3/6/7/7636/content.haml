                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Con(T)
              the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(T)(A)
              to have as objects the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
              and as morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi type
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi type
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a : A \vdash X(a) : type) \to (a : A \vdash Y(a) : type)
              the terms of dependent function type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi t
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a : A \vdash t : (X(a) \to Y(a)))
            %p
              This is cartesian closed by the same kind of argument as in the previous proof. It is now sufficient to exhibit a compatible
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              with the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
