          %h4#category_of_contexts Category of contexts
          .num_defn
            %h6#definition_2 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %strong
                %a.existingWikiWord{:href => "/nlab/show/category+of+contexts"} category of contexts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Con
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Con(T)
              is the category whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/types"} types
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f : A \to B
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/terms"} terms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
