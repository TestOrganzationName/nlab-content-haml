              %path#path2389{:d => "M 121.51454,404.3102 L 639.61519,186.51853", :style => "fill:none;fill-rule:evenodd;stroke:#000000;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;stroke-opacity:1"}
              %path#path2391{:d => "M 202.85714,254.09448 A 34.285713,61.42857 0 1 1 134.28571,254.09448 A 34.285713,61.42857 0 1 1 202.85714,254.09448 z", "sodipodi:cx" => "168.57143", "sodipodi:cy" => "254.09448", "sodipodi:rx" => "34.285713", "sodipodi:ry" => "61.42857", "sodipodi:type" => "arc", :style => "opacity:1;fill:#ffffff;fill-opacity:1;fill-rule:evenodd;stroke:#000000;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;marker:none;marker-start:none;marker-mid:none;marker-end:none;stroke-miterlimit:4;stroke-dasharray:none;stroke-dashoffset:0;stroke-opacity:1;visibility:visible;display:inline;overflow:visible;enable-background:accumulate", :transform => "matrix(0.8143313,0,0,0.8224064,60.410706,-1.7353843)"}
              %path#path3163{:d => "M 202.85714,254.09448 A 34.285713,61.42857 0 1 1 134.28571,254.09448 A 34.285713,61.42857 0 1 1 202.85714,254.09448 z", "sodipodi:cx" => "168.57143", "sodipodi:cy" => "254.09448", "sodipodi:rx" => "34.285713", "sodipodi:ry" => "61.42857", "sodipodi:type" => "arc", :style => "opacity:1;fill:#fffdfe;fill-opacity:1;fill-rule:evenodd;stroke:#000000;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;marker:none;marker-start:none;marker-mid:none;marker-end:none;stroke-miterlimit:4;stroke-dasharray:none;stroke-dashoffset:0;stroke-opacity:1;visibility:visible;display:inline;overflow:visible;enable-background:accumulate", :transform => "matrix(0.6487302,0,0,0.7455493,188.19371,-6.6397643)"}
              %path#path3165{:d => "M 202.85714,254.09448 A 34.285713,61.42857 0 1 1 134.28571,254.09448 A 34.285713,61.42857 0 1 1 202.85714,254.09448 z", "sodipodi:cx" => "168.57143", "sodipodi:cy" => "254.09448", "sodipodi:rx" => "34.285713", "sodipodi:ry" => "61.42857", "sodipodi:type" => "arc", :style => "opacity:1;fill:#fffdfe;fill-opacity:1;fill-rule:evenodd;stroke:#000000;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;marker:none;marker-start:none;marker-mid:none;marker-end:none;stroke-miterlimit:4;stroke-dasharray:none;stroke-dashoffset:0;stroke-opacity:1;visibility:visible;display:inline;overflow:visible;enable-background:accumulate", :transform => "matrix(0.676825,0,0,0.6872657,267.99957,-12.600074)"}
              %path#path3167{:d => "M 202.85714,254.09448 A 34.285713,61.42857 0 1 1 134.28571,254.09448 A 34.285713,61.42857 0 1 1 202.85714,254.09448 z", "sodipodi:cx" => "168.57143", "sodipodi:cy" => "254.09448", "sodipodi:rx" => "34.285713", "sodipodi:ry" => "61.42857", "sodipodi:type" => "arc", :style => "opacity:1;fill:#fffdfe;fill-opacity:1;fill-rule:evenodd;stroke:#000000;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;marker:none;marker-start:none;marker-mid:none;marker-end:none;stroke-miterlimit:4;stroke-dasharray:none;stroke-dashoffset:0;stroke-opacity:1;visibility:visible;display:inline;overflow:visible;enable-background:accumulate", :transform => "matrix(0.614871,0,0,-0.6371152,352.77903,305.95506)"}
              %path#path3211{:d => "M 276.5261,236.44499 C 437.3288,335.40514 437.3288,335.40514 437.3288,335.40514", "sodipodi:nodetypes" => "cc", :style => "fill:none;fill-rule:evenodd;stroke:#000000;stroke-width:1.04990613px;stroke-linecap:butt;stroke-linejoin:miter;stroke-opacity:1"}
              %text#text3215{"sodipodi:linespacing" => "125%", :style => "font-size:16px;font-style:normal;font-variant:normal;font-weight:normal;font-stretch:normal;text-align:start;line-height:125%;writing-mode:lr-tb;text-anchor:start;fill:#000000;fill-opacity:1;stroke:none;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;stroke-opacity:1;font-family:Bitstream Vera Sans;-inkscape-font-specification:Bitstream Vera Sans", :x => "412.48389", "xml:space" => "preserve", :y => "351.69116"}
                %tspan#tspan3217{"sodipodi:role" => "line", :x => "412.48389", :y => "351.69116"} base ray
              %path#path2450{:d => "M 202.85714,254.09448 A 34.285713,61.42857 0 1 1 134.28571,254.09448 A 34.285713,61.42857 0 1 1 202.85714,254.09448 z", "sodipodi:cx" => "168.57143", "sodipodi:cy" => "254.09448", "sodipodi:rx" => "34.285713", "sodipodi:ry" => "61.42857", "sodipodi:type" => "arc", :style => "opacity:1;fill:#fffdfe;fill-opacity:1;fill-rule:evenodd;stroke:#000000;stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;marker:none;marker-start:none;marker-mid:none;marker-end:none;stroke-miterlimit:4;stroke-dasharray:none;stroke-dashoffset:0;stroke-opacity:1;visibility:visible;display:inline;overflow:visible;enable-background:accumulate", :transform => "matrix(0.5637487,0,0,-0.5562563,430.14511,269.36854)"}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be an infinite cylinder with an infinite string of circles attached via a proper ray
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha: [0,\infty) \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(U_{i+1},x_{i+1})
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ,
                  %msub
                    %mi x
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(U_i,x_i)
            for fairly obvious choices of base points such that the limit groups of the resulting two inverse systems are non-isomorphic! (In the survey listed below, this example is examined in detail, and one of the limits is a free group on one element, the other is trivial! Definitely non-isomorphic!)
          %p
            This means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} lim \pi_1(\varepsilon(X))
            is not an invariant of the end. This phenomenon is linked to the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(\varepsilon(X))
            does not satisfy the
            %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
            for either choice of the base rays.
          %h3#waldhausen_boundary Waldhausen boundary
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are locally compact Hausdorff spaces, there is no obvious candidate for a space of proper maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℙ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{P}(X,Y)
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℙ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mi Proper
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi Δ
                      %mi n
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{P}(X,Y)_n = Proper(X\times \Delta^n,Y)
            = succeed "." do
              %em
                singular complex of the mythical space of proper maps from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          .un_defn
            %h6#definition_2 Definition
            %p
              The
              %strong Waldhausen boundary
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the simplicial set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℙ
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{P}([0,\infty),X)
          %p
            There is an epimorphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0(\mathbb{P}([0,\infty),X))
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e(X)
          %ul
            %li
              %p
                In the example above of the cylinder with the string of circles attached,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi ℙ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0(\mathbb{P}([0,\infty),X))
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi ℙ
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(\mathbb{P}([0,\infty),X))
                maps onto
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi lim
                        %mi S
                      %annotation{:encoding => "application/x-tex"} lim S
            %li
              %p
                When
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                has a single end and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi ε
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0(\varepsilon(X))
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi ℙ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0(\mathbb{P}([0,\infty),X))
          %h3#second_attempt Second attempt
          %p
            Even if we did not have the above difficulty with the limit groups, we would still have the problem that, as the limit functor is not exact, the resulting limiting homotopy groups would not be that well behaved. There would not be any general long exact sequence results (just as with
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+homology"} Čech homology
          %p
            One fairly obvious attempt to define a ‘fundamental group’ for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha: [0,\infty) \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            gives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℙ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{P}([0,\infty),X)
            a base point so we could look at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi α
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(\mathbb{P}([0,\infty),X),\alpha)
            and more generally at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(\mathbb{P}([0,\infty),X),\alpha)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %munder
                        %munder
                          %mi π
                          %mo ̲
                        %mo ̲
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{\underline{\pi}}_n(X,\alpha)
          %p
            There are variants ‘at infinity’ of both the Waldhausen boundary and these groups, obtained using germs instead of proper maps. These will be denoted with a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            as a super- or suffix on the above notation.
          %h3#browngrossman_homotopy_groups Brown–Grossman homotopy groups
          %p
            (Once over lightly here, more details at
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Brown-Grossman+homotopy+group"} Brown-Grossman homotopy group
            %a.existingWikiWord{:href => "/nlab/show/spherical+objects"} spherical objects
            and the resulting ‘groups’ (better thought of as ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \Pi_\mathcal{A}
            \-
            %a.existingWikiWord{:href => "/nlab/show/spherical+object+and+Pi%28A%29-algebra"}> algebras
            ’) have a rich structure. They are discussed at
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Brown-Grossman+homotopy+group"} Brown-Grossman homotopy group
            = succeed "s," do
              %span.newWikiWord
                Steenrod homotopy group
                %a{:href => "/nlab/new/Steenrod+homotopy+group"} ?
          %h2#to_do To do!
          %ul
            %li Add stuff on Steenrod homotopy groups both for here and for strong shape theory entries.
          %h2#references References
          %p Survey article:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim Porter
              ,
              = succeed "," do
                %em Proper Homotopy Theory
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Algebraic+Topology"} Handbook of Algebraic Topology
          %p Books:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans-Joachim+Baues"} H. J. Baues
                and A. Quintero,
                = succeed "," do
                  %em Infinite homotopy theory
            %li
              %p
                Bruce Hughes and Andrew Ranicki,
                = succeed "," do
                  %em Ends of Complexes
          %p Lecture Notes:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/D.+A.+Edwards"} D. A. Edwards
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/H.+M.+Hastings"} H. M. Hastings
              %em Čech and Steenrod Homotopy Theory with Applications,
              SLNM 542, Springer (1976).
        .revisedby
