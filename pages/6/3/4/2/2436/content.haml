              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+differential+graded-commutative+superalgebras"} model structure on differential graded-commutative superalgebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supergeometry"} geometry of physics – supergeometry
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Felix+A.+Berezin"} Felix A. Berezin
                (edited by
                = succeed "):" do
                  %a.existingWikiWord{:href => "/nlab/show/Alexandre+A.+Kirillov"} Alexandre A. Kirillov
                = succeed "," do
                  %em
                    Linear Algebra in
                    = succeed "-graded" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi ℤ
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                = succeed "," do
                  %em Introduction to Superanalysis
                = succeed "," do
                  %strong 9
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-94-017-1963-6_4"} doi:10.1007/978-94-017-1963-6_4
            %li#Varadarajan04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Veeravalli+Varadarajan"}> Veeravalli Varadarajan
                , section 3.1 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Supersymmetry+for+mathematicians"}> Supersymmetry for mathematicians
                    \: An introduction
                = succeed "," do
                  %strong 11
