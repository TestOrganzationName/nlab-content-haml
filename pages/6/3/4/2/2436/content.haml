                        \&amp; \searrow^\mathrlap{\ell_x \otimes id_y} &amp;
                        \\\
                        1 \otimes (x \otimes y)
                        \&amp; \underset{\ell_{x \otimes y}}{\longrightarrow} &amp; x \otimes y
                        }
                        \\,;
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
