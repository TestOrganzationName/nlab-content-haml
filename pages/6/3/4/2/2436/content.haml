          #SymmetricMonoidalCategory.num_defn
            %h6#definition_7 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              is a
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo ⊗
                    %mi y
                    %mo →
                    %mi y
                    %mo ⊗
                    %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{x,y} \colon x \otimes y \to y \otimes x
            %p satisfies the condition:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi y
                        %mo ,
                        %mi x
                    %mo ∘
                    %msub
                      %mi τ
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                    %mo =
                    %msub
                      %mn 1
                      %mrow
                        %mi x
                        %mo ⊗
                        %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{y,x} \circ \tau_{x,y} = 1_{x \otimes y}
            %p
              for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x, y
          #SymmetricMonoidalCategoriesCoherenceTheorem.num_remark
            %h6#remark_2 Remark
            %p
              In analogy to the
              %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+monoidal+categories"} coherence theorem for monoidal categories
              (remark
              = succeed "," do
                %a.maruku-ref{:href => "#CoherenceForMonoidalCategories"}
              %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+symmetric+monoidal+categories"} coherence theorem for symmetric monoidal categories
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              = succeed ")" do
                %a.maruku-ref{:href => "#CoherenceForMonoidalCategories"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associators"} associators
              %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/braidings"} braidings
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of objects.
          %p
            Consider the simplest non-trivial special case of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
            from example
            = succeed "," do
              %a.maruku-ref{:href => "#GradedVectorSpacesAsAMonoidaCategory"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}/2
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+two"} cyclic group of order two
          #Z2Zgradedvectorspaces.num_example
            %h6#example_4 Example
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                \-
