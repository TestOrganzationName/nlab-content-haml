          %h2#idea Idea
          %p
            A
            %strong super vector space
            is an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in the non-trivial
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            of the underlying
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
            is taken to be the non-trivial linear map which on elements of homogeneous degree is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi τ
                    %mi super
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi v
                  %mo ⊗
                  %mi w
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi w
                  %mo ⊗
                  %mi v
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tau^{super}
                  \\;\colon\;
                  v \otimes w \;\mapsto\; (-1)^{deg(v) deg(w)} \, w \otimes v
                  \\,.
          %p
            We make this precise as definition
            %a.maruku-ref{:href => "#CategoryOfSuperVectorSpaces"}
            below.
          %p
            Super vector spaces form the basis of
            %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
            (over
            %a.existingWikiWord{:href => "/nlab/show/ground+rings"} ground rings
            which are
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            = succeed "," do
              %a{:href => "#StructuresInternalToSuperVectorSpaces"} below
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+superalgebra"} geometry of physics – superalgebra
          %h2#details Details
          #VectorSpaces.num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Vect
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Vect_k
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/object"} objects
                  are
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphisms
                  are
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
                  between these.
            %p
              When the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is understood or when its precise nature is irrelevant, we will often notationally suppress it and speak of just the category
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              of vector spaces.
            %p
              This is the category inside which
              %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
              takes place.
          %p
            Of course the category
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            has some special properties. Not only are its objects “linear spaces”, but the whole category inherits linear structure of sorts. This is traditionally captured by the following terminology for
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/additive+and+abelian+categories"} additive and abelian categories
          #AdditiveAndAbelianCategories.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
            %ol
              %li
                %p
                  Say that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  has
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
                  if it has
                  %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                  and
                  %a.existingWikiWord{:href => "/nlab/show/finite+coproducts"} finite coproducts
                  and if the canonical comparison morphism between these is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊕
                        %mi W
                      %annotation{:encoding => "application/x-tex"} V \oplus W
                  for the direct sum of two objects of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  Say that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is an
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
                  if it has
                  %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
                  and in addition it is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} enriched in abelian groups
                  %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                  is equipped with the structure of an
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                  such that
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of morphisms is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
              %li
                %p
                  Say that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is an
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
                  if it is an
                  %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
                  and has property that its
                  %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
                  are precisely the inclusions of
                  %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
                  and its
                  %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
                  are precisely the projections onto
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
          %p
            We also make the following definition of
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
            to require on a linear category:
          #LinearCategory.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              (or more generally just a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-
                %a.existingWikiWord{:href => "/nlab/show/linear+category"} linear category
              if
            %ol
              %li
                %p
                  it is an
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#AdditiveAndAbelianCategories"}
              %li
                %p
                  its
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                  have the structure of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
                  (generally
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/modules"} modules
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of morphisms in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
            %p
              and the underlying additive
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              structure of these
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              is that of the underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %p
              In other words, a
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              with the additional structure of a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              (generally
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              = succeed "-enriched)" do
                %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enrichment
              according to def.
              %a.maruku-ref{:href => "#AdditiveAndAbelianCategories"}
              is obtained from the
              = succeed "-enrichment" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Vect
                    %annotation{:encoding => "application/x-tex"} Vect
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Vect
                      %mo →
                      %mi Ab
                    %annotation{:encoding => "application/x-tex"} Vect \to Ab
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              between
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-
                %a.existingWikiWord{:href => "/nlab/show/linear+functor"} linear functor
              if its component functions on
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              are
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              with respect to the given
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
          .num_example
            %h6#example Example
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi k
                  %annotation{:encoding => "application/x-tex"} {}_k
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorSpaces"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/linear+category"} linear category
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#LinearCategory"}
            %p
              Here the abstract
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              is the usual direct sum of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ,
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V,W
              two
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{Vect}(V,W)
              of
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} \phi \colon V \to W
              is given by “pointwise” multiplication and addition of functions:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo +
                    %msub
                      %mi c
                      %mn 2
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi v
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi c
                      %mn 2
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (c_1 \phi_1 + c_2 \phi_2)
                    \\;\colon\,
                    v \;\mapsto\;
                    c_1 \phi_1(v) + c_2 \phi_2(v)
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} c_1, c_2 \in k
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mn 1
                      %mo ,
                      %msub
                        %mi ϕ
                        %mn 2
                      %mo ∈
                      %msub
                        %mi Hom
                        %mi Vect
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi W
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi_1, \phi_2 \in Hom_{Vect}(V,W)
          %p
            Recall the basic construction of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
          #TensorProductOfVectorSpaces.num_defn
            %h6#definition_4 Definition
            %p
              Given two
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              over some
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                      %mo ,
                      %msub
                        %mi V
                        %mn 2
                      %mo ∈
                      %msub
                        %mi Vect
                        %mi k
                    %annotation{:encoding => "application/x-tex"} V_1, V_2 \in Vect_k
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
              is the vector space denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %msub
                      %mo ⊗
                      %mi k
                    %msub
                      %mi V
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"}
                    V_1 \otimes_k V_2 \;\in\; Vect
            %p
              whose elements are
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v_1,v_2)
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi i
                      %mo ∈
                      %msub
                        %mi V
                        %mi i
                    %annotation{:encoding => "application/x-tex"} v_i \in V_i
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi c
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (c v_1 , v_2) \;\sim\; (v_1, c v_2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo +
                    %mi v
                    %msub
                      %mo ′
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi v
                    %msub
                      %mo ′
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (v_1 + v'_1 , v_2) \; \sim \; (v_1,v_2) + (v'_1, v_2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo +
                    %mi v
                    %msub
                      %mo ′
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi v
                    %msub
                      %mo ′
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (v_1 , v_2 + v'_2) \; \sim \; (v_1,v_2) + (v_1, v'_2)
            %p
              More abstractly this means that the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
              is the vector space characterized by the fact that
            %ol
              %li
                %p
                  it receives a
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 1
                        %mo ×
                        %msub
                          %mi V
                          %mn 2
                        %mo ⟶
                        %msub
                          %mi V
                          %mn 1
                        %mo ⊗
                        %msub
                          %mi V
                          %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        V_1 \times V_2 \longrightarrow V_1 \otimes V_2
                %p
                  (out of the
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                  of the underlying sets)
              %li
                %p
                  any other
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 1
                        %mo ×
                        %msub
                          %mi V
                          %mn 2
                        %mo ⟶
                        %msub
                          %mi V
                          %mn 3
                      %annotation{:encoding => "application/x-tex"}
                        V_1 \times V_2 \longrightarrow V_3
                %p
                  factors through the above bilinear map via a unique
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi V
                                  %mn 1
                                %mo ×
                                %msub
                                  %mi V
                                  %mn 2
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi bilinear
                              %mtd
                                %msub
                                  %mi V
                                  %mn 3
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ↗
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo ∃
                                      %mo !
                                      %mspace{:width => "thinmathspace"}
                                      %mi linear
                            %mtr
                              %mtd
                                %msub
                                  %mi V
                                  %mn 1
                                %msub
                                  %mo ⊗
                                  %mi k
                                %msub
                                  %mi V
                                  %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        V_1 \times V_2 &amp;\overset{bilinear}{\longrightarrow}&amp; V_3
                        \\\
                        \\downarrow &amp; \nearrow_{\mathrlap{\exists ! \, linear}}
                        \\\
                        V_1 \otimes_k V_2
                        }
          %p
            The existence of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
            = succeed "," do
              %a.maruku-ref{:href => "#TensorProductOfVectorSpaces"}
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            of vector spaces with extra structure, which is a “
            %a.existingWikiWord{:href => "/nlab/show/categorification"}> categorification
            ” of the familiar structure of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/semi-group"} semi-group
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/semi-group"} semi-group
            and therefore
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            operation are also called
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
          #MonoidalCategory.num_defn
            %h6#definition_5 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              equipped with
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo ×
                        %mi 𝒞
                        %mo ⟶
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"}
                        \\otimes
                        \\;\colon\;
                        \\mathcal{C} \times \mathcal{C}
                        \\longrightarrow
                        \\mathcal{C}
                %p
                  out of the
                  %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  with itself, called the
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %li
                %p an object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"}
                        1 \in \mathcal{C}
                %p
                  called the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
                  or
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        a
                        \\;\colon\;
                        ((-)\otimes (-)) \otimes (-)
                        \\overset{\simeq}{\longrightarrow}
                        (-) \otimes ((-)\otimes(-))
                %p
                  called the
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              %li#MonoidalCategoryUnitors
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℓ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\ell
                        \\;\colon\;
                        (1 \otimes (-))
                        \\overset{\simeq}{\longrightarrow}
                        (-)
                %p
                  called the
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/left+unitor"} left unitor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mn 1
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        r \;\colon\; (-) \otimes 1 \overset{\simeq}{\longrightarrow} (-)
                %p
                  called the
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/right+unitor"} right unitor
            %p
              such that the following two kinds of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commute
            %ol
              %li
                %p
                  %strong> triangle identity
                  \:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi x
