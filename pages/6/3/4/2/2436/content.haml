              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (Line(\mathcal{C}), \otimes, 1)
                    \\hookrightarrow
                    (\mathcal{C}, \otimes, 1)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L \in \mathcal{C}
              which are
              %a.existingWikiWord{:href => "/nlab/show/invertible+objects"} invertible objects
              under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L^{-1} \in \mathcal{C}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊗
                    %msup
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ≃
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} L \otimes L^{-1} \simeq 1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ⊗
                      %mi L
                      %mo ≃
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} L^{-1} \otimes L \simeq 1
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              is clearly in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(L)
              (with
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ≃
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1^{-1} \simeq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo ,
                    %msub
                      %mi L
                      %mn 2
                    %mo ∈
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L_1, L_2 \in Line(\mathcal{C}) \hookrightarrow \mathcal{C}
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi L
                      %mn 2
                    %mo ∈
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L_1 \otimes L_2 \in Line(\mathcal{C})
              (with
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi L
                        %mn 1
                      %mo ⊗
                      %msub
                        %mi L
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ≃
                      %msubsup
                        %mi L
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ⊗
                      %msubsup
                        %mi L
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} (L_1 \otimes L_2)^{-1} \simeq L_2^{-1} \otimes L_1^{-1}
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              restricts to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Line(\mathcal{C})
            %p
              Accordingly any
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes,1)
              restricts to a braiding on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Line(\mathcal{C}), \otimes, 1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Line(\mathcal{C}), \otimes, 1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Line(\mathcal{C}, \otimes , 1))
              is necessarily a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              (the “
              %a.existingWikiWord{:href => "/nlab/show/Picard+groupoid+of+a+monoidal+category"}> Picard groupoid
              ” of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
              %a.existingWikiWord{:href => "/nlab/show/homotopy+1-type"} homotopy 1-type
              with group structure, and as such it it is equivalent to its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mo ⊗
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B_\otimes Line(\mathcal{C})
            %p
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+type"} pointed homotopy type
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(Line(\mathcal{C}))
                    \\simeq
                    \\pi_1(B Line(\mathcal{C}))
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of the delooping space.
            %p
              Now a symmetric braiding on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(\mathcal{C})
              is precisely the structure that makes it a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+2-group"} symmetric 2-group
              which is equivalently the structure of a second
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 2
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^2 Line(\mathcal{C})
              (for the braiding) and then a third delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mn 3
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^3 Line(\mathcal{C})
              (for the symmetry), regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+type"} pointed homotopy type
            %p
              This way we have rephrased the question equivalently as a question about the possible
              %a.existingWikiWord{:href => "/nlab/show/k-invariants"} k-invariants
              of spaces of this form.
            %p
              Now in the case at hand,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(Vect^{\mathbb{Z}/2})
              has precisely two
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of objects, namely the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              itself, regarded as being in even degree and regarded as being in odd degree. We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} k^{1\vert 0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{0 \vert 1}
              for these, respectively. By the rules of the tensor product of
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    k^{1\vert 0} \otimes_k k^{1\vert 0} \simeq k^{1\vert 0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    k^{1\vert 0} \otimes_k k^{0\vert 1} \simeq k^{0\vert 1}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    k^{0 \vert 1} \otimes_k k^{0 \vert 1} \simeq k^{1 \vert 0}
                    \\,.
            %p In other words
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(Line(Vect^{\mathbb{Z}/2})) \simeq \mathbb{Z}/2
                    \\,.
            %p Now under the above homotopical identification the non-trivial braiding is identified with the elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo =
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi τ
                          %mrow
                            %msup
                              %mi k
                              %mrow
                                %mn 0
                                %mo{:stretchy => "false"} |
                                %mn 1
                            %mo ,
                            %msup
                              %mi k
                              %mrow
                                %mn 0
                                %mo{:stretchy => "false"} |
                                %mn 1
                          %mi super
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    1 =
                    k^{1 \vert 0}
                    \\simeq
                    k^{0\vert 1} \otimes_k k^{0 \vert 1}
                    \\stackrel{\tau^{super}_{k^{0\vert 1}, k^{0 \vert 1}}}{\longrightarrow}
                    k^{0\vert 1} \otimes_k k^{0\vert 1}
                    \\simeq
                    k^{1 \vert 0}
                    \= 1
            %p
              Due to the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetry
              condition (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi τ
                      %mrow
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                        %mo ,
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                      %mi super
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"}
                    (\tau^{super}_{k^{0\vert 1}, k^{0 \vert 1}})^2 = id
            %p which implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi τ
                      %mrow
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                        %mo ,
                        %msup
                          %mi k
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                      %mi super
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi id
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi id
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau^{super}_{k^{0\vert 1}, k^{0 \vert 1}}
                    \\in
                    \\{+ id, -id\}
                    \\,.
            %p
              Therefore for classifying just the symmetric braidings, it is sufficient to restrict the
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(Vect^{\mathbb{Z}/2})
              from being either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              or empty, to
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              being
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2 = \{+1-1\} \hookrightarrow k
              or empty. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Line
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widetilde{Line}(sVect)
              for the resulting
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            %p
              In conclusion then the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of possible
              %a.existingWikiWord{:href => "/nlab/show/k-invariants"} k-invariants
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mn 3
                      %mi Line
                      %mo{:stretchy => "false"} (
                      %mi sVect
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B^3 Line(sVect)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Vect
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Line(Vect^{\mathbb{Z}/2})
              are in the degree-4
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z}/2,3)
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^4(K(\mathbb{Z}/2, 3), \mathbb{Z}/2)
                    \\;\simeq\;
                    \\mathbb{Z}/2
                    \\,.
          #CategoryOfSuperVectorSpaces.num_defn
            %h6#definition_8 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
            %ul
              %li
                %p
                  whose underlying
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                  is that of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Z2Zgradedvectorspaces"}
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi τ
                          %mi super
                      %annotation{:encoding => "application/x-tex"} \tau^{super}
                  from prop.
                  %a.maruku-ref{:href => "#TheTwoNontrivialBraidingsOnZ2GradedVectorSpaces"}
            %p
              is called the
              = succeed ":" do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/category+of+super+vector+spaces"} category of super vector spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sVect
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Vect
                      %mi k
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ,
                    %mo ⊗
                    %mo =
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mn 1
                    %mo =
                    %mi k
                    %mo ,
                    %mi τ
                    %mo =
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sVect_k
                    \\;\coloneqq\;
                    (Vect_k^{\mathbb{Z}/2}, \otimes = \otimes_k, 1 = k, \tau = \tau^{super} )
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p The non-full symmetric monoidal subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi Line
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\widetilde{Line}(sVect), \otimes_k, k, \tau^{super})
            %p of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Line
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi k
                    %mo ,
                    %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (Line(sVect) , \otimes_k, k, \tau^{super})
                    \\hookrightarrow
                    (sVect, \otimes_k, k, \tau^{super})
            %p
              (on the two objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} k^{1\vert 0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{0\vert 1}
              and with
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              restricted to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo ⊂
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \{+1,-1\} \subset k
              = succeed ")" do
                %a.maruku-ref{:href => "#TheTwoNontrivialBraidingsOnZ2GradedVectorSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/truncated+object+of+an+%28infinity%2C1%29-category"} 1-truncation
              of the
              %a.existingWikiWord{:href => "/nlab/show/looping"} looping
              of the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+space"} E-infinity space
              (“
              %a.existingWikiWord{:href => "/nlab/show/abelian+infinity-group"}> abelian infinity-group
              ”)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi Line
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi sVect
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi k
                    %mo ,
                    %msup
                      %mi τ
                      %mi super
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} trunc
                      %mn 1
                    %mi Ω
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\widetilde{Line}(sVect), \otimes, k, \tau^{super})
                    \\;\simeq\;
                    \\trunc_1 \Omega \mathbb{S}
                    \\,.
            %p
              It has been suggested (in
              = succeed ")" do
                %a{:href => "super+algebra#Kapranov15"} Kapranov 15
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
              super-grading (and hence
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
              over the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              is just the analog of the group of
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
          %h2#properties Properties
          %h3#StructuresInternalToSuperVectorSpaces Structures internal to super-vector spaces
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalizing
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            and
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            in the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            of super vector spaces, one obtains the corresponding
            %a.existingWikiWord{:href => "/nlab/show/superalgebra"} superalgebra
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
          %p For example
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sVect
                    %annotation{:encoding => "application/x-tex"} sVect
                are
                %a.existingWikiWord{:href => "/nlab/show/super+algebras"} super algebras
                and, more interestingly,
                %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sVect
                    %annotation{:encoding => "application/x-tex"} sVect
                are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} supercommutative superalgebra
            %li
              %p
                hence for example
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebras"} commutative Hopf algebras
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sVect
                    %annotation{:encoding => "application/x-tex"} sVect
                are equivalently
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/supercommutative+Hopf+algebras"} supercommutative Hopf algebras
                %a.existingWikiWord{:href => "/nlab/show/formal+duals"} formal duals
                of affine algebraic
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/supergroups"} supergroups
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sVect
                    %annotation{:encoding => "application/x-tex"} sVect
                are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
                modeled on objects of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sVect
                    %annotation{:encoding => "application/x-tex"} sVect
                are
                %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            %li
              %p etc.
          %p
            By the above definition, any structure in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            works just like the corresponding structure in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
          %h3#delignes_theorem_on_tensor_categories Deligne’s theorem on tensor categories
          %p
            %a.existingWikiWord{:href => "/nlab/show/Deligne%27s+theorem+on+tensor+categories"} Deligne's theorem on tensor categories
            says that all suitable
            %a.existingWikiWord{:href => "/nlab/show/tensor+categories"} tensor categories
            of subexponential growth have a
            %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} fiber functor
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sVect
                %annotation{:encoding => "application/x-tex"} sVect
            and are equivalent to
            %a.existingWikiWord{:href => "/nlab/show/categories+of+representations"} categories of representations
            of affine algebraic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergroups"} supergroups
