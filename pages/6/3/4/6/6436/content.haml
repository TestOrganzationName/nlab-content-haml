                            %a.existingWikiWord{:href => "/nlab/show/11d+Chern-Simons+theory"} 11d Chern-Simons theory
                          %ul
                            %li
                              %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
                    %li
                      %p
                        %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dijkgraaf-Witten+theory"} ∞-Dijkgraaf-Witten theory
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/AKSZ+sigma-model"} AKSZ sigma-model
                  %div
                    %p
                      %a{:href => "/nlab/edit/infinity-Chern-Simons+theory+-+contents"} Edit this sidebar
          %blockquote
            %p
              This is a subentry of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
          %hr/
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#exposition_of_classical_models"}
                  Exposition of classical
                  = succeed "-models" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi σ
                        %annotation{:encoding => "application/x-tex"} \sigma
              %ul
                %li
                  %a{:href => "#ExpositionNewtonianParticle"} The Newtonian particle
                %li
                  %a{:href => "#RelativisticParticle"} The relativistic particle
                %li
                  %a{:href => "#RelativisticNBrane"}
                    The relativistic
                    = succeed "-brane" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (n-1)
                %li
                  %a{:href => "#RelativisticString"} The relativistic string
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#exposition_of_classical_models
            Exposition of classical
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            We survey, starting from the very basics,
            %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
            aspects of
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/particles"} particles
            %a.existingWikiWord{:href => "/nlab/show/strings"} strings
            and
            %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            on geometric
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/target+spaces"} target spaces
          %h3#ExpositionNewtonianParticle The Newtonian particle
          %p
            With hindsight, the earliest
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
          %p
            In order to describe the motion of matter
            %a.existingWikiWord{:href => "/nlab/show/particles"} particles
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/space"} space
            %a.existingWikiWord{:href => "/nlab/show/Isaac+Newton"} Isaac Newton
            wrote down a
            %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            with the famous symbols
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} →
                  %mo =
                  %mi m
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\vec F = m \vec a
                  \\,.
          %p More in detail, this is meant to describe the following situation:
          %ul
            %li
              %p
                write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo :
                      %mo =
                      %msup
                        %mi ℝ
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} X := \mathbb{R}^3
                for the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                3; think of this as a model for physics space;
            %li
              %p
                write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo :
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \Sigma := \mathbb{R}
                for the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                1; think of this as the abstract trajectory of a point particle;
            %li
              %p
                write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo :
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \gamma : \Sigma \to X
                for a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p write furthermore
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} →
                          %mo :
                          %mo =
                          %mover
                            %mi γ
                            %mo ˙
                          %mo ∈
                          %mi Hom
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mi Σ
                          %mo ,
                          %mi T
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \vec v := \dot \gamma \in Hom(T \Sigma, T X)
                    for the
                    %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                    of
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi γ
                          %annotation{:encoding => "application/x-tex"} \gamma
                    %a.existingWikiWord{:href => "/nlab/show/velocity"} velocity
                    of the particle; and
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi a
                            %mo{:stretchy => "false"} →
                          %mo :
                          %mo =
                          %mover
                            %mi γ
                            %mo ¨
                        %annotation{:encoding => "application/x-tex"} \vec a := \ddot \gamma
                    for the second
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                    %a.existingWikiWord{:href => "/nlab/show/acceleration"} acceleration
                    of the particle (strictly speaking this is the
                    %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                    with respect to the trivial
                    %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                    on the (canonically trivialized)
                    %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                    on
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℝ
                              %mn 3
                          %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
                    %a{:href => "#RelativisticParticle"} below
                    for the fully fledged discussion).
          %p
            We call then the collection of all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conf
                  %mo :
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Conf := C^\infty(\Sigma, X)
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of a physical model of a point particle propagating on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p In order to define the model – the model of some physical situation –
          %ul
            %li
              %p
                pick a
                %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} →
                      %mo ∈
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \vec F \in \Gamma(T X)
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/force"} force
                acting on the particle with trajectory.
              %p
                For instance
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} →
                      %mo :
                      %mo =
                      %mi q
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec F := q \vec E
                could be an
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electric field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec E
                influencing the propagation of an electrically charged particle of
                %a.existingWikiWord{:href => "/nlab/show/charge"} charge
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                      %annotation{:encoding => "application/x-tex"} q
          %p In modern language we may say:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is the
                %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
                of the particle;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is the
                %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
                (expressing the fact that it is the
                %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
                of a function
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo :
                        %mi Σ
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \gamma : \Sigma \to X
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec F
                is the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
          %p
            and the collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo ,
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Sigma, X, \vec F)
            of all three is a
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              \-model
            \.
          %p
            Given this data, the space of solutions to the original
            %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi γ
                  %mo ∈
                  %mi Conf
                  %mo{:stretchy => "false"} |
                  %mo ∀
                  %mi t
                  %mo ∈
                  %mi ℝ
                  %mo :
                  %msub
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} →
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mi m
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  P := \{ \gamma \in Conf | \forall t \in \mathbb{R} : \vec F_{\gamma(t)} = m \vec a(t) \}
          %p
            is called the
            %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            of the model. The configurations in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ⊂
                  %mi Conf
                %annotation{:encoding => "application/x-tex"} P \subset Conf
            have the interpretation of being those potential configurations, that describe actual trajectories of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
          %p
            Notice that in the case of vanishing
            %a.existingWikiWord{:href => "/nlab/show/force"} force
            field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} →
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \vec F = 0
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of the
            %a{:href => "#ExpositionNewtonianParticle"} Newtonian particle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\vec a = 0
          %p
            may be read as characterizing precisely the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/geodesic"} geodesic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            using the canonical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
            %a{:href => "#RelativisticParticle"} relativistic particle
            discussed below.
          %p
            A cautionary note is in order. While the Newtonian particle may serve as an introductory example for motivating the concept of
            = succeed "-models," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-models." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/relativistic+particle"} relativistic particle
            to which we turn next.
          %h3#RelativisticParticle The relativistic particle
          %p
            The Newtonian particle propagating on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
            = succeed "," do
              %a{:href => "#ExpositionNewtonianParticle"} above
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            being called a theory of
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/general+relativity"} relativity
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/relativistic+particle"} relativistic particle
          %p
            The
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/target+space"} Target space
                is a
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,g)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %li
              %p
                Parameter space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
                of the particle.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
                is given by a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle bundle with connection
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} 1-form
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \in \Omega^1(X)
                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mo =
                      %mi d
                      %mi A
                    %annotation{:encoding => "application/x-tex"} F := d A
                is the
                %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
                of an
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
                is the
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                (or rather
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Conf
                      %mo =
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi Diff
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      Conf = C^\infty(\mathbb{R}, X)//Diff(\mathbb{R})
                      \\,,
              %p
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma \to X
                by
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mover
                          %mo →
                          %mo ≃
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma \stackrel{\simeq}{\to} \Sigma
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                in
                %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
                is a trajectory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo :
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \gamma : \Sigma \to X
                of a particle in spacetime, each morphism/equivalence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mn 1
                      %mover
                        %mo →
                        %mo ≃
                      %msub
                        %mi γ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \gamma_1 \stackrel{\simeq}{\to} \gamma_2
                \: a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                – the subspace of the configuration space of those configurations that satisfy the
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
                – is defined to be
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} [
                      %mi γ
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Conf
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi m
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∇
                        %mover
                          %mi γ
                          %mo ˙
                      %mover
                        %mi γ
                        %mo ˙
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi γ
                          %mo ˙
                      %mo{:stretchy => "false"} |
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi q
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo ˙
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} }
                      %mo ⊂
                      %mi Conf
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      P =
                      \\{ [\gamma] \in Conf
                      |\;\;
                      m g(\nabla_{\dot \gamma} \dot \gamma/{\vert \dot \gamma}\vert , - ) =  q F(\dot \gamma, -)
                      \\;\; \}
                      \\subset Conf
                      \\,,
              %p where
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∇
                        %annotation{:encoding => "application/x-tex"} \nabla
                    denotes the
                    %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                    of the
                    %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
                    of the background metric
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                        %annotation{:encoding => "application/x-tex"} g
                    on the
                    %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                          %mi X
                        %annotation{:encoding => "application/x-tex"} T X
                    of
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                %li
                  %p
                    the equation is taken to hold in each
                    %a.existingWikiWord{:href => "/nlab/show/cotangent+space"} cotangent space
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi T
                            %mrow
                              %mi γ
                              %mo{:stretchy => "false"} (
                              %mi τ
                              %mo{:stretchy => "false"} )
                            %mo *
                          %mi X
                        %annotation{:encoding => "application/x-tex"} T^*_{\gamma(\tau)} X
                    for each
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi τ
                            %mo ∈
                            %mi ℝ
                          %annotation{:encoding => "application/x-tex"} \tau \in \mathbb{R}
          %p
            To see what this means, consider some special cases. First regard the case that the background field strength vanishes,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} F = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mover
                      %mi γ
                      %mo ˙
                  %mover
                    %mi γ
                    %mo ˙
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{\dot \gamma} \dot \gamma = 0
                  \\,.
          %p
            This says that the trajectory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            exhibits
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            of its tangent vectors with respect to the
            %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
            of the background metric. These curves are precisely the
            %em
              %a.existingWikiWord{:href => "/nlab/show/geodesics"} geodesics
            of the background geometry. This models motion under the
            %a.existingWikiWord{:href => "/nlab/show/force"} force
            exerted by the field of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            on our particle.
          %p
            In the even more special case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 4
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^4, \eta) \simeq (X,g)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mover
                    %mo →
                    %mi γ
                  %msup
                    %mi ℝ
                    %mn 4
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi x
                        %mn 0
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R} \stackrel{\gamma}{\to} \mathbb{R}^4 \stackrel{x^0}{\to} \mathbb{R}
            is the identity, hence for which the
            %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
            parameter coincides precisely with the chosen global time coordinate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mo =
                  %msup
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} t := x^0
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} →
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \vec a = 0
          %p
            Remaining in the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+space"} Minkowski space
            but allowing now a nontrivial background field, notice that we may write the 2-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            always as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %msub
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} →
                    %mi i
                  %mo ⋅
                  %mi d
                  %msup
                    %mi x
                    %mi i
                  %mo ∧
                  %mi d
                  %mi t
                  %mo +
                  %msup
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} →
                    %mi i
                  %msub
                    %mi ϵ
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mi d
                  %msup
                    %mi x
                    %mi j
                  %mo ∧
                  %mi d
                  %msup
                    %mi x
                    %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F = \vec E_i \cdot d x^i \wedge d t + \vec B^i \epsilon_{i j k} d x^j \wedge d x^k
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} →
                  %mo ∈
                  %msup
                    %mi ℝ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \vec E \in \mathbb{R}^3
            is the electric field strength vector and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} →
                  %mo ∈
                  %msup
                    %mi ℝ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \vec B \in \mathbb{R}^3
            the magnetic field strength vector. The spatial part of the above equations of motion are in this case again as for a Newtonian particle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo =
                  %mi q
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mi q
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} →
                  %mo ×
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} →
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  m \vec a = q \vec E + q \vec v \times \vec B
                  \\,,
          %p
            where in the second term we have the
            %a.existingWikiWord{:href => "/nlab/show/cross+product"} cross product
            of vectors in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
            %a.existingWikiWord{:href => "/nlab/show/force"} force
            on the right is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+force"} Lorentz force
            exerted by an electromagnetic field on a charged particle.
          %p
            Notice that the equations of motion imply, generally, that the
            %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi γ
                    %mo ˙
                %annotation{:encoding => "application/x-tex"} \dot \gamma
            is constant along the trajectory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mfrac
                            %mi d
                            %mrow
                              %mi d
                              %mi τ
                          %mi g
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi γ
                            %mo ˙
                          %mo ,
                          %mover
                            %mi γ
                            %mo ˙
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 2
                          %mi g
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∇
                            %mover
                              %mi γ
                              %mo ˙
                          %mover
                            %mi γ
                            %mo ˙
                          %mo ,
                          %mover
                            %mi γ
                            %mo ˙
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 2
                          %mi g
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi γ
                            %mo ˙
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mover
                            %mi γ
                            %mo ˙
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ∝
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi γ
                            %mo ˙
                          %mo ,
                          %mover
                            %mi γ
                            %mo ˙
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\frac{d}{d \tau} g(\dot \gamma, \dot \gamma)
                  \&amp;= 2 g(\nabla_{\dot \gamma} \dot \gamma, \dot \gamma)
                  \\\
                  \&amp; =
                  2 g(g^{-1}(F(\dot \gamma,-), -), \dot \gamma)
                  \\\
                  \&amp; \propto F(\dot \gamma, \dot \gamma)
                  \\\
                  \&amp; =
                  0
                  \\end{aligned}
                  \\,.
          %p
            Therefore a trajectory that solves the equations of motion and whose tangent vector is
            %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
            or
            %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
          %p
            Experiments around the second half of the 19th and the beginning of the 20th century established that this covariant phase space correctly describes the dynamics of gravitationally and electromagnetically charged relativistic particles. But also formally this phase space is not a randomly chosen space; instead, it is the
            %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
            of a (mathematically) natural
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          %p
            The points in the
            %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} [
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi Conf
                  %mo{:stretchy => "false"} |
                  %mi m
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∇
                    %mover
                      %mi γ
                      %mo ˙
                  %mover
                    %mi γ
                    %mo ˙
                  %mo{:stretchy => "false"} /
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi γ
                      %mo ˙
                  %mo{:stretchy => "false"} |
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi q
                  %msub
                    %mi ι
                    %mover
                      %mi γ
                      %mo ˙
                  %mi F
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %mi Conf
                %annotation{:encoding => "application/x-tex"}
                  P := \{ [\gamma] \in Conf |
                  m g(\nabla_{\dot \gamma} \dot \gamma / {\vert \dot \gamma}\vert,-) =  q\iota_{\dot \gamma} F
                  \\}
                  \\subset Conf
          %p
            happen to be the local critical points of the
            %a.existingWikiWord{:href => "/nlab/show/nonlinear+functional"} functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi Conf
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  S : Conf \to \mathbb{R}
          %p given by
          #eq:ParticleActionForGlobalA.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %mi γ
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo :
                          %mo =
                          %msub
                            %mi S
                            %mi kin
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %mi γ
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo +
                          %msub
                            %mi S
                            %mi gauge
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %mi γ
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo :
                          %mo =
                          %mi m
                          %msub
                            %mo ∫
                            %mi Σ
                          %mi dvol
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi γ
                            %mo *
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi q
                          %msub
                            %mo ∫
                            %mi Σ
                          %msup
                            %mi γ
                            %mo *
                          %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  S([\gamma])
                  \&amp; :=
                  S_{kin}([\gamma])
                  +
                  S_{gauge}([\gamma])
                  \\\
                  \&amp;
                  \:=
                  m \int_\Sigma dvol(\gamma^*g)  + q \int_\Sigma \gamma^* A
                  \\end{aligned}
                  \\,,
          %p
            where on the left we have the integral of the
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            of the pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi γ
                    %mo *
                  %mi g
                  %mo ∈
                  %msup
                    %mi Sym
                    %mn 2
                  %msup
                    %mi T
                    %mo *
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \gamma^* g \in Sym^2 T^* \Sigma
            of the metric on target space to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
          %p
            This is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of the relativistic particle
            = succeed "-model." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "," do
              %em kinetic action
            %em gauge coupling
            action.
          %p
            Typically one characterizes
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            is then given as their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
          %p
            Notably the above action functional has an evident generalization to the case where the background
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            is not given by a globally defined 1-form, but more generally by a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle bundle with connection
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Conf
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(-)) : Conf \to U(1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi kin
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi q
                  %msub
                    %mo ∫
                    %mi Σ
                  %msup
                    %mi γ
                    %mo *
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(\gamma)) =
                  \\exp(S_{kin}(\gamma))
                  \\;\;
                  \\exp(i q \int_\Sigma \gamma^* A)
          %p
            the second factor is precisely the
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            over the worldline. Hence for general electromagnetic background gauge fields the action functional is (assuming for simplicity now closed curves with
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = S^1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi kin
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi hol
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(\gamma))
                  \=
                  \\exp(S_{kin}(\gamma))
                  \\;\;
                  hol(\nabla, \gamma)
                  \\,.
          %p
            This is the beginning of an important pattern: most
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            (a cocycle in the
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            that is the
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher holonomy
            functional of this gauge field.
          %p
            At the same time the kinetic action functional factor is usually to be understood as part of the
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            on
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conf
                  %annotation{:encoding => "application/x-tex"} Conf
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mi γ
                      %mo ∈
                      %mi Conf
                  %mi hol
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi kin
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %mi γ
                      %mo ∈
                      %mi Conf
                  %mi hol
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mi d
                  %msub
                    %mi μ
                    %mi Wien
                %annotation{:encoding => "application/x-tex"}
                  \\int_{\gamma \in Conf} hol(\nabla,\gamma) \;\;\exp(i S_{kin}(\gamma)) [d \gamma]
                  \:=
                  \\int_{\gamma \in Conf} hol(\nabla,\gamma) d \mu_{Wien}
          %p
            can be interpreted as the
            %a.existingWikiWord{:href => "/nlab/show/integral"} integral
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/Wiener+measure"} Wiener measure
            on path space (after
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Wick+rotation"} Wick rotation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi μ
                    %mi Wien
                %annotation{:encoding => "application/x-tex"} d \mu_{Wien}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi kin
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi d
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo =
                  %mi d
                  %msub
                    %mi μ
                    %mi Wien
                  %mspace{:width => "thinmathspace"}
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S_{kin}(\gamma)) [d\gamma] := d \mu_{Wien}
                  \\,;
          %p
            (at least after replacing the kinetic
            %a.existingWikiWord{:href => "/nlab/show/Nambu-Goto+action"} Nambu-Goto action
            by the classically equivalent
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Polyakov+action"} Polyakov action
          %p
            Since there is a good general abstract theory of higher gauge fields and their higher holonomies (see
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            and
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} differential cohomology in a cohesive topos
            = succeed "-models." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a{:href => "Exposition"} below
          %h3#RelativisticNBrane
            The relativistic
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %p
            It is hard not to consider the following generalization of the relativistic particle
            = succeed "-model," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ":" do
              %a{:href => "#RelativisticParticle"} above
          %p
            notice that nothing in the structure of the relativistic particle’s
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.maruku-eqref{:href => "#eq:ParticleActionForGlobalA"} (1)
            relies on the
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            being
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "-models," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %ul
            %li
              %p
                let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                be of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                let
                %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
                be a
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,g)
                as before;
            %li
              %p
                let the
                %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
                be given by a smooth
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential n-form
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msup
                          %mi Ω
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \in \Omega^n(X)
            %li
              %p
                let
                %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
                be the
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} weak quotient
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Conf
                        %mi Σ
                      %mo :
                      %mo =
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi Diff
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Conf_\Sigma := C^\infty(\Sigma, X)//Diff(\Sigma)
                      \\,.
            %li
              %p
                let then finally the
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                be given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi γ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mi Σ
                      %mi dvol
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi γ
                        %mo *
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mo ∫
                        %mi Σ
                      %msup
                        %mi γ
                        %mo *
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      S([\gamma]) = \int_\Sigma dvol(\gamma^* g) + \int_\Sigma \gamma^* A
                      \\,.
          %p
            This is the same formula as for the relativistic particle as before, only that now the differential forms are taken to be of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and integrals to be over
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Moreover, for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            there is an analog of the generalization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo −
                  %mi forms
                  %mo{:stretchy => "false"} }
                  %mo ↪
                  %mo{:stretchy => "false"} {
                  %mi circle
                  %mi bundles
                  %mi with
                  %mi connection
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{1-forms\} \hookrightarrow \{circle bundles with connection\}
          %p to the generalization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo −
                  %mi forms
                  %mo{:stretchy => "false"} }
                  %mo ↪
                  %mo{:stretchy => "false"} {
                  %mi circle
                  %mi n
                  %mo −
                  %mi bundles
                  %mi with
                  %mi connection
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{n-forms\} \hookrightarrow \{circle n-bundles with connection\}
                  \\,.
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            and closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            %a.existingWikiWord{:href => "/nlab/show/nonlinear+functional"} functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hol
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mover
                    %mo →
                    %mi γ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi hol
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  hol(\nabla, -) : (\Sigma \stackrel{\gamma}{\to} X) \mapsto
                  hol(\nabla, \gamma) \in U(1)
          %p
            that extends the functional
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \mapsto \exp(i \int_\Sigma \gamma^* A)
          %p
            Therefore, generally, we may take for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to be a
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                      %annotation{:encoding => "application/x-tex"} \nabla
            %li
              %p
                the exponentiated
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                to be
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi γ
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %msub
                        %mo ∫
                        %mi Σ
                      %mi dvol
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi γ
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi hol
                      %mo{:stretchy => "false"} (
                      %mo ∇
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [\gamma] \mapsto \exp(i \int_\Sigma dvol(\gamma^* )) \;\;\; hol(\nabla,\gamma)
                      \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n = 3
            such a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/membrane"} membrane
            = succeed "." do
              %em
                relativistic
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                %a.existingWikiWord{:href => "/nlab/show/brane"} brane
          %p
            The case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            is called the relativistic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string"} string
            = succeed "." do
              %a{:href => "#RelativisticString"} below
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            re-appear in one way or other in the study of the string (as its boundary
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi n
                    %mo ≤
                    %mn 10
                  %annotation{:encoding => "application/x-tex"} 0 \leq n \leq 10
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M-theory+membrane"} M-theory membrane
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/electric-magnetic+duality"} electric-magnetic dual
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/NS5-brane"} NS5-brane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            in the
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-model)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            Another important special case for the general discussion of
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/membrane"} membrane
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            is a
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
            for some
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            some suitable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
            of the
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∇
                    %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CS(\nabla_\mathfrak{g})
            of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \nabla_{\mathfrak{g}}
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            is (locally) the
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mover
                    %mo →
                    %mi γ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mo ∫
                    %mi Σ
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi γ
                    %mo *
                  %msub
                    %mo ∇
                    %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\Sigma \stackrel{\gamma}{\to} X) \mapsto \int_\Sigma CS(\gamma^* \nabla_\mathfrak{g})
                  \\,.
          %p
            Below we will see that when
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
            a suitable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %em universal
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            is no longer a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            incarnation of a
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
          %h3#RelativisticString The relativistic string
          %p
            The important case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            of the general
            %a{:href => "RelativisticNBrane"} (n-1)-brane sigma-model
            that we considered above is called the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/string"} string
            = succeed "-model." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            aspects, that appear in this dimension.
          %p
            First notice that by the general reasoning of relativistic
            = succeed "-branes," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            is now given (if we assume for the moment a topological trivial class) by a 2-form, which is traditionally denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B \in \Omega^2(X)
            and called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            is traditionally denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo :
                    %mo =
                    %mi d
                    %mi B
                  %annotation{:encoding => "application/x-tex"} H := d B
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of the
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/string"} string
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            with background gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mo ↦
                  %msub
                    %mo ∫
                    %mi Σ
                  %mi dvol
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi γ
                    %mo *
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mo ∫
                    %mi Σ
                  %msup
                    %mi γ
                    %mo *
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\gamma] \mapsto \int_\Sigma dvol(\gamma^* g) + \int_\Sigma \gamma^* B
                  \\,.
          %p
            To gain insight into the physical meaning of this, consider the simple case that
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            is
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            and that the
            %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %mi ℝ
                  %mo ×
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R} \times S^1
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi τ
                  %mo ,
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\tau,\sigma)
            the two canonical
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi γ
                    %mo ˙
                  %mo :
                  %mo =
                  %msub
                    %mo ∂
                    %mi τ
                  %mi γ
                %annotation{:encoding => "application/x-tex"}
                  \\dot \gamma := \partial_\tau \gamma
          %p
            for the derivative “along the trajectory” (along the
            = succeed "-factor)," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi σ
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \partial_\sigma \gamma
            which we may think of as being
            %em tangential to the string
            at any instant of its trajectory. A field configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mi Σ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma : \Sigma \to X
            may be thought of as the trajectory of a
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            propagating in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The critical trajectories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mi Σ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma : \Sigma \to X
            are found to be those that satisfy the 2-dimensional
            %a.existingWikiWord{:href => "/nlab/show/wave+equation"} wave equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi γ
                    %mo ¨
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mo ∂
                    %mi σ
                    %mn 2
                  %mi γ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi γ
                    %mo ˙
                  %mo ,
                  %msub
                    %mo ∂
                    %mi σ
                  %mi γ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  g(\ddot \gamma,-)  - g(\partial_\sigma^2 \gamma,-)
                  \=
                  H(\dot \gamma, \partial_\sigma \gamma,-)
          %p
            on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
            %a{:href => "#RelativisticParticle"} relativistic particle
            shows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∂
                    %mi σ
                  %mi γ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(\partial_\sigma \gamma, -,-)
            plays the role of an electromagnetic
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            2-form. Hence the string behaves as if electric
            %a.existingWikiWord{:href => "/nlab/show/charge"} charge
            is spread out evenly along it.
          %p
            For
            %em point particle limit configurations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %mi γ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial_\sigma \gamma = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi γ
                    %mo ¨
                  %mo =
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\ddot \gamma = \vec a = 0
          %p
            and for general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            to the corresponding
            %a.existingWikiWord{:href => "/nlab/show/geodesic"} geodesic
            motion.
          %p
            Therefore close to these point particle configurations the string looks like a little oscillating loop whose dynamics is that of its “center of mass” point, but slightly modified by the energy in the oscillations and the way these interact with the background fields. After quantization of the
            = succeed "-model," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %p
            Next we have a look at aspects of higher
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            that appears in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
          %p
            The above 2-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is in general just the local connection form of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi X
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha : X \to \mathbf{B}^2 U(1)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            with connection.
          %p
            There is a canonical 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/infinity-representation"} 2-representation
            of the
            %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle 2-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B} U(1)
            on
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/2-vector+space"} 2-vector space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 2
                  %mi Vect
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\rho : \mathbf{B} \mathbf{B}U(1) \to 2 Vect
                  \\,.
          %p
            Hence the corresponding
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated 2-bundle
            is classified by a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mover
                    %mo →
                    %mi g
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ρ
                  %mn 2
                  %mi Vect
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\rho(g) : X \stackrel{g}{\to} \mathbf{B}^2 U(1)
                  \\stackrel{\rho}{\to}
                  2 Vect
                  \\,.
          %p
            One can consider the string
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            – called
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo →
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mi D
                      %mo −
                      %mi brane
                %annotation{:encoding => "application/x-tex"} V : \mathbf{1} \to \rho(g)|_{D-brane}
            of the background gauge field
            %a.existingWikiWord{:href => "/nlab/show/n-vector+bundle"} 2-vector bundle
            restricted to the
            = succeed "-brane." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted vector bundle
            on the brane, where the twist is the class in
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^3(X, \mathbb{Z})
            of the background gauge field. More generally, these twisted bundles are cocycles in
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"} differential K-theory
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            appears on the target space for the string in the presence of string boundaries.
          %p
            More generally, the structure
            %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            of the background
            %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            need not be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [U(1) \to 1]
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(U(1))
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U(1) \to Aut(U(1)) \simeq \mathbb{Z}_2)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(U(1))
            %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equivalently a double cover of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariance
            under the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            %em
              string
              %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifold
            background. This is a kind of
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher structure
            that the relativistic particle alone cannot see.
          %p
            More such higher structure appears as one passes to the
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            analogs of the
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            %a.existingWikiWord{:href => "/nlab/show/fermion"} fermion
            fields that this brings with it (both on
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            as well as on the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
            forces the above background
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle"} circle 2-bundle
            to become a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted 2-bundle
            %a.existingWikiWord{:href => "/nlab/show/fivebrane"} fivebrane
            %a.existingWikiWord{:href => "/nlab/show/charge"} charge
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
            %em
              %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
          %p
            These are the first examples of a general phenomenon: as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            increases, a background gauge
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/harmonic+map"} harmonic map
