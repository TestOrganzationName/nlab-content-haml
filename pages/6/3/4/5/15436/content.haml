              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine
                      and
                      %a.existingWikiWord{:href => "/nlab/show/projective+line"} projective line
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                    (
                    %a.existingWikiWord{:href => "/nlab/show/integers"}> integers
                    )
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
