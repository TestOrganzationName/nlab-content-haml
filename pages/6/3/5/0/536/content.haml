                                    %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi X
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi s
                                  %mi i
                                %mo{:stretchy => "false"} )
                              %mtd
                                %munder
                                  %mo →
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi s
                                      %mi i
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi Y
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi s
                                  %mi i
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X(\prod_i s_i) &amp; \overset{f(\prod_i s_i)}{\to} &amp; Y(\prod_i s_i) \\
                        \\mathllap{X(\pi)} \downarrow &amp; &amp; \downarrow \mathrlap{Y(\pi_i)} \\
                        X(s_i) &amp; \underset{f(s_i)}{\to} &amp; Y(s_i)
                        }
                %p
                  and the fact that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  preserves products, we see that the component of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
