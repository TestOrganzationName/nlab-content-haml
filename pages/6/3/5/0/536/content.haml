              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi Π
                          %mi op
                    %mi Kl
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi y
                    %mi Prod
                    %mo{:stretchy => "false"} (
                    %mi Kl
                    %mo{:stretchy => "false"} (
                    %mi T
