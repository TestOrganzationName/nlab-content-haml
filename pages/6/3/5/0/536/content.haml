                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Π
                      %mi op
                    %mo :
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo →
                    %mi Kl
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi^{op}: Set/S \to Kl(T)
              is left adjoint to the underlying functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo :
                      %mi Kl
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
