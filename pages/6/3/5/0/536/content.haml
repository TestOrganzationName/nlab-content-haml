                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                      %annotation{:encoding => "application/x-tex"} S \stackrel{i}{\to} (Set/S)^{op} \to Kl(T)^{op}
                %p From the naturality of the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi X
                                %mo{:stretchy => "false"} (
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                  %mi i
                                %msub
                                  %mi s
                                  %mi i
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %munder
                                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                      %mi i
                                    %msub
                                      %mi s
                                      %mi i
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi Y
                                %mo{:stretchy => "false"} (
