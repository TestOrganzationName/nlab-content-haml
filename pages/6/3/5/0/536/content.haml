          %p In the other direction, we have
          .un_thm
            %h6#theorem_3 Theorem 3
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be an
              = succeed "-sorted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %p
            We assume for convenience that the product-preserving functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \Pi: (Set/S)^{op} \to C
            is the identity on the class of objects.
          .proof
            %h6#proof_4 Proof
            %p
              We need to exhibit a comparison functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Kl
                      %mo{:stretchy => "false"} (
                      %mi T
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} Kl(T)^{op} \to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is the monad of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \Pi: (Set/S)^{op} \to C
              has a left adjoint whose associated monad is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mover
                      %mo →
                      %mi y
                    %mi Prod
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi Prod
                        %mo{:stretchy => "false"} (
                        %mi Π
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi Prod
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{op} \stackrel{y}{\to} Prod(C, Set) \stackrel{Prod(\Pi, 1)}{\to} Prod((Set/S)^{op}, Set)
            %p
              sends an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
              to the product-preserving functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi Π
                    %mo −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} C(c, \Pi-): (Set/S)^{op} \to Set
              which, by the remark above, is represented by an object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Set/S
              which we denote as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi U
                        %mi op
                      %mi c
                    %annotation{:encoding => "application/x-tex"} U^{op} c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi Π
                    %mo −
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi U
                      %mi op
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(c, \Pi-) \cong (Set/S)^{op}(U^{op} c, -)
            %p
              and by the usual Yoneda yoga, we obtained a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi U
                      %mi op
                    %mo :
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} U^{op}: C \to (Set/S)^{op}
              which is left adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Pi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is, by definition (see theorem 1) the monad associated with the adjoint pair
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Π
                        %mi op
                      %mo :
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi S
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ⊣
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo :
                      %mi C
                      %mo →
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi^{op}: Set/S \to C) \dashv (U: C \to Set/S)
            %p
              We thus obtain the comparison functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Kl
                      %mo{:stretchy => "false"} (
                      %mi T
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} Kl(T)^{op} \to C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Kl
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi U
                    %msup
                      %mi Π
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Kl(T)^{op}(f, g) \cong (Set/S)^{op}(f, T(g)) \cong (Set/S)^{op}(f, U\Pi^{op}(g)) \cong C(\Pi(f), \Pi(g))
            %p and hence the comparison functor is an equivalence.
          %h3#algebras_and_models Algebras and models
          %p
            Each
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of the monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            gives rise to a model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi X
                %annotation{:encoding => "application/x-tex"} M_X
            of the Lawvere theory:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Kl
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ↪
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Kl(T)^{op} \hookrightarrow Alg(T)^{op} \stackrel{\hom(-, X)}{\to} Set
          %p
            and similarly a morphism of algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            gives rise to a homomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi f
                    %mo :
                    %msub
                      %mi M
                      %mi X
                    %mo →
                    %msub
                      %mi M
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} M_f: M_X \to M_Y
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo :
                    %mi Alg
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M: Alg(T) \to Mod(Th(T), Set)
          %p It is convenient to proceed as follows. By Theorem 2, the underlying functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
