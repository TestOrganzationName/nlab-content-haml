              is an equivalence.
          .proof
            %h6#proof_5 Proof
            %p In outline, this proceeds as follows:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is essentially surjective, because if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a
                  = succeed "-algebra," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi M
                          %mi X
                        %mo :
                        %mi Kl
                        %mo{:stretchy => "false"} (
                        %mi T
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} M_X: Kl(T)^{op} \to Set
                  is a product-preserving functor such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi M
                            %mi X
                          %mo{:stretchy => "false"} )
                          %mo ≅
                          %mi X
                        %annotation{:encoding => "application/x-tex"} A(M_X) \cong X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is full, because any algebra map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f: X \to Y
                  gives rise to a model homomorphism
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi M
                            %mi f
                          %mo :
                          %msub
                            %mi M
                            %mi X
                          %mo →
                          %msub
                            %mi M
                            %mi Y
                        %annotation{:encoding => "application/x-tex"} M_f: M_X \to M_Y
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is faithful. For this it suffices to prove that the underlying functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo :
                        %mi Prod
                        %mo{:stretchy => "false"} (
                        %mi Kl
                        %mo{:stretchy => "false"} (
                        %mi T
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Set
                        %mo{:stretchy => "false"} /
                        %mi S
                      %annotation{:encoding => "application/x-tex"} U: Prod(Kl(T)^{op}, Set) \to Set/S
                %p
                  is faithful. Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f: X \to Y
                  be a morphism of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Prod
                          %mo{:stretchy => "false"} (
                          %mi Kl
                          %mo{:stretchy => "false"} (
                          %mi T
                          %msup
                            %mo{:stretchy => "false"} )
