              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Kl
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
