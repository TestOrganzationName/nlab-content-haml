                                  %mi s
                                  %mi i
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mi X
                                    %mo{:stretchy => "false"} (
                                    %mi π
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi Y
