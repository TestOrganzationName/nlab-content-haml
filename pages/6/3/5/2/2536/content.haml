                        %semantics
                          %mrow
                            %mi ℤ
                          %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                %strong 5
                13 (2007) 1375–1400 &amp;lbrack;
                %a{:href => "https://doi.org/10.1080/00927877708822224"}> doi:0.1080/00927877708822224
                \&amp;rbrack;
            %li#BarbierCoulembier2018
              %p
                Sigiswald Barbier and Kevin Coulembier,
                = succeed "," do
                  %em On structure and TKK algebras for Jordan superalgebras
                %strong 46
                2 (2018), 684–704. &amp;lbrack;
                %a{:href => "https://www-tandfonline-com.eux.idm.oclc.org/doi/full/10.1080/00927872.2017.1327059"}> doi:full/10.1080/00927872.2017.1327059
                \&amp;rbrack;
            %li#CavenySmirnov11
              %p
                Deanna Caveny and
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Oleg+Smirnov"} Oleg Smirnov
                %em Categories of Jordan structures and graded Lie algebras
                (2011), &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1106.2447"}> arxiv:1106.2447
                \&amp;rbrack;
          %p See also:
          %ul
