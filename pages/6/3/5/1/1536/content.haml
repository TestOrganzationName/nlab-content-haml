                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mstyle{:mathvariant => "bold"}
                              %mi f
                          %mstyle{:mathvariant => "bold"}
                            %mi x
                          %mo ′
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mi x
                          %mover
                            %mo →
                            %mi f
                          %mi R
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi x
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ll}
                    \\Big\{
                    L(x) \xrightarrow{ \mathbf{f} } \mathbf{x}'
                    \\Big\}
                    \\;\simeq\;
                    \\Big\{
                    x \xrightarrow{ f } R(\mathbf{x}')
                    \\Big\}
                    \\end{array}
            %p and on components the following natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mi.mathscript 𝒱
                          %mover
                            %mo →
                            %mi ϕ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi f
                            %mo *
                          %mi.mathscript 𝒱
                          %mo ′
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mi.mathscript 𝒱
                          %mover
                            %mo →
                            %mi ϕ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
