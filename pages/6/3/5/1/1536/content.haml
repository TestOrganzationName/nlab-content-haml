                    \\\
                    \\;\simeq\;
                    \\Big\{
                    \\mathscr{V}
                    \\xrightarrow{ \phi }
                    L(f)^\ast
                    \\big(
                    \\epsilon_{\mathbf{x}'}^\ast
                    \\mathscr{V}'
                    \\big)
                    \\Big\}
                    \&amp;
