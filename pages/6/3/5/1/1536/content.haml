                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{f} \,=\, \epsilon_{\mathbf{x}'} \circ L(f)
              (
              %a{:href => "adjoint+functor#GeneralAdjunctsInTermsOfAdjunctionUnitCounit"}> here
