                    \\widehat{L} \dashv \widehat{R}
                    }_{
                    \\mathscr{V}_{\mathbf{x}}
                    }
                    \\;\colon\;
                    \\widehat{L}
                    \\widehat{R}
                    \\big(\mathscr{V}_{\mathbf{x}}\big)
                    \=
                    \\Big(
                    \\big(\epsilon^{L \dashv R}_{\mathbf{x}}\big)^\ast
                    \\mathscr{V}
                    \\Big)_{ L R(\mathbf{x}) }
                    \\overset{
                    (id)_{\epsilon^{L \dashv R}_{\mathbf{x}}}
                    }{\longrightarrow}
                    \\mathscr{V}_{\mathbf{x}}
            %p
          .proof
            %h6 Proof
            %p
              First notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat R
              is indeed well-defined in that we have a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              on the right of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϵ
                      %mstyle{:mathvariant => "bold"}
                        %mi x
                      %mo *
                    %mi.mathscript 𝒱
                    %mover
                      %mo →
                      %mrow
                        %msubsup
                          %mi ϵ
                          %mstyle{:mathvariant => "bold"}
                            %mi x
                          %mo *
                        %mi ϕ
                    %msubsup
                      %mi ϵ
                      %mstyle{:mathvariant => "bold"}
                        %mi x
                      %mo *
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi f
                      %mo *
                    %mi.mathscript 𝒱
                    %mo ′
                    %mo ≃
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi L
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi f
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo *
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi x
                        %mo ′
                      %mo *
                    %mi.mathscript 𝒱
                    %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon_{\mathbf{x}}^\ast \mathscr{V}
                    \\xrightarrow{ \epsilon_{\mathbf{x}}^\ast \phi }
                    \\epsilon_{\mathbf{x}}^\ast \mathbf{f}^\ast \mathscr{V}'
                    \\simeq
                    \\big(L R(\mathbf{f})\big)^\ast
                    \\epsilon_{\mathbf{x}'}^\ast \mathscr{V}'
            %p
              given by the
              %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
              %a.existingWikiWord{:href => "/nlab/show/pseudo-functor"} pseudo-functoriality
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{(-)}
              applied to the
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commutativity
              of the
              %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi L
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi L
                                %mi R
                                %mo{:stretchy => "false"} (
                                %mstyle{:mathvariant => "bold"}
                                  %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi L
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi ϵ
                                      %mstyle{:mathvariant => "bold"}
                                        %mi x
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi ϵ
                                      %mrow
                                        %mstyle{:mathvariant => "bold"}
                                          %mi x
                                        %mo ′
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi f
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                            %mo ′
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    L R(\mathbf{x})
                    \&amp;\overset{ L R(\mathbf{f}) }{\longrightarrow}&amp;
                    L R(\mathbf{x}')
                    \\\
                    \\mathllap{{}^{ \epsilon_{\mathbf{x}} }}
                    \\Big\downarrow
                    \&amp;&amp;
                    \\Big\downarrow
                    \\mathrlap{{}^{ \epsilon_{\mathbf{x}'} }}
                    \\\
                    \\mathbf{x}
                    \&amp;\underset{\;\; \mathbf{f} \;\;}{\longrightarrow}&amp;
                    \\mathbf{x}'
                    \\mathrlap{\,.}
                    }
            %p
              Now if we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon x \to R(\mathbf{x}')
              for the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
