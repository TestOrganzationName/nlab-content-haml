                          %mo ′
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                        %mtd
                          %mtext formula for adjuncts
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mi.mathscript 𝒱
                          %mover
                            %mo →
                            %mi ϕ
                          %mi L
                          %mo{:stretchy => "false"} (
