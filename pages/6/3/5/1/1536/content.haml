                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_{(-)}
            %p
              This establishes a
              %a{:href => "adjoint+functor#eq:HomIsomorphismForAdjointFunctors"} hom-isomorphism
              exhibiting adjoint functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi L
                        %mo ^
                      %mo ⊣
                      %mover
                        %mi R
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat L \dashv \widehat R
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{R}(-)
              under this hom-isomorphism is the claimed counit
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:AdjunctionCounitCoveringUnderlyingAdjunctionCounit"} (3)
          %h2#generalizations Generalizations
          %h3{:id => ""}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n = 0
          %p
            The analog of the Grothendieck construction one categorical dimension down is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
          %h3#ForInfinityGroupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} n = (\infty,0)
          %p
            The analog of the Grothendieck construction for
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            is examined in detail in
            = succeed "." do
              %a{:href => "#HeutsMoerdijk13"} Heuts-Moerdijk 13
          %p
            The category of presheaves in groupoids is replaced by the
            %a.existingWikiWord{:href => "/nlab/show/model+category+of+simplicial+presheaves"} model category of simplicial presheaves
            equipped with the
            %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"} projective model structure
            and the category of Grothendieck fibrations in groupoids is replaced by the model category of simplicial sets over the
            %a.existingWikiWord{:href => "/nlab/show/nerve+of+a+category"} nerve
            of the source category, equipped with the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contravariant+model+structure"} contravariant model structure
          %p In this case there is not one, but two different functors that generalize the Grothendieck construction.
          %p
            The first functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mo !
                %annotation{:encoding => "application/x-tex"} h_!
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            using the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/diagonal+of+a+bisimplicial+set"} diagonal of a bisimplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi r
                    %mo *
                %annotation{:encoding => "application/x-tex"} r^*
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
            (also known as the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mo !
                  %mo ⊣
                  %msup
                    %mi h
                    %mo *
                %annotation{:encoding => "application/x-tex"} h_!\dashv h^*
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mo !
                    %mo ⊣
                    %msup
                      %mi r
                      %mo *
                  %annotation{:encoding => "application/x-tex"} r_!\dashv r^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi h
                    %mo *
                %annotation{:encoding => "application/x-tex"} h^*
            generalizes the cleavage construction, whereas the left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mo !
                %annotation{:encoding => "application/x-tex"} r_!
            generalizes the comma category construction above.
          %p
            The two functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mo !
                %annotation{:encoding => "application/x-tex"} h_!
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi r
                    %mo *
                %annotation{:encoding => "application/x-tex"} r^*
            become naturally weakly equivalent once we
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derive
            them, but they are not isomorphic. The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi r
                    %mo *
                %annotation{:encoding => "application/x-tex"} r^*
            restricted to the full subcategory of presheaves of groupoids recovers the nerve of the classical Grothendieck construction described above. The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mo !
                %annotation{:encoding => "application/x-tex"} h_!
            restricted to the same full subcategory does not even land in quasicategories, so it doesn’t give rise to a new construction in the classical case.
          %h3{:id => "(oo1)case"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} n = (\infty,1)
          %p
            The analog of the Grothendieck construction for
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (∞,1)-categories
            is described at
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            and at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+fibration+of+%28%E2%88%9E%2C1%29-categories"} universal fibration of (∞,1)-categories
          %p
            The correspondence between
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/cartesian+fibrations"} cartesian fibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} E \to C
            and
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-presheaf"} (∞,1)-presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi Cat
                    %mi op
                %annotation{:encoding => "application/x-tex"} C \to (\infty,1)Cat^{op}
            is
            %a.existingWikiWord{:href => "/nlab/show/model+category"} modeled
            by the
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+marked+simplicial+over-sets"} model structure on marked simplicial over-sets
            and the projective
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+simplicial+presheaves"} global model structure on simplicial presheaves
          %p For more details see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
          %h3#normal_lax_functors_into_
            Normal lax functors into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} Prof
          %p
            The Grothendieck construction can be generalized from pseudofunctors into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            to normal lax functors into
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/displayed+category"} displayed category
            for more.
          %h2#warning_on_terminology Warning on terminology
          %p
            The term ‘Grothendieck Construction’ is applied in the literature to at least two very different constructions (and as
            %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Grothendieck
            introduced so many new ideas and constructions to mathematics, perhaps there are others!). One concerns the construction of a
            %a.existingWikiWord{:href => "/nlab/show/fibered+category"} fibered category
            from a
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            and will be treated in more detail in the entry on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
            is in the context of
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            from isomorphism classes of vector bundles on a space by the introduction of formal inverses, ‘virtual bundles’. This constructs an Abelian group from the semi-group of isomorphism classes.
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              %strong (representable functor and slice categories)
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                    %mo ↪
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} C(-,X) \colon  C^{op} \to Set \hookrightarrow Cat
              maps under the Grothendieck construction to the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} C/X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C/X \to C
              are also called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/representable+fibered+categories"} representable fibered categories
          %p
          #SliceCategoriesAndArrowCategory.num_remark
            %h6 Example
            %p
              %strong (slice categories and arrow category)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              any category, let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒮
                    %mo ⟶
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}_{(-)}
                    \\,\colon\,
                    \\mathcal{S}
                    \\longrightarrow
                    Cat
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
              which sends
            %ul
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi 𝒮
                      %annotation{:encoding => "application/x-tex"} B \,\in\, \mathcal{S}
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒮
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi B
                        %annotation{:encoding => "application/x-tex"} \mathcal{S}_{/B}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                        %mo →
                        %mi B
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} f \colon B \to B'
                  to the left
                  %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo !
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi 𝒞
                          %mi B
                        %mo →
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi B
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} f_! \,\colon\, \mathcal{C}_{B} \to \mathcal{C}_{/B'}
                  given by post-
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              on this functor is the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒮
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}^{I}
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒮
                      %mi I
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %msub
                        %mo ∫
                        %mrow
                          %mi B
                          %mo ∈
                          %mi 𝒮
                      %msub
                        %mi 𝒮
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}^{I}
                    \\;\;\;
                    \\simeq
                    \\;\;\;
                    \\textstyle{\int}_{B \in \mathcal{S}}
                    \\mathcal{S}_{/B}
                    \\mathrlap{\,.}
            %p
              This follows readily by unwinding the definitions. In the refinement to the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction+for+model+categories"} Grothendieck construction for model categories
              (here:
              %a.existingWikiWord{:href => "/nlab/show/slice+model+categories"} slice model categories
              and
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/model+structures+on+functors"} model structures on functors
              = succeed "." do
                %a{:href => "Grothendieck+construction+for+model+categories#HarpazPrasma15"} Harpaz &amp; Prasma (2015), above Cor. 6.1.2
            %p
              The correponding
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
              is also known as the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/opfibration"} opfibration
            %p
              But if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              has all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo ⟶
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}_{(-)}
                    \\,\colon\,
                    \\mathcal{S}^{op}
                    \\longrightarrow
                    Cat
            %p which sends
            %ul
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi 𝒮
                      %annotation{:encoding => "application/x-tex"} B \,\in\, \mathcal{S}
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒮
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi B
                        %annotation{:encoding => "application/x-tex"} \mathcal{S}_{/B}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
