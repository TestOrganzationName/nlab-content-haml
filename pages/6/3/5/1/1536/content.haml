              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of a given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{f} \colon L(x) \to \mathbf{x}'
              then we have natural bijections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %mover
                            %mi L
                            %mo ^
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi.mathscript 𝒱
                            %mi x
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mstyle{:mathvariant => "bold"}
                                  %mi f
                          %mi.mathscript 𝒱
                          %msub
                            %mo ′
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi x
                              %mo ′
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %msub
                            %mi.mathscript 𝒱
                            %mrow
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mstyle{:mathvariant => "bold"}
                                  %mi f
                          %mi.mathscript 𝒱
                          %msub
                            %mo ′
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi x
                              %mo ′
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                        %mtd
                          %mtext by def.
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                          %msub
                            %mi.mathscript 𝒱
                            %mi x
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mi f
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
