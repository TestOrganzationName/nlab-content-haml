                %annotation{:encoding => "application/x-tex"} p : E \to C
            of
            %a.existingWikiWord{:href => "/nlab/show/category"} categories
            – i.e. a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            – is called a
            %a.existingWikiWord{:href => "/nlab/show/fibered+category"} fibered category
            or
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            if it is encoded in a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi p
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} S_p : C^{op} \to Cat
          %p
            The reconstruction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            from the pseudofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi p
                %annotation{:encoding => "application/x-tex"} S_p
            is the
            %strong Grothendieck construction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int} \;\; : \;\; Func(C^{op}, Cat) \to Cat/C
          %p
            which is a
            %a.existingWikiWord{:href => "/nlab/show/fully+faithful"} fully faithful
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            from the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of pseudofunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} C^{op} \to Cat
            to the
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            of
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            The essential image of this functor consists of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+2-categories"} equivalence of 2-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}
                  \\,\colon\,
                  Func(C^{op}, Cat)
                  \\overset{\simeq}{\longrightarrow}
                  Fib(C)
          %p
            between 2-functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} C^{op} \to Cat
            and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            When restricted to pseudofunctors with values in
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊂
                %annotation{:encoding => "application/x-tex"} \subset
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            this identifies the
            %a.existingWikiWord{:href => "/nlab/show/fibration+fibered+in+groupoids"} Grothendieck fibrations in groupoids
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi FibGrpd
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}
                  \\;\colon\;
                  Func(C^{op}, Grpd)
                  \\overset{\simeq}{\longrightarrow}
                  FibGrpd(C)
                  \\,.
          %p
            This equivalence notably allows one to discuss
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            condition with respect to a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            on
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            The Grothendieck construction is one of the central aspects of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
            in
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            theory.
          %p
            The Grothendieck construction can also be generalized beyond fibrations, to the correspondence between
            %a.existingWikiWord{:href => "/nlab/show/displayed+categories"} displayed categories
            and arbitrary categories over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#Definition Definition
          %p
            Let
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            denote the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
          %p
            In line with the philosophy of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundles"} generalized universal bundles
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi Cat
                          %mrow
                            %mo *
                            %mo ,
                            %mi ℓ
                    %mtr
                      %mtd
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                    %mtr
                      %mtd
                        %mi Cat
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{c}
                  Cat_{*,\ell}
                  \\\
                  \\big\downarrow
                  \\\
                  Cat
                  \\mathrlap{\,,}
                  \\end{array}
          %p
            namely the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of “lax-
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"}> pointed
            ”
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/lax+slice+2-category"} lax slice
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            under the
            %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \ast \,\in\, Cat
          %ul
            %li
              %p
                Its objects are
                %a.existingWikiWord{:href => "/nlab/show/pointed+categories"} pointed categories
                (i.e.
                %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,a)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a category and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                is an
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                and its
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,a) \to (B,b)
                are pairs
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f,\gamma)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f \colon A\to B
                is a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi b
                    %annotation{:encoding => "application/x-tex"} \gamma\colon f(a)\to b
                is a
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
            %li
              %p
                The projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cat
                        %mrow
                          %mo *
                          %mo ,
                          %mi ℓ
                      %mo →
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat_{*,\ell} \to Cat
                is the evident
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          %p
            Now if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} F \colon C \to Cat
            is a
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            from a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %strong Grothendieck construction
            is the (strict)
            %a.existingWikiWord{:href => "/nlab/show/2-pullback"} 2-pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mo ∫
                  %mi F
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} p \colon \int F \to C
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cat
                    %mrow
                      %mo *
                      %mo ,
                      %mi ℓ
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat_{*,\ell} \to Cat
            along
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo ∫
                          %mi F
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mi Cat
                            %mrow
                              %mo *
                              %mo ,
                              %mi ℓ
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mi p
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %munder
                            %mo ⟶
                            %mi F
                        %mtd
                          %mi Cat
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\int F &amp;\longrightarrow&amp; Cat_{*,\ell}
                  \\\
                  \\mathllap{{}^{p}}\big\downarrow
                  \&amp;&amp;
                  \\big\downarrow
                  \\\
                  C &amp;\underset{F}{\longrightarrow}&amp; Cat
                  \\mathrlap{\,.}
                  }
          %p This means that:
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∫
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \int F
                are pairs
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (c,a)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \in Obj(C)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a \in Obj(F(c))
            %li#TheMorphisms
              %p
                and morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∫
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \int F
                are given by pairs
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi c
                        %mover
                          %mo →
                          %mi f
                        %mi c
                        %mo ′
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mi ϕ
                        %mi a
                        %mo ′
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} \big(c \overset{f}{\to} c',\, F(f)(a) \overset{\phi}{\to} a'\big)
                %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                in
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                this looks as follows:
          %p
            %img{:src => "/nlab/files/CovariantGrothendieckConstrSchema-230401c.jpg", :width => "300"}/
          %p
            This construction extends to a
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            between
            %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}
                  \\;\colon\;
                  [C, Cat]
                  \\longrightarrow
                  Cat/C
          %p
            from
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctors"} pseudofunctors
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            of
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            The more commonly described version of this construction works instead on
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
            pseudofunctors, i.e. pseudofunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} C^{op}\to Cat
            from an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            = succeed "-cobundle\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Cat
                      %mrow
                        %mo *
                        %mo ,
                        %mi c
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %msup
                      %mi Cat
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (Cat_{*,c})^{op} \to Cat^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Cat
                    %mrow
                      %mo *
                      %mo ,
                      %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Cat_{*,c})
            is the colax slice, whose objects are again pointed categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,a) \to (B,b)
            are pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,\gamma)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f\colon A\to B
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi b
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma\colon b \to f(a)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo ∫
                          %mi F
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Cat
                            %mrow
                              %mo *
                              %mo ,
                              %mi c
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi op
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi p
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mover
                            %mo →
                            %mi F
                        %mtd
                          %msup
                            %mi Cat
                            %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\int F &amp;\to&amp; (Cat_{*,c})^{op}
                  \\\
                  {}^{\mathllap{p}}\downarrow &amp;&amp; \downarrow
                  \\\
                  C &amp;\stackrel{F}{\to}&amp; Cat^{op}
                  }
                  \\,.
          %p
            constitutes a
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}
                  \\;\colon\;
                  [C^{op},Cat]
                  \\longrightarrow
                  Cat/C
                  \\,.
          %p In this case,
          %ul
            %li
              %p
                the objects of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∫
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \int F
                are again pairs
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (c,a)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \in Obj(C)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a \in Obj(F(c))
            %li#TheMorphismsContra
              %p
                the morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∫
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \int F
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c,a)
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ′
                      %mo ,
                      %mi a
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c',a')
                are pairs
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi c
                        %mover
                          %mo →
                          %mi f
                        %mi c
                        %mo ′
                        %mo ,
                        %mi a
                        %mover
                          %mo →
                          %mi ϕ
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} \big(c \overset{f}{\to} c', a \overset{\phi}{\to} F(f)(a')\big)
          %p
            %img{:src => "/nlab/files/ContravariantGrothendieckConstrSchema-230401.jpg", :width => "300"}/
          %p
            Note that this is not the same as the first (covariant) Grothendieck construction applied to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} C^{op} \to Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            go in the opposite direction to one another.
          %h2#properties Properties
          %h3#CoLimitsInAGrothendieckConstruction (Co)Limits in a Grothendieck construction
          %p
            We discuss existence and characterization of (
            %a.existingWikiWord{:href => "/nlab/show/colimit"}> co
            )
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %em in
            a Grothendieck construction.
          %p
          .num_prop
            %h6 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} F \colon C^{op} \to Cat
            %p If
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(J)
                  is complete for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                          %mo ∈
                          %mi C
                        %annotation{:encoding => "application/x-tex"} J \in C
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(f) : F(J) \to F(K)
                  %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves limits
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi K
                        %mo →
                        %mi J
                      %annotation{:encoding => "application/x-tex"}
                        f \colon K \to
                        J
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \int F
              is complete.
            %p Dually, if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(J)
                  is cocomplete for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                          %mo ∈
                          %mi C
                        %annotation{:encoding => "application/x-tex"} J \in C
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(f) : F(J) \to F(K)
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi K
                        %mo →
                        %mi J
                      %annotation{:encoding => "application/x-tex"} f : K \to J
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \int F
              is cocomplete.
          This proven in
          = succeed "." do
            %a{:href => "#TBG91"} Tarlecki, Burstall &amp; Goguen (1991), §3.1, 3.2
          %p
            The case of colimits is also described in
            = succeed ":" do
              %a{:href => "Grothendieck+construction+for+model+categories#HarpazPrasma15"} Harpaz &amp; Prasma (2015), Prop. 2.4.4
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
          #eq:ThePseudofunctor.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi C
                              %mspace{:width => "thinmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                              %mspace{:width => "thinmathspace"}
                              %mspace{:width => "thickmathspace"}
                          %mi Base
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi Cat
                      %mtr
                        %mtd
                          %mi 𝒳
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi C
                            %mi 𝒳
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mi f
                        %mtd
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %msup
                                %mo
                                %mrow
                                  %msub
                                    %mi f
                                    %mo !
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mo ⊣
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↑
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                      %mtr
                        %mtd
                          %mi 𝒴
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi C
                            %mi 𝒴
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathllap{
                  \\mathbf{C} \,\colon\,
                  \\;
                  }
                  Base &amp;\longrightarrow&amp; Cat
                  \\\
                  \\mathcal{X} &amp;\mapsto&amp; \mathbf{C}_{\mathcal{X}}
                  \\\
                  \\Big\downarrow\mathrlap{{}^{f}}
                  \&amp;&amp;
                  \\mathllap{^{f_!}}\Big\downarrow
                  \\dashv
                  \\Big\uparrow\mathrlap{{}^{f^\ast}}
                  \\\
                  \\mathcal{Y} &amp;\mapsto&amp; \mathbf{C}_{\mathcal{Y}}
                  }
          %p such that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Base
                    %annotation{:encoding => "application/x-tex"} Base
                is cocomplete
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}_{\mathcal{X}}
                is
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
                for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                      %mo ∈
                      %mi Base
                    %annotation{:encoding => "application/x-tex"} \mathcal{X} \in Base
          %p
            then also the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi 𝒳
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mi 𝒳
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \int_{\mathcal{X}} \mathbf{C}_{\mathcal{X}} \,\in\, Cat
            is cocomplete.
          %p
            Explicitly,
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi 𝒳
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \int_{\mathcal{X}} \mathbf{C}_{\mathcal{X}}
            are computed as follows:
          %p Given a diagram in the Grothendieck construction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi.mathscript 𝒱
                    %mi 𝒳
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi I
                  %mo ⟶
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathscr{V}_{\mathcal{X}}
                  \\;\colon\;
                  I
                  \\longrightarrow
                  \\textstyle{\int} \mathbf{C}_{(-)}
          %p
            its
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            diagram in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Base
                %annotation{:encoding => "application/x-tex"} Base
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi I
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi.mathscript 𝒱
                        %mi 𝒳
                  %mo ∫
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mi π
                  %mi Base
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{X}
                  \\;\colon\;
                  I
                  \\overset{ \mathscr{V}_{\mathcal{X}} }{\longrightarrow}
                  \\int \mathbf{C}_{(-)}
                  \\overset{\pi}{\longrightarrow}
                  Base
          %p
            has a colimit by assumption on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Base
                  %annotation{:encoding => "application/x-tex"} Base
            %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
            morphisms to be denoted like this:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %munder
                    %mi lim
                    %munder
                      %mo ⟶
                      %mrow
                        %mi j
                        %mo ∈
                        %mi I
                  %mi 𝒳
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{X}(i)
                  \\overset{\;\; q(i) \;\;}{\longrightarrow}
                  \\underset{\underset{j \in I}{\longrightarrow}}{\lim}
                  \\mathcal{X}(j)
                  \\,.
          %p
            Now the idea is that the full colimit in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int \mathbf{C}_{(-)}
            is obtained by
          %ol
            %li
              %p
                first pushing all morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi f
                        %mo !
                      %mi.mathscript 𝒱
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi.mathscript 𝒱
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi \colon f_!\mathscr{V}(i) \to \mathscr{V}(j)
                in the diagram forward along the respective
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mi j
                    %annotation{:encoding => "application/x-tex"} q_j
            %li
              %p
                to hence obtain a diagram
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mo !
                      %mi.mathscript 𝒱
                    %annotation{:encoding => "application/x-tex"} q_! \mathscr{V}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mrow
                          %munder
                            %mi lim
                            %mo ⟶
                          %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}_{\underset{\longrightarrow}{\lim} \mathcal{X}}
            %li
              %p
                whose colimit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %mo ⟶
                      %msub
                        %mi q
                        %mo !
                      %mi.mathscript 𝒱
                    %annotation{:encoding => "application/x-tex"} \underset{\longrightarrow}{\lim} q_! \mathscr{V}
                exists by assumption on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
          %p
            and then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %munder
                    %mi lim
                    %mo ⟶
                  %msub
                    %mi q
                    %mo !
                  %mi.mathscript 𝒱
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mrow
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \big(\underset{\longrightarrow}{\lim} q_! \mathscr{V}\big)_{\underset{\longrightarrow}{\lim}\mathcal{X}}
            is the desired colimit in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \int \mathbf{C}
          %p
          #CartesianProductInGrothendieckConstruction.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                in Grothendick construction is
                %a.existingWikiWord{:href => "/nlab/show/external+tensor+product"} external product
                on fiber categories )
              %br/
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi X
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msup
                                      %mi f
                                      %mo *
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \\\
                    \\Big\downarrow\mathrlap{{}^{f}}
                    \\\
                    Y
                    }
                    \\;\;\;\;\;\mapsto\;\;\;
                    \\array{
                    \\mathcal{C}_X
                    \\\
                    \\Big\uparrow\mathrlap{{}^{f^\ast}}
                    \\\
                    \\mathcal{C}_Y
                    }
            %p
              where the base category and all fiber categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{(-)}
              have
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              and all
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserve
              these products, then the Grothendieck construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi X
                    %msub
                      %mi 𝒞
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \int_X \mathcal{C}_X
              has cartesian products given on objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒱
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi.mathscript 𝒱
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi 𝒞
                      %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{V}_X \,\equiv\,
                    \\big(
                    \\mathscr{V} \,\in\, \mathcal{C}_X
                    \\big)
            %p by the formula
            #eq:CartesianProductInGrothendieckConstruction.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒱
                      %mi X
                    %mo ×
                    %msub
                      %mi.mathscript 𝒲
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi pr
                      %mi X
                      %mo *
                    %mi.mathscript 𝒱
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi pr
                      %mi Y
                      %mo *
                    %mi.mathscript 𝒲
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{V}_X
                    \\times
                    \\mathscr{W}_Y
                    \\;\;
                    \\simeq
                    \\;\;
                    \\Big(
                    \\big(pr_X^\ast \mathscr{V}\big)
                    \\,\times\,
                    \\big(pr_Y^\ast \mathscr{W}\big)
                    \\Big)_{X \times Y}
                    \\,,
            %p where we are denoting by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mi X
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mi Y
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X \times Y
                    \\\
                    \&amp;
                    \\mathllap{{}^{pr_X}}\swarrow
                    \&amp;&amp;
                    \\searrow\mathrlap{{}^{pr_Y}}
                    \\\
                    X &amp;&amp; &amp;&amp; Y
                    }
            %p
              the product
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              maps in the base category.
            %p
              A product of the form
              %a.maruku-eqref{:href => "#eq:CartesianProductInGrothendieckConstruction"} (2)
              is known as an
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/external+tensor+product"} external tensor product
              %a{:href => "free+coproduct+completion#FreeDistributiveCategoryMonad"} this Proposition
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
          %h3#AsALaxColimit As an oplax colimit
          %p
            The Grothendieck construction on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} F : C \to Cat
            is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/oplax+colimit"} oplax colimit
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            (e.g
            = succeed ")." do
              %a{:href => "#GepnerHaugsengNikolaus15"} Gepner-Haugseng-Nikolaus 15
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            there is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence of categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lax
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ,
                  %mi Δ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                  %mi F
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  Lax(F, \Delta X) \simeq [{\textstyle \int} F, X]
          %p
            that is natural in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Delta X
            is the constant functor with value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/oplax+colimit"} oplax colimit
            for an explanation of why
            %em lax
            natural transformations appear in the definition of an
            %em oplax
            colimit.)
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/lax+natural+transformation"} lax natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Delta X
            is given by
          %ul
            %li
              for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi c
                      %mo{:lspace => "verythinmathspace"} :
                      %mi F
                      %mi c
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \alpha_c \colon F c \to X
            %li
              for each morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} m \colon c \to d
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi α
                      %mi c
                    %mo ⇒
                    %msub
                      %mi α
                      %mi d
                    %mo ∘
                    %msub
                      %mi m
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \alpha_m \colon \alpha_c \Rightarrow \alpha_d \circ m_*
              (writing
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi m
                        %mo *
                      %mo =
                      %mi F
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m_* = F m
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %msub
                        %mn 1
                        %mi c
                %annotation{:encoding => "application/x-tex"} \alpha_{1_c}
            is the isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %msub
                    %mn 1
                    %mi c
                  %mo ≅
                  %msub
                    %mn 1
                    %mrow
                      %mi F
                      %mi c
                %annotation{:encoding => "application/x-tex"} F 1_c \cong 1_{F c}
            given by
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctoriality
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} m \colon c \to d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo{:lspace => "verythinmathspace"} :
                  %mi d
                  %mo →
                  %mi e
                %annotation{:encoding => "application/x-tex"} n \colon d \to e
            is a composable pair in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mrow
                      %mi n
                      %mi m
                %annotation{:encoding => "application/x-tex"} \alpha_{n m}
            is equal to the obvious
            %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi m
                %annotation{:encoding => "application/x-tex"} \alpha_m
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \alpha_n
          %p
            We want to show that to each such lax transformation there corresponds an essentially unique functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi F
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \int F \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            as above, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be the functor that sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi F
                  %mi c
                %annotation{:encoding => "application/x-tex"} x \in F c
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi c
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \alpha_c x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:lspace => "verythinmathspace"} :
                  %mi c
                  %mo →
                  %mi d
                  %mo ,
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi m
                    %mo *
                  %mi x
                  %mo →
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mo ↦
                  %mspace{:width => "1em"}
                  %msub
                    %mi α
                    %mi c
                  %mi x
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi α
                        %mi m
                      %mi x
                  %msub
                    %mi α
                    %mi d
                  %msub
                    %mi m
                    %mo *
                  %mi x
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi α
                        %mi d
                      %mi f
                  %msub
                    %mi α
                    %mi d
                  %mi y
                %annotation{:encoding => "application/x-tex"}
                  (m \colon c \to d, f \colon m_* x \to y)
                  \\quad \mapsto \quad
                  \\alpha_c x \overset{\alpha_m x}{\to}
                  \\alpha_d m_* x \overset{\alpha_d f}{\to} \alpha_d y
          %p
            That
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a functor follows from the coherence properties of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            with respect to identities and composition in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Conversely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %mo ∫
                  %mi F
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} A \colon \int F \to X
            is a functor, we get a lax transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            as follows:
          %ul
            %li
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \alpha_c
              is the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi c
                    %annotation{:encoding => "application/x-tex"} F c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \int F
              whose objects are those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi c
                  %annotation{:encoding => "application/x-tex"} F c
              and whose morphisms are those with first component an identity morphism. This clearly makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \alpha_c
              a functor.
            %li
              For each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} m \colon c \to d
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \alpha_m
              has components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi c
                    %mi x
                    %mo →
                    %msub
                      %mi α
                      %mi d
                    %msub
                      %mi m
                      %mo *
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \alpha_c x \to \alpha_d m_* x
              given by
              = succeed "\u2018s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %msub
                        %mn 1
                        %mrow
                          %msub
                            %mi m
                            %mo *
                          %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (m,1_{m_* x})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi x
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} k \colon x \to x'
              is a morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi c
                    %annotation{:encoding => "application/x-tex"} F c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              at the morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %msub
                        %mi m
                        %mo *
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (m, m_*k)
          %p
            As one might expect, the coherence conditions on the resulting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            follow from the functoriality of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            It is then easy to check that these two mappings form a bijection between the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Lax
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ,
                  %mi Δ
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Lax(F, \Delta X)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo ∫
                    %mi F
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\int F, X]
          %p
            As for the morphisms involved, the
            %a.existingWikiWord{:href => "/nlab/show/modifications"} modifications
            between lax transformations and the
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            between functors, it is straightforward to show that these are in bijective correspondence too. Hence we have shown that the above equivalence holds.
          %p
            By inspecting the above proof, it is easy to see that the lax transformation associated to a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi F
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \int F \to X
            is a
            %a.existingWikiWord{:href => "/nlab/show/pseudonatural+transformation"} pseudonatural transformation
            if and only if the functor inverts (i.e. sends to an isomorphism) each member of the class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of morphisms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi F
                %annotation{:encoding => "application/x-tex"} \int F
            whose second component is an identity. (These are in fact the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+morphism"} opcartesian
            morphisms with respect to the projection
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi F
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \int F \to C
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi F
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \int F[S^{-1}]
            is therefore the (weak)
            %a.existingWikiWord{:href => "/nlab/show/2-colimit"} 2-colimit
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ps
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ,
                  %mi Δ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                  %mi F
                  %mo ,
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                  %mi F
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  Ps(F, \Delta X) \simeq [{\textstyle \int} F, X]_{S^{-1}}
                  \\simeq [{\textstyle \int} F[S^{-1}], X]
          %p
            This last result appears in
            %a.existingWikiWord{:href => "/nlab/show/SGA4"} SGA4
            Exposé VI, Section 6.
          %h3#local_smallness Local smallness
          %p
            In general, a
            %a.existingWikiWord{:href => "/nlab/show/weighted+colimit"} (weighted)
            colimit of a
            %a.existingWikiWord{:href => "/nlab/show/large+category"} large
            diagram of
            %a.existingWikiWord{:href => "/nlab/show/locally+small+categories"} locally small categories
            need no longer be locally small. However, in the case of the oplax colimit, i.e. the Grothendieck construction, we have:
          .un_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} F:C^{op}\to Cat
              is a pseudofunctor,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is locally small, and each category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(c)
              is locally small, then the Grothendieck construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \int F
              is also locally small.
          .proof
            %h6#proof Proof
            %p
              Recall that the morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \int F
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c,a)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c',a')
              are pairs
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mover
                        %mo →
                        %mi f
                      %mi c
                      %mo ′
                      %mo ,
                      %mi a
                      %mover
                        %mo →
                        %mi α
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c \overset{f}{\to} c', a \overset{\alpha}{\to} F(f)(a'))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              means that there is only a set of such
              = succeed "\u2018s," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(c)
              means that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              there is only a set of such
              = succeed "\u2019s." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
          %p
            For example, consider the
            %span.newWikiWord
              canonical indexing
              %a{:href => "/nlab/new/canonical+indexing"} ?
            of a locally small category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Set^{op}\to Cat
            sending each set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi X
                  %annotation{:encoding => "application/x-tex"} A^X
            %a.existingWikiWord{:href => "/nlab/show/families"} families
            of objects of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h3#EquivalenceBetweenFiberedCategoriesAndPsuedofunctors The equivalence between fibrations and pseudofunctors
          %p
            One can characterize the
            %em image
            of the Grothendieck construction as consisting precisely of those objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi C
                %annotation{:encoding => "application/x-tex"} Cat/C
            that are
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
          %p
            We recall the definition of the
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            of Grothendieck fibrations and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
          %h4#the_bicategory_of_pseudofunctors The bicategory of pseudofunctors
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            from a 1-
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            (
            %a.existingWikiWord{:href => "/nlab/show/bicategory"}> bicategory
            )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is nothing but a (non-strict)
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            between bicategories, with the ordinary category regarded as a special bicategory.
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C^{op}, A]
            for the
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            2-category from the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi op
                %annotation{:encoding => "application/x-tex"} op
            here is just convention):
          %ul
            %li
              %p
                objects are pseudofunctors
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo :
                        %msup
                          %mi C
                          %mi op
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} F : C^{op} \to A
            %li
              %p
                morphisms are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/lax+natural+transformation"} pseudonatural transformations
            %li
              %p
                2-morphism are
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/modification"} modification
          %h4#the_bicategory_of_fibrations The bicategory of fibrations
          .un_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi E
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p : E \to C
              is a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
              if for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} e \in E
              and every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : c \to p(e)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi e
                  %annotation{:encoding => "application/x-tex"} \hat f : \hat c \to e
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              that lifts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} p(\hat f) = f
              and which is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
            %p
              A
              %strong
                morphism of Grothendieck fibrations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo :
                      %mi E
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ′
                      %mo :
                      %mi E
                      %mo ′
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F : (p : E \to C) \to (p' : E' \to C)
                is
            %ul
              %li
                %p
                  a functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo :
                        %mi E
                        %mo →
                        %mi E
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} F : E \to E'
              %li
                %p such that
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi F
                          %annotation{:encoding => "application/x-tex"} F
                      sends
                      = succeed "s" do
                        %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
                  %li
                    %p the diagram
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mi E
                                  %mtd
                                  %mtd
                                    %mover
                                      %mo →
                                      %mi F
                                  %mtd
                                  %mtd
                                    %mi E
                                    %mo ′
                                %mtr
                                  %mtd
                                  %mtd
                                    %msub
                                      %mrow
                                      %mpadded{:lspace => "-100%width", :width => "0"}
                                        %mi p
                                    %mo ↘
                                  %mtd
                                  %mtd
                                    %msub
                                      %mo ↙
                                      %mpadded{:width => "0"}
                                        %mrow
                                          %mi p
                                          %mo ′
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %mi C
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            E &amp;&amp;\stackrel{F}{\to}&amp;&amp; E'
                            \\\
                            \&amp; {}_{\mathllap{p}}\searrow &amp;&amp; \swarrow_{\mathrlap{p'}}
                            \\\
                            \&amp;&amp; C
                            }
                    %p
                      in
                      %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                      commutes (strictly).
              %li
                %p
                  a
                  %strong 2-morphism
                  between morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo :
                        %mi F
                        %mo →
                        %mi F
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \eta : F \to F'
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                  of the underlying functors, that also makes the obvious diagram 2-commute, i.e. such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ′
                        %mo ⋅
                        %mi η
                      %annotation{:encoding => "application/x-tex"} p' \cdot \eta
                  is trivial.
            %p Compositions are those induced from the underlying functors and natural transformations.
            %p
              This defines the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
                of Grothendieck fibrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    Fib(C) \hookrightarrow Cat/C
            %p
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .un_remark
            %h6#remark Remark
            %p
              Cartesian lifts are not required to be unique, but are automatically unique up to a unique vertical
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              connecting their domains.
          %h4#statement_of_the_equivalence Statement of the equivalence
          %p
          .num_prop
            %h6 Proposition
            %p
            %p
              The Grothendieck construction factors through
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibrations"} Grothendieck fibrations
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mo ∫
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Cat
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mi Fib
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Cat
                      %mo{:stretchy => "false"} /
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\textstyle{\int}
                    \\;\colon\;
                    [C^{op}, Cat]
                    \\longrightarrow
                    Fib(C)
                    \\hookrightarrow
                    Cat/C
            %p
              and establishes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+bicategories"} equivalence of bicategories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mo ∫
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Cat
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mo ≃
                      %mi Fib
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\textstyle{\int}
                    \\;\colon\;
                    [C^{op}, Cat]
                    \\overset{\simeq}{\longrightarrow}
                    Fib(C)
                    \\,.
            %p
              In fact, it is more than that: it is an equivalence of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            %p
              When restricted to pseudofunctors that factor through
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow Cat
              it factors through
              %a.existingWikiWord{:href => "/nlab/show/fibrations+in+groupoids"} fibrations in groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mo ∫
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Grpd
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %msub
                        %mi Fib
                        %mi Grpd
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Cat
                      %mo{:stretchy => "false"} /
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\textstyle{\int}
                    \\;\colon\;
                    [C^{op}, Grpd]
                    \\longrightarrow
                    Fib_{Grpd}(C)
                    \\hookrightarrow
                    Cat/C
            %p and establishes a similar equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msub
                      %mi Fib
                      %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op}, Grpd] \simeq Fib_{Grpd}(C)
                    \\,.
            %p
          .proof
            %h6#proof_2 Proof
            %p
              This can be verified by straightforward albeit somewhat tedious checking. Details are spelled out in
              = succeed "." do
                %a{:href => "#Johnstone"} Johnstone (2002), B1.3
          %h4#model_category_version Model category version
          %p
            There is refinement of the Grothendieck construction to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction+for+model+categories"} Grothendieck construction for model categories
          %p
            This model category incarnation of the Grothendieck construction generalizes to a model category presentation of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
          %h3#adjunction Adjoints to the Grothendieck construction
          %p The Grothendieck construction functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}
                  \\;\colon\;
                  [C^{op}, Cat]
                  \\longrightarrow
                  Cat/C
          %p
            has a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
            and a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
          %p
            Restricted to
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fibrations+in+groupoids"} fibrations in groupoids
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi GpdProf
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C^{op}, GpdProf]
            in order to get all of the objects of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gpd
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Gpd/C
          %p Notice that much of the traditional literature discusses (just) the right adjoint.
          %h4#the_left_adjoint The left adjoint
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            is the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Cat
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  L
                  \\colon
                  (p : E \to C)
                  \\mapsto
                  \\big(
                  (-)/p \colon C^{op} \to Cat
                  \\big)
          %p
            that assigns to a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            the presheaf which sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            to the
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} /
                  %mi p
                %annotation{:encoding => "application/x-tex"} c/p
            with objects given by pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi c
                  %mo →
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (e, c \to p(e))
            and morphisms by commutative triangles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi c
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                      %mtr
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi e
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi e
                            %mn 2
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; c &amp;&amp;
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow &amp;
                  \\\
                  p(e_1) &amp;&amp;\to&amp;&amp; p(e_2)
                  }
          %p i.e.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mover
                    %mo →
                    %mi p
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi c
                  %mo ↦
                  %mi c
                  %mo{:stretchy => "false"} /
                  %mi p
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L(E \stackrel{p}{\to}C) : c \mapsto c/p
                  \\,.
          %p This functor may equivalently be expressed as follows.
          %h5#Cone In terms of a cone construction
          %p
            For given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mover
                    %mo →
                    %mi p
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E \stackrel{p}{\to} C)
            consider the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-limit"} (3,1)-pushout
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi E
                        %mtd
                          %mo ↪
                        %mtd
                          %msup
                            %mi E
                            %mo ▹
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                        %mtd
                          %mo ⇙
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mo →
                        %mtd
                          %mi K
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  E &amp;\hookrightarrow&amp; E^{\triangleright}
                  \\\
                  \\downarrow^{\mathrlap{p}} &amp;\swArrow&amp; \downarrow
                  \\\
                  C &amp;\to&amp; K(p)
                  }
          %p
            of
            %em
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-categories"} (2,1)-categories
            , where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mo ▹
                %annotation{:encoding => "application/x-tex"} K^{\triangleright}
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            with one
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            adjoined (a
            %a.existingWikiWord{:href => "/nlab/show/join+of+quasi-categories"} join
            of categories). (Here
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo ▹
                %annotation{:encoding => "application/x-tex"} E^{\triangleright}
            are 1-catgeories regarded trivially as
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(p)
            will in general be a
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            with nontrivial
            = succeed "s)." do
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
          %p
          .num_prop
            %h6 Proposition
            %p We have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Hom
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c_{/p}
                    \\,\simeq\,
                    Hom_{K(p)}(c,v)
                    \\,.
            %p
              And hence the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the Grothendieck construction may be realized as the assignment that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p \colon E \to C
              to the pseudofunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Hom
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Cat
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L(p) := Hom_{K(p)}(-, v) : C^{op} \to Cat
                    \\,.
            %p
          .proof
            %h6#proof_3 Proof
            %p
              It is convenient to compute the weak pushout by embedding the situation from
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              into the bigger context of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              and using the
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model
              of that provided by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
            %p So consider equivalently the weak pushout diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ▹
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi N
                                  %mo{:stretchy => "false"} (
                                  %mi p
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N(E) &amp;\hookrightarrow&amp; N(E)^{\triangleright}
                    \\\
                    \\downarrow^{\mathrlap{N(p)}} &amp;\swArrow&amp; \downarrow
                    \\\
                    N(C) &amp;\to&amp; N(K(p))
                    }
            %p
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(-)
              is the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              operation and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ▹
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⋆
                    %mo *
                  %annotation{:encoding => "application/x-tex"} N(E)^{\triangleright} = N(E) \star *
              is the
              %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join of simplicial sets
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(E)
              with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/point"} point
            %p
              By the general yoga of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              = succeed "-pushout" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              in the 1-category
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              if the pushout diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ▹
                  %annotation{:encoding => "application/x-tex"} N(C) \leftarrow N(E) \to N(E)^{\triangleright}
              has the property that
            %ul
              %li
                %p all three objects are cofibrant;
              %li
                %p at least one of the two morphisms is a cofibration
            %p
              in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Joyal
                    %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
            %p
              But this is trivially verified since the cofibrations in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Joyal
                  %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
              are just the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Joyal
                  %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
              is cofibrant and the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ▹
                  %annotation{:encoding => "application/x-tex"} N(E) \hookrightarrow N(E)^{\triangleright}
              is a cofibration.
            %p
              (The same conclusion would hold for the same simple reasons in the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %p
              From this it follows that simply because we passed from categories to their
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
              = succeed "-pushouts)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %p
              So we are reduced to computing the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi E
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ▹
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi N
                                  %mo{:stretchy => "false"} (
                                  %mi p
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi Q
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N(E) &amp;\hookrightarrow&amp; N(E)^{\triangleright}
                    \\\
                    \\downarrow^{\mathrlap{N(p)}} &amp;&amp; \downarrow
                    \\\
                    N(C) &amp;\to&amp; Q
                    }
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is then the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(p)
              that we are after.
            %p
              As recalled at
              %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} limits and colimits by example
              in the section
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/limits+and+colimits+by+example#limitsinpresheafcat"} limits in presheaf categories
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "-category" do
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} = Func(\Delta^{op}, Set)
              are computed for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} [n] \in \Delta
              as ordinary colimits in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %p
              For
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n=0
              we see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Q_0
              is the collection of objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and one additional vertex
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 0
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo{:stretchy => "false"} {
                    %mi v
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo{:stretchy => "false"} {
                    %mi v
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    Q_0 = N(C)_0  \coprod \{ v\} = p(Obj(E)) \coprod \{v \}
            %p
              For
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n=1
              similarly we find that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Q_1
              consists of the 1-cells in in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and in addition of one 1-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi c
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} e : c \to v
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e \in Obj(E)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                  %annotation{:encoding => "application/x-tex"} p(e) = c
              (this 1-cell is really the terminal 1-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} e \to v
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo ▹
                  %annotation{:encoding => "application/x-tex"} E^{\triangleright}
              but with its source re-interpreted as being
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                  %annotation{:encoding => "application/x-tex"} p(e) = c
              according to the identification of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Q_0
              as above). In the fibrant replacement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              the composite of original 1-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo →
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1 \to c_2
              and the new 1-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %msub
                      %mi c
                      %mn 2
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} e : c_2 \to v
              will be freely added, so that the general 1-morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} c_1 \to v
              will consist of a 1-morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo →
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1 \to c_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              together with a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_2
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} /
                      %mi p
                    %annotation{:encoding => "application/x-tex"} c/p
            %p
              For
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n=2
              we have in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Q_2
              the 2-cells in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              as well as one 2-cell
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msub
                              %mi c
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi e
                                  %mn 1
                                %mo →
                                %msub
                                  %mi e
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mo ⇙
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi v
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c_1 &amp;&amp;\to&amp;&amp; c_2
                    \\\
                    \&amp; \searrow &amp;{}^{(e_1 \to e_2)}\swArrow&amp; \swarrow
                    \\\
                    \&amp;&amp; v
                    }
            %p
              for each 1-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo →
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_1 \to e_2)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(E)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo →
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(e_1 \to e_2)
              \=
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo →
                      %msub
                        %mi c
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c_1 \to c_2)
            %p
              In particular this means that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 2
                    %mo :
                    %msub
                      %mi c
                      %mn 2
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} e_2: c_2 \to v
              is a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo →
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1 \to c_2
              is a morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo →
                    %msub
                      %mi c
                      %mn 2
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} c_1 \to c_2 \to v
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is homotopic to any compatible direct morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} c_1 \to v
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            %p
              This means that forming the fibrant replacement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Joyal
                  %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
              will not throw in superfluous 1-morphisms on top of those we already discussed in the previous paragraph…
            %p Now furthermore…
          %p
            This formulation of the Grothendieck construction as part of an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊣
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⇄
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  (L \dashv \textstyle{\int})
                  \\;\colon\;
                  Fib(C)
                  \\rightleftarrows
                  [C^{op}, Cat]
          %p
            with the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            given by hom-objects in a pushout object as above is the starting point for its
            %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} vertical categorification
            described at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
          %h4#the_right_adjoint The right adjoint
          %p We also have an adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mo ⊢
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⇄
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (\textstyle{\int} \vdash R)
                  \\;\colon\;
                  Fib(C)
                  \\rightleftarrows
                  [C^{op}, Cat]
                  \\,,
          %p
            where the
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            sends a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mstyle{:displaystyle => "false"}
                    %mo ∫
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                %annotation{:encoding => "application/x-tex"}
                  c
                  \\;\mapsto\;
                  Hom(\textstyle{\int} y(c), F)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int y(c)
            is the Grothendieck construction applied to the representable presheaf of sets (hence
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/discrete+categories"} discrete categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                %annotation{:encoding => "application/x-tex"} Hom
            denotes the category of morphisms between two Grothendieck fibrations.
          %p
            Informally, an object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(F)(c)
            is given by a choice of a pullback along each morphism with codomain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %h3#behaviour_under_simplicial_nerve Behaviour under simplicial nerve
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒟
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{D} \to Cat
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mover
                      %mo ⟶
                      %mi F
                    %mi Cat
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    {\vert N(F(-))\vert}
                    \\;\colon\;
                    \\mathcal{D}
                    \\overset{F}{\longrightarrow}
                    Cat
                    \\stackrel{\vert N(-) \vert}{\to}
                    Top
            %p
              be its postcomposition with
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+categories"} geometric realization of categories
            %p
              Then we have a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi N
                      %mrow
                        %mo (
                        %mstyle{:displaystyle => "false"}
                          %mo ∫
                          %mi F
                        %mo )
                      %mo |
                    %mo ≃
                    %mi hocolim
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    {\left\vert N\left(\textstyle{\int} F \right) \right\vert}
                    \\simeq
                    hocolim {\vert N(F(-)) \vert}
            %p
              exhibiting the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert N(F (-)) \vert
              as the geometric realization of the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
