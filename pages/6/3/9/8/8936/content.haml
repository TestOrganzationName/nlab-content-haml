                %annotation{:encoding => "application/x-tex"} p:\mathrm{Id}_A(a, b)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
