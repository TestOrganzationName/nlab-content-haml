                      %mi a
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi c
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi q
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                  %msub
