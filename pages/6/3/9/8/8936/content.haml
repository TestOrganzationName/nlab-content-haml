                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi q
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo ≡
                      %mi q
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; type \quad \Gamma \vdash a:A \quad \Gamma \vdash b:A \quad \Gamma \vdash p:\mathrm{Id}_A(a, b) \quad \Gamma \vdash q:\mathrm{Id}_A(a, b)}{\Gamma \vdash p \equiv q:\mathrm{Id}_A(a, b)}
          %ul
            %li Typal uniqueness of identity proofs
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi q
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} UIP
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; type \quad \Gamma \vdash a:A \quad \Gamma \vdash b:A \quad \Gamma \vdash p:\mathrm{Id}_A(a, b) \quad \Gamma \vdash q:\mathrm{Id}_A(a, b)}{\Gamma \vdash \mathrm{UIP}_A(a, b, p, q):\mathrm{Id}_{\mathrm{Id}_A(a, b)}(p, q)}
          %p
            Uniqueness of identity proofs is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+set+truncation"} axiom of set truncation
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set-level+type+theory"} set-level type theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/XTT"} XTT
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/boundary+separation"} boundary separation
            %a.existingWikiWord{:href => "/nlab/show/Lean"} Lean
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proof+assistant"} proof assistant
          %p
            If the dependent type theory has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+variables"} type variables
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/impredicative+polymorphism"} impredicative polymorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} UIP
                      %mo :
                      %mi Π
                      %mi A
                      %mo .
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi A
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi A
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi p
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi q
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{UIP}:\Pi A.\prod_{a:A} \prod_{b:A} \prod_{p:\mathrm{Id}_A(a, b)} \prod_{q:\mathrm{Id}_A(a, b)} \mathrm{Id}_{\mathrm{Id}_A(a, b)}(p, q)}
          %h3#as_proposition_equality_reflection As proposition equality reflection
          %p
            The usual formulations of the uniqueness of identity proofs rely on the definition of a proposition as a type where all elements are
            %a.existingWikiWord{:href => "/nlab/show/identified"} identified
            with each other:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isProp}(A) \coloneqq \prod_{x:A} \prod_{y:A} \mathrm{Id}_A(x, y)
          %p
            There is another definition of a proposition as a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with a function from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to the type that signifies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi A
                  %mo →
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isProp}(A) \coloneqq A \to \mathrm{isContr}(A)
          %p
            When applied to identity types in the inference rule for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            %a.existingWikiWord{:href => "/nlab/show/equality+reflection"} equality reflection
            found in
            %a.existingWikiWord{:href => "/nlab/show/extensional+type+theory"} extensional type theory
            in the following sense:
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+some+types"} propositions as some types
            interpretation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
            %em
              %a.existingWikiWord{:href => "/nlab/show/propositionally+equal"} propositionally equal
            %a.existingWikiWord{:href => "/nlab/show/if+and+only+if"} if and only if
            they are
            %a.existingWikiWord{:href => "/nlab/show/uniquely"} uniquely
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/identified"} identified
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo =
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x = y) \simeq \mathrm{isContr}(\mathrm{Id}_A(x, y))
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/isContr"} isContr
            is always a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} x = y
            is always a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
            and
            %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric
            and satisfies the
            %a.existingWikiWord{:href => "/nlab/show/principle+of+substitution"} principle of substitution
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+of+indiscernibles"} identity of indiscernibles
            %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive relation
            if and only if
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            holds for the type; i.e. if and only if the set is an h-set.
          %p
            By definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isProp}(\mathrm{Id}_A(x, y))
            as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} isContr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Id}_A(x, y) \to \mathrm{isContr}(\mathrm{Id}_A(x, y))
            %strong uniqueness of identity proofs
            says that one can derive the uniqueness of identifications from every
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identification"} identification
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi x
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi y
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} UIP
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi x
                      %mo =
                      %mi y
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash x:A \quad \Gamma \vdash y:A \quad \Gamma \vdash p:\mathrm{Id}_A(x, y)}{\Gamma \vdash \mathrm{UIP}_A(x, y, p):x = y}
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/inference+rule"} inference rule
            can thus be called
            = succeed "." do
              %strong propositional equality reflection
          %p
            The relation between the
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            and the
            %a.existingWikiWord{:href => "/nlab/show/K+rule"} K rule
            becomes clearer in this formulation of the uniqueness of identity proofs: by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/J+rule"} J rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/reflexivity"} reflexivity
            %a.existingWikiWord{:href => "/nlab/show/K+rule"} K rule
            states that reflexivity is the
            %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
            of the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+type"} loop space type
            for all elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#properties Properties
          %h3#relation_to_the_circle_type Relation to the circle type
          %p
            In this section, we assume that the
            %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            is inductively defined using two elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} left
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{left}:S^1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} right
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{right}:S^1
            and a two parallel identifications
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} upath
                  %mo :
                  %mi{:mathvariant => "normal"} left
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} right
                %annotation{:encoding => "application/x-tex"} \mathrm{upath}:\mathrm{left} =_{S^1} \mathrm{right}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} dpath
                    %mo :
                    %mi{:mathvariant => "normal"} left
                    %msub
                      %mo =
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi{:mathvariant => "normal"} right
                  %annotation{:encoding => "application/x-tex"} \mathrm{dpath}:\mathrm{left} =_{S^1} \mathrm{right}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            has judgmental
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/computation+rules"} computation rules
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that the
              %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
              has an identification
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} UIP
                      %mo :
                      %mi{:mathvariant => "normal"} upath
                      %mo =
                      %mi{:mathvariant => "normal"} dpath
                    %annotation{:encoding => "application/x-tex"} \mathrm{UIP}:\mathrm{upath} = \mathrm{dpath}
          %p
          .proof
            %h6 Proof
            %p
              For all types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y:A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                  %annotation{:encoding => "application/x-tex"} p:x =_A y
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %annotation{:encoding => "application/x-tex"} q:x =_A y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{S^1}(x, y, p, q):S^1 \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} left
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "2em"}
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} right
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi y
