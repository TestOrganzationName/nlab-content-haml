          .num_theorem
            %h6 Theorem
            %p
              Suppose that the two parallal identifications of the strict circle type are
              %a.existingWikiWord{:href => "/nlab/show/judgmentally+equal"} judgmentally equal
              to each other of the base of the circle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
