                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi b
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %msub
