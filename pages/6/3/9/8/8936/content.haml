            %p
              which is precisely the
              %a.existingWikiWord{:href => "/nlab/show/judgmental+uniqueness+of+identity+proofs"} judgmental uniqueness of identity proofs
              for type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
