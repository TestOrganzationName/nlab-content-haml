          %h2#idea Idea
          %p
            A form of
            %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identity+type"} heterogeneous identity type
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
          %h2#Definition  Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ⊢
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \colon A \;\vdash\; B(a)
            %em fibered heterogeneous identity type
            is the
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            indexed by
          %ol
            %li
              %p a pair of parameters
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi a
                      %mo ′
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi A
                    %annotation{:encoding => "application/x-tex"}
                      a ,\, a' \;\colon\;  A
              %p
                indexing a
                %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                of
                %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
            %li
              %p a pair of terms of these fiber types
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi b
                      %mo ′
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      b \;\colon\; B(a)
                      ,\;\;\;\;
                      b' \;\colon\; B(a')
              %p
                whose “
                %a.existingWikiWord{:href => "/nlab/show/indexed+heterogeneous+identity+type"}> indexed heterogeneous
                ”
                %a.existingWikiWord{:href => "/nlab/show/identification"} identification
                is to be witnessed,
          %p and defined equivalently as follows:
          %ul
            %li
              %p
                \&amp;lbrack;
                %a{:href => "#Winterhalter23"}> Winterhalter 2023
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://dutchcats.github.io/Weak_type_theories/slides_winterhalter.pdf#page=30"} p. 30
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fhId
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ;
                      %mi a
                      %mo ′
                      %mo ,
                      %mi b
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi p
                          %mo{:lspace => "verythinmathspace"} :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi a
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} ihId
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi p
                      %mo ,
                      %mi b
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      fhId(a, b; a', b')
                      \\;\coloneqq\;
                      \\sum_{p \colon \mathrm{Id}_A(a, a')}
                      \\mathrm{ihId}(b, p, b')
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/indexed+heterogeneous+identity+types"} indexed heterogeneous identity types
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ihId
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi p
                      %mo ,
                      %mi b
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≡
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi p
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi b
                      %mo ′
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      ihId(b, p, b')
                      \\;\equiv\;
                      \\mathrm{Id}_{B(b)}\big(
                      p_\ast(b)
                      ,\,
                      b'
                      \\big)
                      \\,,
              %p
                over all
                %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
