                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi a
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p \colon \mathrm{Id}_A(a, a')
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ∼
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      p_\ast \,\colon\, B(a) \overset{\sim}{\to} B(a')
              %p
                denotes the
                %a.existingWikiWord{:href => "/nlab/show/type+transport"} type transport
                along
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %li
              %p
                as the
                %a.existingWikiWord{:href => "/nlab/show/identification+type"} identification type
                of
                %a.existingWikiWord{:href => "/nlab/show/dependent+pairs"} dependent pairs
                in the
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
