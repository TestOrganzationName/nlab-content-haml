                  %mo ≃
                  %msubsup
                    %mi Sus
                    %mi T
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⊗
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sus^p_T(X) \otimes Sus^q_T(Y) \simeq Sus^{p+q}_T(X \otimes Y)
          %p
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
