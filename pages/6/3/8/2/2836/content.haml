                    %mi C
                  %annotation{:encoding => "application/x-tex"} X,Y \in C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sus
                  %mo =
                  %msup
                    %mi Sus
                    %mn 0
                  %mo :
                  %mi C
                  %mo →
                  %msubsup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Spect
                    %mi T
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sus = Sus^0 : C \to \Spect^\Sigma_T(C)
            is a
