              %li
                %a{:href => "#suspension_functor"} Suspension functor
              %ul
                %li
                  %a{:href => "#as_an_infinity1functor"} As an (infinity,1)-functor
                %li
                  %a{:href => "#as_an_ordinary_functor"} As an ordinary functor
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            admitting a
            %a.existingWikiWord{:href => "/nlab/show/final+object"} final object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} {*}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            its
            %strong suspension object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Sigma X
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pushout
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi Σ
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; \Sigma X
                  }
                  \\,,
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
            of the terminal map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to {*}
          %p
            This concept is dual to that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
          %h2#suspension_functor Suspension functor
          %h3#as_an_infinity1functor As an (infinity,1)-functor
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pointed+%28infinity%2C1%29-category"} pointed (infinity,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi Σ
                %annotation{:encoding => "application/x-tex"} M^\Sigma
            for the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/pushout"} cocartesian squares
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; Y
                  }
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            admits
            %a.existingWikiWord{:href => "/nlab/show/cofibres"} cofibres
            of all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi Σ
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} M^\Sigma \to C
            given by evaluation at the initial vertex (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            ) is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/trivial+fibration"} trivial fibration
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi C
                    %mo →
                    %msup
                      %mi M
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} s : C \to M^\Sigma
            %strong suspension functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi C
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \Sigma_C : C \to C
            is the
            %a.existingWikiWord{:href => "/nlab/show/composite"} composite
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            with the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi Σ
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} M^\Sigma \to C
            given by evaluating at the final vertex (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi C
                %annotation{:encoding => "application/x-tex"} \Sigma_C
            is
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+functor"} loop space functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \Omega_C
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a pointed object of a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+%28%E2%88%9E%2C1%29-topos"} Grothendieck (∞,1)-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Sigma X
            is homotopy equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi ℤ
                    %mo ∧
                    %mi X
                  %annotation{:encoding => "application/x-tex"} B{\mathbb{Z}}\wedge X
          %p
            We outline a proof below. For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a pointed object of a Grothendieck (∞,1)-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
            = succeed "," do
              %em reduced free group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F[X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo :
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi ℋ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Omega {\mathbf{B}}:Grp(\mathcal{H})\to \mathcal{H}_*
            which sends a
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} group object internal
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
            to the loop space of its delooping object.
          #ConstructionOfFreeGroup.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a pointed object of a Grothendieck (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi F
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi Σ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} {\mathbf{B}}F[X]\simeq \Sigma X
          .proof
            %h6#proof Proof
            %p
              This is due to the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ⊢
                    %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi ℋ
                      %mo *
                    %mo ⇆
                    %msub
                      %mi ℋ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (\Sigma \vdash \Omega):\mathcal{H}_*\leftrightarrows\mathcal{H}_*
              between suspending and looping and the the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ⊢
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi PathConn
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℋ
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⇆
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega \vdash {\mathbf{B}}):PathConn(\mathcal{H}_*)\leftrightarrows Grp(\mathcal{H})
              between looping and delooping. Indeed, for any group object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Ω
                            %mi Σ
                            %mi X
                            %mo ,
                            %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Ω
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Grp({\mathcal{H}})(\Omega \Sigma X, H)
                    \&amp;  \simeq
                    PathConn({\mathcal{H}}_*)(\Sigma X, {\mathbf{B}}H)
                    \\\
                    \&amp; \simeq
                    PathConn({\mathcal{H}}_*)(X, \Omega{\mathbf{B}}H)
                    \\,,
                    \\end{aligned}
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi Σ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Omega \Sigma X
              has the universal property of the reduced free group. Delooping gives the required result.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Grp(\mathcal{H})
            of group objects internal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
            is tensored over
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℋ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} {\mathcal{H}}_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a group object and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a pointed object, we can form the tensor product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊗
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X\otimes G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi G
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PathConn
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℋ
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Grp({\mathcal{H}})(\Omega (X\otimes G, H)\simeq PathConn({\mathcal{H}}_*)(X, Grp({\mathcal{H}})(G, H))
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          #ConstructionOfTensorProduct.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a pointed object and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a group object of a Grothendieck (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ⊗
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi X
                      %mo ∧
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} {\mathbf{B}}(X\otimes G)\simeq X\wedge {\mathbf{B}}G
          .proof
            %h6#proof_2 Proof
            %p
              This is due to the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ⊢
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi PathConn
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℋ
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⇆
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Omega \vdash {\mathbf{B}}):PathConn(\mathcal{H}_*)\leftrightarrows Grp(\mathcal{H})
              between looping and delooping and the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              adjunction. Indeed, for any group object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Ω
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∧
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∧
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo ,
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Grp({\mathcal{H}})(\Omega (X\wedge {\mathbf{B}}G), H)
                    \&amp;  \simeq
                    PathConn({\mathcal{H}}_*)(X\wedge {\mathbf{B}}G, {\mathbf{B}}H)
                    \\\
                    \&amp; \simeq
                    PathConn({\mathcal{H}}_*)(X, PathConn({\mathcal{H}}_*)({\mathbf{B}}G, {\mathbf{B}}H))
                    \\\
                    \&amp; \simeq
                    PathConn({\mathcal{H}}_*)(X, Grp({\mathcal{H}})(G, H))
                    \\,,
                    \\end{aligned}
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega (X\wedge {\mathbf{B}}G)
              has the universal property of the tensor product. Delooping gives the required result.
          #FreeGroupAsTensor.num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a pointed object of a Grothendieck (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi X
                      %mo ⊗
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} F[X]\simeq X\otimes Z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              is the group object whose delooping object is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} B {\mathbb{Z}}
          .proof
            %h6#proof_3 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
              is a Grothedieck
              = succeed "-topos," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo −
                    %mo :
                    %mi Group
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} *\to {\mathbf{B}}-:Group(\mathcal{H})\to Func(\Delta^1,\mathcal{H})
              which sends a group object to the map from the terminal object to its delooping object is a
              = succeed "-categorial" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(\Delta^1,\mathcal{H})
              spanned by the effective epimorphisms from the terminal object. Hence, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              a group object, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Z
                            %mo ,
                            %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi Func
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Δ
                              %mn 1
                            %mo ,
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo →
                            %mi B
                            %mi ℤ
                            %mo ,
                            %mo *
                            %mo →
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi ℤ
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Grp(\mathcal{H})(Z,H)
                    \&amp;  \simeq
                    Func(\Delta^1,{\mathcal{H}})(*\to B{\mathbb{Z}},*\to {\mathbf{B}}H)
                    \\\
                    \&amp; \simeq
                    {\mathcal{H}}_*(B{\mathbb{Z}},{\mathbf{B}}H)
                    \\,,
                    \\end{aligned}
            %p
              This latter based mapping object is equivalent to the based object of deloopable maps from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} {\mathbb{Z}}
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi H
                    %annotation{:encoding => "application/x-tex"} \Omega{\mathbf{B}}H
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi H
                    %annotation{:encoding => "application/x-tex"} \Omega{\mathbf{B}}H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} {\mathbb{Z}}
              is the discrete free group on one generator.
            %p Hence, there are the following natural equivalences:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Ω
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi PathConn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ℋ
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Grp
                            %mo{:stretchy => "false"} (
                            %mi Z
                            %mo ,
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Grp({\mathcal{H}})(F[X], H)
                    \&amp;  \simeq
                    PathConn({\mathcal{H}}_*)(X, \Omega{\mathbf{B}}H)
                    \\\
                    \&amp; \simeq
                    PathConn({\mathcal{H}}_*)(X, Grp(Z, H)
                    \\,,
                    \\end{aligned}
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F[X]
              has the universal property of the tensor product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} X\otimes Z
          #SuspendingAsSmashProd.num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a pointed object of a Grothendieck (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} {\mathcal{H}}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mi X
                      %mo ≃
                      %mi B
                      %mi ℤ
                      %mo ∧
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma X\simeq B{\mathbb{Z}}\wedge X
          .proof
            %h6#proof_4 Proof
            %p
              Deloop the natural equivalence in Lemma
              %a.maruku-ref{:href => "#FreeGroupAsTensor"}
              to obtain the natural equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi F
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ⊗
                      %mi Z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {\mathbf{B}}F[X]\simeq {\mathbf{B}}(X\otimes Z)
              %a.maruku-ref{:href => "#ConstructionOfFreeGroup"}
              and
              = succeed "," do
                %a.maruku-ref{:href => "#ConstructionOfTensorProduct"}
          %h3#as_an_ordinary_functor As an ordinary functor
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            admitting small
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            be a
            %a.existingWikiWord{:href => "/nlab/show/graded+monoid"} graded monoid
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : C \to C
            a
            = succeed "-symmetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            that commutes with small
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Spect
                    %mi F
                    %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spect_F^{\Phi}(C)
            denote the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-symmetric" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Following
            = succeed "," do
              %a{:href => "#Ayoub"} Ayoub
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ev
                    %mi n
                  %mo :
                  %msubsup
                    %mi Spect
                    %mi F
                    %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo ,
                %annotation{:encoding => "application/x-tex"} Ev^n : Spect_F^{\Phi}(C) \to C,
          %p
            which “evaluates” a symmetric spectrum at its
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Sus
                    %mi n
                  %mo :
                  %mi C
                  %mo →
                  %msubsup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Spect
                    %mi F
                    %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sus^n : C \to \Spect_F^\Phi(C)
          %p
            called the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %strong suspension functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi C
                      %mrow
                        %mn ∞
                        %mo −
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \Sigma_C^{\infty-n}
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo =
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Phi = \Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %mi T
                  %mo ⊗
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} F = T \otimes -
            for some object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+structure"} symmetric monoidal structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Spect
                    %mi T
