                such that the following
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commute
                in
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
