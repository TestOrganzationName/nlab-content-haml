            %p
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              be any arc
              %em inside
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              connecting these two distinct points. Then Prop.
              %a.maruku-ref{:href => "#Pinching"}
              gives homotopy equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mover
                      %mo ⟶
                      %mo ∼
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ∼
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mn 2
                    %mo ∨
                    %msup
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^2 / S^0
                    \\,=\,
                    X/A
                    \\overset{\sim}{\longrightarrow}
                    X
                    \\overset{\sim}{\longrightarrow}
                    X/B
                    \\,=\,
                    S^2 \vee S^1
                    \\,.
            %p
          (e.g.
          %a{:href => "#Hatcher"} Hatcher 2002
          = succeed ")." do
            %a{:href => "https://pi.math.cornell.edu/~hatcher/AT/AT.pdf#page=20"} p 11
          %p In generalization of this example:
          %p
          .num_remark
            %h6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mrow
                        %mi g
                        %mo ,
                        %mi n
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Σ
                      %mi g
                      %mn 2
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi s
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Sigma^2_{g,n} \,\coloneqq\, \Sigma^2_g \setminus \{s_1, \cdots, s_n\}
              the result of subjecting a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/surface"} surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Sigma^2_g
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/punctures"} punctures
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Σ
                      %mrow
                        %mi g
                        %mo ,
                        %mi n
                      %mn 2
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \big(\Sigma^2_{g,n}\big)^\ast
              is
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              of the original surface with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/circles"} circles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Σ
                      %mrow
                        %mi g
                        %mo ,
                        %mi n
                      %mn 2
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Σ
                      %mi g
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ∨
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %msup
                        %mi S
                        %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(\Sigma^2_{g,n}\big)^\ast
                    \\;\simeq\;
                    \\Sigma^2_g \,\vee\, \textstyle{\bigvee_{n-1}} S^1
                    \\,.
            %p
              This follows from Prop.
              %a.maruku-ref{:href => "#Pinching"}
              by generalizing Ex.
              %a.maruku-ref{:href => "#SphereWithArcAttached"}
              as follows: Instead of a single arc, take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              there to each be, in themselves, the linear
              %a.existingWikiWord{:href => "/nlab/show/graph"} graph
              consisting of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              arcs (
              %a.existingWikiWord{:href => "/nlab/show/edges"}> edges
              ) and observe that after identifying the
              %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              all with each other, this gives the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
              circles.
            %p
              Then take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≔
                    %msubsup
                      %mi Σ
                      %mi g
                      %mn 2
                    %mo ∪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X \coloneqq \Sigma^2_g \cup A
              to be the result of attaching this graph to the closed surface by gluing the vertices to the marked points (the would-be punctures) and observe that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Σ
                        %mrow
                          %mi g
                          %mo ,
                          %mi n
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo =
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi A
                    %annotation{:encoding => "application/x-tex"} (\Sigma^2_{g,n})^\ast = X/A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              similarly identified as the corresponding graph but now embedded inside
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Σ
                        %mi g
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \Sigma^2_g
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi B
                      %mo =
                      %msubsup
                        %mi Σ
                        %mi g
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo ∨
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mrow
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %msup
                          %mi S
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X/B = \Sigma^2_g \,\vee\, \textstyle{\bigvee_{n-1}} S^1
            %p
          %h2#references References
          %ul
            %li#Hatcher02
              %p
