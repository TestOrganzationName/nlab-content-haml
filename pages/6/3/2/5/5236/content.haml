                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            and the two processes look like
            %math#mathml_4d2d8b42f8d091b0a67f871f3adb26722b328e2f_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
