                    %mi b
                    %mo .
                    %mi P
                    %mi a
                    %mo .
                    %mi V
                    %mi a
                    %mo .
                    %mi V
                    %mi b
                  %annotation{:encoding => "application/x-tex"} T_2 = P b.P a.V a.V b
