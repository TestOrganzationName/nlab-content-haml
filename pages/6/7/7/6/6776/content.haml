          %h2#idea Idea
          %p
            %strong Macdonald polynomials
            are a generalization of a
            = succeed "s;" do
              %a.existingWikiWord{:href => "/nlab/show/Schur+function"} Schur function
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Jack+polynomial"} Jack polynomial
            %span.newWikiWord
              orthogonal polynomials
              %a{:href => "/nlab/new/orthogonal+polynomials"} ?
            which are
            %a.existingWikiWord{:href => "/nlab/show/symmetric+functions"} symmetric functions
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x_1,\ldots,x_n
            with coefficients which are rational functions of two additional variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/partition"} partition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mi q
                      %mo ,
                      %msub
                        %mi x
                        %mi i
                %annotation{:encoding => "application/x-tex"} T_{q,x_i}
            which maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f = f(x_1,\ldots, x_n)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                  %mo ,
                  %mi q
                  %msub
                    %mi x
                    %mi i
                  %mo ,
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x_1,\ldots, x_{i-1}, q x_i, x_{i+1},\ldots,x_n)
            and the operators
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi r
                  %annotation{:encoding => "application/x-tex"} D_r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo =
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                %annotation{:encoding => "application/x-tex"} r = 0, 1, \ldots, n
            via
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi r
                  %mo =
                  %msup
                    %mi t
                    %mfrac
                      %mrow
                        %mi r
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mn 2
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi I
                      %mo ⊂
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mo{:stretchy => "false"} |
                      %mi I
                      %mo{:stretchy => "false"} |
                      %mo =
                      %mi r
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                      %mo ,
                      %mi j
                      %mo ∉
                      %mi I
                  %mfrac
                    %mrow
                      %mi t
                      %msub
                        %mi x
                        %mi i
                      %mo −
                      %msub
                        %mi x
                        %mi j
                    %mrow
                      %msub
                        %mi x
                        %mi i
                      %mo −
                      %msub
                        %mi x
                        %mi j
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi T
                    %mrow
                      %mi q
                      %mo ,
                      %msub
                        %mi x
                        %mi i
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  D_r = t^{\frac{r(r-1)}{2}} \sum_{I\subset \{1,\ldots,n\}, |I| = r} \prod_{i\in I, j\notin I} \frac{t x_i-x_j}{x_i-x_j}\prod_{i\in I} T_{q, x_i},
          %p
            and the corresponding generating series
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo :
                    %mo =
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi r
                        %mo =
                        %mn 0
                      %mi n
                    %msub
                      %mi D
                      %mi r
                    %msup
                      %mi u
                      %mi r
                  %annotation{:encoding => "application/x-tex"} D := \sum_{r=0}^n D_r u^r
          %p
            The
            %strong Macdonald polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ;
                  %mi q
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_\lambda(x;q,t)
            is an eigenfunction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            with the eigenvalue
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo +
                  %mi u
                  %msup
                    %mi t
                    %mrow
                      %mi n
                      %mo −
                      %mi i
                  %msup
                    %mi q
                    %mrow
                      %msub
                        %mi λ
                        %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{i=1}^n (1 + u t^{n-i} q^{\lambda_i})
          %p
            In the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mi t
                %annotation{:encoding => "application/x-tex"} q = t
            we get the
            %a.existingWikiWord{:href => "/nlab/show/Schur+function"} Schur function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ;
                    %mi t
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi s
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P_\lambda(x; t,t) = s_\lambda(t)
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ian+G.+Macdonald"}> Ian G. Macdonald
