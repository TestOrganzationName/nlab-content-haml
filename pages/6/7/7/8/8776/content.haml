          %h2#idea Idea
          %p
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            in
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            5.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} N = 1
            this arises from
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            by
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            on a
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau manifold
            of complex dimension 3 (see at
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/M-theory+on+Calabi-Yau+manifolds"} M-theory on Calabi-Yau manifolds
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
            of the strong-coupling version of Calabi-Yau compactifications of
            %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
            (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry+and+Calabi-Yau+manifolds"} supersymmetry and Calabi-Yau manifolds
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 11
                          %mi d
                          %mspace{:width => "thickmathspace"}
                          %mi SuGra
                          %mspace{:width => "thickmathspace"}
                          %mi on
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi S
                            %mn 1
                          %mo ×
                          %msub
                            %mi Y
                            %mn 6
                          %mo ×
                          %msub
                            %mi X
                            %mn 4
                        %mtd
                          %mo ⟶
                        %mtd
                          %mn 5
                          %mi d
                          %mspace{:width => "thickmathspace"}
                          %mi SuGra
                          %mspace{:width => "thickmathspace"}
                          %mi on
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi S
                            %mn 1
                          %mo ×
                          %msub
                            %mi X
                            %mn 4
                        %mtd
                        %mtd
                          %mi strong
                          %mspace{:width => "thickmathspace"}
                          %mi coupling
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mn 10
                          %mi d
                          %mspace{:width => "thickmathspace"}
                          %mi tpye
                          %mspace{:width => "thickmathspace"}
                          %mi IIA
                          %mspace{:width => "thickmathspace"}
                          %mi Sugra
                          %mspace{:width => "thickmathspace"}
                          %mi on
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Y
                            %mn 6
                          %mo ×
                          %msub
                            %mi X
                            %mn 4
                        %mtd
                          %mo ⟶
                        %mtd
                          %mn 10
                          %mi d
                          %mspace{:width => "thickmathspace"}
                          %mi Sugra
                          %mspace{:width => "thickmathspace"}
                          %mi on
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi X
                            %mn 4
                        %mtd
