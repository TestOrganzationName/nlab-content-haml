                          %mspace{:width => "thickmathspace"}
                          %mi coupling
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  11d \; SuGra\; on\; S^1 \times Y_6 \times X_4
                  \&amp;\longrightarrow&amp;
                  5d \; SuGra\; on\; S^1 \times X_4 &amp;&amp; strong \; coupling
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
