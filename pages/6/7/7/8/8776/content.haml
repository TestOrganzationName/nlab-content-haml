            %p
              (
              %a{:href => "U-duality#HullTownsend94"}> Hull-Townsend 94, table 1, table 2
              )
          %h3#_supersymmetry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} N = 2
            supersymmetry
          %p
            Consider super Lie algebra cocoycles on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} N =2
            5d
            %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
            (as in the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
          %p
            With the notation as used at
            = succeed "," do
              %em
                %a{:href => "super%20Minkowski%20spacetime#CanonicalCoordinates"} super Minkowski spacetime – Canonical coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ψ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \psi_1
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \psi_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"} A,B, \cdots
            for these. Then the non-trivial bit of the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            differential for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} N = 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 5
                %annotation{:encoding => "application/x-tex"} d = 5
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %msup
                    %mi e
                    %mi a
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi i
                      %mn 2
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi A
                  %mo ∧
                  %msup
                    %mi Γ
                    %mi a
                  %msub
                    %mi ψ
                    %mi A
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} e^a = - \tfrac{i}{2} \overline{\psi}_A \wedge \Gamma^a \psi_A
          %p where summation over repeated indices is understood.
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/Fierz+identity"} Fierz identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi A
                  %mo ∧
                  %msub
                    %mi ψ
                    %mi A
                  %mo ∧
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi B
                  %mo ∧
                  %msub
                    %mi ψ
                    %mi B
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi A
                  %mo ∧
                  %msub
                    %mi Γ
                    %mi a
                  %msub
                    %mi ψ
                    %mi A
                  %mo ∧
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi B
                  %mo ∧
                  %msup
                    %mi Γ
                    %mi a
                  %msub
                    %mi ψ
                    %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\overline{\psi}_A \wedge \psi_A \wedge \overline{\psi}_B \wedge \psi_B
                  \\;=\;
                  \\overline{\psi}_A \wedge \Gamma_a \psi_A
                  \\wedge \overline{\psi}_B \wedge \Gamma^a \psi_B
                  \\,.
          %p
            (
            %a{:href => "#CastellaniDAuriaFre"}> Castellani-D’Auria-Fré (III.5.50a)
            )
          %p This implies that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi A
                  %msup
                    %mi Γ
                    %mi a
                  %msub
                    %mi ψ
                    %mi A
                  %mo ∧
                  %msub
                    %mi e
                    %mi a
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∝
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi A
                  %mo ∧
                  %msup
                    %mi Γ
                    %mi a
                  %msub
                    %mi ψ
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi B
                  %mo ∧
                  %msup
                    %mi Γ
                    %mi a
                  %msub
                    %mi ψ
                    %mi B
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} (\overline{\psi}_A \Gamma^a \psi_A \wedge e_a)
                  \\;\propto\;
                  (\overline{\psi}_A \wedge \Gamma^a \psi_A)
                  \\wedge
                  (\overline{\psi}_B \wedge \Gamma^a \psi_B)
                  \\,.
          %p There is a 4-cocycle of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 2
                  %mo =
                  %msup
                    %mi ϵ
                    %mrow
                      %mi A
                      %mi B
                  %msub
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi A
                  %mo ∧
                  %msup
                    %mi Γ
                    %mrow
                      %mi a
                      %mi b
                  %msub
                    %mi ψ
                    %mi B
                  %mo ∧
                  %msub
                    %mi e
                    %mi a
                  %mo ∧
                  %msub
                    %mi e
                    %mi b
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mu_2
                  \=
                  \\epsilon^{A B} \overline{\psi}_A \wedge \Gamma^{a b} \psi_B
                  \\wedge e_a \wedge e_b
                  \\,.
          %p
            (
            %a{:href => "#CastellaniDAuriaFre"}> Castellani-D’Auria-Fré (III.5.50b), (III.5.53c)
            )
