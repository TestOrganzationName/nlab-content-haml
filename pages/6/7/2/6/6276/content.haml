                %a{:href => "#literature"} Literature
          %h2#magnus_algebras_and_magnus_group Magnus algebras and Magnus group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a set of symbols and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            denote the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative k-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} k\langle X \rangle
            on the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative
            %a.existingWikiWord{:href => "/nlab/show/unital+ring"} unital
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(X)
            %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded
            (by the length of the word) as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⊕
                      %mi n
                    %msup
                      %mi A
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(X) = \oplus_n A^n(X)
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi n
                  %msup
                    %mi A
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{A}(X) = \prod_n A^n(X)
            has a natural multiplication
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ab
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mi n
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mi i
                %annotation{:encoding => "application/x-tex"}
                  (ab)_n = \sum_{i = 0}^n a_i b_{n-i}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} a = (a_n)_n
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} b = (b_n)_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{A}(X)
            has the topology of the product of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{A}(X)
            a
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff topological
            algebra, where the ground field is considered discrete and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(X)
            is dense in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{A}(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{A}(X)
            is the
            %strong Magnus algebra
            with coefficients in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            An element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{A}(X)
            is invertible (under multiplication) iff it’s free term is invertible in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            The
            %strong Magnus group
            is the (multiplicative) subgroup of the Magnus algebra consisting of all elements in the Magnus algebra with free term
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %h2#hausdorff_group_and_hausdorff_series Hausdorff group and Hausdorff series
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/free+Lie+algebra"} free Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(X)
            naturally embeds in (the Lie algebra corresponding to the associative algebra)
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(X)\hookrightarrow \hat{A}(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi L
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{L}(X)
            as the closure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(X)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{A}(X)
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{A}(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi L
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{L}(X)
            it gives a bijection between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi L
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{L}(X)
            and a closed subgroup of the Magnus group which is sometimes called the Hausdorff group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi L
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} exp(\hat{L}(X))
          %p
            %strong Hausdorff series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(U,V)
            is an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi log
                  %mo{:stretchy => "false"} (
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} log(exp(U)exp(V))
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi L
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{L}(\{U,V\})
          %p
            The formula
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} exp(X)exp(Y) = (exp(Y)exp(X))^{-1}
            implies the basic symmetry of the Hausdorff series:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi Y
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(-Y,-X) = -H(X,Y)
          %p
            The specializations of the Hausdorff series in Lie algebras which are not necessarily free are known as the
            %strong Baker-Campbell-Hausdorff
            series and play the role in the corresponding BCH formula
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} exp(U)exp(V) = exp(H(U,V))
          %p
            The BCH formula can be written in many ways, the most important which belong to Dynkin. The part which is linear in one of the variables involves
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Bernoulli+number"} Bernoulli number
          %p
            There is a decomposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi N
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi H
                    %mi N
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(X,Y) = \sum_{N=0}^\infty H_N(X,Y)
            where
            %strong Dynkin’s Lie polynomials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi N
                  %mo =
                  %msub
                    %mi H
                    %mi N
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_N = H_N(X,Y)
            are defined recursively by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 1
                  %mo =
                  %mi X
                  %mo +
                  %mi Y
                %annotation{:encoding => "application/x-tex"} H_1 = X+Y
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi H
                    %mrow
                      %mi N
                      %mo +
                      %mn 1
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo −
                  %mi Y
                  %mo ,
                  %msub
                    %mi H
                    %mi N
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi r
                      %mo =
                      %mn 0
                    %mrow
                      %mo{:stretchy => "false"} ⌊
                      %mi N
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} ⌋
                  %mfrac
                    %mrow
                      %msub
                        %mi B
                        %mrow
                          %mn 2
                          %mi r
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo !
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi s
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi H
                    %mrow
                      %msub
                        %mi s
                        %mn 1
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi H
                    %mrow
                      %msub
                        %mi s
                        %mn 2
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi …
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi H
                    %mrow
                      %msub
                        %mi s
                        %mrow
                          %mn 2
                          %mi r
                  %mo ,
                  %mi X
                  %mo +
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mi …
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  (N+1)H_{N+1} = \frac{1}{2}[X-Y,H_N] +
                  \\sum_{r = 0}^{\lfloor N/2 -1\rfloor}
                  \\frac{B_{2r}}{(2r)!}\sum_s
                  [H_{s_1},[H_{s_2},[ \ldots, [H_{s_{2r}},X+Y]\ldots]]]
          %p
            where the sum over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            is the sum over all
            = succeed "-tuples" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi r
                  %annotation{:encoding => "application/x-tex"} 2r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi s
                    %mrow
                      %mn 2
                      %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s = (s_1,\ldots,s_{2r})
            of strictly positive integers whose sum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 1
                    %mo +
                    %mi …
                    %mo +
                    %msub
                      %mi s
                      %mrow
                        %mn 2
                        %mi r
                    %mo =
                    %mi N
                  %annotation{:encoding => "application/x-tex"} s_1 +\ldots+s_{2r} = N
          %p
            The Hausdorff series satisfies the symmetry
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi Y
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(-Y,-X) = -H(X,Y)
          %p First few terms of Hausdorff series are:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo +
                  %mi Y
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 12
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi X
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo +
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi Y
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mo +
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 24
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                  %mi Y
                  %mo ,
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi X
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                  %mo +
                  %mi …
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H(X,Y)
                  \\;=\;
                  X + Y
                  +
                  \\tfrac{1}{2}[X,Y]
                  + \tfrac{1}{12}
                  \\Big(
                  \\big[X,[X,Y]\big]
                  +
                  \\big[Y,[Y,X]\big]
                  \\Big)
                  +
                  \\tfrac{1}{24}
                  \\Big[
                  Y, \big [X,[Y,X] \big]
                  \\Big]
                  + \ldots
                  \\,.
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Malcev+completion"} Malcev completion
            %li
