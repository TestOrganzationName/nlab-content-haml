                  %path{:d => "m100,50l-100,40l30,-40l-30,-40z", :fill => "#000000", :stroke => "#000000", "stroke-width" => "10"}
                %marker#se_marker_end_svg_14804_27{:markerheight => "5", :markerunits => "strokeWidth", :markerwidth => "5", :orient => "auto", :refx => "50", :refy => "50", :se_type => "rightarrow", :viewbox => "0 0 100 100"}
                  %path{:d => "m100,50l-100,40l30,-40l-30,-40z", :fill => "#000000", :stroke => "#000000", "stroke-width" => "10"}
                %marker#se_marker_end_svg_14804_29{:markerheight => "5", :markerunits => "strokeWidth", :markerwidth => "5", :orient => "auto", :refx => "50", :refy => "50", :se_type => "rightarrow", :viewbox => "0 0 100 100"}
                  %path{:d => "m100,50l-100,40l30,-40l-30,-40z", :fill => "#000000", :stroke => "#000000", "stroke-width" => "10"}
