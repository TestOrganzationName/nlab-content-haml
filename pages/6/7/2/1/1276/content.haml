                  %path{:d => "m100,50l-100,40l30,-40l-30,-40z", :fill => "#000000", :stroke => "#000000", "stroke-width" => "10"}
                %marker#se_marker_end_svg_14804_31{:markerheight => "5", :markerunits => "strokeWidth", :markerwidth => "5", :orient => "auto", :refx => "50", :refy => "50", :se_type => "rightarrow", :viewbox => "0 0 100 100"}
                  %path{:d => "m100,50l-100,40l30,-40l-30,-40z", :fill => "#000000", :stroke => "#000000", "stroke-width" => "10"}
                %marker#se_marker_end_svg_14804_51{:markerheight => "5", :markerunits => "strokeWidth", :markerwidth => "5", :orient => "auto", :refx => "50", :refy => "50", :se_type => "rightarrow", :viewbox => "0 0 100 100"}
                  %path{:d => "m100,50l-100,40l30,-40l-30,-40z", :fill => "#000000", :stroke => "#000000", "stroke-width" => "10"}
                %marker#se_marker_end_svg_14804_52{:markerheight => "5", :markerunits => "strokeWidth", :markerwidth => "5", :orient => "auto", :refx => "50", :refy => "50", :se_type => "rightarrow", :viewbox => "0 0 100 100"}
                  %path{:d => "m100,50l-100,40l30,-40l-30,-40z", :fill => "#000000", :stroke => "#000000", "stroke-width" => "10"}
          %p
            Saying that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is flat says that this lift always occurs.
          #RelationsFromCharacterizationonIdealInclusion.num_prop
            %h6#proposition Proposition
            %p
              A module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is flat precisely if for every finite linear combination of zero,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi r
                      %mi i
                    %msub
                      %mi n
                      %mi i
                    %mo =
                    %mn 0
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \sum_i r_i n_i  = 0\in N
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi r
                        %mi i
                      %mo ∈
                      %mi R
                      %msub
                        %mo{:stretchy => "false"} }
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \{r_i \in R\}_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi n
                      %mi i
                    %mo ∈
                    %mi N
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{n_i \in N\}
              there are elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mover
                        %mi n
                        %mo{:stretchy => "false"} ˜
                      %mi j
                    %mo ∈
                    %mi N
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \{\tilde n_j \in N\}_j
              and linear combinations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi i
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %msub
                      %mi b
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mover
                        %mi n
                        %mo{:stretchy => "false"} ˜
                      %mi j
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    n_i = \sum_j b_{i j} \tilde n_j \;\;\in  N
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi b
                      %mrow
                        %mi i
                        %mi j
                    %mo ∈
                    %mi R
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} \{b_{i j} \in R\}_{i,j}
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi r
                      %mi i
                    %msub
                      %mi b
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi R
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_i r_i b_{i j}  = 0\;\;\; \in R
                    \\,.
          .proof
            %h6#proof Proof
            %p
              A finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi r
                      %mi i
                    %mo ∈
                    %mi R
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \{r_i \in R\}_i
              corresponds to the inclusion of a finitely generated ideal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ↪
                      %mi R
                    %annotation{:encoding => "application/x-tex"} I \hookrightarrow R
            %p
              By theorem
              %a.maruku-ref{:href => "#CharacterizationOnIdealInclusions"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is flat precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mo ⊗
                      %mi R
                    %mi N
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} I \otimes_R N \to N
              is an injection. This in turn is the case precisely if the only element of the tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mo ⊗
                      %mi R
                    %mi R
                  %annotation{:encoding => "application/x-tex"} I \otimes_R R
              that is 0 in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %msub
                      %mo ⊗
                      %mi R
                    %mi N
                    %mo =
                    %mi N
                  %annotation{:encoding => "application/x-tex"} R \otimes_R N = N
              is already 0 on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %msub
                        %mo ⊗
                        %mi R
                      %mi N
                    %annotation{:encoding => "application/x-tex"} I \otimes_R N
            %p
              Now by definition of
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              an element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mo ⊗
                      %mi R
                    %mi N
                  %annotation{:encoding => "application/x-tex"} I \otimes_R N
              is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi i
                    %mo ,
                    %msub
                      %mi n
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_i (r_i ,n_i)
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi n
                        %mi i
                      %mo ∈
                      %mi N
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{n_i \in N\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mo ⊗
                      %mi R
                    %mi N
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} I \otimes_R N \to N
              this maps to the actual linear combination
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi r
                        %mi i
                      %msub
                        %mi n
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \sum_i r_i n_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi i
                    %mo ,
                    %msub
                      %mi n
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_i (r_i, n_i)
              is 0.
            %p
              But the latter is the case precisely if this is equal to a combination
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} ˜
                      %mi j
                    %mo ,
                    %msub
                      %mover
                        %mi n
                        %mo{:stretchy => "false"} ˜
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_j (\tilde r_j  , \tilde n_j)
              where all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} ˜
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \tilde r_j
              are 0. This implies the claim.
          %p
            Taking this a step further, we consider the
            %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered family
            of all finite
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
            %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
            with compatible morphisms to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            of this family to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
            by construction. To show that it is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/injection"} injective
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            has actually died on the way. This is precisely what the above characterisation of flatness is saying: the element corresponding to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mi m
                    %mi i
                %annotation{:encoding => "application/x-tex"} \sum_i a_i m_i
            that dies in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is already dead by the time it reaches
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p We have thus arrived at the following result:
          #filtfree.num_theorem
            %h6#theorem Theorem
            %p
              A module is flat if and only if it is a
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              of finitely generated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
          %p
            This observation (Wraith, Blass) can be put into the more general context of modelling
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theories
            by
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphisms
            from their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying toposes
            %a.existingWikiWord{:href => "/nlab/show/flat+functor"} flat functors
            from
            %a.existingWikiWord{:href => "/nlab/show/site"} sites
            for such topoi.
          %h3#for_more_general_rings For more general rings
          %p
            Even if the
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is not necessarily commutative and not necessarily unital, we can say:
          %p
            A left
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            is flat precisely if the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensoring
            functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi R
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Mod
                    %mi R
                  %mo →
                  %mi Ab
                %annotation{:encoding => "application/x-tex"}
                  (-)\otimes_R \colon Mod_R \to Ab
          %p
            from
            %em right
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            modules to
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
          %h2#general_properties General properties
          %h3#properties_of_the_category_of_flat_modules Properties of the category of flat modules
          %p
          .num_prop
            %h6 Proposition
            %p
              The full subcategory of flat modules over a ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is stable under the following categorical constructions :
            %ol
              %li (infinite) sums ;
              %li filtered colimits ;
              %li retracts;
              %li tensor product.
            %p
          #ProjectiveModulesAreFlat.num_prop
            %h6#corollary Corollary
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              is flat.
          .proof
            %h6#proof_2 Proof
            %p
              Every projective module is a retract of a free module, which in turn is a sum of copies of the base ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
          .num_cor
            %h6 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a commutative ring and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} S \subset R
              be a multiplicative subset. Then the localisation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[S^{-1}]
              is a flat
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
          .proof
            %h6 Proof
            %p
              Regard the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              as a poset with de divisibility relation. The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be multiplicative means that the poset is directed. One thus have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi s
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mi s
                    %mspace{:width => "thickmathspace"}
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R[S^{-1}] = \underset{\longrightarrow}{\lim}_s \;\frac{1}{s} \; R
              is a filtered colimit of free modules, hence it is flat.
          %h3#flatness_is_a_local_property Flatness is a local property
          %p
          .num_prop
            %h6 Proposition
            %p
              (Stability under base change) Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} R \to S
              be a morphism of commutative rings and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a flat
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %msub
                      %mo ⊗
                      %mi R
                    %mi S
                  %annotation{:encoding => "application/x-tex"} M \otimes_R S
              is also flat.
          %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              be an injective morphism of
              = succeed "-modules," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %msub
                      %mo ⊗
                      %mi R
                    %mi S
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi S
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi M
                    %msub
                      %mo ⊗
                      %mi R
                    %mi S
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi S
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} (M \otimes_R S) \otimes_S X \to (M \otimes_R S) \otimes_S Y
              is isomorphic to the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %msub
                      %mo ⊗
                      %mi R
                    %mi X
                    %mo →
                    %mi M
                    %msub
                      %mo ⊗
                      %mi R
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} M \otimes_R X \to M \otimes_R Y
              which is injective because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is flat.
          %p
          .num_prop
            %h6 Proposition
            %p
              (Flatness is a local property) Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a commutative ring and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be an
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                is flat;
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi 𝔭
                    %annotation{:encoding => "application/x-tex"} M_\mathfrak{p}
                is a flat
                = succeed "-module," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi R
                          %mi 𝔭
                      %annotation{:encoding => "application/x-tex"} R_\mathfrak{p}
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔭
                        %mo ⊂
                        %mi R
                      %annotation{:encoding => "application/x-tex"} \mathfrak{p} \subset R
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi 𝔪
                    %annotation{:encoding => "application/x-tex"} M_\mathfrak{m}
                is a flat
                = succeed "-module," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi R
                          %mi 𝔪
                      %annotation{:encoding => "application/x-tex"} R_\mathfrak{m}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔪
                        %mo ⊂
                        %mi R
                      %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subset R
            %p
          %p
          .proof
            %h6 Proof
            %p
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 1
                    %mo ⇒
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1 \Rightarrow 2
              \. By base change.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 2
                    %mo ⇒
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 2 \Rightarrow 3
              \. Obvious.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 3
                    %mo ⇒
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 3 \Rightarrow 1
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              be an injective morphism of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              denote the kernel of the induced map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %msub
                        %mo ⊗
                        %mi R
                      %mi X
                      %mo →
                      %mi M
                      %msub
                        %mo ⊗
                        %mi R
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} M \otimes_R X \to M \otimes_R Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} R_\mathfrak{m}
              is a flat
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi 𝔪
                    %mo →
                    %msub
                      %mi Y
                      %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} X_\mathfrak{m} \to Y_\mathfrak{m}
              is also injective ; and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} K_\mathfrak{m}
              is the kernel of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi 𝔪
                      %msub
                        %mo ⊗
                        %mrow
                          %msub
                            %mi R
                            %mi 𝔪
                      %msub
                        %mi X
                        %mi 𝔪
                      %mo →
                      %msub
                        %mi M
                        %mi 𝔪
                      %msub
                        %mo ⊗
                        %mrow
                          %msub
                            %mi R
                            %mi 𝔪
                      %msub
                        %mi Y
                        %mi 𝔪
                    %annotation{:encoding => "application/x-tex"} M_\mathfrak{m} \otimes_{R_\mathfrak{m}} X_\mathfrak{m}\to M_\mathfrak{m} \otimes_{R_\mathfrak{m}} Y_\mathfrak{m}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi 𝔪
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} K_\mathfrak{m} = 0
              for every maximal ideal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo ⊂
                      %mi R
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subset R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} K = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is flat.
          %h3#flat_modules_are_torsionfree Flat modules are torsion-free
          %p
          .num_prop
            %h6 Proposition
            %p
              For any module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              over a ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mspace{:width => "thickmathspace"}
                    %mtext is flat
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi M
                    %mspace{:width => "thickmathspace"}
                    %mtext is torsion-free
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    M\;\text{is flat}
                    \\;\;\;\;\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;\;\;\;\;
                    M\;\text{is torsion-free}
                    \\,.
            %p
          %p
          .proof
            %h6 Proof
            %p
              For every regular element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} p \in R
              = succeed "-torsion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi{:mathvariant => "normal"} Tor
                        %mn 1
                        %mi R
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Tor}^R_1(M, R/(p))
          %p The converse holds for semi-hereditary rings.
          %h2#reduction_to_cyclic_modules Reduction to cyclic modules
          %p
          .num_theorem
            %h6 Theorem
            %p
              (Reduction to cyclic modules) Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a commutative ring and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be an
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mn 1
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Tor_1^R(M, R/I) = 0
            %p
              for every finitely generated ideal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊂
                      %mi R
                    %annotation{:encoding => "application/x-tex"} I \subset R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a flat
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p Equivalently, if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %msub
                      %mo ⊗
                      %mi R
                    %mi M
                    %mo →
                    %mi IM
                  %annotation{:encoding => "application/x-tex"}
                    I \otimes_R M \to IM
            %p
              is an isomorphism for every finitely generated ideal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊂
                      %mi R
                    %annotation{:encoding => "application/x-tex"} I \subset R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is flat.
          %p
          .proof
            %h6 Proof
            %p The proof goes in 3 steps.
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Tor
                        %mn 1
                        %mi R
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Tor_1^R(M, R/I) = 0
                for every ideal
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo ⊂
                        %mi R
                      %annotation{:encoding => "application/x-tex"} I \subset R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                as the union of the finitely generated ideals
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi{:mathvariant => "normal"} fin
                        %mo ⊂
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I_\mathrm{fin} \subset I
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mi I
                        %mo =
                        %msub
                          %munder
                            %mi lim
                            %mo ⟶
                          %mrow
                            %msub
                              %mi I
                              %mi{:mathvariant => "normal"} fin
                            %mo ⊂
