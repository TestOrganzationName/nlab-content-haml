          %h2#Idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            %em flat
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            (due to
            = succeed ")" do
              %a{:href => "#GAGA"} GAGA
            %a.existingWikiWord{:href => "/nlab/show/torsion-free+modules"} torsion-free modules
            over
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            that are not
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/PID"} PID
          %p
            An
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is
            %em flat
            (from the French word “
            %em> plat
            ”) if it has “no torsion” in the sense that the
            = succeed "-functor" do
              %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mspace{:width => "thickmathspace"}
                  %mtext is flat
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo ∀
                    %mrow
                      %mi X
                      %mo ∈
                      %mi R
                      %mi Mod
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi{:mathvariant => "normal"} Tor
                    %mn 1
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  M\;\text{is flat}
                  \\;\;\;\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;\;\;\;
                  \\underset{X \in R Mod}{\forall}
                  \\;\;\;
                  \\mathrm{Tor}_1^R(M, X) \,=\, 0
                  \\,.
          %p
          #TerminologyAndRelationToFiberBundles.num_remark
            %h6 Remark
            %p
              %strong (terminology and relation to fiber bundles)
              %br/
              %a.existingWikiWord{:href => "/nlab/show/finitely+presented+module"} Finitely presented
              flat modules are locally free [
              %a.maruku-ref{:href => "#FinitelyPresentedFlatIsProjective"}>
              ], hence under the
              %a.existingWikiWord{:href => "/nlab/show/duality+between+algebra+and+geometry"} dual geometric interpretation
              of
              %a{:href => "module#RelationToVectorBundlesInIntroduction"} modules as generalized vector bundles
              over the space on which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring+of+functions"} ring of functions
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+triviality"} local triviality
              of this bundle, hence in particular the fact that the
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              of the bundle do not change, up to isomorphism (cf.
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %p
              On the other hand there is
              %strong no
              relation to “flat” as in
              %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
              on such a bundle.
          %h2#Definition Definition
          %p
            We first state the definition and its equivalent reformulations over a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            abstractly in
            = succeed "." do
              %em
                %a{:href => "#InTermsOfExactFunctorsAndTorFunctors"} In terms of exact functors and Tor-functors
            = succeed "." do
              %em
                %a{:href => "#InTermsOfIdentities"} Explicitly in terms of identities
          %p
            Much of this discussion also works in the more general case where the ring is not-necessarily taken to be commutative and not necessarily required to be equipped with a unit, this we indicate in
            = succeed "." do
              %em
                %a{:href => "#spring"} For more general rings
          %h3#InTermsOfExactFunctorsAndTorFunctors In terms of exact functors and Tor-functors
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
          #FlatModule.num_defn
            %h6#definition_2 Definition
            %p
              An
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is
              %strong flat
              if
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensoring
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              as a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              to itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi R
                    %mi N
                    %mo :
                    %mi R
                    %mi Mod
                    %mo →
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    (-)\otimes_R N : R Mod \to R Mod
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
              (sends
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              to short exact sequences).
          #FaithfullyFlatModule.num_defn
            %h6#definition_3 Definition
            %p
              A module as above is
              %em faithfully flat
              if it is flat and tensoring in addition
              = succeed "," do
                %em reflects exactness
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is nonzero if and only if the module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊗
                    %mi N
                  %annotation{:encoding => "application/x-tex"} M\otimes N
              is nonzero.
          #ImmediateReformulationOfFlatness.num_remark
            %h6#remark Remark
            %p
              The condition in def.
              %a.maruku-ref{:href => "#FlatModule"}
              has the following immediate equivalent reformulations:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is flat precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi R
                        %mi N
                      %annotation{:encoding => "application/x-tex"} (-)\otimes_R N
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
                %p
                  because tensoring with any module is generally already a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is flat precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi R
                        %mi N
                      %annotation{:encoding => "application/x-tex"} (-)\otimes_R N
                  sends
                  %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
                  (
                  %a.existingWikiWord{:href => "/nlab/show/injections"}> injections
                  ) to monomorphisms,
                %p
                  because for a right exact functor to also be left exact the only remaining condition is that it preserves the monomorphisms on the left of a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is flat precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi R
                        %mi N
                      %annotation{:encoding => "application/x-tex"} (-)\otimes_R N
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/flat+functor"} flat functor
                %p
                  because
                  %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is flat precisely if the degree-1
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Tor
                          %mn 1
                          %mrow
                            %mi R
                            %mi Mod
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Tor_1^{R Mod}(-,N)
                  is zero,
                %p
                  because by the general properties of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/derived+functors+in+homological+algebra"} derived functors in homological algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn 1
                        %mi F
                      %annotation{:encoding => "application/x-tex"} L_1 F
                  is the obstruction to a
                  %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  being left exact;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is flat precisely if all higher
                  %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
                  functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Tor
                          %mrow
                            %mo ≥
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mi Mod
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Tor_{\geq 1}(R Mod)(-,N)
                  are zero,
                %p
                  because the higher
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor+in+homological+algebra"} derived functors
                  of an
                  %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
                  vanish;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is flat precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+object"} acyclic object
                  with respect to the tensor product functor;
                %p
                  because the
                  %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
                  functor is symmetric in both arguments and an object is called tensor-
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+object"} acyclic object
                  if all its positive-degree
                  = succeed "-groups" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Tor
                        %annotation{:encoding => "application/x-tex"} Tor
          %p
            The condition in def.
            %a.maruku-ref{:href => "#FlatModule"}
            also has a number of not so immediate equivalent reformulations. These we discuss in detail below in
            = succeed "." do
              %em
                %a{:href => "#EquivalentCharacterizations"} Equivalent characterizations
            = succeed "." do
              %em
                %a{:href => "#InTermsOfIdentities"} In terms of identities
          %h3#InTermsOfIdentities Explicitly in terms of identities
          %p
            There is a characterisation of flatness that says that a left
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is flat if and only if “everything (that happens in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed ")\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.maruku-ref{:href => "#RelationsFromCharacterizationonIdealInclusion"}
            it is shown how this is equivalent to def.
            %a.maruku-ref{:href => "#FlatModule"}
            above.
          %p
            The meaning of this is akin to the existence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/basis+of+a+vector+space"} bases in vector spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi α
                    %mi i
                  %msub
                    %mi v
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \sum_i \alpha_i v_i = 0
            then we cannot necessarily assume that the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi i
                %annotation{:encoding => "application/x-tex"} \alpha_i
            are all zero. However, if we choose a basis then we can write each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} v_i
            in terms of the basis elements, say
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi j
                    %msub
                      %mi β
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mi u
                      %mi j
                  %annotation{:encoding => "application/x-tex"} v_i = \sum_j \beta_{i j} u_j
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mi α
                      %mi i
                    %msub
                      %mi β
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mi u
                      %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sum_{i j} \alpha_i \beta_{i j} u_j = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi u
                    %mi j
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{u_j\}
            forms a basis, we can deduce from this that for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi α
                      %mi i
                    %msub
                      %mi β
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sum_i \alpha_i \beta_{i j} = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in the analogy.
          %p When translating this into the language of modules we cannot use bases so we have to be a little more relaxed. The following statement is the right one.
          %p
            Suppose there is some identity in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mi m
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \sum_i a_i m_i = 0
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mi i
                  %mo ∈
                  %mi M
                %annotation{:encoding => "application/x-tex"} m_i \in M
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a_i \in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi n
                    %mi j
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{n_j\}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            such that every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mi i
                %annotation{:encoding => "application/x-tex"} m_i
            can be written in the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mi i
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi j
                  %msub
                    %mi b
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mi n
                    %mi j
                %annotation{:encoding => "application/x-tex"} m_i = \sum_j b_{i j} n_j
            and the coefficients
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mrow
                      %mi i
                      %mi j
                %annotation{:encoding => "application/x-tex"} b_{i j}
            have the property that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi a
                      %mi i
                    %msub
                      %mi b
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sum_i a_i b_{i j} = 0
          %p
            The module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            being flat is equivalent to being able always to do this.
          %p
            There is an alternative way to phrase this which is less element-centric. The elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mi i
                %annotation{:encoding => "application/x-tex"} m_i
            correspond to a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            from a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
