              be an ordinary
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of abelian groups, i.e. a chain complex of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/module+over+a+groupoid"} modules over the trivial groupoid
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Θ
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} (\Theta C)_1
              is the groupoid with objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0
              and morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
