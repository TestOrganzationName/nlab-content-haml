          %p
          .num_defn
            %h6 Definition
            %p
            %p
              A
              %strong crossed complex
              (“of groupoids”)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 1
                        %mover
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi δ
                                %mi s
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi δ
                                %mi t
                        %msub
                          %mi C
                          %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        C_1 \stackrel{\overset{\delta_t}{\to}}{\underset{\delta_s}
                        {\to}} C_0
              %li
                %p
                  together with a sequence of
                  %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeletal
                  groupoids
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mi k
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi k
                            %mo =
                            %mn 2
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} (C_k)_{k = 2}^\infty
                  over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} C_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi k
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mi x
                            %mo ∈
                            %msub
                              %mi C
                              %mn 0
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mi k
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi x
                      %annotation{:encoding => "application/x-tex"} C_k = \coprod_{x \in C_0} (C_k)_x
                  of groups over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} C_0
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ≥
                          %mn 3
                        %annotation{:encoding => "application/x-tex"} k \geq 3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
