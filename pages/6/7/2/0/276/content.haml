                                  %mi δ
                                  %mi t
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi δ
                                  %mi s
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo =
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mo =
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mo =
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                        %mtd
                          %mover
                            %mo →
