          .un_prop
            %h6#proposition_2 Proposition
            %p
              These form a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
