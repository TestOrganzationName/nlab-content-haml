                        %mtd
                          %msub
                            %mi C
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{c}
                    \\cdots &amp;\to&amp; C_3 &amp;\stackrel{\delta}{\to}&amp; C_2
                    \&amp;\stackrel{\delta}{\to}&amp;
                    C_1 &amp;
                    \\stackrel{\overset{\delta_t}{\to}}{\underset{\delta_s}{\to}} &amp;
                    C_0
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{\delta_s}}
                    \&amp;&amp; \downarrow^{\mathrlap{=}}
                    \\\
                    \\cdots &amp;\to&amp;
                    C_0
                    \&amp;\stackrel{=}{\to}&amp;
                    C_0
                    \&amp;\stackrel{=}{\to}&amp;
                    C_0
                    \&amp;\stackrel{=}{\to}&amp;
                    C_0
                    \\end{array}
            %ul
              %li
                together with a
                %a.existingWikiWord{:href => "/nlab/show/groupoid+action"} groupoid action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C_1
                on all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi k
                      %annotation{:encoding => "application/x-tex"} C_k
            %p such that
            %ul
              %li
                %p
                  the morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \delta_k
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} k \geq 2
                  are
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                  of
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                  (
                  %a.existingWikiWord{:href => "/nlab/show/functors"}> functors
                  ) over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} C_0
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} C_1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi δ
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msub
                          %mi C
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} im(\delta_2) \subset C_1
                  acts by
                  %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} C_2
                  and
                  %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivially
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi k
                      %annotation{:encoding => "application/x-tex"} C_k
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ≥
                          %mn 3
                        %annotation{:encoding => "application/x-tex"} k \geq 3
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %mo ∘
                        %msub
                          %mi δ
                          %mi k
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \delta_{k-1} \circ \delta_k = 0
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ≥
                          %mn 3
                        %annotation{:encoding => "application/x-tex"} k \geq 3
            %p
              There is an obvious notion of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f \colon C \to D
              of crossed complexes, being sequences of maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi C
                      %mi k
                    %mo →
                    %msub
                      %mi D
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_k \colon C_k \to D_k)
              preserving all the above structure. The resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              is often denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Crs
                  %annotation{:encoding => "application/x-tex"} Crs
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CrsCpx
                    %annotation{:encoding => "application/x-tex"} CrsCpx
            %p
          %h3#from_strict_groupoids
            From strict
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            While the above definition of a crossed complex may seem slightly “baroque”, it can naturally be understood as being precisely the data obtained from a
            %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular
            %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoid"} strict ∞-groupoid
            by retaining for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k \geq 2
            precisely only those
            %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
            whose
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            is a an
            %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k-1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
          .num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (crossed complex associated to a strict
                = succeed "-groupoid)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              a
              %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoid"} strict ∞-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %munder
                        %mo →
                        %mi s
                      %mover
                        %mo →
                        %mi t
                    %msub
                      %mi 𝒢
                      %mn 3
                    %mover
                      %munder
                        %mo →
                        %mi s
                      %mover
                        %mo →
                        %mi t
                    %msub
                      %mi 𝒢
                      %mn 2
                    %mover
                      %munder
                        %mo →
                        %mi s
                      %mover
                        %mo →
                        %mi t
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mover
                      %munder
                        %mo →
                        %mi s
                      %mover
                        %mo →
                        %mi t
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\stackrel{\overset{t}{\to}}{\underset{s}{\to}}
                    \\mathcal{G}_3
                    \\stackrel{\overset{t}{\to}}{\underset{s}{\to}}
                    \\mathcal{G}_2
                    \\stackrel{\overset{t}{\to}}{\underset{s}{\to}}
                    \\mathcal{G}_1
                    \\stackrel{\overset{t}{\to}}{\underset{s}{\to}}
                    \\mathcal{G}_0
            %p
              the corresponding crossed complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒢
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{G}]
              is defined as follows:
            %ul
              %li
                %p
                  the groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mn 1
                        %mover
                          %mo →
                          %mo →
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} [\mathcal{G}]_1 \stackrel{\to}{\to} [\mathcal{G}]_0
                  is just the groupoid
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 1
                          %mover
                            %mo →
                            %mo →
                          %msub
                            %mi 𝒢
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \stackrel{\to}{\to} \mathcal{G}_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  by forgetting all
                  %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphisms
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} k \geq 2
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} k \geq 2
                  the bundle of groups
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi k
                      %annotation{:encoding => "application/x-tex"} [\mathcal{G}]_k
                  is over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi 𝒢
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} x \in \mathcal{G}_0
                  the group of
                  %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphisms
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  whose source is the the identity on
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi k
                        %mo :
                        %mo =
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi x
                        %msubsup
                          %mi s
                          %mi k
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Id
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        [\mathcal{G}]_k := \coprod_x s_k^{-1}(Id_x)
                        \\,,
                %p
                  where the group operation is given by the horizontal composition of
                  %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphisms
                  (along objects). By the
                  %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
                  this is indeed an
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                  structure for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ≥
                          %mn 3
                        %annotation{:encoding => "application/x-tex"} k \geq 3
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} [\mathcal{G}]_1
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi k
                      %annotation{:encoding => "application/x-tex"} [\mathcal{G}]_k
                  is given by
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
                  %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
                  of
                  %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphisms
                  by 1-morphisms in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %li
                %p
                  The boundary maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mo ≔
                        %mi t
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi k
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \delta \coloneqq t \colon [\mathcal{G}]_{k} \to [\mathcal{G}]_{k-1}
                  are the restrictions of the target maps
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo{:lspace => "verythinmathspace"} :
                          %msub
                            %mi 𝒢
                            %mi k
                          %mo →
                          %msub
                            %mi 𝒢
                            %mrow
                              %mi k
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} t \colon \mathcal{G}_k \to \mathcal{G}_{k-1}
                  = succeed "-morphisms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed "-morphism." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} k-1
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Str
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Str \infty Grpd
            for the 1-
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoids"} strict ∞-groupoids
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi Str
                  %mn ∞
                  %mi Grpd
                  %mo →
                  %mi CrsCplx
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [-] : Str \infty Grpd \to CrsCplx
                  \\,.
          .un_prop
            %h6#proposition Proposition
            %p The functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Str
                    %mn ∞
                    %mi Grpd
                    %mo →
                    %mi CrsCplx
                  %annotation{:encoding => "application/x-tex"}
                    [-] : Str \infty Grpd \to CrsCplx
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          .proof
            %h6#proof Proof
            %p
              The idea of the proof is that a
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoid"} strict ∞-groupoid
              may completely be reconstructed from its objects, 1-morphisms and those
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo ≥
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k \geq 2)
            %p
              For instance a
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ⇓
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                            %msub
                              %mo ↗
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; \nearrow  \searrow^{\mathrlap{f}}
                    \\\
                    x &amp;\Downarrow&amp; y
                    \\\
                    \&amp; \searrow \nearrow_{\mathllap{g}}
                    }
            %p
              is, by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exchange+law"} exchange law
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ⇓
                          %mtd
                            %mi y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi f
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                            %msub
                              %mo ↗
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; \nearrow  \searrow^{\mathrlap{f}}
                    \\\
                    x &amp;\Downarrow&amp; y &amp; \stackrel{f^{-1}}{\to} &amp; x
                    \\\
                    \&amp; \searrow \nearrow_{\mathllap{g}}
                    }
            %p
              (whose source is the identity on
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p A detailed proof is in
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Ronnie+Brown"}> Ronnie Brown
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Philip+Higgins"} Philip Higgins
                %em
                  The equivalence of
                  = succeed "-groupoids" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                , Cah. Top. Géom. Diff. 22, 371-386, 1981. (
                %a{:href => "http://www.bangor.ac.uk/~mas010/pdffiles/x-comp.pdf"}> pdf
                )
            %p
              Notice that this article says “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoid” for
              %em
                strict globular
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              and “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              \-groupoid” for
              %em
                strict cubical
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              \.
          %p
            This is a nonabelian and globular version of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
          %h3#from_chain_complexes_of_modules From chain complexes of modules
          %p
            We describe a functorial construction of a crossed complex starting with a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            %a.existingWikiWord{:href => "/nlab/show/modules+over+a+groupoid"} modules over a groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A_n, \mathcal{H})
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complexes
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian groups
            into the category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complexes
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoid"} strict ∞-groupoids
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Nonabelian+Algebraic+Topology"} Nonabelian Algebraic Topology
          %p
            Recall the definition of the
            %a{:href => "#AdjointModule"} semidirect product groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                    %mo ⋉
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{H} \ltimes A_n
          .un_def
            %h6#definition_3 Definition
            %p
              %strong (crossed complex from a chain complex)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of
              %a.existingWikiWord{:href => "/nlab/show/modules+over+a+groupoid"} modules over a groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                    %mi A
                    %mo ∈
                    %mi Crs
                  %annotation{:encoding => "application/x-tex"} \Theta A \in Crs
              be the
              %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                    %mi A
                    %mo ≔
                    %msup
                      %mi κ
                      %mo *
                    %mi Θ
                    %mo ′
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta A \coloneqq \kappa^* \Theta' A
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                    %mo ′
                    %mi A
                    %mo ≔
                    %mrow
                      %mo [
                      %msub
                        %mi A
                        %mi n
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ∂
                            %mi n
                      %msub
                        %mi A
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mover
                        %mo →
                        %mrow
                      %mi ⋯
                      %mover
                        %mo →
                        %mrow
                      %msub
                        %mi A
                        %mn 3
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ∂
                            %mn 3
                      %msub
                        %mi A
                        %mn 2
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %msub
                            %mo ∂
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mi ℋ
                      %mo ⋉
                      %msub
                        %mi A
                        %mn 1
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta' A \coloneqq
                    \\left[
                    A_n
                    \\stackrel{\partial_n}{\to}
                    A_{n-1}
                    \\stackrel{}{\to}
                    \\cdots
                    \\stackrel{}{\to}
                    A_{3}
                    \\stackrel{\partial_3}{\to}
                    A_2
                    \\stackrel{(0,\partial_2)}{\to}
                    \\mathcal{H}\ltimes A_1
                    \\right]
            %p and where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ,
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℋ
                    %mo ⋉
                    %msub
                      %mi A
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\kappa \colon P(A_0, \mathcal{H}) \to \mathcal{H} \ltimes A_0
            %p
              is the
              %a{:href => "#AdjointModule"} canonical covering morphism
              from above.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Θ
                            %mi A
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 3
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Θ
                            %mi A
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Θ
                            %mi A
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mn 0
                            %mo ,
                            %mi ℋ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ⋯
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mn 3
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mo ∂
                                  %mn 3
                          %mtd
                            %msub
                              %mi A
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo ,
                                %msub
                                  %mo ∂
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ℋ
                            %mo ⋉
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo ,
                                %msub
                                  %mo ∂
                                  %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ℋ
                            %mo ⋉
                            %msub
                              %mi A
                              %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots \to &amp;
                    (\Theta A)_3
                    \&amp;\to&amp;
                    (\Theta A)_2
                    \&amp;\to&amp;
                    (\Theta A)_1
                    \&amp;\to&amp;
                    P(A_0, \mathcal{H})
                    \\\
                    \&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\cdots \to &amp;
                    A_3
                    \&amp;\stackrel{\partial_3}{\to}&amp;
                    A_2
                    \&amp;\stackrel{(0,\partial_2)}{\to}&amp;
                    \\mathcal{H} \ltimes A_1
                    \&amp;\stackrel{(1, \partial_1)}{\to}&amp;
                    \\mathcal{H} \ltimes A_0
                    }
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                    %mo ⋉
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{H} \ltimes A_1
              acts on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A_n
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              via the projection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                      %mo ⋉
                      %msub
                        %mi A
                        %mn 1
                      %mo →
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H} \ltimes A_1 \to \mathcal{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
              acts trivially. (…)
            %p
              Finally set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                      %mo ≔
                      %msub
                        %mi A
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \Theta(A)_0 \coloneqq A_0
          %p We spell out what this boils down to explicitly.
          %p
            %strong Explicit description
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                %annotation{:encoding => "application/x-tex"} A_\bullet
            be a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            %a.existingWikiWord{:href => "/nlab/show/modules+over+a+groupoid"} modules over the groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
            %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Θ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Theta(A)
            is the following.
          %ul
            %li
              %p
                Its set of objects is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Θ
                        %mo{:stretchy => "false"} (
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 0
                        %mo =
                        %msub
                          %mi A
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \Theta(A)_0 = A_0
              %p
                Remember that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} A_0
                itself is a module over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} matcal
                        %mi H
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℋ
                          %mn 1
                        %mover
                          %mo →
                          %mo →
                        %msub
                          %mi ℋ
                          %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \matcal{H} = (\mathcal{H}_1 \stackrel{\to}{\to} \mathcal{H}_0)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 0
                        %mo =
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} corpdod
                          %mrow
                            %mi p
                            %mo ∈
                            %msub
                              %mi ℋ
                              %mn 0
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 0
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi p
                      %annotation{:encoding => "application/x-tex"} A_0 = \corpdod_{p \in \mathcal{H}_0} (A_0)_p
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi p
                    %annotation{:encoding => "application/x-tex"} x \in (A_0)_p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi q
                    %annotation{:encoding => "application/x-tex"} y \in (A_0)_q
                a morphism in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Theta(A)_1
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                is labeled by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %msub
                        %mi ℋ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} h \in \mathcal{H}_1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi q
