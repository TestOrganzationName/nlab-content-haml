                    %mo ⊣
                    %mi Θ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Chn
                    %mover
                      %munder
                        %mo →
                        %mi Θ
                      %mover
                        %mo ←
                        %mo ∇
                    %mi Crs
                  %annotation{:encoding => "application/x-tex"}
                    (\nabla \dashv \Theta)
                    \\colon
                    Chn
                    \\stackrel{\overset{\nabla}{\leftarrow}}{\underset{\Theta}{\to}}
                    Crs
            %p where…
          %p This is proposition 7.4.29.
          %p (…)
          %h2#examples Examples
          %h3#in_low_degree In low degree
          %p
            Say that a crossed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi k
                %annotation{:encoding => "application/x-tex"} C_k
            is trivial for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &gt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k \gt k
          %p Then
          %ul
            %li
              %p
                0-
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                crossed complexes are canonically equivalent to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/set"} sets
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy 0-types
            %li
              %p
                1-
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                crossed complexes are canonically equivalently to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoids
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy 1-types
            %li
              %p
                2-
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                crossed complexes are equivalent to strict
                %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoids
                equivalent to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy 2-types
              %p
                2-
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                and 0-
                %a.existingWikiWord{:href => "/nlab/show/connected"} connected
                crossed complex, i.e. a 2-truncated one for which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 0
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} C_0 = *
                is the point is the same as a
                %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
                of groups. The equivalence of these to
                %a.existingWikiWord{:href => "/nlab/show/strict+2-group"} strict 2-groups
                is due to
              %p
                R. Brown and C.B. Spencer,
                = succeed "," do
                  %em G-groupoids, crossed modules and the fundamental groupoid of a topological group
          %p
            A discussion of the kind of homotopy types generally modelled by crossed complexes, namely a
            %em linear
            model is in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy n-type
          %h3#abelian_chain_complexes Abelian chain complexes
          %p
            The notion of crossed complex generalizes the notion of
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} k \geq 3
            a crossed complex with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} C_0 = *
            %em is
            a chain complex of abelian groups. To regard the first 2 degrees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                  %mover
                    %mo →
                    %mi δ
                  %msub
                    %mi A
                    %mn 0
                %annotation{:encoding => "application/x-tex"} A_1 \stackrel{\delta}{\to} A_0
            of a chain complex of abelian groups as a crossed module, form the groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 0
                  %mo ×
                  %msub
                    %mi A
                    %mn 1
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo +
                        %mi δ
                  %msub
                    %mi A
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  A_0 \times A_1 \stackrel{\overset{p_1 + \delta}{\to}}{\underset{p_1}{\to}}
                  A_0
          %p
            and take the action of this groupoid on all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi k
                %annotation{:encoding => "application/x-tex"} C_k
            to be trivial. This yields a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ChainCplx
                  %mo{:stretchy => "false"} (
                  %mi Ab
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi CrsCpl
                %annotation{:encoding => "application/x-tex"}
                  \\theta \colon ChainCplx(Ab) \to CrsCpl
          %p that embeds chain complexes of abelian groups into crossed complexes.
          %h3#complex_of_modules_over_a_groupoid Complex of modules over a groupoid
          %p
            The embedding of chain complexes of abelian groups into crossed complexes generalizes to an embedding of chain complexs of
            %a.existingWikiWord{:href => "/nlab/show/modules+over+a+groupoid"} modules over a groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ChainCplx
                  %mo{:stretchy => "false"} (
                  %mi GrpdMod
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi CrsCplx
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\theta \colon ChainCplx(GrpdMod) \to CrsCplx
                  \\,.
          %p
            For details see
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Nonabelian+Algebraic+Topology"} Nonabelian Algebraic Topology
            = succeed "." do
              %a{:href => "Nonabelian+Algebraic+Topology#CrsFromCh"} section 7.4.v
          %h3#fundamental_crossed_complex Fundamental crossed complex
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} X_*
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/filtered+space"} filtered space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %msub
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Pi X_*
            – the
            %a{:href => "Nonabelian+Algebraic+Topology#FundamentalCrossedComplex"} fundamental crossed complex
            which corresponds to a (filtered and)
            %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoid"} strict ∞-groupoid
            version of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(X_1,X_0)
            of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(X_1)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X_1
            on objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \gt 1
            it is the family of
            %span.newWikiWord
              relative homotopy groups
              %a{:href => "/nlab/new/relative+homotopy+group"} ?
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi p
                    %mo ∈
                    %msub
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\pi_n(X_n,X_{n-1},p) : p\in X_0\}
          %p
            This gives a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            from filtered spaces to crossed complexes, which may be used to construct the generalisation of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+T-complex"} simplicial T-complexes
          %h3#fundamental_crossed_complex_of_the_simplex
            Fundamental crossed complex of the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            An important special case of the above is when the filtered space is a
            %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            and the filtration is by skeleta. Particularly useful instances of this are the
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-simplices," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi I
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(I^n)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(\Delta^n)
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerves
            of a crossed complex and these in turn define the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            mentioned above. For instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a crossed complex, then its simplicial nerve is the simplicial set with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ner
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo =
                  %mi Crs
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Ner(C)_n =
                  Crs(\Pi(\Delta^n),C)
            in dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .un_example
            %h6#example_2 Example
            %p
              %strong
                (fundamental crossed complex of the
                = succeed "-simplex)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %p
              The topological
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              is canonically a
              %a.existingWikiWord{:href => "/nlab/show/filtered+space"} filtered space
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (\Delta^n)_k
              being the union of its
              = succeed "-faces." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Then we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1((\Delta^n)_1, (\Delta^n)_0)
              is the groupoid whose objects are the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              vertices of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              and which has precisely one morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                    %mo →
                    %msub
                      %mi x
                      %mi j
                  %annotation{:encoding => "application/x-tex"} x_i \to x_j
              for each ordered pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi j
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_i,x_j \in (\Delta^n)_0
              (all of them being
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi x
                                %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                              %mo ↖
                          %mtr
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mo ←
                            %mtd
                            %mtd
                              %msub
                                %mi x
                                %mn 2
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_1((\Delta^2)_1,(\Delta^2)_0) =
                    \\left\{
                    \\array{
                    \&amp;&amp; x_1
                    \\\
                    \&amp; \nearrow\swarrow &amp;&amp; \searrow \nwarrow
                    \\\
                    x_0 &amp;&amp;\stackrel{\leftarrow}{\to}&amp;&amp; x_2
                    }
                    \\right\}
                    \\,.
            %p
              At any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              the relative homotopy group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_2((\Delta^n)_2,(\Delta^n)_1, x_i)
              is a group on the set of 2-faces that have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              as a 0-face: there is a unique homotopy class of disks in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              that sits in the 2-faces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} (\Delta^n)_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi j
                  %annotation{:encoding => "application/x-tex"} x_j
              and whose boundary runs along the boundary of a given 2-face of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta^n
            %p
              So (using the equivalence of crossed complexes with strict
              = succeed "-groupoids)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %msup
                      %mi Δ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Pi \Delta^2
              is generated from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1((\Delta^2)_1,(\Delta^2)_0)
              as above and a 2-cell
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi x
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo ⇓
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mn 0
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msub
                              %mi x
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; x_1
                    \\\
                    \&amp; \swarrow &amp;\Downarrow&amp; \nwarrow
                    \\\
                    x_0 &amp;&amp;\to&amp;&amp; x_2
                    }
            %p
              under whiskering and composition. For instance whiskering this with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo →
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_1 \to x_2
              yields the 2-morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi x
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mn 0
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msub
                              %mi x
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; x_1
                    \\\
                    \&amp; \swarrow &amp;\swArrow&amp; \searrow
                    \\\
                    x_0 &amp;&amp;\to&amp;&amp; x_2
                    }
                    \\,.
            %p
              One sees that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %msup
                      %mi Δ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Pi \Delta^2
              is the strict groupoidification of the second
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
            %p
              Generally,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Pi \Delta^n
              is the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta^n
          %h2#crossed_complexes_as_moore_complexes Crossed complexes as Moore complexes
          %p
            Crossed complexes (of groups) correspond to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group+T-complex"} group T-complexes
            = succeed "-complex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-complex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒩
                  %mi G
                  %mo ∩
                  %mi D
                %annotation{:encoding => "application/x-tex"} \mathcal{N}G\cap D
            is the trivial graded subgroup, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                %annotation{:encoding => "application/x-tex"} D = (D_n)_{n\geq 1}
            is the graded subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            generated by the degenerate elements. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is such a group
            = succeed "-complex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
            has a natural structure of a crossed complex. In general the obstruction to a given simplicial group to have Moore complex which is a crossed complex is exactly that graded subgroup,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒩
                    %mi G
                    %mo ∩
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \mathcal{N}G\cap D
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead products
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            live in this graded subgroup, so this provides one way of showing that the homotopy types representable by crossed complexes have trivial Whitehead products.)
          %p
            Conversely, for any crossed complex,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(C)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            = succeed "-complex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p The generalisation to general crossed complexes (of groupoids) and simplicially enriched groupoids is quite easy to do. We will usually state results below for the group case, leaving the general case to the reader.
          %h2#from_simplicial_groupoids_to_crossed_complexes From simplicial group(oid)s to crossed complexes
          %p
            It is fairly clear that crossed complexes / group(oid)
            = succeed "-complexes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "(oid)s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            in the category,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SSet
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} SSet Grpd
            %a.existingWikiWord{:href => "/nlab/show/group+T-complex"} group T-complex
            is relevant here.)
          %p
            There is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(-)
            from simplicial groups to crossed complexes given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi G
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo =
                  %mfrac
                    %mrow
                      %mi 𝒩
                      %msub
                        %mi G
                        %mi n
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒩
                      %msub
                        %mi G
                        %mi n
                      %mo ∩
                      %msub
                        %mi D
                        %mi n
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi 𝒩
                      %msub
                        %mi G
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ∩
                      %msub
                        %mi D
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} {C}(G)_{n+1} = \frac{\mathcal{N}G_n}{(\mathcal{N}G_n\cap D_n)d_0(\mathcal{N}G_{n+1}\cap D_{n+1})},
          %p in higher dimensions with at its ‘bottom end’, the crossed module,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi 𝒩
                      %msub
                        %mi G
                        %mn 1
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi 𝒩
                      %msub
                        %mi G
                        %mn 2
                      %mo ∩
                      %msub
                        %mi D
                        %mn 2
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒩
                  %msub
                    %mi G
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \frac{\mathcal{N}G_1}{d_0(\mathcal{N}G_2\cap D_2)} \to \mathcal{N}G_0
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                %annotation{:encoding => "application/x-tex"} \partial
            induced from the boundary in the Moore complex.
          %p
            The category of
            %a.existingWikiWord{:href => "/nlab/show/crossed+complexes"} crossed complexes
            form a variety in the category of all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hypercrossed+complexes"} hypercrossed complexes
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/group+T-complex"} group T-complex
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/group"} group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-group"}> 2-group
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
                %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/3-group"}> 3-group
                ,
                %a.existingWikiWord{:href => "/nlab/show/2-crossed+module"} 2-crossed module
                \/
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/crossed+square"} crossed square
                %a.existingWikiWord{:href => "/nlab/show/differential+2-crossed+module"} differential 2-crossed module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/n-group"} n-group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"}> ∞-group
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                = succeed "," do
                  %strong crossed complex
                %a.existingWikiWord{:href => "/nlab/show/hypercrossed+complex"} hypercrossed complex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+crossed+complexes"} model structure on crossed complexes
          %h2#references References
          %p
            Crossed complexes were defined by Blakers in 1948 (following a suggestion of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} Samuel Eilenberg
            %a.existingWikiWord{:href => "/nlab/show/Johannes+Huebschmann"} Johannes Huebschmann
            to
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            in 1980. They were further developed in series of articles by Ronnie Brown and collaborators in the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+algebraic+topology"} nonabelian algebraic topology
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "." do
              %em connections
          %p Monographs:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ronnie+Brown"}> Ronnie Brown
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Philip+Higgins"} Philip Higgins
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rafael+Sivera"} Rafael Sivera
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Nonabelian+Algebraic+Topology"} Nonabelian Algebraic Topology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim Porter
                ,
                %em
                  %a.existingWikiWord{:href => "/timporter/show/crossed+menagerie"} Crossed Menagerie
                \.
          %p Survey:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ronnie+Brown"}> Ronnie Brown
                ,
                = succeed "," do
                  %em Crossed complexes and homotopy groupoids as non commutative tools for higher dimensional local-to-global problems
                = succeed ")." do
                  %a{:href => "http://arxiv.org/abs/math.AT/0212274"} arxiv:math.AT/0212274 v7
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Tonks"}> Andrew Tonks
                \:
                = succeed "," do
                  %em Theory and Applications of Crossed Complexes
                = succeed "," do
                  %a{:href => "https://groupoids.org.uk/pdffiles/tonksthesis.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Tonks-CrossedComplexes.pdf", :title => "pdf"} pdf
          %p
            The equivalence of
            %a.existingWikiWord{:href => "/nlab/show/strict+omega-groupoid"} strict omega-groupoids
            and crossed complexes is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ronnie+Brown"}> Ronnie Brown
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Philip+Higgins"} Philip Higgins
              %em
                The equivalence of
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              , Cah. Top. Géom. Diff. 22, 371-386, 1981. (
              %a{:href => "http://www.bangor.ac.uk/~mas010/pdffiles/x-comp.pdf"}> pdf
              )
          %p
            Notice that this article says “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-groupoid” for
            %em
              strict globular
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            and “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            \-groupoid” for
            = succeed "." do
              %em
                strict cubical
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p
            For the relation to
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Johannes+Huebschmann"}> Johannes Huebschmann
              ,
              %em
                Crossed
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              (
              %a{:href => "http://dx.doi.org/10.1007/BF02566688"}> web
              )
