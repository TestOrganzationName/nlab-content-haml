                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            of its orbits.
          %h3#category_of_orbits Category of orbits
          %p
            The
            %em category of orbits
            of a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is the full subcategory of the category of sets with an action of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Since any orbit of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is isomorphic to the orbit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            for some group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-orbits" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 1
                  %mo →
                  %msub
                    %mi H
                    %mn 2
                %annotation{:encoding => "application/x-tex"} H_1\to H_2
            are elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi g
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi G
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi H
                    %mn 2
                %annotation{:encoding => "application/x-tex"} [g]\in G/H_2
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 1
                    %mo ⊂
                    %mi g
                    %msub
                      %mi H
                      %mn 2
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} H_1\subset g H_2g^{-1}
          %p
            In particular, the group of automorphisms of a
            = succeed "-orbit" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} N_G(H)/H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N_G(H)
            is the
            %a.existingWikiWord{:href => "/nlab/show/normalizer"} normalizer
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h3#topological_case Topological case
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            and the action
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
            %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
            orbits from those which are not. Even when one starts with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ,
                  %mi X
                %annotation{:encoding => "application/x-tex"} G,X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            of Connes’ school.)
          %p
            If the original space is
            %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
            Hausdorff, then every orbit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi x
                %annotation{:encoding => "application/x-tex"} G x
            as a topological
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is the
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %h2#examples Examples
          %ul
            %li
              An orbit of a
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of a
              %a.existingWikiWord{:href => "/nlab/show/permutation+group"} permutation group
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/permutation+cycle"} permutation cycle
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbit-stabilizer+theorem"} orbit-stabilizer theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbit+category"}> orbit category
                ,
                %a.existingWikiWord{:href => "/nlab/show/orbit+type"} orbit type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/coinvariant"} coinvariant
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbit+method"} orbit method
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/slice+theorem"} slice theorem
          %h2#references References
          %p Textbook accounts:
          %ul
            %li#Bredon72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
