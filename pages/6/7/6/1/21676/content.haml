          %h2#idea Idea
          %p
            The
            %em PL de Rham theorem
            is the variant of the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            with the smooth
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            replaced by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+complex"} PL de Rham complex
          %h2#statement Statement
          #PLdeRhamTheorem.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+theorem"}> PL de Rham theorem
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              of
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              (such as the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              or
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %p
              Then the evident operation of
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
              induces a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+complex"} PL de Rham complex
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              and
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
              for
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi PLdR
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                      %mo ≃
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{PLdR}(X)
                    \\underoverset{}{\simeq}{\longrightarrow}
                    C^\bullet(X; k)
            %p
              and hence an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              from
              %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+cohomology"} PL de Rham cohomology
              to
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              (such as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+cohomology"} real cohomology
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/complex+cohomology"} complex cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi PLdR
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                      %mo ≃
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet_{PLdR}(X)
                    \\underoverset{}{\simeq}{\longrightarrow}
                    H^\bullet(X; k)
            %p
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          %p
            (
            %a{:href => "#BousfieldGugenheim76"}> Bousfield-Gugenheim 76, Theorem 2.2
            )
          %h2#lemmas Lemmas
          %p
            Besides the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+lemma"} Poincaré lemma
            for piecewise polynomial forms, the proof uses:
          %p
          #ExtensionLemma.num_lemma
            %h6 Lemma
            %p
              %strong (extension lemma)
              Given a PL form on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary of a simplex
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} restriction of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-simplex"} n-simplex
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#GriffithsMorgan13"} Griffiths &amp; Morgan 2013, Lemma 9.6
          %p
          .proof
            %h6 Proof
            %p
              Consider
              %a{:href => "simplex#BarycentricCoordinates"} barycentric coordinates
              for the given
              %a.existingWikiWord{:href => "/nlab/show/n-simplex"} n-simplex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo {
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msup
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi k
                        %msup
                          %mi x
                          %mi k
                        %mo =
                        %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %msub
                          %mo ∀
                          %mi i
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi x
                          %mi i
                        %mo ≥
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^n
                    \\,\equiv\,
                    \\left\{
                    \\,
                    (x^0, \cdots, x^n)
                    \\,\in\,
                    \\mathbb{R}^{n+1}
                    \\;\Big\vert\;
                    \\textstyle{\sum}_k x^k = 1
                    \\,,
                    \\forall_i \, x^i \geq 0
                    \\,
                    \\right\}
            %p
              such that the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo ∈
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_i \in \Delta^n
              with coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi δ
                      %mi i
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    x^n(v_i)
                    \\;=\;
                    \\delta^n_i
            %p
              and the
              = succeed "th-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msup
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi Δ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi x
                      %mi i
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_i\big(\Delta^n\big)
                    \\;=\;
                    \\big\{
                    \\,
                    (x^0, \cdots, x^n)
                    \\,\in\,
                    \\Delta^n
                    \\;\big\vert\;
                    x^i = 0
                    \\,
                    \\big\}
                    \\,.
            %p With these coordinate expressions consider the functions
            #eq:ProjectionFunctions.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %msub
                                %mi p
                                %mi i
                              %mspace{:width => "thickmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                              %mspace{:width => "thickmathspace"}
                          %msup
                            %mi Δ
                            %mi n
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi v
                            %mi i
                          %mo{:stretchy => "false"} }
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mi σ
                            %mi i
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi x
                            %mi k
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi k
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mrow
                              %mo (
                              %mfrac
                                %mrow
                                  %msup
                                    %mi x
                                    %mi k
                                %mrow
                                  %mn 1
                                  %mo −
                                  %msup
                                    %mi x
                                    %mi i
                              %mo )
                            %mrow
                              %mi k
                              %mo ≠
                              %mi i
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcl}
                    \\mathllap{
                    p_i
                    \\;\colon\;
                    }
                    \\Delta^n
                    \\setminus
                    \\{v_i\}
                    \&amp;\longrightarrow&amp;
                    \\sigma_i(\Delta^{n})
                    \\\
                    (x^k)_{k}
                    \&amp;\mapsto&amp;
                    \\left(
                    \\frac{x^k}{1-x^i}
                    \\right)_{k \neq i}
                    \\,.
                    \\end{array}
            %p
              Observe that given a polynomial form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sigma_i(\Delta^n)
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              is a form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Delta^n \setminus \{v_i\}
              which is polynomial in the variables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi x
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ≠
                        %mi i
                  %annotation{:encoding => "application/x-tex"} \{x^k\}_{k \neq i}
              and in the variable
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %msup
                        %mi x
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1/(1-x^i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N_i \in \mathbb{N}
              such that
            #eq:PartialExtension.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi α
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi N
                          %mi i
                    %mo ⋅
                    %msubsup
                      %mi p
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat \alpha
                    \\;\coloneqq\;
                    (1 - x^i)^{N_i}
                    \\cdot
                    p_i^\ast(\alpha)
            %p
              is a differential form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Delta^n \setminus \{v_i\}
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi α
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat \alpha
                  extends to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                      %annotation{:encoding => "application/x-tex"} v_i
                  (by zero) to give a polynomial differential form on all of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Δ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \Delta^n
              %li
                %p
                  pulled back to the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi α
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat \alpha
                  coincides with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                  (there being the pullback of an identity map);
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                  vanishes on the
                  = succeed "-face" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \sigma(\Delta^n)
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi α
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{\alpha}
                  vanishes on the
                  = succeed "-face" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \Delta^n
                  (there being a pullback of the former).
            %p
              Now to complete the proof, consider a polynomial differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              on the
              %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \partial \Delta^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ω
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat \omega
              to all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta_n
            %p
              First consider the above construction
              %a.maruku-eqref{:href => "#eq:PartialExtension"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ω
                        %mo ^
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mrow
                        %mi ω
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi σ
                              %mn 0
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat \omega_0
                    \\;\coloneqq\;
                    \\widehat {\omega \vert_{\sigma_0} }
            %p
              on the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma_0(\Delta^n)
              and notice that the difference
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ω
                    %mo −
                    %msub
                      %mover
                        %mi ω
                        %mo ^
                      %mn 0
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo ∂
                        %msup
                          %mi Δ
                          %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\omega_1
                    \\;\coloneqq\;
                    \\omega
                    \-
                    \\widehat{\omega}_0 \vert_{\partial \Delta^n}
            %p
              vanishes on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma_0
              and coincides with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              on all other faces. Therefore consider next the above construction
              %a.maruku-eqref{:href => "#eq:PartialExtension"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ω
                        %mo ^
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mrow
                        %msub
                          %mi ω
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi σ
                              %mn 1
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat \omega_2
                    \\;\coloneqq\;
                    \\widehat{ \omega_1 \vert_{\sigma_1} }
            %p
              on this difference restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_1
              and notice that the difference
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ω
                      %mn 1
                    %mo −
                    %msub
                      %mover
                        %mi ω
                        %mo ^
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo ∂
                        %msup
                          %mi Δ
                          %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\omega_2
                    \\;\coloneqq\;
                    \\omega_1
                    \-
                    \\widehat{\omega}_1 \vert_{\partial \Delta^n}
            %p
              vanishes on the union of faces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 0
                    %mo ∪
                    %msub
                      %mi σ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_0 \cup \sigma_1
              and coincides with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              on all remaining faces. Proceeding in this fashion one arrives at
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mstyle{:displaystyle => "false"}
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi k
                          %msub
                            %mover
                              %mi ω
                              %mo ^
                            %mi k
                        %mo ⏟
                      %mover
                        %mi ω
                        %mo ^
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                      %mrow
                        %mo ∂
                        %msup
                          %mi Δ
                          %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \\;=\;
                    \\underset{
                    \\widehat{\omega}
                    }{
                    \\underbrace{
                    \\textstyle{\sum}_k
                    \\widehat{\omega}_k
                    }
                    }
                    \\,
                    \\Big\vert_{\partial \Delta^n}
            %p and hence the term over the brace is an extension as required.
          %p
          #ExtensionLemmaForPiecewiseSmoothForms.num_remark
            %h6 Remark
            %p
              %strong (extension lemma for piecewise smooth differential forms)
              The Extension Lemma
              %a.maruku-ref{:href => "#ExtensionLemma"}
              holds also for other flavors of differential forms over simplices:
            %p
              In (the proof of)
              %a{:href => "#GriffithsMorgan13"} Griffiths &amp; Morgan 2013, Cor. 9.9
              this is observed for the case of smooth differential forms: Here the proof of Lemma
              %a.maruku-ref{:href => "#ExtensionLemma"}
              applies verbatim, except that the multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi N
                          %mi i
                  %annotation{:encoding => "application/x-tex"} (1-x^i)^{N_i}
              in
              %a.maruku-eqref{:href => "#eq:PartialExtension"} (2)
              needs to be replaced by multiplication with any
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              which vanishes in a neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi i
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} x^i = 1
              and is unity for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mi i
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x^i = 0
            %p
              Moreover, we may observe that this same argument then also applies to differential forms on “extended simplices” (see
              = succeed ")" do
                %a{:href => "shape+via+cohesive+path+∞-groupoid#SmoothExtendedSimplices"} this Def.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi ext
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo {
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msup
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi k
                        %msup
                          %mi x
                          %mi k
                        %mo =
                        %mn 1
                        %mspace{:width => "thinmathspace"}
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^n_{ext}
                    \\,\equiv\,
                    \\left\{
                    \\,
                    (x^0, \cdots, x^n)
                    \\,\in\,
                    \\mathbb{R}^{n+1}
                    \\;\Big\vert\;
                    \\textstyle{\sum}_k x^k = 1
                    \\,
                    \\right\}
                    \\,,
            %p
              where the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∀
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi x
                      %mi i
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \forall_i \, x^i \geq 0
              is dropped (which plays no role in the above proof).
            %p
              This is noteworthy, because it implies, with the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/shape+via+cohesive+path+%E2%88%9E-groupoid"} shape via cohesive path ∞-groupoid
              and using the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+dg-algebraic+rational+homotopy+theory"} fundamental theorem of dg-algebraic rational homotopy theory
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+L-infinity+algebra"}
                Whitehead
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ;
                    %mi 𝔞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi flat
                  %annotation{:encoding => "application/x-tex"}
                    \\esh
                    \\,
                    \\Omega^1_{dR}(-;\mathfrak{a})_{flat}
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/flat+L-infinity+algebra+valued+differential+forms"}
                  flat
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔞
                        %annotation{:encoding => "application/x-tex"} \mathfrak{a}
