              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "215.24", "xlink:href" => "#wtZlSQ5dYHFoeUgXFu_rb0A95Eo=-glyph-6-2", :y => "170.044"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "222.017773", "xlink:href" => "#wtZlSQ5dYHFoeUgXFu_rb0A95Eo=-glyph-6-1", :y => "170.044"}
              %path{:d => "M -100.690062 -83.596625 L -100.690062 83.118219 ", :fill => "none", :stroke => "rgb(75%, 75%, 75%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 121.776, 92.544)"}
              %path{:d => "M -2.484675 2.86758 C -2.03155 1.14883 -1.019831 0.33633 -0.0003 0.0003925 C -1.019831 -0.335545 -2.03155 -1.148045 -2.484675 -2.870701 ", :fill => "none", :stroke => "rgb(75%, 75%, 75%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(0, -1, -1, 0, 21.08633, 9.1872)"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "8.528", "xlink:href" => "#wtZlSQ5dYHFoeUgXFu_rb0A95Eo=-glyph-6-3", :y => "23.986"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "14.124", "xlink:href" => "#wtZlSQ5dYHFoeUgXFu_rb0A95Eo=-glyph-7-1", :y => "21.174"}
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/codomains"} codomains
              of the
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              on all the following pages are translated diagonally (downwards and rightwards, by the
              = succeed ")" do
                %a{:href => "spectral+sequence#eq:FormOfDifferentialInCohomologySpectralSequence"} general formula
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              or the
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+group"} zero group
            %p
              This means that all differentials are the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{\bullet, \bullet}_\infty
                    \\;\;
                    \\simeq
                    \\;\;
                    E^{\bullet, \bullet}_2
                    \\,.
            %p
              Therefore the convergence statement
              %a.maruku-eqref{:href => "#eq:FilteringForOrdinaryCohomologySerreSpectralSequence"} (2)
              says that the degree-4 cohomology group in question is a
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 4
                    %mo ;
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    E^{0,4}_\infty
                    \\;\simeq\;
                    H^0\big(B G, \, H^4(S^4; \mathbb{Z}) \big)
                    \\;\simeq\;
                    H^0\big( B G, \, \mathbb{Z}\big)
                    \\;\simeq\;
                    \\mathbb{Z}
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mn 4
                        %mo ,
                        %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mn 4
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 4
                    %mo ;
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mn 4
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo |
                      %mi G
                      %mo |
                  %annotation{:encoding => "application/x-tex"}
                    E^{4,0}_\infty
                    \\;\simeq\;
                    H^4\big(B G, \, H^0(S^4; \mathbb{Z}) \big)
                    \\;\simeq\;
                    H^4\big( B G, \, \mathbb{Z}\big)
                    \\;\simeq\;
                    \\mathbb{Z}/\left\vert G \right\vert
            %p
              in that we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo |
                      %mi G
                      %mo |
                    %mo ↪
                    %msup
                      %mi H
                      %mn 4
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mn 4
                    %mspace{:width => "negativethinmathspace"}
                    %mo ⫽
                    %mspace{:width => "negativethinmathspace"}
                    %mi G
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ↠
                    %mi ℤ
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\mathbb{Z}/\left\vert G\right\vert
                    \\hookrightarrow
                    H^4\big( S^4 \!\sslash\! G;\, \mathbb{Z} \big)
                    \\twoheadrightarrow
                    \\mathbb{Z}
                    \\to
                    0
                    \\,.
            %p
              But since the
              %a.existingWikiWord{:href => "/nlab/show/Ext-group"} Ext-group
              of the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              is
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
              (
              %a{:href => "Ext#ExtensionsOfTheIntegersAreTrivial"}> this Expl.
              ) this extension must be the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mn 4
                    %mspace{:width => "negativethinmathspace"}
                    %mo ⫽
                    %mspace{:width => "negativethinmathspace"}
                    %mi G
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℤ
                      %mrow
                        %mo |
                        %mi G
                        %mo |
                    %mo ⊕
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^4\big( S^4 \!\sslash\! G;\, \mathbb{Z} \big)
                    \\;\simeq\;
                    \\mathbb{Z}_{\left\vert G\right\vert}
                    \\oplus
                    \\mathbb{Z}
                    \\,.
            %p
              This is the claim
              %a.maruku-eqref{:href => "#eq:Integral4CohomologyOfHomotopyQuotientOf4SphereByFiniteSubgroupOfSU2"} (3)
              to be proven.
          %h2#consequences Consequences
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Serre+long+exact+sequence"} Serre long exact sequence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thom-Gysin+sequence"} Thom-Gysin sequence
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+cohomology"} long exact sequence in cohomology
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+generalized+cohomology"} long exact sequence in generalized cohomology
          %h2#references References
          %h3#general General
          %p The original article is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"}> Jean-Pierre Serre
              ,
              %em Homologie singuliére des espaces fibrés
              Applications, Ann. of Math. 54 (1951),
          %p Textbook accounts:
          %ul
            %li#Hatcher
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alan+Hatcher"}> Alan Hatcher
                ,
                %em
                  %a{:href => "https://pi.math.cornell.edu/~hatcher/SSAT/SSATpage.html"} Spectral sequences in algebraic topology
                %em I: The Serre spectral sequence
                (
                %a{:href => "https://pi.math.cornell.edu/~hatcher/SSAT/SSch1.pdf"}> pdf
                ,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Hatcher_SerreSpectralSequence.pdf", :title => "pdf"} pdf
            %li#Kochman96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochman"}> Stanley Kochman
                , section 2.2. of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#Davis91
              %p
                Davis,
                = succeed "," do
                  %em Lecture notes in algebraic topology
          %p Lecture notes etc. includes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Greg+Friedman"}> Greg Friedman
              ,
              %em Some extremely brief notes on the Leray spectral sequence
              (
              %a{:href => "http://faculty.tcu.edu/richardson/Seminars/Gregspecseq.pdf"}> pdf
              )
          %p
            Discussion in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            includes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              = succeed "," do
                %em
                  %a{:href => "http://homotopytypetheory.org/2013/08/08/spectral-sequences/"} Spectral Sequences
          %p
            and implementation in
            %a.existingWikiWord{:href => "/nlab/show/Lean"} Lean
            is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Floris+van+Doorn"}> Floris van Doorn
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"} Egbert Rijke
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ulrik+Buchholtz"} Ulrik Buchholtz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Favonia"} Favonia
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Steve+Awodey"} Steve Awodey
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeremy+Avigad"} Jeremy Avigad
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jonas+Frey"} Jonas Frey
                %em Spectral
                (
                %a{:href => "https://github.com/cmu-phil/Spectral"}> github.com/cmu-phil/Spectral
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Floris+van+Doorn"}> Floris van Doorn
                , §5 in:
                %em On the Formalization of Higher Inductive Types and Synthetic Homotopy Theory
                (2018) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1808.10690"}> arXiv:1808.10690
                \&amp;rbrack;
          %h3#in_equivariant_cohomology_2 In equivariant cohomology
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Bredon+cohomology"} Bredon cohomology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
              , J.-A. Svensson,
              = succeed "," do
                %em The Equivariant Serre Spectral Sequence
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/2160037"} JSTOR
          %p
            and for genuine equivariant cohomology, i.e. for
            = succeed "-graded" do
              %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-grading"} RO(G)
            = succeed ":" do
              %a{:href => "Mackey+functor#Cohomology"} cohomology with coefficients in a Mackey functor
