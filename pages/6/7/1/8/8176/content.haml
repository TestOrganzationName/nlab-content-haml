                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F &amp;\longrightarrow&amp; E
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              over a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
