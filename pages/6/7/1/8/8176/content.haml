              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
