          %h2#motivation Motivation
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L X = C^\infty(S^1,X)
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space
          %p
            then
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            gives a map on
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo :
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\tau : H^k(X) \to H^{k-1}(L X)
          %p
            %strong Example
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            \-coefficients,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k = 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi ℤ
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi τ
                        %mtd
                          %msup
                            %mi H
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mi X
                          %mo ,
                          %msub
                            %mi ℤ
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ξ
                        %mtd
                          %mo ↦
                        %mtd
                          %mi τ
                          %mo{:stretchy => "false"} (
                          %mi ξ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  H^2(X, \mathbb{Z}_2) &amp;\stackrel{\tau}{\to}&amp; H^1(L X, \mathbb{Z}_2)
                  \\\
                  \\xi &amp;\mapsto&amp; \tau(\xi)
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            is the second
            %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+class"} Stiefel-Whitney class
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \xi = 0
            is the trivial class. This implies of course that also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau(\xi)
            vanishes. Atiyah showed that if the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \pi_1(X) = 1
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            vanishes, i.e. if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+space"} simply connected space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is spin if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau(\xi)
            vanishes in the cohomology of the loop space.
          %p
            %strong Questions
          %ol
            %li
              %p
                What is the relation between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} \xi
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau(\xi)
                in general, that would make
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                a bijection.
            %li
              %p
                What are relation between trivializations of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} \xi
                and those of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau(\xi)
                that would make
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                – such that this makes transgression an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %h2#transgression_as_a_functor Transgression as a functor
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 2
