              %p
                into the
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
                is logical.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                its
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mstyle{:mathvariant => "bold"}
