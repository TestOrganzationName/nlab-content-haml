                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+theorem"} Diaconescu's theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#preserved_structures"} Preserved structures
                %li
                  %a{:href => "#relation_to_geometric_morphisms"} Relation to geometric morphisms
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em logical morphism
            or
            %em logical functor
            is a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            between
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power+objects"} power objects
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
          %p
            If instead a topos is regarded as a context for
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            or specifically
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric logic
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            preserving this is that of a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          %h2#definition Definition
          %p
            Since all the elementary topos structure follows from having
            %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power+objects"} power objects
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+functor"} locally cartesian closed functor
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+functor"} Heyting functor
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \Omega \in \mathcal{E}
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{E}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi A
                    %mo ≔
                    %msup
                      %mi Ω
                      %mi A
                  %annotation{:encoding => "application/x-tex"}
                    P A \coloneqq \Omega^A
            %p
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∈
                      %mi A
                    %mo ↪
                    %mi P
                    %mi A
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\in_A \hookrightarrow P A \times A
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              classified by the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ev
                      %mo :
                      %mi P
                      %mi A
                      %mo ×
                      %mi A
                      %mo →
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} ev : P A \times A \to \Omega
          %p
            This exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi A
                %annotation{:encoding => "application/x-tex"} P A
            as a
            %a.existingWikiWord{:href => "/nlab/show/power+object"} power object
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} F : \mathcal{E} \to \mathcal{F}
              between
              %a.existingWikiWord{:href => "/nlab/show/elementary+toposes"} elementary toposes
              is called a
              %strong logical morphism
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves finite
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              %li
                %p
                  for every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} A \in \mathcal{E}
                %ul
                  %li
                    %p the canonical morphism
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi ϕ
                              %mi A
                            %mo :
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi P
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mi A
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
                            \\phi_A : F(P A) \to P (F A)
                    %p
                      is an
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                      %a.existingWikiWord{:href => "/nlab/show/name+of+the+relation"} name of the relation
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∈
                              %mi A
                            %mo{:stretchy => "false"} )
                            %mo ↪
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mi A
                            %mo ×
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi F
                            %mi A
                          %annotation{:encoding => "application/x-tex"}
                            F(\in_A) \hookrightarrow F(P A \times A) \simeq F(P A) \times F A
                    %p
                      (using that
                      = succeed "s" do
                        %a.existingWikiWord{:href => "/nlab/show/cartesian+functor"} cartesian functor
                      = succeed "s" do
                        %a.existingWikiWord{:href => "/nlab/show/product"} product
                      = succeed ")" do
                        %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  %li
                    %p
                      equivalently:
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mi A
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} F(P A)
                      equipped with the
                      %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∈
                              %mi A
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} F(\in_A)
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/power+object"} power object
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} F(A)
                      in
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi ℱ
                            %annotation{:encoding => "application/x-tex"} \mathcal{F}
          %p
            The notion of logical functors between
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
          %p But both can be combined:
          #AtomicGeometricMorphism.num_defn
            %h6#definition_4 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              whose
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              is a logical functor is called an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/atomic+geometric+morphism"} atomic geometric morphism
          .num_remark
            %h6#remark Remark
            %p
              The other case, that the
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              of a geometric morphism is a logical functor is not of interest. See cor.
              %a.maruku-ref{:href => "#LogicalMorphismsAsDirectImages"}
              below.
          %h2#properties Properties
          %h3#general General
          #LeftRightAdjoint.num_prop
            %h6#proposition Proposition
            %p
              A logical functor has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              precisely if it has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, cor. A2.2.10
            ).
          .proof
            %h6#proof Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} F : \mathcal{E} \to \mathcal{F}
              a logical functor, we have by definition a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℰ
                              %mi op
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi F
                                  %mi op
                          %mtd
                            %msup
                              %mi ℱ
                              %mi op
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi P
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi P
                        %mtr
                          %mtd
                            %mi ℰ
                          %mtd
                            %mover
                              %mo →
                              %mi F
                          %mtd
                            %mi ℱ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{E}^{op} &amp;\stackrel{F^{op}}{\to}&amp; \mathcal{F}^{op}
                    \\\
                    {}^{\mathllap{P}}\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow^{\mathrlap{P}}
                    \\\
                    \\mathcal{E} &amp;\stackrel{F}{\to}&amp; \mathcal{F}
                    }
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              %a.existingWikiWord{:href => "/nlab/show/adjoint+lifting+theorem"} adjoint lifting theorem
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              has a right adjoint precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi op
                  %annotation{:encoding => "application/x-tex"} F^{op}
              does. But a right adjoint of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi op
                  %annotation{:encoding => "application/x-tex"} F^{op}
              is a left adjoint of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          #PresMono.num_prop
            %h6#proposition_2 Proposition
            %p
              If a logical functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} F : \mathcal{E} \to \mathcal{F}
              has a left adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} A\in \mathcal{F}
              and subobjects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mi A
                      %mo ∈
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} L A\in \mathcal{E}
          .proof
            %h6#proof_2 Proof
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ω
                        %mi ℰ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi Ω
                        %mi ℱ
                    %annotation{:encoding => "application/x-tex"} F(\Omega_{\mathcal{E}}) = \Omega_{\mathcal{F}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sub
                      %mi ℱ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi ℱ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msub
                      %mi Ω
                      %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi A
                    %mo ,
                    %msub
                      %mi Ω
                      %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi Sub
                      %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Sub_{\mathcal{F}}(A) \cong \mathcal{F}(A,\Omega_{\mathcal{F}}) \cong \mathcal{E}(L A,\Omega_{\mathcal{E}}) \cong Sub_{\mathcal{E}}(L A).
            %p
              It remains to check that this bijection is implemented by the action of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/partial+map+classifiers"} partial map classifiers
              = succeed ")." do
                %a{:href => "#Johnstone"} Johnstone, Lemma A2.4.8
          #CharPullback.num_prop
            %h6#proposition_3 Proposition
            %p
              For a logical functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} F : \mathcal{E} \to \mathcal{F}
              having a left adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
            %ol
              %li
                The induced functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ′
                      %mo :
                      %mi ℱ
                      %mo →
                      %mi ℰ
                      %mo{:stretchy => "false"} /
                      %mi L
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} L':\mathcal{F} \to \mathcal{E}/L 1
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ⊣
                      %mi F
                    %annotation{:encoding => "application/x-tex"} L\dashv F
                can be identified with the pullback adjunction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                      %mo{:stretchy => "false"} /
                      %mi B
                      %mo ⇄
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}/B \rightleftarrows \mathcal{E}
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                (namely
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} L1
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                preserves
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                preserves
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, Prop. A2.3.8
            ).
          .proof
            %h6#proof_3 Proof
            %p
              The left adjoint of pullback has all the other properties. Any pullback-preserving functor preserves equalizers. An equalizer-preserving functor is faithful as soon as it reflects invertibility of monomorphisms, which follows from Proposition
              %a.maruku-ref{:href => "#PresMono"}
              above. A faithful functor reflects monos and epis, hence is conservative once its domain is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/balanced+category"} balanced
            %p
              Finally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is conservative then so is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} L'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F'
              (given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              followed by pullback along
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo :
                      %mn 1
                      %mo →
                      %mi F
                      %mi L
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \eta : 1 \to F L 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                    %mo ⊣
                    %mi F
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} L'\dashv F'
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hopf+adjunction"} Hopf adjunction
              for the cartesian monoidal structures, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} L'
              preserves the terminal object. Now the counit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                    %mo ⊣
                    %mi F
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} L'\dashv F'
              can be factored as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                    %mi F
                    %mo ′
                    %mi A
                    %mo ≅
                    %mi L
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ×
                    %mi F
                    %mo ′
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≅
                    %mi L
                    %mo ′
                    %mn 1
                    %mo ×
                    %mi A
                    %mo ≅
                    %mn 1
                    %mo ×
                    %mi A
                    %mo ≅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} L' F' A \cong L'(1\times F' A) \xrightarrow{\cong} L' 1 \times A \cong 1\times A\cong A
            %p
              so it is an isomorphism. By the triangle identity,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L'(\eta)
              is an isomorphism, but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} L'
              is conservative, hence the unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is also an isomorphism, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                    %mo ⊣
                    %mi F
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} L'\dashv F'
              is an equivalence.
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, cor. A2.2.10
            ).
          #LogicalMorphismsRightAdjointToCartesianFunctors.num_cor
            %h6#corollary Corollary
            %p
              If a logical functor is
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, scholium 2.3.9
            ).
          %h3#preserved_structures Preserved structures
          %p
            In particular, a logical functor preserves the truth of all sentences in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
            %em reflects
            the truth of such sentences. For example, the
            %a.existingWikiWord{:href => "/nlab/show/transfer+principle"} transfer principle
            of
            %a.existingWikiWord{:href => "/nlab/show/nonstandard+analysis"} nonstandard analysis
            can be stated as the fact that a certain functor is logical and conservative.
          %h3#relation_to_geometric_morphisms Relation to geometric morphisms
          %p
            The difference between geometric and logical functors between toposes is, in a certain sense, a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of the difference between a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/frames"} frames
            and a homomorphism of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebras"} Heyting algebras
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            but different morphisms.
          %p
            However, while frame homomorphisms naturally categorified by geometric functors, a more precise categorification of Heyting algebra homomorphisms would be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+functors"} Heyting functors
          #LogicalMorphismsAsDirectImages.num_prop
            %h6#proposition_4 Proposition
            %p
              A logical functor is the
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              of a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              precisely if it is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
          .proof
            %h6#proof_4 Proof
            %p
              Since by definition the direct image of a geometric morphism has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              that preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
          %p
            But logical inverse images are of interest. Recall from def.
            %a.maruku-ref{:href => "#AtomicGeometricMorphism"}
            above that a
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            with logical inverse image is called an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/atomic+geometric+morphism"} atomic geometric morphism
          .num_cor
            %h6#corollary_2 Corollary
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/atomic+geometric+morphism"} atomic geometric morphism
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
          .proof
            %h6#proof_5 Proof
            %p
              By prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LeftRightAdjoint"}
          %p The following is the main source of examples of atomic geometric morphisms.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/base+change+geometric+morphism"} base change geometric morphism
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
          .proof
            %h6#proof_6 Proof
            %p
              The inverse image is given by
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along the given morphism.
          .num_prop
            %h6#remark_2 Remark
            %p
              When considering the
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
              of a given
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              relations,
              = succeed "s/" do
                %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              %a.existingWikiWord{:href => "/nlab/show/type"} type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi ob
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} A \in ob \mathcal{E}
              are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %em logical operation
          %h2#examples Examples
          %ul
            %li
              %p
                The inclusion
                %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ↪
                    %annotation{:encoding => "application/x-tex"} \hookrightarrow
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                is logical.
            %li
              %p
                More generally, for any
                %a.existingWikiWord{:href => "/nlab/show/finite+category"} finite category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                the inclusion
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi FinSet
                      %mo{:stretchy => "false"} ]
                      %mo ↪
