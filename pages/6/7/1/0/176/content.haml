                  %mtext for
                  %mspace{:width => "thickmathspace"}
                  %mi i
                  %mo ≠
                  %mi j
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  M_n := \{(z_1, ..., z_n) \in \mathbb{C}^n : z_i \neq z_j \; \text{for} \; i \neq j  \}
          %p
            be the
            = succeed "." do
              %strong space of configuration points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
