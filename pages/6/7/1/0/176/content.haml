                      %mi t
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} w(z) = e^t (t), t \in \mathbb{R}
          %p Explicitly, the last condition says that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi z
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi z
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi e
                    %mi t
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi h
                        %mn 1
                      %mo +
                      %mover
                        %mrow
                          %msub
                            %mi h
                            %mn 1
                        %mo ¯
                      %mo +
                      %mo .
                      %mo .
                      %mo .
                      %mo +
                      %msub
                        %mi h
                        %mi n
                      %mo +
                      %mover
                        %mrow
                          %msub
                            %mi h
                            %mi n
                        %mo ¯
                  %msub
                    %mi G
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi e
                    %mi t
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi z
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msup
                    %mi e
                    %mi t
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi z
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  G_i(z_1, ..., z_n) = (e^t)^{h_1 + \overline{h_1} +...+ h_n + \overline{h_n}} G_i(e^t(z_1), ..., e^t(z_n))
          %p Given axioms 1-4, the 2-point functions can be fully classified, see below.
          .num_defn
            %h6#axiom_5 Axiom 5
            %p
              %strong existence of the energy-momentum tensor
            %p
              There are four fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %mo ,
                    %mi μ
                    %mo .
                    %mi ν
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} T_{\mu, \nu}, \mu. \nu \in \{0, 1\}
              with the following properties:
            %p Symmetry:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %mo =
                    %msub
                      %mi T
                      %mrow
                        %mi ν
                        %mo ,
                        %mi μ
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %mo{:stretchy => "false"} (
                    %mi z
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo =
                    %msub
                      %mi T
                      %mrow
                        %mi ν
                        %mo ,
                        %mi μ
                    %mo{:stretchy => "false"} (
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    T_{\mu, \nu} = T_{\nu, \mu}, \; T_{\mu, \nu}(z)^* = T_{\nu, \mu}(\theta (z))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi t
                    %msub
                      %mi T
                      %mrow
                        %mi μ
                        %mo ,
                        %mn 0
                    %mo +
                    %msub
                      %mo ∂
                      %mi y
                    %msub
                      %mi T
                      %mrow
                        %mi μ
                        %mo ,
                        %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_t T_{\mu, 0} + \partial_y T_{\mu, 1} = 0
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                  %annotation{:encoding => "application/x-tex"} T_{\mu, \nu}
              has scaling dimension 2 and the conformal spin
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is restricted by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mn 00
                    %mo −
                    %msub
                      %mi T
                      %mn 11
                    %mo ±
                    %mn 2
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mn 01
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ±
                    %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    s(T_{00} - T_{11} \pm 2i \; T_{01}) = \pm 2
          %p
            The energy momentum tensor allows us to define two densly defined operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi n
                  %mo ,
                  %mover
                    %mrow
                      %msub
                        %mi L
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi n
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} L_{-n}, \overline{L_{-n}}
            that both define unitary representations of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Virasoro+algebra"} Virasoro algebra
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                %a{:href => "#LüscherMack75"} Lüscher &amp; Mack 1975
            %p T is holomorphic. Therefore, the operators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mo :
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                    %msub
                      %mo ∮
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ζ
                        %mo{:stretchy => "false"} |
                        %mo =
                        %mn 1
                    %mfrac
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi ζ
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi ζ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mi d
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"}
                    L_{-n} := \frac{1}{2 \pi i} \oint_{| \zeta | = 1} \frac{T(\zeta)}{\zeta^{n+1}} d\zeta
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi L
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi n
                      %mo ¯
                    %mo :
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                    %msub
                      %mo ∮
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ζ
                        %mo{:stretchy => "false"} |
                        %mo =
                        %mn 1
                    %mfrac
                      %mrow
                        %mover
                          %mi T
                          %mo ¯
                        %mo{:stretchy => "false"} (
                        %mi ζ
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi ζ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mi d
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{L_{-n}} := \frac{1}{2 \pi i} \oint_{| \zeta | = 1} \frac{\overline{T}(\zeta)}{\zeta^{n+1}} d\zeta
            %p
              are well defined and satisfy the commutation relations of two commuting
              %a.existingWikiWord{:href => "/nlab/show/Virasoro+algebra"} Virasoro algebras
              with the same central charge.
          .num_defn
            %h6#definition Definition
            %p
              %strong primary field
            %p
              A conformal field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ψ
                        %mi i
                      %mo ,
                      %mi i
                      %mo ∈
                      %msub
                        %mi B
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \psi_i, i \in B_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi L
                      %mi n
                    %mo ,
                    %msub
                      %mi ψ
                      %mi i
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msup
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo ∂
                      %mi z
                    %msub
                      %mi ψ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi h
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi z
                      %mi n
                    %msub
                      %mi ψ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [L_n, \psi_i] =  z^{n+1} \partial_z \psi_i(z) + h_i (n+1) z^n \psi_i(z)
            %p
              and likewise for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi z
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{z}
          %p So, primary fields are the fields whose correlation functions are covariant “infinitesimally” with respect to all holomorphic functions, the “infinitesimal symmetry” expressed in the definition.
          %p The fields are operator valued distributions and cannot be multiplied in general. The possibility of multiplication of fields evaluated at different points and some control of the singularities of this product are part of the axioms of conformal field theory:
          .num_defn
            %h6#pseudodefinition Pseudodefinition
            %p
              %strong operator product expansion
            %p
              An operator product expansion (
              %strong> OPE
              ) for a family of fields means that there is for all fields and all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mn 1
                    %mo ≠
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} z
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} z_1 \neq \z_2
              a relation of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi ψ
                      %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi B
                          %mn 0
                    %msub
                      %mi C
                      %mi ijk
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 1
                    %mo −
                    %msub
                      %mi z
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi h
                          %mi k
                        %mo −
                        %msub
                          %mi h
                          %mi i
                        %mo −
                        %msub
                          %mi h
                          %mi j
                    %msub
                      %mi ψ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\psi_i(z_1) \psi_j(z_2) \sim \sum_{k \in B_0} C_{ijk} (z_1 - z_2)^{h_k - h_i - h_j} \psi_k(z_2)
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
              means modulo regular functions.
          %p A rigorous interpretation of an OPE would interpret the given relation as a relation of e.g. matrix elements or vacuum expectation values.
          %p
            An OPE is called
            %strong associative
            if the expansion of a product of more than two fields does not depend on the order of the expansion of the products of two factors. Since the OPE has no interpretation as defining products of operators, or more generally the product in a ring, the notion of associativity does not refer to the associativity of a product in a ring, as the term may suggest.
          .num_defn
            %h6#axiom_6 Axiom 6
            %p
              %strong existence of associative operator product expansion
            %p The primary fields have an associative OPE.
          %p
            Many
            %em formal
            calculations of physicists in CFT involving OPE can be justified by using
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebra"} vertex operator algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebra"} vertex operator algebra
          %h3#properties Properties
          .num_prop
            %h6#proposition_3 Proposition
            %p Any 2-point function satisfying axioms 1-4 has the following form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi ij
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 1
                    %mo ,
                    %msub
                      %mi z
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi C
                      %mi ij
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 1
                    %mo −
                    %msub
                      %mi z
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi h
                          %mi i
                        %mo +
                        %msub
                          %mi h
                          %mi j
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %msub
                          %mi z
                          %mn 1
                      %mo ¯
                    %mo −
                    %mover
                      %mrow
                        %msub
                          %mi z
                          %mn 2
                      %mo ¯
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mover
                          %mrow
                            %msub
                              %mi h
                              %mi i
                          %mo ¯
                        %mo +
                        %mover
                          %mrow
                            %msub
                              %mi h
                              %mi j
                          %mo ¯
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G_{ij}(z_1, z_2) = C_{ij} (z_1 - z_2)^{-(h_i + h_j)} (\overline{z_1} - \overline{z_2})^{-(\overline{h_i} + \overline{h_j})}
            %p
              with some constant
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi ij
                      %mo ∈
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} C_{ij} \in \mathbb{C}
          %h2#2d_cft_on_surfaces_or_arbitrary_genus 2d CFT on surfaces or arbitrary genus
          %p …
          %h2#conformal_anomaly Conformal anomaly
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Liouville+cocycle"} Liouville cocycle
            appears when one moves from genuine
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            %a.existingWikiWord{:href => "/nlab/show/conformal+cobordisms"} conformal cobordisms
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+representation"} projective representations
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} c\neq 0
            = succeed "." do
              %em
                conformal
                %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} anomaly
          %p …
          %h2#cft_in_aqft_language CFT in AQFT language
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/AQFT"} AQFT
            conformal field theory is modeled in terms of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/local+net"} local net
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/conformal+net"} conformal net
          %h2#FullAndChiral Full versus chiral CFT
          %blockquote
            %p some discussion of full vs. chiral CFT goes here… then:
          %p
            The following result establishes which pairs of
            %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebras"} vertex operator algebras
            can appear as the left and right chiral parts of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/full+field+algebra"} full field algebra
            in the sense of (
            %a{:href => "#HuangKong05"}> Huang-Kong 05
            ), etc. (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebra"} vertex operator algebra
          .num_defn
            %h6#definition_2 Definition
            %p
              Two
              %a.existingWikiWord{:href => "/nlab/show/modular+tensor+categories"} modular tensor categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are said to have the same
              %strong Witt class
              if there exist two
              %a.existingWikiWord{:href => "/nlab/show/spherical+categories"} spherical categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              such that we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/ribbon+categories"} ribbon categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊠
                    %mi 𝒵
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi D
                    %mo ⊠
                    %mi 𝒵
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C \boxtimes \mathcal{Z}(S) \simeq D \boxtimes \mathcal{Z}(T)
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒵
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{Z}(S)
            is the category whose objects are pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Z, z)
            consisting of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} Z \in S
            and a
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mi X
                    %mo :
                    %mi Z
                    %mo ⊗
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mi X
                    %mo ⊗
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} z_X : Z \otimes X \stackrel{\simeq}{\to} X \otimes Z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} X, Y \in S
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Z
                          %mo ⊗
                          %mi X
                          %mo ⊗
                          %mi Y
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi z
                                %mrow
                                  %mi X
                                  %mo ⊗
                                  %mi Y
                        %mtd
                        %mtd
                          %mi X
                          %mo ⊗
                          %mi Y
                          %mo ⊗
                          %mi Z
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi z
                                  %mi x
                                %mo ⊗
                                %mi Id
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↗
                            %mrow
                              %mi Id
                              %mo ⊗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi z
                                    %mi y
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                          %mo ⊗
                          %mi Z
                          %mo ⊗
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Z \otimes X \otimes Y &amp;&amp;\stackrel{z_{X \otimes Y}}{\to}&amp;&amp;
                  X \otimes Y \otimes Z
                  \\\
                  \&amp; {}_{\mathllap{z_x \otimes Id}}\searrow &amp;&amp; \nearrow_{Id \otimes \mathrlap{z_y^{-1}}}
                  \\\
                  \&amp;&amp; X \otimes Z \otimes Y
                  }
          %p This becomes a monoidal category itself by setting
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo ⊗
                  %mi W
                  %mo ,
                  %mi z
                  %mo ⊗
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (Z,z) \otimes (W,w) := (Z \otimes W, z \otimes w)
                  \\,.
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Michael+M%C3%BCger"}> Michael Müger
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              %a.existingWikiWord{:href => "/nlab/show/spherical+category"} spherical category
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒵
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}(S)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
          %p
          .num_theorem
            %h6 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Michael+M%C3%BCger"}> Michael Müger
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
              then there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/ribbon+categories"} ribbon categories
            #eq:IdentifyingTheDrinfeldCenter.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒵
                    %mover
                      %mo ←
                      %mo ≃
                    %mi C
                    %mo ⊠
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{Z}
                    \\stackrel{\simeq}{\leftarrow}
                    C \boxtimes \bar C
            %p
          %p
          #IdentifyingTheDrinfeldCenter.num_remark
            %h6 Remark
            %p
            %ol
              %li
                %p
                  An explicit
                  %a.existingWikiWord{:href => "/nlab/show/inverse+functor"} inverse functor
                  for
                  %a.maruku-eqref{:href => "#eq:IdentifyingTheDrinfeldCenter"} (1)
                  is given by
                  %a{:href => "modular+tensor+category#GuuTham21"} Guu &amp; Tham 2021
                  using
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/string+diagram"} graphical calculus
              %li
                %p
                  The functor
                  %a.maruku-eqref{:href => "#eq:IdentifyingTheDrinfeldCenter"} (1)
                  exists also for the non-modular case, but it is then just an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunctions"} ambidextrous adjoint
            %p
