                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+flat+modality"} infinitesimal flat modality
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
                %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic modality
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/jet+comonad"} jet comonad
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+coalgebras+over+a+comonad"} model structure on coalgebras over a comonad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polynomial+comonad"} polynomial comonad
          %h2#references References
          %h3#general General
          %ul
            %li#ApplegateTierney70
              %a.existingWikiWord{:href => "/nlab/show/Harry+Applegate"}> Harry Applegate
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Myles+Tierney"} Myles Tierney
              = succeed "," do
                %em Iterated cotriples
              %strong 137
              (1970) 56-99 (
              %a{:href => "https://doi.org/10.1007/BFb0060440"}> doi:10.1007/BFb0060440
              )
          %p
            Some introductory material on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comonads"} comonads
            %a.existingWikiWord{:href => "/nlab/show/coalgebra+over+a+comonad"} coalgebras
            and
            %a.existingWikiWord{:href => "/nlab/show/co-Kleisli+morphisms"} co-Kleisli morphisms
            can be found in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"}> Paolo Perrone
              ,
              = succeed "," do
                %em Notes on Category Theory with examples from basic mathematics
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1912.10642"} arXiv
          %h3#as_contexts_in_computer_science As contexts in computer science
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/comonads+in+computer+science"} comonads in computer science
          %ul
            %li#UustaluVene08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"}> Tarmo Uustalu
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Varmo+Vene"} Varmo Vene
                = succeed "," do
                  %em Comonadic Notions of Computation
                %strong 203
                5 (2008) 263-284 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/j.entcs.2008.05.029"}> doi:10.1016/j.entcs.2008.05.029
                \&amp;rbrack;
            %li#POM13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tomas+Petricek"}> Tomas Petricek
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dominic+Orchard"} Dominic Orchard
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alan+Mycroft"} Alan Mycroft
                = succeed "," do
                  %em Coeffects: Unified Static Analysis of Context-Dependence
                = succeed "," do
                  %em Automata, Languages, and Programming. ICALP 2013
                %strong 7966
                Springer (2013) &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/978-3-642-39212-2_35"}> doi:10.1007/978-3-642-39212-2_35
                \&amp;rbrack;
            %li#GKOBU16
              %p
                Marco Gaboardi,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shin-ya+Katsumata"} Shin-ya Katsumata
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dominic+Orchard"} Dominic Orchard
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"} Tarmo Uustalu
                = succeed "," do
                  %em Combining effects and coeffects via grading
                = succeed "," do
                  %a{:href => "https://doi.org/10.1145/2951913.2951939"} doi:10.1145/2951913.2951939
                = succeed "," do
                  %a{:href => "https://icfp16.sigplan.org/details/icfp-2016-papers/31/Combining-Effects-and-Coeffects-via-Grading"} talk abstract
                = succeed "&rbrack;" do
                  %a{:href => "https://www.youtube.com/watch?v=l1ZNMT3fQCo"} video rec
            %li#KRU20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Shin-ya+Katsumata"}> Shin-ya Katsumata
                , Exequiel Rivas,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"} Tarmo Uustalu
                %em Interaction laws of monads and comonads
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1912.13477"}> arXiv:1912.13477
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1145/3373718.3394808"} doi:10.1145/3373718.3394808
          %h3#GameComonads Game comonads in logic
          %p
            Comonads encode positions in back-and-forth
            %a.existingWikiWord{:href => "/nlab/show/games"} games
            and
            %a.existingWikiWord{:href => "/nlab/show/bisimulations"} bisimulations
            in various
            %a.existingWikiWord{:href => "/nlab/show/fragments"} fragments
            of
            %a.existingWikiWord{:href => "/nlab/show/first+order+logic"} first-order
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modal+logics"} modal logics
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Ehrenfeucht-Fra%C3%AFss%C3%A9+comonad"} Ehrenfeucht-Fraïssé comonad
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"}> Samson Abramsky
                \.
                %em Structure and Power: an emerging landscape.
                Fundamenta Informaticae 186(1-4) : 1–26, 2022 (
                %a{:href => "https://doi.org/10.3233/FI-222116"}> doi:10.3233/FI-222116
                ,
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/quant-ph/2206.07393"} arXiv:quant-ph/2206.07393
            %li#AbramskyShah
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"} Samson Abramsky
                and
                = succeed "," do
                  %span.newWikiWord
                    Nihil Shah
                    %a{:href => "/nlab/new/Nihil+Shah"} ?
                %em Relating Structure and Power: Comonadic Semantics for Computational Resources
                (
                %a{:href => "https://arxiv.org/abs/1806.09031"}> arXiv:1806.09031
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"}> Samson Abramsky
                , Anuj Dawar, and Pengming Wang.
                %em The pebbling comonad in finite model theory.
                32nd Annual ACM/IEEE Symposium on Logic in Computer Science (LICS). IEEE, 2017 (
                %a{:href => "https://arxiv.org/abs/1704.05124"}> arXiv:1704.05124
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"} Samson Abramsky
                and Dan Marsden.
                %em Comonadic semantics for guarded fragments.
