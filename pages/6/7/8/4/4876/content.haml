            %p#HypergeometricReferencesForVanishingLevel
              Discussion for the special case of
              %a.existingWikiWord{:href => "/nlab/show/level+%28Chern-Simons+theory%29"} level
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} =0
              (cf. at
              = succeed "):" do
                %em
