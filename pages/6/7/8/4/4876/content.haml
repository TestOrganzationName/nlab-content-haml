                %a{:href => "https://projecteuclid.org/journals/hokkaido-mathematical-journal/volume-34/issue-2/The-twisted-de-Rham-cohomology-for-basic-constructionsof-hyperplane-arrangements/10.14492/hokmj/1285766233.full"} doi:10.14492/hokmj/1285766233
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
