                  %annotation{:encoding => "application/x-tex"} G
              an ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              may be taken to be the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cocycle
              corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ˜
                      %mo ≃
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \tilde G \simeq G
            %p
              On the opposite extreme, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G = \mathbf{B}^p U(1)
              itself with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              the identity, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \tilde G = \mathbf{B}^p U (1)_{conn}
              is the
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              for
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              (the
              %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
              under
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              and
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/infinity-stackification"} infinity-stackification
            %p
              Hence a more general case is a fibered product of these two, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde G
              is such that a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ⟶
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \Sigma \longrightarrow \tilde G
              is equivalently a pair consisting of a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Sigma \to G
              and of differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
              with “tensor multiplet” fields on them, such as the
              %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
              and the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          .num_prop
            %h6#proposition Proposition
            %p
              In the situation of def.
              %a.maruku-ref{:href => "#RefinementOfHodgeFiltration"}
              there is an essentially unique
              %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi WZW
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %msub
                      %mi 𝔾
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{WZW}
                    \\colon
                    \\tilde G
                    \\longrightarrow
                    \\mathbf{B}^2 \mathbb{G}_{conn}
            %p of the closed differential form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi θ
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi θ
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ˜
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi μ
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔾
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(\theta_{\tilde G})
                    \\colon
                    \\tilde G
                    \\stackrel{\theta_{\tilde G}}{\longrightarrow}
                    \\mathbf{\Omega}^1_{flat}(-,G)
                    \\stackrel{\mu}{\longrightarrow}
                    \\mathbf{\Omega}^2_{cl}(-,\mathbb{G})
            %p
              whose underlying
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              is
              %a.existingWikiWord{:href => "/nlab/show/modulating+morphism"} modulated
              by the
              %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \Omega \mathbf{c}
              of the original cocycle.
            %p
              This we call the
              %em WZW term
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              with respect to the chosen refinement of the Hodge structure.
          %h2#Properties Properties
          %h3#EquationsOfMotion Equations of motion
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational derivative
            of the WZW
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %msub
                    %mi S
                    %mi WZW
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mi k
                    %mrow
                      %mn 2
                      %mi π
                      %mi i
                  %msub
                    %mo ∫
                    %mi Σ
                  %mo{:stretchy => "false"} ⟨
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi δ
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mover
                    %mo ∂
                    %mo{:stretchy => "false"} ¯
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta S_{WZW}(g)
                  \=
                  \-\frac{k}{2 \pi i }
                  \\int_\Sigma \langle (g^{-1}\delta g), \partial (g^{-1}\bar \partial g)  \rangle
                  \\,.
          %p
            Therefore the classical
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            for function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} g \colon \Sigma \to G
            are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mover
                    %mo ∂
                    %mo{:stretchy => "false"} ¯
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo ∂
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∂
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\partial(g^{-1}\bar \partial g)
                  \= 0
                  \\;\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;\;
                  \\bar \partial(g \partial g^{-1}) = 0
                  \\,.
          %p
            The space of solutions to these equations is small. However, discussion of the
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of the theory (
            %a{:href => "#HolographyAndRigorousConstruction"}> below
            ) suggests to consider these equations with the real
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            replaced by its
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            to the
            %a.existingWikiWord{:href => "/nlab/show/complex+Lie+group"} complex Lie group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G({\mathbb{C}})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo ,
                  %mover
                    %mi z
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi g
                    %mi ℓ
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi g
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi z
                    %mo{:stretchy => "false"} ¯
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  g(z,\bar z)
                  \=
                  g_{\ell}(z) g_r(\bar z)^{-1}
          %p
            where hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi ℓ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_{\ell} \colon \Sigma \to G(\mathbb{C})
            is any
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphic function
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi r
                %annotation{:encoding => "application/x-tex"} g_r
            similarly any anti-holomorphic function.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Gawedzki99"} Gawedzki 99 (3.18), (3.19)
          %h3#HolographyAndRigorousConstruction Holography and Rigorous construction
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2+and+CS-WZW+correspondence"} AdS3-CFT2 and CS-WZW correspondence
            (see there for more details) the 2d WZW
            %a.existingWikiWord{:href => "/nlab/show/CFT"} CFT
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is related to
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                    %mi d
                  %annotation{:encoding => "application/x-tex"} 3d
          %p
            In fact a rigorous constructions of the
            = succeed "-WZW" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/rational+2d+CFT"} rational 2d CFT
            is via the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/FRS-theorem+on+rational+2d+CFT"} FRS-theorem on rational 2d CFT
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            as a
            %a.existingWikiWord{:href => "/nlab/show/3d+TQFT"} 3d TQFT
            incarnated via a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Reshetikhin-Turaev+construction"} Reshetikhin-Turaev construction
          %div
            %h3#BraidRepresentationsViaTwisteddRCohomologyOfConfigurationSpaces Braid representations via twisted cohomology of configuration spaces
            %p
              The “
              %a.existingWikiWord{:href => "/nlab/show/hypergeometric+construction+of+KZ+solutions"}> hypergeometric integral
              ” construction of
              %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
              for
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/affine+Lie+algebra"} affine Lie algebra
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
              %a.existingWikiWord{:href => "/nlab/show/2d+CFTs"} 2d CFTs
              and of more general solutions to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+equation"} Knizhnik-Zamolodchikov equation
              %a.existingWikiWord{:href => "/nlab/show/twisted+de+Rham+cohomology"} twisted de Rham cohomology
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Vadim+Schechtman"}> Vadim Schechtman
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Alexander+Varchenko"} Alexander Varchenko
                  = succeed "," do
                    %em Integral representations of N-point conformal correlators in the WZW model
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "http://cds.cern.ch/record/1044951"} cds:1044951
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li#DateJimboMatsuoMiwa90
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Etsuro+Date"}> Etsuro Date
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Michio+Jimbo"} Michio Jimbo
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Atsushi+Matsuo"} Atsushi Matsuo
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Tetsuji+Miwa"} Tetsuji Miwa
                  = succeed "," do
                    %em
                      Hypergeometric-type integrals and the
                      = succeed "-Knizhnik-Zamolodchikov" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝔰𝔩
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo ,
                              %mi ℂ
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
                  %strong 04
                  05 (1990) 1049-1057
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1142/S0217979290000528"} doi:10.1142/S0217979290000528
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
                %blockquote
                  %p
                    (for
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/sl%282%29"}
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝔰𝔩
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo ,
                              %mi ℂ
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Atsushi+Matsuo"}> Atsushi Matsuo
                  ,
                  = succeed "," do
                    %em
                      An application of Aomoto-Gelfand hypergeometric functions to the
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} SU(n)
                      Knizhnik-Zamolodchikov equation
