                %annotation{:encoding => "application/x-tex"} (A_i)_{i:I}
            of sets, the (external)
            %strong disjoint union
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
