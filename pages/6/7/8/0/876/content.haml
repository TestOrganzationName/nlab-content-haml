                      %mi i
                  %annotation{:encoding => "application/x-tex"} \sum_i A_i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
