          %h2#definition Definition
          #InfinitesimalBraidLieAlgebra.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+braid+Lie+algebra"}> infinitesimal braid Lie algebra
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ≠
                        %mi j
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\{t_{i j}\}_{i\neq j \in \{1,\cdots, n\}})
              be the
              %a.existingWikiWord{:href => "/nlab/show/free+Lie+algebra"} free Lie algebra
              (over a given
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} t_{i j}
              in degree with two indices ranging from 1 to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and distinct.
            %p
              The
              %em infinitesimal braid relations
              in dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} D = 2
              are the following
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} relations
              on the underlying
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              on
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ≠
                        %mi j
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_{i j}\}_{i\neq j \in \{1,\cdots, n\}}
            #eq:InfinitesimalBriadRelations.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "left center left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi R
                            %mn 0
                            %mo :
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %msub
                              %mi t
                              %mrow
                                %mi i
                                %mi j
                            %mo −
                            %msub
                              %mi t
                              %mrow
                                %mi j
                                %mi i
                          %mtd
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mi R
                            %mn 1
                            %mo :
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi t
                              %mrow
                                %mi i
                                %mi j
                            %mo ,
                            %msub
                              %mi t
                              %mrow
                                %mi k
                                %mi l
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mi R
                            %mn 2
                            %mo :
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi t
                              %mrow
                                %mi i
                                %mi j
                            %mo ,
                            %msub
                              %mi t
                              %mrow
                                %mi i
                                %mi k
                            %mo +
                            %msub
                              %mi t
                              %mrow
                                %mi k
                                %mi j
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo =
                            %mn 0
                          %mtd
                            %mpadded{:width => "0"}
                              %mspace{:width => "thinmathspace"}
                      %mo }
                    %mtext for pairwise distinct indices
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\left.
                    \\begin{array}{lcll}
                    R0: \;\; &amp; t_{i j} - t_{j i} &amp; = 0
                    \\\
                    R1: \;\; &amp; [t_{i j}, t_{k l}] &amp; =  0
                    \\\
                    R2: \;\; &amp; [t_{i j}, t_{i k} + t_{k j}] &amp; = 0
                    \&amp;
                    \\mathrlap{\,}
                    \\end{array}
                    \\right\}
                    \\text{for pairwise distinct indices}
                    \\;\;
            %p
              This defines a quotient
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              often denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ≠
                        %mi j
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mn 0
                    %mo ,
                    %mi R
                    %mn 1
                    %mo ,
                    %mi R
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_n
                    \\;\coloneqq\;
                    F(\{t_{i j}\}_{i\neq j \in \{1,\cdots, n\}})
                    \/(R0, R1, R2)
                    \\,.
          %p
            More generally, there is a version of this in any dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} D \in \mathbb{N}
            with some extra signs thrown in.
          %p
            This is originally due to
            = succeed "," do
              %a{:href => "#Kohno87"} Kohno 87 (1.1.4)
            = succeed "," do
              %a{:href => "#Kohno88"} Kohno 88
            = succeed "," do
              %a{:href => "#BarNatan96"} Bar-Natan 96, Fact 3
            = succeed "," do
              %a{:href => "#FadellHusseini01"} Fadell-Husseini 01
            = succeed "." do
              %a{:href => "#CohenGitler01"} Cohen-Gitler 01, Section 3
          %p
            Authors have used different equivalent versions of this presentation, see
            %a{:href => "#CohenGitler02"} Cohen-Gitler 02, p. 2
            for a clear statement.
          %h2#properties Properties
          %h3#relation_to_horizontal_chord_diagrams Relation to horizontal chord diagrams
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi t
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ≠
                      %mi j
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi R
                  %mn 0
                %annotation{:encoding => "application/x-tex"} F(\{t_{i j}\}_{i\neq j \in \{1,\cdots, n\}})/R0
            is identified with the
            %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
            Lie algebra of
            %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            strands, generated by
          %center
            %img{:src => "https://ncatlab.org/nlab/files/HorizontalChordGenerator.jpg", :width => "500 /> "}/
          %p
            and forming an
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            under
            %a.existingWikiWord{:href => "/nlab/show/concatenation"} concatenation
            of diagrams along strands, as in
          %center
            %img{:src => "https://ncatlab.org/nlab/files/AlgebraStrucOnSpanofHorizontalChordDiagrams.jpg", :width => "500"}/
          %p
            then the remaining infinitesimal braid relations
            %a.maruku-eqref{:href => "#eq:InfinitesimalBriadRelations"} (1)
            are equivalently the following:
          %p
            R1 is the the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/2T+relation"} 2T relation
          %center
            %img{:src => "https://ncatlab.org/nlab/files/HorizontalChordDiagram2TRelation.jpg", :width => "600"}/
          %p
            R2 is the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/4T+relation"} 4T relation
          %center
            %img{:src => "https://ncatlab.org/nlab/files/HorizontalChordDiagram4TRelation.jpg", :width => "600"}/
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %p Hence:
          #UniversalEnvelopingOfInfinitesimalBraidsIsHorizontalChords.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+braid+Lie+algebra"} infinitesimal braid Lie algebra
                is
                %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
                %a.existingWikiWord{:href => "/nlab/show/quotient+vector+space"} modulo
                = succeed "&" do
                  %a.existingWikiWord{:href => "/nlab/show/2T+relations"} 2T
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/4T+relations"} 4T
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msubsup
                      %mi 𝒜
