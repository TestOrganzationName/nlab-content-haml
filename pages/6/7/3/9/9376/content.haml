          %p
            hece equivalently pairs consisting of a
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
