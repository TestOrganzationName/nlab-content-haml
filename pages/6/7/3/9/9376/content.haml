                    \\,.
          .num_example
            %h6#example_2 Example
            %p
              In
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi LieGrp
                    %mo ↪
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in LieGrp \hookrightarrow Grp(\mathbf{H})
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+group"} semisimple Lie group
              %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mi Spin
                    %annotation{:encoding => "application/x-tex"} G = Spin
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              is a pre-3-plectic form on the
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo →
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi cl
                      %mn 4
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle
                    \\;\colon\;
                    \\mathbf{B}G_{conn} \to \mathbf{\Omega}_{cl}^4
                    \\,.
            %p
              This has a
              %a.existingWikiWord{:href => "/nlab/show/higher+geometric+prequantization"} higher geometric prequantization
              by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+first+fractional+Pontryagin+class"} smooth first fractional Pontryagin class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tfrac{1}{2}\hat\mathbf{p}_1
                    \\;\colon\;
                    \\mathbf{B}G_{conn} \to \mathbf{B}^3 U(1)_{conn}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
              of this to maps oout of the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              yields a
              %a.existingWikiWord{:href => "/nlab/show/circle+2-bundle+with+connection"} circle 2-bundle with connection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %mfrac
                          %mn 1
                          %mn 2
                        %msub
                          %mover
                            %mstyle{:mathvariant => "bold"}
                              %mi p
                            %mo{:stretchy => "false"} ^
                          %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi π
                        %mi i
                        %msub
                          %mo ∫
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla
                    \\;\colon\;
                    G \to [S^1, G]
                    \\stackrel{[S^1, \frac{1}{2}\hat\mathbf{p}_1]}{\to}
                    [S^1, \mathbf{B}^3 U(1)_{conn}]
                    \\stackrel{\exp(2 \pi i \int_{S^1}(-))}{\to}
                    \\mathbf{B}^2 U(1)
                    \\,.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/prequantum+circle+2-bundle"} prequantum circle 2-bundle
              which prequantizes the canonical
              %a.existingWikiWord{:href => "/nlab/show/differential+3-form"} differential 3-form
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/invariant+differential+form"} left invariant
              and at the neutral element is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -,[-,-]\rangle
            %p
              Consider now the
              %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+geometry"} higher prequantum geometry
              of this 2-connection. So now
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{G} = \mathbf{B}U(1)
            %p Observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Ω
                            %mi 𝔾
                            %mo{:stretchy => "false"} )
                            %mstyle{:mathvariant => "bold"}
                              %mi FlatConn
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mstyle{:mathvariant => "bold"}
                              %mi FlatConn
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\Omega \mathbb{G})\mathbf{FlatConn}(G)
                    \&amp; \simeq
                    U(1) \mathbf{FlatConn}(G)
                    \\\
                    \&amp; =
                    \\mathbf{B}U(1)
                    \\end{aligned}
            %p
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is assumed to be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
              does appear here with its canonical smooth structure: while a
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
              from the trivial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
