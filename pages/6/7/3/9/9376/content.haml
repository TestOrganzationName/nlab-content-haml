              \-
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connections"} principal ∞-connections
            and this is itself again a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28%E2%88%9E%2C1%29-category"} group object
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
