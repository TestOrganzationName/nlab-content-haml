                        %annotation{:encoding => "application/x-tex"} n
              below.
          #HValuedAutomorphismAsFiber.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              a morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.maruku-ref{:href => "#HValuedAutomorphismGroup"}
              sits in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Aut
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Aut
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ∘
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ⊢
                                %mi f
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{Aut}_{\mathbf{H}}(f)
                    \&amp;\to&amp;
                    \\mathbf{Aut}(X)
                    \\\
                    \\downarrow^{\mathrlap{}} &amp;&amp; \downarrow^{\mathrlap{f \circ (-)}}
                    \\\
                    {*}
                    \&amp;\stackrel{\vdash f}{\to}&amp;
                    [X,Y]
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Aut}(X) \hookrightarrow [X,X]
              is the ordinary
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ∈
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \in Grpd(\mathbf{H})
              a
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+bisections"} ∞-group of bisections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{BiSect}(\mathcal{G}) \in Grpd(\mathbf{H})
              is the
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              = succeed "-group," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %a.maruku-ref{:href => "#HValuedAutomorphismGroup"}
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi 𝒢
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo →
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \phi_{\mathcal{G}} \colon \mathcal{G}_0 \to \mathcal{G}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              under prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#EffectiveEpisAreEquivalentlyGroupoids"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Aut
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{BiSect}(\mathcal{G})
                    \\coloneqq
                    \\mathbf{Aut}_{\mathbf{H}}(\phi_{\mathcal{G}})
                    \\,.
          %p With this the following proposition is immediate, but important for the interpretation of higher Atiyah groupoids:
          .num_prop
            %h6#propostition Propostition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi F
                  %annotation{:encoding => "application/x-tex"} c \;\colon\; X \to \mathbf{F}
              a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} P \to X
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi At
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Aut
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{BiSect}(At(P))
                    \\simeq
                    \\mathbf{Aut}_{\mathbf{H}}(c)
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              We may read this as saying that the higher Atiyah groupoid of an
              %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
              is the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
              solution to the problem of finding a
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object
              whose
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+bisections"} ∞-group of bisections
              reproduces a given slice
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              %em
                %a{:href => "#Examples"} Examples
              below.
          %h3#SequencesOfInclusionsOfGroupsOfBisections
            Sequences of inclusions of Atiyah-bisection
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            which is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            and in particular of
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connections"} principal ∞-connections
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stacks"} moduli ∞-stacks
            of
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            equipped with differing degree of differential refinement induce canonical inclusions of the corresponding higher Atiyah groupoids.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔾
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mi be
                  %mi a
                %annotation{:encoding => "application/x-tex"} \mathbb{G} \in Grp(\mathbf{H}) be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/braided+%E2%88%9E-group"} braided ∞-group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connections"} principal ∞-connections
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            we denote
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi{:mathvariant => "normal"} conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{G}_{\mathrm{conn}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔾
                    %mi conn
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi 𝔾
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}\mathbb{G}_{conn} \to \mathbf{B}\mathbb{G}
          %p
            which “forgets the connection”. Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔾
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla \colon X \to \mathbf{B}\mathbb{G}_{conn}
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connection"} principal ∞-connection
            we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo →
                    %mo ∇
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔾
                    %mi conn
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi 𝔾
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_0 \;\colon\; X \stackrel{\nabla}{\to}
                  \\mathbf{B}\mathbb{G}_{conn} \to \mathbf{B}\mathbb{G}
          %p for the corresponding underlying map.
          #InclusionOfNableBisectionsIntoNable0Bisections.num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
              along this map induces a canonical map of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi At
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi At
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∇
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{BiSect}(At(\nabla))
                    \\to
                    \\mathbf{BiSect}(At(\nabla_0))
                    \\,.
          %p
            If we regard
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            as a
            %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum n-bundle
            then this is a canonical inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/quantomorphism+n-group"} quantomorphism n-group
            into the
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \nabla_0
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔾
                %annotation{:encoding => "application/x-tex"} \mathbb{G}
            is even a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sylleptic+%E2%88%9E-group"} sylleptic ∞-group
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            and we obtain a 2-step sequence of forgetful maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %msub
                    %mi 𝔾
                    %mi conn
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔾
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi 𝔾
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^2 \mathbb{G}_{conn}
                  \\to
                  \\mathbf{B}(\mathbf{B}\mathbb{G}_{conn})
                  \\to
                  \\mathbf{B}^2 \mathbb{G}
                  \\,.
          %p Accordingly:
          #InclusionOfNableBisectionsIntoNable1AndNabla0Bisections.num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
              along these maps induces inclusions of
              = succeed "-groups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi At
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi At
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∇
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi BiSect
                    %mo{:stretchy => "false"} (
                    %mi At
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∇
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{BiSect}(At(\nabla))
                    \\to
                    \\mathbf{BiSect}(At(\nabla_1))
                    \\to
                    \\mathbf{BiSect}(At(\nabla_0))
                    \\,.
          .num_remark
            %h6#remark_5 Remark
            %p This now interprets as the inclusion
            %ol
              %li
                %p
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/quantomorphism+n-group"} quantomorphism n-group
                  into the
                  = succeed "-group" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/higher+Courant+groupoid"} higher Courant groupoid
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-group of bisections of the
                  %a.existingWikiWord{:href => "/nlab/show/higher+Courant+groupoid"} higher Courant groupoid
                  into that of “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \nabla_0
                  \-twisted diffeomorphisms”.
          %p In summary we have the following table of inclusions
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"}> slice
                \-
                %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-groups"} automorphism ∞-groups
                in
                %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+geometry"} higher prequantum geometry
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/cohesive"} cohesive
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-group"} Heisenberg ∞-group
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/quantomorphism+%E2%88%9E-group"} quantomorphism ∞-group
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-bisections"} ∞-bisections
                    of
                    %a.existingWikiWord{:href => "/nlab/show/higher+Courant+groupoid"} higher Courant groupoid
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-bisections"} ∞-bisections
                    of
                    %a.existingWikiWord{:href => "/nlab/show/higher+Atiyah+groupoid"} higher Atiyah groupoid
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"}> L-∞ algebras
                    \:
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Heisenberg+L-%E2%88%9E+algebra"} Heisenberg L-∞ algebra
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Poisson+L-%E2%88%9E+algebra"} Poisson L-∞ algebra
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Courant+L-%E2%88%9E+algebra"} Courant L-∞ algebra
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ↪
                        %annotation{:encoding => "application/x-tex"} \hookrightarrow
                  %td{:style => "text-align: left;"} twisted vector fields
          %p
            See below at
            %em
              %a{:href => "#TheTraditionalCourantLie2Algebroid"} Examples– The traditional Courant Lie 2-algebroid
            for more on this.
          %h2#Examples Examples
          %p
            We first show how the general notion of
            %em higher Atiyah groupoid
            reproduces various traditonal structures.
          %ul
            %li
              %p
                %em
                  %a{:href => "#TheTraditionalAtiyagLieGroupoid"} The traditonal Atiyah Lie groupoid
            %li
              %p
                %em
                  %a{:href => "#TheTraditionalCourantLie2Algebroid"} The traditional Courant Lie 2-algebroid
            %li
              %p
                %em
                  %a{:href => "#TheTraditionalQuantomorphismGroup"} The traditional quantomorphism group
            %li
              %p
                %em
                  %a{:href => "#TheQuantomorphismNGroups"} The quantomorphism n-groups
            %li
              %p
                %em
                  %a{:href => "#TheTraditionalHeisenbergGroup"} The traditional Heisenberg group
            %li
              %p
                %em
                  %a{:href => "#TheHeisenbergnGroup"} The Heisenberg n-group
          %h3#TheTraditionalAtiyagLieGroupoid The traditional Atiyah Lie groupoid
          %p
            We discuss how the traditional notion of
            %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+groupoids"} Atiyah Lie groupoids
            in traditional
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            is a special case of higher Atiyah groupoids of def.
            = succeed "." do
              %a.maruku-ref{:href => "#HigherAtiyahGroupoid"}
          %p
            To set this up we take the ambient
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            to be
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                %annotation{:encoding => "application/x-tex"} \mathbf{H} \coloneqq
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            and make use of the canonical embeddings
          %p
            %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} \hookrightarrow
            %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} DiffeologicalSpace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} \hookrightarrow
            %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} SmoothSpace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} \hookrightarrow
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          %p and
          %p
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} LieGrpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} \simeq
            %a.existingWikiWord{:href => "/nlab/show/differentiable+stack"} differentiable stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} \hookrightarrow
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          %p which are understood in the following.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+groupoid"} Atiyah Lie groupoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is equivalent to that of def.
              = succeed "." do
                %a.maruku-ref{:href => "#HigherAtiyahGroupoid"}
          .proof
            %h6#proof Proof
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \colon X \to \mathbf{B}G
              for the classifying map of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} P \to X
              = succeed "." do
                %a.maruku-ref{:href => "#ClassificationOfGPrincipalBundles"}
            %p
              By remark
              %a.maruku-ref{:href => "#AtiyahGroupoidIsCechNerve"}
              the higher Atiyah groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi At
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} At(P)
              is simply the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              of this map. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              are all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/truncated+object+in+an+%28infinity%2C1%29-category"} 0-truncated objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              a
              %a.existingWikiWord{:href => "/nlab/show/1-truncated"} 1-truncated
              object, this Cech nerve is
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} 2-coskeletal
              and hence is sufficient to consider the first three degrees. By definition these are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi At
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo (
                      %mi X
                      %munder
                        %mo ×
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mi X
                      %munder
                        %mo ×
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mi X
                      %mover
                        %mover
                          %mo →
                          %mo →
                        %mo →
                      %mi X
                      %munder
                        %mo ×
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mi X
                      %mover
                        %mo →
                        %mo →
                      %mi X
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    At(P)
                    \\simeq
                    \\left(
                    X \underset{\mathbf{B}G}{\times}X \underset{\mathbf{B}G}{\times}X
                    \\stackrel{\to}{\stackrel{\to}{\to}}
                    X \underset{\mathbf{B}G}{\times}X
                    \\stackrel{\to}{\to}
                    X
                    \\right)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %munder
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \underset{\mathbf{B}G}{\times}X
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              with itself, and so forth. To see what this object is, pick any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi X
                    %munder
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
