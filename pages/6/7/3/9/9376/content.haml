                        %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{G}
                  %td{:style => "text-align: left;"}
                    %math#mathml_25bb27a7b2a5a8fcca6d17f6a351b913ce28a816_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔾
                            %mi{:mathvariant => "normal"} conn
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}(\mathbf{B}\mathbb{G}_{\mathrm{conn}})
                  %td{:style => "text-align: left;"}
                    %math#mathml_25bb27a7b2a5a8fcca6d17f6a351b913ce28a816_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi 𝔾
                            %mi conn
                        %annotation{:encoding => "application/x-tex"} \mathbf{B} \mathbb{G}_{conn}
                %tr
                  %td{:style => "text-align: left;"}
                    type of
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connection"} principal ∞-connection
                    without top-degree connection form
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connection"} principal ∞-connection
          %p
            At the same time the definition of higher Atiyah groupoids in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            %a.maruku-ref{:href => "#HigherAtiyahGroupoid"}
            below, is very simple, almost tautological, identifying it as a very fundamental notion in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %h3#InHigherPrequantumGeometryMotivationAndSurvey In higher prequantum geometry: motivation and survey
          %p
            Higher Atiyah groupoids play a central role in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+geometry"} higher prequantum geometry
          %blockquote
            %p under construction
          %h4#OrdinaryPrequantumGeometryInTermsofAutomorphismsInSlices Ordinary prequantum geometry in terms of automorphisms in slices
          %p
            A sequence of time-honored traditional concepts in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            %a.existingWikiWord{:href => "/nlab/show/prequantum+geometry"} prequantum geometry
            is
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/Lie+groups"}> Lie groups
                  \:
                %th
                  %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ↪
                      %annotation{:encoding => "application/x-tex"} \hookrightarrow
                %th
                  %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ↪
                      %annotation{:encoding => "application/x-tex"} \hookrightarrow
                %th
                  %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"}> Lie algebras
                  \:
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Heisenberg+Lie+algebra"} Heisenberg Lie algebra
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ↪
                      %annotation{:encoding => "application/x-tex"} \hookrightarrow
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebra"} Poisson Lie algebra
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ↪
                      %annotation{:encoding => "application/x-tex"} \hookrightarrow
                %td{:style => "text-align: left;"}
                  twisted
                  %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
          %p
            For instance in the
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electrically
            %a.existingWikiWord{:href => "/nlab/show/charged+particle"} charted
            %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            we have a
            %a.existingWikiWord{:href => "/nlab/show/prequantum+circle+bundle"} prequantum circle bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            with
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on a
            %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msup
                    %mi T
                    %mo *
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X = T^* Y
            which is essentially the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of the
            = succeed "-bundle" do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %em
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
            is the group of
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mover
                    %mo →
                    %mo ≃
                  %mi P
                %annotation{:encoding => "application/x-tex"} P \stackrel{\simeq}{\to} P
            of the total space of the prequantum bundle which preserve the connection (also called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/contactomorphism"} contactomorphism
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P,\nabla)
            regarded as a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/regular+contact+manifold"} regular contact manifold
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as a
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            on the
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            (a “
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"}> smooth space
            ”) and then moreover as a
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            on this site (a “
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"}> smooth groupoid
            ”) and make use of the tautological existence of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
            (we don’t need further details right now, but they can be found for instance at
            %em
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            for details). By definition this is such that for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla \colon X \to \mathbf{B}U(1)_{conn}
            is equivalently a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
            and such that a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mo ∇
                    %mn 1
                  %mo →
                  %msub
                    %mo ∇
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \eta \colon \nabla_1 \to \nabla_2
            between two such maps is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            between two such connections. With this formulation a
            %a.existingWikiWord{:href => "/nlab/show/quantomorphism"} quantomorphism
            of the
            %a.existingWikiWord{:href => "/nlab/show/prequantum+bundle"} prequantum bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            is equivalently a diagram of the form as on the right of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi QuantMorph
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %munderover
                              %mo →
                              %mo ≃
                              %mi ϕ
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %msub
                              %mo ⇙
                              %mi η
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{QuantMorph}(\nabla)
                  \=
                  \\left\{
                  \\array{
                  X &amp;&amp;\underoverset{\simeq}{\phi}{\to}&amp;&amp; X
                  \\\
                  \&amp; \searrow &amp;\swArrow_{\eta}&amp; \swarrow
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)_{conn}
                  }
                  \\right\}
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mover
                    %mo →
                    %mo ≃
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi \colon X \stackrel{\simeq}{\to} X
            of the base space of the bundle together with a
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ϕ
                      %mo *
                    %mo ∇
                    %mover
                      %mo →
                      %mo ≃
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \eta \colon \phi^* \nabla \stackrel{\simeq}{\to} \nabla
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
            is naturally an (
            %a.existingWikiWord{:href => "/nlab/show/infinite-dimensional+Lie+group"}> infinite dimensional
            )
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            is the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equipped with the structure of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            itself (notably if it is a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %a.existingWikiWord{:href => "/nlab/show/invariant+differential+form"} invariant vectors
            is the
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+Lie+algebra"} Heisenberg Lie algebra
            and the Lie group corresponding to that is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
          %p
            One also says that a triangular diagram as above is an autoequivalence of the “modulating” map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla \colon X \to \mathbf{B}U(1)_{conn}
            in the
            %em
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice (2,1)-category
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
          %p
            Such autoequivalences in slices are familiar from basic concepts of
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            theory. For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒢
                    %mn 1
                  %mover
                    %mo →
                    %mo →
                  %msub
                    %mi 𝒢
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{G} = (\mathcal{G}_1 \stackrel{\to}{\to} \mathcal{G}_0)
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            being a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi 𝒢
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo →
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} p_\mathcal{G} \colon\mathcal{G}_0 \to \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice (2,1)-category
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
            %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi BiSect
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mi 𝒢
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 0
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi ϕ
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %msub
                              %mo ⇙
                              %mi η
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝒢
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{BiSect}(p_{\mathcal{G}})
                  \=
                  \\left\{
                  \\array{
                  \\mathcal{G}_0 &amp;&amp;\stackrel{\phi}{\to}&amp;&amp; \mathcal{G}_0
                  \\\
                  \&amp; \searrow &amp;\swArrow_\eta &amp; \swarrow
                  \\\
                  \&amp;&amp; \mathcal{G}
                  }
                  \\right\}
                  \\,.
          %p
            This is a
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi 𝒢
                    %mn 0
                  %mover
                    %mo →
                    %mo ≃
                  %msub
                    %mi 𝒢
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \phi \colon \mathcal{G}_0 \stackrel{\simeq}{\to} \mathcal{G}_0
            of the
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            of
