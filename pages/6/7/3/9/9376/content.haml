                    \\stackrel{\simeq}{\to}
                    Grpd(\mathbf{H})
                    \\,.
          %p
            This is a refined version of one of the
            %a.existingWikiWord{:href => "/nlab/show/Giraud-Rezk-Lurie+axioms"} Giraud-Rezk-Lurie axioms
            characterizing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
          .num_remark
            %h6#remark Remark
            %p
              In terms of traditional terminology in the literature on
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/topological+stacks"} topological stacks
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
              etc, this says that a groupoid object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is equivalently an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              which is equipped with an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_0 \to X
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H}
            for the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            (the
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
          #ClassificationOfGPrincipalBundles.num_prop
            %h6#proposition_2 Proposition
            %p
              The operation of forming
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-fibers"} (∞,1)-fibers
              (
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"}> homotopy fibers
              ) constitutes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%E2%88%9E-groupoids"} equivalence of ∞-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fib
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    fib
                    \\;\colon\;
                    \\mathbf{H}(X, \mathbf{B}G)
                    \\to
                    G Bund(X)
                    \\,.
          %p
            This is discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %p Using these two facts we now set:
          #HigherAtiyahGroupoid.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %strong Atiyah groupoid
              is the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi At
                    %mo ∈
                    %mi{:mathvariant => "normal"} Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 1
                        %mi epi
                  %annotation{:encoding => "application/x-tex"} At \in \mathrm{Grpd}(\mathbf{H}) \simeq (\mathbf{H}^{\Delta^1})_{1epi}
              which is the
              %a.existingWikiWord{:href => "/nlab/show/1-image"} 1-image
              projection of the classifying map
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
