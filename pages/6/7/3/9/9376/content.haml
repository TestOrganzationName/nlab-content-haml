                            %mi ω
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X, \flat \mathbf{B}^{n-1}\mathbb{R})
                    \\to
                    \\mathfrak{Poisson}(X,\omega) \to \mathcal{X}_{Ham}(X,\omega)
                    \\stackrel{\iota_{(-)\omega}}{\to}
