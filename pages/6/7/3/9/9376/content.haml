                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔓𝔬𝔦𝔰𝔰𝔬𝔫
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ω
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{Poisson}(X,\omega)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+n-algebra"} Poisson Lie n-algebra
                  as defined in (
                  %a{:href => "#Rogers11"}> Rogers 11
                  ).
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒳
                          %mi Ham
                      %annotation{:encoding => "application/x-tex"} \mathcal{X}_{Ham}
                  is the Lie algebra of
                  %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
                  restricted to the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ♭
                        %mo{:stretchy => "false"} (
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
