            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            is equivalently a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi 𝔾
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}^2\mathbb{G})
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connection"} principal ∞-connection
            “without
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/curving"} curving
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔾
