          %h3#TheTraditionalHeisenbergGroup The traditional Heisenberg group
          %p
            (…)
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
            (…)
          %h3#TheHeisenbergnGroup
            The Heisenberg
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi G
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X = G \in \mathbf{H}
            has itself
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            structure, then it is natural to restrict the
            %a.existingWikiWord{:href => "/nlab/show/quantomorphism+%E2%88%9E-group"} quantomorphism ∞-group
            to that subgroup of the
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+symplectomorphism+%E2%88%9E-group"} Hamiltonian symplectomorphism ∞-group
            whose elements come from the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            on itself. This is the corresponding
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-group"} Heisenberg ∞-group
          .num_defn
            %h6#definition_7 Definition
            %p
              With all assumtions as
              = succeed "," do
                %a{:href => "#TheQuantomorphismNGroups"} above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(\mathbf{H})
              be an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G \hookrightarrow \mathbf{Aut}(G)
            %p
              (where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              of the underlying object
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} G \in \mathbf{H}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              on itself.
            %p
              The the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-group"} Heisenberg ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Heis
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Heis}(\nabla)
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              in the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Heis
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi QuantMorph
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Aut
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{Heis}(\nabla)
                    \&amp;\to&amp;
                    \\mathbf{QuantMorph}(\nabla)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    G &amp;\to&amp; \mathbf{Aut}(G)
                    }
                    \\,.
          %p The following is an immediate consequence of the definition
          #HeisenbergInfinityGroupExtension.num_prop
            %h6#proposition_10 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-group"} Heisenberg ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Heis
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Heis}(\nabla)
              is an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mi 𝔾
                      %mo{:stretchy => "false"} )
                      %mstyle{:mathvariant => "bold"}
                        %mi FlatConn
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Omega \mathbb{G})\mathbf{FlatConn}(G)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi 𝔾
                    %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi FlatConn
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega \mathbb{G})\mathbf{FlatConn}(G)
                    \\to
                    \\mathbf{QuantMorph}(\nabla)
                    \\to
