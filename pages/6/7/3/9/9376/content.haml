                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
              to itself is a constant function along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi FlatConn
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)\mathbf{FlatConn}(G)
              comes from how this may vary in parameterized collections ).
            %p
              Therefore by prop.
              %a.maruku-ref{:href => "#HeisenbergInfinityGroupExtension"}
              we have an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Heis
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}U(1)
                    \\to
                    \\mathbf{Heis}(\nabla)
                    \\to
                    G
                    \\,.
            %p
              This exhibits the Heisenberg 2-group here as the
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
