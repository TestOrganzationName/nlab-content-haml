            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          #EffectiveEpisAreEquivalentlyGroupoids.num_prop
            %h6#proposition Proposition
            %p
              The construction of forming the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              consitutes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              from that of
              %a.existingWikiWord{:href => "/nlab/show/1-epimorphisms"} 1-epimorphisms
              to that of
              %a.existingWikiWord{:href => "/nlab/show/groupoid+objects+in+an+%28%E2%88%9E%2C1%29-category"} groupoid objects
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %msup
