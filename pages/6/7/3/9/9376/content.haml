                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{G} \in \mathrm{Grp}(\mathbf{H})
            a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/sylleptic+%E2%88%9E-group"} sylleptic ∞-group
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
