          %h4#the_central_theorem_quantomorphism_group_extensions
            The central theorem: Quantomorphism
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
              a
              %a.existingWikiWord{:href => "/nlab/show/braided+%E2%88%9E-group"} braided ∞-group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \nabla \colon X \to \mathbf{B}\mathbb{G}_{conn}
              a higher prequantum geometry with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
              there is a long
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi Ω
                      %mi 𝔾
                      %mo )
                    %mstyle{:mathvariant => "bold"}
                      %mi FlatConn
                    %mrow
                      %mo (
                      %mo ∇
                      %mo )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi HamSympl
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo ∇
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mi Ω
                        %mi 𝔾
                        %mo )
                      %mstyle{:mathvariant => "bold"}
                        %mi FlatConn
                      %mrow
                        %mo (
                        %mo ∇
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\Omega \mathbb{G}\right)\mathbf{FlatConn}\left(\nabla\right)
                    \\to
                    \\mathbf{QuantMorph}(\nabla)
                    \\to
                    \\mathbf{HamSympl}(\nabla)
                    \\stackrel{\nabla \circ (-)}{\to}
                    \\mathbf{B}\left(\left(\Omega \mathbb{G}\right)\mathbf{FlatConn}\left(\nabla\right) \right)
                    \\,.
            %p
              Similarly there is the
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+infinity-group"} Heisenberg infinity-group
              extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi 𝔾
                    %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi FlatConn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Heis
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega \mathbb{G})\mathbf{FlatConn}(X)
                    \\to
                    \\mathbf{Heis}(\nabla)
                    \\to
                    G
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
              of the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
