                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} i: S \to (Set/S)^{op}
              is the free category with small products generated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a category with small products. Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi S
                      %mo →
                      %mi Ob
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f: S \to Ob(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \Pi: (Set/S)^{op} \to C
              is defined on the object-level:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %mi N
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} n: N \to S
              is sent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mi s
                  %annotation{:encoding => "application/x-tex"} \prod_{s \in S} f(s)^{n_s}
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi M
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} m: M \to S
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %mi N
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} n: N \to S
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (Set/S)^{op}
              is a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi N
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \phi: N \to M
              that satisfies
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∘
                      %mi ϕ
                      %mo =
                      %mi n
                    %annotation{:encoding => "application/x-tex"} m \circ \phi = n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi s
                    %mo :
                    %msub
                      %mi n
                      %mi s
                    %mo →
                    %msub
                      %mi m
                      %mi s
                  %annotation{:encoding => "application/x-tex"} \phi_s: n_s \to m_s
              indexed by elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} s \in S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi ϕ
                          %mi s
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi m
                          %mi s
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mi s
                  %annotation{:encoding => "application/x-tex"} f(s)^{\phi_s}: f(s)^{m_s} \to f(s)^{n_s}
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mi th
                  %annotation{:encoding => "application/x-tex"} i^{th}
              component of this morphism for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %msub
                      %mi n
                      %mi s
                  %annotation{:encoding => "application/x-tex"} i \in n_s
              to be given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi m
                          %mi s
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi proj
                          %mrow
                            %msub
                              %mi ϕ
                              %mi s
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(s)^{m_s} \stackrel{proj_{\phi_s(i)}}{\to} f(s)
            %p
              Given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi S
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} (Set/S)^{op}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(\phi)
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi ϕ
                          %mi s
                    %msub
                      %mo{:stretchy => "false"} ⟩
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi m
                          %mi s
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mi s
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \Pi(\phi) = \langle f(s)^{\phi_s} \rangle_{s \in S}: \prod_{s \in S}  f(s)^{m_s} \to \prod_{s \in S} f(s)^{n_s}.
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              is the unique product-preserving functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (Set/S)^{op} \to C
              (up to isomorphism) that extends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi S
                      %mo →
                      %mi Ob
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f: S \to Ob(C)
          %p
            Given categories with products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Prod}(C, D)
            denote the category of product-preserving functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F: C \to D
            and natural transformations between them. By the preceding theorem, there is an equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Prod
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi C
                    %mi S
                %annotation{:encoding => "application/x-tex"} \mathbf{Prod}((Set/S)^{op}, C) \simeq C^S
          %p
            where the right side consists of functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} S \to C
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is regarded as a discrete category) and natural transformations between them.
          %p
          .num_cor
            %h6 Corollary
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Prod
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Prod}((Set/S)^{op}, Set)
              is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi S
                    %annotation{:encoding => "application/x-tex"} Set/S
          %p
          .proof
            %h6 Proof
            %p
              Because
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Prod
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi S
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi Set
                        %mi S
                      %mo ≃
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \mathbf{Prod}((Set/S)^{op}, Set) \simeq Set^S \simeq Set/S
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  y \;\colon\; C^{op} \to \mathbf{Prod}(C, Set)
          %p
            As we just saw, the Yoneda embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Prod
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y: Set/S \to \mathbf{Prod}((Set/S)^{op}, Set)
            is an equivalence. We may arrange that the reverse equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Prod
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi S
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mathbf{Prod}((Set/S)^{op}, Set) \to Set/S
            is right adjoint to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi y
                      %mo *
                  %annotation{:encoding => "application/x-tex"} y^*
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a locally small category with small products and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi S
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f: S \to C
              is a functor, the coproduct-preserving functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Π
                      %mi op
                    %mo :
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo →
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \Pi^{op}: Set/S \to C^{op}
              has a right adjoint given by the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mover
                      %mo →
                      %mi y
                    %mstyle{:mathvariant => "bold"}
                      %mi Prod
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Prod
                        %mo{:stretchy => "false"} (
                        %mi Π
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi Prod
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi y
                          %mo *
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} C^{op} \stackrel{y}\to \mathbf{Prod}(C, Set) \stackrel{\mathbf{Prod}(\Pi, Set)}{\to} \mathbf{Prod}((Set/S)^{op}, Set) \stackrel{y^*}{\to} Set/S
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} g: X \to S
              be an object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Set/S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              an object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Π
                              %mi op
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo :
                            %mi X
                            %mo →
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi c
                          %mtd
                          %mtd
                            %mi in
                            %msup
                              %mi C
                              %mi op
                        %mtr
                          %mtd
                            %mi c
                            %mo →
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo :
                            %mi X
                            %mo →
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi in
                            %mi C
                        %mtr
                          %mtd
                            %mi y
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo :
                            %mi X
                            %mo →
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msub
                              %mi hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi Π
                            %mo −
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi in
                            %mstyle{:mathvariant => "bold"}
                              %mi Prod
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi Set
                            %mo{:stretchy => "false"} /
                            %mi S
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi op
                            %mo ,
                            %mi Set
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo :
                            %mi X
                            %mo →
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msup
                              %mi y
                              %mo *
                            %msub
                              %mi hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi Π
                            %mo −
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi in
                            %mi Set
                            %mo{:stretchy => "false"} /
                            %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Pi^{op}(g: X \to S) \to c &amp; &amp; in C^{op}\\
                    c \to \Pi(g: X \to S) &amp; &amp; in C\\
                    y(g: X \to S) \to \hom_C(c, \Pi-) &amp; &amp; in \mathbf{Prod}((Set/S)^{op}, Set)\\
                    (g: X \to S) \to y^* \hom_C(c, \Pi-) &amp; &amp; in Set/S
                    }
            %p where we get to the third line by the Yoneda lemma. This proves the theorem.
          .num_corollary
            %h6#corollary Corollary
            %p
              Under the hypotheses of the previous theorem, the product-preserving functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \Pi: (Set/S)^{op} \to C
              is a right adjoint. In particular, it preserves
              %em all
              limits, not just products.
          %h2#free_productcompletions_of_categories Free product-completions of categories
          %p It will be convenient to consider first the coproduct-cocompletion; then the product-completion is obtained by dualizing.
          %h3#explicit_construction Explicit construction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a small category. We may construct the free category with
            = succeed "products" do
              %em co
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            directly as follows:
          %ul
            %li
              %p
                The objects of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Coprod
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Coprod(C)
                are those of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi C
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} Set/C_0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} C_0
                is the set of objects.
            %li
              %p
                A morphism (say from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} f: X \to C_0
                to
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo :
                        %mi Y
                        %mo →
                        %msub
                          %mi C
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} g: Y \to C_0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \phi: X \to Y
                together with an
                = succeed "-indexed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                of the form
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Φ
                          %mi x
                        %mo :
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Phi_x: f(x) \to g(\phi(x))
          %p The data of a morphism may be exhibited as a 2-cell of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi ϕ
                        %mtd
                          %mi Y
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %msub
                                %mn 1
                                %mi X
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mover
                            %mo ⇒
                            %mi Φ
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mi g
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %munder
                            %mo →
                            %mi f
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp; \stackrel{\phi}{\to} &amp; Y \\
                  \\mathllap{1_X} \downarrow &amp; \stackrel{\Phi}{\Rightarrow} &amp; \downarrow \mathrlap{g} \\
                  X &amp; \underset{f}{\to} &amp; C
                  }
          %p
            Coproducts of objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coprod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Coprod(C)
            are computed just as they are in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Set/C_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} f: X \to C_0
            is then a formal coproduct
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi x
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_x f(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo ,
                  %mi Φ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\phi, \Phi): \sum_{x \in X} f(x) \to \sum_{y \in Y} g(y)
            is uniquely determined by its restrictions along the coprojections
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi x
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi x
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_x: f(x) \to \sum_x f(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Φ
                        %mi x
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi i
                        %mi y
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) \stackrel{\Phi_x}{\to} g(y) \stackrel{i_y)}{\to} \sum_{y \in Y} g(y)
          %p
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y = \phi(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coprod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Coprod(C)
            as coproduct cocompletion is then obvious.
          %h3#as_kleisli_construction As Kleisli construction
          %p
            Another light on this construction comes from seeing the
            %a.existingWikiWord{:href => "/nlab/show/free+coproduct-cocompletion"} free coproduct-cocompletion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coprod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Coprod(C)
            as sitting inside the
            %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{C^{op}}
            (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda mapping
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo ↦
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_0 \to Set^{C^{op}} \;\colon\; c \mapsto \hom(-, c)
          %p
            This induces a coproduct-
            %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserving
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mn 0
                    %mo →
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Set/C_0 \to Set^{C^{op}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi Y
                  %mo →
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} g: Y \to C_0
            to the presheaf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{y \in Y} \hom_C(-, g(y))
          %p By the preceding theorem, this functor has a right adjoint. The right adjoint is simply described: it is the evident underlying functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mo →
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Set^{C^{op}} \to Set/C_0
          %p
            taking a presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F: C^{op} \to Set
            to the
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} c \in C_0
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(c)
          .proof
            %h6#proof_3 Proof
            %p
              As is well-known, this underlying functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                    %mo →
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Set^{C^{op}} \to Set/C_0
              is monadic; the monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi C
                  %annotation{:encoding => "application/x-tex"} M_C
              takes an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} g: Y \to C_0
              to the object whose fiber over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                    %msub
                      %mi hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{y \in Y} \hom_C(c, g(y))
            %p
              In other words, the left adjoint to the underlying functor is the coproduct-preserving functor that takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} g: Y \to C_0
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{y \in Y} \hom(-, g(y))
            %p as described above.
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M_C(g)
            is given by the top horizontal composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi C
                            %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} dom
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} cod
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %munder
                            %mo →
                            %mi g
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                        %mtd
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P &amp; \to &amp; C_1 &amp; \stackrel{\dom}{\to} &amp; C_0 \\
                  \\downarrow &amp; &amp; \downarrow \mathrlap{\cod} &amp; &amp; \\
                  Y &amp; \underset{g}{\to} &amp; C_0 &amp; &amp;
                  }
          %p where the square is a pullback.
          #Kleisli.num_theorem
            %h6#theorem_3 Theorem
            %p
              The free coproduct-cocompletion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the Kleisli category of the monad
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi C
                      %mo :
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi C
                        %mn 0
                      %mo →
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} M_C: Set/C_0 \to Set/C_0
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} f: X \to C_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} g: Y \to C_0
              be two objects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Kl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi M
                        %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Kl(M_C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Kl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Kl(M_C)
              is a morphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M_C(g)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} Set/C_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi X
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} h: X \to P
              making the following diagram commute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mn 1
                                  %mi X
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                            %mi h
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi f
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi C
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} dom
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} cod
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo →
                              %mi g
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp; \stackrel{1_X}{\to} &amp; X &amp; &amp; \\
                    h \downarrow &amp; &amp; &amp; \searrow \mathrlap{f} \\
                    P &amp; \to &amp; C_1 &amp; \stackrel{\dom}{\to} &amp; C_0 \\
                    \\downarrow &amp; &amp; \downarrow \mathrlap{\cod} &amp; &amp; \\
                    Y &amp; \underset{g}{\to} &amp; C_0 &amp; &amp;
                    }
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is the pullback, the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is given by maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \phi: X \to Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Phi: X \to C_1
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi(x): f(x) \to g(\phi(x))
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              was described in the explicit construction of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Coprod
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Coprod(C)
          %h4#Subset
            Example:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Subset
                %annotation{:encoding => "application/x-tex"} Subset
          %p
            We calculate the free coproduct completion of the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{2} = (0 \to 1)
          %p
            According to theorem
            = succeed "," do
              %a.maruku-ref{:href => "#Kleisli"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Set/\{0, 1\}
            corresponding to the monadic functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mn 2
                          %mi op
                    %mo →
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Set^{\mathbf{2}^{op}} \to Set/\{0, 1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_1, X_0)
            to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 0
                    %mo +
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_1, X_0 + X_1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 0
                  %mo +
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_1, X_0 + X_1)
            is the structure of presheaf over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            given by the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mn 0
                    %mo +
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1 \hookrightarrow X_0 + X_1
          %p
            Thus the
            %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            is equivalent to the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Subset
                %annotation{:encoding => "application/x-tex"} Subset
            who objects are pairs of sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, X)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a subset of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, X) \to (B, Y)
            are functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            which carry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            This category has many pleasant properties, largely summarized by the fact that it is a Grothendieck
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
            = succeed "-separated" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg \neg
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            (so that it is a reflective subcategory of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mn 2
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Set^{\mathbf{2}^{op}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            to the pair
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Im(f), Y)
          %p
            In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Subset
                %annotation{:encoding => "application/x-tex"} Subset
            is
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            and
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{\mathbf{2}^{op}}
            (that is, objectwise). As are exponentials, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Subset
                %annotation{:encoding => "application/x-tex"} Subset
            is actually an
            %a.existingWikiWord{:href => "/nlab/show/exponential+ideal"} exponential ideal
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mn 2
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Set^{\mathbf{2}^{op}}
            %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            are formed as they are in the
            %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Subset
                %annotation{:encoding => "application/x-tex"} Subset
            is the coproduct completion; coequalizers are constructed by forming them in the presheaf category and then reflecting back into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Subset
                  %annotation{:encoding => "application/x-tex"} Subset
          %p
            Categories
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Subset
                %annotation{:encoding => "application/x-tex"} Subset
            are also called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M-categories"} M-categories
          %h3#algebraic_theory_of_a_category Algebraic theory of a category
          %p
            The free product-completion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is obtained by dualization:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Coprod
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo =
                  %mi Kl
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} Prod(C) = Coprod(C^{op})^{op} = Kl(M_{C^{op}})^{op}
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %msub
                    %mi M
                    %mrow
                      %msup
                        %mi C
                        %mi op
                %annotation{:encoding => "application/x-tex"} M = M_{C^{op}}
            is the monad on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Set/C_0
            whose algebras are functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} C \to Set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} C_0
            and each morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi c
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} f: c \to d
            is regarded as an unary operation. According to the entry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Kl
                    %mo{:stretchy => "false"} (
                    %mi M
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Kl(M)^{op}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Kl
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} Kl(M)^{op}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi Kl
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi Set
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{Prod}(Kl(M)^{op}, Set) \simeq \mathbf{Prod}(Prod(C), Set) \simeq Set^C
          %p
            by the universal property of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prod
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Prod(C)
          %h3#kz_property KZ property
          %p
            There is no foundational difficulty in forming the free small coproduct-cocompletion of any locally small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (any more than forming the free cocompletion with respect to small limits). An object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coprod
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Coprod(C)
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            together with a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} f: X \to C_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} f: X \to C_0
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi Y
                  %mo →
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} g: Y \to C_0
            consists of a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \phi: X \to Y
            together with an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi x
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_x: f(x) \to g(\phi(x))
          %p To be continued…
          %h2#free_cartesian_category_on_a_signature Free cartesian category on a signature
          %p
            There are a number of ways of explaining the same material from a more categorical point of view. Whatever the explanation is, the point is to describe the free category with finite products generated from a multigraph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Term
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Term(S, F)
          %p
            As before, the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Term
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Term(S, F)
            are product types: elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} T: [m] \to S
            to a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ′
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} T': [n] \to S
            are, in the language of the preceding section,
            = succeed "-tuples" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi t
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (t_1, \ldots, t_n)
            where each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi i
                %annotation{:encoding => "application/x-tex"} t_i
            has arity
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo →
                    %mi T
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \to T'(i)
          %p It is hopefully more or less clear how all of this works in the term syntax approach. Despite this, we believe that the bureaucracy of handling variables in the term syntax is something of a hack; from one point of view (closely related to string diagrams), some of it is actually unnecessary.
          %p
            For example, the input strings play the role of variables declared in the context, but the difference is that they do not need “variable names” – they only need to be labeled by an appropriate sort, for type-checking purposes. This trick effectively eliminates the need for rules of
            = succeed "-conversion." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          %p To begin, recall the following abstract definition:
          .num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a cartesian monad acting on a finitely complete category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                \-span
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is a span of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
