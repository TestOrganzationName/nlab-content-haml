                            %mi M
                            %mi b
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mi m
                                  %mi b
                          %mtd
                            %mi M
                            %mi M
                            %mi b
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi M
                            %mi c
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp; &amp; &amp; &amp; &amp; x \circ y &amp; &amp; &amp; &amp; \\
                    \&amp; &amp; &amp; &amp; &amp; \swarrow &amp; &amp; \searrow &amp; &amp; &amp; \\
                    \&amp; &amp; &amp; &amp; M y &amp; &amp; &amp; &amp; x &amp; &amp; \\
                    \&amp; &amp; &amp; ^\mathllap{M h} \swarrow &amp; &amp; \searrow ^\mathrlap{M k} &amp; &amp; ^\mathllap{f} \swarrow &amp; &amp; \searrow ^\mathrlap{g} &amp; \\
                    M b &amp; \stackrel{m_b}{\leftarrow} &amp; M M b &amp; &amp; &amp; &amp; M c &amp; &amp; &amp; &amp; d
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi M
                    %mi M
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} m: M M \to M
              is the multiplication on the monad
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "-spans" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Span
                    %annotation{:encoding => "application/x-tex"} Span
          %p
            In the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the free monoid monad acting on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "-span" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the same as a multigraph over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            in the bicategory
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                %annotation{:encoding => "application/x-tex"} Span
            is a
            %strong multicategory
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            The free multicategory construction has other names and descriptions. We could also call it the free nonpermutative
            = succeed "-sorted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "-typed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} Set/S
            which takes an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi s
                %annotation{:encoding => "application/x-tex"} X_s
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi s
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi T
                      %mo ∈
                      %msup
                        %mi S
                        %mo *
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo :
                      %mi T
                      %mo →
                      %mi s
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi s
                      %mo ′
                      %mo ∈
                      %mi S
                  %msubsup
                    %mi X
                    %mrow
                      %mi s
                      %mo ′
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi s
                          %mo ′
                %annotation{:encoding => "application/x-tex"} P(X)_s = \sum_{T \in S^\ast} \sum_{f: T \to s} \prod_{s' \in S} X_{s'}^{T_{s'}}
          %p
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} f \in F
            ). However it is named, the underlying multigraph of the free multicategory generated by a multigraph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            can be described as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Tree
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi in
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi out
                        %mtd
                      %mtr
                        %mtd
                          %msup
                            %mi S
                            %mo *
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi S
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; Tree(F) &amp; &amp; \\
                  \&amp; ^\mathllap{in} \swarrow &amp; &amp; \searrow ^\mathrlap{out} &amp; \\
                  S^\ast &amp; &amp; &amp; &amp; S
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tree
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Tree(F)
            is the set of
            = succeed "-labeled" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %ul
            %li
              %p
                Nodes of a planar tree are labeled by elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi T
                      %mo →
                      %mi s
                    %annotation{:encoding => "application/x-tex"} f: T \to s
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
            %li
              %p
                Edges of that planar tree are labeled by sorts
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi T
                      %mo →
                      %mi s
                    %annotation{:encoding => "application/x-tex"} f: T \to s
                is the word
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
          %p
            The list of labels of “leaves” of an
            = succeed "-labeled" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            (edges that are not outgoing edges of any node) gives an element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi in
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} in(t) \in S^\ast
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi out
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} out(t) \in S
            = succeed "-labeled" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            Next, any multicategory generates a (strict monoidal) category. In the present instance, we denote this category as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F)
            (we write “Pro” by analogy with “prop” – whereas props are used for the doctrine of symmetric monoidal categories, pros are used for monoidal categories). The objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F)
            are elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F)
            could be described as “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            \-labeled forests”. Formally, the underlying span of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F)
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo *
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi m
                        %mi S
                  %msup
                    %mi S
                    %mrow
                      %mo *
                      %mo *
                  %mover
                    %mo ←
                    %mrow
                      %msup
                        %mi in
                        %mo *
                  %mi Tree
                  %mo{:stretchy => "false"} (
                  %mi F
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi out
                        %mo *
                  %msup
                    %mi S
                    %mo *
                %annotation{:encoding => "application/x-tex"} S^\ast \stackrel{m_S}{\leftarrow} S^{\ast\ast} \stackrel{in^\ast}{\leftarrow} Tree(F)^\ast \stackrel{out^\ast}{\to} S^\ast
          %p The monoidal product on forests is simply juxtaposition. The composition of forests is the obvious one, plugging in roots of one forest for leaves of another.
          %p
            The construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F)
            formalizes what we meant earlier by “pure substitutions of terms”, and lives in the doctrine of (strict) monoidal categories. To switch over to the doctrine of categories with finite cartesian products, we apply a simple trick. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F) \circ Prod(S)
            be the composite of the two spans
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Prod
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Pro
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ,
                          %mi F
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi dom
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi cod
                        %mtd
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi in
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi out
                        %mtd
                      %mtr
                        %mtd
                          %msup
                            %mi S
                            %mo *
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi S
                            %mo *
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi S
                            %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; Prod(S) &amp; &amp; &amp; &amp; Pro(S, F) &amp; &amp; \\
                  \&amp; ^\mathllap{dom} \swarrow &amp; &amp; \searrow ^\mathrlap{cod} &amp; &amp; ^\mathllap{in} \swarrow &amp; &amp; \searrow ^\mathrlap{out} &amp; \\
                  S^\ast &amp; &amp; &amp; &amp; S^\ast &amp; &amp; &amp; &amp; S^\ast
                  }
          %p
            Then, in the first place,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F) \circ Prod(S)
            carries a canonical category structure. The reason is that, viewing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Prod(S)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F)
            as monads in the bicategory of spans, there is a canonical distributive law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta: Prod(S) \circ Pro(S, F) \to Pro(S, F) \circ Prod(S)
          %p
            (here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(S, F)
            can be replaced by any pro over
            = succeed ")." do
