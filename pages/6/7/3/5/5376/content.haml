                  %annotation{:encoding => "application/x-tex"} (Set/S)^{op}
              together with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi S
