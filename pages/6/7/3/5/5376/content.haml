            %p
              This gives a morphism between underlying spans,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Term
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} Term(S, F) \to C
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Span
                    %annotation{:encoding => "application/x-tex"} Span
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prod
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
