                    %mi c
                    %mover
                      %mo ←
                      %mi f
                    %mi x
                    %mover
                      %mo →
                      %mi g
                    %mi d
                  %annotation{:encoding => "application/x-tex"} M c \stackrel{f}{\leftarrow} x \stackrel{g}{\to} d
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              \-spans are composed by consideration of a pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
