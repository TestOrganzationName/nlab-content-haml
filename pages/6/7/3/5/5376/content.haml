                    \\array{
                    S^\ast &amp; \stackrel{\dom}{\leftarrow} &amp; Prod(S) &amp; \stackrel{\cod}{\to} &amp; S^\ast &amp; \stackrel{in}{\leftarrow} &amp; Pro(S, F) &amp; \stackrel{out}{\to} &amp; S^\ast \\
