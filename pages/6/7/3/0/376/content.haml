              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi y
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi x
                %annotation{:encoding => "application/x-tex"} f^*: C/y \to C/x
            has a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \Pi_f
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            = succeed ".)" do
              %a{:href => "#EquivalentCharacterizations"} below
          %p
            In particular, such pullbacks preserve all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finitely+cocomplete+category"} has finite colimits
