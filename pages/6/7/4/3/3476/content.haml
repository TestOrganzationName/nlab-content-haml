            such that
          %ul
            %li
              %p
                each
                %em node
                of the tree is labeled with an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
