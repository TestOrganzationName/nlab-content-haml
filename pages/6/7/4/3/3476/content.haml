                        %msub
                          %mi A
                          %mi c
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|A_c|}
                outgoing edges, each labeled by some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo{:lspace => "verythinmathspace"} :
