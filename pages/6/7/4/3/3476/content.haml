              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/definitional+equality"} definitional equality
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
              (Exp.
              = succeed ")." do
                %a.maruku-ref{:href => "#NaturalNumbersAsWType"}
            %p
          %h3#WTypesInCategories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi 𝒲
                %annotation{:encoding => "application/x-tex"} \mathcal{W}
            \-types in categories
          %h4#plain_version Plain version
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of
            = succeed "-types," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
            = succeed "." do
              %a{:href => "#MoerdijkPalmgren00"} Moerdijk &amp; Palmgren (2000)
          %p
            Here one describes a
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
            %a.existingWikiWord{:href => "/nlab/show/initial+algebra"} initial
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+an+endofunctor"} algebra for an endofunctor
            on an ambient category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi A
                    %mi c
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                %annotation{:encoding => "application/x-tex"} \{A_c\}_{c\in C}
            can be thought of as a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
          #eq:TheDisplayMap.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mo
                                %mi f
                      %mtr
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A
                  \\\
                  \\big\downarrow\mathrlap{^{f}}
                  \\\
                  C
                  }
          %p
            in some
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            (such that the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c\in C
            is
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi c
                  %annotation{:encoding => "application/x-tex"} A_c
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            in question is the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mover
                    %mo ⟶
                    %mrow
                      %msup
                        %mi A
                        %mo *
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi A
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi Π
                        %mi f
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi C
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi Σ
                        %mi C
                  %mi 𝒞
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{C}
                  \\overset{A^*}{\longrightarrow}
                  \\mathcal{C}_{/A}
                  \\overset{\Pi_f}{\longrightarrow}
                  \\mathcal{C}_{/C}
                  \\overset{\Sigma_C}{\longrightarrow}
                  \\mathcal{C}
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A^*
                denotes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/context+extension"} context extension
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                functor (a.k.a.
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ×
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %annotation{:encoding => "application/x-tex"} A\times -
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \Pi_f
                denotes the interpretation of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                along
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \Sigma_C
                the denotes the interpretation of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                given by the
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi C
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/C}
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p Equivalently, it is the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mover
                    %mo ⟶
                    %mrow
                      %msup
                        %mi C
                        %mo *
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi C
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mo ◯
                        %mi f
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi C
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi Σ
                        %mi C
                  %mi 𝒞
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{C}
                  \\overset{C^*}{\longrightarrow}
                  \\mathcal{C}_{/C}
                  \\overset{\bigcirc_f}{\longrightarrow}
                  \\mathcal{C}_{/C}
                  \\overset{\Sigma_C}{\longrightarrow}
                  \\mathcal{C}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ◯
                    %mi f
                %annotation{:encoding => "application/x-tex"} \bigcirc_f
            is the
            %a.existingWikiWord{:href => "/nlab/show/reader+monad"} reader monad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi f
                    %mo ∘
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Pi_f \circ f^*
          %p
            Such a composite is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/polynomial+endofunctor"} polynomial endofunctor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi c
                        %mo :
                        %mi C
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mi A
                          %mi c
                  %annotation{:encoding => "application/x-tex"} X \mapsto \sum_{c : C} X^{A_c}
          %p
            This definition makes sense in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/transfinite+construction+of+free+algebras"} transfinite construction of free algebras
          %p
            The above definition is most useful when the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is not just
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed
            but is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%CE%A0-pretopos"} Π-pretopos
            %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            in constructing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
            (Exp.
            = succeed ")" do
              %a.maruku-ref{:href => "#NaturalNumbersAsWType"}
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo →
                    %mn 1
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1\to 1+1
            %a.existingWikiWord{:href => "/nlab/show/list+object"} list object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                %annotation{:encoding => "application/x-tex"} L X
            is a
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi X
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} X\to X+1
            %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
            in the traditional sense:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi A
                    %mi n
                  %mo ×
                  %msup
                    %mi Y
                    %mrow
                      %mo ×
                      %mi n
                  %mo +
                  %mi …
                  %mo +
                  %msub
                    %mi A
                    %mn 1
                  %mo ×
                  %mi Y
                  %mo +
                  %msub
                    %mi A
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  F(Y) = A_n \times Y^{\times n}  + \dots + A_1 \times Y  + A_0
          %p
            can be constructed as
            %a.existingWikiWord{:href => "/nlab/show/polynomial+endofunctors"} polynomial endofunctors
            in the above sense for any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lextensive+category"} lextensive category
            = succeed "-pretopos." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
            = succeed "-pretopos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%CE%A0W-pretopos"} ΠW-pretopos
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            with a
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
            (NNO), W-types for any polynomial endofunctor can be constructed as certain sets of well-founded trees; thus every topos with a NNO is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%CE%A0W-pretopos"} ΠW-pretopos
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            (unless one is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicativist
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            is not a topos and W-types in it must be postulated explicitly).
          %h4#DependentWTypesCategoricalSemantics
            Dependent
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
          %p
            The above has a natural generalization to
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent
            or
            %em indexed
            W-types (
            %a{:href => "#GambinoHyland04"}> Gambino &amp; Hyland (2004)
            ) with a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            of
            = succeed ":" do
              %em indices
          %p
            given a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo ⟶
                            %mi f
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi h
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi g
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp;\stackrel{f}{\longrightarrow}&amp; B
                  \\\
                  \\downarrow^{\mathrlap{h}} &amp;&amp; \downarrow^{\mathrlap{g}}
                  \\\
                  C &amp;&amp; C
                  }
          %p
            there is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/dependent+polynomial+functor"} dependent polynomial functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi C
                  %mover
                    %mo ⟶
                    %mrow
                      %msup
                        %mi h
                        %mo *
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi A
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi Π
                        %mi f
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi B
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi Σ
                        %mi g
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{C}_{/C} \overset{h^\ast}{\longrightarrow}
                  \\mathcal{C}_{/A}
                  \\overset{\Pi_f}{\longrightarrow}
                  \\mathcal{C}_{/B}
                  \\overset{\Sigma_g}{\longrightarrow}
                  \\mathcal{C}_{/C}
                  \\,,
          %p
            This reduces to the above for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} C = \ast
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            Notice that we do not necessarily have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi f
                    %mo =
                    %mi h
                  %annotation{:encoding => "application/x-tex"} g f = h
            %a.existingWikiWord{:href => "/nlab/show/polynomial+endofunctor"} polynomial endofunctor
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} /
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathcal{C}/_{C}
            considered as a lccc in its own right. If we
            %em do
            have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi f
                    %mo =
                    %mi h
                  %annotation{:encoding => "application/x-tex"} g f = h
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is called a type of
            %em parameters
            instead of indices.
          %h2#examples Examples
          %p
          #NaturalNumbersAsWType.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
                as a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/W-type"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi 𝒲
                        %annotation{:encoding => "application/x-tex"} \mathcal{W}
                    \-type
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mn 0
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi succ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N},\, 0,\, succ)
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/W-type"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒲
                    %annotation{:encoding => "application/x-tex"} \mathcal{W}
                \-type
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WTypeInferenceRules"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi C
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mi succ
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %mo *
                        %mo ⊔
                        %mo *
                      %annotation{:encoding => "application/x-tex"} C \,\coloneqq\, \{0, succ\} \,\simeq\, \ast \sqcup \ast
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo ∅
                      %annotation{:encoding => "application/x-tex"} A_0 \,\coloneqq\, \varnothing
                  (
                  %a.existingWikiWord{:href => "/nlab/show/empty+type"}> empty type
                  );
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi succ
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo *
                      %annotation{:encoding => "application/x-tex"} A_{succ} \,\coloneqq\, \ast
                  (
                  %a.existingWikiWord{:href => "/nlab/show/unit+type"}> unit type
                  )
            %p
          \&amp;lbrack;
          %a{:href => "#Martin-Löf84"}> Martin-Löf (1984)
          ,
          = succeed "," do
            %a{:href => "/nlab/files/MartinLofIntuitionisticTypeTheory.pdf#page=51"} pp. 45
          = succeed "&rbrack;" do
            %a{:href => "#Dybjer97"} Dybjer (1997, p. 330, 333)
          %h2#Properties Properties
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a{:href => "#Danielsson12"}> Danielsson (2012)
                )
              %br/
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has
              %a.existingWikiWord{:href => "/nlab/show/h-level"} h-level
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n\geq -1
              = succeed "-type" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒲
                    %annotation{:encoding => "application/x-tex"} \mathcal{W}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi 𝒲
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \underset{C}{\mathcal{W}} B
              has h-level
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
