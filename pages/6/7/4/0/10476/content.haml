                    %mi G
                %annotation{:encoding => "application/x-tex"} Orb_G
            for the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Top
                    %mi G
                %annotation{:encoding => "application/x-tex"} Top^G
            on the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/homogeneous+spaces"} homogeneous spaces
            of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
