                        %mrow
                          %mi ℱ
                        %annotation{:encoding => "application/x-tex"} \mathcal{F}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  orbits
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full sub
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              %a.maruku-eqref{:href => "#eq:SimplicialHomComplexBetweenGTopologicalSpaces"} (1)
              on the
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
