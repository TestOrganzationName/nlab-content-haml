            = succeed "," do
              %a{:href => "#Rezk14"} Rezk 14
            %a{:href => "#SatiSchreiber20"} Sati-Schreiber 20
            (for more on this see at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/orbifold+cohomology"} orbifold cohomology
          %p
            More in detail, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
