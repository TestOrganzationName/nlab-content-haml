                    }
            %p
              then it says that got each
              %a.existingWikiWord{:href => "/nlab/show/G-CW+complex"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
