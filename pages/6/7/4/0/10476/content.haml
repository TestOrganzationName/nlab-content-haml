            %p
          %p
          #FProjectiveModelStructureOnGSpaces.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
                \-projective model structure on
                = succeed "-spaces)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %br/
              In the generality of Assumption
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralInputData"}
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"}
                topological
                = succeed "-spaces" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              carries the
              %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
              of a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi kTop
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi ℱ
                        %mi proj
                  %annotation{:encoding => "application/x-tex"} G Act(kTop)_{\mathcal{F} proj}
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complexes"} singular simplicial complexes
                  of
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} mapping spaces
                #eq:SimplicialHomComplexBetweenGTopologicalSpaces.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mi Sing
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi Map
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi G
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi sSet
                      %annotation{:encoding => "application/x-tex"}
                        [X,Y]
                        \\,\coloneqq\,
                        Sing
                        \\big(
                        Map(X,Y)^G
                        \\big)
                        \\;\;\;
                        \\in
                        \\;
                        sSet
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  and
                  %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo →
                          %mi f
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \xrightarrow{f} Y
                  are
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                          %mo ∈
                          %mi ℱ
                        %annotation{:encoding => "application/x-tex"} H \in \mathcal{F}
                  = succeed "-wise" do
                    %a.existingWikiWord{:href => "/nlab/show/fixed+point+space"} fixed point space
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mover
                            %mo →
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mo{:stretchy => "false"} [
                              %mi G
                              %mo{:stretchy => "false"} /
                              %mi H
                              %mo ,
                              %mi f
                              %mo{:stretchy => "false"} ]
                              %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [G/H, X] \xrightarrow{\;[G/H, f]\;} [G/H, Y]
                  = succeed ")" do
                    %a.maruku-ref{:href => "#FixedLociAsEquivariantMappingSpaces"}
                %p
                  those of the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                  include the relative
                  %a.existingWikiWord{:href => "/nlab/show/G-CW+complexes"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                    \-CW complexes
                  which are build (only) from
                  %a.existingWikiWord{:href => "/nlab/show/orbits"} orbits
                  of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi H
                      %annotation{:encoding => "application/x-tex"} G/H
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                          %mspace{:width => "thinmathspace"}
                          %mo ∈
                          %mspace{:width => "thinmathspace"}
                          %mi ℱ
                          %mo ⊂
                          %mi Sub
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} H \,\in\, \mathcal{F} \subset Sub(G)
            %p
          (
          %a{:href => "#DwyerKan84"}> Dwyer &amp; Kan 1984, §1.2 and Thm. 2.2
          )
          %p
          .num_remark
            %h6 Remark
            %p
              %strong
                (relation to classical
                = succeed "-equivariant" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %br/
              In the special case of Assumption
              %a.maruku-ref{:href => "#GeneralInputData"}
              that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℱ
                        %mo ≔
                        %mi ClsSub
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{F} \coloneqq ClsSub(G)
                  is the set of all
                  %a.existingWikiWord{:href => "/nlab/show/closed+topological+space"} closed
                  subgroups
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/G-CW-complex"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                    \-CW complex
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/equivariant+Whitehead+theorem"} equivariant Whitehead theorem
              says that weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow{Y}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi kTop
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi ClsSub
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G Act(kTop)_{ClsSub(G)}
              (from Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FProjectiveModelStructureOnGSpaces"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+map"} equivariant
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            %p
              More generally there may be more weak equivalences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi KTop
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℱ
                  %annotation{:encoding => "application/x-tex"} G Act(KTop)_{\mathcal{F}}
              than there are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Heq
                    %mo ↪
                    %msub
                      %mi W
                      %mi ℱ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G Heq
                    \\hookrightarrow
                    W_{\mathcal{F}}
                    \\,.
            %p
              However, observe that the simplicial hom-complex
              %a.maruku-eqref{:href => "#eq:SimplicialHomComplexBetweenGTopologicalSpaces"} (1)
              is always the classical one, in particular its
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              are always (no matter the choice of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ":" do
