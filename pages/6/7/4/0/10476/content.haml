                    \\,=\,
                    G Heq(X,\,Y)
                    \\,.
            %p
          %p
          #SimplicialPresheavesOnFTypeGOrbits.num_defn
            %h6 Definition
            %p
              %strong
                (simplicial presheaves over
                = succeed "-type" do
