                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi{:mathvariant => "normal"} X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} Y
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi G
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Psh
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Orb
                    %mo{:stretchy => "false"} (
