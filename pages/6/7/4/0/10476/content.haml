            %p
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orbit+category"}
                  category of
                  = succeed "-type" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
