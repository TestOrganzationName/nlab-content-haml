                  %annotation{:encoding => "application/x-tex"} G/H
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            by regarding each
            %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} hom-space
            as its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Top
                    %mrow
                      %msub
                        %mi Orb
                        %mi G
                %annotation{:encoding => "application/x-tex"} Top^{Orb_G}
            for the category of
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Orb
                      %mi G
                      %mi op
                    %mo ⟶
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Orb_G^{op} \longrightarrow Top
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Orb
                    %mi G
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %mspace{:width => "thinmathspace"}
