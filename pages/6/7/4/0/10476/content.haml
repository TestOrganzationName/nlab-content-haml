            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi kTop
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mrow
                        %msub
                          %mo ≃
                          %mpadded{:width => "0"}
                            %mi Qu
                      %munder
                        %mo ⟶
                        %mrow
                          %mi X
                          %mo ↦
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi G
                          %mo{:stretchy => "false"} /
