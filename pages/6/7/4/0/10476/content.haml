                %annotation{:encoding => "application/x-tex"} Top^G
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            which are equipped with a
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            (
            %a.existingWikiWord{:href => "/nlab/show/G-spaces"}> G-spaces
            ). Say that a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
