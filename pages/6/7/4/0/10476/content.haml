            %p
          %h2#statement Statement
          %h3#ClassicalVersionInTopologicalSpaces Classical version in topological spaces
          %p Write
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi kTop
                  %annotation{:encoding => "application/x-tex"} kTop
              for the category of
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
          %p
          #GeneralInputData.num_theorem
            %h6 Assumption
            %p
              %strong (general input data)
              %br/
              Let
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi Grp
                        %mo{:stretchy => "false"} (
                        %mi kTop
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(kTop)
                  be
                  %em any
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
