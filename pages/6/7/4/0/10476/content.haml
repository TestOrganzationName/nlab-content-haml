            %p
          %p
          #FixedLociAsEquivariantMappingSpaces.num_remark
            %h6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
                as
                %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi H
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^H \subset X
              inside
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"}
                topological
                = succeed "-spaces" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant
              %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} mapping space
              out of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
