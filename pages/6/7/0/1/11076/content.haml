            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} f \colon {|X|} \to {|Y|}
            is a
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            between their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+realizations"} topological realizations
