                %annotation{:encoding => "application/x-tex"} {|g|}
            is
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h2#statement Statement
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a simplicial complex, with vertex set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a space whose points may be described as functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \alpha: X_0 \to [0, 1]
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi α
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha^{-1}((0, 1])
            is a simplex of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (in particular, finite) and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi v
                        %mo ∈
                        %msub
                          %mi X
                          %mn 0
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \sum_{v \in X_0} \alpha(v) = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi s
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|s|}
            denote the
            %em closed
            (affine) simplex in the geometric realization
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|X|}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi s
                    %mo{:stretchy => "false"} |
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi α
                  %mo ∈
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %mo :
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mi implies
                  %mspace{:width => "thickmathspace"}
                  %mi v
                  %mo ∈
                  %mi s
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} {|s|} = \{\alpha \in {|X|}: \alpha(v) \gt 0 \; implies \; v \in s\}.
          %p
            This may be identified with a standard affine simplex, and we topologize
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi s
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|s|}
            so that this identification is a homeomorphism.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|X|}
            is then given the coherent topology: the largest topology rendering each inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi s
                    %mo{:stretchy => "false"} |
                  %mo ↪
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|s|} \hookrightarrow {|X|}
            is continuous.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X, Y
            are simplicial complexes, then a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} f: X_0 \to {|Y|}
            can be extended linearly to a continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo :
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \tilde{f}: {|X|} \to {|Y|}
            by the rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi v
                      %mo ∈
                      %msub
                        %mi X
                        %mn 0
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \tilde{f}(\alpha) = \sum_{v \in X_0} \alpha(v)f(v),
          %p
            provided that for every simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(s)
            lie in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Y
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|Y|}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mi j
                  %mo ∘
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} f = j \circ \phi
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %msub
                    %mi Y
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \phi: X_0 \to Y_0
            is a simplicial map and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %msub
                    %mi Y
                    %mn 0
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Y
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} j: Y_0 \to {|Y|}
            is the natural inclusion.
          %p
            We may then define a general
            %em subdivision
            (not necessarily an iterated barycentric
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/subdivision"} subdivision
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to be a simplicial complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ′
                %annotation{:encoding => "application/x-tex"} X'
            such that
          %ul
            %li
              %p
                Vertices of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} X'
                are points of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi X
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {|X|}
            %li
              %p
                For every simplex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} s'
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} X'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ′
                        %mo ⊆
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi s
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} s' \subseteq {|s|}
            %li
              %p
                The linear map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi i
                        %mo{:stretchy => "false"} ˜
                      %mo :
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo ′
                        %mo{:stretchy => "false"} |
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} \tilde{i}: {|X'|} \to {|X|}
                induced from the inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi X
                      %mo ′
                      %mo ↪
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} i: X' \hookrightarrow {|X|}
                is a homeomorphism.
          %p
            Often one treats such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi i
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde{i}
            as an identity map.
          .num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X, Y
              be simplicial complexes, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Y
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} f: {|X|} \to {|Y|}
              be a continuous map. A simplicial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \phi: X \to Y
              is a
              %strong simplicial approximation
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi s
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} f(\alpha) \in {|s|}
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ϕ
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi s
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|\phi|}(\alpha) \in {|s|}
          .num_prop
            %h6#proposition Proposition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \phi: X \to Y
              is a simplicial approximation to a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo{:stretchy => "false"} |
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Y
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} f: {|X|} \to {|Y|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi ϕ
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} f = {|\phi|}
              on a subset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} A \subseteq {|X|}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ϕ
                        %mo{:stretchy => "false"} |
                      %mo ≃
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mi rel
                      %mspace{:width => "thickmathspace"}
                      %mi A
                    %annotation{:encoding => "application/x-tex"} {|\phi|} \simeq f \; rel \; A
          .proof
            %h6#proof Proof
            %p
              Define the homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ϕ
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(\alpha, t) = t f(\alpha) + (1-t){|\phi|}(\alpha)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi s
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} f(\alpha) \in {|s|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi ϕ
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi s
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|\phi|}(\alpha) \in {|s|}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi s
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|s|}
              is closed under convex combinations. Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(\alpha, t) = f(\alpha)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              on a set where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi ϕ
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|\phi|}
              agree.
          .num_theorem
            %h6#theorem Theorem
            %p
              Given simplicial pairs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X, A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y, B)
              and a map of pairs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo{:stretchy => "false"} |
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi A
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Y
                        %mo{:stretchy => "false"} |
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi B
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f: ({|X|}, {|A|}) \to ({|Y|}, {|B|})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ′
                    %mo ,
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                    %mo ,
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi A
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i: (X', A') \hookrightarrow ({|X|}, {|A|})
              and a simplicial approximation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ′
                    %mo ,
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi: (X', A') \to (Y, B)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mover
                        %mi i
                        %mo{:stretchy => "false"} ˜
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi X
                        %mo ′
                        %mo{:stretchy => "false"} |
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi A
                        %mo ′
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Y
                        %mo{:stretchy => "false"} |
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi B
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \circ \tilde{i}: ({|X'|}, {|A'|}) \to ({|Y|}, {|B|})
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, A)
              is a finite simplicial pair, we may choose the subdivision to be an iterated barycentric subdivision
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi sd
                      %mi n
                    %mi X
                    %mo ,
                    %msup
                      %mi sd
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (sd^n X, sd^n A)
              for any sufficiently large
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (given
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
