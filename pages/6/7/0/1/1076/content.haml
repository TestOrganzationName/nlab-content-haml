                    \\,.
            %p
              Observe that the top part is a distinguished triangle by axioms T1 and T2 in def.
              = succeed "." do
                %a.maruku-ref{:href => "#TriangulatedCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
