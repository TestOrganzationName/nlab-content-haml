                    A \overset{f}{\longrightarrow} B \overset{g}{\longrightarrow} B/A \overset{h}{\longrightarrow} \Sigma A
            %p
              the sequences of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            %ol
              %li
                %p (long cofiber sequence)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Σ
                        %mi A
                        %mo ,
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi h
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mo{:stretchy => "false"} [
                        %mi B
