              %li
                %p (long fiber sequence)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi f
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi B
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi g
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} /
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi h
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi Σ
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                      %annotation{:encoding => "application/x-tex"}
                        [X,A]_\ast
                        \\overset{[X,f]_\ast}{\longrightarrow}
                        [X,B]_\ast
                        \\overset{[X,g]_\ast}{\longrightarrow}
                        [X,B/A]_\ast
                        \\overset{[X,h]_\ast}{\longrightarrow}
                        [X,\Sigma A]_\ast
            %p
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences"} long exact sequences
          .proof
            %h6#proof_2 Proof
            %p Regarding the first case:
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g \circ f = 0
              by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#CompositesInADistinguishedTriangleAreZero"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im([g,X]_\ast) \subset ker([f,X]_\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \psi \colon B \to X
              is in the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [f,X]_\ast
              in that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo ∘
                      %mi f
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \psi \circ f = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi \colon C \to X
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∘
                      %mi g
                      %mo =
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \phi \circ g = \psi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} /
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi h
                          %mtd
                            %mi Σ
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ψ
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi id
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A
                    \&amp;\overset{f}{\longrightarrow}&amp;
                    B
                    \&amp;\overset{g}{\longrightarrow}&amp;
                    B/A
                    \&amp;\overset{h}{\longrightarrow}&amp;
                    \\Sigma A
                    \\\
                    \\downarrow &amp;&amp; {}^{\mathllap{\psi}}\downarrow
                    \\\
                    0
                    \&amp;\overset{}{\longrightarrow}&amp;
                    X
                    \&amp;\overset{id}{\longrightarrow}&amp;
                    X
                    \&amp;\overset{}{\longrightarrow}&amp;
                    0
                    }
                    \\,,
            %p where the commutativity of the left square exhibits our assumption.
            %p
              The top part of this diagram is a distinguished triangle by assumption, and the bottom part is by condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} T1
              in def.
              = succeed "." do
                %a.maruku-ref{:href => "#TriangulatedCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              fitting into a commuting diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} /
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi h
                          %mtd
                            %mi Σ
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ψ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϕ
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi id
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A
                    \&amp;\overset{f}{\longrightarrow}&amp;
                    B
                    \&amp;\overset{g}{\longrightarrow}&amp;
                    B/A
                    \&amp;\overset{h}{\longrightarrow}&amp;
                    \\Sigma A
                    \\\
                    \\downarrow &amp;&amp; {}^{\mathllap{\psi}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi}} &amp;&amp; \downarrow
                    \\\
                    0
                    \&amp;\overset{}{\longrightarrow}&amp;
                    X
                    \&amp;\overset{id}{\longrightarrow}&amp;
                    X
                    \&amp;\overset{}{\longrightarrow}&amp;
                    0
                    }
                    \\,.
            %p Here the commutativity of the middle square exhibits the desired conclusion.
            %p
              This shows that the first sequence in question is exact at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi B
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                    %annotation{:encoding => "application/x-tex"} [B,X]_\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi h
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi Σ
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g,h,-\Sigma f)
              provided by T2 yields exactness at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                    %annotation{:encoding => "application/x-tex"} [C,X]_\ast
            %p Regarding the second case:
            %p
              Again, from lemma
              %a.maruku-ref{:href => "#CompositesInADistinguishedTriangleAreZero"}
              it is immediate that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    im([X,f]_\ast) \subset ker([X,g]_\ast)
            %p
              so that we need to show that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \psi \colon X \to B
              in the kernel of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi g
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mo *
                    %annotation{:encoding => "application/x-tex"} [X,g]_\ast
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∘
                      %mi ψ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g\circ \psi = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \phi \colon X \to A
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi ϕ
                      %mo =
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} f \circ \phi = \psi
            %p To that end, consider the commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mn 0
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Σ
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi id
                          %mtd
                            %mi Σ
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ψ
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} /
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi h
                          %mtd
                            %mi Σ
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi Σ
                                %mi f
                          %mtd
                            %mi Σ
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; 0 &amp;\longrightarrow&amp; \Sigma X &amp;\overset{- id}{\longrightarrow}&amp; \Sigma X
                    \\\
                    \\downarrow^{\mathrlap{\psi}} &amp;&amp; \downarrow
                    \\\
                    B
                    \&amp;\overset{g}{\longrightarrow}&amp;
                    B/A
                    \&amp;\overset{h}{\longrightarrow}&amp;
                    \\Sigma A
                    \&amp;\overset{-\Sigma f}{\longrightarrow}&amp;
                    \\Sigma B
                    }
                    \\,,
            %p where the commutativity of the left square exhibits our assumption.
            %p
              Now the top part of this diagram is a distinguished triangle by conditions T1 and T2 in def.
              = succeed "," do
                %a.maruku-ref{:href => "#TriangulatedCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ϕ
                      %mo{:stretchy => "false"} ˜
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mi X
                    %mo →
                    %mi Σ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \tilde \phi \colon \Sigma X \to \Sigma A
              such as to extend to a commuting diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mn 0
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Σ
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi id
                          %mtd
                            %mi Σ
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ψ
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ϕ
                                  %mo{:stretchy => "false"} ˜
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Σ
                                  %mi ψ
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} /
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi h
                          %mtd
                            %mi Σ
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi Σ
                                %mi f
                          %mtd
                            %mi Σ
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; 0 &amp;\longrightarrow&amp; \Sigma X &amp;\overset{- id}{\longrightarrow}&amp; \Sigma X
                    \\\
                    \\downarrow^{\mathrlap{\psi}}
                    \&amp;&amp;
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\tilde \phi}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\Sigma \psi}}
                    \\\
                    B
                    \&amp;\overset{g}{\longrightarrow}&amp;
                    B/A
                    \&amp;\overset{h}{\longrightarrow}&amp;
                    \\Sigma A
                    \&amp;\overset{-\Sigma f}{\longrightarrow}&amp;
                    \\Sigma B
                    }
                    \\,,
            %p
              At this point we appeal to the condition in def.
              %a.maruku-ref{:href => "#TriangulatedCategory"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Ho
                    %mo →
                    %mi Ho
                  %annotation{:encoding => "application/x-tex"} \Sigma \colon Ho \to Ho
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
              implies that there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \phi \colon X \to A
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ϕ
                        %mo{:stretchy => "false"} ˜
                      %mo =
                      %mi Σ
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \tilde \phi = \Sigma \phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              of a commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi id
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ϕ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ψ
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi f
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{-id}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\phi}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\psi}}
                    \\\
                    A &amp;\underset{-f}{\longrightarrow}&amp; B
                    }
                    \\,.
            %p This exhibits the claim to be shown.
          %h3#FromStableModelCategories
            From stable model categories and stable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/pointed+category"} pointed
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
            if the canonically induced
            = succeed "-functor" do
              %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma \;\colon\; Ho(\mathcal{C}) \longrightarrow Ho(\mathcal{C})
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %p
            In this case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Ho(\mathcal{C}),\Sigma)
            is a triangulated category. (
            %a{:href => "#Hovey99"}> Hovey 99, section 7
            , for review see also
            = succeed ")." do
              %a{:href => "#Schwede"} Schwede, section 2
          %p
            Similarly, the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
            of a
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            is a triangulated category, see
            = succeed "." do
              %a{:href => "stable+infinity-category#TheTriangulatedHomotopyCategory"} there
          %h2#examples Examples
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+chain+complexes"} homotopy category of chain complexes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(\mathcal{A})
                in an
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
                (the category of chain complexes modulo
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
                %a.existingWikiWord{:href => "/nlab/show/suspension+of+chain+complexes"} suspension of chain complexes
                and the distinguished triangles are those coming from the
                %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
                construction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                      %mo →
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\to}Y \to Cone(f) \to T X
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
                (the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category+of+spectra"} stable (∞,1)-category of spectra
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parametrized
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+spectra"} equivariant
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                called the
                %a.existingWikiWord{:href => "/nlab/show/Spanier-Whitehead+category"} Spanier-Whitehead category
                is triangulated.
            %li
              %p
                The stable category of a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+exact+category"} Quillen exact category
                is
                %a.existingWikiWord{:href => "/nlab/show/suspended+category"} suspended category
                as exhibited by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Bernhard+Keller"} Bernhard Keller
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+triangulated+category"} algebraic triangulated category
            %li
              %p
                As mentioned before, the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
                of a
                %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
                is a triangulated category. Slightly more generally, this applies also to a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/stable+derivator"} stable derivator
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi N
                    %annotation{:encoding => "application/x-tex"} C/N
                of any triangulated category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                at a
                %a.existingWikiWord{:href => "/nlab/show/null+system"} null system
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ↪
                        %mi C
                      %annotation{:encoding => "application/x-tex"} N \hookrightarrow C
                %a.existingWikiWord{:href => "/nlab/show/calculus+of+fractions"} calculus of fractions
                given by the morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f : X \to Y
                such that there exists distinguished triangles
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                      %mo →
                      %mi Z
                      %mo →
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \to Y \to Z \to T X
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                an object of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/null+system"} null system
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo :
                        %mi C
                        %mo →
                        %mi C
                        %mo{:stretchy => "false"} /
                        %mi N
                      %annotation{:encoding => "application/x-tex"} Q : C \to C/N
              %ul
                %li
                  In particular, therefore, the
                  %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
                  of any
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
                  is a triangulated category, since it is the localization of the homotopy category at the null system of acyclic complexes. This example is also the homotopy category of a stable
                  = succeed "-category," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
                %a.existingWikiWord{:href => "/nlab/show/triangulated+categories+of+sheaves"} triangulated categories of sheaves
                associated to a
                %a.existingWikiWord{:href => "/nlab/show/variety"} variety
                (e.g. bounded derived category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coherent+sheaves"} coherent sheaves
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/perfect+complexes"} perfect complexes
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exact+triangle"}> exact triangle
                ,
                %a.existingWikiWord{:href => "/nlab/show/distinguished+triangle"} distinguished triangle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enhanced+triangulated+category"}> enhanced triangulated category
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pretriangulated+dg-category"} pretriangulated dg-category
                %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/t-structure"}> t-structure
                ,
                %a.existingWikiWord{:href => "/nlab/show/Bridgeland+stability+condition"} Bridgeland stability condition
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/suspended+category"}> suspended category
                ,
                %a.existingWikiWord{:href => "/nlab/show/n-angulated+category"} n-angulated category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bousfield+lattice"}> Bousfield lattice
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/thick+subcategory"} thick subcategory
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exceptional+collection"} exceptional collection
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/well-generated+triangulated+category"}> well-generated triangulated category
                ,
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+triangulated+category"} compactly generated triangulated category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+triangulated+category"} spectrum of a triangulated category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/triangulated+categories+of+sheaves"}> triangulated categories of sheaves
                ,
                %a.existingWikiWord{:href => "/nlab/show/Bondal-Orlov+reconstruction+theorem"} Bondal-Orlov reconstruction theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/triangulated+subcategory"}> triangulated subcategory
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/full+triangulated+subcategory"} full triangulated subcategory
                %a.existingWikiWord{:href => "/nlab/show/periodic+triangulated+category"} periodic triangulated category
          %h2#references References
          %p The concept orignates in the thesis
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Verdier%2C+Jean-Louis"}> Verdier, Jean-Louis
              ,
              = succeed "," do
                %em Des Catégories Dérivées des Catégories Abéliennes
              %strong 239
              (1996) &amp;lbrack;
              %a{:href => "https://smf.emath.fr/publications/des-categories-derivees-des-categories-abeliennes"}> doi:10.24033/ast.364
              ,
              = succeed "," do
                %a{:href => "http://www.numdam.org/issues/AST_1996__239__R1_0"} numdam:AST_1996__239__R1_0
              = succeed "&rbrack;" do
                %a{:href => "http://www.numdam.org/item/AST_1996__239__R1_0.pdf"} pdf
          %p Similar axioms were already given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Albrecht+Dold"}> Albrecht Dold
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dieter+Puppe"} Dieter Puppe
              = succeed "," do
                %em Homologie nicht-additiver Funktoren
              = succeed "." do
                %a{:href => "https://eudml.org/doc/73776"} eudml
          %p Monographs:
          %ul
            %li#GelfandManin96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Gelfand"}> Sergei Gelfand
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"} Yuri Manin
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Methods+of+homological+algebra"} Methods of homological algebra
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-662-12492-5"} doi:10.1007/978-3-662-12492-5
            %li#Neeman01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Amnon+Neeman"}> Amnon Neeman
                ,
                = succeed "," do
                  %em Triangulated Categories
                = succeed "," do
                  %strong 213
                = succeed "," do
                  %a{:href => "https://press.princeton.edu/titles/7102.html"} ISBN:9780691086866
                = succeed "&rbrack;" do
                  %a{:href => "http://www.mi-ras.ru/~akuznet/homalg/Neeman%20Triangulated%20categories.pdf"} pdf
          %p
            Discussion of the relation to
            %a.existingWikiWord{:href => "/nlab/show/stable+model+categories"} stable model categories
            originates in
          %ul
            %li#Hovey99
              %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
              , section 7 of
              %em Model Categories
              Mathematical Surveys and Monographs, Volume 63, AMS (1999) (
              %a{:href => "https://www.math.rochester.edu/people/faculty/doug/otherpapers/hovey-model-cats.pdf"}> pdf
              ,
              = succeed ")" do
                %a{:href => "http://books.google.co.uk/books?id=Kfs4uuiTXN0C&printsec=frontcover"} Google books
          %p Other surveys:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Masaki+Kashiwara"}> Masaki Kashiwara
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Schapira"} Pierre Schapira
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Categories+and+Sheaves"} Categories and Sheaves
                = succeed "," do
                  %strong 332
                = succeed "," do
                  %a{:href => "https://link.springer.com/book/10.1007/3-540-27950-4"} doi:10.1007/3-540-27950-4
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/kashiwara2.pdf"} pdf
            %li#Hubery
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Hubery"}> Andrew Hubery
                \:
                %em Notes on the octahedral axiom
                \&amp;lbrack;
                %a{:href => "https://citeseerx.ist.psu.edu/document?repid=rep1&type=pdf&doi=2246900fb2f9694d965b6b6482f76d4d3c6b1206"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Hubery-OctahedralAxiom.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Masaki+Kashiwara"}> Masaki Kashiwara
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Schapira"} Pierre Schapira
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Categories+and+Sheaves"} Categories and Sheaves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , section 3 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Stable+Infinity-Categories"} Stable Infinity-Categories
            %li#Noohi08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Behrang+Noohi"}> Behrang Noohi
                ,
                = succeed "," do
                  %em Lectures on derived and triangulated categories
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Masoud+Khalkhali"} Masoud Khalkhali
                %a.existingWikiWord{:href => "/nlab/show/Matilde+Marcolli"} Matilde Marcolli
                (eds.),
                = succeed "," do
                  %em An Invitation to Noncommutative Geometry
                %a{:href => "https://doi.org/10.1142/9789812814333_0006"} doi:10.1142/9789812814333_0006
                = succeed ")." do
                  %a{:href => "http://arxiv.org/abs/0704.1009"} arXiv:0704.1009
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fernando+Muro"} Fernando Muro
                (
                %a{:href => "http://personal.us.es/fmuro/htag.pdf"}> pdf
                )
            %li#Schwede
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                %em Triangulated categories
                (
                %a{:href => "https://math.berkeley.edu/~aaron/atf/triangulated-categories.pdf"}> pdf
                )
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory"} Introduction to Stable homotopy theory
                  –
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TriangulatedStructure"} Triangulated structure
          %p
            A survey of formalisms used in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            to present the triangulated
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of a
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"}> Neil Strickland
              ,
              %em Axiomatic stable homotopy - a survey
              (
              %a{:href => "http://front.math.ucdavis.edu/0307.5143"}> arXiv:math.AT/0307143
              )
          %p Discussion of the redundancy in the traditional definition of triangulated category is in
          %ul
            %li#May
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              ,
              = succeed "," do
                %em The additivity of traces in triangulated categories
              = succeed ")" do
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/AddJan01.pdf"} pdf
          %p
            There was also some discussion at the
            = succeed "." do
              %a{:href => "http://nforum.mathforge.org/discussion/3638/triangulated-category"} nForum
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            of triangulated categories:
          %ul
            %li#Krause08
              %a.existingWikiWord{:href => "/nlab/show/Henning+Krause"}> Henning Krause
              ,
              = succeed "," do
                %em Localization theory for triangulated categories
              %em
                %a{:href => "https://www.commalg.org/2006/08/13/workshop-on-triangulated-categories-leeds/"} Workshop on Triangulated Categories, Leeds 2006
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0806.1324"}> arXiv:0806.1324
              \&amp;rbrack;
          .property
            category:
            %a.category_link{:href => "/nlab/all_pages/triangulated+categories"} triangulated categories
