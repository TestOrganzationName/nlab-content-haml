                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo *
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo *
                      %annotation{:encoding => "application/x-tex"}
                        [\Sigma A, X]_\ast
                        \\overset{[h,X]_\ast}{\longrightarrow}
                        [B/A,X]_\ast
                        \\overset{[g,X]_\ast}{\longrightarrow}
                        [B,X]_\ast
                        \\overset{[f,X]_\ast}{\longrightarrow}
