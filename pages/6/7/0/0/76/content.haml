                %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"}> Peter Hilton
                ,
                = succeed "," do
                  %em Subjective History of Homology and Homotopy Theory
                %strong 61
                5 (1988) 282-291
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.2307/2689545"} doi:10.2307/2689545
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %h3#ReferencesTopologicalHomotopyTheory Topological homotopy theory
            %p
              Textbook accounts of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (i.e. via “
              %a.existingWikiWord{:href => "/nlab/show/point-set+topology"}> point-set topology
              ”):
            %ul
              %li#Hilton53
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Peter+J.+Hilton"}> Peter J. Hilton
                  ,
                  = succeed "," do
                    %em An introduction to homotopy theory
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1017/CBO9780511666278"} doi:10.1017/CBO9780511666278
              %li#SzeTsen59
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sze-Tsen+Hu"}> Sze-Tsen Hu
                  ,
                  = succeed "," do
                    %em Homotopy Theory
                  = succeed ")" do
                    %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/hu2.pdf"} pdf
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Robert+E.+Mosher"}> Robert E. Mosher
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Martin+C.+Tangora"} Martin C. Tangora
                  = succeed "," do
                    %em Cohomology operations and applications in homotopy theory
                  %a{:href => "https://store.doverpublications.com/0486466647.html"} Dover 2008
                  %a{:href => "https://www.google.com/books/edition/Cohomology_Operations_and_Applications_i/wu79f-7V_6AC"} GoogleBooks
              %li#Homotopietheorie
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Klaus+Heiner+Kamps"} Klaus Heiner Kamps
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Dieter+Puppe"} Dieter Puppe
                  = succeed "," do
                    %em Homotopietheorie
                  %strong 157
                  Springer 1970 (
                  %a{:href => "https://link.springer.com/book/10.1007/BFb0059721"}> doi:10.1007/BFb0059721
                  )
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Brayton+Gray"}> Brayton Gray
                  ,
                  = succeed "," do
                    %em Homotopy Theory: An Introduction to Algebraic Topology
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "," do
                    %a{:href => "https://www.sciencedirect.com/bookseries/pure-and-applied-mathematics/vol/64/suppl/C"} 978-0-12-296050-5
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/gray.pdf"} pdf
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/George+W.+Whitehead"}> George W. Whitehead
                  ,
                  = succeed "," do
                    %em Elements of Homotopy Theory
                  = succeed ")" do
                    %a{:href => "https://link.springer.com/book/10.1007/978-1-4612-6318-0"} doi:10.1007/978-1-4612-6318-0
