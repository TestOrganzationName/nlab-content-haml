                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\partial_W}}
                    \\\
                    V_{n-2}
                    \&amp;\overset{=}{\longrightarrow}&amp;
                    V_{n-2}
                    \&amp;\overset{f_{n-2}}{\longrightarrow}&amp;
                    W_{n-2}
                    \\\
                    \\\
                    \\downarrow^{\mathrlap{\partial_{V}}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\partial_{V}}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\partial_W}}
                    \\\
                    \\vdots &amp;&amp; \vdots &amp;&amp; \vdots
                    }
            %p
              Moreover, the middle vertical sequence is a chain complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi im
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"} im_{n+1}(f)_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet
              into two chain maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi V
                      %mo •
                    %mo ⟶
                    %msub
                      %mi im
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ⟶
                    %msub
                      %mi W
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_\bullet
                    \\;\colon\;
                    V_\bullet \longrightarrow im_{n+1}(f)_\bullet \longrightarrow W_\bullet
                    \\,.
            %p
              Finally, this is a model for the
              %a.existingWikiWord{:href => "/nlab/show/n-image"} (n+1)-image factorization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in that on
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
              the following holds:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mrow
                            %mo •
                            %mo &lt;
                            %mi n
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %msub
                          %mi H
                          %mrow
                            %mo •
                            %mo &lt;
                            %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi im
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_{\bullet \lt n}(V) \overset{\simeq}{\to} H_{\bullet \lt n}(im_{n+1}(f))
                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi im
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_n(V) \to H_n(im_{n+1}(f)) \hookrightarrow H_n(W)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image factorization
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi H
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} H_n(f)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mrow
                            %mo •
                            %mo &gt;
                            %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi im
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %msub
                          %mi H
                          %mrow
                            %mo •
                            %mo &gt;
                            %mi n
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_{\bullet \gt n}(im_{n+1}(f)) \overset{\simeq}{\to} H_{\bullet \gt n}(W)
                  are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
          .proof
            %h6#proof_2 Proof
            %p This follows by elementary and straightforward direct inspection.
          %h3#in_simplicial_presheaves In simplicial (pre-)sheaves
          %p
            The following gives a sufficient condition for modeling
            %a.existingWikiWord{:href => "/nlab/show/n-image"} n-image
            factorizations in some
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"} (∞,1)-toposes
            with particularly convenient presentation.
          #nImageFactroizationModeledOnSimplicialPrsheaves.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a site with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} loc
                  %annotation{:encoding => "application/x-tex"} sPSh(C)_{\mathrm{loc}}
              are detected on
              %a.existingWikiWord{:href => "/nlab/show/stalks"} stalks
              (
              %a{:href => "model+structure+on+simplicial+presheaves#OverSiteWithEnoughPointsWeakEquivalencesDetectedOnStalks"}> this prop.
              ). Then given a morphism of
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              such that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-types"} homotopy k-types
              for some finite
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/n-image"} n-image
              factorization in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi lwhe
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} L_{lwhe} sPSh(C)_{loc}
              for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              is presented by any factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msub
                      %mi im
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow im_{n}(f) \longrightarrow Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sPSh(C)
              through some Kan-complex valued simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi im
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im_n(f)
              such that for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+groups"} simplicial homotopy groups
              satisfy the following conditions:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mo •
                            %mo &lt;
                            %mi n
                        %mrow
                          %mo (
                          %mi X
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi im
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \pi_{\bullet \lt n}\left(X(U) \to (im_{n}(f))(U)\right)
                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi n
                        %mrow
                          %mo (
                          %mi X
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi im
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi Y
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \pi_n\left(X(U) \to (im_{n}(f))(U)\to Y(U)\right)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/%28epi%2Cmono%29+factorization"} (epi,mono) factorization
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_n(f(U))
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mo •
                            %mo &gt;
                            %mi n
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi im
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi Y
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \pi_{\bullet \gt n}\left((im_{n}(f))(U) \to Y(U)\right)
                  are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
          .proof
            %h6#proof_3 Proof
            %p
              Evalutation on
              %a.existingWikiWord{:href => "/nlab/show/stalks"} stalks
              is a
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              which preserves the
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and
              %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
              that go into the definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+groups"} simplicial homotopy groups
              %a.existingWikiWord{:href => "/nlab/show/categorical+homotopy+groups+in+an+infinity-topos"} categorical homotopy groups
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi lwhe
                      %mi sPSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi loc
                    %annotation{:encoding => "application/x-tex"} L_{lwhe} sPSh(C)_{loc}
              %a{:href => "n-truncated+object+of+an+infinity-category#RecognizngnTuncationOnSimplicialHomotopyGroups"} this prop.
              and
              %a{:href => "n-connected+object+of+an+infinity-topos#Connectedness"} this def.
              we may recognize
              = succeed "-truncation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are
              = succeed "-truncated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
          %h2#properties Properties
          %h3#general General
          %p
            It is known that Postnikov systems classify all weak, pointed
            %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            satisfies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_r(X)=0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo &lt;
                  %mi r
                  %mo &lt;
                  %mi n
                %annotation{:encoding => "application/x-tex"} 1 \lt r \lt n
            then the first non trivial Postnikov invariant is an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} k^{n+1}
            of
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            (with twisted coefficients of course). Such elements are also determined by
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                %annotation{:encoding => "application/x-tex"} \pi_n
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msub
                    %mi π
                    %mi n
                  %mo →
                  %msub
                    %mi C
                    %mi n
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo →
                  %mi ⋯
                  %mo →
                  %msub
                    %mi C
                    %mn 2
                  %mo →
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \to \pi_n \to C_n \to C_{n-1} \to \cdots \to C_2 \to C_1
          %p
            together with an isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 2
                    %mo →
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Coker(C_2 \to C_1) \cong \pi_1
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} type
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            or colimits. The various
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/higher+homotopy+van+Kampen+theorem"} higher homotopy van Kampen theorem
          %p
            A Postnikov system is easiest to understand in the 2-stage case, i.e. two non vanishing homotopy groups, and focuses attention on the cohomology of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Mac+Lane+space"} Eilenberg-Mac Lane space
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+operation"} cohomology operation
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+operation"} Steenrod operation
          %p The reference below shows the problems in the 3-stage systems.
          %p
            For homotopy 3-types, the algebraic model of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/crossed+square"} crossed square
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+operation"} cohomology operation
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h3#for_simplicial_sets_3 For simplicial sets
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{X(n)\}
              the model for its Postnikov tower from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SimplPostnikovByCoskeletonQuotient"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v \in X_0
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(n)
              for the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi b
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    K(n) &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{b}}
                    \\\
                    X(n) &amp;\to&amp; X(n-1)
                    }
                    \\,.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\pi_n (X,v), n)
              be the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
              on the
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K(n) \stackrel{\simeq}{\to} K(\pi_n(X,v),n)
                    \\,.
          %p
            This appears for instance as
            = succeed "." do
              %a{:href => "#GoerssJardine"} GoerssJardine, corollary VI 3.7
          .proof
            %h6#proof_4 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(n) \to K(n-1)
              is a
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              by prop.
              %a.maruku-ref{:href => "#SimplPostnikovByCoskeletonQuotient"}
              the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(n)
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X(n) \to X(n-1)
          %h2#generalizations Generalizations
          %p There are analogues in other setups, e.g.
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Postnikov+system+in+triangulated+category"} Postnikov systems in triangulated categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/motivic+homotopy+theory"} motivic homotopy theory
                (M. Levine,
                = succeed ")." do
                  %a{:href => "http://www.math.uiuc.edu/K-theory/0692"} The Postnikov tower in motivic stable homotopy theory
          %h3#postnikov_tower_in_an_category
            Postnikov tower in an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            We may think of
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            as being the archetypical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          %p
            In every
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            there is a notion of
            %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+in+an+%28%E2%88%9E%2C1%29-category"} n-truncated object
            and accordingly a notion of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower+in+an+%28%E2%88%9E%2C1%29-category"}> Postnikov tower in an (∞,1)-category
              \.
          %p
            The traditional case of Postnikov towers in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is a special case of this more general concept.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tower+of+homotopy+fibers"}> tower of homotopy fibers
                ,
                %a.existingWikiWord{:href => "/nlab/show/Adams+tower"} Adams tower
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/n-image"}> n-image
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/n-epimorphism"} n-epimorphism
                %a.existingWikiWord{:href => "/nlab/show/n-monomorphism"} n-monomorphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Postnikov+invariant"}> Postnikov invariant
                \/
                %a.existingWikiWord{:href => "/nlab/show/k-invariant"} k-invariant
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/k-ary+factorization+system"} k-ary factorization system
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/chromatic+tower"}> chromatic tower
                ,
                %a.existingWikiWord{:href => "/nlab/show/Taylor+tower"} Taylor tower
          %h2#references References
          %p Textbook accounts:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/George+Whitehead"}> George Whitehead
                , Chapter IV:
                = succeed "," do
                  %em Elements of homotopy theory
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-1-4612-6318-0"} doi:10.1007/978-1-4612-6318-0
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                , Section 8 of:
                %em Simplicial methods in algebraic topology
                (
                %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/Simp.djvu"}> djvu
                , 1967)
            %li#GoerssJardine
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"} J. F. Jardine
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
          %p The original articles:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/M.+M.+Postnikov"}> M. M. Postnikov
                ,
                = succeed "," do
                  %em Determination of the homology groups of a space by means of the homotopy invariants
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/M.+M.+Postnikov"}> M. M. Postnikov
                ,
                = succeed "." do
                  %em Issledovaniya po gomotopičeskoĭ teorii nepreryvnyh otobraženiĭ. I. Algebraičeskaya teoriya sistem. II. Naturalʹnaya sistema i gomotopičeskiĭ tip
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %em Investigations in homotopy theory of continuous mappings. I. The algebraic theory of systems. II. The natural system and homotopy type.
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
                Trudy Mat. Inst. Steklov. no. 46. Izdat. Akad. Nauk SSSR, Moscow, 1955. (
                %a{:href => "http://mi.mathnet.ru/eng/tm1182"}> mathnet:tm1182
                )
          %p Early development:
          %ul
            %li
              %p
                Donald W. Kahn,
                = succeed "," do
                  %em The spectral sequence of a Postnikov system
                %a{:href => "http://dx.doi.org/10.1007/BF02564370"} doi
            %li
              %p
                P. I. Booth,
                = succeed "," do
                  %em An explicit classification of three-stage Postnikov towers
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.+J.+Ellis"} G. J. Ellis
                and R. Mikhailov,
                %em A colimit of classifying spaces
                \&amp;lbrack;
                %a{:href => "http://www.arxiv.org/abs/0804.3581"}> arXiv:0804.3581
                \&amp;rbrack;
          %p
            Probably the earliest treatment of Postnikov systems for
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Moore"}> J. C. Moore
              ,
              = succeed "," do
                %em Semisimplicial complexes and Postnikov systems
          %p
            and as a result, in that context, they are sometimes referred to as
            %strong Moore-Postnikov systems
          %p The coskeleton construction for the Postnikov tower of a Kan complex is already in
          %ul
            %li#ArtinMazur
              %a.existingWikiWord{:href => "/nlab/show/M.+Artin"}> M. Artin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/B.+Mazur"} B. Mazur
              = succeed "," do
                %em Étale homotopy
          %p
            Another classical article that amplifies the expression of Postnikov towers in terms of
            %a.existingWikiWord{:href => "/nlab/show/coskeleta"} coskeleta
            is
          %ul
            %li#DwyerKan
              %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dan+Kan"} Dan Kan
              %em An obstruction theory for diagrams of simplicial sets
              (
              %a{:href => "http://www.nd.edu/~wgd/Dvi/ObstructionTheoryForDiagrams.pdf"}> pdf
              ), from 1984.
          %p Analogous remarks are also in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Duskin"} John Duskin
              %em
                Simplicial matrices and the nerves of weak
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              , TAC
              %strong 9
              no. 2, (2002). (
              %a{:href => "http://www.emis.de/journals/TAC/volumes/9/n10/9-10abs.html"}> web
              )
          %p reviewed around page 302 in
          %ul
            %li#Beke
              %a.existingWikiWord{:href => "/nlab/show/Tibor+Beke"}> Tibor Beke
              ,
              = succeed "," do
                %em Higher Čech theory
              = succeed ")" do
                %a{:href => "http://www.math.uiuc.edu/K-theory/0646/"} web
          %p
            Discussion for
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            includes
          %ul
            %li#Schwede12
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              , chapter II, section 8 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"} Symmetric spectra
              = succeed ")" do
                %a{:href => "http://www.math.uni-bonn.de/~schwede/SymSpec-v3.pdf"} pdf
          %p
            Discussion in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
              , section 7.3 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
          %p
            Discussion for
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            modeled by
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/crossed+complexes"} crossed complexes
            %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoids"} strict ∞-groupoids
            is in
          %ul
            %li#BFGM
              M. Bullejos, E. Faro, and M. A. García-Munoz,
              = succeed "," do
                %em Postnikov Invariants of Crossed Complexes
              = succeed ")." do
                %a{:href => "http://arxiv.org/abs/math/0409339"} arXiv:math/0409339
          %p
            and for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/hypergroupoids"} hypergroupoids
            in the thesis,
          %ul
            %li
              M. A. García-Munoz, 2003,
              = succeed "," do
                %em Un aceramiento algebraico a la theoría de Torres de Postnikov
              = succeed "," do
                %a{:href => "https://digibug.ugr.es/handle/10481/1419"} thesis
          %p This also contains a good discussion of the link with twisted cohomology and homotopy colimits.
          %p
            A pedagogical introduction to Postnikov systems with an eye towards their generalization from
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            to
            %a.existingWikiWord{:href => "/nlab/show/n-categories"} n-categories
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lectures+on+n-Categories+and+Cohomology"} Lectures on n-Categories and Cohomology
        .revisedby
          %p
