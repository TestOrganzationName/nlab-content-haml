          %h2#idea Idea
          %p
            An
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-connected object
            is an object all whose
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %em equal to or below
            degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            are trivial.
          %p
            More precisely, an object in an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            is
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} categorical homotopy groups
            equal to or below degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            are trivial.
          %p
            The complementary notion is that of an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28%E2%88%9E%2C1%29-category"} n-truncated object of an (∞,1)-category
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            construction produces
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h2#Definition Definition
          #Connectedness.num_defn
            %h6#definition_2 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-connected
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ≤
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} -1 \leq n \in \mathbb{Z}
              if
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
                  morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} X \to *
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28infinity%2C1%29-category"} effective epimorphism
              %li
                %p
                  all
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} categorical homotopy groups
                  equal to or below degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  are trivial.
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mtext for
                        %mspace{:width => "thickmathspace"}
                        %mi k
                        %mo ≤
                        %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_k(X) = * \;\;\; \text{for} \; k \leq n
                        \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in an
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-connected
              if
            %ol
              %li
                %p
                  it is an
                  %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphism in an (∞,1)-category
              %li
                %p
                  regarded as an object in the
                  %a.existingWikiWord{:href => "/nlab/show/over+quasi-category"} over-(∞,1)-category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Y
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/Y}
                  all
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} categorical homotopy groups
                  equal to or below degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  are trivial.
          %p
            This appears as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, def. 6.5.1.10
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/n-connective+object"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
                \-connective
            = succeed "-simply" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-connected+space"} n-connected space
            for discussion.
          %p One adopts the following convenient terminology.
          %ul
            %li
              %p
                Every object is
                = succeed "-connected." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-2)
            %li
              %p
                A
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-1)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+object"} inhabited object
            %li
              %p
                A 0-connected object is simply called a
                = succeed "." do
                  %strong connected object
          %p
            Notice that
            %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphisms
            are precisely the
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-connected%2Fn-truncated+factorization+system"} n-connected/n-truncated factorization system
          %h2#Properties Properties
          %h3#PropertiesGeneral General
          #ConnectednessViaTruncationComodalness.num_prop
            %h6#proposition Proposition
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.maruku-ref{:href => "#Connectedness"}
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+in+an+%28%E2%88%9E%2C1%29-category"} n-truncation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mi n
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_{\leq n} X
              is
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              (hence precisely if it is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mrow
                          %mo ≤
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \tau_{\leq n}
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/comodal+type"} comodal
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 6.5.1.12
          %p
          .num_lemma
            %h6 Lemma
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+quasi-category"} equivalence
              is
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 6.5.1.16, item 2
          .num_remark
            %h6#remark Remark
            %p
              In a general
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The class of
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %p
              If the pullback of a morphism along an
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
              is
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 6.5.1.16, item 6
          %h3#RecursiveCharacterization Recursive characterization
          #CharacterizationByDiagonal.num_prop
            %h6#proposition_3 Proposition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              is
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28infinity%2C1%29-category"} effective epimorphism
              and the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              morphism into the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_f : X \to X \times_Y X
            %p
              is
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 6.5.1.18
          %h3#factorization_system Factorization system
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi n
                    %mo ≤
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} (-2) \leq n \leq \infty
              the
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              forms the left class in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system+in+an+%28%E2%88%9E%2C1%29-category"} orthogonal factorization system in an (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/n-truncated"} n-truncated
              morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-connected%2Fn-truncated+factorization+system"} n-connected/n-truncated factorization system
          %p
            This appears as a remark in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, Example 5.2.8.16
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentation
            is in (
            %a{:href => "#Rezk"}> Rezk, prop. 8.5
            ).
          %h3#blakersmassey_theorem Blakers-Massey theorem
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Blakers-Massey+theorem"} Blakers-Massey theorem
          %h3#Clock The truncated / connected clock
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
            the
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalences
          %p
            Therefore in such a context we have the following “clock” of notions of
            %a.existingWikiWord{:href => "/nlab/show/truncated+object+in+an+%28infinity%2C1%29-category"} truncated object in an (infinity,1)-category
            \/ connected :
          %ul
            %li
              %p
                any morphism =
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-2)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphism
                \=
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-1)
            %li
              %p
                0-connected, 1-connected, 2-connected,
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"} \cdots
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-connected =
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
                \=
                = succeed "-truncated" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-2)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monomorphism+in+an+%28%E2%88%9E%2C1%29-category"} monomorphism
                \=
                = succeed "-truncated" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-1)
            %li
              %p
                0-truncated, 1-truncated, 2-truncated,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⋯
                    %annotation{:encoding => "application/x-tex"} \cdots
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-truncated = any morphism
          %h2#examples Examples
          %h3#InTop
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
          %p
            In the the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi whe
                %annotation{:encoding => "application/x-tex"} L_{whe}
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            we have that an object is
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/n-connected+topological+space"} n-connected topological space
          %ul
            %li
              %p
                a
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-1)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited space
            %li
              %p
                a
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+space"} path-connected space
            %li
              %p
                a
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+space"} simply connected space
            %li
              %p
                a
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible space
          %p
            More generally, a continuous function represents an
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi whe
                  %mi Top
                %annotation{:encoding => "application/x-tex"} L_{whe} Top
            precisely if it is an
            %a.existingWikiWord{:href => "/nlab/show/n-connected+continuous+function"} n-connected continuous function
            (“
            %a.existingWikiWord{:href => "/nlab/show/n-equivalence"}> n-equivalence
            ”).
          %h3#ExamplesInGrpd
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Grpd
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is 0-connected precisely if it is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+and+full+functor"} essentially surjective and full functor
          .proof
            %h6#proof Proof
            %p
              As discussed there, an
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphism
              in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              between 1-groupoids is precisely an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective functor
            %p
              So it remains to check that for an essentially surjective
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times_Y X
              is given by the groupoid whose objects are triples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ∈
                    %mi X
                    %mo ,
                    %mi α
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1, x_2 \in X, \alpha : f(x_1) \to f(x_2))
              and whose morphisms are corresponding tuples of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              making the evident square in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              commute.
            %p
              By prop.
              %a.maruku-ref{:href => "#CharacterizationByDiagonal"}
              it is sufficient to check that the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to X \times_Y X
              is (-1)-connected, hence, as before, essentially surjective, precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is full.
            %p
              First assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is full. Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (x_1,x_2, \alpha) \in X \times_Y X
              any object, by
              %a.existingWikiWord{:href => "/nlab/show/full+functor"} fullness
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi α
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %msub
                      %mi x
                      %mn 1
                    %mo →
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat \alpha : x_1 \to x_2
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi α
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi α
                    %annotation{:encoding => "application/x-tex"} f(\hat \alpha) = \alpha
            %p
              Accordingly we have a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi α
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi id
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\hat \alpha,id) : (x_1, x_2) \to (x_2, x_2)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times_Y X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi α
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi α
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi id
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f(x_1) &amp;\stackrel{f(\hat \alpha)}{\to}&amp; f(x_2)
                    \\\
                    \\downarrow^{\mathrlap{\alpha}} &amp;&amp; \downarrow^{\mathrlap{id}}
                    \\\
                    f(x_2) &amp;\stackrel{id}{\to}&amp; f(x_2)
                    }
            %p to an object in the diagonal.
            %p
              Conversely, assume that the diagonal is essentially surjective. Then for every pair of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x_1, x_2 \in X
              such that there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha : f(x_1) \to f(x_2)
              we are guaranteed morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 1
                    %mo :
                    %msub
                      %mi x
                      %mn 1
                    %mo →
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h_1 : x_1 \to x_2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 2
                    %mo :
                    %msub
                      %mi x
                      %mn 2
                    %mo →
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h_2 : x_2 \to x_2
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi h
                                  %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
