                        %a.existingWikiWord{:href => "/nlab/show/BBDG+decomposition+theorem"} BBDG decomposition theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/representation+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#InTermsOfSemistandardYoungTableaux"} In terms of semistandard Young tableaux
                %li
                  %a{:href => "#InTermsOfSymnCharacters"}
                    In terms of
                    = succeed "-Characters" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Sym
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Sym(n)
                %li
                  %a{:href => "#schurweyl_duality"} Schur-Weyl duality
              %li
                %a{:href => "#generalizations_via_schur_functors"} Generalizations via Schur functors
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em Schur polynomials
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} s_\lambda
            %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/variables"} variables
            indexed by
            %a.existingWikiWord{:href => "/nlab/show/partitions"} partitions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo =
                  %msub
                    %mi λ
                    %mn 1
                  %mo ≥
                  %msub
                    %mi λ
                    %mn 2
                  %mo ≥
                  %mi …
                  %mo ≥
                  %msub
                    %mi λ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \lambda = \lambda_1 \geq \lambda_2 \geq \ldots \geq \lambda_n
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
            of the
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+polynomials"} symmetric polynomials
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            variables
          %h2#definition Definition
          %p
            Given the
            %a.existingWikiWord{:href => "/nlab/show/partition"} partition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mn 1
                    %mo ≥
                    %msub
                      %mi λ
                      %mn 2
                    %mo ≥
                    %mi …
                    %mo ≥
                    %msub
                      %mi λ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \lambda_1\geq \lambda_2\geq \ldots \geq \lambda_n
            %strong Schur polynomial
            is defined as follows. First define the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n\times n
            %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            (for any partition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            parts)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi α
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi det
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mi x
                    %mi i
                    %mrow
                      %msub
                        %mi α
                        %mi j
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  a_\alpha \;\coloneqq\; det\big(x_i^{\alpha_j}\big).
          %p
            Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mi n
                    %mo −
                    %mn 2
                    %mo ,
                    %mi …
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta=(n-1, n-2, \dots, 1, 0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            is the quotient
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi a
                    %mrow
                      %mi λ
                      %mo +
                      %mi δ
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi a
                    %mi δ
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  s_{\lambda}(x_1,x_2,\dots,x_n)
                  \=
                  a_{\lambda+\delta}/a_{\delta}.
          %p
            As is usual in the theory of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+functions"} symmetric functions
            one can also deal with
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            in infinitely many variables. To make this precise one uses an
            %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
            (see
            = succeed ")" do
              %a{:href => "#Macdonald95"} Macdonald 95
            %strong Schur function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi λ
                %annotation{:encoding => "application/x-tex"} s_{\lambda}
            for each partition, depending on countably many variables
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ,
                    %mi …
                  %annotation{:encoding => "application/x-tex"} x_1, x_2,\dots,x_n,x_{n+1}, \dots
          %h2#properties Properties
          %h3#InTermsOfSemistandardYoungTableaux In terms of semistandard Young tableaux
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"} semistandard Young tableau
            is a
            %a.existingWikiWord{:href => "/nlab/show/Young+tableau"} Young tableau
            such that its values are:
          %ol
            %li
              %p weakly increasing to the right (along rows),
            %li
              %p strictly increasing downwards (along columns).
          %p For example:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 1
                        %mtd
                          %mn 1
                        %mtd
                          %mn 1
                        %mtd
                          %mn 3
                      %mtr
                        %mtd
                          %mn 2
                        %mtd
                          %mn 3
                      %mtr
                        %mtd
                          %mn 4
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  1 &amp; 1 &amp; 1 &amp; 3
                  \\\
                  2 &amp; 3
                  \\\
                  4
                  }
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableau"} semistandard Young tableau
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi T
                %annotation{:encoding => "application/x-tex"} X^T
            for the
            %a.existingWikiWord{:href => "/nlab/show/monomial"} monomial
            which contains one factor of the
            %a.existingWikiWord{:href => "/nlab/show/variable"} variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi k
                %annotation{:encoding => "application/x-tex"} x_k
            for each occurrence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            in the Young tableau:
          #eq:MonomialAssociatedWithSemistandardYoungTableau.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi T
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi x
                    %mn 1
                    %mrow
                      %mo #
                      %mn 1
                      %mi s
                  %msubsup
                    %mi x
                    %mn 1
                    %mrow
                      %mo #
                      %mn 2
                      %mi s
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  x^T
                  \\;\coloneqq\;
                  x_1^{\#1s}
                  x_1^{\#2s}
                  \\cdots
                  \\,.
          %p We write
          #eq:SetOfSemistandardYoungTableaux.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ssYT
                    %mi λ
                  %mspace{:width => "thickmathspace"}
                  %mo ⊃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi ssYY
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  ssYT_\lambda \;\supset\; ssYY_\lambda(N)
          %p
            for the set of semistandard Young tableaux whose underlying
            %a.existingWikiWord{:href => "/nlab/show/partition"} partition
            (i.e. forgetting its labels) is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            on those whose labels are bounded as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo ≤
                    %mi N
                  %annotation{:encoding => "application/x-tex"} T_{i,j} \leq N
          %p
          .num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              a
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} s_\lambda
              is equal to the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              over the
              %a.existingWikiWord{:href => "/nlab/show/monomials"} monomials
              %a.maruku-eqref{:href => "#eq:MonomialAssociatedWithSemistandardYoungTableau"} (1)
              associated with all
              %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableaux"} semistandard Young tableaux
              %a.maruku-eqref{:href => "#eq:SetOfSemistandardYoungTableaux"} (2)
              of shape
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mrow
                          %mi T
                          %mo ∈
                          %mi ssYT
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                        %mo ,
                    %msup
                      %mi x
                      %mi T
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_\lambda
                    \\;\;=\;\;
                    \\underset{
                    {T \in ssYT(\lambda)},
                    }{\sum}
                    x^T
                    \\,.
            %p
          %p
            (
            %a{:href => "#Sagan01"}> Sagan 01, Def. 4.4.1
            , review in
            = succeed ")" do
              %a{:href => "#SaganEnc"} Sagan Enc., p. 1
          %p
            This means that the Schur polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi λ
                %annotation{:encoding => "application/x-tex"} s_\lambda
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            variables is the sum over semistandard Young tableaux
            %a.maruku-eqref{:href => "#eq:SetOfSemistandardYoungTableaux"} (2)
            of shape
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            and with labels bounded as
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo ≤
                    %mi N
                  %annotation{:encoding => "application/x-tex"} T_{i,j} \leq N
          #eq:SchurPolynomialWithFiniteNumberOfvariablesAsSumOverssYT.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi λ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi N
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mrow
                        %mi T
                        %mo ∈
                        %msub
                          %mi ssYT
                          %mi λ
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                      %mo ,
                  %msup
                    %mi x
                    %mi T
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  s_\lambda
                  \\big(
                  x_1, \cdots, x_N
                  \\big)
                  \\;\;=\;\;
                  \\underset{
                  {T \in ssYT_\lambda(N)},
                  }{\sum}
                  x^T
                  \\,.
          %p
            In particular, the evaluation of a Schur polynomial at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            unit values is the number of
            %a.existingWikiWord{:href => "/nlab/show/semistandard+Young+tableaux"} semistandard Young tableaux
            with labels
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \leq N
          #eq:SchurPolynomialCountsNumberOfSemiStandardYoungTableaux.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi λ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi x
                    %mn 1
                  %mspace{:width => "negativethinmathspace"}
                  %mo =
                  %mspace{:width => "negativethinmathspace"}
                  %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi N
                  %mspace{:width => "negativethinmathspace"}
                  %mo =
                  %mspace{:width => "negativethinmathspace"}
                  %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mrow
                        %mi T
                        %mo ∈
                        %msub
                          %mi ssYT
                          %mi λ
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                      %mo ,
                  %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo |
                    %msub
                      %mi ssYT
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo |
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  s_\lambda
                  \\big(
                  x_1\!=\!1, \cdots, x_N \!=\! 1
                  \\big)
                  \\;\;=\;\;
                  \\underset{
                  {T \in ssYT_\lambda(N)},
                  }{\sum}
                  1
                  \\;\;=\;\;
                  \\left\vert
                  ssYT_\lambda(N)
                  \\right\vert
                  \\,.
          %p An immediate consequence is:
          %p
          #CoefficientsOfMonomialsAreNaturalNumbers.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              of any
              %a.existingWikiWord{:href => "/nlab/show/monomial"} monomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi x
                      %mn 1
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %msubsup
                      %mi x
                      %mn 2
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} x_1^{n_1} x_2^{n_2} \cdots
              appearing in a Schur polynomial is non-negative.
          %h3#InTermsOfSymnCharacters
            In terms of
            = succeed "-Characters" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
          %p
            We discuss an expression of the Schur polynomials as
            %a.existingWikiWord{:href => "/nlab/show/symmetric+polynomials"} symmetric polynomials
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in the
            = succeed "-values" do
              %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} character
            %a.maruku-ref{:href => "#FrobeniusFormula"}
            below.
          %p First to set up some notation:
          %p
            For the present purpose, a
            %em
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
            of a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            is a weakly decreasing sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mn 1
                  %mo ≥
                  %msub
                    %mi λ
                    %mn 2
                  %mo ≥
                  %mi ⋯
                  %mo ≥
                  %msub
                    %mi λ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\lambda = (\lambda_1 \geq \lambda_2 \geq \cdots \geq \lambda_k)
          %p
            of
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            whose
            %a.existingWikiWord{:href => "/nlab/show/sum"} sum
            equals
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mn 1
                  %mo +
                  %msub
                    %mi λ
                    %mn 2
                  %mo +
                  %mi ⋯
                  %mo +
                  %msub
                    %mi λ
                    %mi k
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\lambda_1 + \lambda_2 + \cdots + \lambda_k \;=\; n
                  \\,.
          %p
            By the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory+of+the+symmetric+group"} representation theory of the symmetric group
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
            in the form of
            %a.existingWikiWord{:href => "/nlab/show/Specht+modules"} Specht modules
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Specht
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Specht^{(\lambda)}
          #eq:SpechtCharacter.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi χ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Tr
                    %mrow
                      %msup
                        %mi Specht
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\chi^{(\lambda)}(-)
                  \\;\coloneqq\;
                  Tr_{Specht^{(\lambda)}}(-)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/irreducible+character"} irreducible
            %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} character
            corresponding to this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Specht+module"} Specht module
          %p We write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Sym
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ⟶
                            %mi CycLengths
                        %mtd
                          %mi Part
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi Sym
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} /
                            %mi ad
                          %mi Sym
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Sym(n)
                  \&amp;
                  \\overset{CycLengths}{\longrightarrow}
                  \&amp;
                  Part(n)
                  \\\
                  \\big\downarrow &amp; \nearrow_{\mathrlap{\simeq}}
                  \\\
                  Sym(n)/_{ad}Sym(n)
                  }
          %p
            for the function that sends a
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            elements to the
            %a.existingWikiWord{:href => "/nlab/show/partition"} partition
          #eq:CycleLengths.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CycLengths
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi l
                    %mn 1
                  %mo ≥
                  %msub
                    %mi l
                    %mn 2
                  %mo ≥
                  %mi ⋯
                  %mo ≥
                  %msub
                    %mi l
                    %mrow
                      %mo |
                      %mi Cycles
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo |
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CycLengths(\sigma)
                  \\;=\;
                  (l_1 \geq l_2 \geq \cdots \geq l_{\left\vert Cycles(\sigma)\right\vert})
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            given by the lengths of its
            %a.existingWikiWord{:href => "/nlab/show/permutation+cycles"} permutation cycles
            (
            %a{:href => "symmetric+group#ConjugacycClassesOfSymmetricGroupCorrespondToCycleSet"}> this Prop.
            ).
          %p
            Given any such
            %a.existingWikiWord{:href => "/nlab/show/partition"} partition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi l
                      %mn 1
                    %mo ≥
                    %msub
                      %mi l
                      %mn 2
                    %mo ≥
                    %mi ⋯
                    %mo ≥
                    %msub
                      %mi l
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (l_1 \geq l_2 \geq \cdots \geq l_k)
            %a.existingWikiWord{:href => "/nlab/show/symmetric+polynomial"} symmetric polynomial
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/variables"} variables
          #eq:SymmetricFunctionIndecedByPartition.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi l
                        %mn 1
                      %mo ≥
                      %msub
                        %mi l
                        %mn 2
                      %mo ≥
                      %mi ⋯
                      %mo ≥
                      %msub
                        %mi l
                        %mi k
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mi x
                    %mn 1
                    %mrow
                      %msub
                        %mi l
                        %mn 1
                  %mo +
                  %mi ⋯
                  %mo +
                  %msubsup
                    %mi x
                    %mi n
                    %mrow
                      %msub
                        %mi l
                        %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⋅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mi x
                    %mn 1
                    %mrow
                      %msub
                        %mi l
                        %mn 2
                  %mo +
                  %mi ⋯
                  %mo +
                  %msubsup
                    %mi x
                    %mi n
                    %mrow
                      %msub
                        %mi l
                        %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mi ⋯
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mi x
                    %mn 1
                    %mrow
                      %msub
                        %mi l
                        %mi k
                  %mo +
                  %mi ⋯
                  %mo +
                  %msubsup
                    %mi x
                    %mi n
                    %mrow
                      %msub
                        %mi l
                        %mi k
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  p_{
                  (l_1 \geq l_2 \geq \cdots \geq l_k)
                  }
                  (x_1, x_2, \cdots, x_n)
                  \\;\;\;\coloneqq\;\;\;
                  \\big(
                  x_1^{l_1} + \cdots + x_n^{l_1}
                  \\big)
                  \\cdot
                  \\big(
                  x_1^{l_2} + \cdots + x_n^{l_2}
                  \\big)
                  \\cdots
                  \\big(
                  x_1^{l_k} + \cdots + x_n^{l_k}
                  \\big)
                  \\,.
          %p
          #FrobeniusFormula.num_prop
            %h6 Proposition
            %p
              %strong (Frobenius formula)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              a
              %a.existingWikiWord{:href => "/nlab/show/partition"} partition
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} s_\lambda
              is equal to the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              over
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              of the character values
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi χ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi^{(\lambda)}
              %a.maruku-eqref{:href => "#eq:SpechtCharacter"} (5)
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              times the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+polynomial"} symmetric polynomial
              %a.maruku-eqref{:href => "#eq:SymmetricFunctionIndecedByPartition"} (7)
              which is indexed by the cycle lengths
              %a.maruku-eqref{:href => "#eq:CycleLengths"} (6)
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo !
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi σ
                        %mo ∈
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi χ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi p
                      %mrow
                        %mi CycLengths
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_\lambda
                    \\;=\;
                    \\frac{1}{n!}
                    \\underset
                    {\sigma \in Sym(n)}
                    {\sum}
                    \\chi^{(\lambda)}(\sigma)
                    \\cdot
                    p_{CycLengths(\sigma)}
                    \\,.
            %p
          %p
            (
            %a{:href => "#Sagan01"}> Sagan 01, Thm. 4.6.4
            , review in
            = succeed ")" do
              %a{:href => "#SaganEnc"} Sagan Enc., Thm. 3
          %p
            %br/
          %h3#schurweyl_duality Schur-Weyl duality
          %p
            The Schur polynomials are precisely the
            %a.existingWikiWord{:href => "/nlab/show/irreducible+characters"} irreducible characters
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
            polynomial
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} representations
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} GL(n)
          %p
            Also, the character
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi λ
                %annotation{:encoding => "application/x-tex"} \chi_{\lambda}
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} V_\lambda
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi k
                %annotation{:encoding => "application/x-tex"} S_k
            attached to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            the size
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi λ
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |\lambda|
            of the partition) maps to the Schur polynomial under the character map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ch
                %annotation{:encoding => "application/x-tex"} ch
            from virtual characters to symmetric polynomials.
          %p
            This correspondence between
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            of the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
            and the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+groups"} general linear groups
            is called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Schur-Weyl+duality"} Schur-Weyl duality
          %h2#generalizations_via_schur_functors Generalizations via Schur functors
          %p
            %a.existingWikiWord{:href => "/nlab/show/Schur+functors"} Schur functors
            may be viewed as a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of Schur functions. In fact, the Schur functors make sense in more general
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
            than
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/VectorSpaces"} VectorSpaces
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            of
          %p
            a Schur functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi S
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{S}_\lambda(V)\stackrel{\mathbf{S}_\lambda(g)}\to \mathbf{S}_\lambda(V)
            on an endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g\in GL(V)
            is the Schur function of the eigenvalues of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Schur+positivity"} Schur positivity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/representation+theory+of+the+symmetric+group"} representation theory of the symmetric group
          %p Generalizations:
          %ul
            %li
