              %a{:href => "http://www-math.mit.edu/~rstan/pubs/pubfiles/12-1.pdf"}> pdf
              ,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/StanleyPlanePartitions1.pdf", :title => ""} StanleyPlanePartitions1.pdf
          %p Textbook accounts:
