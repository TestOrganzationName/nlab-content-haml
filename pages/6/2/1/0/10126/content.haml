            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            a map of suitable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            %a.existingWikiWord{:href => "/nlab/show/Umkehr+map"} Umkehr map
            for the induced map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo •
