          %h2#definition Definition
          %h3#abstract_duality_and_atiyahmilnorspanier_duality__pontryaginthom_collapse Abstract duality and Atiyah-Milnor-Spanier duality + Pontryagin-Thom collapse
          #SpanierDualityOperation.num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∨
                    %mo ∘
                    %msubsup
                      %mi Σ
                      %mo +
                      %mn ∞
                    %mo ≔
                    %msub
                      %mi L
                      %mi whe
                    %mi Top
                    %mo →
                    %mi 𝕊
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    D \coloneqq (-)^\vee\circ \Sigma^\infty_+ \coloneqq L_{whe} Top \to \mathbb{S}Mod
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/Spanier-Whitehead+duality"} Spanier-Whitehead duality
              map which sends a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              first to its
              %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
              and then that to its
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+spectra"} (∞,1)-category of spectra
          %p
            (
            %a{:href => "#ABG11"}> ABG 11, def 10.3
            ).
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+manifold"} compact manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \to \mathbb{R}^n
              be an
              %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mi ν
                          %mi n
                  %annotation{:encoding => "application/x-tex"} S^n \to X^{\nu_n}
              for the classical
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin-Thom+collapse+map"} Pontryagin-Thom collapse map
              for this situation, and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi T
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S} \to X^{-T X}
            %p
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/looping"} looping
              map from the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              to the
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              of the negative
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/Atiyah+duality"} Atiyah duality
              produces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi T
                        %mi X
                    %mo ≃
                    %mi D
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X^{- T X} \simeq D X
            %p
              which identifies the
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              with the
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mo +
                      %mn ∞
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_+ X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \mathbb{S} Mod
              and this constitutes a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi T
                                %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi 𝕊
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mi D
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo →
                                %mo *
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi D
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X^{- T X}
                    \\\
                    \&amp; \nearrow &amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\mathbb{S}
                    \&amp;\underset{D(X \to \ast)}{\to}&amp;
                    D X
                    }
            %p
              identifying the classical
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin-Thom+collapse+map"} Pontryagin-Thom collapse map
              with the abstract
              %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
              construction of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SpanierDualityOperation"}
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} W \hookrightarrow X
              an
              %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
              %a.existingWikiWord{:href => "/nlab/show/Atiyah+duality"} Atiyah duality
              identifies the
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin-Thom+collapse+maps"} Pontryagin-Thom collapse maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi T
                        %mi X
                    %mo →
                    %msup
                      %mi W
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi T
                        %mi W
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S} \to X^{-T X} \to W^{- T W}
            %p
              with the abstract
              %a.existingWikiWord{:href => "/nlab/show/dual+morphisms"} dual morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo →
                    %mi D
                    %mi X
                    %mo →
                    %mi D
                    %mi W
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S} \to D X \to D W
                    \\,.
          %p
            (
            %a{:href => "#ABG11"}> ABG 11, prop. 10.5
            ).
          %h3#umkehr_map Umkehr map
          .num_remark
            %h6#remark Remark
            %p
              Given now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %msub
                      %mi CRing
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E \in CRing_\infty
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo →
                    %mi D
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{S} \to D X
              induces under
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              a similar Pontryagin-Thom collapse map, but now not in
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-modules"} (∞,1)-modules
              but in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-modules"} (∞,1)-modules
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi D
                    %mi X
                    %msub
                      %mo ⊗
                      %mi 𝕊
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \to D X \otimes_{\mathbb{S}} E
                    \\,.
            %p
              The image of this under the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} cohomology
              functor produces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mi X
                    %msub
                      %mo ⊗
                      %mi 𝕊
                    %mi E
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [D X \otimes_{\mathbb{S}} E, E] \to E
                    \\,.
            %p
              If now one has a
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              \-
              %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"}> orientation
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mi X
                    %msub
                      %mo ⊗
                      %mi 𝕊
                    %mi E
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [D X \otimes_{\mathbb{S}} E, E] \simeq [X,E]
              that identifies the cohomology of the dual object with the original cohomology, then together with the above this produces the
              %a.existingWikiWord{:href => "/nlab/show/Umkehr+map"} Umkehr map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mi X
                    %msub
                      %mo ⊗
                      %mi 𝕊
                    %mi E
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    [X,E] \simeq [D X \otimes_{\mathbb{S}} E, E] \to E
            %p
              that pushes the
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to \ast
              we start with a more general map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to Y
            %p
              More generally a
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
              may not exists, but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mi X
                    %msub
                      %mo ⊗
                      %mi 𝕊
                    %mi E
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [D X \otimes_{\mathbb{S}} E, E]
              may still be equivalent to a
              = succeed "-variant" do
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi χ
                  %annotation{:encoding => "application/x-tex"} [X,E]_{\chi}
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi E
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [X,E]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi Γ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi χ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi E
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Gamma_X(\chi),E]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi E
                    %mi Line
                    %mo ↪
                    %mi E
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \chi \colon \Pi(X) \to E Line \hookrightarrow E Mod
              is an (
              %a.existingWikiWord{:href => "/nlab/show/flat+%28%E2%88%9E%2C1%29-bundle"}> flat
              )
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ≃
                    %munder
                      %mi lim
                      %mo →
                  %annotation{:encoding => "application/x-tex"} \Gamma \simeq \underset{\to}{\lim}
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              (the
              %a.existingWikiWord{:href => "/nlab/show/generalized+Thom+spectrum"} generalized Thom spectrum
              construction). In this case the above yields a
              = succeed "." do
                %strong twisted Umkehr map
          %p
            (
            %a{:href => "#ABG10"}> ABG 10, 9.1
            )
          %h2#examples Examples
          %ul
            %li
              %p
                %span.newWikiWord
                  fiber integration in ordinary cohomology
                  %a{:href => "/nlab/new/fiber+integration+in+ordinary+cohomology"} ?
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+K-theory"} fiber integration in K-theory
              %p
                For a detailed discussion of an example in
                %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
                see also at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebra"} Poincaré duality algebra
                and at
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+differential+K-theory"} fiber integration in differential K-theory
          %h2#related_concepts Related concepts
          %div
            %p The following terms all refer to essentially the same concept:
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+generalized+cohomology"} fiber integration in generalized cohomology
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"} push-forward in generalized cohomology
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Umkehr+map"}> Umkehr map
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/twisted+Umkehr+map"} twisted Umkehr map
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Gysin+map"} Gysin map
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+collapse+map"} Pontrjagin-Thom collapse map
          %h2#references References
          %p
            Twisted Umkehr maps in
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            are discussed (somewhat implicitly sometimes) in the literature on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebra"} Poincaré duality algebra
          %p
            The general abstract formulation in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            is sketched in section 9 of
          %ul#ABG10
            %li#ABG10
              %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"} Andrew Blumberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
              = succeed "," do
                %em Twists of K-theory and TMF
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
              = succeed "," do
                %em
                  Superstrings, Geometry, Topology, and
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^*
              = succeed "," do
                %a{:href => "http://www.ams.org/bookstore-getitem/item=PSPUM-81"} vol 81
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1002.3004"} arXiv:1002.3004
          %p and in section 10 of
          %ul
            %li#ABG11
              %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"} Andrew Blumberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
              = succeed "," do
                %em Parametrized spectra, multiplicative Thom spectra, and the twisted Umkehr map
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1112.2203"} arXiv:1112.2203
              = succeed ")" do
                %a{:href => "https://doi.org/10.2140/gt.2018.22.3761"} doi:10.2140/gt.2018.22.3761
          %p
            A review and applications to
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            is in
          %ul
            %li#Nuiten13
              %a.existingWikiWord{:href => "/nlab/show/Joost+Nuiten"}> Joost Nuiten
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/master+thesis+Nuiten"} Cohomological quantization of local prequantum boundary field theory
          %p
            Formalization in
            %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent linear type theory
            is discussed
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Quantization+via+Linear+homotopy+types"} Quantization via Linear homotopy types
        .revisedby
