          %h2#definition Definition
          %p
            The
            %strong singular cohomology
            (also
            = succeed ")" do
              %strong Betti cohomology
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            of its
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℬ
                    %mi n
                  %mi ℤ
                  %mo ∈
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathcal{B}^n \mathbb{Z} \in \infty Grpd
            the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
            with the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            in degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-singular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi ℬ
                    %mi n
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n(X,\mathbb{Z}) := \pi_0 \infty Grpd(\Pi(X), \mathcal{B}^n \mathbb{Z})
                  \\,.
          %p
            With
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \infty Grpd
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by the category
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            is modeled by the
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Sing
                  %mi X
                  %mo =
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Δ
                    %mi Top
                    %mo •
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(X) = Sing X = Hom_{Top}(\Delta^\bullet_{Top}, X)
                  \\,,
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℬ
                    %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}^n \mathbb{Z}
            is usefully modeled by the simplicial set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℬ
                    %mi n
                  %mi ℤ
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi Ξ
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{B}^n \mathbb{Z} = U (\Xi \mathbb{Z}[n])
          %p which is
          %ul
            %li
              %p
                the underlying simplicial set under the
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ⊣
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mi sAb
                      %mover
                        %munder
                          %mo →
                          %mi U
                        %mover
                          %mo ←
                          %mi F
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"}
                      (F \dashv U)
                      sAb \stackrel{\overset{F}{\leftarrow}}{\underset{U}{\to}}
                      sSet
              %p
                from abelian
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %li
              %p
                of the abelian
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ξ
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Xi \mathbb{Z}[n]
                which is the image under the
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sAb
                      %mover
                        %munder
                          %mo →
                          %mrow
                        %mover
                          %mo ←
                          %mi Ξ
                      %msup
                        %mi Ch
                        %mo +
                    %annotation{:encoding => "application/x-tex"}
                      sAb \stackrel{\overset{\Xi}{\leftarrow}}{\underset{}{\to}}
                      Ch^+
            %li
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi ⋯
                      %mo →
                      %mi ℤ
                      %mo →
                      %mn 0
                      %mo →
                      %mn 0
                      %mo →
                      %mi ⋯
                      %mo →
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}[n] =
                      (\cdots \to \mathbb{Z} \to 0 \to 0 \to \cdots \to 0)
              %p
                concentrated in degree
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p So in this model we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mi sSet
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi Ξ
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n(X,\mathbb{Z}) = \pi_0 sSet(Sing X, U(\Xi \mathbb{Z}[n]))
                  \\,.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in this cohomology theory is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cochain+on+a+simplicial+set"} cochain on a simplicial set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Sing X
          %p
            Using the
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊣
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (F \dashv U)
            this is
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo ≃
                  %msub
                    %mi π
                    %mn 0
                  %mi sAb
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ch
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Ξ
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\cdots \simeq \pi_0 sAb( Ch_n(X), \Xi \mathbb{Z}[n] )
                  \\,,
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi Sing
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  F(Sing X) = \mathbb{Z}[Sing X]
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
            abelian simplicial group on the simplicial set
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Sing X
            %strong singular chains
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta^n_{Top} \to X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo ≃
                  %msub
                    %mi π
                    %mn 0
                  %mi sAb
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi Sing
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi Ξ
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots \simeq \pi_0 sAb( \mathbb{Z}[Sing X], \Xi \mathbb{Z}[n] )
                  \\,.
          %p
            Using next the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan adjunction
            this is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo ≃
                  %msub
                    %mi H
                    %mn 0
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\cdots \simeq H_0 Ch( Ch_\bullet(X), \mathbb{Z}[n] )
                  \\,,
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mi N
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Ch_\bullet(X) := N^\bullet(\mathbb{Z}(Sing X))
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
            of normalized chains of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Sing
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[Sing X]
            = succeed "," do
              %strong singular chains
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            of simplices in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            This way singular cohomology is the abelian dual of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
          %p …
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cochain+on+a+simplicial+set"} cochain on a simplicial set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
          %h2#comparison_to_sheaf_cohomology Comparison to sheaf cohomology
          %p
            If the topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is semi-locally contractible (meaning: any open subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U\subset X
            has an open cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            by open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi i
                  %mo ⊂
                  %mi U
                %annotation{:encoding => "application/x-tex"} W_i\subset U
            that are contractible in 
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            ), then the
            %a.existingWikiWord{:href => "/nlab/show/sheaf+cohomology"} sheaf cohomology
            of 
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is isomorphic to the singular cohomology of 
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            for any abelian group of coefficients.
          %p
            This was proved in (
            %a{:href => "#Sella16"}> Sella 16
            ).
          %h2#discussion Discussion
          %p
            A previous version of this entry led to the following discussion, which later led to extensive discussion by email. Partly as a result of this and similar discussions, there is now more information on how Kan complexes
            %em are
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"}> ∞-groupoid
                \.
          %h2#references References
          %div
            %h3#early_references_on_cohomology Early references on (co)homology
            %p
              The original references on
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              and
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              in the form of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cellular+cohomology"} cellular cohomology
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Andrei+Kolmogoroff"}> Andrei Kolmogoroff
                ,
                = succeed "," do
                  %em Über die Dualität im Aufbau der kombinatorischen Topologie
                = succeed ")" do
                  %a{:href => "http://mi.mathnet.ru/msb5361"} mathnet
            %p
              A footnote on the first page reads as follows, giving attribution to
              = succeed "," do
                %a{:href => "#Alexander35a"} Alexander 35a
              = succeed ":" do
                %a{:href => "#Alexander35a"} 35b
            %blockquote
              %p
                Die Resultate dieser Arbeit wurden für den Fall gewöhnlicher Komplexe vom Verfasser im Frühling und im Sommer 1934 erhalten und teilweise an der Internationalen Konferenz für Tensoranalysis (Moskau) im Mai 1934 vorgetragen. Die hier dargestellte allgemeinere Theorie bildete den Gegenstand eines Vortrages, den der Verfasser an der Internationalen Topologischen Konferenz (Moskau, September 1935) hielt; bei letzterer Gelegenheit erfuhr er, dass ein grosser Teil dieser Resultate im Falle von Komplexen indessen von Herrn Alexander erhalten worden ist. Vgl. die inzwischen erschienenen Noten von Herrn
                %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"} Alexander
                in den «Proceedings of the National Academy of Sciences U.S.A.», 21, (1935), 509—512. Herr Alexander trug über seine Resultate ebenfalls an der Moskauer Topologischen Konferenz vor. Verallgemeinerungen für abgeschlossene Mengen und die Konstruktion eines Homologieringes für Komplexe und abgeschlossene Mengen, über welche der Verfasser ebenso an der Tensorkonferenz 1934 vorgetragen hat, werden in einer weiteren Publikation dargestellt. Diese weitere Begriffsbildungen sind übrigens ebenfalls von Herrn Alexander gefunden und teilweise in den erwähnten Noten publiziert.
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Andrei+Kolmogoroff"}> Andrei Kolmogoroff
                  ,
                  = succeed "," do
                    %em Homologiering des Komplexes und des lokal-bicompakten Raumes
                  = succeed "." do
                    %a{:href => "http://mi.mathnet.ru/msb5475"} mathnet
              %li#Alexander35a
                %p
                  %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                  ,
                  = succeed "," do
                    %em On the chains of a complex and their duals
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1073/pnas.21.8.50"} doi:10.1073/pnas.21.8.50
              %li#Alexander35b
                %p
                  %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                  ,
                  = succeed "," do
                    %em On the ring of a compact metric space
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1073/pnas.21.8.511"} doi:10.1073/pnas.21.8.511
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                  ,
                  = succeed "," do
                    %em On the connectivity ring of an abstract space
                  = succeed "," do
                    %a{:href => "https://doi.org/10.2307/1968484"} doi:10.2307/1968484
                  = succeed ")" do
                    %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/alexcon.pdf"} pdf
            %p
              The term “cohomology” was introduced by
              %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"} Hassler Whitney
              in
            %ul
              %li#Whitney37
                %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"}> Hassler Whitney
                ,
                = succeed "." do
                  %em On matrices of integers and combinatorial topology
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/journals/duke-mathematical-journal/volume-3/issue-1/On-matrices-of-integers-and-combinatorial-topology/10.1215/S0012-7094-37-00304-1.short"} doi:10.1215/S0012-7094-37-00304-1
            %p See also
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"}> Hassler Whitney
                ,
                = succeed "," do
                  %em On products in a complex
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2307/1968795"} doi:10.2307/1968795
            %p
              The notion of
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              is due to
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
                = succeed "," do
                  %em Singular homology theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2307/1969185"} doi:10.2307/1969185
            %p
              The general abstract perspective on
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              (subsuming
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+cohomology"} sheaf cohomology
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
              and indications of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized cohomology
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} Abstract homotopy theory and generalized sheaf cohomology
                (1973)
          %h3#general General
          %p
            Relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/sheaf+cohomology"} sheaf cohomology
          %ul
            %li#Sella16
              %a.existingWikiWord{:href => "/nlab/show/Yehonatan+Sella"}> Yehonatan Sella
              ,
              %em Comparison of sheaf cohomology and singular cohomology
              (
              %a{:href => "http://arxiv.org/abs/1602.06674"}> arXiv:1602.06674
              )
          %p
            A simplified proof using
            %a.existingWikiWord{:href => "/nlab/show/hypercovers"} hypercovers
            can be found in
          %ul
            %li#Petersen21
              %a.existingWikiWord{:href => "/nlab/show/Dan+Petersen"}> Dan Petersen
              ,
              %em A remark on singular cohomology and sheaf cohomology
              (
              %a{:href => "https://arxiv.org/abs/2102.06927"}> arXiv:2102.06927
              )
        .revisedby
