                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \boxtimes A_2 \coloneqq (p_1^\ast A_1) \otimes_{X_1 \times X_2} (p_2^\ast A_2)
                    \\in Mod(X_1 \times X_2)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo ,
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_1, p_2
              denote the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              maps out of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
