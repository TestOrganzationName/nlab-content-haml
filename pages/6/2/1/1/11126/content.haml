                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{V}_X
                    \\,\boxtimes\,
                    \\mathscr{W}_Y
                    \\;\;
                    \\equiv
                    \\;\;
                    \\Big(
                    \\big(
                    (pr_X)^\ast \mathscr{V}
                    \\big)
                    \\otimes
                    \\big(
                    (pr_Y)^\ast \mathscr{W}
                    \\big)
                    \\Big)_{X \times Y}
                    \\;\;\;
                    \\in
                    \\;
                    Vect(X \times Y)
                    \\,,
            %p where we are denoting by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mi X
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mi Y
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X \times Y
                    \\\
                    \&amp;
                    \\mathllap{{}^{pr_X}}\swarrow
                    \&amp;&amp;
                    \\searrow\mathrlap{{}^{pr_Y}}
                    \\\
                    X &amp;&amp; &amp;&amp; Y
                    }
            %p
              the product
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              maps in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              whose
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} (x,y) \,\in\, X \times Y
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi.mathscript 𝒱
                        %mi x
                      %mo ⊗
                      %msub
                        %mi.mathscript 𝒲
                        %mi y
                    %annotation{:encoding => "application/x-tex"} \mathscr{V}_x \otimes \mathscr{W}_y
          %p
          #CartesianProductInGrothendieckConstruction.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                in a
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
                is external cartesian product)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi X
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %msup
                                      %mi f
                                      %mo *
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \\\
                    \\Big\downarrow\mathrlap{{}^{f}}
                    \\\
                    Y
                    }
                    \\;\;\;\;\;\mapsto\;\;\;
                    \\array{
                    \\mathcal{C}_X
                    \\\
                    \\Big\uparrow\mathrlap{{}^{f^\ast}}
                    \\\
                    \\mathcal{C}_Y
                    }
            %p
              where the base category and all fiber categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{(-)}
              have
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              and all
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserve
              these products, then the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi X
                    %msub
                      %mi 𝒞
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \int_X \mathcal{C}_X
              has cartesian products (as a special case of a general result on limits in Grothendieck constructions, discussed
              = succeed ")" do
                %a{:href => "Grothendieck+construction#CoLimitsInAGrothendieckConstruction"} there
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒱
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi.mathscript 𝒱
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi 𝒞
                      %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{V}_X \,\equiv\,
                    \\big(
                    \\mathscr{V} \,\in\, \mathcal{C}_X
                    \\big)
            %p by the formula
            #eq:CartesianProductInGrothendieckConstruction.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒱
                      %mi X
                    %mo ×
                    %msub
                      %mi.mathscript 𝒲
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi pr
                      %mi X
                      %mo *
                    %mi.mathscript 𝒱
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi pr
                      %mi Y
                      %mo *
                    %mi.mathscript 𝒲
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{V}_X
                    \\times
                    \\mathscr{W}_Y
                    \\;\;
                    \\simeq
                    \\;\;
                    \\Big(
                    \\big(pr_X^\ast \mathscr{V}\big)
                    \\,\times\,
                    \\big(pr_Y^\ast \mathscr{W}\big)
                    \\Big)_{X \times Y}
                    \\,.
            %p
              This is the general form of what might be called the “external cartesian product”; see also
              %a{:href => "free+coproduct+completion#FreeDistributiveCategoryMonad"} this Proposition
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/external+tensor+product+of+vector+bundles"}> external tensor product of vector bundles
                ,
                %a.existingWikiWord{:href => "/nlab/show/VectBund"} VectBund
            %li
              %p
                %a{:href => "direct+product+group#Representations"} direct product group representations
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/doubly+closed+monoidal+category"} doubly closed monoidal category
          %h2#references References
          %p
            The notion of the
            %a.existingWikiWord{:href => "/nlab/show/external+tensor+product+of+vector+bundles"} external tensor product of vector bundles
            originates in discussion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %ul
            %li#Atiyah67
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                , §2.6 in:
                = succeed "," do
                  %em K-theory
                = succeed "," do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/atiyahk.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/AtiyahKTheory.pdf", :title => "pdf"} pdf
            %li#Bott69
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                , p. 19 of:
                = succeed "," do
                  %em
                    Lectures on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} K(X)
                = succeed "," do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/bottk.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Bott-KTheory.pdf", :title => "pdf"} pdf
            %li#Karoubi
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                , §4.9 in:
                = succeed "," do
                  %em K-Theory – An introduction
                = succeed "," do
                  %strong 226
                = succeed "," do
                  %a{:href => "https://webusers.imj-prg.fr/~max.karoubi/K.book/MK.book.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-540-79890-3"} doi:10.1007/978-3-540-79890-3
          %p
            The notion of
            %a.existingWikiWord{:href => "/nlab/show/external+tensor+product+of+representations"} external tensor product of representations
            seems to be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/folklore"} folklore
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Fulton"}> William Fulton
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joe+Harris"} Joe Harris
                = succeed "," do
                  %em Representation Theory: a First Course
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-1-4612-0979-9"} doi:10.1007/978-1-4612-0979-9
            %li
              %p
                Caroline Gruson, Vera Serganova, p. 3 of:
                = succeed "," do
                  %em From Finite Groups to Quivers via Algebras – A Journey Through Representation Theory
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-319-98271-7"} doi:10.1007/978-3-319-98271-7
          %p
            The external tensor product of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perverse+sheaves"} perverse sheaves
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Volodymyr+Lyubashenko"}> Volodymyr Lyubashenko
              ,
              = succeed "," do
                %em External tensor product of categories of perverse sheaves
              %strong 53
              3 (2001) 311-322 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/9911207"}> arXiv:math/9911207
              \&amp;rbrack;
          %p
            The external tensor product of of
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
            in (
            %a.existingWikiWord{:href => "/nlab/show/derived+algebraic+geometry"}> derived
            )
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
          %ul
            %li#BondalvdBerg03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Bondal"}> Alexei Bondal
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michel+Van+den+Bergh"} Michel Van den Bergh
                = succeed "," do
                  %em Generators and representability of functors in commutative and noncommutative geometry
                %strong 3
                1 (2003) 1-36 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0204218"}> arXiv:math/0204218
                \&amp;rbrack;
            %li#BFN08
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
                = succeed "," do
                  %em Integral Transforms and Drinfeld Centers in Derived Algebraic Geometry
                %strong 23
                4 (2010) 909-966 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0805.0157"}> arXiv:0805.0157
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.ams.org/journals/jams/2010-23-04/S0894-0347-10-00669-7"} ISSN:1088-6834
          %p
            The external product on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+rings"} cobordism rings
          %ul
            %li#Quillen71
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
              , §1.6 in:
              = succeed "," do
                %em Elementary Proofs of Some Results of Cobordism Theory Using Steenrod Operations
              %strong 7
              (1971) 29–56 &amp;lbrack;
              %a{:href => "http://dx.doi.org/10.1016/0001-8708(71)90041-7"}> doi:10.1016/0001-8708(71)90041-7
              \&amp;rbrack;
          %p
            and on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+cobordism+cohomology"} differential cobordism rings
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Schick"} Thomas Schick
              = succeed "," do
                %em Landweber exact formal group laws and smooth cohomology theories
              %strong 9
              (2009) 1751-1790 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0711.1134"}> arXiv:0711.1134
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.2140/agt.2009.9.1751"} doi:10.2140/agt.2009.9.1751
          %p
            and in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hodge-filtered+differential+cohomology"} Hodge-filtered version
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Knut+Bjarte+Haus"}> Knut Bjarte Haus
                , §4.1.8, §4.10 in:
                = succeed "," do
                  %em Geometric Hodge filtered complex cobordism
                = succeed "&rbrack;" do
                  %a{:href => "https://ntnuopen.ntnu.no/ntnu-xmlui/handle/11250/3017489"} ntnuopen:3017489
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Knut+B.+Haus"}> Knut B. Haus
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gereon+Quick"} Gereon Quick
                %em Geometric Hodge filtered complex cobordism
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2210.13259"}> arXiv:2210.13259
                \&amp;rbrack;
          %p#ReferencesExternalSmashProduct
            The external
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            of
            %a.existingWikiWord{:href => "/nlab/show/retractive+spaces"} retractive spaces
            and of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
          %ul
            %li#MaySigurdsson06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Johann+Sigurdsson"} Johann Sigurdsson
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Parametrized+Homotopy+Theory"} Parametrized Homotopy Theory
                = succeed "," do
                  %strong 132
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/math/0411656"} arXiv:math/0411656
            %li#Malkiewich19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cary+Malkiewich"}> Cary Malkiewich
                , §3.1 of:
                %em Parametrized spectra, a low-tech approach
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1906.04773"}> arXiv:1906.04773
                , user guide:
                = succeed "," do
                  %a{:href => "https://people.math.binghamton.edu/malkiewich/users_guide_parametrized.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Malkiewich-ParametrizedSpectraUserGuide.pdf", :title => "pdf"} pdf
            %li#Malkiewich23
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cary+Malkiewich"}> Cary Malkiewich
                , §2.3 and §4.4 of:
                %em A convenient category of parametrized spectra
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2305.15327"}> arXiv:2305.15327
                \&amp;rbrack;
          %p
            For general abstract literature dealing with the external tensor products see the references at
            %em
              %a.existingWikiWord{:href => "/nlab/show/indexed+monoidal+category"} indexed monoidal category
            and at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent linear type theory
          %ul
            %li#Shulman12
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              ,
              = succeed "," do
                %em Enriched indexed categories
              %strong 28
              (2013) 616-695 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1212.3914"}> arXiv:1212.3914
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/28/21/28-21abs.html"} tac:28-21
