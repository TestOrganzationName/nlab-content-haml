                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
