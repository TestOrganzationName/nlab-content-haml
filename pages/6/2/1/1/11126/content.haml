                            %mi 𝒳
                          %mspace{:width => "thinmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thinmathspace"}
                          %mi I
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo ∫
                          %mstyle{:mathvariant => "bold"}
                            %mi C
                      %mtr
                        %mtd
                          %mi i
                        %mtd
                          %mo ↦
                        %mtd
                          %mi 𝒱
                          %mo{:stretchy => "false"} (
                          %mi i
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi 𝒳
                                %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathcal{V}_{\mathcal{X}}
                    \\,\colon\,
                    I &amp;\longrightarrow&amp; \int \mathbf{C}
                    \\\
                    i &amp;\mapsto&amp; \mathcal{V}(i)_{\mathcal{X}_i}
                    \\end{array}
            %p
              in the Grothendieck construction category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∫
                      %mstyle{:mathvariant => "bold"}
