                    %annotation{:encoding => "application/x-tex"} \int \mathbf{C}
            %p Then with
            %ul
              %li
                %p
                  the description of colimits in Grothendieck constructions as (see
                  = succeed ")" do
                    %a{:href => "Grothendieck+construction#CoLimitsInAGrothendieckConstruction"} there
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi lim
