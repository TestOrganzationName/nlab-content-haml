                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Mod(-)
                  \\\
                  \\downarrow
                  \\\
                  \\mathbf{H}
                  }
          %p
            over a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
