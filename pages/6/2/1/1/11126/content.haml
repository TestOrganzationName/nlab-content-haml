          .num_remark
            %h6#remark Remark
            %p
              The external tensor product constitutes a
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              on the total category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Mod
              of the given
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mod
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} Mod(-)\to \mathbf{H}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+fibration"} monoidal fibration
          %h2#properties Properties
          %h3#relation_to_fiberwise_tensor_product Relation to fiberwise tensor product
          .num_prop
            %h6#proposition Proposition
            %p
              The fiberwise (“internal”) tensor product over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X\in \mathbf{H}
              is recovered form the external one via a
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⊗
                      %mi X
                    %msub
                      %mi A
                      %mn 2
                    %mo ≃
                    %msubsup
                      %mi Δ
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo ⊠
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_1 \otimes_X A_2 \simeq \Delta_X^\ast (A_1 \boxtimes A_2)
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %mo ,
                      %msub
                        %mi A
                        %mn 2
                      %mo ∈
                      %mi Mod
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_1, A_2 \in Mod(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta \colon X \longrightarrow X \times X
              is the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h3#generation_of__from_external_tensor_products
            Generation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
