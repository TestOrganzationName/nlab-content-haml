                    \\longrightarrow
                    Mod(X_1 \times X_2)
            %p
              given on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ∈
                    %mi Mod
                    %mo{:stretchy => "false"} (
