                      \\\
                      \\Big\downarrow\mathrlap{{}^{f}}
                      \&amp;&amp;
                      \\mathllap{^{f_!}}\Big\downarrow
                      \\dashv
                      \\Big\uparrow\mathrlap{{}^{f^\ast}}
                      \\\
                      \\mathcal{Y}
                      \&amp;\mapsto&amp;
                      \\mathbf{C}_{\mathcal{Y}}
                      }
            %li
              %p
                between
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^\ast
                are
              %ol
                %li
                  %p
                    besides being
                    %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functors"} strong monoidal functors
                %li
                  %p
                    also
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/strong+closed+functors"} strong closed functors
                  %p
                    hence the pushforward functors
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mo !
                        %annotation{:encoding => "application/x-tex"} f_!
                    satisfy the
                    %a.existingWikiWord{:href => "/nlab/show/projection+formula"} projection formula
                    (“
                    %a.existingWikiWord{:href => "/nlab/show/Frobenius+reciprocity"}> Frobenius reciprocity
                    ”)
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/preserving+colimits"} preserving colimits
            %li
              %p
                pull-push through
                %a.existingWikiWord{:href => "/nlab/show/cartesian+squares"} cartesian squares
                in
