                      %mi p
                      %mn 1
                      %mo *
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                        %mo ×
                        %msub
                          %mi X
