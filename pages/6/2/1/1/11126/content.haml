                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mrow
                                    %mrow
                                      %msup
                                        %mi f
                                        %mo *
                          %mtr
                            %mtd
                              %mi 𝒴
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi C
                                %mi 𝒴
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathllap{
                      \\mathbf{C} \,\colon\,
