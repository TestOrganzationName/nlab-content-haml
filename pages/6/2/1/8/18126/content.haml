            (example
            = succeed "):" do
              %a.maruku-ref{:href => "#MetricTopology"}
          #TopologicalSpaceSequenceConverging.num_defn
            %h6#definition_49 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converging
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                in a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
