                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi A
                        %msub
                          %mi f
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 2
                        %mphantom
                          %mi A
                    %msub
                      %mi X
                      %mn 2
