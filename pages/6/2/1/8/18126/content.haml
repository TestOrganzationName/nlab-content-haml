                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi Y
                            %mspace{:width => "thickmathspace"}
                            %mo ∩
                            %mspace{:width => "thickmathspace"}
                            %mi C
                            %mo =
                            %mi ∅
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} {
