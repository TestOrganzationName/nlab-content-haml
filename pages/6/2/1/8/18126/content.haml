              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↪
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \hookrightarrow Y
              is an embedding of smooth manifolds, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is also called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
