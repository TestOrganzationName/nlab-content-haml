                                %mi Y
                                %mo ,
                                %msub
                                  %mi τ
                                  %mi Y
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi f
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ↦
                                  %mphantom
                                    %mi AAA
                              %mtd
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        (X, \tau_X) \times Maps((X,\tau_X), (Y, \tau_Y))
                        \&amp; \overset{\phantom{AA} ev \phantom{AA}}{\longrightarrow}&amp;
                        (Y, \tau_Y)
                        \\\
