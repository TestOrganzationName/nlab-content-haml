                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tau_{final}(\{f_i\}_{i \in I})
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/fine+topology"} finest
                  topology on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi q
                          %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi X
                          %mi i
                        %mo ⟶
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo ,
