          %p
            It follows immediately from prop.
            %a.maruku-ref{:href => "#LocalPropertiesOfLocallyEuclideanSpace"}
            via prop.
            %a.maruku-ref{:href => "#ForLocallyPathConnectedThenPathConnectedComponentsAgree"}
            that:
          #PathConnectedFromConnectedLocallyEuclideanSpace.num_prop
            %h6#proposition_80 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+spaces"} locally Euclidean spaces
                are
                = succeed ")" do
