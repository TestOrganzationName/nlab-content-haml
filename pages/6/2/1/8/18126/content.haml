                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K \times V_z \;\subset\; f^{-1}(U) \cap (K \times Z) \;\subset\; f^{-1}(U)
                    \\,.
            %p
              This shows that with every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %msup
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mrow
                      %mo (
                      %msup
                        %mi U
                        %mi K
                      %mo )
                  %annotation{:encoding => "application/x-tex"} z \in \tilde f^{-1}\left(U^K\right)
              also an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              is contained in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mrow
                        %mo (
                        %msup
                          %mi U
                          %mi K
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \tilde f^{-1}\left(U^K\right)
            %p
              In the other direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Z
                    %mo →
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde f \colon Z \to Maps((X,\tau_X),(Y,\tau_Y))
              is continuous: We need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is continuous. But observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ,
                    %msub
                      %mi τ
                      %mi Z
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi τ
                            %mi X
                          %mo{:stretchy => "false"} )
                        %mo ×
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi ev
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \=
                    (X, \tau_X) \times (Z,\tau_Z)
                    \\overset{id{(X,\tau_X)} \times \tilde f}{\longrightarrow}
                    (X, \tau_X)
                    \\times
                    Maps((X,\tau_X), (Y,\tau_Y))
                    \\overset{ev}{\longrightarrow}
                    (X,\tau_X)
                    \\,.
            %p
              Here the first function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo ×
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} id \times \tilde f
              is continuous since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              is by assumption since the product of two continuous functions is again continuous (example
              = succeed ")." do
                %a.maruku-ref{:href => "#FunctorialProductSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                  %annotation{:encoding => "application/x-tex"} ev
              is continuous by the first point above. hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is continuous.
          #TopologicalMappingSpaceIsExponentialObject.num_remark
            %h6#remark_20 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} topological mapping space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            %p
              In the language of
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              (remark
              = succeed ")," do
                %a.maruku-ref{:href => "#TopCategory"}
              %a.maruku-ref{:href => "#UniversalPropertyOfMappingSpace"}
              says that the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              construction with its
              %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
              from def.
              %a.maruku-ref{:href => "#CompactOpenTopology"}
              is an
              %em
                %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
              or
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
              does for plain functions, but it does so for continuous functions and being itself equipped with a topology.
            %p
              Moreover, the construction of topological mapping spaces in example
              %a.maruku-ref{:href => "#CompactOpenTopology"}
              extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Top
                      %mi lcpt
                      %mi op
                    %mo ×
                    %mi Top
                    %mo ⟶
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{(-)} \;\colon\; Top_{lcpt}^{op} \times Top \longrightarrow Top
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              of the category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of all
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopCategory"}
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+spaces"} locally compact topological spaces
          #MappingSpaceOutOfPoint.num_example
            %h6#example_102 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} topological mapping space
                construction out of the
                %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
                is the identity)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#Point"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              the
              %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Maps(\ast, (X,\tau))
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactOpenTopology"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,\tau)
              itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Maps(\ast, (X,\tau))
                    \\simeq
                    (X,\tau)
                    \\,.
          #LoopSpace.num_example
            %h6#example_103 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SpheresAndDisks"}
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ExamplesOfCompactHausdorffSpaces"}
                  = succeed "," do
                    %a.maruku-ref{:href => "#OpenSubspacesOfCompactHausdorffSpacesAreLocallyCompact"}
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#LocallyCompactSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℒ
                        %mi X
                        %mo ≔
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{L} X \coloneqq Maps( S^1, (X,\tau) )
                %p
                  exists (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#CompactOpenTopology"}
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X,\tau)
                %p
                  If both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  are equipped with a choice of point (“
                  %a.existingWikiWord{:href => "/nlab/show/basepoint"}> basepoint
                  ”)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi s
                            %mn 0
                          %mo ∈
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} s_0 \in S^1
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mn 0
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x_0 \in X
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mi X
                        %mo ⊂
                        %mi ℒ
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\Omega X \subset \mathcal{L}X
                %p
                  on those functions which take the basepoint of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  to that of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
              %li
                %p
                  Similarly the
                  %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ExamplesOfCompactHausdorffSpaces"}
                  = succeed "," do
                    %a.maruku-ref{:href => "#OpenSubspacesOfCompactHausdorffSpacesAreLocallyCompact"}
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#LocallyCompactSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Maps( [0,1], (X,\tau) )
                %p
                  exists (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#CompactOpenTopology"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is equipped with a choice of basepoint
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mn 0
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x_0 \in X
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                  of those functions that take
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} 0 \in [0,1]
                  to that chosen basepoint is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X\tau)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mi X
                        %mo ⊂
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        P X \subset Maps( [0,1], (X,\tau) )
                        \\,.
            %p
              Notice that we may encode these subspaces more abstractly in terms of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/universal+properties"} universal properties
            %p
              The path space and the loop space are characterized, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              %a.existingWikiWord{:href => "/nlab/show/limit"} limiting cones
              in the following
