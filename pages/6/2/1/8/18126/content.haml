                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X &amp; \overset{t_n(X)}{\longrightarrow} &amp;  X/{\sim}
                        \\\
                        x &amp;\overset{\phantom{AAA}}{\mapsto}&amp; [x]
                        }
                %p
                  exhibits the
                  = succeed "-reflection" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
