                              %mi E
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in i}{\sqcup} U_i \times k^n
                    \&amp;\overset{( \phi^1_i \circ f_i^{-1} )_{i \in I}}{\longrightarrow}&amp;
                    E_1
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{\exists !}}
                    \\\
                    E_2
                    }
                    \\,.
            %p
              This unique function is clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              (by pointwise inspection) and therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              is continuous.
          .num_example
            %h6#example_125 Example
            %p
              %strong (fiberwise linearly independent sections trivialize a vector bundle)
            %p
              If a topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              of
              %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              admits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundleSections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi σ
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\{\sigma_k \;\colon\; X \longrightarrow E\}_{k \in \{1, \cdots, n\}}
            %p
              that are linearly independent at each point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is trivializable (example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialTopologicalVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (according to example
              = succeed ")," do
                %a.maruku-ref{:href => "#VectorBundleSections"}
              %em are
              the trivialization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi σ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\sigma_1, \cdots, \sigma_n)
                    \\;\colon\;
                    (X \times k^n)
                    \\overset{\simeq}{\longrightarrow}
                    E
                    \\,.
            %p
              This is because their linear independence at each point means precisely that this morphism of vector bundles is a fiber-wise linear isomorphism and therefore an isomorphism of vector bundles by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#FiberwiseIsoisIsomorphismOfVectorBundles"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p (…)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#Manifolds Manifolds
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            which is
            %em locally
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
            to a
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            (def.
            %a.maruku-ref{:href => "#TopologicalManifold"}
            below), but which may globally look very different. These are the kinds of topological spaces that are really meant when people advertise
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            as “
            %a.existingWikiWord{:href => "/nlab/show/rubber-sheet+geometry"}> rubber-sheet geometry
            ”.
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
            which relate the Euclidean
            %a.existingWikiWord{:href => "/nlab/show/local+charts"} local charts
            of topological manifolds to each other are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
            %em
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
            (def
            %a.maruku-ref{:href => "#DifferentiableManifold"}
            below) or of
            %em
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            if the gluing functions are arbitrarily differentiable.
          %p
            Accordingly, a differentiable manifold is a space to which the tools of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+analysis"} infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            may be applied
            = succeed "." do
              %em locally
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            between differentiable manifolds is
            %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiable
            by computing its
            %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
            pointwise in any of the Euclidean
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
            are in
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
          %p
            Basic examples of smooth manifolds are the
            %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
            (example
            %a.maruku-ref{:href => "#SmoothManifoldnSphere"}
            below), the
            %a.existingWikiWord{:href => "/nlab/show/projective+spaces"} projective spaces
            (example
            %a.maruku-ref{:href => "#SmoothManifoldRealComplexProjectiveSpace"}
            below). and the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            (example
            = succeed ")" do
              %a.maruku-ref{:href => "#SmoothManifoldGeneralLinearGroup"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The definition of
            %a.existingWikiWord{:href => "/nlab/show/topological+manifolds"} topological manifolds
            (def.
            %a.maruku-ref{:href => "#TopologicalManifold"}
            below) involves two clauses: The conceptual condition is that a manifold is
            %em
              %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+topological+space"} locally Euclidean topological space
            (def.
            %a.maruku-ref{:href => "#LocallyEuclideanSpace"}
            below). On top of this one demands as a technical regularity condition
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+topological+space"} paracompact Hausdorffness
          #LocallyEuclideanSpace.num_defn
            %h6#definition_74 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+topological+space"}> locally Euclidean topological space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+topological+space"} locally Euclidean
              if every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              has an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              which, as a
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#MetricTopology"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ≃
                        %mphantom
                          %mi AA
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n
                    \\overset{\phantom{AA} \simeq \phantom{AA}}{\longrightarrow}
                    U_x
                    \\subset
                    X
                    \\,.
          %p
            The “local”
            %a.existingWikiWord{:href => "/nlab/show/topological+properties"} topological properties
            of Euclidean space are inherited by locally Euclidean spaces:
          #LocalPropertiesOfLocallyEuclideanSpace.num_prop
            %h6#proposition_79 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+spaces"} locally Euclidean spaces
                are
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_1
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separated
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+spaces"} locally path-connected topological spaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+space"} locally Euclidean space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyEuclideanSpace"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  satisfies the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_1
                  %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separation axiom
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#Sober"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
                  in the weak sense of def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#LocalCompactnessViaCompactNeighbourhoodBase"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#LocallyConnected"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#PathConnectedLocally"}
          .proof
            %h6#proof_115 Proof
            %p Regarding the first statement:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≠
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \neq y
              be two distinct points in the locally Euclidean space. We need to show that there is an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              that does not contain
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
            %p
              By definition, there is a Euclidean open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %munderover
                      %mo →
                      %mo ≃
                      %mi ϕ
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \underoverset{\simeq}{\phi}{\to} U_x \subset X
              around
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              does not contain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              does contain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi^{-1}(x) \neq \phi^{-1}(y)
              are equivalently two distinct points in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#HausdorffMetricSpace"}
              = succeed ")," do
                %a.maruku-ref{:href => "#TnImplications"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %msup
                          %mi ϕ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V_{\phi^{-1}(x)} \subset \mathbb{R}^n
              not containing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi^{-1}(y)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mrow
                        %msup
                          %mi ϕ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi(V_{\phi^{-1}(x)}) \subset X
              is an open neighbourhood as required.
            %p Regarding the second statement:
            %p We need to show that the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mi IrrClSub
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\{-\}) \;\colon\; X \to IrrClSub(X)
            %p
              that sends points to the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of their singleton sets is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              with the set of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subsets"} irreducible closed subsets
              %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective
              (via lemma
              = succeed ")." do
                %a.maruku-ref{:href => "#T1InTermsOfTopologicalClosure"}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \subset X
              be an open proper subset such that if there are two open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \subset X
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset P
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \subset P
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi P
                    %annotation{:encoding => "application/x-tex"} U_2 \subset P
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenSubsetVersionOfClosedIrreducible"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} P = X \setminus \{x\}
              it its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            %p
              Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \subset X
              is a proper subset, and since the locally Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is covered by Euclidean neighbourhoods, there exists a Euclidean neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %munderover
                      %mo →
                      %mo ≃
                      %mi ϕ
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \underoverset{\simeq}{\phi}{\to} U \subset X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∩
                    %mi U
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"} P \cap U \subset U
              is a proper subset. In fact this still satisfies the condition that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %munder
                      %mo ⊂
                      %mtext open
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \underset{\text{open}}{\subset} U
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi P
                    %mo ∩
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset P \cap U
              implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %mi P
                    %mo ∩
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_1 \subset P \cap U
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi P
                      %mo ∩
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U_2 \subset P \cap U
              = succeed "," do
                %a.maruku-ref{:href => "#OpenSubsetVersionOfClosedIrreducible"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∖
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ∩
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \setminus \phi^{-1}(P \cap U)
              is an irreducible closed subset of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
              are
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober topological space
              as well as
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separated
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#HausdorffMetricSpace"}
              = succeed ")," do
                %a.maruku-ref{:href => "#SoberFromHausdorff"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ∩
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \phi^{-1}(P \cap U) = \mathbb{R}^n \setminus \{x\}
            %p
              In conclusion this means that the restriction of an irreducible closed subset in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to any Euclidean chart is either empty or a singleton set. This means that the irreducible closed subset must be a disjoint union of singletons that are separated by Euclidean neighbourhoods. But by irreducibiliy, this union has to consist of just one point.
            %p Regarding the third statement:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              be an open neighbourhood. We need to find a compact neighbourhood
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi x
                      %mo ⊂
                      %msub
                        %mi U
                        %mi x
