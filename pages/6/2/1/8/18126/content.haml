              of the origin, and consider on its underlying set the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              which identifies two points if they differ by
              %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
              with some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} c \in k
              (necessarily non-zero):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mn 1
                    %mo ∼
                    %msub
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mrow
                          %mi c
                          %mo ∈
                          %mi k
                      %mo{:stretchy => "false"} (
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                        %mn 2
                      %mo =
                      %mi c
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\vec x_1 \sim \vec x_2)
                    \\;\Leftrightarrow\;
                    \\left(
                    \\underset{c \in k}{\exists}
                    ( \vec x_2 = c \vec x_1 )
                    \\right)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\vec x]
              is traditionally denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo :
                    %msub
                      %mi x
                      %mn 2
                    %mo :
                    %mi ⋯
                    %mo :
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [x_1 : x_2 : \cdots : x_{n+1}]
                    \\,.
            %p
              Then the
              %em
                %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              is the corresponding
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi k
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    k P^n \;\coloneqq\; \left(k^{n+1} \setminus \{0\}\right) / \sim
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{R}
              this is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}P^n
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{C}
              this is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
          #RiemannSphere.num_example
            %h6#examples_6 Examples
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"}> Riemann sphere
                )
            %p
              The first
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ToplogicalProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
              (example
