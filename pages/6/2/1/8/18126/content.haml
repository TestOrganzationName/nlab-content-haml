                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi k
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo =
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mo ∈
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} }
                          %mi k
