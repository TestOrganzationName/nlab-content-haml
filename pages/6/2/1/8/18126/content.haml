                        \\underset{\longrightarrow}{\lim}_i L(X_i)
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint+functor"} right adjoint functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserve
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LimitingCone"}
                %p
                  in that for every
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi i
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi f
                              %mi α
                        %msub
                          %mi X
                          %mi j
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{X_i \overset{f_\alpha}{\to} X_j\}
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mrow
                          %mo (
                          %msub
                            %munder
                              %mi lim
                              %mo ⟵
                            %mi i
