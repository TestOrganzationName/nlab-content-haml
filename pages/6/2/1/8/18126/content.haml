                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ′
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ′
                            %mo ,
                            %mi j
                            %mo ′
                            %mo ∈
                            %mi I
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} \{g'_{i',j'} \colon U'_{i'} \cap U'_{j'} \to GL(n',k) \}_{i', j' \in I'}
                  the corresponding component functions.
            %p
              Then a
              %em
                %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
              between these two cocycles is
            %ol
              %li
                %p
                  the condition that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mi n
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} n = n'
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi V
                            %mi α
                          %mo ⊂
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} }
                            %mrow
                              %mi α
                              %mo ∈
                              %mi A
