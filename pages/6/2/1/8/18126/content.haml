                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i_0 \in I
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
