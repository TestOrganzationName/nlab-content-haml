              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mi i
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi U
                        %mi x
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ∩
                    %mspace{:width => "thickmathspace"}
