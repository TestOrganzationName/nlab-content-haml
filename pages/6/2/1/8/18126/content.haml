          %p
            We have already seen
            %a{:href => "#BasicConstructions"} above
            simple examples of initial and final topologies:
          #TopologicalSubspaceInitial.num_example
            %h6#example_68 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                as an
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/initial+topology"} initial topology
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              a single
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} q \colon S \hookrightarrow X
              a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of its underlying set, then the
              %a.existingWikiWord{:href => "/nlab/show/initial+topology"} initial topology
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi intial
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau_{intial}(p)
              = succeed "," do
                %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#SubspaceTopology"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
