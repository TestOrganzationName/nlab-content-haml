                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod}(X_i, \tau_i)
              (example
              = succeed ")" do
