            = succeed ":" do
              %a.maruku-ref{:href => "#CompactTopologicalSpace"}
          #ContinuousSurjectionOutOfCompactSpaceHasCompactCodomain.num_lemma
            %h6#lemma_14 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/continuous+surjections+out+of+compact+spaces+have+compact+codomain"}> continuous surjections out of compact spaces have compact codomain
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X,\tau_X) \longrightarrow (Y,\tau_Y)
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau_X)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective function
            %p
              Then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
          .proof
            %h6#proof_60 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset Y\}_{i \in I}
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#OpenCover"}
            %p
              By the continuity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              the
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(U_i)
              form an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{f^{-1}(U_i) \subset X\}_{i \in I}
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{f^{-1}(U_i) \subset X\}_{i \in J \subset I}
              is still an open cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              it it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo =
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi f
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi J
                              %msup
                                %mi f
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ∈
                                %mi J
                            %msub
                              %mi U
                              %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Y
                    \&amp; = f(X)
                    \\\
                    \&amp; = f\left( \underset{i \in J}{\cup} f^{-1}(U_i) \right)
                    \\\
                    \&amp; = \underset{i \in J}{\cup} U_i
                    \\end{aligned}
            %p
              where we used that
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/images+of+unions+are+unions+of+images"} images of unions are unions of images
            %p
              This means that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset Y\}_{i \in J \subset I}
              is still an open cover of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          %p
            As a direct corollary of lemma
            %a.maruku-ref{:href => "#ContinuousSurjectionOutOfCompactSpaceHasCompactCodomain"}
            we obtain:
          #ContinuousImageOfACompactSpaceIsCompact.num_prop
            %h6#proposition_46 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"}> continuous images of compact spaces are compact
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              out of a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
              %a.existingWikiWord{:href => "/nlab/show/image+factorization"} image factorization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mphantom
                        %mi AAA
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \overset{\phantom{AAA}}{\longrightarrow} f(X) \overset{\phantom{AAA}}{\hookrightarrow} Y
            %p
              as in example
              = succeed "." do
                %a.maruku-ref{:href => "#ImageFactorization"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to f(X)
              is surjective, and so lemma
              %a.maruku-ref{:href => "#ContinuousSurjectionOutOfCompactSpaceHasCompactCodomain"}
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X)
              is compact.
          %p
            The converse to cor.
            %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
            does not hold in general: the pre-image of a compact subset under a continuous function need not be compact again. If this is the case, then we speak of
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/proper+maps"} proper maps
          #ProperContinuous.num_defn
            %h6#definition_48 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/proper+maps"}> proper maps
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f  \colon (X, \tau_X) \to (Y, \tau_Y)
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper
              if for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} C \in Y
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(C)
              is
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            As a first useful application of the topological concept of compactness we obtain a quick proof of the following classical result from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
          #ExtremeValueTheorem.num_prop
            %h6#proposition_47 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/extreme+value+theorem"}> extreme value theorem
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi C
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; C \longrightarrow \mathbb{R}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              to the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              equipped with their
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              attains its
              %a.existingWikiWord{:href => "/nlab/show/maximum"} maximum
              and its
              %a.existingWikiWord{:href => "/nlab/show/minimum"} minimum
              in that there exist
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi min
                    %mo ,
                    %msub
                      %mi x
                      %mi max
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x_{min}, x_{max} \in C
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi min
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi max
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f(x_{min}) \leq f(x) \leq f(x_{max})
                    \\,.
          .proof
            %h6#proof_61 Proof
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f([a,b]) \subset \mathbb{R}
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
            %p
              Suppose this image did not contain its maximum. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
                        %mo ∈
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{(-\infty,x)\}_{x \in f([a,b])}
              were an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of the image, and hence, by its compactness, there would be a finite subcover, hence a finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi x
                      %mn 2
                    %mo &lt;
                    %mi ⋯
                    %mo &lt;
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1 \lt x_2 \lt \cdots \lt x_n)
              of points
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                      %mo ∈
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x_i \in f([a,b])
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-\infty,x_i)
              and hence the single set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-\infty, x_n)
              alone would cover the image. This were in contradiction to the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi n
                    %mo ∈
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x_n \in f([a,b])
              and hence we have a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
            %p Similarly for the minimum.
          %p And as a special case:
          #ExtremeValueTheoremTraditional.num_example
            %h6#example_94 Example
            %p
              %strong
                (traditional
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/extreme+value+theorem"} extreme value theorem
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; [a,b] \longrightarrow \mathbb{R}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              from a
              %a.existingWikiWord{:href => "/nlab/show/bounded+set"} bounded
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \lt b \in \mathbb{R}
              ) (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              attains its
              %a.existingWikiWord{:href => "/nlab/show/maximum"} maximum
              and
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/minimum"} minimum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi max
                    %mo ,
                    %msub
                      %mi x
                      %mi min
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} x_{max}, x_{min} \in [a,b]
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} x \in [a,b]
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi min
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi max
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f([a,b]) = [f(x_{min}), f(x_{max})]
                    \\,.
          .proof
            %h6#proof_62 Proof
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f([a,b]) \subset \mathbb{R}
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              = succeed ")." do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#BorelHeine"}
              %a.existingWikiWord{:href => "/nlab/show/bounded+set"} bounded
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#MetricSpaceBoundedSubset"}
              = succeed ")." do
                %a.maruku-ref{:href => "#ClosedSubset"}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+intervals"} closed intervals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              it needs to be a single closed interval, hence (being bounded) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi min
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi max
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f([a,b]) =  [f(x_{min}), f(x_{max})] \;\subset\; \mathbb{R}
                    \\,.
          %p There is also the following more powerful equivalent reformulation of compactness:
          #ClosedProjectionCharacterizationOfCompactness.num_prop
            %h6#proposition_48 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/closed-projection+characterization+of+compactness"}> closed-projection characterization of compactness
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau_X)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                  according to def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  For every topological space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
                  then the
                  %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                  map out of the
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                  (example
                  = succeed "," do
                    %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi Y
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_Y
                        \\;\colon\;
                        (Y, \tau_Y) \times (X, \tau_X)
                        \\longrightarrow
                        (Y, \tau_Y)
                %p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
          .proof
            %h6#proof_63 Proof
            %p
              (
              %a{:href => "closed-projection+characterization+of+compactness#Acknowledgement"}> due to Todd Trimble
              )
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              is compact and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi Y
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C \subset Y \times X
              be a closed subset. We need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \pi_Y(C) \subset Y
              is closed.
            %p
              By lemma
              %a.maruku-ref{:href => "#UnionOfOpensGivesClosure"}
              this is equivalent to showing that every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                    %mo ∖
                    %msub
                      %mi π
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y \in Y \setminus \pi_Y(C)
              in the complement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_Y(C)
              has an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi y
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V_y \supset \{y\}
              which does not intersect
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_Y(C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi y
                    %mo ∩
                    %msub
                      %mi π
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V_y \cap \pi_Y(C) = \emptyset
                    \\,.
            %p This is clearly equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi y
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi C
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"}
                    (V_y \times X) \cap C = \emptyset
            %p and this is what we will show.
            %p To this end, consider the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mi U
                      %mo ⊂
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mtext open
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ∃
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi V
                              %mo ⊂
                              %mi Y
                              %mspace{:width => "thinmathspace"}
                              %mtext open
                          %mrow
                            %mrow
                              %mi V
                              %mo ⊃
                              %mo{:stretchy => "false"} {
                              %mi y
                              %mo{:stretchy => "false"} }
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ×
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi C
                        %mo =
                        %mi ∅
                        %mo )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U \subset X\, \text{open}
                    \\;\vert\;
                    \\underset{ {V \subset Y \, \text{open} } \atop { V \supset \{y\} }  }{\exists}
                    \\left(
                    (V \times U) \cap C = \emptyset
                    \\right)
                    \\right\}
            %p
              Observe that this is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∉
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (y,x) \notin C
              by assumption of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              this means that there exists an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (y,x)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \times X
              not intersecting
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              this contains an open neighbourhood of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ×
                      %mi U
                    %annotation{:encoding => "application/x-tex"} V \times U
            %p
              Hence by compactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi j
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{ U_j \subset X \}_{j \in J}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and a corresponding set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{V_j \subset Y\}_{j \in J}
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi j
                      %mo ×
                      %msub
                        %mi U
                        %mi j
                      %mo ∩
                      %mi C
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} V_j \times U_j \cap C = \emptyset
            %p The resulting open neighbourhood
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≔
                    %munder
                      %mo ∩
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    V \coloneqq \underset{j \in J}{\cap} V_j
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              has the required property:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi V
                            %mo ×
                            %mi X
                          %mtd
                            %mo =
                            %mi V
                            %mo ×
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mrow
                                  %mi j
                                  %mo ∈
                                  %mi J
                              %msub
                                %mi U
                                %mi j
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∪
                              %mrow
                                %mi j
                                %mo ∈
                                %mi J
                            %mrow
                              %mo (
                              %mi V
                              %mo ×
                              %msub
                                %mi U
                                %mi j
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %munder
                              %mo ∪
                              %mrow
                                %mi j
                                %mo ∈
                                %mi J
                            %mrow
                              %mo (
                              %msub
                                %mi V
                                %mi j
                              %mo ×
                              %msub
                                %mi U
                                %mi j
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ×
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ∖
                            %mi C
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    V \times X
                    \&amp; =
                    V \times \left( \underset{j \in J}{\cup} U_j \right)
                    \\\
                    \&amp; = \underset{j \in J}{\cup}\left( V \times U_j \right)
                    \\\
                    \&amp; \subset \underset{j \in J}{\cup} \left( V_j \times U_j \right)
                    \\\
                    \&amp; \subset (Y \times X) \setminus C
                    \\,.
                    \\end{aligned}
            %p Now for the converse:
            %p
              Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi Y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi_Y \colon Y \times X \to X
              is a closed map for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is compact. By prop.
              %a.maruku-ref{:href => "#ClosedSubsetFormulationOfCompactness"}
              this means equivalently that for every set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
              of closed subsets and satisfying the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∩
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi C
                        %mi i
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i \neq \emptyset
            %p
              So consider such a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
              of closed subsets satisfying the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y, \tau_Y)
              by setting
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Y
                        %mo ≔
                        %mi X
                        %mo ⊔
                        %mo{:stretchy => "false"} {
                        %mn ∞
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} Y \coloneqq X \sqcup \{\infty\}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi β
                          %mi Y
                        %mo ≔
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊔
                        %msub
                          %mrow
                            %mo {
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mi i
                            %mo ∪
                            %mo{:stretchy => "false"} {
                            %mn ∞
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ⊂
                            %mi Y
                            %mo }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \beta_Y \coloneqq P(X) \sqcup \left\{ (C_i \cup \{\infty\}) \subset Y  \right\}_{i \in I}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/sub-base+for+a+topology"} sub-base
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mi Y
                      %annotation{:encoding => "application/x-tex"} \tau_Y
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#TopologyBase"}
            %p
              Then consider the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(\Delta)
              of the “diagonal”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \times X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi Y
                      %mo ×
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mo ∈
                      %mi X
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta
                    \\coloneqq
                    \\left\{
                    (x,x) \in Y \times X \,\vert\, x \in X
                    \\right\}
                    \\,.
            %p
              We claim that there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\infty,x) \in Cl(\Delta)
                    \\,.
            %p This is because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mtext is closed
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_Y(Cl(\Delta)) \subset Y \,\,\text{is closed}
            %p
              by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \pi_Y
              is a closed map, and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊂
                    %msub
                      %mi π
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \subset \pi_Y(Cl(\Delta))
            %p
              by construction. So if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              were not in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_Y(Cl(\Delta))
              = succeed "," do
                %a.maruku-ref{:href => "#UnionOfOpensGivesClosure"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \tau_Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              are the unions of finite intersections of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi i
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} C_i \cup \{\infty\}
              %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
