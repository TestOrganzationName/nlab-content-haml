                  of all the
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi i
                      %annotation{:encoding => "application/x-tex"} X_i
                  appearing in the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
