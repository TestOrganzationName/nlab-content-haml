          #PointTopologicalSpaceAsEmptyLimit.num_example
            %h6#example_70 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
                and
                %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
                as empty
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty diagram
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#DiscreteDiagram"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %a.maruku-ref{:href => "#TerminalInitialObject"}
              the limit and colimit (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LimitingCone"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              and
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  of topological spaces over the
                  %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty diagram
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                  (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#Point"}
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  of topological spaces over the
                  %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty diagram
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/empty+topological+space"} empty topological space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \emptyset
                  (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#Point"}
            %p
              This is because for an empty diagram, the a (co-)cone is just a topological space, without any further data or properties, and it is universal precisely if there is a unique continuous function to (respectively from) this space to any other space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed ":" do
                %a.maruku-ref{:href => "#TerminalityOfThePoint"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ∃
                        %mo !
                        %mphantom
                          %mi AA
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ∃
                        %mo !
                        %mphantom
                          %mi AA
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset
                    \\overset{ \phantom{AA} \exists ! \phantom{AA} }{\longrightarrow}
                    (X, \tau)
                    \\overset{\phantom{AA} \exists ! \phantom{AA}}{\longrightarrow}
                    \\ast
                    \\,.
          #DisjointUnionOfTopologicalSpacesIsCoproduct.num_example
            %h6#example_71 Example
            %p
              %strong
                (binary
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                and
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
                as
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              consisting of two topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X), (Y,\tau_Y)
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#DiscreteDiagram"}
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              and
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              and
              %em
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊔
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \sqcup Y
              = succeed ")." do
                %a.maruku-ref{:href => "#CoProduct"}
            %ol
              %li
                %p
                  In topological space this
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  is the binary
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                  from example
                  = succeed "," do
                    %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
                  = succeed ":" do
                    %a.maruku-ref{:href => "#UniversalPropertyOfBinaryProductSpace"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mrow
                            %mi X
                            %mo ×
                            %mi Y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (X,\tau_X) \times (Y, \tau_Y) \simeq (X \times Y, \tau_{X \times Y})
                        \\,.
              %li
                %p
                  In topological spaces, this
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
                  from example
                  = succeed "," do
                    %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
                  = succeed ":" do
                    %a.maruku-ref{:href => "#UniversalPropertyOfDisjointUnionSpace"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊔
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⊔
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mrow
                            %mi X
                            %mo ⊔
                            %mi Y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (X, \tau_X) \sqcup (Y, \tau_Y) \simeq ( X \sqcup Y, \tau_{X \sqcup Y} )
                        \\,.
          %p
            So far these examples just reproduces simple constructions which we already considered. Now the first important application of the general concept of limits of diagrams of topological spaces is the following example
            %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
            of product spaces with an non-
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            of factors. It turns out that the correct topology on the underlying infinite
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            of sets is
            %em not
            the naive generalization of the binary product topology, but instead is the corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+topology"} weak topology
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
          #InfiniteProductTopologicalSpace.num_example
            %h6#example_72 Example
            %p
              %strong
                (general
                %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
                with
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
            %p
              Consider an arbitrary
              %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of topological spaces (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DiscreteDiagram"}
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{(X_i, \tau_i)\}_{i \in I}
              of topological spaces, indexed by any
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              over this diagram (a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              = succeed ")" do
                %a.maruku-ref{:href => "#CoProduct"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              of the spaces in the diagram, and denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\prod} (X_i, \tau_i)
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#SetLimits"}
              and prop.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalSubspaceInitial"}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of the underlying sets, hence the set of
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi i
                      %mo ∈
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} (x_i \in X_i)_{i \in I}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              with the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi j
                                %mo ∈
                                %mi I
                            %msub
                              %mi X
                              %mi j
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi pr
                                  %mi i
                          %mtd
                            %msub
                              %mi X
                              %mi i
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi j
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi j
                                %mo ∈
                                %mi I
                          %mtd
                            %mover
                              %mo ↦
                              %mrow
                                %mphantom
                                  %mi AA
                                %mphantom
                                  %mi AA
                          %mtd
                            %msub
                              %mi x
                              %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{j \in I}{\prod} X_j &amp;\overset{pr_i}{\longrightarrow}&amp; X_i
                    \\\
                    (x_j)_{j \in I} &amp; \overset{\phantom{AA}  \phantom{AA} }{\mapsto} &amp; x_i
                    }
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#TopologicalSubspaceInitial"}
              and def.
              = succeed "," do
                %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
              %a.existingWikiWord{:href => "/nlab/show/coarse+topology"} coarsest
              topology such that the
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} pr_i(U)
              of open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U \subset X_i
              under these projection maps are open. Now one such pre-image is a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of open subsets of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi j
                          %mo ∈
                          %mi I
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %mi i
                          %mo{:stretchy => "false"} }
                      %msub
                        %mi X
                        %mi j
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi j
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_i^{-1}(U_i)
                    \\;=\;
                    U_i
                    \\times
                    \\left(
                    \\underset{j \in I \setminus \{i\}}{\prod} X_j
                    \\right)
                    \\; \subset \;
                    \\underset{j \in I}{\prod} X_j
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coarse+topology"} coarsest topology
              that contains these open subsets ist that generated by these subsets regarded as a
              %a.existingWikiWord{:href => "/nlab/show/topological+base"} sub-basis for the topology
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologyBase"}
            %p
              Observe that a binary intersection of these generating open is (for
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≠
                      %mi j
                    %annotation{:encoding => "application/x-tex"} i \neq j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msubsup
                      %mi p
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msub
                      %mi U
                      %mi j
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi k
                          %mo ∈
                          %mi I
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %mi i
                          %mo .
                          %mi j
                          %mo{:stretchy => "false"} }
                      %msub
                        %mi X
                        %mi k
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    p_i^{-1}(U_i)
                    \\cap
                    p_j^{-1}(U_j)
                    \\;\simeq\;
                    U_i \times U_j
                    \\times
                    \\left(
                    \\underset{k \in I \setminus \{i.j\}}{\prod} X_k
                    \\right)
            %p
              and generally for a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∩
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                          %mo ⊂
                          %mi I
                      %msub
                        %mi U
                        %mi j
                      %mo )
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                          %mo ∖
                          %mi J
                      %msub
                        %mi X
                        %mi i
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{j \in J \subset I}{\cap} p_i^{-1}(U_i)
                    \\;=\;
                    \\left(
                    \\underset{j \in J \subset I}{\prod} U_j
                    \\right)
                    \\times
                    \\left(
                    \\underset{i \in I\setminus J}{\prod} X_i
                    \\right)
                    \\,.
            %p
              Therefore the open subsets of the product topology are unions of those of this form. Hence the product topology is equivalently that generated by these subsets when regarded as a
              %a.existingWikiWord{:href => "/nlab/show/basis+for+the+topology"} basis for the topology
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologyBase"}
            %p
              This is also known as the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
            %p
              Notice the subtlety: Naively we could have considered as open subsets the unions of products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod}U_i
              of open subsets of the factors, without the constraint that only finitely many of them differ from the corresponding total space. This also defines a topology, called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/box+topology"} box topology
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite index set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              the box topology coincides with the product space (Tychonoff) topology, but for non-finite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              it is strictly
              %a.existingWikiWord{:href => "/nlab/show/fine+topology"} finer
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologyFinerCoarser"}
          #CantorSpace.num_example
            %h6#example_73 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cantor+space"}> Cantor space
                )
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(\{0,1\})
              for the the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              with two points (example
              = succeed ")." do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{n \in \mathbb{N}}{\prod} Disc(\{0,2\})
              for the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable set
              of copies of this discrete space with itself (i.e. thehight corresponding
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \underset{n \in \mathbb{N}}{\prod} \{0,1\}
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
              induced from the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
              of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0,1\}
            %p
              Notice that due to the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
              %em not
              itself discrete.
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi n
                                %mo ∈
                                %mi ℕ
                          %mtd
                            %mover
                              %mo ⟶
                              %mi κ
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi a
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo ∈
                                %mi ℕ
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAAA
                          %mtd
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 0
                              %mn ∞
                            %mfrac
                              %mrow
                                %mn 2
                                %msub
                                  %mi a
                                  %mi i
                              %mrow
                                %msup
                                  %mn 3
                                  %mrow
                                    %mi i
                                    %mo +
                                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{n \in \mathbb{N}}{\prod}
                    \&amp;\overset{\kappa}{\longrightarrow}&amp;
                    [0,1]
                    \\\
                    (a_i)_{i \in \mathbb{N}}
                    \&amp;\overset{\phantom{AAAA}}{\mapsto}&amp;
                    \\underoverset{i = 0}{\infty}{\sum} \frac{2 a_i}{ 3^{i+1}}
                    }
            %p
              which sends an element in the product space, hence a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of binary digits, to the value of the
              %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
              as shown on the right.
            %p
              One checks that this is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (from the
              %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              to the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              on the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \kappa\left( \underset{n \in \mathbb{N}}{\prod} \{0,1\}\right) \subset [0,1]
              equipped with its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              onto its image:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ≃
                        %mphantom
                          %mi AA
                    %mi κ
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAAA
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{n \in \mathbb{N}}{\prod} Disc(\{0,1\})
                    \\overset{\phantom{AA}\simeq\phantom{AA}}{\longrightarrow}
                    \\kappa\left(
                    \\underset{n \in \mathbb{N}}{\prod} Disc(\{0,1\})
                    \\right)
                    \\overset{\phantom{AAAA}}{\hookrightarrow}
                    [0,1]
                    \\,.
            %p
              This image is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cantor+space"} Cantor space
          #EqualizerInTop.num_example
            %h6#example_74 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#Equalizer"}
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f, g \colon (X,\tau_X) \stackrel{\longrightarrow}{\longrightarrow} (Y,\tau_Y)
              is the equalizer of the underlying functions of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi eq
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AA
                    %mi X
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi g
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi f
                          %mphantom
                            %mi AA
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    eq(f,g)
                    \\overset{\phantom{AA}}{\hookrightarrow}
                    X
                    \\underoverset
                    {\underset{\phantom{AA}g\phantom{AA}}{\longrightarrow}}
                    {\overset{\phantom{AA}f\phantom{AA}}{\longrightarrow}}
                    {}
                    Y
            %p
              (hence the largest subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              on which both functions coincide) and equipped with the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#SubspaceTopology"}
          #CoequalizerInTop.num_example
            %h6#example_75 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              of two
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f, g \colon (X,\tau_X) \stackrel{\longrightarrow}{\longrightarrow} (Y,\tau_Y)
              is the coequalizer of the underlying functions of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi g
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi f
                          %mphantom
                            %mi AA
                    %mi Y
                    %mover
                      %mo ⟶
                      %mphantom
                        %mi AA
                    %mi coeq
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\underoverset
                    {\underset{\phantom{AA}g\phantom{AA}}{\longrightarrow}}
                    {\overset{\phantom{AA}f\phantom{AA}}{\longrightarrow}}
                    {}
                    Y
                    \\overset{\phantom{AA}}{\longrightarrow}
                    coeq(f,g)
            %p
              (hence the
              %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
              by the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              generated by the
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) \sim g(x)
              for all
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              = succeed "." do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
          #ClosedSubspacesGluing.num_example
            %h6#example_76 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/union"} union
                of two
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                or two
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              be
              %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A,B \subset X
                  are both
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  or are both
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %li
                %p
                  they constitute a
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/cover"} cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mi A
                        %mo ∪
                        %mi B
                      %annotation{:encoding => "application/x-tex"} X = A \cup B
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_A \colon A \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi B
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_B \colon B \to X
              for the corresponding inclusion
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ∩
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi A
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mi B
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \cap B &amp;\longrightarrow&amp; A
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow^{\mathrlap{i_A}}
                    \\\
                    B &amp;\underset{i_B}{\longrightarrow}&amp; X
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              square in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#Pushout"}
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              this means in particular that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              then a function of underlying sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              as soon as its two restrictions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi Y
                    %mphantom
                      %mi AAAA
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f\vert_A \;\colon\; A \longrightarrow Y
                    \\phantom{AAAA}
                    f\vert_A \;\colon\; B \longrightarrow Y
            %p are continuous.
            %p
              More generally if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by an arbitrary set of
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              or by a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              is continuous precisely if all its restrictions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                  %annotation{:encoding => "application/x-tex"} f\vert_{U_i}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              are continuous.
          .proof
            %h6#proof_37 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#SetLimits"}
              the underlying diagram of underlying
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              is clearly a pushout in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed "," do
                %a.maruku-ref{:href => "#DescriptionOfLimitsAndColimitsInTop"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi i
                        %mi A
                      %mo ,
                      %msub
                        %mi i
                        %mi B
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{i_A, i_B\}
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              (restrictions)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mi A
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo ∩
                    %mi A
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %msubsup
                      %mi i
                      %mi B
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo ∩
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    i_A^{-1}(S) = S \cap A
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    i_B^{-1}(S) = S \cap B
            %p
              are open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              Now by definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is open, then the intersections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open in these subspaces.
            %p
              Conversely, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open. We need to show that then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is open.
            %p
              Consider now first the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ;
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A;B \subset X
              are both open open. Then by the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S
              is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              means that there is an open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_A \subset X
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∩
                      %mi S
                      %mo =
                      %mi A
                      %mo ∩
                      %msub
                        %mi S
                        %mi A
                    %annotation{:encoding => "application/x-tex"} A \cap S = A \cap S_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %msub
                      %mi S
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S_A
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S
              is open. Similarly
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∩
                      %mi S
                    %annotation{:encoding => "application/x-tex"} B \cap S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo =
                            %mi S
                            %mo ∩
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi S
                            %mo ∩
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∪
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ∩
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ∩
                            %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S
                    \&amp; =
                    S \cap X
                    \\\
                    \&amp; = S \cap (A \cup B)
                    \\\
                    \&amp; =  (S \cap A) \cup (S \cap B)
                    \\end{aligned}
            %p is the union of two open subsets and therefore open.
            %p
              Now consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              are both closed subsets.
            %p
              Again by the nature of the subspace topology, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open means that there exist open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi A
                    %mo ,
                    %msub
                      %mi S
                      %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_A, S_B \subset X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo =
                    %mi A
                    %mo ∩
                    %msub
                      %mi S
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S = A \cap S_A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∩
                      %mi S
                      %mo =
                      %mi B
                      %mo ∩
                      %msub
                        %mi S
                        %mi B
                    %annotation{:encoding => "application/x-tex"} B \cap S = B \cap S_B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              are closed by assumption, this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∖
                    %mi S
                    %mo ,
                    %mi B
                    %mo ∖
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \setminus S, B \setminus S \subset X
              are still closed, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
