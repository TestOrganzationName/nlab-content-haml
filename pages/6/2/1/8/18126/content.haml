          %p
            Above we have seen that open subspace of compact Hausdorff spaces are locally compact Hausdorff spaces. Now we prepare to show the converse, namely that every locally compact Hausdorff spaces arises as an open subspace of a compact Hausdorff space. That compact Hausdorff space is its “
            %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"}> one-point compactification
            ”:
          #OnePointExtension.num_defn
            %h6#definition_53 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"}> one-point compactification
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %em
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X^*
              is the topological space
            %ul
              %li
                %p
                  whose underlying
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∪
                        %mo{:stretchy => "false"} {
                        %mn ∞
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} X \cup \{\infty\}
              %li
                %p
                  and whose
                  %a.existingWikiWord{:href => "/nlab/show/open+sets"} open sets
                  are
                %ol
                  %li
                    %p
                      the open subsets of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                      (thought of as subsets of
                      = succeed ");" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
