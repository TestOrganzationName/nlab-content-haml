                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %p
              Then an
              %em inner product
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
            %ul
              %li
                %p
                  a vector bundle
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi E
                        %msub
                          %mo ⊗
                          %mi X
                        %mi E
                        %mo ⟶
                        %mi X
                        %mo ×
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"}
                        \\langle -,-\rangle
                        \\;\colon\;
                        E \otimes_X E
                        \\longrightarrow
                        X \times \mathbb{R}
                %p
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  with itself to the trivial
                  %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            %p such that
            %ul
              %li
                %p
                  for each point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  the function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
