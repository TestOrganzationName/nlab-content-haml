              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#SpheresAndDisks"}
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; S^{n-1} \longrightarrow X
            %p
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %a.existingWikiWord{:href => "/nlab/show/space+attachment"} space attachment
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#PushoutInTop"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ∪
                      %mi ϕ
                    %msup
                      %mi D
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    X \cup_\phi D^n \,\in Top
            %p
              is the topological space which is the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of the boundary inclusion of the
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ϕ
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %msub
                              %mo ∪
                              %mi ϕ
                            %msup
                              %mi D
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\stackrel{\phi}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    D^n &amp;\longrightarrow&amp; X \cup_\phi D^n
                    }
                    \\,.
          .num_example
            %h6#example_79 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
                from 0-cell
                %a.existingWikiWord{:href => "/nlab/show/space+attachment"} attachment
                to the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
            %p
              A single cell
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attachment
              of a 0-cell, according to example
              %a.maruku-ref{:href => "#SingleCellAttachment"}
              is the same as forming the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \sqcup \ast
              with the
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo =
                            %mi ∅
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∃
                                %mo !
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi D
                              %mn 0
                            %mo =
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %mo ⊔
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (S^{-1} = \emptyset) &amp;\overset{\exists !}{\longrightarrow}&amp;  X
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    (D^0 = \ast) &amp;\longrightarrow&amp; X \sqcup \ast
                    }
                    \\,.
            %p
              In particular if we start with the
              %a.existingWikiWord{:href => "/nlab/show/empty+topological+space"} empty topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} X = \emptyset
              itself (example
              = succeed ")," do
                %a.maruku-ref{:href => "#Point"}
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching
              0-cells we obtain a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
          #CellAttachments.num_defn
            %h6#definition_36 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/space+attachment"} attaching
                many cells at once)
            %p
              If we have a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/attaching+maps"} attaching maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mi i
                        %mo −
                        %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{S^{n_i-1} \overset{\phi_i}{\longrightarrow} X\}_{i \in I}
              (as in def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SingleCellAttachment"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of their
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              spheres
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mi i
                        %mo −
                        %mn 1
                    %mo ⟶
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\phi_i)_{i \in I}
                    \\;\colon\;
                    \\underset{i \in I}{\sqcup}
                    S^{n_i-1}
                    \\longrightarrow
                    X
                    \\,.
            %p
              Then the result of attaching
              %em all
              the corresponding
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the pushout of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of boundary inclusions:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ϕ
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %msub
                              %mo ∪
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ϕ
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                            %mrow
                              %mo (
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mi n
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\sqcup} S^{n_i - 1}
                    \&amp;\overset{(\phi_i)_{i \in I}}{\longrightarrow}&amp;
                    X
                    \\\
                    \\downarrow
                    \&amp;(po)&amp;
                    \\downarrow
                    \\\
                    \\underset{i \in I}{\sqcup} D^n
                    \&amp;\longrightarrow&amp;
                    X \cup_{(\phi_i)_{i \in I}} \left(\underset{i \in I}{\sqcup} D^n\right)
                    }
                    \\,.
          %p Apart from attaching a set of cells all at once to a fixed base space, we may “attach cells to cells” in that after forming a given cell attachment, then we further attach cells to the resulting attaching space, and ever so on:
          #RelativeCellComplexes.num_defn
            %h6#definition_37 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a topological space, then A
              %em
                topological
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              of countable height based on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              and a
              %a.existingWikiWord{:href => "/nlab/show/sequential+diagram"} sequential diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mn 2
                    %mo ↪
                    %msub
                      %mi X
                      %mn 3
                    %mo ↪
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    X = X_0 \hookrightarrow X_1 \hookrightarrow X_2 \hookrightarrow X_3 \hookrightarrow \cdots
            %p such that
            %ol
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi k
                        %mo ↪
                        %msub
                          %mi X
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} X_k \hookrightarrow X_{k+1}
                  is exhibited as a cell attachment according to def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#CellAttachments"}
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  diagram of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %munder
                                  %mo ⊔
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                                %msup
                                  %mi S
                                  %mrow
                                    %msub
                                      %mi n
                                      %mi i
                                    %mo −
                                    %mn 1
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi ϕ
                                      %mi i
                                    %msub
                                      %mo{:stretchy => "false"} )
                                      %mrow
                                        %mi i
                                        %mo ∈
                                        %mi I
                              %mtd
                                %msub
                                  %mi X
                                  %mi k
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi po
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %munder
                                  %mo ⊔
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                                %msup
                                  %mi D
                                  %mrow
                                    %msub
                                      %mi n
                                      %mi i
                              %mtd
                                %mo ⟶
                              %mtd
                                %msub
                                  %mi X
                                  %mrow
                                    %mi k
                                    %mo +
                                    %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\underset{i \in I}{\sqcup} S^{n_i - 1}
                        \&amp;\overset{(\phi_i)_{i \in I}}{\longrightarrow}&amp;
                        X_k
                        \\\
                        \\downarrow
                        \&amp;(po)&amp;
                        \\downarrow
                        \\\
                        \\underset{i \in I}{\sqcup} D^{n_i}
                        \&amp;\longrightarrow&amp;
                        X_{k+1}
                        }
                        \\,.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo =
                        %munder
                          %mo ∪
                          %mrow
                            %mi k
                            %mo ∈
                            %mi ℕ
                        %msub
                          %mi X
                          %mi k
                      %annotation{:encoding => "application/x-tex"} Y = \underset{k\in \mathbb{N}}{\cup} X_k
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/union"} union
                  of all these cell attachments, and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  is the canonical inclusion; or stated more abstractly: the map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  is the inclusion of the first component of the diagram into its
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimiting cocone
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %munder
                              %mi lim
                              %mo ⟶
                            %mi k
                          %msub
                            %mi X
                            %mi k
                        %annotation{:encoding => "application/x-tex"} \underset{\longrightarrow}{\lim}_k X_k
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi X
                                %mo =
                                %msub
                                  %mi X
                                  %mn 0
                              %mtd
                                %mo ⟶
                              %mtd
                                %msub
                                  %mi X
                                  %mn 1
                              %mtd
                                %mo ⟶
                              %mtd
                                %msub
                                  %mi X
                                  %mn 2
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi ⋯
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi f
                                %mo ↘
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mi ⋯
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi Y
                                %mo =
                                %munder
                                  %mi lim
                                  %mo ⟶
                                %msub
                                  %mi X
                                  %mo •
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X = X_0 &amp;\longrightarrow&amp; X_1 &amp;\longrightarrow&amp; X_2 &amp;\longrightarrow&amp; \cdots
                        \\\
                        \&amp; {}_{\mathllap{f}}\searrow &amp; \downarrow &amp; \swarrow &amp;&amp; \cdots
                        \\\
                        \&amp;&amp; Y = \underset{\longrightarrow}{\lim} X_\bullet
                        }
            %p
              If here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} X = \emptyset
              is the
              %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
              then the result is a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ↪
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \emptyset \hookrightarrow Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              built form “attaching cells to nothing”. This is then called just a
              %em
                topological
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              of countable height.
            %p
              Finally, a topological (relative) cell complex of countable height is called a
              %strong CW-complex
              is the
              = succeed "-st" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi k
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_k \to X_{k+1}
              is entirely by
              = succeed "-cells," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi S
                              %mi k
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ϕ
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                          %mtd
                            %msub
                              %mi X
                              %mi k
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi D
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i \in I}{\sqcup} S^{k}
                    \&amp;\overset{(\phi_i)_{i \in I}}{\longrightarrow}&amp;
                    X_k
                    \\\
                    \\downarrow
                    \&amp;(po)&amp;
                    \\downarrow
                    \\\
                    \\underset{i \in I}{\sqcup} D^{k+1}
                    \&amp;\longrightarrow&amp;
                    X_{k+1}
                    }
                    \\,.
            %p
              Given a CW-complex, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              is also called its
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/finite+CW-complex"} finite CW-complex
              is one which admits a presentation in which there are only finitely many attaching maps, and similarly a
              %em countable CW-complex
              is one which admits a presentation with countably many attaching maps.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#subspaces Subspaces
          %p
            We discuss special classes of
            %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            that play an important role in the theory, in particular for the discussion of
            %a.existingWikiWord{:href => "/nlab/show/topological+manifolds"} topological manifolds
            = succeed ":" do
              %a{:href => "#Manifolds"} below
          %ol
            %li
              %p
                %em
                  %a{:href => "#ConnectedComponents"} Connected components
            %li
              %p
                %em
                  %a{:href => "#Embeddings"} Embeddings
          %h3#ConnectedComponents Connected components
          %p
            Via
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            to
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union+spaces"} disjoint union spaces
            one may characterize whether topological spaces are
            %em
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+spaces"} connected
            (def.
            %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
            below), and one may decompose every topological space into its
            %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            (def.
            %a.maruku-ref{:href => "#ComponentsConnected"}
            below).
          %p
            The important subtlety in to beware of is that a topological space is
            %em not
            in general the disjoint union space of its connected components. The extreme case of this phenomenon are
            %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+spaces"} totally disconnected topological spaces
            (def.
            %a.maruku-ref{:href => "#TotallyDisconnectedTopologicalSpace"}
            below) which are nevertheless not
            %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete
            (examples
            %a.maruku-ref{:href => "#RationalNumbersAreTotallyDisconnected"}
            and
            %a.maruku-ref{:href => "#TotallyDisconnectedCantorSpace"}
            below). Spaces which are free from this exotic behaviour include the
            %em
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+spaces"} locally connected topological spaces
            (def.
            %a.maruku-ref{:href => "#LocallyConnected"}
            below) and in particular the
            %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+spaces"} locally path-connected topological spaces
            (def.
            %a.maruku-ref{:href => "#ForLocallyPathConnectedThenPathConnectedComponentsAgree"}
            below).
          #ConnectedTopologicalSpace.num_defn
            %h6#definition_38 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"}> connected topological space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              if the following equivalent conditions hold:
            %ol
              %li
                %p
                  For all pairs of topological spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi τ
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi τ
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X_1, \tau_1), (X_2, \tau_2)
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X, \tau)
                  is
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Homeomorphism"}
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi τ
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⊔
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi τ
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (X,\tau) \simeq (X_1,\tau_1) \sqcup (X_2,\tau_2)
                %p
                  then exactly one of the two spaces is the
                  %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
                  (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#Point"}
              %li
                %p
                  For all pairs of
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ,
                        %msub
                          %mi U
                          %mn 2
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U_1, U_2 \subset X
                  if
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ∪
                        %msub
                          %mi U
                          %mn 2
                        %mo =
                        %mi X
                        %mphantom
                          %mi A
                        %mtext and
                        %mphantom
                          %mi A
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"}
                        U_1 \cup U_2 = X \phantom{A}\text{and} \phantom{A} U_1 \cap U_2 = \emptyset
                %p
                  then exactly one of the two subsets is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
              %li
                %p
                  if a
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CO
                        %mo ⊆
                        %mi X
                      %annotation{:encoding => "application/x-tex"} CO \subseteq X
                  is both an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedSubset"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CO
                        %mo =
                        %mi X
                      %annotation{:encoding => "application/x-tex"} CO = X
                  if and only if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CO
                      %annotation{:encoding => "application/x-tex"} CO
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
          .num_prop
            %h6#lemma_10 Lemma
            %p
              The conditions in def.
              %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              are indeed equivalent.
          .proof
            %h6#proof_38 Proof
            %p First consider the equivalence of the first two statements:
            %p
              Suppose that in every disjoint union decomposition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              exactly one summand is empty. Now consider two disjoint open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \subset X
              whose union is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and whose intersection is empty. We need to show that exactly one of the two subsets is empty.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi τ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U_1, \tau_{1})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U_2, \tau_2)
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+subspaces"} topological subspaces
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi τ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq (U_1, \tau_1) \sqcup (U_2, \tau_2)
            %p
              because by assumption every open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              is the disjoint union of open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} U_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mi U
                    %mo ∩
                    %mi X
                    %mo =
                    %mi U
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊔
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ∩
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    U = U \cap X = U \cap (U_1 \sqcup U_2) = (U \cap U_1) \sqcup (U \cap U_2)
                    \\,,
            %p which is the definition of the disjoint union topology.
            %p
              Hence by assumption exactly one of the two summand spaces is the
              %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
              and hence the underlying set is the empty set.
            %p
              Conversely, suppose that for every pair of open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \subset U
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∪
                    %msub
                      %mi U
                      %mn 2
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_1 \cup U_2 = X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 = \emptyset
              then exactly one of the two is empty. Now consider a homeomorphism of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 1
                      %mo ,
                      %msub
                        %mi τ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⊔
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 2
                      %mo ,
                      %msub
                        %mi τ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau) \simeq (X_1, \tau_1) \sqcup (X_2,\tau_2)
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 2
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_1, X_2 \subset X
              are disjoint open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p Now regarding the equivalence to the third statement:
            %p
              If a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CO
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} CO \subset X
              is both closed and open, this means equivalently that it is open and that its
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi CO
                  %annotation{:encoding => "application/x-tex"} X \setminus CO
              is also open, hence equivalently that there are two open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CO
                    %mo ,
                    %mi X
                    %mo \
                    %mi CO
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} CO, X \backslash CO \subset X
              whose union is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and whose intersection is empty. This way the third condition is equivalent to the second, hence also to the first.
          .num_remark
            %h6#remark_13 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
                is not
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %p
              According to def.
              %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              the
              %a.existingWikiWord{:href => "/nlab/show/empty+topological+space"} empty topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Point"}
              %em not
              connected, since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ≃
                      %mi ∅
                      %mo ⊔
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset \simeq \emptyset \sqcup \emptyset
            %p
              Of course it is immediate to change def.
              %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              so that it would regard the empty space as connected. This is a matter of convention.
          #ConnectedSubspacesOfRealLineAreTheIntervals.num_example
            %h6#example_80 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
                of the
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                are the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/intervals"} intervals
            %p
              Regard the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{R}
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ∈
                        %mi S
                        %mo ⊂
                        %mi ℝ
                    %munder
                      %mo ∀
                      %mrow
                        %mi r
                        %mo ∈
                        %mi ℝ
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mi x
                        %mo &lt;
                        %mi r
                        %mo &lt;
                        %mi y
                        %mo )
                      %mo ⇒
                      %mrow
                        %mo (
                        %mi r
                        %mo ∈
                        %mi S
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{x,y \in S \subset \mathbb{R}}{\forall}
                    \\underset{ r \in \mathbb{R}  }{\forall}
                    \\left(
                    \\left(
                    x \lt r \lt y
                    \\right)
                    \\Rightarrow
                    \\left(
                    r \in S
                    \\right)
                    \\right)
                    \\,.
          .proof
            %h6#proof_39 Proof
            %p
              Suppose on the contrary that we had
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi r
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \lt r \lt y
              but
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∉
                      %mi S
                    %annotation{:encoding => "application/x-tex"} r \notin S
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              there would be a decomposition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              as a
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mrow
                      %mo (
                      %mi S
                      %mo ∩
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⊔
                    %mrow
                      %mo (
                      %mi S
                      %mo ∩
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn ∞
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S
                    \=
                    \\left(
                    S \cap (r,\infty)
                    \\right)
                    \\sqcup
                    \\left(
                    S \cap (-\infty,r)
                    \\right)
                    \\,.
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"} x \lt r
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo &lt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} r \lt y
              both these open subsets were
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is connected. This yields a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          #ContinuousImagesOfConnectedSpacesAreConnected.num_prop
            %h6#proposition_37 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                %a.existingWikiWord{:href => "/nlab/show/images"} images
                of
                %a.existingWikiWord{:href => "/nlab/show/connected+spaces"} connected spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ContinuousMaps"}
              %a.existingWikiWord{:href => "/nlab/show/image"} image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munderover
                      %mo ⟶
                      %mi surjective
                      %mi p
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mi injective
                      %mi i
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \underoverset{surjective}{p}{\longrightarrow} f(X) \underoverset{injective}{i}{\longrightarrow} Y
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X)
              equipped either with he
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              relative to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              or the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              relative to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#ImageFactorization"}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(X)
            %p
              In particular connectedness is a
              %a.existingWikiWord{:href => "/nlab/show/topological+property"} topological property
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Homeomorphism"}
          .proof
            %h6#proof_40 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_1,U_2 \subset f(X)
              be two
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∪
                    %msub
                      %mi U
                      %mn 2
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_1 \cup U_2 = f(X)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 = \emptyset
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p^{-1}(U_1), p^{-1}(U_2) \subset X
              are open subsets and are still disjoint. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is
              %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
              it also follows that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p^{-1}(U_1) \cup p^{-1}(U_2) = X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is connected, it follows that one of these two pre-images is the empty set. But again sicne
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is surjective, this implies that precisely one of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_1, U_2
              is empty, which means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X)
              is connected.
          %p
            This yields yet another quick proof via
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            of a classical fact of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
          #IntermediateValueTheorem.num_prop
            %h6#corollary Corollary
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/intermediate+value+theorem"}> intermediate value theorem
                )
            %p
              Regard the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              with their
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} [a,b] \subset \mathbb{R}
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#SubspaceTopology"}
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousMaps"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f \colon [a,b] \longrightarrow \mathbb{R}
            %p
              takes every value in between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(a)
              and f(b).
          .proof
            %h6#proof_41 Proof
            %p
              By example
              %a.maruku-ref{:href => "#ConnectedSubspacesOfRealLineAreTheIntervals"}
              the interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a,b]
              is connected. By prop.
              %a.maruku-ref{:href => "#ContinuousImagesOfConnectedSpacesAreConnected"}
              also its image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f([a,b]) \subset \mathbb{R}
              is connected. By example
              %a.maruku-ref{:href => "#ConnectedSubspacesOfRealLineAreTheIntervals"}
              that image is hence itself an interval. This implies the claim.
          #ProductSpaceOfConnectedSpacesIsConnected.num_example
            %h6#example_81 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
                of
                %a.existingWikiWord{:href => "/nlab/show/connected+spaces"} connected spaces
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              be a set of
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+spaces"} connected topological spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod}X_i
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
          .proof
            %h6#proof_42 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \subset \underset{i \in I}{\prod}X_i
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of the product space by two disjoint open subsets. We need to show that precisely one of the two is empty. Since each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} X_i
              is connected and hence non-empty, the product space is not empty, and hence it is sufficient to show that at least one of the two is empty.
            %p
              Assume on the contrary that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_2
              were non-empty.
            %p
              Observe first that if so, then we could find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo ∈
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1 \in U_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                    %mo ∈
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2 \in U_2
              whose coordinates differed only in a finite subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \pi_i(U_1) = X_i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \pi_i(U_2) = X_i
              for all but a finite number of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i \in i
            %p
              Next observe that we then could even find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ′
                      %mn 1
                    %mo ∈
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x'_1 \in U_1
              that differed only in a single coordinate from
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              differs from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
              and change it to the corresponding coordinate of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_2
              are a cover, the resulting point is either in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_1
              or in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} U_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} U_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              already differed in only one coordinate from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
              and we may take
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ′
                        %mn 1
                      %mo ≔
                      %msub
                        %mi x
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x'_1 \coloneqq x_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} U_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              and repeat the argument. By
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              this finally yields an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ′
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x'_1
              as claimed.
            %p
              Therefore it is now sufficient to see that it leads to a contradiction to assume that there are points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo ∈
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1 \in U_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                    %mo ∈
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2 \in U_2
              that differ in only the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} i_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i_0 \in I
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                      %mo =
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x_1 = x_2
            %p Observe that the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \colon X_{i_0} \longrightarrow \underset{i \in I}{\prod} X_i
            %p
              which is the identity on the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} i_0
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              or equivalently of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
              is a continuous function, by the nature of the
              %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
            %p
              Therefore also the restrictions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota^{-1}(U_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota^{-1}(U_2)
              are open subsets. Moreover they are still disjoint and cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} X_{i_0}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} X_{i_0}
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} i_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
              must be in the other subset of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} X_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
              must both be in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_1
              or both in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} U_2
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            While topological spaces are not always connected, they always decompose
            %em at least as sets
            into their connected components:
          #ComponentsConnected.num_defn
            %h6#definition_39 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/connected+components"}> connected components
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %em
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              are the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              under the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which regards two points as equivalent if they both sit in some
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              which, as a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∼
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mrow
                          %mi U
                          %mo ⊂
                          %mi X
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %mi x
                          %mo ,
                          %mi y
                          %mo ∈
                          %mi U
                          %mo )
                        %mphantom
                          %mi A
                        %mtext and
                        %mphantom
                          %mi A
                        %mrow
                          %mo (
                          %mi U
                          %mspace{:width => "thinmathspace"}
                          %mtext is connected
                          %mo )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x \sim y)
                    \\;\coloneqq\;
                    \\left(
                    \\underset{ U \subset X  }{\exists}
                    \\left(
                    \\left( x,y \in U \right)
                    \\phantom{A}\text{and}\phantom{A}
                    \\left( U \, \text{is connected} \right)
                    \\right)
                    \\right)
                    \\,.
            %p
              Equivalently, the connected components are the
              %a.existingWikiWord{:href => "/nlab/show/maximal+elements"} maximal elements
              in the
              %a.existingWikiWord{:href => "/nlab/show/pre-ordered+set"} pre-ordered set
              of connected
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
          #DisjointUnionConnectedComponents.num_example
            %h6#example_82 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union+spaces"} disjoint union spaces
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              an
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+spaces"} connected topological spaces
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComponentsConnected"}
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\sqcup}X_i
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
          %p
            In general the situation is more complicated than in example
            = succeed "," do
              %a.maruku-ref{:href => "#DisjointUnionConnectedComponents"}
            %a.maruku-ref{:href => "#RationalNumbersAreTotallyDisconnected"}
            and
            %a.maruku-ref{:href => "#TotallyDisconnectedCantorSpace"}
            below. But first notice some basic properties of connected components:
          #ClosureOfConnectedSubspaceIsConnected.num_prop
            %h6#proposition_38 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
                of
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              which, as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Cl(S) \subset X
              is connected
          .proof
            %h6#proof_43 Proof
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo ⊔
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Cl(S) = A \sqcup B
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subsets"} disjoint
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            %p
              But also the intersections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S\,,B \cap S \subset S
              are disjoint subsets, open as subsets of the subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∩
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ⊔
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ∩
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S = (A \cap S) \sqcup (B \cap S)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} B \cap S
              is empty. Assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} B \cap S
              is empty, otherwise rename. Hence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∩
                      %mi S
                      %mo =
                      %mi S
                    %annotation{:encoding => "application/x-tex"} A \cap S = S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊂
                      %mi A
                    %annotation{:encoding => "application/x-tex"} S \subset A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              this means that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊂
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi B
                    %annotation{:encoding => "application/x-tex"} S \subset Cl(S) \setminus B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is open,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Cl(S) \setminus B
              is still closed, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (S \subset Cl(S) \setminus B)
                    \\Rightarrow
                    (Cl(S) \subset Cl(S) \setminus B)
                    \\,.
            %p
              This means that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} B = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(S)
              is connected.
          #ConnectedComponentsAreClosed.num_prop
            %h6#proposition_39 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComponentsConnected"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
          .proof
            %h6#proof_44 Proof
            %p
              By definition, the connected components are
              %a.existingWikiWord{:href => "/nlab/show/maximal+elements"} maximal elements
              in the set of connected subspaces
              %a.existingWikiWord{:href => "/nlab/show/preorder"} pre-ordered
              by inclusion. Assume a connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              were not closed. By prop.
              %a.maruku-ref{:href => "#ClosureOfConnectedSubspaceIsConnected"}
              its closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(U)
              is still closed, and would be strictly larger, contradicting the maximality of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          .num_remark
            %h6#remark_14 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#ConnectedComponentsAreClosed"}
              implies that when a space has a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              of connected components, then they are not just closed but also open, hence
              %a.existingWikiWord{:href => "/nlab/show/clopen+subsets"} clopen subsets
              (because then each is the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of a finite union of closed subspaces). This in turn means that the space is the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of its connected components.
            %p
              For a non-finite set of connected components this remains true if the space is
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
              see def.
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyConnected"}
              %a.maruku-ref{:href => "#AlternativeCharacterizationOfLocalConnectivity"}
              below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p We now highlight the subtlety that not every topological space is the disjoint union of its connected components. For this it is useful to consider the following extreme situation:
          #TotallyDisconnectedTopologicalSpace.num_defn
            %h6#definition_40 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"}> totally disconnected topological space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected
              if all its
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComponentsConnected"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/singletons"} singletons
              %a.existingWikiWord{:href => "/nlab/show/point+spaces"} point spaces
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#ConcreteAndAbstractPoint"}
          %p The trivial class of examples is this:
          .num_example
            %h6#example_83 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
              %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TotallyDisconnectedTopologicalSpace"}
          %p But the important point is that there are non-discrete totally disconnected topological spaces:
          #RationalNumbersAreTotallyDisconnected.num_example
            %h6#example_84 Example
            %p
              %strong
                (the
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                are
                %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected
                but non-
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"}> discrete topological space
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q} \subset \mathbb{R}
              equipped with their
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+space"} totally disconnected space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TotallyDisconnectedTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
          .proof
            %h6#proof_45 Proof
            %p
              It is clear that the subspace topology is not discrete, since the
              %a.existingWikiWord{:href => "/nlab/show/singletons"} singletons
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi q
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \{q\} \subset \mathbb{Q}
              are not
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              (because their
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              are still singletons, and the points in a
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              are closed, by example
              %a.maruku-ref{:href => "#HausdorffMetricSpace"}
              and prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#T1InTermsOfTopologicalClosure"}
            %p
              What we need to see is that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q} \subset \mathbb{R}
              is nevertheless totally disconnected:
            %p
              By construction, a
              %a.existingWikiWord{:href => "/nlab/show/base+for+a+topology"} base for the topology
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologyBase"}
              %a.existingWikiWord{:href => "/nlab/show/open+intervals"} open intervals
              of real numbers to the rational numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℚ
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"}
                    (a,b)_{\mathbb{Q}} \coloneqq (a,b) \cap \mathbb{Q}
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} a \lt b \in \mathbb{R}
            %p
              Now for any such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \lt b
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/irrational+number"} irrational number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi ℝ
                    %mo \
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} r \in \mathbb{R}\backslash \mathbb{Q}
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi r
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \lt r \lt b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi r
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℚ
                    %mo ⊂
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} (a,r)_{\mathbb{Q}} \subset \mathbb{Q}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ,
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℚ
                    %mo ⊂
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} (r,b)_{\mathbb{Q}} \subset \mathbb{Q}
              are disjoint subsets. Therefore every basic open subset is the disjoint union of (at least) two open subsets:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℚ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi r
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℚ
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ,
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℚ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (a,b)_{\mathbb{Q}} = (a,r)_{\mathbb{Q}} \cup (r,b)_{\mathbb{Q}}
                    \\,.
            %p
              Hence no
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
              open subspace of the rational numbers is connected.
          #TotallyDisconnectedCantorSpace.num_example
            %h6#example_85 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cantor+space"} Cantor space
                is
                %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected
                but non-
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"}> discrete
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Cantor+space"} Cantor space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{n \in \mathbb{N}}{\prod} Disc(\{0,1\})
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CantorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+topological+space"} totally disconnected topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TotallyDisconnectedTopologicalSpace"}
              %em not
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
          .proof
            %h6#proof_46 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/base+of+a+topology"} base opens
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologyBase"}
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{n \in \mathbb{N}}{\prod} Disc(\{1,2\})
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                          %mo ⊂
                          %mi ℕ
                      %msub
                        %mi U
                        %mi i
                      %mo )
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                          %mo ∖
                          %mi I
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left( \underset{i \in I \subset \mathbb{N}}{\prod} U_i \right)
                    \\times
                    \\left(
                    \\underset{k \in \mathbb{N}\setminus I}{\prod} \{1,2\}
                    \\right)
                    \\,.
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} I \subset \mathbb{N}
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %p
              First of all this is not the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1,2\}
              as open subsets, hence is strictly
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finer+topology"} finer
            %p
              On the other hand, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} I \subset \mathbb{N}
              is finite,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo ∖
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}\setminus I
              is
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
              and hence there exists some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 0
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k_0 \in \mathbb{N}
              such that the corresponding factor in the above product is the full set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1,2\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi k
                          %mn 0
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi k
                            %mn 0
                          %mo{:stretchy => "false"} }
                          %mo ⊂
                          %mi ℕ
                      %msub
                        %mi U
                        %mi i
                      %mo )
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                          %mo ∖
                          %mo{:stretchy => "false"} (
                          %mi I
                          %mo ∪
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi k
                            %mn 0
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mo{:stretchy => "false"} {
                    %mn 2
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi k
                          %mn 0
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi k
                            %mn 0
                          %mo{:stretchy => "false"} }
                          %mo ⊂
                          %mi ℕ
                      %msub
                        %mi U
                        %mi i
                      %mo )
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                          %mo ∖
                          %mo{:stretchy => "false"} (
                          %mi I
                          %mo ∖
                          %msub
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} k
                            %mn 0
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{1\}_{k_0}
                    \\times
                    \\left(
                    \\underset{i \in I \setminus \{k_0\} \subset \mathbb{N}}{\prod} U_i \right)
                    \\times
                    \\left(
                    \\underset{k \in \mathbb{N}\setminus (I \cup \{k_0\}) }{\prod} \{1,2\}
                    \\right)
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\{2\}_{k_0}
                    \\times
                    \\left(
                    \\underset{i \in I \setminus \{k_0\} \subset \mathbb{N}}{\prod} U_i
                    \\right)
                    \\times
                    \\left(
                    \\underset{k \in \mathbb{N}\setminus (I\setminus \k_0 ) }{\prod} \{1,2\}
                    \\right)
                    \\,.
            %p
              In particular if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≠
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \neq y
              are two distinct points in the original open subset, them being distinct means that there is a smallest
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 0
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k_0 \in \mathbb{N}
              such that they have different coordinates in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1,2\}
              in that position. By the above this implies that they belong to different connected components.
          %p
            In applications to
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            (such as in the definition of
            %a.existingWikiWord{:href => "/nlab/show/topological+manifolds"} topological manifolds
            = succeed ")" do
              %a{:href => "#Manifolds"} below
            %a.maruku-ref{:href => "#RationalNumbersAreTotallyDisconnected"}
            or
            = succeed "," do
              %a.maruku-ref{:href => "#TotallyDisconnectedCantorSpace"}
            %em are
            the disjoint union of their connected components:
          #LocallyConnected.num_example
            %h6#definition_41 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+spaces"}> locally connected topological spaces
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
              if the following equivalent conditions hold:
            %ol
              %li
                %p
                  For every point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  and every
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi x
                        %mo ⊃
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Cn
                            %mi x
                          %mo ⊂
                          %msub
                            %mi U
                            %mi x
                        %annotation{:encoding => "application/x-tex"} Cn_x \subset U_x
              %li
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
                  of every open
                  %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is open.
              %li
                %p
                  Every open
                  %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SubspaceTopology"}
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
                  %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#ComponentsConnected"}
          #AlternativeCharacterizationOfLocalConnectivity.num_lemma
            %h6#lemma_11 Lemma
            %p
              The conditions in def.
              %a.maruku-ref{:href => "#LocallyConnected"}
              are indeed all equivalent.
          .proof
            %h6#proof_47 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              2)
            %p
              Assume every neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              contains a connected neighbourhood and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              be an open subset with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_0 \subset U
              a connected component. We need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} U_0
              is open.
            %p
              Consider any point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} x \in U_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} x \in U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} U_{x,0}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} U_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mo ∪
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} U_0 \cup U_{x,0}
              were a larger open connected open neighbourhood, contradicting the maximality of the connected component
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} U_0
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mo =
                    %munder
                      %mo ∪
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi U
                          %mn 0
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} U_0 = \underset{x \in U_0}{\cup} U_{x,0}
              is a union of open subsets, and hence itself open.
            %p
              2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              3)
            %p
              Now assume that every connected component of every open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is open. Since the connected components generally constitute a
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/disjoint+subsets"} disjoint subsets
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              by disjoint subsets. But by forming intersections with the cover this implies that every open subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is the disjoint union of open subsets of the connected components (and of course every union of open subsets of the connected components is still open in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of the connected components.
            %p
              3)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              1)
            %p
              Finally assume that every open subspace is the disjoint union of its connected components. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              be a point and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              a neighbourhood. We need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              contains a connected neighbourhood of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              But, by definition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              contains an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and by assumption this decomposes as the disjoint union of its connected components. One of these contains
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              all summands are open, this is the required connected open neighbourhood.
          #LocallyConnectedEuclideanSpace.num_example
            %h6#example_86 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyConnected"}
          .proof
            %h6#proof_48 Proof
            %p
              By nature of the Euclidean metric topology, every neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              of a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              contains an
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#OpenBalls"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cube"} cube
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo −
                    %mi ϵ
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{i \in \{1, \cdots, n\}}{\prod} (x_i-\epsilon, x_i + \epsilon)
              of
              %a.existingWikiWord{:href => "/nlab/show/open+intervals"} open intervals
              which is still a neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#ClosedIntervalsProduct"}
            %p
              Now intervals are connected by example
              %a.maruku-ref{:href => "#ConnectedSubspacesOfRealLineAreTheIntervals"}
              and product spaces of connected spaces are connected by example
              = succeed "." do
                %a.maruku-ref{:href => "#ProductSpaceOfConnectedSpacesIsConnected"}
              = succeed "." do
                %a.maruku-ref{:href => "#LocallyConnected"}
          #LocallyConnectedOpenSubspaceOfLocallyConnectedSpace.num_prop
            %h6#proposition_40 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                of
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected space
                is locally connected)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#LocallyConnected"}
          .proof
            %h6#proof_49 Proof
            %p
              This is immediate from the first item of def.
              = succeed "." do
                %a.maruku-ref{:href => "#LocallyConnected"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Another important class of examples of locally connected topological spaces are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+manifolds"} topological manifolds
            %a.maruku-ref{:href => "#LocalPropertiesOfLocallyEuclideanSpace"}
            below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p There is also a concept of connectedness which is “geometric” instead of “purely topological” by definition:
          #Path.num_defn
            %h6#definition_42 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/path"}> path
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %em
                %a.existingWikiWord{:href => "/nlab/show/path"} path
              or
              %em
                continuous
                %a.existingWikiWord{:href => "/nlab/show/curve"} curve
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma \;\colon\; [0,1] \longrightarrow X
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
            %p
              We say that this path
              %em connects
              its endpoints
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \gamma(0), \gamma(1) \in X
          %p The following is obvious, but the construction is important:
          #ConnectedByPathIsEquivalenceRelation.num_lemma
            %h6#lemma_12 Lemma
            %p
              %strong
                (being connected by a
                %a.existingWikiWord{:href => "/nlab/show/path"} path
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Path"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∼
                      %mi pcon
                  %annotation{:encoding => "application/x-tex"} \sim_{pcon}
              on the underlying set of points
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_50 Proof
            %p
              We need to show that the relation is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive
              %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a point, then the
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              with value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo *
                    %mover
                      %mo ⟶
                      %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    const_x \;\colon\; [0,1] \to \ast \overset{}{\longrightarrow} X
            %p
              is continuous (example
              = succeed ")." do
                %a.maruku-ref{:href => "#PointsViaContinuousFunctions"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ∼
                      %mi pcon
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \sim_{pcon} x
              for all points (
              %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"}> reflexivity
              ).
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y \in X
              two points and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma
                    \\;\colon\;
                    [0,1] \longrightarrow X
            %p
              a path connecting them, then the
              %em reverse path
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo −
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mi γ
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    [0,1]
                    \\overset{(1-(-))}{\longrightarrow}
                    [0,1]
                    \\overset{\gamma}{\longrightarrow}
                    X
            %p
              is continuous (the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mn 1
                        %mo −
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1] \overset{1-(-)}{\to} [0,1]
              is continuous because
              %a.existingWikiWord{:href => "/nlab/show/polynomials+are+continuous"} polynomials are continuous
              ). Hence with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ∼
                      %mi pcon
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \sim_{pcon} y
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %msub
                      %mo ∼
