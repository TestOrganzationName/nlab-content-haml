          #StandardStereographicProjection.num_example
            %h6#example_44 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"}> stereographic projection
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then there is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SpheresAndDisks"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p \in S^n
              removed and the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "):" do
                %a.maruku-ref{:href => "#MetricTopology"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ≃
                        %mphantom
                          %mi AA
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n \setminus \{p\} \overset{\phantom{AA}\simeq\phantom{AA}}{\longrightarrow} \mathbb{R}^n
                    \\,.
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/StereographicProjection.png", :width => "300"}/
            %p
              This homeomorphism is given by “
              %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"}> stereographic projection
              ”: One thinks of both the
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              as
              %a.existingWikiWord{:href => "/nlab/show/topological+subspaces"} topological subspaces
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              in the standard way (example
              = succeed ")," do
                %a.maruku-ref{:href => "#SpheresAndDisks"}
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersect
              in the
              %a.existingWikiWord{:href => "/nlab/show/equator"} equator
              of the
              = succeed "-sphere." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p \in S^n
              one of the corresponding poles, then the homeomorphism is the function which sends a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi S
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} x \in S^{n}\setminus \{p\}
              along the line connecting it with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              to the point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              where this line intersects the equatorial plane.
            %p
              In the canonical ambient
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              this
              %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"} stereographic projection
              is given as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ⊃
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %msup
                              %mi S
                              %mi n
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mn 0
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ≃
                                %mphantom
                                  %mi AA
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⊂
                            %msup
                              %mi ℝ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAAA
                          %mtd
                            %mfrac
                              %mn 1
                              %mrow
                                %mn 1
                                %mo −
                                %msub
                                  %mi x
                                  %mn 1
                            %mrow
                              %mo (
                              %mn 0
                              %mo ,
                              %msub
                                %mi x
                                %mn 2
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %msub
                                %mi x
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{n+1} \supset \;\;\;
                    \&amp;
                    S^n \setminus (1,0, \cdots, 0)
                    \&amp;\overset{\phantom{AA} \simeq \phantom{AA}}{\longrightarrow}&amp;
                    \\mathbb{R}^{n}
                    \&amp;
                    \\;\;\;
                    \\subset \mathbb{R}^{n+1}
                    \\\
                    \&amp;
                    (x_1, x_2, \cdots, x_{n+1})
                    \&amp;\overset{\phantom{AAAA}}{\mapsto}&amp;
                    \\frac{1}{1 - x_1}
                    \\left(
                    0 , x_2, \cdots, x_{n+1}
                    \\right)
                    }
                    \\,.
          .proof
            %h6#proof_15 Proof
            %p First consider more generally the stereographic projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo \
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mn .1
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi x
                      %mn 1
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma
                    \\;\colon\;
                    \\mathbb{R}^{n+1} \backslash (1,0,\cdots, 0)
                    \\longrightarrow
                    \\mathbb{R}^n
                    \=
                    \\{x \in \mathbb{R}^{n.1} \,\vert\, x_1 = 0 \}
            %p
              of the entire ambient space minus the point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              onto the equatorial plane, still given by mapping a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to the unique point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              on the equatorial hyperplane such that the points
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              sit on the same straight line.
            %p
              This condition means that there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} d \in \mathbb{R}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p +  d(x-p) = y
                    \\,.
            %p
              Since the only condition on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              is that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} y_1 = 0
              this implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo +
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo −
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_1 + d(x_1-p_1) = 0
                    \\,.
            %p
              This equation has a unique solution for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 1
                        %mo −
                        %msub
                          %mi x
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    d = \frac{1}{1 - x_1}
            %p and hence it follow that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 1
                        %mo −
                        %msub
                          %mi x
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma(x_1, x_2, \cdots, x_{n+1})
                    \=
                    \\frac{1}{1-x_1}(0,x_2, \cdots, x_n)
                    \\,
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/rational+functions+are+continuous"} rational functions are continuous
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#PolynoialsAreContinuous"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is continuous and since the topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo \
                    %mi p
                  %annotation{:encoding => "application/x-tex"} S^n\backslash p
              is the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              under the canonical embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo \
                    %mi p
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo \
                    %mi p
                  %annotation{:encoding => "application/x-tex"} S^n \backslash p \subset \mathbb{R}^{n+1} \backslash p
              it follows that the restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo \
                        %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo \
                    %mi p
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma\vert_{S^n \backslash p}
                    \\;\colon\;
                    S^n\backslash p
                    \\longrightarrow
                    \\mathbb{R}^n
            %p
              is itself a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (because its pre-images are the restrictions of the pre-images of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              to
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo \
                      %mi p
                    %annotation{:encoding => "application/x-tex"} S^n\backslash p
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo \
                        %mi p
                  %annotation{:encoding => "application/x-tex"} \sigma \vert_{S^n \backslash p}
              is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              of the underlying sets we need to show that for every
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %msub
                      %mi y
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (0, y_2, \cdots, y_{n+1})
            %p
              there is a unique
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1, \cdots , x_{n+1})
              satisfying
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi x
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msup
                          %mi S
                          %mi n
                        %mo \
                        %mo{:stretchy => "false"} {
                        %mi p
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} (x_1, \cdots, x_{n+1}) \in S^{n} \backslash \{p\}
                  , hence
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi x
                              %mn 1
                            %mo &lt;
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} x_1 \lt 1
                      ;
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 1
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %mo =
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} \underoverset{i = 1}{n+1}{\sum} (x_i)^2 = 1
                      ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi i
                            %mo ∈
                            %mo{:stretchy => "false"} {
                            %mn 2
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mrow
                          %mo (
                          %msub
                            %mi y
                            %mi i
                          %mo =
                          %mfrac
                            %mrow
                              %msub
                                %mi x
                                %mi i
                            %mrow
                              %mn 1
                              %mo −
                              %msub
                                %mi x
                                %mn 1
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \underset{i \in \{2, \cdots, n+1\}}{\forall} \left(y_i = \frac{x_i}{1-x_1} \right)
                  \.
            %p
              The last condition uniquely fixes the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo ≥
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} x_{i \geq 2}
              in terms of the given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mrow
                        %mi i
                        %mo ≥
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} y_{i \geq 2}
              and the remaining
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo ≥
                        %mn 2
                    %mo =
                    %msub
                      %mi y
                      %mi i
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x_{i \geq 2} = y_i \cdot (1-x_1)
                    \\,.
            %p With this, the second condition says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %msub
                      %mi x
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %munder
                      %munder
                        %mrow
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo =
                              %mn 2
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi y
                            %mi i
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                        %mo ⏟
                      %mrow
                        %msup
                          %mi r
                          %mn 2
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (x_1)^2 + (1-x_1)^2 \underset{r^2}{\underbrace{\underoverset{i = 2}{n+1}{\sum}(y_i)^2}} = 1
            %p hence equivalently that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi r
                      %mn 2
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %msup
                      %mi r
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi x
                      %mn 1
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi r
                      %mn 2
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (r^2 + 1) (x_1)^2 - (2 r^2) x_1 + (r^2 - 1) = 0
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/quadratic+formula"} quadratic formula
              the solutions of this equation are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mn 1
                          %mtd
                            %mo =
                            %mfrac
                              %mrow
                                %mn 2
                                %msup
                                  %mi r
                                  %mn 2
                                %mo ±
                                %msqrt
                                  %mrow
                                    %mn 4
                                    %msup
                                      %mi r
                                      %mn 4
                                    %mo −
                                    %mn 4
                                    %mo{:stretchy => "false"} (
                                    %msup
                                      %mi r
                                      %mn 4
                                    %mo −
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                              %mrow
                                %mn 2
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi r
                                  %mn 2
                                %mo +
                                %mn 1
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mfrac
                              %mrow
                                %mn 2
                                %msup
                                  %mi r
                                  %mn 2
                                %mo ±
                                %mn 2
                              %mrow
                                %mn 2
                                %msup
                                  %mi r
                                  %mn 2
                                %mo +
                                %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    x_1
                    \&amp; =
                    \\frac
                    { 2 r^2 \pm \sqrt{ 4 r^4 - 4 (r^4 - 1)  } }
                    { 2 (r^2 + 1) }
                    \\\
                    \&amp; =
                    \\frac
                    { 2 r^2 \pm 2  }
                    { 2 r^2 + 2 }
                    \\end{aligned}
                    \\,.
            %p
              The solution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mn 2
                        %msup
                          %mi r
                          %mn 2
                        %mo +
                        %mn 2
                      %mrow
                        %mn 2
                        %msup
                          %mi r
                          %mn 2
                        %mo +
                        %mn 2
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac{ 2 r^2 + 2  }{ 2 r^2 + 2 } = 1
              violates the first condition above, while the solution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mn 2
                        %msup
                          %mi r
                          %mn 2
                        %mo −
                        %mn 2
                      %mrow
                        %mn 2
                        %msup
                          %mi r
                          %mn 2
                        %mo +
                        %mn 2
                    %mo &lt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac{ 2 r^2 - 2  }{ 2 r^2 + 2 } \lt 1
              satisfies it.
            %p Therefore we have a unique solution, given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %mi σ
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msup
                              %mi S
                              %mi n
                            %mo \
                            %mo{:stretchy => "false"} {
                            %mi p
                            %mo{:stretchy => "false"} }
                        %mo )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %msub
                      %mi y
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mn 2
                          %msup
                            %mi r
                            %mn 2
                          %mo −
                          %mn 2
                        %mrow
                          %mn 2
                          %msup
                            %mi r
                            %mn 2
                          %mo +
                          %mn 2
                      %mo ,
                      %mrow
                        %mo (
                        %mn 1
                        %mo −
                        %mfrac
                          %mrow
                            %mn 2
                            %msup
                              %mi r
                              %mn 2
                            %mo −
                            %mn 2
                          %mrow
                            %mn 2
                            %msup
                              %mi r
                              %mn 2
                            %mo +
                            %mn 2
                        %mo )
                      %msub
                        %mi y
                        %mn 2
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mrow
                        %mo (
                        %mn 1
                        %mo −
                        %mfrac
                          %mrow
                            %mn 2
                            %msup
                              %mi r
                              %mn 2
                            %mo −
                            %mn 2
                          %mrow
                            %mn 2
                            %msup
                              %mi r
                              %mn 2
                            %mo +
                            %mn 2
                        %mo )
                      %msub
                        %mi y
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\sigma\vert_{S^n \backslash \{p\}}
                    \\right)^{-1}(0,y_2, \cdots, y_{n+1})
                    \\;=\;
                    \\left(
                    \\frac{2 r^2 - 2}{2 r^2 +2}
                    ,
                    \\left( 1- \frac{2 r^2 - 2}{2 r^2 +2} \right) y_2
                    ,
                    \\cdots
                    ,
                    \\left( 1- \frac{2 r^2 - 2}{2 r^2 +2} \right) y_{n+1}
                    \\right)
            %p
              In particular therefore also an
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
              to the stereographic projection exists and is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+function"} rational function
              = succeed "." do
                %a.maruku-ref{:href => "#PolynoialsAreContinuous"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Important examples of pairs of spaces that are
            %em not
            homeomorphic include the following:
          #TopologicalInvarianceOfDimension.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"}> topological invariance of dimension
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2 \in \mathbb{N}
              but
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo ≠
                      %msub
                        %mi n
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} n_1 \neq n_2
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
              %em not
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
            %p
              More generally, an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
              is never homeomorphic to an open subset in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo ≠
                      %msub
                        %mi n
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} n_1 \neq n_2
          %p
            The proofs of theorem
            %a.maruku-ref{:href => "#TopologicalInvarianceOfDimension"}
            are not elementary, in contrast to how obvious the statement seems to be intuitively. One approach is to use tools from
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            %a.existingWikiWord{:href => "/nlab/show/topological+invariants"} topological invariants
            to topological spaces, notably classes in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            or in
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1} - \{0\}
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi n
                        %mn 2
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2} - \{0\}
            precisely only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo =
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_1 = n_2
          %p
            One indication that
            %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"} topological invariance of dimension
            is not an
            %em elementary
            consequence of the axioms of topological spaces is that a related “intuitively obvious” statement is in fact false: One might think that there is no
            %em
              %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                  %mo →
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi n
                        %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1} \to  \mathbb{R}^{n_2}
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_1 \lt n_2
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Peano+curves"} Peano curves
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#SeparationAxioms Separation axioms
          %p
            The plain definition of
            %em
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            (
            %a{:href => "#TopologicalSpaces"}> above
            ) happens to admit examples where distinct points or distinct subsets of the underlying set appear as more-or-less unseparable as seen by the topology on that set.
          %p
            The extreme class of examples of topological spaces in which the open subsets do not distinguish distinct underlying points, or in fact any distinct subsets, are the
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+spaces"} codiscrete spaces
            (example
            = succeed ")." do
              %a.maruku-ref{:href => "#CoDiscreteTopology"}
          #RQuotientedByQ.num_example
            %h6#example_45 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                quotiented by
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              regarded as the 1-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              which identifies two
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              if they differ by a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi x
                      %mo ∼
                      %mi y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi q
                          %mo ∈
                          %mi ℚ
                          %mo ⊂
                          %mi ℝ
                      %mrow
                        %mo (
                        %mi x
                        %mo =
                        %mi y
                        %mo +
                        %mi p
                        %mo{:stretchy => "false"} /
                        %mi q
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    x \sim y
                    \\right)
                    \\;\Leftrightarrow\;
                    \\left(
                    \\underset{p/q \in \mathbb{Q} \subset \mathbb{R}}{\exists}
                    \\left(
                    x = y + p/q
                    \\right)
                    \\right)
                    \\,.
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℚ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}/\mathbb{Q}
                    \\;\coloneqq\;
                    \\mathbb{R}/\sim
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+topological+space"} codiscrete topological space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
          %p Here are some less extreme examples:
          #SierpinskiNonSeparated.num_example
            %h6#example_46 Example
            %p
              %strong (open neighbourhoods in the Sierpinski space)
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#SierpinskiSpace"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0,1\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi ∅
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \tau = \{ \emptyset, \{1\}, \{0,1\} \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0\}
              is the entire space. Incidentally, also the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0\}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubset"}
          #LineWithTwoOrigins.num_example
            %h6#example_47 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/line+with+two+origins"}> line with two origins
                )
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ⊔
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} \sqcup \mathbb{R}
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              regarded as the 1-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              with the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              on the 2-element set (example
              = succeed "):" do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ⊔
                    %mi ℝ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R} \sqcup \mathbb{R} \;\simeq\; \mathbb{R} \times Disc(\{0,1\})
            %p
              Moreover, consider the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on the underlying set which identifies every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              in the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              with the corresponding point in the other, the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1-i)
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi x
                        %mi i
                      %mo ∼
                      %msub
                        %mi y
                        %mi j
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mi x
                        %mo =
                        %mi y
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mtext and
                      %mspace{:width => "thinmathspace"}
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %mi x
                          %mo ≠
                          %mn 0
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mtext or
                        %mspace{:width => "thinmathspace"}
                        %mrow
                          %mo (
                          %mi i
                          %mo =
                          %mi j
                          %mo )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    x_i \sim y_j
                    \\right)
                    \\;\Leftrightarrow\;
                    \\left(
                    \\left(
                    x = y
                    \\right)
                    \\,\text{and}\,
                    \\left(
                    \\left(
                    x \neq 0
                    \\right)
                    \\,\text{or}\,
                    \\left(
                    i = j
                    \\right)
                    \\right)
                    \\right)
                    \\,.
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/LineWithTwoOrigins.png", :width => "300"}/
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              by this equivalence relation (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi ℝ
                      %mo ⊔
                      %mi ℝ
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\mathbb{R} \sqcup \mathbb{R}
                    \\right)/\sim
            %p
              is called the
              = succeed "." do
                %strong line with two origins
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} 0_0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 0
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} 0_1
            %p
              We claim that in this space
              %em
                every neighbourhood of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 0
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} 0_0
                intersects every neighbourhood of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mn 0
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} 0_1
            %p
              Because, by definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient space topology
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mi i
                    %mo ∈
                    %mrow
                      %mo (
                      %mi ℝ
                      %mo ⊔
                      %mi ℝ
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} 0_i \in   \left( \mathbb{R} \sqcup \mathbb{R} \right)/\sim
              are precisely those that contain subsets of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %msub
                      %mn 0
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-\epsilon, \epsilon)_i
                    \\;\coloneqq\;
                    (-\epsilon,0) \cup \{0_i\} \cup (0,\epsilon)
                    \\,.
            %p
              But this means that the “two origins”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} 0_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} 0_1
              may not be
              = succeed "," do
                %a{:href => "separation+axioms#SeparatedByNeighbourhoods"} separated by neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} (-\epsilon, \epsilon)_0
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                  %annotation{:encoding => "application/x-tex"} (-\epsilon, \epsilon)_i
              is always non-empty:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-\epsilon, \epsilon)_0
                    \\cap
                    (-\epsilon, \epsilon)_1
                    \\;=\;
                    (-\epsilon, 0) \cup (0, \epsilon)
                    \\,.
          %p
            In many applications one wants to exclude at least some such exotic examples of topological spaces from the discussion and instead concentrate on those examples for which the topology recognizes the separation of distinct points, or of more general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subsets"} disjoint subsets
            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            are hence known as
            %em
              %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            which we discuss in the following.
          %p
            These axioms are all of the form of saying that two subsets (of certain kinds) in the topological space are ‘separated’ from each other in one sense if they are ‘separated’ in a (generally) weaker sense. For example the weakest axiom (called
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            that contains one but not the other.
          %p
            In this fashion one may impose a hierarchy of stronger axioms. For example demanding that given two distinct points, then each of them is contained in some open subset not containing the other (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            ) or that such a pair of open subsets around two distinct points may in addition be chosen to be
            %a.existingWikiWord{:href => "/nlab/show/disjoint+subsets"} disjoint
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            ). Below in
            %em
              %a{:href => "TnTopologicalSpaces"} Tn-spaces
            we discuss the following hierarchy:
          %div
            %p
              the
              %strong
                main
                %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            %table
              %thead
                %tr
                  %th number
                  %th name
                  %th statement
                  %th reformulation
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} T_0
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+space"} Kolmogorov
                  %td{:style => "text-align: left;"}
                    given two distinct points, at least one of them has an
                    %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
                    not containing the other point
                  %td{:style => "text-align: left;"}
                    every
                    %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subset"} irreducible closed subset
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/topological+closure"} closure
                    of at most one point
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} T_1
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    given two distinct points, both have an
                    %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
                    not containing the other point
                  %td{:style => "text-align: left;"}
                    all points are
                    %a.existingWikiWord{:href => "/nlab/show/closed+point"} closed
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} T_2
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff
                  %td{:style => "text-align: left;"}
                    given two distinct points, they have
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
                    %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
                  %td{:style => "text-align: left;"}
                    the
                    %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mrow
                              %mo &gt;
                              %mn 2
                        %annotation{:encoding => "application/x-tex"} T_{\gt 2}
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} T_1
                    and…
                  %td{:style => "text-align: left;"}
                    all points are
                    %a.existingWikiWord{:href => "/nlab/show/closed+point"} closed
                    and…
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} T_3
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/regular+Hausdorff+topological+space"} regular Hausdorff
                  %td{:style => "text-align: left;"}
                    …given a point and a
                    %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                    not containing it, they have
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
                    %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
                  %td{:style => "text-align: left;"}
                    …every
                    %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                    of a point contains the
                    %a.existingWikiWord{:href => "/nlab/show/topological+closure"} closure
                    of an
                    %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} T_4
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/normal+Hausdorff+topological+space"} normal Hausdorff
                  %td{:style => "text-align: left;"}
                    …given two
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
                    %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
                  %td{:style => "text-align: left;"}
                    …every
                    %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                    of a
                    %a.existingWikiWord{:href => "/nlab/show/closed+set"} closed set
                    also contains the
                    %a.existingWikiWord{:href => "/nlab/show/topological+closure"} closure
                    of an
                    %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
                    %br/
                    … every pair of
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
                    %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
                    is separated by an
                    %a.existingWikiWord{:href => "/nlab/show/Urysohn+function"} Urysohn function
          %p
            The condition,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_2
            %em
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff condition
            is the most common among all separation axioms. Historically this axiom was originally taken as part of the definition of topological spaces, and it is still often (but by no means always) considered by default.
          %p
            However, there are respectable areas of mathematics that involve topological spaces where the Hausdorff axiom fails, but a weaker axiom is still satisfied, called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sobriety
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            (
            %a.existingWikiWord{:href => "/nlab/show/schemes+are+sober"}> schemes are sober
            ) and in
            %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
            (
            %a{:href => "#Vickers89"}> Vickers 89
            ). These
            %em
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
            are singled out by the fact that they are entirely characterized by their
            %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"} sets of open subsets
            with their union and intersection structure (as in def.
            = succeed ")" do
              %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
            = succeed "." do
              %a{:href => "#SoberSpaces"} further below
          %table
            %thead
              %tr
                %th
                  hierarchy of
                  %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mtext metric space
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mo ⇓
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mi ⋮
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mo ⇓
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi T
                                  %mn 4
                                %mo =
                                %mtext normal Hausdorff
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mo ⇓
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi T
                                  %mn 3
                                %mo =
                                %mtext regular Hausdorff
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mo ⇓
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi T
                                  %mn 2
                                %mo =
                                %mtext Hausdorff
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo ⇙
                              %mtd
                              %mtd
                                %mo ⇘
                            %mtr
                              %mtd
                                %mspace{:width => "thinmathspace"}
                              %mtd
                                %msub
                                  %mi T
                                  %mn 1
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mtext sober
                              %mtd
                                %mspace{:width => "thinmathspace"}
                            %mtr
                              %mtd
