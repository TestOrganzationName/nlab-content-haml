              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
          .proof
            %h6#proof_58 Proof
            %p
              Since all the closed intervals are
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              (by example
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBallsHomeomorphicToRn"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
