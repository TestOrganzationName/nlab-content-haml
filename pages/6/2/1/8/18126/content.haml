          #TangentSpace.num_defn
            %h6#definition_84 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tangent+space"}> tangent space
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a point, then the
              %em
                %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi x
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_x X
              of
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TangentVector"}
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              via lemma
              = succeed "." do
                %a.maruku-ref{:href => "#LinearTangentSpace"}
          #EuclideanSpaceTangentBundle.num_example
            %h6#example_132 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^n
              is itself a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y \in X
              the
              %a.existingWikiWord{:href => "/nlab/show/tangent+spaces"} tangent spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi x
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_x X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_y X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TangentSpace"}
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              (or just
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^n
              we may send every smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma \colon \mathbb{R} \to X
              to the smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi t
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma' \;\colon\; t \mapsto  (x-y) + \gamma(t)
                    \\,.
            %p This gives a linear bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi T
                      %mi x
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi T
                      %mi y
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{x,y} \colon T_x X \overset{\simeq}{\longrightarrow} T_y X
            %p
              and these linear bijections are compatible, in that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x,y,z \in \mathbb{R}^n
              any three points, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi y
                        %mo ,
                        %mi z
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                    %mo =
                    %msub
                      %mi ϕ
                      %mrow
                        %mi x
                        %mo ,
                        %mi z
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mi x
                    %mi X
                    %mo ⟶
                    %msub
                      %mi T
                      %mi y
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{y,z} \circ \phi_{x,y} = \phi_{x,z} \;\colon\; T_x X \longrightarrow T_y Y
                    \\,.
            %p
              Moreover, by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#LinearTangentSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              itself, and this identification in turn is compatible with all the above identifications:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mi x
                            %mi X
                          %mtd
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi x
                                    %mo ,
                                    %mi y
                              %mo ≃
                          %mtd
                          %mtd
                            %msub
                              %mi T
                              %mi y
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbb{R}^n
                    \\\
                    \&amp; {}^{\mathllap{\simeq}}\swarrow &amp;&amp; \searrow^{\mathrlap{\simeq}}
                    \\\
                    T_x X &amp;&amp; \underoverset{\phi_{x,y}}{\simeq}{\longrightarrow} &amp;&amp; T_y Y
                    }
                    \\,.
            %p Therefore it makes sense to canonically identify all the tangent spaces of Euclidean space with that Euclidean space itself.
            %p
              In words, what this identification does is to use the additive group structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              to translate any tangent vector at any point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
              to the corresponding tangent vector at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              but applies to every
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and it fact to every
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              space of a Lie group.)
            %p
              As a result, the collection of all the tangent spaces of Euclidean space is naturally identified with the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi ℝ
                      %mi n
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    T \mathbb{R}^n = \mathbb{R}^n \times \mathbb{R}^n
            %p
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              on the first factor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %msup
                              %mi ℝ
                              %mi n
                            %mo =
                            %msup
                              %mi ℝ
                              %mi n
                            %mo ×
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi π
                                  %mo =
                                  %msub
                                    %mi pr
                                    %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T \mathbb{R}^n = \mathbb{R}^n \times \mathbb{R}^n
                    \\\
                    \\downarrow^{\mathrlap{\pi = pr_1}}
                    \\\
                    \\mathbb{R}^n
                    }
                    \\,,
            %p
              because then the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              of a
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{x\} \subset \mathbb{R}^n
              under this projection are canonically identified with the above tangent spaces:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi T
                      %mi x
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi^{-1}(\{x\}) \simeq T_x \mathbb{R}^n
                    \\,.
            %p
              This way, if we equip
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi ℝ
                      %mi n
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T \mathbb{R}^n = \mathbb{R}^n \times \mathbb{R}^n
              with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/product+space"} product space topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo ⟶
                      %mi π
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T \mathbb{R}^n \overset{\pi}{\longrightarrow} \mathbb{R}^n
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
            %p
              This is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
          #EuclideanTangentSpaceFunctoriality.num_remark
            %h6#remark_35 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
                is
                %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
                of
                %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
                construction on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            %p Consider the assignment that sends
            %ol
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  to its
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} T \mathbb{R}^n
                  according to def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#EuclideanSpaceTangentBundle"}
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo ⟶
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^{n_1} \longrightarrow \mathbb{R}^{n_2}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DifferentiableFunctionBetweenCartesianSpaces"}
                  %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TangentVector"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi T
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi f
                                    %mo ∘
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi T
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 2
                            %mtr
                              %mtd
                                %mrow
                                  %mo [
                                  %msup
                                    %mi ℝ
                                    %mn 1
                                  %mover
                                    %mo ⟶
                                    %mi γ
                                  %msup
                                    %mi ℝ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                  %mo ]
                              %mtd
                                %mo ↦
                              %mtd
                                %mrow
                                  %mo [
                                  %msup
                                    %mi ℝ
                                    %mn 1
                                  %mover
                                    %mo ⟶
                                    %mrow
                                      %mi f
                                      %mo ∘
                                      %mi γ
                                  %msup
                                    %mi ℝ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 2
                                  %mo ]
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        T \mathbb{R}^{n_1}
                        \&amp;\overset{f \circ (-)}{\longrightarrow}&amp;
                        T \mathbb{R}^{n_2}
                        \\\
                        \\left[
                        \\mathbb{R}^1
                        \\overset{\gamma}{\longrightarrow}
                        \\mathbb{R}^{n_1}
                        \\right]
                        \&amp;\mapsto&amp;
                        \\left[
                        \\mathbb{R}^1
                        \\overset{ f \circ \gamma}{\longrightarrow}
                        \\mathbb{R}^{n_2}
                        \\right]
                        }
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ChainRuleOnEuclideanSpace"}
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              of the composite curve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi γ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi t
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mi f
                      %mrow
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi d
                    %mi γ
                  %annotation{:encoding => "application/x-tex"}
                    d (f \circ \gamma)_t
                    \=
                    (d f_{\gamma(x)}) \circ d\gamma
            %p
              and hence that under the identification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T \mathbb{R}^n \simeq \mathbb{R}^n \times \mathbb{R}^n
              of example
              %a.maruku-ref{:href => "#EuclideanSpaceTangentBundle"}
              this assignment takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to its
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ×
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi d
                                %mi f
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mo ×
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} →
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %msub
                              %mi f
                              %mi x
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} →
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{n_1} \times \mathbb{R}^{n_1}
                    \&amp;\overset{ d f }{\longrightarrow}&amp;
                    \\mathbb{R}^{n_2} \times \mathbb{R}^{n_2}
                    \\\
                    (x,\vec v)
                    \&amp;\mapsto&amp;
                    (f(x), d f_x(\vec v))
                    }
                    \\,,
            %p
              Conversely, in the first form above the assignment
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \mapsto f \circ (-)
              manifestly respects
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              (and
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
              %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ChainRuleOnEuclideanSpace"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ∘
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d(g \circ f) = (d f)\circ (d g)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi g
                                %mo ∘
                                %mi f
                          %mtd
                          %mtd
                            %mi Z
                    %mphantom
                      %mi AAAA
                    %mo ↦
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi T
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi d
                                  %mi f
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi d
                                  %mi g
                        %mtr
                          %mtd
                            %mi T
                            %mi X
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi d
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo ∘
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi T
                            %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp; {}^{\mathllap{f}}\nearrow  &amp;&amp; \searrow^{\mathrlap{g}}
                    \\\
                    X &amp;&amp; \underset{ g\circ  f}{\longrightarrow} &amp;&amp; Z
                    }
                    \\phantom{AAAA}
                    \\mapsto
                    \\phantom{AAAA}
                    \\array{
                    \&amp;&amp; T Y
                    \\\
                    \&amp; {}^{\mathllap{d f}}\nearrow &amp;&amp; \searrow^{\mathrlap{d g}}
                    \\\
                    T X &amp;&amp;  \underset{d(g \circ f)}{\longrightarrow} &amp;&amp; T Z
                    }
                    \\,.
            %p
              In the language of
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              this says that the assignment
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CartSp
                          %mtd
                            %mover
                              %mo ⟶
                              %mi T
                          %mtd
                            %mi CartSp
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ↦
                          %mtd
                            %mi T
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi d
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ↦
                          %mtd
                            %mi T
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CartSp &amp;\overset{T}{\longrightarrow}&amp; CartSp
                    \\\
                    \\\
                    X &amp;\mapsto&amp; T X
                    \\\
                    {}^{\mathllap{ f }}\downarrow &amp;&amp; \downarrow^{\mathrlap{d f}}
                    \\\
                    Y &amp;\mapsto&amp; T Y
                    }
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
              on the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              whose
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                  between these (for any chosen differentiability class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mi k
                      %annotation{:encoding => "application/x-tex"} C^k
                  with
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo &gt;
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} k \gt 0
            %p
              In fact more is true: By example
              %a.maruku-ref{:href => "#TangentSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
              has the structure of a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundle"} differentiable vector bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiableVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mi d
                        %mi f
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X \overset{ d f}{\longrightarrow} T X
              is evidently a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundles"} differentiable vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi d
                                %mi f
                          %mtd
                            %mi T
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
