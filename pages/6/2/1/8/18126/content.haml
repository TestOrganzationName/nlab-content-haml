            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} T_3
              it is said to be a
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} T_3
                \-space
              also called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/regular+Hausdorff+topological+space"} regular Hausdorff topological space
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} T_4
              it is to be a
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} T_4
                \-space
              also called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/normal+Hausdorff+topological+space"} normal Hausdorff topological space
          #MetricSpacesAreNormal.num_example
            %h6#example_52 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normal+Hausdorff+space"} normal Hausdorff
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              be a
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via its
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/normal+Hausdorff+space"} normal Hausdorff space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#NormalSpace"}
          .proof
            %h6#proof_19 Proof
            %p
              By example
              %a.maruku-ref{:href => "#HausdorffMetricSpace"}
              metric spaces are
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} T_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subsets"} disjoint
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %msub
                      %mi C
                      %mn 2
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C_1, C_2 \subset X
              then their exists
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi C
                          %mn 1
                    %mo ⊂
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_{C_1} \subset C_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi C
                            %mn 2
                      %mo ⊃
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} U_{C_2} \supset C_2
            %p Recall the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    d(S,-) \colon X \to \mathbb{R}
            %p
              computing distances from a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#DistanceFunctionFromsubset"}
              %a.existingWikiWord{:href => "/nlab/show/unions"} unions
              of
              %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBalls"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi C
                          %mn 1
                    %mo ≔
                    %munder
                      %mo ∪
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                        %mo ∈
                        %msub
                          %mi C
                          %mn 1
                    %msubsup
                      %mi B
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U_{C_1}
                    \\coloneqq
                    \\underset{x_1 \in C_1}{\cup} B^\circ_{x_1}( d(C_2,x_1)/2 )
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi C
                          %mn 2
                    %mo ≔
                    %munder
                      %mo ∪
                      %mrow
                        %msub
                          %mi x
                          %mn 2
                        %mo ∈
                        %msub
                          %mi C
                          %mn 2
                    %msubsup
                      %mi B
                      %mrow
                        %msub
                          %mi x
                          %mn 2
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_{C_2}
                    \\coloneqq
                    \\underset{x_2 \in C_2}{\cup} B^\circ_{x_2}( d(C_1,x_2)/2 )
                    \\,.
            %p have the required properties.
          %p Observe that:
          #ImplicationsAmongTheSeparationAxioms.num_prop
            %h6#proposition_19 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi n
                    %annotation{:encoding => "application/x-tex"} T_n
                are topological properties of increasing strength)
            %p
              The separation axioms from def.
              = succeed "," do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %a.maruku-ref{:href => "#NormalSpace"}
              are
              %a.existingWikiWord{:href => "/nlab/show/topological+properties"} topological properties
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 4
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 3
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 2
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T_4 \Rightarrow T_3 \Rightarrow T_2 \Rightarrow T_1 \Rightarrow T_0
                    \\,.
          .proof
            %h6#proof_20 Proof
            %p The implications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    T_2 \Rightarrow T_1 \Rightarrow T_0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 4
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    T_4 \Rightarrow T_3
            %p
              are immediate from the definitions. The remaining implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 3
                    %mo ⇒
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_3 \Rightarrow T_2
              follows with prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#T1InTermsOfTopologicalClosure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              then all points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              are closed, and with this the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_2
              is manifestly a special case of the condition for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} T_3
          %p
            Hence instead of saying “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and …” one could just as well phrase the conditions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 3
                %annotation{:encoding => "application/x-tex"} T_3
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 4
                %annotation{:encoding => "application/x-tex"} T_4
            as “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            and …”, which would render the proof of prop.
            %a.maruku-ref{:href => "#ImplicationsAmongTheSeparationAxioms"}
            even more trivial.
          %p
            The following shows that not every
            = succeed "-space/Hausdorff" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_2
            = succeed "/regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} T_3
          #KTopology.num_example
            %h6#example_53 Example
            %p
              %strong (K-topology)
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mi n
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mrow
                        %mo ≥
                        %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    K \coloneqq \{1/n \,\vert\, n \in \mathbb{N}_{\geq 1}\} \subset \mathbb{R}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural
              %a.existingWikiWord{:href => "/nlab/show/fractions"} fractions
              inside the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/topological+basis"} topological basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta \subset P(\mathbb{R})
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              consisting of all the
              %a.existingWikiWord{:href => "/nlab/show/open+intervals"} open intervals
              as well as the
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              inside them:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi a
                      %mo &lt;
                      %mi b
                      %mo ∈
                      %mi ℝ
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo ∪
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi K
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi a
                      %mo &lt;
                      %mi b
                      %mo ∈
                      %mi ℝ
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\beta
                    \\;\coloneqq\;
                    \\left\{
                    (a,b),
                    \\,\vert\,
                    a\lt b \in \mathbb{R}
                    \\right\}
                    \\,\cup\,
                    \\left\{
                    (a,b) \setminus K,
                    \\,\vert\,
                    a\lt b \in \mathbb{R}
                    \\right\}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi β
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{\beta} \subset P(\mathbb{R})
              which is generated from this
              %a.existingWikiWord{:href => "/nlab/show/topological+basis"} topological basis
              is called the
              = succeed "." do
                %em K-topology
            %p
              We may denote the resulting
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi K
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo ,
                    %msub
                      %mi τ
                      %mi β
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}_K
                    \\;\coloneqq\;
                    ( \mathbb{R}, \tau_{\beta}\}
                    \\,.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/regular+Hausdorff+space"} regular Hausdorff space
              = succeed ")" do
                %a.maruku-ref{:href => "#ImplicationsAmongTheSeparationAxioms"}
              %a.existingWikiWord{:href => "/nlab/show/normal+Hausdorff+space"} normal Hausdorff space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#NormalSpace"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %strong Further separation axioms in terms of topological closures
          %p As before we have equivalent reformulations of the further separation axioms.
          #T3InTermsOfTopologicalClosures.num_prop
            %h6#proposition_20 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} T_3
                in terms of topological closures)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is a
              %a.existingWikiWord{:href => "/nlab/show/regular+Hausdorff+space"} regular Hausdorff space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#NormalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
