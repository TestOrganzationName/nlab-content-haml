            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ∼
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
