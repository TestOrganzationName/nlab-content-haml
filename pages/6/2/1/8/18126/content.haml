                      %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
                  be a set of
                  %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedSubset"}
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo ⊂
                        %mi I
                      %annotation{:encoding => "application/x-tex"} J \subset I
                  then the corresponding finite intersection is
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
