                        \\;\;\;\;\in \tau_X
                        \\,.
          #PreservationOfInclusionsByFrameHomomorphism.num_remark
            %h6#remark_4 Remark
            %p
              %strong (frame homomorphisms preserve inclusions)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              as in def.
              %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
              necessarily also preserves inclusions in that
            %ul
              %li
                %p
                  for every inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ⊂
                        %msub
                          %mi U
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} U_1 \subset U_2
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ,
                        %msub
                          %mi U
                          %mn 2
                        %mo ∈
                        %msub
                          %mi τ
                          %mi Y
                        %mo ⊂
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U_1, U_2 \in \tau_Y \subset P(Y)
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %msub
                          %mi τ
                          %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\phi(U_1) \subset \phi(U_2) \;\;\;\;\;\;\; \in \tau_X
                        \\,.
            %p This is because inclusions are witnessed by unions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mn 1
                      %mo ∪
                      %msub
                        %mi U
                        %mn 2
                      %mo =
                      %msub
                        %mi U
                        %mn 2
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (U_1 \subset U_2)
                    \\;\Leftrightarrow\;
                    \\left( U_1 \cup U_2 = U_2 \right)
            %p or alternatively because inclusions are witnessed by finite intersections:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo =
                      %msub
                        %mi U
                        %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (U_1 \subset U_2)
                    \\;\Leftrightarrow\;
                    \\left(
                    U_1 \cap U_2 = U_1
                    \\right)
                    \\,.
          #ContinuousFunctionGivesFrameHomomorphism.num_example
            %h6#example_25 Example
            %p
              %strong (pre-images of continuous functions are frame homomorphisms)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              be two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_X \longleftarrow \tau_Y \;\colon\; \phi
            %p is to specify a function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              of their underlying sets, and take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ≔
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi \coloneqq f^{-1}
              to be the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              operation. A priori this is a function of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    P(X) \longleftarrow P(Y) \;\colon\; f^{-1}
            %p
              and hence in order for this to co-restrict to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_X \subset P(X)
              when restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Y
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_Y \subset P(Y)
              we need to demand that, under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are open subsets of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
              %a.maruku-ref{:href => "#ContinuousMaps"}
              we highlight these as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              between topological spaces.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; (X,\tau_X) \longrightarrow (Y, \tau_Y)
            %p In this case then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_X \longleftarrow \tau_Y \;\colon\; f^{-1}
            %p
              is a frame homomorphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau_Y
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
              = succeed "." do
                %a.maruku-ref{:href => "#PreservedByPreImages"}
          %p
            For the following recall from example
            %a.maruku-ref{:href => "#Point"}
            the
            %a.existingWikiWord{:href => "/nlab/show/point+topological+space"} point topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %msub
                      %mi τ
                      %mo *
                    %mo =
                    %mrow
                      %mo {
                      %mi ∅
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ast = (\{1\}, \tau_\ast = \left\{\emptyset, \{1\}\right\})
          #FrameHomomorphismsToPointAreIrrClSub.num_prop
            %h6#proposition_11 Proposition
            %p
              %strong (irreducible closed subsets are equivalently frame homomorphisms to opens of the point)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between the
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspaces"} irreducible closed subspaces
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedIrreducible"}
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \tau_\ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi FrameHom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi τ
                              %mi X
                            %mo ,
                            %msub
                              %mi τ
                              %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                              %mo ≃
                          %mtd
                            %mi IrrClSub
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi ϕ
                          %mtd
                            %mo ↦
                          %mtd
                            %mi X
                            %mo ∖
                            %mrow
                              %mo (
                              %msub
                                %mi U
                                %mi ∅
                              %mo{:stretchy => "false"} (
                              %mi ϕ
                              %mo{:stretchy => "false"} )
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    FrameHom(\tau_X, \tau_\ast)
                    \&amp;\underoverset{}{\simeq}{\longrightarrow}&amp;
                    IrrClSub(X)
                    \\\
                    \\phi
                    \&amp;\mapsto&amp;
                    X \setminus \left( U_\emptyset(\phi) \right)
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_\emptyset(\phi)
              is the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U \in \tau_x
              such that
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \phi(U) = \emptyset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo ∪
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi U
                            %mo ∈
                            %msub
                              %mi τ
                              %mi X
                        %mrow
                          %mrow
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ∅
                    %mrow
                      %mo (
                      %mi U
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_{\emptyset}(\phi)
                    \\coloneqq
                    \\underset{{U \in \tau_X} \atop {\phi(U) = \emptyset} }{\cup}
                    \\left( U \right)
                    \\,.
          %p
            See also (
            %a{:href => "#Johnstone82"}> Johnstone 82, II 1.3
            ).
          .proof
            %h6#proof_9 Proof
            %p
              First we need to show that the function is well defined in that given a frame homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
                      %mi τ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \phi \colon \tau_X \to \tau_\ast
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \setminus U_\emptyset(\phi)
              is indeed an irreducible closed subspace.
            %p To that end observe that:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              %em
                If there are two elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ,
                      %msub
                        %mi U
                        %mn 2
                      %mo ∈
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} U_1, U_2 \in \tau_X
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset U_{\emptyset}(\phi)
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_1 \subset U_{\emptyset}(\phi)
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 2
                        %mo ⊂
                        %msub
                          %mi U
                          %mi ∅
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U_2 \subset U_{\emptyset}(\phi)
            %p This is because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo ∩
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi ∅
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi(U_1) \cap \phi(U_2)
                    \&amp; =
                    \\phi(U_1 \cap U_2)
                    \\\
                    \&amp; \subset \phi(U_{\emptyset}(\phi))
                    \\\
                    \&amp; =
                    \\emptyset
                    \\end{aligned}
                    \\,,
            %p
              where the first equality holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              preserves finite intersections by def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              respects inclusions by remark
              = succeed "," do
                %a.maruku-ref{:href => "#PreservationOfInclusionsByFrameHomomorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              preserves arbitrary unions by def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi ∅
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \tau_\ast = \{\emptyset, \{1\}\}
              the intersection of two open subsets is empty precisely if at least one of them is empty, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \phi(U_1) = \emptyset
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \phi(U_2) = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_1 \subset U_{\emptyset}(\phi)
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_2 \subset U_{\emptyset}(\phi)
            %p
              Now according to prop.
              %a.maruku-ref{:href => "#OpenSubsetVersionOfClosedIrreducible"}
              the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              identifies the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \setminus U_{\emptyset}(\phi)
              as an
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible closed subspace
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            %p
              Conversely, given an irreducible closed subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∖
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X \setminus U_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext if
                              %mspace{:width => "thinmathspace"}
                              %mi U
                              %mo ⊂
                              %msub
                                %mi U
                                %mn 0
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;\colon\;
                    U
                    \\mapsto
                    \\left\{
                    \\array{
                    \\emptyset &amp; \vert \, \text{if} \, U \subset U_0
                    \\\
                    \\{1\} &amp; \vert \, \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p This does preserve
            %ol
              %li
                %p arbitrary unions
                %p
                  because
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %munder
                          %mo ∪
                          %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi ∅
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(\underset{i}{\cup} U_i) = \{\emptyset\}
                  precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∪
                          %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \underset{i}{\cup}U_i \subset U_0
                  which is the case precisely if all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                          %mo ⊂
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_i \subset U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \phi(U_i) = \emptyset
                  and because
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∪
                            %mi i
                          %mi ∅
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \underset{i}{\cup}\emptyset = \emptyset
                %p
                  while
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %munder
                          %mo ∪
                          %mi i
                        %msub
                          %mi U
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(\underset{i}{\cup}U_1) = \{1\}
                  as soon as one of the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
                  is not contained in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(U_i) = \{1\}
                  which means that
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∪
                            %mi i
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \underset{i}{\cup} \phi(U_i) = \{1\}
              %li
                %p finite intersections
                %p
                  because if
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mn 1
                          %mo ∩
                          %msub
                            %mi U
                            %mn 2
                          %mo ⊂
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\ast)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ⊂
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} U_1 \subset U_0
                  or
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mn 2
                          %mo ⊂
                          %msub
                            %mi U
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} U_2 \subset U_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \phi(U_1) = \emptyset
                  or
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \phi(U_2) = \emptyset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \phi(U_1 \cap U_2) = \emptyset
                  also
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \phi(U_1) \cap \phi(U_2) = \emptyset
                %p
                  while if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} U_1 \cap U_2
                  is not contained in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} U_0
                  then neither
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} U_1
                  nor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} U_2
                  is contained in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} U_0
                  and hence with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi(U_1 \cap U_2) = \{1\}
                  also
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                          %mo ∩
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \phi(U_1) \cap \phi(U_2) = \{1\} \cap \{1\} = \{1\}
            %p
              Hence this is indeed a frame homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                      %mo →
                      %msub
                        %mi τ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \tau_X \to \tau_\ast
            %p Finally, it is clear that these two operations are inverse to each other.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#ContinuousFunctions Continuous functions
          %p
            With the concept of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            in hand (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#TopologicalSpace"}
            = succeed ":" do
              %a.maruku-ref{:href => "#ContinuityBetweenMetricSpacesInTermsOfOpenSets"}
          .un_remark{:style => "border:solid #0000cc;background: #add8e6;border-width:2px 1px;padding:0 1em;margin:0 1em;"}
            %p
              %strong principle of continuity
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
              %em Continuous pre-Images of open subsets are open.
          #ContinuousMaps.num_defn
            %h6#definition_20 Definition
            %p
              %strong (continuous function)
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \colon (X, \tau_X) \to (Y, \tau_Y)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              between the underlying sets,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              such that
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are open subsets of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            We may equivalently state this in terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
          #ClosedSubsetContinuity.num_prop
            %h6#proposition_12 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              be two
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              between the underlying
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              is
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              in the sense of def.
              %a.maruku-ref{:href => "#ContinuousMaps"}
              precisely if
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubset"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_10 Proof
            %p
              This follows since taking
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              commutes with taking
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complements"} complements
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Before looking at first examples of continuous functions
            %a{:href => "#ContinuousFunctionsExamples"} below
            we consider now an informal remark on the resulting global structure, the “
            %a.existingWikiWord{:href => "/nlab/show/category+of+topological+spaces"}> category of topological spaces
            ”, remark
            %a.maruku-ref{:href => "#TopCategory"}
            below. This is a language that serves to make transparent key phenomena in
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            which we encounter further below, such as the
            %a{:href => "#HausdorffReflections"} Tn-reflection
            (remark
            %a.maruku-ref{:href => "#ReflectiveSubcategory"}
            below), and the
            = succeed "." do
              %a{:href => "#UniversalConstructions"} universal constructions
          #TopCategory.num_remark
            %h6#remark_5 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+topological+spaces"} category of topological spaces
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi X
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} X_1, X_2, X_3
              three
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              and for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %mo ⟶
                      %mi f
                    %msub
                      %mi X
                      %mn 2
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %msub
                      %mi X
                      %mn 2
                    %mover
                      %mo ⟶
                      %mi g
                    %msub
                      %mi X
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    X_1 \overset{f}{\longrightarrow} X_2
                    \\phantom{AA}\text{and}\phantom{AA}
                    X_2 \overset{g}{\longrightarrow} X_3
            %p
              two
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousMaps"}
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %mo ⟶
                      %mi f
                    %msub
                      %mi X
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %msub
                      %mi X
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    f_2 \circ f_1
                    \\;\colon\;
                    X_1 \overset{f}{\longrightarrow} X_2 \overset{f_2}{\longrightarrow} X_3
            %p
              is clearly itself again a continuous function from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} X_3
            %p
              Moreover, this composition operation is clearly
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %mo ⟶
                      %mi f
                    %msub
                      %mi X
                      %mn 2
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %msub
                      %mi X
                      %mn 2
                    %mover
                      %mo ⟶
                      %mi g
                    %msub
                      %mi X
                      %mn 3
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %msub
                      %mi X
                      %mn 3
                    %mover
                      %mo ⟶
                      %mi h
                    %msub
                      %mi X
                      %mn 4
                  %annotation{:encoding => "application/x-tex"}
                    X_1 \overset{f}{\longrightarrow} X_2
                    \\phantom{AA}\text{and}\phantom{AA}
                    X_2 \overset{g}{\longrightarrow} X_3
                    \\phantom{AA}\text{and}\phantom{AA}
                    X_3 \overset{h}{\longrightarrow} X_4
            %p
              three
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 3
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 2
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 3
                    %mo ∘
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi X
                      %mn 4
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_3 \circ (f_2 \circ f_1)
                    \=
                    (f_3 \circ f_2) \circ f_1
                    \\;\colon\;
                    X_1 \longrightarrow X_4
                    \\,.
            %p
              Finally, the composition operation is also clearly
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there exists the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} id_X \colon X \to X
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon X_1 \to X_2
              any continuous function then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %mo ∘
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ∘
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    id_{X_2} \circ f  \;=\; f \;=\; f \circ id_{X_1}
                    \\,.
            %p One summarizes this situation by saying that:
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                  constitute the
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  constitute the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"}> homomorphisms
                  )
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/AssociativityDiagram.png", :width => "400"}/
            %p
              of a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+of+topological+spaces"} category of topological spaces
              (“
              %a.existingWikiWord{:href => "/nlab/show/Top"}> Top
              ” for short).
            %p
              It is useful to depict collections of
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              with
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              between them by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %blockquote
              %p
                graphics grabbed from
                = succeed "." do
                  %a{:href => "#category+theory#LawvereSchanuel09"} Lawvere-Schanuel 09
            %p
              There are other categories. For instance there is the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              (“
              %a.existingWikiWord{:href => "/nlab/show/Set"}> Set
              ” for short) whose
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are plain
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                  between these.
            %p
              The two categories
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              and
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              are different, but related. After all,
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  (hence a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                  (hence a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
                  (namely with a
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  (hence a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                  (hence a plain
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/function"} function
                  %a.existingWikiWord{:href => "/nlab/show/extra+property"} extra property
                  that it preserves this extra structure.
            %p
              Hence we have the
              %em underlying set assigning function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Top
                          %mtd
                            %mover
                              %mo ⟶
                              %mi U
                          %mtd
                            %mi Set
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi τ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAa
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Top &amp;\overset{U}{\longrightarrow}&amp; Set
                    \\\
                    \\\
                    (X,\tau) &amp;\overset{\phantom{AAa}}{\mapsto}&amp; X
                    }
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              to the
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between topological spaces is, by definition, in particular a function on underlying sets:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Top
                          %mtd
                            %mover
                              %mo ⟶
                              %mi U
                          %mtd
                            %mi Set
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mi τ
                              %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mover
                              %mo ↦
                              %mrow
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %msub
                              %mi τ
                              %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Top &amp;\overset{U}{\longrightarrow}&amp; Set
                    \\\
                    \\\
                    (X,\tau_X) &amp;\overset{\phantom{AAA}}{\mapsto}&amp; X
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;\overset{}{\mapsto}&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    (Y, \tau_Y) &amp;\underset{\phantom{AAA}}{\mapsto}&amp; Y
                    }
            %p
              and this assignment (trivially) respects the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of morphisms and the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
            %p
              Such a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              between
              %a.existingWikiWord{:href => "/nlab/show/classes"} classes
              of
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              of
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              between these objects in a way that respects
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              and
              %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Top
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    U \;\colon\; Top \longrightarrow Set
            %p
              then it is understood that we mean not just a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              between their
              %a.existingWikiWord{:href => "/nlab/show/classes"} classes
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              at hand has the special property that it does not do much except
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} forgetting extra structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              given by a choice of topology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \tau_X
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %p
              This is intuitively clear, and we may easily formalize it: The
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              has the special property that as a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              between
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              of
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              (“
              %a.existingWikiWord{:href => "/nlab/show/hom+sets"}> hom sets
              ”, for short) it is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              then the component function of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              from the set of
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between these spaces to the set of plain functions between their underlying sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo {
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %msub
                                %mi τ
                                %mi X
                              %mo{:stretchy => "false"} )
                              %munderover
                                %mo ⟶
                                %mtext function
                                %mtext continuous
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo ,
                              %msub
                                %mi τ
                                %mi Y
                              %mo{:stretchy => "false"} )
                              %mo }
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mover
                              %mo ↦
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi U
                                %mphantom
                                  %mi AA
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mrow
                              %mo {
                              %mi X
                              %munder
                                %mo ⟶
                                %mtext function
                              %mi Y
                              %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\left\{
                    (X,\tau_X)
                    \\underoverset{\text{function}}{\text{continuous}}{\longrightarrow}
                    (Y,\tau_Y)
                    \\right\}
                    \&amp;\;\overset{\phantom{AA}U\phantom{AA}}{\mapsto}\;&amp;
                    \\left\{
                    X
                    \\underset{\text{function}}{\longrightarrow}
                    Y
                    \\right\}
                    }
            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              with this property, that its component functions between all
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              are injective, is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              to
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
            %p
              Hence
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              is canonically a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
          #FunctorialProductSpace.num_example
            %h6#example_26 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                construction is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              two
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              as in remark
              %a.maruku-ref{:href => "#TopCategory"}
              (for instance
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              or
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ×
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \times \mathcal{D}
              and called their
              %em
                %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              whose
            %ol
              %li
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are
                %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c,d)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                an object of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                an object of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ′
                        %mo ,
                        %mi d
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f,g) \;\colon\; (c,d) \to (c', d')
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi c
                        %mo →
                        %mi c
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} f \colon c \to c'
                  a morphism of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %p
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:lspace => "verythinmathspace"} :
                        %mi d
                        %mo →
                        %mi d
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} g \colon d \to d'
                  a morphism of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of morphisms is defined pairwise
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo ,
                          %mi g
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo ≔
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo ∘
                          %mi f
                          %mo ,
                          %mi g
                          %mo ′
                          %mo ∘
                          %mi g
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (f', g') \circ (f,g) \coloneqq ( f' \circ f, g' \circ g )
            %p
              This concept secretly underlies the construction of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 1
                      %mo ,
                      %msub
                        %mi τ
                        %mrow
                          %msub
                            %mi X
                            %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X_1,\tau_{X_1})
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 2
                      %mo ,
                      %msub
                        %mi τ
                        %mrow
                          %msub
                            %mi X
                            %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X_2, \tau_{X_2})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 1
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y_1, \tau_{Y_1})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Y
                          %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y_2, \tau_{Y_2})
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 1
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_1 \;\colon\; (X_1, \tau_{X_1}) \longrightarrow (Y_1, \tau_{Y_1})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Y
                          %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_2 \;\colon\; (X_2, \tau_{X_2}) \longrightarrow (Y_2, \tau_{Y_2})
            %p
              the canonically induced function on
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                            %mo ×
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                                %mo ×
                                %msub
                                  %mi f
                                  %mn 2
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                            %mo ×
                            %msub
                              %mi Y
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi f
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_1 \times X_2 &amp; \overset{  f_1 \times f_2 }{\longrightarrow} &amp; Y_1 \times Y_2
                    \\\
                    (x_1, x_2) &amp;\mapsto&amp; ( f_1(x_1), f_2(x_2) )
                    }
            %p
              is clearly a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} binary product space topologies
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ×
                    %msub
                      %mi f
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
