                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi J
                            %mo ⊂
                            %mi I
                        %mo ⊔
                        %mo{:stretchy => "false"} {
