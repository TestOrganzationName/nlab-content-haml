                            %mi α
                      %msub
                        %mi X
                        %mi j
                      %mo{:stretchy => "false"} }
                      %mo )
                  %annotation{:encoding => "application/x-tex"} Cones\left(Y, \{X_i \overset{f_\alpha}{\to} X_j\} \right)
              of cones over the corresponding diagram with tip
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
