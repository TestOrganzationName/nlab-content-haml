                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"}
                        \\{X_i \overset{\phantom{AA}f_i\phantom{AA}}{\longrightarrow} S\}_{i \in I}
                %p
                  a set of
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                  into
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mi final
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi f
