                  %mrow
                    %msub
                      %mi V
                      %mn 0
                    %mo ⊂
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi V
                      %mn 2
                    %mo ⊂
                    %mi ⋯
