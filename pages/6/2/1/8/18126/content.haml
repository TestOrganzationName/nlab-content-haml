                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_1 \sim x_2
              precisely if for every
              %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              into any
              = succeed "-topological" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi n
                    %annotation{:encoding => "application/x-tex"} T_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
