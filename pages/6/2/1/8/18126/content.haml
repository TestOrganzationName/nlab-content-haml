          .proof
            %h6#proof_32 Proof
            %p
              First observe that there is a unique function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
