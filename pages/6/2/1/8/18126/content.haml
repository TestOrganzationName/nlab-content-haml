              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              to this open subset by closed balls and since the further subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∖
                    %msub
                      %mi K
                      %mi n
                  %annotation{:encoding => "application/x-tex"} K_{n+1}\setminus K_n
              is still compact (example
              = succeed ")" do
                %a.maruku-ref{:href => "#UnionsAndIntersectionOfCompactSubspaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi n
                  %annotation{:encoding => "application/x-tex"} L_n
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi B
                      %mrow
                        %msub
                          %mi l
                          %mi n
                    %mo ⊂
                    %msub
