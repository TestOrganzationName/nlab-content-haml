                                  %mn 0
                                %mo =
                                %mtext Kolmogorov
                            %mtr
                              %mtd
                      %annotation{:encoding => "application/x-tex"} \array{ &amp;&amp;&amp;\text{metric space}  \\ &amp;&amp;&amp; \Downarrow \\ &amp;&amp;&amp; \vdots \\ &amp;&amp;&amp; \Downarrow \\ &amp;&amp;&amp; T_4  = \text{normal Hausdorff} \\ &amp;&amp;&amp; \Downarrow \\ &amp;&amp;&amp; T_3 = \text{regular Hausdorff} \\ &amp;&amp;&amp; \Downarrow \\ &amp;&amp;&amp; T_2 = \text{Hausdorff}  \\ &amp;&amp; \swArrow &amp;&amp; \seArrow \\ \, &amp; T_1 &amp;&amp; &amp;&amp; \text{sober} &amp; \, \\ &amp;&amp; \seArrow &amp;&amp; \swArrow \\ &amp;&amp;&amp; T_0 = \text{Kolmogorov} \\ }
          %p
            All separation axioms are satisfied by
            %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
            (example
            = succeed "," do
              %a.maruku-ref{:href => "#HausdorffMetricSpace"}
            %a.maruku-ref{:href => "#MetricSpacesAreNormal"}
            below), from whom the concept of topological space was originally abstracted
            = succeed "." do
              %a{:href => "#TopologicalSpaces"} above
          %h3#TnTopologicalSpaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi n
                %annotation{:encoding => "application/x-tex"} T_n
            spaces
          %p
            There are many variants of separation axioms. The classical ones are labeled
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi n
                %annotation{:encoding => "application/x-tex"} T_n
            (for German “Trennungsaxiom”) with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo ,
                  %mn 4
                  %mo ,
                  %mn 5
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} n \in \{0,1,2,3,4,5\}
            or higher. These we now introduce in def.
            %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
            and def.
            = succeed "." do
              %a.maruku-ref{:href => "#NormalSpace"}
          #HausdorffTopologicalSpace.num_defn
            %h6#definition_25 Definition
            %p
              %strong
                (the first three
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalSpace"}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≠
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \neq y \in X
              any two points in the underlying set of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which are not
              %a.existingWikiWord{:href => "/nlab/show/equality"} equal
              as elements of this set, consider the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            %div{:style => "float:left;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/HausdorffProperty.png", :width => "190"}/
            %ul
              %li
                %p
                  %strong (T0)
                  %em
                    There exists a
                    %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                    of one of the two points which does not contain the other point.
              %li
                %p
                  %strong (T1)
                  %em
                    There exist
                    %a.existingWikiWord{:href => "/nlab/show/neighbourhoods"} neighbourhoods
                    of both points which do not contain the other point.
              %li
                %p
                  %strong (T2)
                  %em
                    There exists
                    = succeed "_" do
                      %a.existingWikiWord{:href => "/nlab/show/neighbourhoods"} neighbourhoods
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Vickers89"} Vickers 89
            %p
              The topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called a
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi n
                    %annotation{:encoding => "application/x-tex"} T_n
                \-topological space
              or just
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi n
                      %annotation{:encoding => "application/x-tex"} T_n
                  \-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
              above for all pairs of distinct points.
            %p
              A
              = succeed "-topological" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} T_0
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+space"} Kolmogorov space
            %p
              A
              = succeed "-topological" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} T_2
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
            %p
              For definiteness, we re-state these conditions formally. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y \in X
              for points in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ,
                    %msub
                      %mi U
                      %mi y
                    %mo ∈
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} U_x, U_y \in \tau
              for open
              %a.existingWikiWord{:href => "/nlab/show/neighbourhoods"} neighbourhoods
              of these points. Then:
            %ul
              %li
                %p
                  %strong> (T0
                  )
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi x
                            %mo ≠
                            %mi y
                        %mrow
                          %mo (
                          %mrow
                            %mo (
                            %munder
                              %mo ∃
                              %mrow
                                %msub
                                  %mi U
                                  %mi y
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} {
                              %mi x
                              %mo{:stretchy => "false"} }
                              %mo ∩
                              %msub
                                %mi U
                                %mi y
                              %mo =
                              %mi ∅
                              %mo )
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mtext or
                          %mspace{:width => "thinmathspace"}
                          %mrow
                            %mo (
                            %munder
                              %mo ∃
                              %mrow
                                %msub
                                  %mi U
                                  %mi x
                            %mrow
                              %mo (
                              %msub
                                %mi U
                                %mi x
                              %mo ∩
                              %mo{:stretchy => "false"} {
                              %mi y
                              %mo{:stretchy => "false"} }
                              %mo =
                              %mi ∅
                              %mo )
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{x \neq y}{\forall} \left(
                        \\left( \underset{U_y}{\exists} \left( \{x\} \cap U_y = \emptyset \right) \right)
                        \\,\text{or}\,
                        \\left( \underset{U_x}{\exists} \left( U_x \cap \{y\} = \emptyset  \right) \right) \right)
              %li
                %p
                  %strong ((T1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi x
                            %mo ≠
                            %mi y
                        %mrow
                          %mo (
                          %munder
                            %mo ∃
                            %mrow
                              %msub
                                %mi U
                                %mi x
                              %mo ,
                              %msub
                                %mi U
                                %mi y
                          %mrow
                            %mo (
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} {
                              %mi x
                              %mo{:stretchy => "false"} }
                              %mo ∩
                              %msub
                                %mi U
                                %mi y
                              %mo =
                              %mi ∅
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext and
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %msub
                                %mi U
                                %mi x
                              %mo ∩
                              %mo{:stretchy => "false"} {
                              %mi y
                              %mo{:stretchy => "false"} }
                              %mo =
                              %mi ∅
                              %mo )
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{x \neq y}{\forall} \left(\underset{U_x,U_y}{\exists} \left(\left( \{x\} \cap U_y = \emptyset\right)
                        \\, \text{and} \, \left( U_x \cap \{y\}  = \emptyset \right)\right) \right)
              %li
                %p
                  %strong (T2)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi x
                            %mo ≠
                            %mi y
                        %mrow
                          %mo (
                          %munder
                            %mo ∃
                            %mrow
                              %msub
                                %mi U
                                %mi x
                              %mo ,
                              %msub
                                %mi U
                                %mi y
                          %mrow
                            %mo (
                            %msub
                              %mi U
                              %mi x
                            %mo ∩
                            %msub
                              %mi U
                              %mi y
                            %mo =
                            %mi ∅
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \underset{x \neq y}{\forall} \left( \underset{U_x, U_y}{\exists} \left( U_x \cap U_y = \emptyset\right) \right)
          %p The following is evident but important:
          #TnImplications.num_prop
            %h6#proposition_15 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi n
                    %annotation{:encoding => "application/x-tex"} T_n
                are
                %a.existingWikiWord{:href => "/nlab/show/topological+properties"} topological properties
                of increasing strength)
            %p
              The separation properties
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
              from def.
              %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              are
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+properties"} topological properties
              in that if two topological spaces are
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
              precisely if the other does.
            %p Moreover, these properties imply each other as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mn 2
                    %mo ⇒
                    %mi T
                    %mn 1
                    %mo ⇒
                    %mi T
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T2 \Rightarrow T1 \Rightarrow T0
                    \\,.
          #TnCounter.num_example
            %h6#example_48 Example
            %p
              Examples of topological spaces that are
              %em not
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+spaces"} Hausdorff
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
                  (example
                  = succeed ")," do
                    %a.maruku-ref{:href => "#SierpinskiNonSeparated"}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/line+with+two+origins"} line with two origins
                  (example
                  = succeed ")," do
                    %a.maruku-ref{:href => "#LineWithTwoOrigins"}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                        %mo{:stretchy => "false"} /
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}/\mathbb{Q}
                  (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#RQuotientedByQ"}
          #FiniteT1SpacesAreDiscrete.num_example
            %h6#example_49 Example
            %p
              %strong
                (finite
                = succeed "-spaces" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_1
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/finite+topological+space"} finite topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_1
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#CoDiscreteTopology"}
          #HausdorffMetricSpace.num_example
            %h6#example_50 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              (def
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via its
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
            %p
              Because for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≠
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \neq y \in X
              two distinct points, then the
              %a.existingWikiWord{:href => "/nlab/show/distance"} distance
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(x,y)
              between them is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive number
              = succeed "." do
                %a.maruku-ref{:href => "#MetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBalls"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %msubsup
                      %mi B
                      %mi y
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    B^\circ_x(d(x,y)) \supset \{x\}
                    \\phantom{AA}
                    \\text{and}
                    \\phantom{AA}
                    B^\circ_y(d(x,y)) \supset \{y\}
            %p are disjoint open neighbourhoods.
          #TiSubspaces.num_example
            %h6#example_51 Example
            %p
              %strong
                (subspace of
                = succeed "-space" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi n
                      %annotation{:encoding => "application/x-tex"} T_n
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi n
                      %annotation{:encoding => "application/x-tex"} T_n
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              satisfying the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
              %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separation axiom
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
