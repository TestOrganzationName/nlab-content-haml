                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} /
                    %mn 3
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
