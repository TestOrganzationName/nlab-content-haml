                        %mi i
                      %msub
                        %mi X
                        %mi i
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Cones
                    %mrow
                      %mo (
                      %mi Y
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi X
                        %mi i
