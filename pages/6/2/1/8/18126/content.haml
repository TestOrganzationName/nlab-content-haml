                    %mi I
                    %mo =
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} I = \mathbb{N}
              be the set of
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              and consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi f
                                %mrow
                                  %mi i
                                  %mo ,
                                  %mi j
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi j
