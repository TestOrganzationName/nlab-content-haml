                          %mo ,
                          %mi j
                          %mo ∈
                          %mi I
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϕ
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                    %mspace{:width => "thickmathspace"}
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\left(
                    \\underset{i \in I}{\sqcup} U_i
                    \\right)
                    \\times
                    k^n
                    \\right)
                    \/
                    \\left(
                    \\left\{
                    g_{i j}
                    \\right\}_{i,j \in I}
                    \\right)
                    \\;\underoverset{\simeq}{(\phi_i)_{i \in I}}{\longrightarrow}\;
                    E
            %p
              from the vector bundle glued from the transition functions according to def.
              %a.maruku-ref{:href => "#TransitionFunctions"}
              to the original bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          .proof
            %h6#proof_111 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              (
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              in
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %mo ⊂
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \times k^n \underoverset{\simeq}{\phi_i}{\to} E|_{U_i} \subset E\}_{i \in I}
              may be collected into a single
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϕ
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\sqcup} U_i
                    \\times
                    k^n
                    \\overset{(\phi_i)_{i \in I}}{\longrightarrow }
                    E
                    \\,.
            %p
              By construction this function respects the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on the disjoint union space given by the transition functions, in that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"} x \in U_i \cap U_j
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ϕ
                      %mi j
                    %mo ∘
                    %msubsup
                      %mi ϕ
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ϕ
                      %mi j
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_i((x,i),v)
                    \=
                    \\phi_j \circ \phi_j^{-1} \circ \phi_i((x,i),v)
                    \=
                    \\phi_j \circ ((x,j),g_{i j}(x)(v))
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              coprojection this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (\phi_i)_{i \in I}
              uniquely
              %a.existingWikiWord{:href => "/nlab/show/extension"} extends
              to a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              on the quotient space such that the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msub
                                %mi U
                                %mi i
                              %mo )
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ϕ
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                                %mo ∃
                                %mo !
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %mrow
                                %mo (
                                %munder
                                  %mo ⊔
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                                %msub
                                  %mi U
                                  %mi i
                                %mo )
                              %mo ×
                              %msup
                                %mi k
                                %mi n
                              %mo )
                            %mo{:stretchy => "false"} /
                            %mrow
                              %mo (
                              %msub
                                %mrow
                                  %mo {
                                  %msub
                                    %mi g
                                    %mrow
                                      %mi i
                                      %mi j
                                  %mo }
                                %mrow
                                  %mi i
                                  %mo ,
                                  %mi j
                                  %mo ∈
                                  %mi I
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\left(
                    \\underset{i \in I}{\sqcup} U_i
                    \\right)
                    \\times
                    k^n
                    \&amp;\overset{(\phi_i)_{i \in I}}{\longrightarrow}&amp;
                    E
                    \\\
                    \\downarrow  &amp; \nearrow_{\exists !}
                    \\\
                    \\left(
                    \\left(
                    \\underset{i \in I}{\sqcup} U_i
                    \\right)
                    \\times
                    k^n
                    \\right)
                    \/
                    \\left(
                    \\left\{
                    g_{i j}
                    \\right\}_{i,j \in I}
                    \\right)
                    }
                    \\,.
            %p
              It is clear that this continuous function is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              (by prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#HomeoContinuousOpenBijection"}
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
              be a subset in the quotient space which is open. By definition of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              this means equivalently that its restriction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi i
                  %annotation{:encoding => "application/x-tex"} O_i
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U_i \times k^n
              is open for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \phi_i
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                  %annotation{:encoding => "application/x-tex"} \phi_i(O_i)  \subset  E\vert_{U_ i}
              are open. By the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(O) = \underset{i \in I}{\cup} \phi_i(O_i)
              is open.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p Here are some basic examples of vector bundles constructed from transition functions.
          #MoebiusStrip.num_example
            %h6#example_121 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Moebius+strip"}> Moebius strip
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %msup
                        %mi y
                        %mn 2
                      %mo =
                      %mn 1
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    S^1
                    \=
                    \\left\{
                    (x,y)
                    \\;\vert\;
                    x^2 + y^2 = 1
                    \\right\}
                    \\;\subset\,
                    \\mathbb{R}^2
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi n
                        %mo ⊂
                        %msup
                          %mi S
                          %mn 1
                        %mo }
                      %mrow
                        %mi n
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_n \subset S^1
                    \\right\}_{n \in \{0,1,2\}}
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi n
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi cos
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi n
                      %mfrac
                        %mrow
                          %mn 2
                          %mi π
                        %mn 3
                      %mo −
                      %mi ϵ
                      %mo &lt;
                      %mi α
                      %mo &lt;
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mfrac
                        %mrow
                          %mn 2
                          %mi π
                        %mn 3
                      %mo +
                      %mi ϵ
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    U_n \coloneqq \left\{ (cos(\alpha), sin(\beta)) \;\vert\; n \frac{2 \pi }{3} - \epsilon \lt \alpha \lt (n+1) \frac{2\pi }{3} + \epsilon  \right\}
            %p
              for any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 2
                      %mi π
                      %mo{:stretchy => "false"} /
                      %mn 6
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \epsilon \in (0,2\pi/6)
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              cocycle (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#CocycleCech"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi n
                                %mn 1
                              %mo ,
                              %msub
                                %mi n
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi n
                                %mn 1
                              %mo ,
                              %msub
                                %mi n
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo ,
                              %mn 0
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    g_{n_1 n_2} =
                    \\left\{
                    \\array{
                    const_{-1} &amp; \vert &amp; (n_1,n_2) = (0,2)
                    \\\
                    const_{-1} &amp;\vert&amp; (n_1,n_2) = (2,0)
                    \\\
                    const_1 &amp;\vert&amp; \text{otherwise}
                    }
                    \\right.
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/moebiusstrip.jpg", :width => "200"}/
            %p Since there are no non-trivial triple intersections, all cocycle conditions are evidently satisfied.
            %p
              Accordingly by example
              %a.maruku-ref{:href => "#TopologicalVectorBundleFromCechCocycle"}
              these functions define a vector bundle.
            %p
              The total space of this bundle is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to (the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/interior"} interior
              %a.maruku-ref{:href => "#IntSubset"}
              of) the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Moebius+strip"} Moebius strip
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#SquareToCyclinderTorusAndMoebius"}
          .num_example
            %h6#example_122 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/basic+complex+line+bundle+on+the+2-sphere"}> basic complex line bundle on the 2-sphere
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %msup
                        %mi y
                        %mn 2
                      %mo +
                      %msup
                        %mi z
                        %mn 2
                      %mo =
                      %mn 1
                      %mo }
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    S^2
                    \\coloneqq
                    \\left\{
                    (x,y,z)
                    \\;\vert\;
                    x^2 + y^2 + z^2 = 1
                    \\right\}
                    \\subset
                    \\mathbb{R}^3
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
              with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %msup
                          %mi S
                          %mn 2
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_{i} \subset S^2
                    \\right\}_{i \in \{+,-\}}
            %p
              be the two
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              of antipodal points
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo ±
                    %mo ≔
                    %msup
                      %mi S
                      %mn 2
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %mo ±
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_\pm \coloneqq S^2 \setminus \{(0, 0, \pm 1)\}
                    \\,.
            %p Define continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mo +
                            %mo ∩
                            %msub
                              %mi U
                              %mo −
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mrow
                                    %mo ±
                                    %mo ∓
                          %mtd
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msqrt
                              %mrow
                                %mn 1
                                %mo −
                                %msup
                                  %mi z
                                  %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mi cos
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msqrt
                              %mrow
                                %mn 1
                                %mo −
                                %msup
                                  %mi z
                                  %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mi sin
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi z
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mo ±
                            %mn 2
                            %mi π
                            %mi i
                            %mi α
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_+ \cap U_-
                    \&amp;\overset{g_{\pm \mp}}{\longrightarrow}&amp;
                    GL(1,\mathbb{C})
                    \\\
                    ( \sqrt{1-z^2} \, cos(\alpha), \sqrt{1-z^2} \, sin(\alpha), z)
                    \&amp;\mapsto&amp;
                    \\exp(\pm 2\pi i \alpha)
                    }
                    \\,.
            %p Since there are no non-trivial triple intersections, the only cocycle condition is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mo ∓
                        %mo ±
                    %msub
                      %mi g
                      %mrow
                        %mo ±
                        %mo ∓
                    %mo =
                    %msub
                      %mi g
                      %mrow
                        %mo ±
                        %mo ±
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"}
                    g_{\mp \pm} g_{\pm \mp} = g_{\pm \pm} = id
            %p which is clearly satisfied.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
              this defined is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/basic+complex+line+bundle+on+the+2-sphere"} basic complex line bundle on the 2-sphere
            %p
              With the 2-sphere identified with the
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} P^1
              (the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
              %a.existingWikiWord{:href => "/nlab/show/tautological+line+bundle"} tautological line bundle
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TautologicalTopologicalLineBundle"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1
          #ClutchingConstruction.num_example
            %h6#example_123 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/clutching+construction"}> clutching construction
                )
            %p
              Generally, for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              then the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              may be covered by two open
              %a.existingWikiWord{:href => "/nlab/show/hemispheres"} hemispheres
              intersecting in an
              %a.existingWikiWord{:href => "/nlab/show/equator"} equator
              of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϵ
                      %mo ,
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^{n-1} \times (-\epsilon, \epsilon)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo −
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⟶
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g_{+-}
                    \\;\colon\;
                    S^{n-1} \longrightarrow GL(n,k)
                    \\,.
            %p
              This is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              of vector bundles over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
          %p
            Using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            and of
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
            to vector bundles:
          #DirectSumOfTopologicalVectorBundlesViaTransitionFunctions.num_defn
            %h6#definition_69 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"}> direct sum of vector bundles
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_1 \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_2 \to X
              be two
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              with respect to which both vector bundles locally trivialize (this always exists: pick a
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
              of either bundle and form the joint
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of the respective
              %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
              by
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of their patches). Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo →
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ⟶
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    (g_1)_{i j}
                    \\colon U_i \cap U_j \to GL(n_1)
                    \\right\}
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\left\{
                    (g_2)_{i j}
                    \\colon
                    U_i \cap U_j \longrightarrow GL(n_2)
                    \\right\}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
              of these two bundles with respect to this cover.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i, j \in I
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mi j
                            %mo ⊕
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 2
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mi j
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ∩
                            %msub
                              %mi U
                              %mi j
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi x
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi g
                                        %mn 1
                                      %msub
                                        %mo{:stretchy => "false"} )
                                        %mrow
                                          %mi i
                                          %mi j
                                      %mo{:stretchy => "false"} (
                                      %mi x
                                      %mo{:stretchy => "false"} )
                                    %mtd
                                      %mn 0
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi g
                                        %mn 2
                                      %msub
                                        %mo{:stretchy => "false"} )
                                        %mrow
                                          %mi i
                                          %mi j
                                      %mo{:stretchy => "false"} (
                                      %mi x
                                      %mo{:stretchy => "false"} )
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (g_1)_{i j} \oplus (g_2)_{i j}
                    \&amp;\colon&amp;
                    U_i \cap U_j
                    \&amp;\longrightarrow&amp;
                    GL(n_1 + n_2)
                    \\\
                    \&amp;&amp;
                    x
                    \&amp;\overset{\phantom{AAA}}{\mapsto}&amp;
                    \\left(
                    \\array{
                    (g_1)_{i j}(x) &amp; 0
                    \\\
                    0 &amp; (g_2)_{i j}(x)
                    }
                    \\right)
                    }
            %p
              be the pointwise
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these transition functions
            %p
              Then the
              %em direct sum bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_1 \oplus E_2
              is the one glued from this direct sum of the transition functions (by
              = succeed "):" do
                %a{:href => "topological+vector+bundle#TopologicalVectorBundleFromCechCocycle"} this construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi E
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %munder
                          %mo ⊔
                          %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo )
                      %mo ×
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                        %mo )
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %msub
                        %mrow
                          %mo {
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi g
                            %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi i
                              %mi j
                          %mo ⊕
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi g
                            %mn 2
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi i
                              %mi j
                          %mo }
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                          %mo ∈
                          %mi I
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_1 \oplus E_2
                    \\;\coloneqq\;
                    \\left(
                    \\left( \underset{i}{\sqcup} U_i \right)
                    \\times
                    \\left(
                    \\mathbb{R}^{n_1 + n_2}
                    \\right)
                    \\right)/ \left( \left\{ (g_1)_{i j} \oplus (g_2)_{i j} \right\}_{i,j \in I} \right)
                    \\,.
          #TensorProductOfVectorBundles.num_defn
            %h6#definition_70 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"}> tensor product of vector bundles
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_1 \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_2 \to X
              be two
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              with respect to which both vector bundles locally trivialize (this always exists: pick a
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
              of either bundle and form the joint
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of the respective
              %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
              by
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of their patches). Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
