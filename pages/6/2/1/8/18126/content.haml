                  %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
