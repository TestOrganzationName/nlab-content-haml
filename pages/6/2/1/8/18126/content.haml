                                %mi lim
                                %mo ⟵
                              %mi i
                            %msub
                              %mi X
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi i
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi X
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi i
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %msub
                              %munder
                                %mi lim
