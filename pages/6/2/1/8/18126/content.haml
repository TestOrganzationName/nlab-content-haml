                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 0
                      %annotation{:encoding => "application/x-tex"} B^\circ_g(\epsilon) \subset U_{i_0}
                  is still contained in the patch. It follows that there is an element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msubsup
                          %mi B
                          %mi g
                          %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 0
                        %mo ∩
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \in B^\circ_g(\epsilon) \cap [0,g) \subset U_{i_0} \cap [0,g)
                  and such that there is a finite subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo ⊂
                        %mi I
                      %annotation{:encoding => "application/x-tex"} J \subset I
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:stretchy => "false"} }
