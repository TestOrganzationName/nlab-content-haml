              and every [neighbourhood  there exists a neighbourhood  which is  and a neighbourhood which is .]
            %p
              By local Euclideanness there exists a chart
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
