                          %mo ≤
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} T_{n \leq 2}
              %a.maruku-ref{:href => "#ReflectiveSubcategory"}
              or with sober spaces according to remark
              = succeed ")" do
                %a.maruku-ref{:href => "#SobertopologicalSpacesFormReflectiveSubcategory"}
            %p then
            %ol
              %li
                %p
                  limits in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi nice
                      %annotation{:encoding => "application/x-tex"} Top_{nice}
                  are computed as limits in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Top
                        %annotation{:encoding => "application/x-tex"} Top
              %li
                %p
                  colimits in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi nice
                      %annotation{:encoding => "application/x-tex"} Top_{nice}
                  are computed as the reflection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  of the colimit in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Top
                        %annotation{:encoding => "application/x-tex"} Top
            %p
              For example let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mi α
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi j
                    %mo ,
                    %msub
                      %mi τ
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{(X_i, \tau_i) \overset{f_\alpha}{\to} (X_j, \tau_j) \}
              be a diagram of Hausdorff spaces, regarded as a diagram of general topological spaces. Then
            %ol
              %li
                %p
                  not only is the limit of topological spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %munder
                            %mi lim
