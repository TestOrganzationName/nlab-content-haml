                        %annotation{:encoding => "application/x-tex"} \{V_\alpha \subset X\}_{\alpha \in A}\,
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi I
                      %annotation{:encoding => "application/x-tex"} \phi \colon A \to I
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ′
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi J
                      %annotation{:encoding => "application/x-tex"} \phi' \colon A \to J
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi α
                            %mo ∈
                            %mi A
                        %mrow
                          %mo (
                          %mrow
                            %mo (
                            %msub
                              %mi V
                              %mi α
                            %mo ⊂
                            %msub
                              %mi U
                              %mrow
                                %mi ϕ
                                %mo{:stretchy => "false"} (
                                %mi α
                                %mo{:stretchy => "false"} )
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mtext and
                          %mspace{:width => "thinmathspace"}
                          %mrow
                            %mo (
                            %msub
                              %mi V
                              %mi α
                            %mo ⊂
                            %mi U
                            %msub
                              %mo ′
                              %mrow
                                %mi ϕ
                                %mo ′
                                %mo{:stretchy => "false"} (
                                %mi α
                                %mo{:stretchy => "false"} )
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \underset{\alpha \in A}{\forall}\left( \left( V_\alpha \subset U_{\phi(\alpha)} \right) \,\text{and}\, \left( V_\alpha \subset U'_{\phi'(\alpha)} \right) \right)
              %li
                %p
                  a set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi κ
                          %mi α
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi V
                          %mi α
                        %mo →
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{ \kappa_\alpha \colon V_\alpha \to  GL(n,k) \}
                  of continuous functions as in def.
                  %a.maruku-ref{:href => "#CocycleCech"}
            %p such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi α
                            %mo ,
                            %mi β
                            %mo ∈
                            %mi A
                        %mrow
                          %mo (
                          %msub
                            %mi κ
                            %mi β
                          %mo ⋅
                          %msub
                            %mi g
                            %mrow
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi α
                              %mo{:stretchy => "false"} )
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi β
                              %mo{:stretchy => "false"} )
                          %mo =
                          %mi g
                          %msub
                            %mo ′
                            %mrow
                              %mi ϕ
                              %mo ′
                              %mo{:stretchy => "false"} (
                              %mi α
                              %mo{:stretchy => "false"} )
                              %mi ϕ
                              %mo ′
                              %mo{:stretchy => "false"} (
                              %mi β
                              %mo{:stretchy => "false"} )
                          %mo ⋅
                          %msub
                            %mi κ
                            %mi α
                          %mspace{:width => "thinmathspace"}
