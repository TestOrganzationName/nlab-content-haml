          #HausdorffReflectionViaHomsIntoAllHausdorffSpaces.num_prop
            %h6#proposition_25 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
