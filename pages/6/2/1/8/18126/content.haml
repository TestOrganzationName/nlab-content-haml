                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_n \coloneqq
                    (n-\epsilon, n+1+\epsilon)
                    \\times
                    \\mathbb{R}^{n-1}
                    \\;\subset\;
                    \\mathbb{R}^{n+1}
                    \\right\}_{n \in \mathbb{Z}}
                    \\,.
            %p
              This is not a finite cover, and removing any one of its patches
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi n
                    %annotation{:encoding => "application/x-tex"} U_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi ϵ
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 3
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n + \epsilon, x_2, x_3, \cdots, x_n)
              are contained only in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U_n
              and in no other patch.
          %p
            Below we prove the
            %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#BorelHeine"}
            %a.maruku-ref{:href => "#CompactClosedInterval"}
            and example
            = succeed "." do
              %a.maruku-ref{:href => "#NonCompactEuclideanSpace"}
          #UnionsAndIntersectionOfCompactSubspaces.num_example
            %h6#example_92 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/unions"} unions
                and
                = succeed ")" do
                  %span.newWikiWord
                    intersection9] of [[compact spaces
                    %a{:href => "/nlab/new/intersection9%5D+of+%5B%5Bcompact+spaces"} ?
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi K
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\{K_i \subset X\}_{i \in I}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                  %a.existingWikiWord{:href => "/nlab/show/union"} union
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∪
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi K
                          %mi i
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cup} K_i \subset X
                  is itself a compact subspace;
              %li
                %p
                  If all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi K
                          %mi i
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} K_i \subset X
                  are also
                  %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
                  then their
                  %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∩
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi K
                          %mi i
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} K_i \subset X
                  is itself a compact subspace.
          #IntersectionCompactWithOpen.num_example
            %h6#example_93 Example
            %p
              %strong (complement of compact by open subspaces is compact)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
