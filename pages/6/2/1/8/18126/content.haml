          .proof
            %h6#proof_34 Proof
            %p We discuss the first case, the second is directly analogous:
            %p
              Consider any
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              over the given free diagram:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ˜
                            %mo ,
                            %msub
                              %mi τ
                              %mover
                                %mi X
                                %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi p
                                  %msub
                                    %mo ′
                                    %mi i
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi p
                                  %msub
                                    %mo ′
                                    %mi j
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mi i
                            %mo ,
                            %msub
                              %mi τ
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mi j
                            %mo ,
                            %msub
                              %mi τ
                              %mi j
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; (\tilde X,\tau_{\tilde X})
                    \\\
                    \&amp; {}^{\mathllap{p'_i}}\swarrow &amp;&amp; \searrow^{\mathrlap{p'_j}}
                    \\\
                    (X_i, \tau_i) &amp;&amp; \underset{}{\longrightarrow} &amp;&amp; (X_j, \tau_j)
                    }
            %p
              By the nature of the limiting cone of the underlying diagram of underlying sets, which always exists by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SetLimits"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; \tilde X \longrightarrow \underset{\longleftarrow}{\lim}_{i \in I} S_i
            %p
              satisfying the required conditions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi i
                      %mo ∘
                      %mi ϕ
                      %mo =
                      %mi p
                      %msub
                        %mo ′
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p_i \circ \phi = p'_i
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              with respect to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/initial+topology"} initial topology
            %p
              Hence let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U \subset \underset{\longleftarrow}{\lim}_i X_i
              be in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi initial
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi p
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau_{initial}( \{p_i\} )
              = succeed "," do
                %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a union of finite intersections of subsets of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_i^{-1}(U_i)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i \subset X_i
              open. But since taking pre-images preserves unions and intersections (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#PreservedByPreImages"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %msub
                      %mi τ
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\tilde X, \tau_{\tilde X})
              are again open, it is sufficient to consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo =
                      %msubsup
                        %mi p
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U = p_i^{-1}(U_i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo ∘
                    %mi ϕ
                    %mo =
                    %mi p
                    %msub
                      %mo ′
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i \circ \phi = p'_i
              we find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
