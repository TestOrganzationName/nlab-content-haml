                        %mi X
                        %mn 0
                      %mo ≔
                      %msub
                        %mi Δ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} r^0_X \coloneqq \Delta_X
                ;
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/successor+ordinal"} successor ordinal
              we set
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi r
                        %mi X
                        %mrow
                          %mi α
                          %mo +
                          %mn 1
                      %mo ≔
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi X
                        %mo ×
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi q
                          %mi α
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msup
                          %mi q
                          %mi α
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi r
                          %mrow
                            %msup
                              %mi H
                              %mi α
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo }
                    %annotation{:encoding => "application/x-tex"} r_X^{\alpha+1} \coloneqq \left\{ (a,b) \in X \times X  \,\vert\, (q^\alpha(a), q^\alpha(b)) \in r_{H^\alpha(X)} \right\}
            %p
              and for a
              %a.existingWikiWord{:href => "/nlab/show/limit+ordinal"} limit ordinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              we set
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msubsup
                        %mi r
                        %mi X
                        %mi α
                      %mo ≔
                      %munder
                        %mo ∪
                        %mrow
                          %mi β
                          %mo &lt;
                          %mi α
                      %msubsup
                        %mi r
                        %mi X
                        %mi β
                    %annotation{:encoding => "application/x-tex"} r_X^\alpha \coloneqq \underset{\beta \lt \alpha}{\cup} r_X^\beta
                \.
            %p Then:
            %ol
              %li
                %p
                  there exists an ordinal
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi r
                          %mi X
                          %mi α
                        %mo =
                        %msubsup
                          %mi r
                          %mi X
                          %mrow
                            %mi α
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} r_X^\alpha = r_X^{\alpha+1}
              %li
                %p
                  for this
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mi α
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^\alpha(X) = H(X)
                  is the Hausdorff reflection from prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#HausdorffReflectionViaHomsIntoAllHausdorffSpaces"}
          %p
            A detailed
            %strong proof
            is spelled out in (
            %a{:href => "#vanMunster14"}> vanMunster 14, section 4
            ).
          .num_example
            %h6#example_54 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+reflection"} Hausdorff reflection
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/line+with+two+origins"} line with two origins
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+reflection"} Hausdorff reflection
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_2
              \-reflection, prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffReflection"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Top
                    %mo ⟶
                    %msub
                      %mi Top
                      %mi Haus
                  %annotation{:encoding => "application/x-tex"}
                    T_2 \;\colon\; Top \longrightarrow Top_{Haus}
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/line+with+two+origins"} line with two origins
              from example
              %a.maruku-ref{:href => "#LineWithTwoOrigins"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mi ℝ
                        %mo ⊔
                        %mi ℝ
                        %mo )
                      %mo{:stretchy => "false"} /
                      %mo ∼
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T_2\left(
                    \\left(
                    \\mathbb{R} \sqcup \mathbb{R}
                    \\right)/\sim
                    \\right)
                    \\;\simeq\;
                    \\mathbb{R}
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#SoberSpaces Sober spaces
          %p
            While the original formulation of the
            %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi n
                %annotation{:encoding => "application/x-tex"} T_n
            from def.
            %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
            and def.
            %a.maruku-ref{:href => "#NormalSpace"}
            clearly does follow some kind of pattern, its equivalent reformulation in terms of closure conditions in prop.
            = succeed "," do
              %a.maruku-ref{:href => "#T0InTermsOfClosureOfPoints"}
            = succeed "," do
              %a.maruku-ref{:href => "#T1InTermsOfTopologicalClosure"}
            = succeed "," do
              %a.maruku-ref{:href => "#T2InTermsOfClosedDiagonal"}
            %a.maruku-ref{:href => "#T3InTermsOfTopologicalClosures"}
            and prop.
            %a.maruku-ref{:href => "#T4InTermsOfTopologicalClosures"}
            suggests rather different patterns. Therefore it is worthwhile to also consider separation-like axioms that are not among the original list.
          %p
            In particular, the alternative characterization of the
            = succeed "-condition" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0
            %a.maruku-ref{:href => "#T0InTermsOfClosureOfPoints"}
            immediately suggests the following strengthening, different from the
            = succeed "-condition" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
            %a.maruku-ref{:href => "#T1AndSoberIncomparable"}
            below):
          #Sober.num_defn
            %h6#definition_28 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"}> sober topological space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober topological space
              precisely if every
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible closed subspace
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#IrreducibleClosureOfPoint"}
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubset"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi IrrClSub
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\{-\}) \;\colon\; X \longrightarrow IrrClSub(X)
            %p
              from the underlying set of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the set of
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subsets"} irreducible closed subsets
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClosedIrreducible"}
              = succeed ")" do
                %a.maruku-ref{:href => "#IrreducibleClosureOfPoint"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijective+function"} bijective
          #T0FromSober.num_prop
            %h6#proposition_28 Proposition
            %p
              %strong
                (sober implies
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} T_0
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sober"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
          .proof
            %h6#proof_25 Proof
            %p
              By prop.
              = succeed "." do
                %a.maruku-ref{:href => "#T0InTermsOfClosureOfPoints"}
          #SoberFromHausdorff.num_prop
            %h6#proposition_29 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+spaces+are+sober"}> Hausdorff spaces are sober
                )
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Sober"}
            %p
              More specifically, in a Hausdorff topological space the
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspaces"} irreducible closed subspaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedIrreducible"}
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SubspaceTopology"}
            %p
              Hence, by example
              = succeed "," do
                %a.maruku-ref{:href => "#HausdorffMetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              with its
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
          .proof
            %h6#proof_26 Proof
            %p
              The second statement clearly implies the first. To see the second statement, suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is an irreducible closed subspace which contained two distinct points
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \neq y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                      %mo ,
                      %msub
                        %mi U
                        %mi y
                    %annotation{:encoding => "application/x-tex"} U_x, U_y
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∖
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} F \setminus U_x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∖
                    %msub
                      %mi U
                      %mi y
                  %annotation{:encoding => "application/x-tex"} F \setminus U_y
              were distinct closed proper subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ∖
                    %msub
                      %mi U
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ∖
                    %msub
                      %mi U
                      %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F = (F \setminus U_x) \cup (F \setminus U_y)
            %p
              in contradiction to the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is irreducible.
            %p
              This
              %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proves by contradiction
              that every irreducible closed subset is a singleton. Conversely, generally the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of every singleton is irreducible closed, by example
              = succeed "." do
                %a.maruku-ref{:href => "#IrreducibleClosureOfPoint"}
          %p
            By prop.
            %a.maruku-ref{:href => "#T0FromSober"}
            and prop.
            %a.maruku-ref{:href => "#SoberFromHausdorff"}
            we have the implications on the right of the following diagram:
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi T
                                  %mn 2
                                %mo =
                                %mtext Hausdorff
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo ⇙
                              %mtd
                              %mtd
                                %mo ⇘
                            %mtr
                              %mtd
                                %mspace{:width => "thinmathspace"}
                              %mtd
                                %msub
                                  %mi T
                                  %mn 1
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mtext sober
                              %mtd
                                %mspace{:width => "thinmathspace"}
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo ⇘
                              %mtd
                              %mtd
                                %mo ⇙
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi T
                                  %mn 0
                                %mo =
                                %mtext Kolmogorov
                            %mtr
                              %mtd
                      %annotation{:encoding => "application/x-tex"} \array{\\ &amp;&amp;&amp; T_2 = \text{Hausdorff}  \\ &amp;&amp; \swArrow &amp;&amp; \seArrow \\ \, &amp; T_1 &amp;&amp; &amp;&amp; \text{sober} &amp; \, \\ &amp;&amp; \seArrow &amp;&amp; \swArrow \\ &amp;&amp;&amp; T_0 = \text{Kolmogorov} \\ }
          %p
            But there there is no implication betwee
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            and sobriety:
          .num_defn
            %h6#proposition_30 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of the
              %a.existingWikiWord{:href => "/nlab/show/classes"} classes
              of
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sober"}
              = succeed "-topological" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
          %p
            That the intersection is not empty follows from prop.
            = succeed "." do
              %a.maruku-ref{:href => "#SoberFromHausdorff"}
          #T1AndSoberIncomparable.num_example
            %h6#example_55 Example
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
                neither implies nor is implied by sobriety)
            %ul
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SierpinskiSpace"}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} T_1
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/cofinite+topology"} cofinite topology
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TopologyCofinite"}
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_1
                  but not sober.
          %p Finally, sobriety is indeed strictly weaker that Hausdorffness:
          .num_example
            %h6#example_56 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/schemes+are+sober"} schemes are sober
                but in general not
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
              on an
              %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#ZariskiTopologyOnAffineSpace"}
              %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum of a commutative ring
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#ZariskiTopologyOnPrimeSpectrum"}
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober
                  (def
                  = succeed ");" do
                    %a.maruku-ref{:href => "#Sober"}
              %li
                %p
                  in general not
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
            %p
              For details see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
              %a{:href => "Zariski+topology#ZariskiTopologyIsSober"} this prop
              and
              = succeed "." do
                %a{:href => "Zariski+topology#AffineSpaceOverInfiniteFieldNotHausdorff"} this example
          %h3#frames_of_opens Frames of opens
          %p
            What makes the concept of
            %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
            special is that for them the concept of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            may be expressed entirely in terms of the relations between their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
          %p
            Recall from example
            %a.maruku-ref{:href => "#ContinuousFunctionGivesFrameHomomorphism"}
            that for every
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi τ
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi τ
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \colon (X, \tau_X) \to (Y, \tau_Y)
            the
            %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
            function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi τ
                    %mi Y
                  %mo →
                  %msub
                    %mi τ
                    %mi X
                %annotation{:encoding => "application/x-tex"} f^{-1} \colon \tau_Y \to \tau_X
            is a
            %a.existingWikiWord{:href => "/nlab/show/frame"} frame
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
          %p For sober topological spaces the converse holds:
          #FrameMorphismsBetweenOpensOfSoberSpaces.num_prop
            %h6#proposition_31 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              are
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Sober"}
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_X \longleftarrow \tau_Y \;\colon\; \phi
            %p
              there is a unique
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is the function of forming
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              under
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi = f^{-1}
                    \\,.
          #ProofOfFrameMorphismsBetweenOpensOfSoberSpaces.proof
            %h6#proof_27 Proof
            %p We first consider the special case of frame homomorphisms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\ast \longleftarrow \tau_X \;\colon\; \phi
            %p
              and show that these are in bijection to the underlying set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ast \to (X,\tau)
              via example
              = succeed "." do
                %a.maruku-ref{:href => "#PointsViaContinuousFunctions"}
            %p
              By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#FrameHomomorphismsToPointAreIrrClSub"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
                      %mi τ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \phi \colon \tau_X \to \tau_\ast
              are identified with the irreducible closed subspaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %msub
                      %mi U
                      %mi ∅
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \setminus U_\emptyset(\phi)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sobriety
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              there is a unique point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∖
                      %msub
                        %mi U
                        %mi ∅
                      %mo =
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \setminus U_{\emptyset} = Cl(\{x\})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              an open neighbourhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              is not a subset of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi ∅
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_\emptyset(\phi)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \phi(U_x) = \{1\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext if
                              %mspace{:width => "thinmathspace"}
                              %mi x
                              %mo ∈
                              %mi U
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;\colon\;
                    U \mapsto
                    \\left\{
                    \\array{
                    \\{1\} &amp; \vert \,\text{if}\, x \in U
                    \\\
                    \\emptyset &amp; \vert \, \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p
              This is precisely the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              function of the continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \ast \to X
              which sends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ↦
                      %mi x
                    %annotation{:encoding => "application/x-tex"} 1 \mapsto x
            %p
              Hence this establishes the bijection between frame homomorphisms of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mo *
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_\ast \longleftarrow \tau_X
              and continuous functions of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ast \to (X,\tau)
            %p
              With this it follows that a general frame homomorphism of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mover
                      %mo ⟵
                      %mi ϕ
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau_X \overset{\phi}{\longleftarrow} \tau_Y
              defines a function of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \overset{f}{\longrightarrow} Y
              by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi τ
                              %mo *
                            %mo ←
                            %msub
                              %mi τ
                              %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi τ
                              %mo *
                            %mo ←
                            %msub
                              %mi τ
                              %mi X
                            %mover
                              %mo ⟵
                              %mi ϕ
                            %msub
                              %mi τ
                              %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{f}{\longrightarrow}&amp; Y
                    \\\
                    (\tau_\ast \leftarrow \tau_X)
                    \&amp;\mapsto&amp;
                    (\tau_\ast \leftarrow \tau_X \overset{\phi}{\longleftarrow} \tau_Y)
                    }
                    \\,.
            %p
              By the previous analysis, an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi Y
                    %mo ∈
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} U_Y \in \tau_Y
              is sent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1\}
              under this composite precisely if the corresponding point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \ast \to X \overset{f}{\longrightarrow} Y
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} U_Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi X
                      %mo ∈
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} U_X \in \tau_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \phi(U_Y) \in \tau_X
              is precisely that subset of points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which are sent by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} U_Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi = f^{-1}
              is the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              function of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              by definition sends open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to open subsets of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is indeed a continuous function. This proves the claim in generality.
          #Locales.num_remark
            %h6#remark_10 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locales"}> locales
                )
            %p
              Proposition
              %a.maruku-ref{:href => "#FrameMorphismsBetweenOpensOfSoberSpaces"}
              is often stated as saying that sober topological spaces are
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalently
              the “
              %a.existingWikiWord{:href => "/nlab/show/locales+with+enough+points"}> locales with enough points
              ” (
              %a{:href => "#Johnstone82"}> Johnstone 82, II 1.
              ). Here “
              %a.existingWikiWord{:href => "/nlab/show/locale"}> locale
              ” refers to a concept akin to topological spaces where one considers
              %em just
              a “
              %a.existingWikiWord{:href => "/nlab/show/frame+of+open+subsets"}> frame of open subsets
              ”
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \tau_X
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of some ambient set. The natural notion of
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between such generalized topological spaces are clearly the
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo ←
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau_X \leftarrow \tau_Y
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
            %p
              From this perspective, prop.
              %a.maruku-ref{:href => "#FrameMorphismsBetweenOpensOfSoberSpaces"}
              says that sober topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau_X)
              are entirely characterized by their
              %a.existingWikiWord{:href => "/nlab/show/frames+of+opens"} frames of opens
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              and just so happen to “have enough points” such that these are actual open subsets of some ambient set, namely of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h3#sober_reflection Sober reflection
          %p
            We saw above in prop.
            %a.maruku-ref{:href => "#HausdorffReflection"}
            that every
            = succeed "-topological" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} n \in \{0,1,2\}
            has a “best approximation from the left” by a
            = succeed "-topological" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
            = succeed "\u201D)." do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+reflection"} Hausdorff reflection
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
          %p
            Recall again the
            %a.existingWikiWord{:href => "/nlab/show/point+topological+space"} point topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %msub
                    %mi τ
                    %mo *
                  %mo =
                  %mrow
                    %mo {
                    %mi ∅
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \ast \coloneqq ( \{1\}, \tau_\ast = \left\{ \emptyset, \{1\}\right\} )
            (example
            = succeed ")." do
              %a.maruku-ref{:href => "#Point"}
          #SoberificationConstruction.num_defn
            %h6#definition_29 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sober+reflection"}> sober reflection
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S X
              to be the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                    %mo ≔
                    %mi FrameHom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S X \coloneqq FrameHom( \tau_X, \tau_\ast )
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
              %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"} frame of opens
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to that of the point. Define a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{S X} \subset P(S X)
              on this set by declaring it to have one element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde U
              for each element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} U \in \tau_X
              and given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi ϕ
                      %mo ∈
                      %mi S
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde U
                    \\;\coloneqq\;
                    \\left\{
                    \\phi \in S X
                    \\,\vert\,
                    \\phi(U) = \{1\}
                    \\right\}
                    \\,.
            %p Consider the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi s
                                  %mi X
                          %mtd
                            %mi S
                            %mi X
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi const
                              %mi x
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{s_X}{\longrightarrow}&amp; S X
                    \\\
                    x &amp;\mapsto&amp; (const_x)^{-1}
                    }
            %p
              which sends an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              to the function which assigns
              %a.existingWikiWord{:href => "/nlab/show/inverse+images"} inverse images
              of the
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} const_x \;\colon\; \{1\} \to X
              on that element.
            %p
              We are going to call this function the
              %em
                %a.existingWikiWord{:href => "/nlab/show/sober+reflection"} sober reflection
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #SoberificationConstructionWellDefined.num_lemma
            %h6#lemma_7 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sober+reflection"} sober reflection
                is well defined)
            %p
              The construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S X, \tau_{S X})
              in def.
              %a.maruku-ref{:href => "#SoberificationConstruction"}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} s_X \colon X \to S X
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    s_X \colon (X, \tau_X) \longrightarrow (S X, \tau_{S X})
          #ProofOfSoberificationConstructionWellDefined.proof
            %h6#proof_28 Proof
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi S
                        %mi X
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{S X} \subset P(S X)
              is closed under arbitrary unions and finite intersections, observe that the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                %mo ˜
                          %mtd
                            %msub
                              %mi τ
                              %mrow
                                %mi S
                                %mi X
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mo ↦
                          %mtd
                            %mover
                              %mi U
                              %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tau_X &amp;\overset{\widetilde{(-)}}{\longrightarrow}&amp; \tau_{S X}
                    \\\
                    U &amp;\mapsto&amp; \tilde U
                    }
            %p
              in fact preserves arbitrary unions and finite intersections. With this the statement follows by the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              is closed under these operations.
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{(-)}
              indeed preserves unions, observe that (e.g.
              = succeed ")" do
                %a{:href => "#Johnstone82"} Johnstone 82, II 1.3 Lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi p
                            %mo ∈
                            %munder
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mover
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                              %mo ˜
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo ⇔
                            %munder
                              %mo ∃
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %munder
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %mi p
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msub
                                %mi U
                                %mi i
                              %mo )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %mi p
                            %mo ∈
                            %mover
                              %mrow
                                %munder
                                  %mo ∪
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                                %msub
                                  %mi U
                                  %mi i
                              %mo ˜
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p \in \underset{i \in I}{\cup} \widetilde{U_i} \;
                    \&amp; \Leftrightarrow
                    \\underset{i \in I}{\exists} p(U_i) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow \underset{i \in I}{\cup} p(U_i) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow p\left(\underset{i \in I}{\cup} U_i\right) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow p \in \widetilde{ \underset{i \in I}{\cup} U_i }
                    \\end{aligned}
                    \\,,
            %p
              where we used that the frame homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo →
                    %msub
                      %mi τ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p \colon \tau_X \to \tau_\ast
              preserves unions. Similarly for intersections, now with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi p
                            %mo ∈
                            %munder
                              %mo ∩
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mover
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                              %mo ˜
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo ⇔
                            %munder
                              %mo ∀
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %munder
                              %mo ∩
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %mi p
                            %mrow
                              %mo (
                              %munder
                                %mo ∩
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msub
                                %mi U
                                %mi i
                              %mo )
                            %mo =
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇔
                            %mi p
                            %mo ∈
                            %mover
                              %mrow
                                %munder
                                  %mo ∩
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                                %msub
                                  %mi U
                                  %mi i
                              %mo ˜
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p \in \underset{i \in I}{\cap} \widetilde{U_i} \;
                    \&amp; \Leftrightarrow
                    \\underset{i \in I}{\forall} p(U_i) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow \underset{i \in I}{\cap} p(U_i) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow p\left(\underset{i \in I}{\cap} U_i\right) = \{1\}
                    \\\
                    \&amp; \Leftrightarrow p \in \widetilde{ \underset{i \in I}{\cap} U_i }
                    \\end{aligned}
                    \\,,
            %p
              where we used that the frame homomorphism
