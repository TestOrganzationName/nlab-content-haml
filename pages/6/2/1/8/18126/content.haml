                        }
                %p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                  of
                  %a.existingWikiWord{:href => "/nlab/show/function+sets"} function sets
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %munder
                                  %munder
                                    %mrow
                                      %mo {
                                      %mi X
                                      %mo ×
                                      %mi Z
                                      %mo ⟶
                                      %mi Y
                                      %mo }
                                    %mo ⏟
                                  %mrow
                                    %msub
                                      %mi Hom
                                      %mi Set
                                    %mo{:stretchy => "false"} (
                                    %mi X
                                    %mo ×
                                    %mi Z
                                    %mo ,
                                    %mi Y
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %munderover
                                  %mo ⟶
                                  %mrow
                                  %mrow
                                    %mphantom
                                      %mi AA
                                    %mo ≃
                                    %mphantom
                                      %mi AA
                              %mtd
                                %munder
                                  %munder
                                    %mrow
                                      %mo {
                                      %mi Z
                                      %mo ⟶
                                      %msub
                                        %mi Hom
                                        %mi Set
                                      %mo{:stretchy => "false"} (
                                      %mi X
                                      %mo ,
                                      %mi Y
                                      %mo{:stretchy => "false"} )
                                      %mo }
                                    %mo ⏟
                                  %mrow
                                    %msub
                                      %mi Hom
                                      %mi Set
                                    %mrow
                                      %mo (
                                      %mi Z
                                      %mo ,
                                      %msub
                                        %mi Hom
                                        %mi Set
                                      %mo{:stretchy => "false"} (
