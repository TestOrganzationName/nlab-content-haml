                    \\underoverset
                    {\underset{\phantom{AA}\iota\phantom{AA}}{\hookrightarrow}}
                    {\overset{\phantom{AA}L\phantom{AA}}{\longleftarrow}}
                    {\bot}
                    Top
            %p
              (such as with
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
