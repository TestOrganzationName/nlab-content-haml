                    %annotation{:encoding => "application/x-tex"} C
              %a.maruku-ref{:href => "#UnionOfOpensGivesClosure"}
              we need to show that there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which does not
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersect
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "." do
                %a.maruku-ref{:href => "#SeparationByNeighbourhoodsOfPointsFromCompactSubsetsInHausdorffSpaces"}
          #BorelHeine.num_prop
            %h6#proposition_52 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"}> Heine-Borel theorem
                )
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              as the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              via example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via its
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
            %p
              Then for a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{R}^n
              the following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedSubset"}
                  %a.existingWikiWord{:href => "/nlab/show/bounded+subset"} bounded
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#MetricSpaceBoundedSubset"}
          #BorelHeineProof.proof
            %h6#proof_70 Proof
            %p
              First consider a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{R}^n
              which is closed and bounded. We need to show that regarded as a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              it is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %p
              The assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is bounded by (hence contained in) some
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^\circ_x(\epsilon)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              implies that it is contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi i
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mo −
                      %mi ϵ
                      %mo ≤
                      %msub
                        %mi x
                        %mi i
                      %mo ≤
                      %mi ϵ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ (x_i)_{i = 1}^n \in \mathbb{R}^n \,\vert\, -\epsilon \leq x_i \leq \epsilon \}
              = succeed "," do
                %a.maruku-ref{:href => "#ClosedIntervalsProduct"}
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi n
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [-\epsilon, \epsilon]^n
                    \=
                    \\underset{i \in \{1, \cdots, n\}}{\prod} [-\epsilon, \epsilon]
                    \\,,
            %p
              hence to the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              copies of the closed interval with itself.
            %p
              Since the closed interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-\epsilon, \epsilon]
              is compact by example
              = succeed "," do
                %a.maruku-ref{:href => "#CompactClosedInterval"}
              %a.existingWikiWord{:href => "/nlab/show/Tychonoff+theorem"} Tychonoff theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TychonoffTheorem"}
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/subsets+are+closed+in+a+closed+subspace+precisely+if+they+are+closed+in+the+ambient+space"} subsets are closed in a closed subspace precisely if they are closed in the ambient space
              (lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#SubsetsInClosedSubspace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{R}^n
              is also closed as a subset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊂
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϵ
                      %mo ,
                      %mi ϵ
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S \subset [-\epsilon, \epsilon]^n
              %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+spaces+are+compact"} closed subspaces of compact spaces are compact
              (lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubsetsOfCompactSpacesAreCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is compact.
            %p
              Conversely, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{R}^n
              is a compact subspace. We need to show that it is closed and bounded.
            %p
              The first statement follows since the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffMetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+of+Hausdorff+spaces+are+closed"} compact subspaces of Hausdorff spaces are closed
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompactSubspacesOfHausdorffSpacesAreClosed"}
            %p
              Hence what remains is to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is bounded.
            %p
              To that end, choose any
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mrow
                        %mo &gt;
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{R}_{\gt 0}
              and consider the
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              by the open
              %a.existingWikiWord{:href => "/nlab/show/n-cubes"} n-cubes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mn 1
                    %mo −
                    %mi ϵ
                    %mo ,
                    %msub
                      %mi k
                      %mn 1
                    %mo +
                    %mn 1
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mn 2
                    %mo −
                    %mi ϵ
                    %mo ,
                    %msub
                      %mi k
                      %mn 2
                    %mo +
                    %mn 1
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi ⋯
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mi n
                    %mo −
                    %mi ϵ
                    %mo ,
                    %msub
                      %mi k
                      %mi n
                    %mo +
                    %mn 1
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (k_1-\epsilon, k_1+1+\epsilon)
                    \\times
                    (k_2-\epsilon, k_2+1+\epsilon)
                    \\times
                    \\cdots
                    \\times
                    (k_n-\epsilon, k_n+1+\epsilon)
            %p
              for
              %a.existingWikiWord{:href => "/nlab/show/n-tuples"} n-tuples
              of
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi k
                        %mn 1
                      %mo ,
                      %msub
                        %mi k
                        %mn 2
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi k
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi ℤ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} (k_1, k_2 , \cdots, k_n ) \in \mathbb{Z}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              hence form an open cover of the subspace
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is compact, there is then a finite subset of
              = succeed "-tuples" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-cubes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "-cubes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is clearly a bounded subset, and hence so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            For the record, we list some examples of
            %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
            that are immediately identified by the
            %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
            (prop.
            = succeed "):" do
              %a.maruku-ref{:href => "#BorelHeine"}
          #ExamplesOfCompactHausdorffSpaces.num_example
            %h6#example_95 Example
            %p
              %strong
                (examples of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
            %p
              We list some basic examples of
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
            %ol
              %li
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
                may canonically be regarded as a
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                of
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#SpheresAndDisks"}
            %p
              These are clearly closed and bounded subspaces of Euclidean space, hence they are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
              = succeed "." do
                %a.maruku-ref{:href => "#BorelHeine"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #MapsFromCompactSpacesToHausdorffSpacesAreClosed.num_prop
            %h6#proposition_53 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/maps+from+compact+spaces+to+Hausdorff+spaces+are+closed+and+proper"}> maps from compact spaces to Hausdorff spaces are closed and proper
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X, \tau_X) \longrightarrow (Y, \tau_Y)
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau_X)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#OpenMap"}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper map
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#ProperContinuous"}
          .proof
            %h6#proof_71 Proof
            %p
              For the first statement, we need to show that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C \subset X
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(C) \subset Y
              is a closed subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %p Now
            %ol
              %li
                %p
                  since
                  %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+spaces+are+compact"} closed subspaces of compact spaces are compact
                  (lemma
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedSubsetsOfCompactSpacesAreCompact"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} C \subset X
                  is also compact;
              %li
                %p
                  since
                  %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
                  (cor.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f(C) \subset Y
                  is compact;
              %li
                %p
                  since
                  %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+of+Hausdorff+spaces+are+closed"} compact subspaces of Hausdorff spaces are closed
                  (prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CompactSubspacesOfHausdorffSpacesAreClosed"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(C)
                  is also closed in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
            %p
              For the second statement we need to show that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} C \subset Y
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact subset
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(C)
              is compact.
            %p Now
            %ol
              %li
                %p
                  since
                  %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+of+Hausdorff+spaces+are+closed"} compact subspaces of Hausdorff spaces are closed
                  (prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CompactSubspacesOfHausdorffSpacesAreClosed"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ⊂
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} C \subset Y
                  is closed;
              %li
                %p
                  since
                  %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
                  under continuous functions of closed subsets are closed (prop.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#ClosedSubsetContinuity"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} f^{-1}(C) \subset X
                  is closed;
              %li
                %p
                  since
                  %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+spaces+are+compact"} closed subspaces of compact spaces are compact
                  (lemma
                  = succeed ")," do
                    %a.maruku-ref{:href => "#ClosedSubsetsOfCompactSpacesAreCompact"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f^{-1}(C)
                  is compact.
          %p As an immediate corollary we record this useful statement:
          #ContinuousBijectionsFromCompactSpacesToHausdorffSpacesAreHomeomorphisms.num_prop
            %h6#proposition_54 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/continuous+bijections+from+compact+spaces+to+Hausdorff+spaces+are+homeomorphisms"}> continuous bijections from compact spaces to Hausdorff spaces are homeomorphisms
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X, \tau_X) \longrightarrow (Y, \tau_Y)
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau_X)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ⟶
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
            %p
              In particular then both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y, \tau_Y)
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
          .proof
            %h6#proof_72 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#HomeoContinuousOpenBijection"}
              it is sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              = succeed "." do
                %a.maruku-ref{:href => "#MapsFromCompactSpacesToHausdorffSpacesAreClosed"}
          #CompactHausdorffSpacesAreNormal.num_defn
            %h6#proposition_55 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces+are+normal"}> compact Hausdorff spaces are normal
                )
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+topological+space"} compact Hausdorff topological space
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/normal+topological+space"} normal topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#NormalSpace"}
          .proof
            %h6#proof_73 Proof
            %p
              First we claim that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+topological+space"} regular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              and each closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \in X
              not containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              disjoint open neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi Y
                      %mo ⊃
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} U_Y \supset Y
              %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+spaces+are+compact"} closed subspaces of compact spaces are compact
              (lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#ClosedSubsetsOfCompactSpacesAreCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is in fact compact, and hence this is the statement of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#SeparationByNeighbourhoodsOfPointsFromCompactSubsetsInHausdorffSpaces"}
            %p
              Next to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is indeed normal, we apply the idea of the proof of lemma
              %a.maruku-ref{:href => "#SeparationByNeighbourhoodsOfPointsFromCompactSubsetsInHausdorffSpaces"}
              once more:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                    %mo ,
                    %msub
                      %mi Y
                      %mn 2
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y_1, Y_2 \subset X
              be two disjoint closed subspaces. By the previous statement then for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 1
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y_1 \in Y
              we find disjoint open neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_{y_1} \supset \{y_1\}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi Y
                            %mn 2
                          %mo ,
                          %msub
                            %mi y
                            %mn 1
                      %mo ⊃
                      %msub
                        %mi Y
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} U_{Y_2,y_1} \supset Y_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} U_{y_1}
              is a cover of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Y
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Y_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Y_1
              there is a finite subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} S \subset Y
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                    %mo ≔
                    %munder
                      %mo ∪
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                        %mo ⊂
                        %msub
                          %mi Y
                          %mn 1
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    U_{Y_1} \coloneqq \underset{s \in S \subset Y_1}{\cup} U_{y_1}
            %p
              is an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Y_1
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi Y
                          %mn 2
                    %mo ≔
                    %munder
                      %mo ∩
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                        %mo ⊂
                        %mi Y
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi Y
                          %mn 2
                        %mo ,
                        %mi s
                  %annotation{:encoding => "application/x-tex"}
                    U_{Y_2} \coloneqq \underset{s \in S \subset Y}{\cap} U_{Y_2,s}
            %p
              is an open neighbourhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Y
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} Y_2
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We discuss some important relations between the concept of
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
            and that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+spaces"} quotient topological spaces
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          .num_prop
            %h6#proposition_56 Proposition
            %p
              %strong (continuous surjections from compact spaces to Hausdorff spaces are quotient projections)
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi \;\colon\; (X, \tau_X) \longrightarrow (Y, \tau_Y)
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau_X)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y, \tau_Y)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ⟶
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} \pi \;\colon\; X \longrightarrow Y
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective function
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau_Y
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topology
              inherited from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              via the surjection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
          .proof
            %h6#proof_74 Proof
            %p
              We need to show that a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} U \subset Y
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y , \tau_Y)
              precisely if its
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(U) \subset X
              is an open subset in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              = succeed "," do
                %a.maruku-ref{:href => "#ClosedSubsetContinuity"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(U)
              is a closed subset. The implication
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi U
                      %mspace{:width => "thinmathspace"}
                      %mtext closed
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ⇒
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mtext closed
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left( U \, \text{closed}\right) \,\Rightarrow\, \left( f^{-1}(U) \,\text{closed}\right)
            %p
              follows via prop.
              %a.maruku-ref{:href => "#ClosedSubsetContinuity"}
              from the continuity of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mtext closed
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ⇒
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo (
                      %mi U
                      %mspace{:width => "thinmathspace"}
                      %mtext closed
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left( f^{-1}(U) \,\text{closed}\right)
                    \\,\Rightarrow\,
                    \\left( U \, \text{closed}\right)
            %p
              follows since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#MapsFromCompactSpacesToHausdorffSpacesAreClosed"}
          %p
            The following proposition allows to recognize when a
            %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
            of a compact Hausdorff space is itself still Hausdorff.
          #QuotientProjectionsOutOfCompactHausdorffSpacesAreClosedPreciselyIfTheCodomainIsHausdorff.num_prop
            %h6#proposition_57 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/quotient+projections+out+of+compact+Hausdorff+spaces+are+closed+precisely+if+the+codomain+is+Hausdorff"}> quotient projections out of compact Hausdorff spaces are closed precisely if the codomain is Hausdorff
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi \;\colon\; (X, \tau_X) \longrightarrow (Y, \tau_Y)
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X, \tau)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+topological+space"} compact Hausdorff topological space
                  (def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
                  = succeed ");" do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                      %annotation{:encoding => "application/x-tex"} \pi
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mi Y
                      %annotation{:encoding => "application/x-tex"} \tau_Y
                  is the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topology
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
            %p Then the following are equivalent
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y, \tau_Y)
                  is itself a
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                      %annotation{:encoding => "application/x-tex"} \pi
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#OpenMap"}
          .proof
            %h6#proof_75 Proof
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi τ
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mtext Hausdorff
                      %mo )
                    %mo ⇒
                    %mrow
                      %mo (
                      %mi π
                      %mspace{:width => "thinmathspace"}
                      %mtext closed
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( (Y, \tau_Y)\, \text{Hausdorff} \right) \Rightarrow \left( \pi \, \text{closed}  \right)
              is given by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#MapsFromCompactSpacesToHausdorffSpacesAreClosed"}
            %p
              Hence assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is a closed map. We need to show that for every pair of distinct points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 1
                    %mo ≠
                    %msub
                      %mi y
                      %mn 2
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y_1 \neq y_2 \in Y
              there exist
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi y
                          %mn 2
                    %mo ∈
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} U_{y_1}, U_{y_2} \in \tau_Y
              which are disjoint,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi y
                            %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi y
                            %mn 2
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U_{y_1} \cap U_{y_2} = \emptyset
            %p
              First notice that the
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \{x\}, \{y\} \in Y
              are closed. This is because they are images of singleton subsets in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %a.maruku-ref{:href => "#TnImplications"}
              and prop.
              = succeed "," do
                %a.maruku-ref{:href => "#T1InTermsOfTopologicalClosure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of closed subsets are closed, by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a closed map.
            %p
              It follows that the
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ≔
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %msub
                      %mi C
                      %mn 2
                    %mo ≔
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_1 \coloneqq \pi^{-1}(\{y_1\})
                    \\phantom{AA}
                    C_2 \coloneqq \pi^{-1}(\{y_2\})
                    \\,.
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Now again since
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces+are+normal"} compact Hausdorff spaces are normal
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactHausdorffSpacesAreNormal"}
              = succeed ")" do
                %a.maruku-ref{:href => "#NormalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ∈
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} U_1, U_2 \in \tau_X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi U
                      %mn 1
                    %mphantom
                      %mi AAA
                    %msub
                      %mi C
                      %mn 2
                    %mo ⊂
                    %msub
                      %mi U
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_1 \subset U_1 \phantom{AAA} C_2 \subset U_2
                    \\,.
            %p
              Moreover, by lemma
              %a.maruku-ref{:href => "#SaturatedOpenNeighbourhoodsOfSaturatedClosedSubsets"}
              we may find these
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              such that they are both
              %a.existingWikiWord{:href => "/nlab/show/saturated+subsets"} saturated subsets
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SubsetSaturated"}
              %a.maruku-ref{:href => "#DetectViaSaturatedSubsetsContinuousQuotientMap"}
              says that the images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi(U_i)
              are open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi τ
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} y_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} y_2
          #ContinuousBijectionFromClosedIntervalToCircle.num_example
            %h6#example_96 Example
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "http://ncatlab.org/nlab/files/ClosedIntervalQuotientedToCircle.pdf", :width => "300 /> "}/
            %p Consider the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 2
                            %mi π
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mo ∼
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ⊂
                            %msup
                              %mi ℝ
                              %mn 2
                        %mtr
                          %mtd
                            %mi t
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi cos
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi sin
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,2\pi]/\sim &amp;\longrightarrow&amp; S^1 \subset \mathbb{R}^2
                    \\\
                    t &amp;\mapsto&amp; (cos(t), sin(t))
                    }
            %ul
              %li
                %p
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                  which identifies the two endpoints
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∼
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ⇔
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mrow
                            %mo (
                            %mi x
                            %mo =
                            %mi y
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mtext or
                          %mspace{:width => "thinmathspace"}
                          %mrow
                            %mo (
                            %mrow
                              %mo (
                              %mi x
                              %mo ∈
                              %mo{:stretchy => "false"} {
                              %mn 0
                              %mo ,
                              %mn 2
                              %mi π
                              %mo{:stretchy => "false"} }
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext and
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %mi y
                              %mo ∈
                              %mo{:stretchy => "false"} {
                              %mn 0
                              %mo ,
                              %mn 2
                              %mi π
                              %mo{:stretchy => "false"} }
                              %mo )
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        (x \sim y) \;\Leftrightarrow\; \left( \left( x = y\right) \,\text{or}\, \left( \left( x \in \{0,2\pi\}\right)  \,\text{and}\, \left( y\in \{0, 2\pi\} \right)   \right) \right)
              %li
                %p
                  to the unit
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo =
                        %msub
                          %mi S
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} S^1 = S_0(1) \subset \mathbb{R}^2
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#OpenBalls"}
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                  of the 2-dimensional
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EuclideanNorm"}
            %p
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
            %p
              This is clearly a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              and a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              on the underlying sets. Moreover, since
              %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
              (cor.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is compact (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactClosedInterval"}
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              is compact.
            %p
              Hence by prop.
              %a.maruku-ref{:href => "#ContinuousBijectionsFromCompactSpacesToHausdorffSpacesAreHomeomorphisms"}
              the above map is in fact a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [0,2\pi]/\sim \;\simeq\; S^1
                    \\,.
            %p
              Compare this to the counter-example
              = succeed "," do
                %a.maruku-ref{:href => "#ExponentialMapFromHalfOpenIntervalToCircle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 2
                            %mi π
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ⊂
                            %msup
                              %mi ℝ
                              %mn 2
                        %mtr
                          %mtd
                            %mi t
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi cos
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi sin
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,2\pi) &amp;\longrightarrow&amp; S^1 \subset \mathbb{R}^2
                    \\\
                    t &amp;\mapsto&amp; (cos(t), sin(t))
                    }
            %p
              is
              %em not
              a homeomorphism, even though this, too, is a bijection on the the underlying sets. But the
              %a.existingWikiWord{:href => "/nlab/show/half-open+interval"} half-open interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,2\pi)
              is not compact (for instance by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
              = succeed ")," do
                %a.maruku-ref{:href => "#BorelHeine"}
              %a.maruku-ref{:href => "#ContinuousBijectionsFromCompactSpacesToHausdorffSpacesAreHomeomorphisms"}
              does not apply.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#locally_compact_spaces Locally compact spaces
          %p
            A topological space is
            %em
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
            if each point has a
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+spaces"} Hausdorff spaces
            %a.maruku-ref{:href => "#LocallyCompactSpace"}
            below).
          %p
            It turns out (prop.
            %a.maruku-ref{:href => "#LocallyCompactHausdorffAreSubspacesOfCompactHausdorff"}
            below) that locally compact Hausdorff spaces are precisely the open
            %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
            of the
            %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
            discussed
            = succeed "." do
              %a{:href => "#CompactSpaces"} above
          %p
            A key application of local compactness is that the
            %em
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            (topological spaces of continuous functions, def.
            %a.maruku-ref{:href => "#CompactOpenTopology"}
            below) out of a locally compact space behave as expected from mapping spaces. (prop.
            %a.maruku-ref{:href => "#UniversalPropertyOfMappingSpace"}
            below). This gives rise for instance the
            %a.existingWikiWord{:href => "/nlab/show/loop+spaces"} loop spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/path+spaces"} path spaces
            (example
            %a.maruku-ref{:href => "#LoopSpace"}
            below) which become of paramount importance in the discussion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            For the purposes of
            %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
            local compactness is useful as a criterion for identifying
            %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompactness
            (prop.
            %a.maruku-ref{:href => "#ParacompactFromLocallyCompactAndSigmacompact"}
            below).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #LocallyCompactSpace.num_defn
            %h6#definition_51 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"}> locally compact topological space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              if for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              and every
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              there exists a smaller open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi x
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} V_x \subset U_x
              whose
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              is
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msub
                      %mi V
                      %mi x
                    %mo ⊂
                    %munder
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mi x
                        %mo{:stretchy => "false"} )
                      %mtext compact
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{x\} \subset V_x \subset \underset{\text{compact}}{Cl(V_x)} \subset U_x
                    \\,.
          #LocallyCompactVarying.num_remark
            %h6#remark_19 Remark
            %p
              %strong (varying terminology regarding “locally compact”)
            %p
              On top of the terminology issue inherited from that of “compact”, remark
              %a.maruku-ref{:href => "#CompactTerminology"}
              (regarding whether or not to require “
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"}> Hausdorff
              ” with “compact”; we do not), the definition of “locally compact” is subject to further ambiguity in the literature. There are various definitions of locally compact spaces alternative to def.
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyCompactSpace"}
              = succeed "." do
                %a.maruku-ref{:href => "#LocalCompactnessViaCompactNeighbourhoodBase"}
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+spaces"} Hausdorff topological spaces
              all these definitions happen to be equivalent (prop.
              %a.maruku-ref{:href => "#InHausdorffSpacesDefinitionsOfLocalCompactnessAgree"}
              below), but in general they are not.
          #DiscreteSpacesAreLocallyCompact.num_example
            %h6#example_97 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/discrete+spaces"} discrete spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyCompactSpace"}
          #EuclideanSpacesAreLocallyCompact.num_example
            %h6#example_98 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via its
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyCompactSpace"}
          .proof
            %h6#proof_76 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              contains an
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^\circ_x(\epsilon)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBalls"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of some
              %a.existingWikiWord{:href => "/nlab/show/radius"} radius
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi x
                    %mo ≔
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_x \coloneqq B^\circ_x(\epsilon/2)
              and its topological closure, which is the
              %a.existingWikiWord{:href => "/nlab/show/closed+ball"} closed ball
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B_x(\epsilon/2)
              %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#BorelHeine"}
          #OpenSubspacesOfCompactHausdorffSpacesAreLocallyCompact.num_example
            %h6#example_99 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+subspaces+of+compact+Hausdorff+spaces+are+locally+compact"}> open subspaces of compact Hausdorff spaces are locally compact
                )
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %munder
                      %mo ⊂
                      %mtext open
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X \underset{\text{open}}{\subset} K
              of a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyCompactSpace"}
            %p
              In particular
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
              themselves are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
          #ProofOfOpenSubspacesOfCompactHausdorffSpacesAreLocallyCompact.proof
            %h6#proof_77 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              such that it arises as a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X \subset K
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyCompactSpace"}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              an open neighbourhood. We need to produce a smaller open neighbourhood whose closure is compact and still contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                    %annotation{:encoding => "application/x-tex"} U_x
            %p
              By the nature of the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              there exists an open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi x
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} V_x\subset K
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                      %mo =
                      %mi X
                      %mo ∩
                      %msub
                        %mi V
                        %mi x
                    %annotation{:encoding => "application/x-tex"} U_x = X \cap V_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X \subset K
              is assumed to be open, it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              is also open as a subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces+are+normal"} compact Hausdorff spaces are normal
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactHausdorffSpacesAreNormal"}
              %a.maruku-ref{:href => "#T4InTermsOfTopologicalClosures"}
              that there exists a smaller open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi x
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} W_x \subset K
              whose
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              is still contained in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                    %annotation{:encoding => "application/x-tex"} U_x
              %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+spaces+are+compact"} closed subspaces of compact spaces are compact
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ClosedSubsetsOfCompactSpacesAreCompact"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msub
                      %mi W
                      %mi x
                    %mo ⊂
                    %munder
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi W
                          %mi x
                        %mo{:stretchy => "false"} )
                      %mtext cpt
                    %mo ⊂
                    %msub
                      %mi V
                      %mi x
                    %mo ⊂
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{x\} \subset W_x \subset \underset{\text{cpt}}{Cl(W_x)} \subset V_x \subset K
                    \\,.
            %p
              The intersection of this situation with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the required smaller compact neighbourhood
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Cl(W_x) \cap X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msub
                      %mi W
                      %mi x
                    %mo ∩
                    %mi X
                    %mo ⊂
                    %munder
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi W
                          %mi x
                        %mo{:stretchy => "false"} )
                      %mtext cpt
                    %mo ∩
                    %mi X
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{x\} \subset W_x \cap X \subset \underset{\text{cpt}}{Cl(W_x)} \cap X \subset U_x \subset X
                    \\,.
          .num_example
            %h6#example_100 Example
            %p
              %strong
                (finite
                %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
                of
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact spaces
                is locally compact)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{i \in J}{\prod} (X_i, \tau_i)
              of a a
              %em
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{ (X_i, \tau_i) \}_{i \in I}
              of
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+spaces"} locally compact topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_i, \tau_i)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocallyCompactSpace"}
          #CountablyInfiniteProductsOfNonCompactSpacesAreNotLocallyCompact.num_example
            %h6#nonexample_2 Nonexample
            %p
              %strong (countably infinite products of non-compact spaces are not locally compact)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              which is
              %em not
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/countable+set"} countably infinite set
              of copies of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{n \in \mathbb{N}}{\prod} X
            %p
              is
              %em not
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+space"} locally compact space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyCompactSpace"}
          .proof
            %h6#proof_78 Proof
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/continuous+image+of+a+compact+space+is+compact"} continuous image of a compact space is compact
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi ℕ
                    %mi X
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p_i \;\colon\; \underset{\mathbb{N}}{\prod} X \longrightarrow X
              are continuous (by nature of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/initial+topology"} initial topology
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                    %msub
                      %mi K
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in \mathbb{N}}{\prod} K_i
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi i
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} K_i \subset X
              compact.
            %p
              But by the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
              %a.existingWikiWord{:href => "/nlab/show/base+for+a+topology"} base for the topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi ℕ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \underset{\mathbb{N}}{\prod} X
              is given by subsets of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} }
                      %msub
                        %mi U
                        %mi i
                      %mo )
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi j
                          %mo ∈
                          %msub
                            %mi ℕ
                            %mrow
                              %mo &gt;
                              %mi n
                      %mi X
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\underset{i \in \{1,\cdots,n\}}{\prod}
                    U_{i}
                    \\right)
                    \\times
                    \\left(
                    \\underset{j \in \mathbb{N}_{\gt n}}{\prod}
                    X
                    \\right)
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_i \subset X
              open. Hence every compact neighbourhood in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi ℕ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \underset{\mathbb{N}}{\prod} X
              contains a subset of this kind, but if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              itself is non-compact, then none of these is contained in a product of compact subsets.
          %p
            In the discussion of
            %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+spaces"} locally Euclidean spaces
            (def.
            %a.maruku-ref{:href => "#LocallyEuclideanSpace"}
            below), as well as in other contexts, a definition of local compactness that in the absence of Hausdorffness is slightly weaker than def.
            %a.maruku-ref{:href => "#LocallyCompactSpace"}
            (recall remark
            = succeed ")" do
              %a.maruku-ref{:href => "#LocallyCompactVarying"}
          #LocalCompactnessViaCompactNeighbourhoodBase.num_defn
            %h6#definition_52 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} local compactness
                via compact
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood+base"} neighbourhood base
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              if for for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              every
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              contains a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi x
                      %mo ⊂
                      %msub
                        %mi U
                        %mi x
                    %annotation{:encoding => "application/x-tex"} K_x \subset U_x
          #InHausdorffSpacesDefinitionsOfLocalCompactnessAgree.num_prop
            %h6#proposition_58 Proposition
            %p
              %strong (equivalence of definitions of local compactness for Hausdorff spaces)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} local compactness
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %ol
              %li
                %p
                  definition
                  %a.maruku-ref{:href => "#LocalCompactnessViaCompactNeighbourhoodBase"}
                  (every open neighbourhood contains a compact neighbourhood),
              %li
                %p
                  definition
                  %a.maruku-ref{:href => "#LocallyCompactSpace"}
                  (every open neighbourhood contains a compact neighbourhood that is the topological closure of an open neighbourhood)
            %p are equivalent.
          .proof
            %h6#proof_79 Proof
            %p
              Generally, definition
              %a.maruku-ref{:href => "#LocallyCompactSpace"}
              directly implies definition
              = succeed "." do
                %a.maruku-ref{:href => "#LocalCompactnessViaCompactNeighbourhoodBase"}
            %p
              Hence assume that for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              then every open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              contains a compact neighbourhood. We need to show that it then also contains the closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V_x)
              of a smaller open neighbourhood and such that this closure is compact.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi x
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} K_x \subset U_x
              be a compact neighbourhood. Being a neighbourhood, it has a non-trivial
              %a.existingWikiWord{:href => "/nlab/show/interior"} interior
              which is an open neighbourhood
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi K
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi K
                      %mi x
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{x\} \subset Int(K_x) \subset K_x \subset U_x \subset X
                    \\,.
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+of+Hausdorff+spaces+are+closed"} compact subspaces of Hausdorff spaces are closed
              (lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#CompactSubspacesOfHausdorffSpacesAreClosed"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} K_x \subset X
              is a closed subset. This implies that the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of its interior as a subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is still contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi x
                  %annotation{:encoding => "application/x-tex"} K_x
              (since the topological closure is the smallest closed subset containing the given subset, by def.
              = succeed "):" do
                %a.maruku-ref{:href => "#ClosedSubset"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mi Int
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi K
                        %mi x
                    %annotation{:encoding => "application/x-tex"} Cl(Int(K_x)) \subset K_x
              %a.existingWikiWord{:href => "/nlab/show/subsets+are+closed+in+a+closed+subspace+precisely+if+they+are+closed+in+the+ambient+space"} subsets are closed in a closed subspace precisely if they are closed in the ambient space
              (lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#SubsetsInClosedSubspace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi K
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(Int(K_x))
              is also closed as a subset of the compact subspace
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi x
                    %annotation{:encoding => "application/x-tex"} K_x
              %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+spaces+are+compact"} closed subspaces of compact spaces are compact
              (lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#ClosedSubsetsOfCompactSpacesAreCompact"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi x
                    %annotation{:encoding => "application/x-tex"} K_x
              %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi K
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %munder
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi Int
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi K
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %mtext compact
                    %mo ⊂
                    %munder
                      %mrow
                        %msub
                          %mi K
                          %mi x
                      %mrow
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{x\} \subset Int(K_x) \subset \underset{\text{compact}}{Cl(Int(K_x))} \subset \underset{}{K_x} \subset U_x \subset X
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            A key application of locally compact spaces is that the
            %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} space of maps
            out of them into any given topological space (example
            %a.maruku-ref{:href => "#CompactOpenTopology"}
            below) satisfies the expected
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of a
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            (prop.
            %a.maruku-ref{:href => "#UniversalPropertyOfMappingSpace"}
            below).
          #CompactOpenTopology.num_example
            %h6#example_101 Example
            %p
              %strong
                (topological
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                with
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
            %p For
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X, \tau_X)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                  (in the sense of def.
                  %a.maruku-ref{:href => "#LocallyCompactSpace"}
                  or just in the sense of def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LocalCompactnessViaCompactNeighbourhoodBase"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
                  any
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              then the
              %em
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi τ
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msub
                        %mi Hom
                        %mi Top
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi τ
                        %mtext cpt-op
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    Maps\left(
                    (X,\tau_X), (Y,\tau_Y)
                    \\right)
                    \\;\coloneqq\;
                    \\left(
                    Hom_{Top}(X,Y) , \tau_{\text{cpt-op}}
                    \\right)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ul
              %li
                %p
                  whose underlying set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_Top(X,Y)
                  is the set of
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo →
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X \to Y
              %li
                %p
                  whose topology
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mtext cpt-op
                      %annotation{:encoding => "application/x-tex"} \tau_{\text{cpt-op}}
                  is generated from the
                  %a.existingWikiWord{:href => "/nlab/show/topological+basis"} sub-basis for the topology
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TopologyBase"}
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi U
                          %mi K
                        %mo ⊂
                        %msub
                          %mi Hom
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U^K \subset Hom_{Top}(X,Y)
                  for labels
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi K
                            %mo ⊂
                            %mi X
                          %annotation{:encoding => "application/x-tex"} K \subset X
                      a
                      %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                      subset,
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo ⊂
                            %mi Y
                          %annotation{:encoding => "application/x-tex"} U \subset Y
                      an
                      %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                %p
                  and defined to be those subsets of all those
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  that take
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  to
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                        %annotation{:encoding => "application/x-tex"} U
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi U
                          %mi K
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo {
                          %mi f
                          %mo{:lspace => "verythinmathspace"} :
                          %mi X
                          %mover
                            %mo ⟶
                            %mtext continuous
                          %mi Y
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo{:stretchy => "false"} )
                          %mo ⊂
                          %mi U
                          %mo }
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        U^K
                        \\;\coloneqq\;
                        \\left\{
                        f \colon X \overset{\text{continuous}}{\longrightarrow} Y
                        \\;\;\vert\;\;
                        f(K) \subset U
                        \\right\}
                        \\,.
            %p
              Accordingly this topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mtext cpt-op
                  %annotation{:encoding => "application/x-tex"} \tau_{\text{cpt-op}}
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
              on the set of functions.
          #UniversalPropertyOfMappingSpace.num_prop
            %h6#proposition_59 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi τ
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y, \tau_Y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ,
                    %msub
                      %mi τ
                      %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Z, \tau_Z)
              be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              (def.
              %a.maruku-ref{:href => "#LocallyCompactSpace"}
              or just def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalCompactnessViaCompactNeighbourhoodBase"}
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
                  function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %msub
                                  %mi τ
                                  %mi X
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi Maps
                                %mo{:stretchy => "false"} (
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %msub
                                  %mi τ
                                  %mi X
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %msub
                                  %mi τ
                                  %mi Y
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mphantom
                                      %mi AA
                                    %mi ev
                                    %mphantom
                                      %mi AA
                              %mtd
