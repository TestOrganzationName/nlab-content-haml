          #ProofOfSequentiallyCompactMetricSpacesAreEquivCompact.proof
            %h6#proof_65 Proof
            %p
              of prop.
              %a.maruku-ref{:href => "#CompactnessImpliedBySequentialCompactnessForMetricSpace"}
              and prop.
              %a.maruku-ref{:href => "#SequentiallyCompactMetricSpacesAreEquivCompact"}
            %p
              Assume first that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (x_k)_{k \in \mathbb{N}}
              be a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/topological+closures"} topological closures
              of the sub-sequences that omit the first
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements of the sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo {
                      %msub
                        %mi x
                        %mi k
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi k
                      %mo ≥
                      %mi n
                      %mo }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_n
                    \\;\coloneqq\;
                    Cl(\left\{
                    x_k \,\vert\, k \geq n
                    \\right\})
            %p and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi n
                    %mo ≔
                    %mi X
                    %mo ∖
                    %msub
                      %mi F
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    U_n \coloneqq X \setminus F_n
            %p
              for their
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complements"} complements
            %p
              Assume now that the
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi n
                  %annotation{:encoding => "application/x-tex"} F_n
              were
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %munder
                      %mo ∩
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msub
                      %mi F
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"}
                    (\star)
                    \\phantom{AA}
                    \\underset{n \in \mathbb{N}}{\cap} F_n \;= \; \emptyset
            %p
              or equivalently that the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U_n
              were all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∪
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msub
                      %mi U
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{n \in \mathbb{N}}{\cup} U_n
                    \\;=\;
                    X
                    \\,,
            %p
              hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi n
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{U_n \subset X\}_{n \in \mathbb{N}}
              were an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is compact, this would imply that there were a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi i
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi i
