                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∩
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi C
                            %mi i
                          %mo ≠
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i \neq \emptyset
          .proof
            %h6#proof_57 Proof
            %p
              The equivalence between the first and the second statement is immediate from the definitions after expressing open subsets as complements of closed subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo =
                    %mi X
                    %mo ∖
                    %msub
                      %mi C
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i = X \setminus C_i
              and applying
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan%27s+law"} de Morgan's law
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#deMorgan"}
            %p We discuss the equivalence between the first and the third statement:
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is compact in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
              satisfies the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∩
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi C
                        %mi i
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i \neq \emptyset
            %p
              Assume that this were not the case, hence assume that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∩
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi C
                        %mi i
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i = \emptyset
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              were an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenCover"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mo ≔
                        %mi X
                        %mo ∖
                        %msub
                          %mi C
                          %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_i \coloneqq X \setminus C_i
                    \\right\}_{i \in I}
                    \\,,
            %p
              because (using
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/de+Morgan%27s+law"} de Morgan's law
              = succeed ")" do
                %a.maruku-ref{:href => "#deMorgan"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %munder
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msub
                              %mi U
                              %mi i
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo ≔
                            %munder
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mi X
                            %mo ∖
                            %msub
                              %mi C
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mrow
                              %mo (
                              %munder
                                %mo ∩
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msub
                                %mi C
                                %mi i
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mi ∅
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underset{i \in I}{\cup} U_i\;
                    \&amp; \coloneqq
                    \\underset{i \in I}{\cup} X \setminus C_i
                    \\\
                    \&amp; = X \setminus \left( \underset{i \in I}{\cap}C_i \right)
                    \\\
                    \&amp; = X \setminus \emptyset
                    \\\
                    \&amp; = X
                    \\end{aligned}
                    \\,.
            %p
              But then by compactness of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              there were a finite subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{ U_i \subset X\}_{i \in J \subset I}
              were still an open cover, hence that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∪
                        %mrow
                          %mi i
                          %mo ∈
                          %mi J
                          %mo ⊂
                          %mi I
                      %msub
                        %mi U
                        %mi i
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \underset{i \in J \subset I}{\cup} U_i = X
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan%27s+law"} de Morgan's law
              again this would mean that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi J
                                  %mo ⊂
                                  %mi I
                              %msub
                                %mi U
                                %mi i
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mi X
                            %mo ∖
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi J
                                  %mo ⊂
                                  %mi I
                              %mi X
                              %mo ∖
                              %msub
                                %mi C
                                %mi i
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∩
                              %mrow
                                %mi i
                                %mo ∈
                                %mi J
                                %mo ⊂
                                %mi I
                            %mi X
                            %mo ∖
                            %mrow
                              %mo (
                              %mi X
                              %mo ∖
                              %msub
                                %mi C
                                %mi i
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∩
                              %mrow
                                %mi i
                                %mo ∈
                                %mi J
                                %mo ⊂
                                %mi I
                            %msub
                              %mi C
                              %mi i
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\emptyset
                    \&amp; =
                    X \setminus
                    \\left(
                    \\underset{i \in J \subset I}{\cup} U_i
                    \\right)
                    \\\
                    \&amp; \coloneqq
                    X \setminus
                    \\left(
                    \\underset{i \in J \subset I}{\cup} X \setminus C_i
                    \\right)
                    \\\
                    \&amp; = \underset{i \in J \subset I}{\cap} X \setminus \left( X \setminus C_i\right)
                    \\\
                    \&amp; =
                    \\underset{i \in J \subset I}{\cap}  C_i
                    \\,.
                    \\end{aligned}
            %p
              This would be in contradiction with the finite intersection property of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi C
                        %mi i
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
            %p
              Conversely, assume that every set of closed subsets in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the finite intersection property has non-empty total intersection. We need to show that the every open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a finite subcover.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi i
                    %mo ≔
                    %mi X
                    %mo ∖
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} C_i \coloneqq X \setminus U_i
              for the closed complements of these open subsets.
            %p
              Assume on the contrary that there were no finite subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∪
                        %mrow
                          %mi i
                          %mo ∈
                          %mi J
                          %mo ⊂
                          %mi I
                      %msub
                        %mi U
                        %mi i
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \underset{i \in J \subset I}{\cup} U_i = X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∩
                        %mrow
                          %mi i
                          %mo ∈
                          %mi J
                          %mo ⊂
                          %mi I
                      %msub
                        %mi C
                        %mi i
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \underset{i \in J \subset I}{\cap} C_i = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I }
              satisfied the finite intersection property.
            %p
              But by assumption this would imply that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∩
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi C
                        %mi i
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i \neq \emptyset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∪
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi U
                        %mi i
                      %mo ≠
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cup} U_i \neq X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              are a cover. Hence we have a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          .num_example
            %h6#example_90 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/finite+topological+space"} finite
                %a.existingWikiWord{:href => "/nlab/show/discrete+spaces"} discrete spaces
                are
                = succeed ")" do
