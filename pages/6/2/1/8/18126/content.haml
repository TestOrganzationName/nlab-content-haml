                      %mi k
                      %mi n
                    %mo ⟶
                    %msub
                      %mi E
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\phi^1_i \circ f_i^{-1})_{i \in I}
                    \\;\colon\;
                    \\underset{i \in I}{\sqcup} U_i \times k^n
                    \\longrightarrow
                    E_1
                    \\,.
            %p
              These functions respect the equivalence relation, since for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"} x \in U_i \cap U_j
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mn 1
                    %mo ∘
                    %msubsup
                      %mi f
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mi j
                      %mn 1
                    %mo ∘
                    %msubsup
                      %mi f
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAA
                    %mtext since:
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ϕ
                                    %mi i
                                    %mn 1
                                  %mo ∘
                                  %msubsup
                                    %mi f
                                    %mi i
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                          %mtd
                            %msup
                              %mo ↖
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ϕ
                                    %mi j
                                    %mn 1
                                  %mo ∘
                                  %msubsup
                                    %mi f
                                    %mi j
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi i
                                  %mn 2
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                                %mo ∩
                                %msub
                                  %mi U
                                  %mi i
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msubsup
                                  %mi ϕ
