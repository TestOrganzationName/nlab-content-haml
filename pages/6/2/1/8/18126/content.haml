          #HomeomorphismBetweenTopologicalAndCombinatorialCircle.num_example
            %h6#example_42 Example
            %p
              %strong (closed interval glued at endpoints homeomorphic circle)
            %p
              As topological spaces, the
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ∼
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [0,1]_{/(0 \sim 1)} \;\; \simeq \;\; S^1
                    \\,.
            %p More in detail: let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \hookrightarrow \mathbb{R}^2
            %p
              be the unit
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              in the
              %a.existingWikiWord{:href => "/nlab/show/plane"} plane
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ,
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %msup
                      %mi y
                      %mn 2
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    S^1 = \{(x,y) \in \mathbb{R}^2, x^2 + y^2 = 1\}
            %p
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
            %p Moreover, let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ∼
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [0,1]_{/(0 \sim 1)}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} [0,1] \subset \mathbb{R}^1
              with its
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              by applying the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              which identifies the two endpoints (and nothing else).
            %p Consider then the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; [0,1] \longrightarrow S^1
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    t \mapsto (cos(2\pi t), sin(2\pi t))
                    \\,.
            %p
              This has the property that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0) = f(1)
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo ∼
                                %mn 1
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,1] &amp;\overset{}{\longrightarrow}&amp; [0,1]_{/(0 \sim 1)}
                    \\\
                    \&amp; {}_{\mathllap{f}}\searrow &amp; \downarrow^{\mathrlap{\tilde f}}
                    \\\
                    \&amp;&amp; S^1
                    }
                    \\,.
            %p
              We claim that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              (definition
              = succeed ")." do
                %a.maruku-ref{:href => "#Homeomorphism"}
            %p
              First of all it is immediate that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              and by definition of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
            %p
              So we need to check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              has a continuous inverse function. Clearly the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              itself to the open interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,1)
              has a continuous inverse. It fails to have a continuous inverse on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,1)
              and on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (0,1]
              and fails to have an inverse at all on [0,1], due to the fact that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0) = f(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ∼
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,1]_{/(0 \sim 1)}
              is exactly such as to fix this failure.
          #SquareToCyclinderTorusAndMoebius.num_defn
