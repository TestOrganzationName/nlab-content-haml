                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec x
            %p
              (The space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is the space of pairs consisting of the “name” of a
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
