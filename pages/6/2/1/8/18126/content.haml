                                  %mn 2
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
