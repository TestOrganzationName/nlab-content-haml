              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sequences"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi n
                          %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (x_{n_k})_{k \in \mathbb{N}}
              which
              %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalSpaceSequenceConverging"}
          #SequentiallyCompactMetricSpacesAreEquivCompact.num_prop
            %h6#proposition_50 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+metric+spaces+are+equivalently+compact+metric+spaces"}> sequentially compact metric spaces are equivalently compact metric spaces
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
