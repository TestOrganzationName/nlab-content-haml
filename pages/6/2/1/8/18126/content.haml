                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Now by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lebesgue+number+lemma"} Lebesgue number lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta \gt 0
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i_x \in I
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi B
                        %mi x
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi δ
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mi x
                    %annotation{:encoding => "application/x-tex"} B^\circ_x(\delta) \subset U_{i_x}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+metric+spaces+are+totally+bounded"} sequentially compact metric spaces are totally bounded
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∪
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msubsup
                      %mi B
                      %mi s
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\;=\;
                    \\underset{s \in S}{\cup}
                    B^\circ_s(\delta)
                    \\,.
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi s
                    %mo →
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi s
