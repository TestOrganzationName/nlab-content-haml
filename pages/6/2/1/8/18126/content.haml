                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          #SmoothManifoldAdmitsSmoothPartitionsOfUnity.num_prop
            %h6#proposition_85 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                admit
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/partitions+of+unity"} partitions of unity
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              has a subordinate
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PartitionOfUnity"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{f_i \colon U_i \to \mathbb{R}\}_{i \in I}
              which are
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
          .proof
            %h6#proof_127 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#SmoothManifoldClosedBallRefinementOfCover"}
              the given cover has a
              %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              by
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/closed+balls"} closed balls
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi B
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϵ
                          %mi j
                        %mo{:stretchy => "false"} )
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msub
                              %mi ψ
                              %mi j
                        %msub
                          %mi V
                          %mi j
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    B_0(\epsilon_j)
                    \\underoverset{\simeq}{\psi_j}{\to}
                    V_j
                    \\subset
                    X
                    \\right\}_{j \in J}
                    \\,.
            %p Given this, let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    h_j \;\colon\; X \longrightarrow \mathbb{R}
            %p
              be the function which on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j
              is given by a smooth
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#BumpFunction"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SomeBumpFunctions"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    b_j \;\colon\; \mathbb{R} \longrightarrow \mathbb{R}
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi B
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϵ
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} supp(b_j) = B_0(\epsilon_j)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi x
