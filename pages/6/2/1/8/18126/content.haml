                    }
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              to the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with itself.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi X
                        %mo ×
                        %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_X \;\colon\; (X, \tau) \longrightarrow (X \times X, \tau_{X \times X})
                    \\,.
            %p
              To see this, it is sufficient to see that the
              %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
              of
              %a.existingWikiWord{:href => "/nlab/show/basis+for+a+topology"} basic opens
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ×
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_1 \times U_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi X
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_{X \times X}
              are in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \tau_X
              %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ∩
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \tau_X
          #ImageFactorization.num_example
            %h6#example_31 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/image+factorization"}> image factorization
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; (X, \tau_X) \longrightarrow (Y,\tau_Y)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(X) \subset Y
              for the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              on underlying sets, and consider the resulting factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X)
              on underlying sets:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mtext surjective
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mtext injective
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\overset{\text{surjective}}{\longrightarrow}
                    f(X)
                    \\overset{\text{injective}}{\longrightarrow}
                    Y
                    \\,.
            %p
              There are the following two ways to topologize the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X)
              such as to make this a sequence of two continuous functions:
            %ol
              %li
                %p
                  By example
                  %a.maruku-ref{:href => "#SubspaceTopology"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(X)
                  inherits a
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} subspace topology
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
                  which evidently makes the inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f(X) \longrightarrow Y
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %p
                  Observe that this also makes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \to f(X)
                  a continuous function: An open subset of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(X)
                  in this case is of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi Y
                        %mo ∩
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U_Y \cap f(X)
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi Y
                          %mo ∈
                          %msub
                            %mi τ
                            %mi Y
                        %annotation{:encoding => "application/x-tex"} U_Y \in \tau_Y
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi Y
                          %mo ∩
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi Y
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f^{-1}( U_Y \cap f(X) ) = f^{-1}(U_Y)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is continuous.
              %li
                %p
                  By example
                  %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(X)
                  inherits a
                  %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topology
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau_X)
                  which evidently makes the surjection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ⟶
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \longrightarrow f(X)
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %p
                  Observe that this also makes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f(X) \longrightarrow Y
                  a continuous function: The preimage under this map of an open subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi Y
                        %mo ∈
                        %msub
                          %mi τ
                          %mi Y
                      %annotation{:encoding => "application/x-tex"} U_Y \in \tau_Y
                  is the restriction
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi Y
                          %mo ∩
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} U_Y \cap f(X)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \to f(X)
                  is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi Y
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f^{-1}(U_Y)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is continuous, and therefore
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi Y
                        %mo ∩
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U_Y \cap f(X)
                  is open in the quotient topology.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Beware, in general a continuous function itself (as opposed to its
            %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
            function) neither preserves
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
          .num_example
            %h6#example_32 Example
            %p
              Regard the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              as the 1-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{R}
              the
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#PointsViaContinuousFunctions"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℝ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi const
                                  %mi a
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R} &amp;\overset{const_a}{\longrightarrow}&amp; \mathbb{R}
                    \\\
                    x &amp;\mapsto&amp; a
                    }
            %p
              maps every
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} U \subset \mathbb{R}
              to the
              %a.existingWikiWord{:href => "/nlab/show/singleton+set"} singleton set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo ⊂
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \{a\} \subset \mathbb{R}
          .num_example
            %h6#example_33 Example
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(\mathbb{R})
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              equipped with its
              %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              equipped with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              on the underlying sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi ℝ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    id_{\mathbb{R}} \;\colon\; Disc(\mathbb{R}) \longrightarrow \mathbb{R}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (a special case of example
              = succeed ")." do
                %a.maruku-ref{:href => "#ContinuousFunctionsIntoCoDiscreteTopologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/singleton+set"} singleton
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ∈
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{a\} \in Disc(\mathbb{R})
              is open, but regarded as a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \{a\} \in \mathbb{R}
              it is not open.
          .num_example
            %h6#example_34 Example
            %p
              Consider the set of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              equipped with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(-) \;\colon\; \mathbb{R} \longrightarrow \mathbb{R}
            %p
              maps all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              (which is a closed subset, since
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo =
                      %mi ℝ
                      %mo ∖
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \mathbb{R} = \mathbb{R} \setminus \emptyset
              %a.existingWikiWord{:href => "/nlab/show/open+interval"} open interval
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} (0,\infty) \subset \mathbb{R}
          %p Those continuous functions that do happen to preserve open or closed subsets get a special name:
          #OpenMap.num_defn
            %h6#definition_22 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+maps"} open maps
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+maps"} closed maps
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X,\tau_X) \to (Y, \tau_Y)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousMaps"}
            %ul
              %li
                %p
                  an
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
                  if the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  of an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is an open subset of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
                  if the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedSubset"}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
          #OpenClosedImageProjection.num_example
            %h6#example_35 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                projections of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/open+map"} open
                %a.existingWikiWord{:href => "/nlab/show/closed+maps"} closed maps
                are themselves open/closed)
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X,\tau_X) \to (Y,\tau_Y)
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              or
              %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenMap"}
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              projection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to f(X) \subset Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(X) \subset Y
              regarded with its
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#ImageFactorization"}
          .proof
            %h6#proof_11 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an open map, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} O \subset X
              is an open subset, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(O) \subset Y
              is also open in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi O
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi O
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(O) = f(O) \cap f(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to f(X)
              is an open map.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a closed map, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C \subset X
              is a closed subset so that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(C) \subset Y
              is a closed subset, then the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∖
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y \setminus f(C)
              is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ∖
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y \setminus f(C)) \cap f(X) = f(X) \setminus f(C)
              is open in the subspace topology, which means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(C)
              is closed in the subspace topology.
          #ProjectionsAreOpenContinuousFunctions.num_example
            %h6#example_36 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/projections"} projections
                are
                %a.existingWikiWord{:href => "/nlab/show/open+map"} open
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_1,\tau_{X_1})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_2,\tau_{X_2})
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                        %mo ×
                        %msub
                          %mi X
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    pr_i \;\colon\; (X_1 \times X_2, \tau_{X_1 \times X_2}) \longrightarrow (X_i, \tau_{X_i})
            %p
              out of their
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                            %mo ×
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %msub
                              %mi x
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_1 \times X_2 &amp;\overset{pr_1}{\longrightarrow}&amp; X_1
                    \\\
                    (x_1, x_2) &amp;\overset{\phantom{AAA}}{\mapsto}&amp; x_1
                    }
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                            %mo ×
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 2
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %msub
                              %mi x
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_1 \times X_2 &amp;\overset{pr_2}{\longrightarrow}&amp; X_2
                    \\\
                    (x_1, x_2) &amp;\overset{\phantom{AAA}}{\mapsto}&amp; x_2
                    }
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/open+maps"} open
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#OpenMap"}
            %p
              This is because, by definition, every open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo ⊂
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} O \subset X_1 \times X_2
              in the product space topology is a union of products of open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ∈
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_i \in X_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                    %mo ∈
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_i \in X_2
              in the factor spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo =
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mi i
                      %mo ×
                      %msub
                        %mi V
                        %mi i
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    O = \underset{i \in I}{\cup} \left( U_i \times V_i  \right)
            %p and because taking the image of a function preserves unions of subsets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi pr
                              %mn 1
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %mrow
                                %mo (
                                %msub
                                  %mi U
                                  %mi i
                                %mo ×
                                %msub
                                  %mi V
                                  %mi i
                                %mo )
                              %mo )
                          %mtd
                            %mo =
                            %munder
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msub
                              %mi pr
                              %mn 1
                            %mrow
                              %mo (
                              %msub
                                %mi U
                                %mi i
                              %mo ×
                              %msub
                                %mi V
                                %mi i
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∪
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msub
                              %mi U
                              %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    pr_1\left(
                    \\underset{i \in I}{\cup} \left( U_i \times V_i \right)
                    \\right)
                    \&amp; =
                    \\underset{i \in I}{\cup}
                    pr_1
                    \\left(
                    U_i \times V_i
                    \\right)
                    \\\
                    \&amp; =
                    \\underset{i \in I}{\cup} U_i
                    \\end{aligned}
                    \\,.
          %p
            Below in prop.
            %a.maruku-ref{:href => "#MapsFromCompactSpacesToHausdorffSpacesAreClosed"}
            we find a large supply of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+maps"} closed maps
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Sometimes it is useful to recognize
            %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
            projections via
            %a.existingWikiWord{:href => "/nlab/show/saturated+subsets"} saturated subsets
            (essentially another term for pre-images of underlying sets):
          #SubsetSaturated.num_defn
            %h6#definition_23 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/saturated+subset"}> saturated subset
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is called an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                \-
                %a.existingWikiWord{:href => "/nlab/show/saturated+subset"} saturated subset
              (or just
              = succeed "," do
                %em saturated subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is understood) if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              of its
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/image"} image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi S
                      %mo ⊂
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mi f
                      %mtext -saturated
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ⇔
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo (
                      %mi S
                      %mo =
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(S \subset X \,\, f\text{-saturated} \right)
                    \\,\Leftrightarrow\,
                    \\left(
                    S = f^{-1}(f(S))
                    \\right)
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(f(S))
              is also called the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                \-saturation
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          #PreImagesAreSaturatedSubsets.num_example
            %h6#example_37 Example
            %p
              %strong (pre-images are saturated subsets)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \to Y
              any
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi Y
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} S_Y \subset Y
              any
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^{-1}(S_Y) \subset X
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %a.existingWikiWord{:href => "/nlab/show/saturated+subset"} saturated subset
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SubsetSaturated"}
          %p Observe that:
          #ComplementOfSaturatedSubsetIsSaturated.num_lemma
            %h6#lemma_5 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is
              = succeed "-saturated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed ")" do
                %a.maruku-ref{:href => "#SubsetSaturated"}
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi S
                  %annotation{:encoding => "application/x-tex"} X \setminus S
              is saturated.
          #DetectViaSaturatedSubsetsContinuousQuotientMap.num_prop
            %h6#proposition_13 Proposition
            %p
              %strong (recognition of quotient topologies)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousMaps"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; (X, \tau_X) \longrightarrow (Y,\tau_Y)
            %p
              whose underlying function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              is
              %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau_Y
              as the corresponding
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topology
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              sends open and
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %a.existingWikiWord{:href => "/nlab/show/saturated+subsets"} saturated subsets
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SubsetSaturated"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.maruku-ref{:href => "#ComplementOfSaturatedSubsetIsSaturated"}
              this is the case precisely if it sends closed and
              = succeed "-saturated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %p
            We record the following technical lemma about saturated subspaces, which we will need below to prove prop.
            = succeed "." do
              %a.maruku-ref{:href => "#QuotientProjectionsOutOfCompactHausdorffSpacesAreClosedPreciselyIfTheCodomainIsHausdorff"}
          #SaturatedOpenNeighbourhoodsOfSaturatedClosedSubsets.num_lemma
            %h6#lemma_6 Lemma
            %p
              %strong (saturated open neighbourhoods of saturated closed subsets under closed maps)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi τ
                          %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \;\colon\; (X, \tau_X) \longrightarrow (Y, \tau_Y)
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#OpenMap"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} C \subset X
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedSubset"}
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                  %a.existingWikiWord{:href => "/nlab/show/saturated+subset"} saturated
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#SubsetSaturated"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊃
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U \supset C
                  be an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  containing
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
            %p
              then there exists a smaller open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              still containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊃
                    %mi V
                    %mo ⊃
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    U \supset V \supset C
            %p
              and such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is still
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/saturated+subset"} saturated
          .proof
            %h6#proof_12 Proof
            %p
              We claim that the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by the
              = succeed "-saturation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed ")" do
                %a.maruku-ref{:href => "#SubsetSaturated"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≔
                    %mi X
                    %mo ∖
                    %mrow
                      %mo (
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mrow
                        %mo (
                        %mi f
                        %mrow
                          %mo (
                          %mi X
                          %mo ∖
                          %mi U
                          %mo )
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    V \coloneqq X \setminus \left(  f^{-1}\left( f\left(  X \setminus U \right)  \right) \right)
            %p has the desired properties. To see this, observe first that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∖
                        %mi U
                      %annotation{:encoding => "application/x-tex"} X \setminus U
                  is closed, since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  is assumed to be open;
              %li
                %p
                  hence the image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ∖
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(X\setminus U)
                  is closed, since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is assumed to be a closed map;
              %li
                %p
                  hence the pre-image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mrow
                          %mo (
                          %mi f
                          %mrow
                            %mo (
                            %mi X
                            %mo ∖
                            %mi U
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} f^{-1}\left( f\left(  X \setminus U \right)\right)
                  is closed, since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is continuous (using prop.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#ClosedSubsetContinuity"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  is indeed open;
              %li
                %p
                  this pre-image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mrow
                          %mo (
                          %mi f
                          %mrow
                            %mo (
                            %mi X
                            %mo ∖
                            %mi U
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} f^{-1}\left( f\left(  X \setminus U \right) \right)
                  is saturated (by example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#PreImagesAreSaturatedSubsets"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  is saturated (by lemma
                  = succeed ")." do
                    %a.maruku-ref{:href => "#ComplementOfSaturatedSubsetIsSaturated"}
            %p
              Therefore it now only remains to see that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊃
                      %mi V
                      %mo ⊃
                      %mi C
                    %annotation{:encoding => "application/x-tex"} U \supset V \supset C
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan%27s+law"} de Morgan's law
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#deMorgan"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊃
                    %mi V
                  %annotation{:encoding => "application/x-tex"} U \supset V
              is equivalent to the inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mrow
                        %mo (
                        %mi f
                        %mrow
                          %mo (
                          %mi X
                          %mo ∖
                          %mi U
                          %mo )
                        %mo )
                      %mo ⊃
                      %mi X
                      %mo ∖
                      %mi U
                    %annotation{:encoding => "application/x-tex"} f^{-1}\left( f\left(  X \setminus U \right)\right) \supset X \setminus U
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊃
                    %mi C
                  %annotation{:encoding => "application/x-tex"} V \supset C
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mrow
                        %mo (
                        %mi f
                        %mrow
                          %mo (
                          %mi X
                          %mo ∖
                          %mi U
                          %mo )
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ∩
                      %mspace{:width => "thinmathspace"}
                      %mi C
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} f^{-1}\left( f\left(  X \setminus U \right) \right) \,\cap \, C = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is saturated by assumption, this is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mrow
                        %mo (
                        %mi f
                        %mrow
                          %mo (
                          %mi X
                          %mo ∖
                          %mi U
                          %mo )
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ∩
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} f^{-1}\left( f\left(  X \setminus U \right)\right) \,\cap \, f^{-1}(f(C)) = \emptyset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mrow
                        %mo (
                        %mi X
                        %mo ∖
                        %mi U
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ∩
                      %mspace{:width => "thinmathspace"}
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} f\left(  X \setminus U \right) \,\cap \, f(C)  = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is saturated, this holds precisely if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∖
                      %mi U
                      %mo ∩
                      %mi C
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} X \setminus U \cap C = \emptyset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊃
                      %mi C
                    %annotation{:encoding => "application/x-tex"} U \supset C
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#Homeomorphisms Homeomorphisms
          %p
            With the
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            (
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"}> topological spaces
            ) and the
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            (
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"}> continuous functions
            ) of the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            thus defined (remark
            = succeed ")," do
              %a.maruku-ref{:href => "#TopCategory"}
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  X \overset{f}{\to} Y
          %p
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            is an
            %em
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            if there exists a morphism going the other way around
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ⟵
                    %mi g
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  X \overset{g}{\longleftarrow} Y
          %p
            which is an
            %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
            in the sense that both its
            %a.existingWikiWord{:href => "/nlab/show/compositions"} compositions
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            yield an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi g
                  %mo =
                  %msub
                    %mi id
                    %mi Y
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi and
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi g
                  %mo ∘
                  %mi f
                  %mo =
                  %msub
                    %mi id
                    %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f \circ g = id_Y \;\;\;\;\; and \;\;\;\;\; g \circ f = id_X
                  \\,.
          %p
            Since such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is unique if it exists, one often writes “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} f^{-1}
            ” for this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse morphism
          #Homeomorphism.num_defn
            %h6#definition_24 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"}> homeomorphisms
                )
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopCategory"}
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              between them (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousMaps"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            %p
              Hence a
              %em
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; (X, \tau_X) \longrightarrow (Y, \tau_Y)
            %p
              between two
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              such that there exists another continuous function the other way around
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    (X, \tau_X) \longleftarrow (Y, \tau_Y) \;\colon\; g
            %p
              such that their
              %a.existingWikiWord{:href => "/nlab/show/composition"} composites
              are the
              %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi g
                    %mo =
                    %msub
                      %mi id
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi id
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \circ g = id_{Y} \;\;\;and\;\;\; g \circ f = id_{X}
                    \\,.
            %p
              %img{:src => "https://ncatlab.org/nlab/files/Homeomorphism.png", :width => "560"}/
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Munkres75"} Munkres 75
            %p
              We notationally indicate that a continuous function is a homeomorphism by the symbol “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ≃
                  %annotation{:encoding => "application/x-tex"} \simeq
              ”.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; (X,\tau_X) \overset{\simeq}{\longrightarrow} (Y,\tau_Y)
                    \\,.
            %p
              If there is
              = succeed "," do
                %em some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi τ
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X,\tau_X) \,\simeq\, (Y,\tau_Y)
            %p
              and say that the two topological spaces
              %em are homeomorphic.
            %p
              A
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/property"} property
              %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              which is
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              under homeomorphism in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ≃
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi τ
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ⇔
                      %mspace{:width => "thinmathspace"}
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi τ
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    (X, \tau_X)
                    \\,
                    \\simeq
                    \\,
                    (Y,\tau_Y)
                    \\right)
                    \\;\Rightarrow\;
                    \\left(
                    P(X,\tau_X)
                    \\,\Leftrightarrow\,
                    P(Y,\tau_Y)
                    \\right)
            %p
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+property"} topological property
              or
              = succeed "." do
                %em topological invariant
          .num_remark
            %h6#remark_6 Remark
            %p
              %strong (notation for homeomorphisms)
            %p Beware the following notation:
            %ol
              %li
                %p
                  In
                  %a.existingWikiWord{:href => "/nlab/show/topology"} topology
                  the notation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} f^{-1}
                  generally refers to the
                  %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
                  function of a given
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#Homeomorphism"}
                  %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  happens to be a homeomorphism, then the pre-image of a subsets under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is its image under the inverse function
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} f^{-1}
              %li
                %p
                  Many authors strictly distinguish the symbols “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ≅
                      %annotation{:encoding => "application/x-tex"} \cong
                  ” and “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ≃
                      %annotation{:encoding => "application/x-tex"} \simeq
                  ” and use the
                  %em former
                  to denote homeomorphisms and the latter to refer to
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
                  (which we consider in
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Topology+--+2"} part 2
                  = succeed "\u201D)" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                        %annotation{:encoding => "application/x-tex"} \simeq
                  = succeed "\u201D" do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  may be and try to make that context always unambiguously explicit.
          .num_remark
            %h6#remark_7 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X, \tau_X) \to (Y, \tau_Y)
              is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            %ol
              %li
                %p
                  also
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  is a homeomophism, with inverse continuous function
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
              %li
                %p
                  the underlying function of sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  of a homeomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is necessarily a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                        %annotation{:encoding => "application/x-tex"} g
          %p
            But beware that not every
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            which is
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijective
            on underlying sets is a homeomorphism. While an
            %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            will exists on the level of functions of sets, this inverse may fail to be continuous:
          #ExponentialMapFromHalfOpenIntervalToCircle.num_example
            %h6#counter_example Counter Example
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 2
                            %mi π
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ⊂
                            %msup
                              %mi ℝ
                              %mn 2
                        %mtr
                          %mtd
                            %mi t
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi cos
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi sin
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,2\pi) &amp;\longrightarrow&amp; S^1 \subset \mathbb{R}^2
                    \\\
                    t &amp;\mapsto&amp; (cos(t), sin(t))
                    }
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/half-open+interval"} half-open interval
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ≔
                    %msub
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^1 \coloneqq S_0(1) \subset \mathbb{R}^2
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#OpenBalls"}
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+plane"} Euclidean plane
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#EuclideanNorm"}
            %p
              The underlying function of sets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
              of sets however fails to be continuous at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi S
                        %mn 1
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} (1,0) \in S^1 \subset \mathbb{R}^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em not
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            %p
              Indeed, below we see that the two topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,2\pi)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              are distinguished by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+invariants"} topological invariants
              %em any
              (other) choice of homeomorphism. For example
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,2\pi)
              is not, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              has a non-trivial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,2\pi)
              is trivial (
              %a{:href => "Introduction+to+Topology+--+2#FundamentalGroup"}> this prop.
              ).
          %p
            Below in example
            %a.maruku-ref{:href => "#ContinuousBijectionFromClosedIntervalToCircle"}
            we discuss a practical criterion under which continuous bijections are homeomorphisms after all. But immediate from the definitions is the following characterization:
          #HomeoContinuousOpenBijection.num_prop
            %h6#proposition_14 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
                are the
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                and
                %a.existingWikiWord{:href => "/nlab/show/open+map"} open
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; (X, \tau_X) \longrightarrow (Y,\tau_Y)
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ContinuousMaps"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  and an
                  %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#OpenMap"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#OpenMap"}
          .proof
            %h6#proof_13 Proof
            %p
              It is clear from the definition that a homeomorphism in particular has to be a bijection. The condition that the
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ←
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi g
                  %annotation{:encoding => "application/x-tex"} Y \leftarrow X \colon g
              be continuous means that the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              function of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              sends open subsets to open subsets. But by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              being the inverse to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g^{-1} = f \;\colon\; P(X) \to P(Y)
                    \\,.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} g^{-1}
              sends opens to opens precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              does, which is the case precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an open map, by definition. This shows the equivalence of the first two items. The equivalence between the first and the third follows similarly via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ClosedSubsetContinuity"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Now we consider some actual
            %strong examples
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
          #ConcreteAndAbstractPoint.num_example
            %h6#example_38 Example
            %p
              %strong (concrete point homeomorphic to abstract point space)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              be a
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} non-empty
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be any point. Regard the corresponding
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \{x\} \subset X
              as equipped with its
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \tau_{\{x\}}
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homeomorphic
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              from example
              = succeed ":" do
                %a.maruku-ref{:href => "#Point"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\{x\}, \tau_{\{x\}} ) \,\simeq\, \ast
                    \\,.
          #OpenBallsHomeomorphicToRn.num_example
            %h6#example_39 Example
            %p
              %strong (open interval homeomorphic to the real line)
            %p
              Regard the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              as the 1-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
            %p
              Then the open
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} (-1,1) \subset \mathbb{R}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              (def.
              %a.maruku-ref{:href => "#Homeomorphism"}>
              ) to all of the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℝ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-1,1) \,\simeq\, \mathbb{R}^1
                    \\,.
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              pair of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              is for instance given (via example
              = succeed ")" do
                %a.maruku-ref{:href => "#PolynoialsAreContinuous"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mfrac
                              %mi x
                              %msqrt
                                %mrow
                                  %mn 1
                                  %mo +
                                  %msup
                                    %mi x
                                    %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f &amp;\colon&amp;  \mathbb{R}^1 &amp;\longrightarrow&amp; (-1,+1)
                    \\\
                    \&amp;&amp; x &amp;\mapsto&amp; \frac{x}{\sqrt{1+ x^2}}
                    }
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi g
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mfrac
                              %mi x
                              %msqrt
                                %mrow
                                  %mn 1
                                  %mo −
                                  %msup
                                    %mi x
                                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    g &amp;\colon&amp;  (-1,+1) &amp;\longrightarrow&amp; \mathbb{R}^1
                    \\\
                    \&amp;&amp; x &amp;\mapsto&amp; \frac{x}{\sqrt{1 - x^2}}
                    }
                    \\,.
            %p
              But there are many other choices for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              that yield a homeomorphism.
            %p
              Similarly, for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \lt b \in \mathbb{R}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/open+intervals"} open intervals
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} (a,b) \subset \mathbb{R}
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} subspace topology
                  are all homeomorphic to each other,
              %li
                %p
                  the closed intervals
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [a,b]
                  are all homeomorphic to each other,
              %li
                %p
                  the half-open intervals of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [a,b)
                  are all homeomorphic to each other;
              %li
                %p
                  the half-open intervals of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} (a,b]
                  are all homeomorphic to each other.
            %p
              Generally, every
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBalls"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              to all of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msubsup
                        %mi B
                        %mn 0
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    B^\circ_0(\epsilon) \subset \mathbb{R}^n
                    \\right)
                    \\,\simeq\,
                    \\mathbb{R}^n
                    \\,.
          %p
            While mostly the interest in a given homeomorphism is in it being non-obvious from the definitions, many homeomorphisms that appear in practice exhibit “obvious re-identifications” for which it is of interest to leave them
            = succeed ":" do
              %em consistently implicit
          #CartesianSymmetricMonoidalTop.num_example
            %h6#example_40 Example
            %p
              %strong (homeomorphisms between iterated product spaces)
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi τ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ,
                    %msub
                      %mi τ
                      %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Z, \tau_Z)
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %p Then:
            %ol
              %li
                %p
                  There is an evident
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  between the two ways of bracketing the three factors when forming their
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
                  = succeed ":" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi α
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                            %mo ,
                            %mi Z
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi τ
                            %mi X
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %msub
                            %mi τ
                            %mi Y
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mi Z
                        %mo ,
                        %msub
                          %mi τ
                          %mi Z
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %mo ≃
                            %mphantom
                              %mi AA
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %msub
                            %mi τ
                            %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mi Z
                          %mo ,
                          %msub
                            %mi τ
                            %mi Z
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\alpha_{X,Y,Z}
                        \\;\colon\;
                        \\left(
                        (X, \tau_X) \times (Y, \tau_Y)
                        \\right)
                        \\times
                        (Z, \tau_Z)
                        \\overset{\phantom{AA}\simeq\phantom{AA}}{\longrightarrow}
                        (X,\tau_X)
                        \\times
                        \\left(
                        (Y,\tau_Y)
                        \\times
                        (Z, \tau_Z)
                        \\right)
                        \\,.
              %li
                %p
                  There are evident
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  between
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  and its
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                  (example
                  = succeed ")," do
                    %a.maruku-ref{:href => "#Point"}
                  = succeed ":" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi λ
