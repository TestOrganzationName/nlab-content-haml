                      %mo &lt;
                      %mi r
                      %mo ′
                      %mo &lt;
                      %mi r
                      %mo +
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} r \lt r' \lt r + \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi r
                        %mo ′
                    %mo ⊃
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_{r'} \supset Cl(U_r)
              hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
