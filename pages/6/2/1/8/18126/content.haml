            %p
              by
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              whose
              %a.existingWikiWord{:href => "/nlab/show/topological+closures"} topological closures
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 0
                    %mo ⊂
                    %msub
                      %mi K
                      %mn 1
                    %mo ⊂
                    %msub
                      %mi K
                      %mn 2
                    %mo ⊂
