                        %mo ×
                        %msub
                          %mi X
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 1
                    %mo ×
                    %msub
                      %mi Y
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                        %mo ×
                        %msub
                          %mi Y
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_1 \times f_2
                    \\;\colon\;
                    (X_1 \times X_2, \tau_{X_1 \times X_2})
                    \\longrightarrow
                    (Y_1 \times Y_2, \tau_{Y_1 \times Y_2})
                    \\,.
            %p
              Moreover, this construction respects
              %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
              and
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of functions in both arguments.
            %p
              In the language of
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              (remark
              = succeed ")," do
                %a.maruku-ref{:href => "#TopCategory"}
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-) \times (-)
              extends to a
              %em
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              of the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              with itself to itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Top
                    %mo ×
                    %mi Top
                    %mo ⟶
                    %mi Top
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-) \times (-)
                    \\;\colon\;
                    Top \times Top
                    \\longrightarrow
                    Top
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#ContinuousFunctionsExamples Examples
          %p
            We discuss here some basic examples of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ContinuousMaps"}
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#TopologicalSpace"}
            %em
              %a{:href => "#UniversalConstructions"} Universal constructions
            we discuss a general principle that serves to produce examples of continuous functions with prescribed “
            %a.existingWikiWord{:href => "/nlab/show/universal+properties"}> universal properties
            ”.
          #TerminalityOfThePoint.num_example
