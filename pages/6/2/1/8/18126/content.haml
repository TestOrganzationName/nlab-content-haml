          #SmoothManifoldRealComplexProjectiveSpace.num_example
            %h6#example_131 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+projective+space"}> real
                \/
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} k \in \{\mathbb{R}, \mathbb{C}\}
              the topological
              %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ToplogicalProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalManifold"}
            %p
              Equipped with the standard open cover of def.
              %a.maruku-ref{:href => "#TopologicalProjectiveSpaceStandardOpenCover"}
              regarded as an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#ProjectiveSpaceOpenCoverIsAtlas"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
          .proof
            %h6#proof_119 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#ProjectiveSpaceOpenCoverIsAtlas"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+space"} locally Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              admits the structure of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              (
              %a{:href => "real+projective+space#RealProjectiveSpaceCWComplex"} this prop.
              and
              = succeed ")" do
                %a{:href => "complex+projective+space#CellComplexStructureOnComplexProjectiveSpace"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
              since
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes+are+paracompact+Hausdorff+spaces"} CW-complexes are paracompact Hausdorff spaces
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            %p
              It remains to see that the
              %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
              of this atlas are
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
              and in fact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %a.maruku-ref{:href => "#ProjectiveSpaceOpenCoverIsAtlas"}
              they are even
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundle"} differentiable vector bundle
            is defined just as a
            %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#TopologicalVectorBundle"}
          #DifferentiableVectorBundle.num_defn
            %h6#definition_81 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundle"}> differentiable vector bundle
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a “differentiable field”, specifically
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} k  \in \{\mathbb{R}, \mathbb{C}\}
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
              is equipped with the canonical
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} differentiable structure
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundle"} differentiable k-vector bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo ⟶
                          %mi π
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{\pi}{\longrightarrow} X
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DifferentiableManifold"}
              %li
                %p
                  the structure of a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi^{-1}(\{x\})
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
            %p such that there exists
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi ℝ
                          %mi d
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^d \underoverset{\simeq}{\phi_i}{\to}\}_{i \in I}
                  by open subsets
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
                  to Euclidean space with its canonical smooth structure from example
                  %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
                  (hence an
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                  exhibiting the
                  %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
                  of
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i \in I
                  a
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
                  as on the top of this diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi ℝ
                                  %mi d
                                %mo ×
                                %msup
                                  %mi k
                                  %mi n
                              %mtd
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi ψ
                                      %mi i
                              %mtd
                              %mtd
                                %mi E
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mi U
                                      %mi i
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi ϕ
                                        %mi i
