          #PointsViaContinuousFunctions.num_example
            %h6#example_28 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/constant+functions"} constant
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau)
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              any element of the underlying set, there is a unique continuous function (which we denote by the same symbol)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    x \;\colon\; \ast \longrightarrow X
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/point+topological+space"} point topological space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Point"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is that element. Hence there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo *
                      %mover
                        %mo →
                        %mi f
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext continuous
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\ast \overset{f}{\to} X
                    \\,\vert\, f \,\,\text{continuous}
                    \\right\}
                    \\;\simeq\;
                    X
            %p between the continuous functions from the point to any topological space, and the underlying set of that topological space.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              two topological spaces, then a continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              between them is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              with value some point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              if it factors through the point spaces as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∃
                        %mo !
                    %mo *
                    %mover
                      %mo ⟶
                      %mi y
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    const_y
                    \\;\colon\;
                    X \overset{\exists !}{\longrightarrow} \ast \overset{y}{\longrightarrow} Y
                    \\,.
