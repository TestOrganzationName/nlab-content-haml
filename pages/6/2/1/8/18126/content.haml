            %p
              Since Euclidean spaces are locally compact (example
              = succeed ")," do
                %a.maruku-ref{:href => "#EuclideanSpacesAreLocallyCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mrow
                        %msup
                          %mi ϕ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} K_{\phi^{-1}(x)} \subset \mathbb{R}^n
              (for instance a sufficiently small
              %a.existingWikiWord{:href => "/nlab/show/closed+ball"} closed ball
              around
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
