                  %mrow
                    %mi T
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo :
                      %mi ⋯
                      %mo :
                      %msub
                        %mi x
                        %mrow
                          %mi n
