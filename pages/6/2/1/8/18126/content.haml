                            %mn 2
                      %msub
                        %mi E
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msubsup
                            %mi U
                            %mrow
                              %msub
                                %mi i
                                %mn 2
                            %mn 2
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %msub
                            %mi i
                            %mn 2
                          %mo ∈
                          %msub
                            %mi I
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \{ U^2_{i_2} \underoverset{\simeq}{\phi^2_{i_2}}{\to} E_2\vert_{U^2_{i_2}} \}_{i_2 \in I_2}
            %p
              The
              %em
                joint
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of these two covers is the open cover given by the intersections of the original patches:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                            %mo ,
                            %msub
                              %mi i
                              %mn 2
                        %mo ≔
                        %msubsup
                          %mi U
