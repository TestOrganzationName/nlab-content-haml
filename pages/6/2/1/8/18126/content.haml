                %semantics
                  %mrow
                    %mi ∅
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi ∅
                      %mo ,
                      %msub
