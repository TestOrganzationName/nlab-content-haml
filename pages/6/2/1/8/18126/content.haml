                    }
                    \\right.
                    }
                    }
                    \\,.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              by example
              = succeed "," do
                %a.maruku-ref{:href => "#ClosedSubspacesGluing"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              (the “concatenated path”). Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ∼
                      %mi pcon
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \sim_{pcon} y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %msub
                      %mo ∼
                      %mi pcon
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y \sim_{pcon} z
              implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ∼
                      %mi pcon
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x \sim_{pcon} z
              (
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"}> transitivity
              ).
          #PathConnectedComponents.num_defn
            %h6#definition_43 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"}> path-connected components
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of the equivalence relation “connected by a path” (def.
              = succeed "," do
                %a.maruku-ref{:href => "#Path"}
              = succeed ")" do
                %a.maruku-ref{:href => "#ConnectedByPathIsEquivalenceRelation"}
              %em path-connected components
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo ∼
                      %mi pcon
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(X) \;\coloneqq\; X/\sim_{pcon}
                    \\,.
            %p
              (The notation reflects the fact that this is the degree-zero case of a more general concept of
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \pi_n
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Topology+--+2"} part 2
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Homotopy+Theory"} Introduction to Homotopy Theory
            %p
              If there is a single path-connected component (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \pi_0(\ast) \simeq \ast
              ), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
          #PathConnectedEuclideanSpace.num_example
            %h6#example_87 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is a
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PathConnectedComponents"}
            %p
              Because for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo ,
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \vec x, \vec y \in \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mi γ
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                            %mi t
                          %mtd
                            %mo ↦
                          %mtd
                            %mi t
                            %mover
                              %mi y
                              %mo{:stretchy => "false"} →
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo −
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,1] &amp;\overset{\gamma}{\longrightarrow}&amp; \mathbb{R}^n
                    \\\
                    t &amp;\mapsto&amp; t \vec y + (1-t) \vec x
                    }
                    \\,.
            %p
              This clearly has the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \gamma(0) = \vec x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \gamma(1) = \vec y
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              function and
              %a.existingWikiWord{:href => "/nlab/show/polynomials+are+continuous+functions"} polynomials are continuous functions
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#PolynoialsAreContinuous"}
          #PathConnectedContinuousImage.num_example
            %h6#example_88 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                of
                %a.existingWikiWord{:href => "/nlab/show/path-connected+space"} path-connected space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+space"} path-connected
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %munderover
                      %mo ⟶
                      %mtext surjective
                      %mi p
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mtext injective
                      %mi i
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\underoverset{\text{surjective}}{p}{\longrightarrow}
                    f(X)
                    \\underoverset{\text{injective}}{i}{\longrightarrow}
                    Y
            %p
              with either of its two possible topologies (example
              = succeed ")" do
                %a.maruku-ref{:href => "#ImageFactorization"}
            %p
              In particular path-connectedness is a
              %a.existingWikiWord{:href => "/nlab/show/topological+property"} topological property
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Homeomorphism"}
          .proof
            %h6#proof_51 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y \in X
              be two points. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \;\colon\; X \to f(X)
              is surjective, there are pre-images
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p^{-1}(x), p^{-1}(y) \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is path-connected, there is a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma \colon [0,1] \longrightarrow X
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(0) = p^{-1}(x)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma(1) = p^{-1}(y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \circ \gamma \;\colon\; [0,1] \to f(X)
              is a path connecting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
          #PathSpace.num_remark
            %h6#remark_15 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/path+space"}> path space
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanSpacesAreLocallyCompact"}
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P X
                    \\;\coloneqq\; Maps([0,1],X)
            %p
              hence the set of
              %a.existingWikiWord{:href => "/nlab/show/paths"} paths
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Path"}
              %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompactOpenTopology"}
            %p
              This is often called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              By functoriality of the mapping space (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalMappingSpaceIsExponentialObject"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi const
                          %mn 0
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %mo *
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi const
                          %mn 1
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\ast \overset{const_0}{\hookrightarrow} [0,1]
                    \\phantom{AA}
                    \\text{and}
                    \\phantom{AA}
                    \\ast \overset{const_1}{\hookrightarrow} [0,1]
            %p induce two continuous functions of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                    %mo =
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mi const
                            %mn 1
                            %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mi const
                            %mn 0
                            %mo *
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P X
                    \=
                    Maps([0,1],X)
                    \\underoverset
                    {\underset{const_1^\ast}{\longrightarrow}}
                    {\overset{const_0^\ast}{\longrightarrow}}
                    {}
                    Maps(\ast,X)
                    \\simeq
                    X
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CoequalizerInTop"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(X)
              of path-connected components (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PathConnectedComponents"}
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
          #ConnectedPathConnectedSpace.num_lemma
            %h6#lemma_13 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/path-connected+spaces"} path-connected spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/path+connected+topological+space"} path connected topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PathConnectedComponents"}
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ConnectedTopologicalSpace"}
          .proof
            %h6#proof_52 Proof
            %p
              Assume it were not, then it would be covered by two disjoint non-empty open subsets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ,
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U_1, U_2 \subset X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma \colon [0,1] \to X
              from a point in one of the open subsets to a point in the other. The continuity would imply that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi γ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi γ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma^{-1}(U_1), \gamma^{-1}(U_2) \subset [0,1]
              were a disjoint open cover of the interval. This would be in contradiction to the fact that intervals are connected. Hence we have a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          #PathConnectedLocally.num_defn
            %h6#definition_44 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"}> locally path-connected topological space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
              if for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              and every
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              there exists a neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi x
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} C_x \subset U_x
              which, as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PathConnectedComponents"}
          .num_example
            %h6#examples_4 Examples
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (with its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              is a
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#PathConnectedEuclideanSpace"}
          .num_example
            %h6#example_89 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open subspace
                of
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+space"} locally path-connected space
                is locally path-connected)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of a
              %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected topological space
              is itself locally path-connected.
          %p
            Another class of examples we consider below:
            %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+topological+spaces"} locally Euclidean topological spaces
            are locally path-connected (prop.
            %a.maruku-ref{:href => "#LocalPropertiesOfLocallyEuclideanSpace"}
            below).
          #InLocallyPathConnectedSpaceThePathConnectedComponentsAreOpen.num_prop
            %h6#proposition_41 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PathConnectedLocally"}
              %a.existingWikiWord{:href => "/nlab/show/open+set"} open set
              and a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+set"} closed set
          .proof
            %h6#proof_53 Proof
            %p
              To see that every path connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi x
                  %annotation{:encoding => "application/x-tex"} P_x
              is open, it is sufficient to show that every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %msub
                      %mi P
                      %mi x
                  %annotation{:encoding => "application/x-tex"} y \in P_x
              has an
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi y
                  %annotation{:encoding => "application/x-tex"} U_y
              which is still contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mi x
                    %annotation{:encoding => "application/x-tex"} P_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              has a neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi y
                  %annotation{:encoding => "application/x-tex"} V_y
              which is path connected. It follows by concatenation of paths (as in the proof of lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#ConnectedByPathIsEquivalenceRelation"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi y
                      %mo ⊂
                      %msub
                        %mi P
                        %mi x
                    %annotation{:encoding => "application/x-tex"} V_y \subset P_x
            %p
              Now each path-connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi x
                  %annotation{:encoding => "application/x-tex"} P_x
              is the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of all the other path-connected components. Since these are all open, their union is open, and hence the complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi x
                  %annotation{:encoding => "application/x-tex"} P_x
              is closed.
          #ForLocallyPathConnectedThenPathConnectedComponentsAgree.num_prop
            %h6#proposition_42 Proposition
            %p
              %strong
                (in a
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+space"} locally path-connected space
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                coincide with path-connected components)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PathConnectedLocally"}
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              according to def.
              %a.maruku-ref{:href => "#ComponentsConnected"}
              agree with the path-connected components according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#PathConnectedComponents"}
            %p
              In particular, locally path connected spaces are
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+spaces"} locally connected topological spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyConnected"}
          .proof
            %h6#proof_54 Proof
            %p
              A path connected component is always connected by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#ConnectedPathConnectedSpace"}
              = succeed "." do
                %a.maruku-ref{:href => "#InLocallyPathConnectedSpaceThePathConnectedComponentsAreOpen"}
            %p
              Conversely let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              be a connected component. It is now sufficient to see that this is path-connected. Suppose it were not, then it would be covered by more than one disjoint non-empty path-connected components. But by prop.
              %a.maruku-ref{:href => "#InLocallyPathConnectedSpaceThePathConnectedComponentsAreOpen"}
              these would all be open. This would be in contradiction with the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is connected. Hence we have a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#Embeddings Embeddings
          %p
            Often it is important to know whether a given space is homeomorphism to its
            = succeed "," do
              %em image
            %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding of topological spaces
            (def.
            %a.maruku-ref{:href => "#EmbeddingOfTopologicalSpaces"}
            below) we will later refine to that of
            %em
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding of smooth manifolds
            (
            %a{:href => "#EmbeddingOfSmoothManifolds"}> below
            ).
          #EmbeddingOfTopologicalSpaces.num_defn
            %h6#definition_45 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"}> embedding of topological spaces
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              is called an
              %em
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding of topological spaces
              if in its
              %a.existingWikiWord{:href => "/nlab/show/image+factorization"} image factorization
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#ImageFactorization"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi A
                        %mo ≃
                        %mphantom
                          %mi A
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\overset{\phantom{A}\simeq\phantom{A}}{\longrightarrow}
                    f(X)
                    \\overset{\phantom{AAA}}{\hookrightarrow}
                    Y
            %p
              with the image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(X) \hookrightarrow Y
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to f(X)
              is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Homeomorphism"}
          #OpenClosedContinuousInjectionsAreEmbeddings.num_prop
            %h6#proposition_43 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/closed+injections+are+embeddings"}> open/closed continuous injections are embeddings
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X, \tau_X) \to (Y,\tau_Y)
              which is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
                  or a
                  %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#OpenMap"}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding of topological spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#EmbeddingOfTopologicalSpaces"}
            %p
              This is called a
              %em closed embedding
              if the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(X) \subset Y
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
          .proof
            %h6#proof_55 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is injective, then the map onto its
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to f(X) \subset Y
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(X)
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#ImageFactorization"}
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              or a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              %a.maruku-ref{:href => "#HomeoContinuousOpenBijection"}
              \. But the image projection of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has this property, respectively, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              does, by prop
              = succeed "." do
                %a.maruku-ref{:href => "#OpenClosedImageProjection"}
          %p
            The following characterization of closed embeddings uses concepts of (locally) compact spaces discussed
            = succeed "." do
              %a{:href => "#CompactSpaces"} below
            %a.existingWikiWord{:href => "/nlab/show/embeddings+of+smooth+manifolds"} embeddings of smooth manifolds
            %a{:href => "#Embeddings"} further bellow
            in prop.
            = succeed "." do
              %a.maruku-ref{:href => "#ProperInjectiveImmersionsAreEquivalentlyTheClosedEmbeddings"}
          #InjectiveProperMapsAreEquivalentlyTheClosedEmbeddings.num_prop
            %h6#proposition_44 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/injective+proper+maps+to+locally+compact+spaces+are+equivalently+the+closed+embeddings"}> injective proper maps to locally compact spaces are equivalently the closed embeddings
                )
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#LocallyCompactSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %p Then the following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective
                  %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper map
                  (prop.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#ProperContinuous"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a closed
                  %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding of topological spaces
                  (def
                  = succeed ")." do
                    %a.maruku-ref{:href => "#EmbeddingOfTopologicalSpaces"}
          .proof
            %h6#proof_56 Proof
            %p
              In one direction, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an injective proper map, then since
              %a.existingWikiWord{:href => "/nlab/show/proper+maps+to+locally+compact+spaces+are+closed"} proper maps to locally compact spaces are closed
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ProperMapsToLocallyCompactSpacesAreClosed"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is also
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              %a.existingWikiWord{:href => "/nlab/show/closed+injections+are+embeddings"} closed injections are embeddings
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#OpenClosedContinuousInjectionsAreEmbeddings"}
            %p
              Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a closed embedding, we only need to show that the embedding map is proper. So for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} C \subset Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+subspace"} compact subspace
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^{-1}(C) \subset X
              is also compact. But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an injection (being an embedding), that pre-image is equivalently just the intersection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi C
                      %mo ∩
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f^{-1}(C) \simeq C \cap f(X) \subset Y
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %p
              To see that this is compact, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{V_i \subset X\}_{i \in I}
              be an open cover of the subspace
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ∩
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C \cap f(X)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset Y\}_{i \in I}
              be a set of open subsets of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∩
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} C \cap f(X) \subset Y
              and with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V_i
              the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ∩
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C \cap f(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(X) \subset Y
              is closed by assumption, it follows that the complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∖
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y \setminus f(X)
              is open and hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mi Y
                    %mo ∖
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\{ U_i \subset Y \}_{i \in  I} \sqcup \{ Y \setminus f(X) \}
            %p
              is an open cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ⊂
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} C \subset Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              this has a finite subcover. Since restricting that finite subcover back to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∩
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \cap f(X)
              makes the potential element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∖
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y \setminus f(X)
              disappear, this restriction is a finite subcover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi V
                        %mi i
                      %mo ⊂
                      %mi C
                      %mo ∩
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{V_i \subset C \cap f(X)\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∩
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \cap f(X)
              is compact.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#CompactSpaces Compact spaces
          %p
            We discuss
            %em
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
            (def
            %a.maruku-ref{:href => "#CompactTopologicalSpace"}
            below), the generalization of compact metric spaces
            = succeed "." do
              %a{:href => "#CompactMetricSpaces"} above
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            to what
            %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            are in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+spaces"} finite-dimensional vector spaces
            are in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Prop.
            %a.maruku-ref{:href => "#CompactnessImpliedBySequentialCompactnessForMetricSpace"}
            suggests the following simple definition
            = succeed ":" do
              %a.maruku-ref{:href => "#CompactTopologicalSpace"}
          #OpenCover.num_defn
            %h6#definition_46 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+cover"}> open cover
                )
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              of
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              is all of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∪
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi U
                        %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cup} U_i \;=\; X
            %p
              A
              %em subcover
              of a cover is a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in J \subset I}
              is still a cover.
          #CompactTopologicalSpace.num_defn
            %h6#definition_47 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"}> compact topological space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              if every
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenCover"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/finite+cover"} finite subcover
              in that there is a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in J}
              is still a cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in that also
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∪
                        %mrow
                          %mi i
                          %mo ∈
                          %mi J
                      %msub
                        %mi U
                        %mi i
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \underset{i \in J}{\cup} U_i = X
          #CompactTerminology.num_remark
            %h6#remark_16 Remark
            %p
              %strong (varying terminology regarding “compact”)
            %p Beware the following terminology issue which persists in the literature:
            %p
              Some authors use “compact” to mean “
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"}> Hausdorff and compact
              ”. To disambiguate this, some authors (mostly in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
              = succeed ")" do
                %a{:href => "#Waldhausen"} Waldhausen
              = succeed "." do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
          %p
            There are several equivalent reformulations of the compactness condition. An immediate reformulation is prop.
            = succeed "," do
              %a.maruku-ref{:href => "#ClosedSubsetFormulationOfCompactness"}
            %a.maruku-ref{:href => "#ClosedProjectionCharacterizationOfCompactness"}
            further below.
          #ClosedSubsetFormulationOfCompactness.num_prop
            %h6#proposition_45 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compactness
                in terms of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  is
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  in the sense of def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi C
                          %mi i
                        %mo ⊂
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
                  be a set of
                  %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ClosedSubset"}
                  %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                  is
                  %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∩
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi C
                            %mi i
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i = \emptyset
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo ⊂
                        %mi I
                      %annotation{:encoding => "application/x-tex"} J \subset I
                  such that the corresponding finite intersection is still empty
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∩
                            %mrow
                              %mi i
                              %mo ∈
                              %mi J
                              %mo ⊂
                              %mi i
                          %msub
                            %mi C
                            %mi i
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \underset{i \in  J \subset i}{\cap} C_i = \emptyset
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi C
                          %mi i
                        %mo ⊂
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
