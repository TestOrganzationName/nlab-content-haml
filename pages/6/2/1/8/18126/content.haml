                    \=
                    \\left[
                    \\frac{x_1}{x_i} : \cdots : 1 : \cdots \frac{x_{n+1}}{x_i}
                    \\right]
            %p
              and the representatives of the form on the right are
              = succeed "." do
                %em unique
            %p This means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
