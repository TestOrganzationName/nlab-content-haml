          #UnitIntoSXDetectsT0AndSobriety.num_lemma
            %h6#lemma_8 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sober+reflection"} sober reflection
                detects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} T_0
                and sobriety)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau_X)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} s_X \colon X \to S X
              from def.
              %a.maruku-ref{:href => "#SoberificationConstruction"}
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/injection"} injection
                  precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau_X)
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} T_0
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
