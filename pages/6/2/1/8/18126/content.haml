              %a.existingWikiWord{:href => "/nlab/show/contrapositions"} contrapositions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
