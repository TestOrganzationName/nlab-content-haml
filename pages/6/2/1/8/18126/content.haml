                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    X \setminus Int(S)
                    \&amp; =
                    X \setminus \left(  \underset{ {U \subset S} \atop {U \subset X \, open} }{\cup}U \right)
                    \\\
                    \&amp; = \underset{ {U \subset S} \atop {U \subset X \, \text{open}}  }{\cap} \left( X \setminus U \right)
                    \\\
                    \&amp; = \underset{ {C \supset X \setminus S} \atop {C\, closed}  }{\cap} \left( C \right)
                    \\\
                    \&amp; = Cl(X \setminus S)
                    \\end{aligned}
            %p Similarly for the other case.
          .num_example
            %h6#example_22 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
                and
                %a.existingWikiWord{:href => "/nlab/show/interior"} interior
                of
                %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed
                and
                = succeed ")" do
