                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mrow
                          %mo (
                          %munder
                            %mo ∪
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi U
                            %mi i
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo ∪
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %msub
                          %mi τ
                          %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\phi\left(\underset{i \in I}{\cup} U_i\right) \;=\; \underset{i \in I}{\cup} \phi(U_i)\;\;\;\;\in \tau_X
                        \\,,
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  and every
                  = succeed "-indexed" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
