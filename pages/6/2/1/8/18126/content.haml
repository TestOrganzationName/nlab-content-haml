                        \\,.
          #UrysohnLemma.num_prop
            %h6#proposition_22 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Urysohn%27s+lemma"}> Urysohn's lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/normal+Hausdorff+topological+space"} normal Hausdorff topological space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#NormalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              be two
              %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/Urysohn+function"} Urysohn function
              separating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#UrysohnFunction"}
          .num_remark
            %h6#remark_8 Remark
            %p
              Beware, the Urysohn function in prop.
              %a.maruku-ref{:href => "#UrysohnLemma"}
              may take the values 0 or 1 even outside of the two subsets. The condition that the function takes value 0 or 1, respectively,
              %em precisely
              on the two subsets corresponds to “
              %a.existingWikiWord{:href => "/nlab/show/perfectly+normal+spaces"}> perfectly normal spaces
              ”.
          .proof
            %h6#proof_22 Proof
            %p
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urysohn%27s+lemma"} Urysohn's lemma
              %a.maruku-ref{:href => "#UrysohnLemma"}
            %p Set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                    %mo ≔
                    %mi A
                    %mphantom
                      %mi AAA
                    %msub
                      %mi U
                      %mn 1
                    %mo ≔
                    %mi X
                    %mo ∖
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_0 \coloneqq A
                    \\phantom{AAA}
                    U_1 \coloneqq X \setminus B
                    \\,.
            %p Since by assumption
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi B
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \cap B = \emptyset
                    \\,.
            %p we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                    %mo ⊂
                    %msub
                      %mi U
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_0 \subset U_1
                    \\,.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is normal implies, by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#T4InTermsOfTopologicalClosures"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊃
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \supset C
              of a closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              contains a smaller neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              together with its
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi V
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U \subset V \subset Cl(V) \subset C
                    \\,.
            %p
              Apply this fact successively to the above situation to obtain the following infinite sequence of nested open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi r
                  %annotation{:encoding => "application/x-tex"} U_r
              and closed subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi r
                  %annotation{:encoding => "application/x-tex"} C_r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ⊂
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                          %mtd
                          %mtd
                            %mo ⊂
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                          %mtd
                          %mtd
                          %mtd
                            %mo ⊂
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mn 0
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 4
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 4
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mn 3
                                %mo{:stretchy => "false"} /
                                %mn 4
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mn 3
                                %mo{:stretchy => "false"} /
                                %mn 4
                          %mtd
                            %mo ⊂
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_0 &amp;&amp;  &amp;&amp;  &amp;&amp;  &amp;\subset&amp;  &amp;&amp;  &amp;&amp;  &amp;&amp; U_1
                    \\\
                    C_0 &amp;&amp;  &amp;\subset&amp;  &amp;&amp; U_{1/2} &amp;\subset&amp; C_{1/2} &amp;&amp;  &amp;\subset&amp;  &amp;&amp; U_1
                    \\\
                    C_0 &amp;\subset&amp; U_{1/4} &amp;\subset&amp; C_{1/4} &amp;\subset&amp; U_{1/2} &amp;\subset&amp; C_{1/2} &amp;\subset&amp; U_{3/4} &amp;\subset&amp; C_{3/4} &amp;\subset&amp; U_1
                    }
            %p
              and so on, labeled by the
              %a.existingWikiWord{:href => "/nlab/show/dyadic+rational+numbers"} dyadic rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℚ
                      %mi dy
                    %mo ⊂
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{dy} \subset \mathbb{Q}
              within
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (0,1]
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/UrysohnConstruction.png", :width => "400"}/
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi r
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ∈
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ∩
                        %msub
                          %mi ℚ
                          %mi dy
                  %annotation{:encoding => "application/x-tex"}
                    \\{ U_{r} \subset X \}_{r \in (0,1] \cap \mathbb{Q}_{dy}}
            %p with the property
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %msub
                          %mi r
                          %mn 1
                        %mo &lt;
                        %msub
                          %mi r
                          %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ∩
                        %msub
                          %mi ℚ
                          %mi dy
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi r
                            %mn 1
                      %mo ⊂
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi r
                            %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi r
                            %mn 2
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{r_1 \lt r_2 \, \in (0,1] \cap \mathbb{Q}_{dy}}{\forall}
                    \\left(
                    U_{r_1} \subset Cl(U_{r_1}) \subset U_{r_2}
                    \\right)
                    \\,.
            %p Define then the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow [0,1]
            %p
              to assign to a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              the
              %a.existingWikiWord{:href => "/nlab/show/infimum"} infimum
              of the labels of those open subsets in this sequence that contain
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mi U
                          %mi r
                        %mo ⊃
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                    %mi r
                  %annotation{:encoding => "application/x-tex"}
                    f(x)
                    \\coloneqq
                    \\underset{U_r \supset \{x\}}{\lim} r
            %p
              Here the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+net"} limit
              is over the
              %a.existingWikiWord{:href => "/nlab/show/directed+set"} directed set
              of those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi r
                  %annotation{:encoding => "application/x-tex"} U_r
              that contain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              This function clearly has the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} f(A) = \{0\}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} f(B) = \{1\}
            %p To this end, first observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo ⋆
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mrow
                              %mo (
                              %mi x
                              %mo ∈
                              %mi Cl
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi U
                                %mi r
                              %mo{:stretchy => "false"} )
                              %mo )
                          %mtd
                            %mo ⇒
                          %mtd
                            %mrow
                              %mo (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo ≤
                              %mi r
                              %mo )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo ⋆
                            %mo ⋆
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mrow
                              %mo (
                              %mi x
                              %mo ∈
                              %msub
                                %mi U
                                %mi r
                              %mo )
                          %mtd
                            %mo ⇐
                          %mtd
                            %mrow
                              %mo (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo &lt;
                              %mi r
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\star)
                    \&amp;&amp;
                    \\left(
                    x \in Cl(U_r)
                    \\right)
                    \&amp;\Rightarrow&amp;
                    \\left(
                    f(x) \leq r
                    \\right)
                    \\\
                    (\star\star)
                    \&amp;&amp;
                    \\left(
                    x \in U_r
                    \\right)
                    \&amp;\Leftarrow&amp;
                    \\left(
                    f(x) \lt r
                    \\right)
                    }
                    \\,.
            %p
              Here it is immediate from the definition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %msub
                      %mi U
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \in U_r) \Rightarrow (f(x) \leq r)
              and that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∈
                      %msub
                        %mi U
                        %mi r
                      %mo ⊂
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi r
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f(x) \lt r) \Rightarrow (x \in U_r \subset Cl(U_r))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mo ∂
                    %msub
                      %mi U
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (x \in \partial U_r) \Rightarrow (f(x) = r)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi U
                      %mi r
                    %mo ≔
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %msub
                      %mi U
                      %mi r
                  %annotation{:encoding => "application/x-tex"} \partial U_r \coloneqq Cl(U_r) \setminus U_r
              is the
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi r
                    %annotation{:encoding => "application/x-tex"} U_r
            %p
              This holds because the
              %a.existingWikiWord{:href => "/nlab/show/dyadic+numbers"} dyadic numbers
              are
              %a.existingWikiWord{:href => "/nlab/show/dense+subset"} dense
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed "-s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi a
                          %mo{:stretchy => "false"} /
                          %msup
                            %mn 2
                            %mi n
                    %annotation{:encoding => "application/x-tex"} U_{a/2^n}
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mo ∂
                    %msub
                      %mi U
                      %mi r
                  %annotation{:encoding => "application/x-tex"} x \in \partial U_r
              then for every small positive real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              there exists a dyadic rational number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} r'
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
