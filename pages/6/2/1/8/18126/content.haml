                                      %mo ,
                                      %mi Y
                                      %mo{:stretchy => "false"} )
                                      %mo )
                            %mtr
                              %mtd
                                %mrow
                                  %mo (
                                  %mi f
                                  %mo{:lspace => "verythinmathspace"} :
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %mi z
                                  %mo{:stretchy => "false"} )
                                  %mo ↦
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %mi z
                                  %mo{:stretchy => "false"} )
                                  %mo )
                              %mtd
                                %mover
                                  %mo ↦
                                  %mphantom
                                    %mi AAA
                              %mtd
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                                %mo{:lspace => "verythinmathspace"} :
                                %mi z
                                %mo ↦
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ↦
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\underset
                        {Hom_{Set}(X \times Z, Y) }
                        {\underbrace{
                        \\left\{
                        X \times Z \longrightarrow Y
                        \\right\}
                        }}
                        \&amp;\underoverset{}{\phantom{AA}\simeq\phantom{AA}}{\longrightarrow}&amp;
                        \\underset
                        {Hom_{Set}\left( Z, Hom_{Set}(X,Y) \right)}
                        {\underbrace{
                        \\left\{
                        Z \longrightarrow Hom_{Set}(X,Y)
                        \\right\}
                        }}
                        \\\
                        \\left(f \colon (x,z) \mapsto f(x,z) \right)
                        \&amp;\overset{\phantom{AAA}}{\mapsto}&amp;
                        \\tilde f
                        \\colon
                        z \mapsto (x \mapsto f(x,z))
                        }
                %p
                  restricts to a
                  %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                  between sets of
