                          %mi A
                    %msub
                      %mi X
                      %mn 3
                    %mover
                      %mo ⟶
                      %mrow
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_0
                    \\overset{\phantom{A}f_{0,1} \phantom{A} }{\longrightarrow}
                    X_1
                    \\overset{\phantom{A} f_{1,2} \phantom{A} }{\longrightarrow}
                    X_2
