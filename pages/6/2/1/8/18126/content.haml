                                        %mo ≤
                                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,1] &amp;\overset{  (\gamma_2 \cdot \gamma_1) }{\longrightarrow}&amp; X
                    \\\
                    t
                    \&amp;\mapsto&amp;
                    \\mathrlap{
                    \\left\{
                    \\array{
                    \\gamma_1(2t) &amp; \vert&amp; 0 \leq t \leq 1/2
                    \\\
