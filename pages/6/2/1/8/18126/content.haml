                  %annotation{:encoding => "application/x-tex"} (-\pi,\pi) \hookrightarrow \athbb{R}^2
              none of the intervals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
