              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} (a,b) \subset \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubset"}
              = succeed "):" do
                %a.maruku-ref{:href => "#RelationClAndInt"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Cl
                            %mrow
                              %mo (
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo ,
                              %mi b
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mo )
