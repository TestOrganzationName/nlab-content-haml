                          %mrow
                            %mphantom
                              %mi AA
                            %mo ∃
                            %mo !
                            %mphantom
                              %mi AA
                        %mo *
                      %annotation{:encoding => "application/x-tex"}
                        X \overset{\phantom{AA} \exists ! \phantom{AA}}{\longrightarrow} \ast
            %p
              In the language of
