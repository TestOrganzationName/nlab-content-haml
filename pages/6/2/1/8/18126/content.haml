                    %mrow
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
