                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi x
                    %mo ′
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,x' \in X
              are distinct, and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is Hausdorff, there exist disjoint open neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi x
                          %mo ′
                      %mo ⊃
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} U_{x'} \supset \{x'\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(U_x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(U_{x'})
              are disjoint open neighbourhoods of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,\vec v)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo ,
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} vect
                      %mi v
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x',\vect v')
            %p
              Now to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
              is paracompact.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi T
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset T X\}_{i \in I}
              be an open cover. We need to find a
              %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi \colon T X \to X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              (by example
              %a.maruku-ref{:href => "#ProjectionsAreOpenContinuousFunctions"}
              and example
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubspacesGluing"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\pi(U_i) \subset X\}_{i \in I}
              is an open cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Let now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mi n
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %msub
                          %mi ϕ
                          %mi j
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^n \underoverset{\simeq}{\phi_j}{\to} V_j \subset X\}_{j \in J}
              be an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and consider the open common refinement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mi π
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %msub
                          %mi V
                          %mi j
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi J
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ \pi(U_i) \cap V_j \subset X  \right\}_{i \in I, j \in J}
                    \\,.
            %p
              Since this is still an open cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is paracompact, this has a locally finite refinement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mi V
                        %msub
                          %mo ′
                          %mrow
                            %mi j
                            %mo ′
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi j
                        %mo ′
                        %mo ∈
                        %mi J
                        %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ V'_{j'} \subset X\right\}_{j' \in J'}
            %p
              Notice that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                    %mo ∈
                    %mi J
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} j' \in J'
              the product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} V'_{j'} \times \mathbb{R}^n \subset \mathbb{R}^{2n}
              is paracompact (as a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              it is itself
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              and
              %a.existingWikiWord{:href => "/nlab/show/second+countable+topological+space"} second countable
              and since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+and+second-countable+spaces+are+paracompact"} locally compact and second-countable spaces are paracompact
              = succeed ")." do
                %a.maruku-ref{:href => "#SigmaCompactFromLocallyCompactAndSecondCountable"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi I
                        %mo ×
                        %mi J
                        %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\{ \pi^{-1}(V'_{j'}) \cap U_i \subset V'_{j'} \times \mathbb{R}^n \}_{(i,j') \in I \times J'}
            %p has a locally finite refinement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mrow
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                    %mo ⊂
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                        %mo ∈
                        %msub
                          %mi K
                          %mrow
                            %mi j
                            %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{W_{k_{j'}} \subset V'_{j'} \times \mathbb{R}^n \}_{k_{j'} \in K_{j'}}
                    \\,.
            %p We claim now that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mrow
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                    %mo ⊂
                    %mi T
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ′
                        %mo ∈
                        %mi J
                        %mo ′
                        %mo ,
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                        %mo ∈
                        %msub
                          %mi K
                          %mrow
                            %mi j
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\{ W_{k_{j'}}  \subset T X \}_{j' \in J',  k_{j'} \in K_{j'}}
            %p is a locally finite refinement of the original cover. That this is an open cover refining the original one is clear. We need to see that it is locally finite.
            %p
              So let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} (x,\vec v) \in T X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ′
                        %mo ∈
                        %mi J
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \{ V'_{j'}  \subset X\}_{j' \in J'}
              there is an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V_x \supset \{x\}
              which intersects only finitely many of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %msub
                        %mo ′
                        %mrow
                          %mi j
                          %mo ′
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} V'_{j'} \subset X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi k
                            %mrow
                              %mi j
                              %mo ′
                      %mo ⊂
                      %mi V
                      %msub
                        %mo ′
                        %mrow
                          %msub
                            %mi j
                            %mo ′
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ W_{k_{j'}}  \subset V'_{j_'}\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} j'
              the point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,\vec v)
              regarded in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V'_{j'} \times \mathbb{R}^n
              has an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi j
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} U_{j'}
              that intersects only finitely many of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi k
                            %mrow
                              %mi j
                              %mo ′
                    %annotation{:encoding => "application/x-tex"} W_{k_{j'}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mrow
                      %mo (
                      %munder
                        %mo ∩
                        %mrow
                          %mi j
                          %mo ′
                      %msub
                        %mi U
                        %mrow
                          %mi j
                          %mo ′
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(V_x) \cap \left( \underset{j'}{\cap}  U_{j'} \right)
              is a finite intersection of open subsets, hence still open, and by construction it intersects still only a finite number of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi k
                            %mrow
                              %mi j
                              %mo ′
                    %annotation{:encoding => "application/x-tex"} W_{k_{j'}}
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
              is paracompact.
            %p
              Finally the statement about the differentiability of the
              %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
              and of the projections is immediate from the definitions
          #FunctionsBetweenDifferentiableManifoldsDifferentials.num_prop
            %h6#proposition_83 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
                of
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                between
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to differentiable curves in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi Diff
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mn 1
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ∘
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi Hom
                              %mi Diff
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mn 1
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %msup
                                %mi ℝ
                                %mn 1
                              %mover
                                %mo →
                                %mi γ
                              %mi X
                              %mo )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %mrow
                              %mo (
                              %msup
                                %mi ℝ
                                %mn 1
                              %mover
                                %mo →
                                %mrow
                                  %mi f
                                  %mo ∘
                                  %mi γ
                              %mi Y
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{Diff}(\mathbb{R}^1, X)
                    \&amp;\overset{f \circ (-)}{\longrightarrow}&amp;
                    Hom_{Diff}(\mathbb{R}^1, Y)
                    \\\
                    \\left(
                    \\mathbb{R}^1 \overset{\gamma}{\to} X
                    \\right)
                    \&amp;\overset{\phantom{AAA}}{\mapsto}&amp;
                    \\left(
                    \\mathbb{R}^1 \overset{f \circ \gamma}{\to} Y
                    \\right)
                    }
            %p
              descends at each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              to the tangency
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#TangencyRelationOnSmoothCurves"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TangencyIsEquivalenceRelation"}
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TangentVector"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                  %annotation{:encoding => "application/x-tex"} d f_x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mi x
                    %mi X
                    %mo ⟶
                    %msub
                      %mi T
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d f|_{x}
                    \\;\colon\;
                    T_x X
                    \\longrightarrow
                    T_{f(x)} Y
                    \\,.
            %p Moreover:
            %ol
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear dependence
                  on the tangent vector) these differentials are
                  %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
                  with respect to the vector space structure on the
                  %a.existingWikiWord{:href => "/nlab/show/tangent+spaces"} tangent spaces
                  from lemma
                  = succeed "," do
                    %a.maruku-ref{:href => "#LinearTangentSpace"}
                  = succeed ";" do
                    %a.maruku-ref{:href => "#TangentSpace"}
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable dependence
                  on the base point) globally they yield a
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  of real
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundles"} differentiable vector bundles
                  between the
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
                  (def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#TangentBundle"}
                  = succeed ")," do
                    %a.maruku-ref{:href => "#DifferentiableTangentBundle"}
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi f
                      %annotation{:encoding => "application/x-tex"} d f
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi T
                        %mi X
                        %mo ⟶
                        %mi T
                        %mi Y
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        d f \;\colon\; T X \longrightarrow T Y
                        \\,.
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/chain+rule"}> chain rule
                  ) The assignment
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ↦
                        %mi d
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f \mapsto d f
                  respects
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  in that for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} Z
                  three
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
                  and for
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi A
                            %mi f
                            %mphantom
                              %mi A
                        %mi Y
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi A
                            %mi g
                            %mphantom
                              %mi A
                        %mi Z
                      %annotation{:encoding => "application/x-tex"}
                        X
                        \\overset{\phantom{A}f\phantom{A}}{\longrightarrow}
                        Y
                        \\overset{\phantom{A}g\phantom{A}}{\longrightarrow}
                        Z
                %p
                  two
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composable
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                  then their
                  %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
                  satisfy
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ∘
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        d(g \circ f) = (d g) \circ (d f)
                        \\,.
          .proof
            %h6#proof_123 Proof
            %p
              All statements are to be tested on charts of an atlas for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              = succeed "." do
                %a.maruku-ref{:href => "#EuclideanSpaceTangentBundle"}
          .num_remark
            %h6#remark_36 Remark
            %p
              %strong
                (tangent
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %p
              In the language of
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopCategory"}
              %a.maruku-ref{:href => "#FunctionsBetweenDifferentiableManifoldsDifferentials"}
              says that forming
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
              of
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d f
              of
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Diff
                    %mo ⟶
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Diff
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    T \;\colon\; Diff \longrightarrow Vect(Diff)
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              of
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
              to the category of differentiable real vector bundles.
          #VectorField.num_defn
            %h6#definition_86 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/vector+field"}> vector field
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              with differentiable tangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X \to X
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TangentBundle"}
            %p
              A differentiable
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} v \colon X \to T X
              of the tangent bundle is called a (differentiable)
              %em
                %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
