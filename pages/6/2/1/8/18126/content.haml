                        %msub
                          %mi X
                          %mi j
                        %mo{:stretchy => "false"} }
                        %mo )
                    %annotation{:encoding => "application/x-tex"} Cones\left( Y, \{X_i \overset{f_\alpha}{\to} X_j\} \right)
          %p Using this, we find the following:
          #CoLimitsInNiceTopologicalSpaces.num_remark
            %h6#remark_12 Remark
            %p
              %strong
                (limits and colimits in categories of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/nice+topological+spaces"} nice topological spaces
            %p
              Recall from remark
              %a.maruku-ref{:href => "#ReflectiveSubcategory"}
              the concept of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi A
                          %mi R
                          %mphantom
                            %mi A
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi A
                          %mi L
                          %mphantom
                            %mi A
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\underoverset
                    {\underset{\phantom{A}R\phantom{A}}{\longrightarrow}}
                    {\overset{\phantom{A}L\phantom{A}}{\longleftarrow}}
                    {\bot}
                    \\mathcal{D}
            %p
              witnessed by
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒟
                    %mrow
                      %mo (
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi d
                      %mo )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mrow
                      %mo (
                      %mi c
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{D}}\left( L(c),d \right)
                    \\simeq
                    Hom_{\mathcal{C}}\left( c,R(d) \right)
                    \\,.
            %p
              Then these
              %em
                %a.existingWikiWord{:href => "/nlab/show/adjoints+preserve+%28co-%29limits"} adjoints preserve (co-)limits
              in that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint+functor"} left adjoint functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserve
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LimitingCone"}
                %p
                  in that for every
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi i
                        %mover
                          %mo →
