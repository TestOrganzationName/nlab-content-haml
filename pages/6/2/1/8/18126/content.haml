            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              equipped with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricTopology"}
            %ul
              %li
                %p
                  it takes the value 0 on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  and the value 1 on
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                        %annotation{:encoding => "application/x-tex"} B
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mphantom
                          %mi AAA
                        %mtext and
                        %mphantom
                          %mi AAA
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        f(A) = \{0\}
                        \\phantom{AAA}
                        \\text{and}
                        \\phantom{AAA}
