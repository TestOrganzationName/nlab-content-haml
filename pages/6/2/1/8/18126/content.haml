                %annotation{:encoding => "application/x-tex"} \,
          %p Now we may finally state and prove the simplest form of the embedding theorem for smooth manifolds:
          #CompactManifoldEmbedsIntoLargeDimensionalEuclideanSpace.num_prop
            %h6#proposition_86 Proposition
            %p
              %strong (weak embedding theorem)
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              (def
              = succeed ")," do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has an
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding of smooth manifolds
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothManifoldsEmbedding"}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              of dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ":" do
                %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ↪
                      %mtext embd
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    X \overset{\text{embd}}{\hookrightarrow} \mathbb{R}^k
          .proof
            %h6#proof_128 Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mi n
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\{\mathbb{R}^n \underoverset{\simeq}{\phi_i}{\longrightarrow} U_i \subset X\}_{i \in I}
            %p
              be an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              exhibiting the
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SmoothStructure"}
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              by patches
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mi n
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\{\mathbb{R}^n \underoverset{\simeq}{\phi_i}{\to} U_i \subset X\}_{i \in J \subset I}
            %p is still an open cover.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{f_i \in C^\infty(X,\mathbb{R})\}_{i \in J }
              subordinate to this cover (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PartitionOfUnity"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              (by prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#SmoothManifoldAdmitsSmoothPartitionsOfUnity"}
            %p
              This we may use to
              %a.existingWikiWord{:href => "/nlab/show/extension"} extend
              the inverse
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msub
                          %mi ψ
                          %mi i
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    X \supset \;\; U_i \underoverset{\simeq}{\psi_i}{\longrightarrow} \mathbb{R}^n
            %p
              to smooth functions on all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ψ
                        %mo{:stretchy => "false"} ^
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \psi_i \;\colon\; X \to \mathbb{R}^{n}
            %p by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ψ
                        %mo{:stretchy => "false"} ^
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi f
                                %mi i
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %msub
                                %mi ψ
                                %mi i
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi x
                              %mo ∈
                              %msub
                                %mi U
                                %mi i
                              %mo ⊂
                              %mi X
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \psi_i
                    \\;\colon\;
                    x
                    \\mapsto
                    \\left\{
                    \\array{
                    f_i(x) \cdot \psi_i(x) &amp;\vert&amp; x \in U_i \subset X
                    \\\
                    0 &amp;\vert&amp; \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p
              The idea now is to use the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              to combine all these functions to obtain an injective function of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi ψ
                        %mo{:stretchy => "false"} ^
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi J
                        %mo{:stretchy => "false"} |
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo ⋅
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi J
                          %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\hat \psi_i)_{i \in J}
                    \\;\colon\;
                    X \longrightarrow (\mathbb{R}^n)^{\vert J\vert }
                    \\simeq
                    \\mathbb{R}^{n \cdot {\vert J \vert }}
                    \\,.
            %p
              This function is an immersion: On the interior of the support of the bump functions the product functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo ⋅
                    %msub
                      %mi ψ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i\cdot \psi_i
              have smooth inverses
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %msubsup
                            %mi ψ
                            %mi i
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                        %mrow
                          %msub
                            %mi f
                            %mi i
                  %annotation{:encoding => "application/x-tex"} \tfrac{\psi_i^{-1}}{f_i}
              and therefore their differentials have vanishing kernel.
            %p
              Hence it remains to see that the function is also an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding of topological spaces
            %p
              Observe that it is an injective function: If two points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y \in X
              have the same image, this means that they have the same image under all the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi i
                      %mo ⋅
                      %msub
                        %mi ψ
                        %mi i
                    %annotation{:encoding => "application/x-tex"} f_i \cdot \psi_i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              must be the same.
            %p
              Hence we have an injective immersion. With this prop.
              %a.maruku-ref{:href => "#OpenClosedContinuousInjectionsAreEmbeddings"}
              says that it is now sufficient to show that we also have a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              by assumption, and since
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#HausdorffMetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/maps+from+compact+spaces+to+Hausdorff+spaces+are+closed+and+proper"} maps from compact spaces to Hausdorff spaces are closed and proper
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#MapsFromCompactSpacesToHausdorffSpacesAreClosed"}
          #EmbeddingWhitney.num_remark
            %h6#remark_38 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Whitney+embedding+theorem"}> Whitney embedding theorem
                )
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/Whitney+embedding+theorem"} Whitney embedding theorem
              (which we do not prove here) strengthens the statement of prop.
              %a.maruku-ref{:href => "#CompactManifoldEmbedsIntoLargeDimensionalEuclideanSpace"}
              in two ways:
            %ol
              %li
                %p it applies to non-compact smooth manifolds with a countable set of connected components;
              %li
                %p
                  it gives the upper bound of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 2n
                  on the dimension of the ambient Euclidean space (for embedding of
                  = succeed "-dimensional" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "-manifolds" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
