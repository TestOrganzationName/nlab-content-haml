                    %annotation{:encoding => "application/x-tex"} E
          #VectorBundleSections.num_example
            %h6#example_116 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{\pi}{\to} X
              be a topological vector bundle (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of vector bundles from the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#TrivialTopologicalVectorBundle"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TerminologyVectorBundles"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mi k
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \times k \longrightarrow E
            %p
              is, by fiberwise linearity, equivalently a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma \;\colon\;  X \longrightarrow E
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ∘
                    %mi σ
                    %mo =
                    %msub
                      %mi id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \pi \circ \sigma = id_X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi σ
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi π
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi id
                                  %mi X
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; E
                    \\\
                    \&amp; {}^{\mathllap{\sigma}}\nearrow &amp; \downarrow^{\mathrlap{\pi}}
                    \\\
                    X &amp; \underset{id_X}{\longrightarrow} &amp; X
                    }
                    \\,.
            %p
              Such functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \sigma \colon X \to E
              are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              (or
              = succeed ")" do
                %em cross-sections
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              Namely
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              by is necessarily of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
