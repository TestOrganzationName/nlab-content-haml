                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              such that both bundles have a
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
              over this cover.
          .proof
            %h6#proof_108 Proof
            %p
              By definition we may find two possibly different open covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                      %mn 1
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                        %mo ∈
                        %msub
                          %mi I
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \{U^1_{i_1} \subset X\}_{{i_1} \in I_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                      %mn 2
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                        %mo ∈
                        %msub
                          %mi I
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \{U^2_{i_2} \subset X\}_{i_2 \in I_2}
              with local tivializations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                      %mn 1
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                          %mn 1
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msubsup
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo ∈
                        %msub
                          %mi I
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \{ U^1_{i_1} \underoverset{\simeq}{\phi^1_{i_1}}{\to} E_1\vert_{U^1_{i_1}} \}_{i_1 \in I_1}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msubsup
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 2
                        %mn 2
                      %munderover
                        %mo →
                        %mo ≃
                        %mrow
                          %msubsup
