                        %mi ℝ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^0
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#EuclideanNorm"}
          #SierpinskiSpace.num_example
            %h6#example_10 Example
            %p
              On the 2-element set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1\}
              there are (up to
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of elements) three distinct topologies:
            %ol
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/codiscrete+topology"} codiscrete topology
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CoDiscreteTopology"}
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi τ
                          %mo =
                          %mrow
                            %mo {
                            %mi ∅
                            %mo ,
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo }
                        %annotation{:encoding => "application/x-tex"} \tau = \left\{   \emptyset, \{0,1\}  \right\}
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#CoDiscreteTopology"}
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi τ
                          %mo =
                          %mrow
                            %mo {
                            %mi ∅
                            %mo ,
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                            %mo ,
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo ,
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo }
                        %annotation{:encoding => "application/x-tex"} \tau = \left\{   \emptyset, \{0\}, \{1\}, \{0,1\}  \right\}
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
                  topology
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi τ
                          %mo =
                          %mrow
                            %mo {
                            %mi ∅
                            %mo ,
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo ,
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo }
                        %annotation{:encoding => "application/x-tex"} \tau = \left\{\emptyset, \{1\}, \{0,1\}  \right\}
          .num_example
            %h6#example_11 Example
            %p
              The following shows all the topologies on the 3-element set (up to
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of elements)
            %p
              %img{:src => "https://ncatlab.org/nlab/files/TopologiesOn3ElementSet.png", :width => "400"}/
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Munkres75"} Munkres 75
          #CoDiscreteTopology.num_example
            %h6#example_12 Example
            %p
              %strong (discrete and co-discrete topology)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with a topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau \subset P(X)
              in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                        %mo ≔
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tau \coloneqq P(S)
                  the set of
                  %em all
                  open subsets;
                %p
                  this is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/finer+topology"} finest topology
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TopologyFinerCoarser"}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                %p
                  we write
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Disc
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Disc(S)
                  for the resulting topological space;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mi ∅
                        %mo ,
                        %mi S
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \tau \coloneqq \{ \emptyset, S \}
                  the set containing only the
                  %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                  subset of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  and all of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  itself;
                %p
                  this is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/codiscrete+topology"} codiscrete topology
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/coarser+topology"} coarsest topology
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TopologyFinerCoarser"}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                %p
                  we write
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CoDisc
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CoDisc(S)
                  for the resulting topological space.
            %p
              The reason for this terminology is best seen when considering
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              into or out of these (co-)discrete topological spaces, we come to this in example
              %a.maruku-ref{:href => "#ContinuousFunctionsIntoCoDiscreteTopologicalSpaces"}
              below.
          #TopologyCofinite.num_example
            %h6#example_13 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cofinite+topology"}> cofinite topology
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em
                %a.existingWikiWord{:href => "/nlab/show/cofinite+topology"} cofinite topology
              or
              %em finite complement topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              are precisely
            %ol
              %li
                %p
                  all
                  %a.existingWikiWord{:href => "/nlab/show/cofinite+subsets"} cofinite subsets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subset X
                  (i.e. those such that the
                  %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∖
                        %mi S
                      %annotation{:encoding => "application/x-tex"} X \setminus S
                  is a
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %li
                %p
                  the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is itself a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              (but not otherwise) then the cofinite topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#BasicConstructions We now consider basic construction principles of new topological spaces from given ones:
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union+spaces"} disjoint union spaces
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
                (example
                = succeed ")," do
                  %a.maruku-ref{:href => "#SubspaceTopology"}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/product+spaces"} product spaces
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
          %p
            Below in
            %em
              %a{:href => "#UniversalConstructions"} Universal constructions
            we will recognize these as simple special cases of a general construction principle.
          #DisjointUnionOfTopologicalSpaces.num_example
            %h6#example_14 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"}> disjoint union space
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{(X_i, \tau_i)\}_{i \in I}
              a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of topological spaces, then their
              %em
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\sqcup} (X_i, \tau_i)
            %p
              is the topological space whose underlying set is the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of the underlying sets of the summand spaces, and whose open subsets are precisely the disjoint unions of the open subsets of the summand spaces.
            %p
              In particular, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              any index set, then the disjoint union of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              copies of the
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#Point"}
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CoDiscreteTopology"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\sqcup} \ast
                    \\;=\;
                    Disc(I)
                    \\,.
          #SubspaceTopology.num_example
            %h6#example_15 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"}> subspace topology
                )
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/OpenSubsetsOfSquareInsidePlane.png", :width => "200"}/
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau_X)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of the underlying set. Then the corresponding
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              as its underlying set, and its open subsets are those subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              which arise as restrictions of open subsets of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mi S
                      %mo ⊂
                      %mi S
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext open
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ⇔
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mrow
                          %msub
                            %mi U
                            %mi X
                          %mo ∈
                          %msub
                            %mi τ
                            %mi X
                      %mrow
                        %mo (
                        %msub
                          %mi U
                          %mi S
                        %mo =
                        %msub
                          %mi U
                          %mi X
                        %mo ∩
                        %mi S
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    U_S \subset S\,\,\text{open}
                    \\right)
                    \\,\Leftrightarrow\,
                    \\left(
                    \\underset{U_X \in \tau_X}{\exists} \left( U_S = U_X \cap S \right)
                    \\right)
                    \\,.
            %p
              (This is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/initial+topology"} initial topology
              of the inclusion map. We come back to this below in def.
              = succeed ".)" do
                %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
            %p
              The picture on the right shows two open subsets inside the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/square"} square
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of the
              %a.existingWikiWord{:href => "/nlab/show/plane"} plane
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Munkres75"} Munkres 75
          #QuotientTopologicalSpace.num_example
            %h6#example_16 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"}> quotient topological space
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mo ∼
                    %mo ⊂
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    R_\sim \subset X \times X
            %p
              be an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on its underlying set. Then the
              %em
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              has
            %ul
              %li
                as underlying set the
                %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %annotation{:encoding => "application/x-tex"} X/\sim
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            %p and
            %ul
              %li
                %p
                  a subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo ⊂
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %annotation{:encoding => "application/x-tex"} O \subset X/\sim
                  is declared to be an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  precisely if its
                  %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi O
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi^{-1}(O)
                  under the canonical
                  %a.existingWikiWord{:href => "/nlab/show/projection+map"} projection map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %annotation{:encoding => "application/x-tex"}
                        \\pi \;\colon\; X \to X/\sim
                %p
                  is open in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
            %p
              (This is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              of the projection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
              = succeed "." do
                %a.maruku-ref{:href => "#InitialAndFinalTopologies"}
            %p
              Often one considers this with input datum not the equivalence relation, but any
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\pi \;\colon\; X \longrightarrow Y
            %p
              of sets. Of course this identifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} Y = X/\sim
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ∼
                      %msub
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ⇔
                      %mo{:stretchy => "false"} (
                      %mi π
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi π
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_1 \sim x_2) \Leftrightarrow (\pi(x_1) = \pi(x_2))
              %em quotient topology
              on the codomain set of a function out of any topological space has as open subsets those whose pre-images are open.
            %p
              To see that this indeed does define a topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} X/\sim
              it is sufficient to observe that taking pre-images commutes with taking unions and with taking intersections.
          #BinaryProductTopologicalSpace.num_example
            %h6#example_17 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"}> binary product topological space
                )
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/ProductTopology.png", :width => "300"}/
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_1,\tau_{X_1})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_2, \tau_{X_2})
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %em
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} binary product topological space
              has as underlying set the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_1 \times X_2
              of the corresponding two underlying sets, and its topology is generated from the
              %a.existingWikiWord{:href => "/nlab/show/basis+for+a+topology"} basis
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologyBase"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ×
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_1 \times U_2
              of the opens
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∈
                      %msub
                        %mi τ
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i \in \tau_i
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Munkres75"} Munkres 75
            %p
              Beware for non-
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              products, the descriptions of the product topology is not as simple. This we turn to below in example
              = succeed "," do
                %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+topological+spaces"} category of topological spaces
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p The following examples illustrate how all these ingredients and construction principles may be combined.
          %p
            The following example examines in more detail below in example
            = succeed "," do
              %a.maruku-ref{:href => "#HomeomorphismBetweenTopologicalAndCombinatorialCircle"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
            = succeed "." do
              %a{:href => "#Homeomorphisms"} below
          .num_example
            %h6#example_18 Example
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              as the 1-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via the corresponding
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} [0,1] \subset \mathbb{R}
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [0,1] \times [0,1]
            %p
              is a topological space modelling the closed square. The
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            %p
              %img{:src => "https://ncatlab.org/nlab/files/QuotientOfSquareIsCylinderAndTorus.png", :width => "660"}/
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Munkres75"} Munkres 75
          #SpheresAndDisks.num_example
            %h6#example_19 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/spheres"} spheres
                and disks)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mi n
                      %annotation{:encoding => "application/x-tex"} D^n
                  for the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/n-disk"} n-disk
                  %a.existingWikiWord{:href => "/nlab/show/closed+ball"} closed unit ball
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#OpenBalls"}
                  = succeed "-dimensional" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EuclideanNorm"}
                  %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SubspaceTopology"}
                  %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
                  (example
                  = succeed ");" do
                    %a.maruku-ref{:href => "#MetricTopology"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} S^{n-1}
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (n-1)-sphere
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#OpenBalls"}
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi n
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ↪
                        %msup
                          %mi D
                          %mi n
                      %annotation{:encoding => "application/x-tex"} i_n \;\colon\; S^{n-1} \hookrightarrow D^n
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  that exhibits this
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  inclusion.
            %p Notice that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} S^{-1} = \emptyset
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/empty+topological+space"} empty topological space
                  (example
                  = succeed ");" do
                    %a.maruku-ref{:href => "#Point"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 0
                        %mo =
                        %mo *
                        %mo ⊔
                        %mo *
                      %annotation{:encoding => "application/x-tex"} S^0 = \ast \sqcup \ast
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpaces"}
                  %a.existingWikiWord{:href => "/nlab/show/point+topological+space"} point topological space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Point"}
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
                  on two elements (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#SierpinskiSpace"}
          %p
            The following important class of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            form the foundation of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
          #ZariskiTopologyOnAffineSpace.num_example
            %h6#example_20 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[X_1, \cdots, X_n]
              for the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/variables"} variables
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset k[X_1, \cdots, X_n]
              a subset of polynomials, let the subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F}) \subset k^n
              of the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of the underlying set of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              (the
              %em vanishing set
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi k
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %munder
                        %mo ∀
                        %mrow
                          %mi f
                          %mo ∈
                          %mi ℱ
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V(\mathcal{F})
                    \\coloneqq
                    \\left\{
                    (a_1, \cdots, a_n) \in k^n
                    \\,\vert\,
                    \\underset{f \in \mathcal{F}}{\forall} f(a_1, \cdots, a_n) = 0
                    \\right\}
                    \\,.
            %p
              These subsets are called the
              = succeed "." do
                %em
                  Zariski
                  %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msubsup
                          %mi 𝔸
                          %mi k
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %msup
                        %mi k
                        %mi n
                      %mo ∖
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msup
                        %mi k
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi ℱ
                      %mo ⊂
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi X
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} ]
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{\mathbb{A}^n_k}
                    \\;\coloneqq\;
                    \\left\{
                    k^n \setminus V(\mathcal{F}) \subset k^n
                    \\,\vert\,
                    \\mathcal{F} \subset k[X_1, \cdots, X_n]
                    \\right\}
            %p
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              of the Zariski closed subsets. These are called the
              %em
                Zariski
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k^n
            %p
              The Zariski open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
              form a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔸
                      %mi k
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi k
                        %mi n
                      %mo ,
                      %msub
                        %mi τ
                        %mrow
                          %msubsup
                            %mi 𝔸
                            %mi k
                            %mi n
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{A}^n_k
                    \\;\coloneqq\;
                    \\left(
                    k^n, \tau_{\mathbb{A}^n_k}
                    \\right)
            %p
              is also called the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %em
                %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p More generally:
          #ZariskiTopologyOnPrimeSpectrum.num_example
            %h6#example_21 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
                on the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum of a commutative ring
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PrimeIdl(R)
              for its set of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset R
              any subset of elements of the ring, consider the subsets of those prime ideals that contain
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi p
                      %mo ∈
                      %mi PrimeIdl
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi ℱ
                      %mo ⊂
                      %mi p
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V(\mathcal{F})
                    \\;\coloneqq\;
                    \\left\{
                    p \in PrimeIdl(R) \,\vert\, \mathcal{F} \subset p
                    \\right\}
                    \\,.
            %p
              These are called the
              %em
                Zariski
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PrimeIdl
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PrimeIdl(R)
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              are called the
              = succeed "." do
                %em Zariski open subsets
            %p
              Then the collection of Zariski open subsets in its set of
              %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{Spec(R)} \subset P(PrimeIdl(R))
            %p
              satisfies the axioms of a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski topology
            %p
              This
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Spec(R) \coloneqq (PrimeIdl(R), \tau_{Spec(R)})
            %p
              is called (the space underlying) the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum of the commutative ring
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#ClosedSubsets Closed subsets
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/complements"} complements
            of
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            in a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            are called
            %em
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
            (def.
            %a.maruku-ref{:href => "#ClosedSubset"}
            below). This simple definition indeed captures the concept of closure in the
            %a.existingWikiWord{:href => "/nlab/show/analysis"} analytic
            sense of
            %a.existingWikiWord{:href => "/nlab/show/convergence"} convergence
            of
            %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
            (prop.
            %a.maruku-ref{:href => "#ConvergenceInClosedSubspace"}
            below). Of particular interest for the theory of topological spaces in the discussion of
            %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            %a{:href => "#SeparationAxioms"} below
            are those closed subsets which are “
            %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subset"}> irreducible
            ” (def.
            %a.maruku-ref{:href => "#ClosedIrreducible"}
            below). These happen to be equivalently the “
            %a.existingWikiWord{:href => "/nlab/show/frame"} frame
            homomorphisms” (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#HomomorphismOfFramesOfOpens"}
            %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"} frame of opens
            of the point (prop.
            %a.maruku-ref{:href => "#FrameHomomorphismsToPointAreIrrClSub"}
            below).
          #ClosedSubset.num_defn
            %h6#definition_16 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"}> closed subsets
                )
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/ClosedAndOpenSubsets.png", :width => "300"}/
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalSpace"}
            %ol
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subset X
                  is called a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                  if its
                  %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∖
                        %mi S
                      %annotation{:encoding => "application/x-tex"} X \setminus S
                  is an
                  = succeed ":" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mi S
                          %mo ⊂
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mtext is closed
                          %mo )
                        %mphantom
                          %mi AA
                        %mo ⇔
                        %mphantom
                          %mi AA
                        %mrow
                          %mo (
                          %mi X
                          %mo ∖
                          %mi S
                          %mspace{:width => "thinmathspace"}
                          %mo ⊂
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mtext is open
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        S \subset X\,\, \text{is closed}
                        \\right)
                        \\phantom{AA}
                        \\Leftrightarrow
                        \\phantom{AA}
                        \\left(
                        X\setminus S \, \subset X \,\, \text{is open}
                        \\right)
                        \\,.
                %blockquote
                  %p
                    graphics grabbed from
                    %a{:href => "#Vickers89"} Vickers 89
              %li
                %p
                  If a
                  %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                  subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \{x\} \subset X
                  is closed, one says that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  is a
                  %em closed point
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  Given any subset
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mo ⊂
                          %mi X
                        %annotation{:encoding => "application/x-tex"} S \subset X
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(S)
                  is the smallest closed subset containing
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo ∩
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %mi C
                                %mo ⊂
                                %mi X
                                %mspace{:width => "thinmathspace"}
                                %mtext closed
                            %mrow
                              %mrow
                                %mi S
                                %mo ⊂
                                %mi C
                        %mrow
                          %mo (
                          %mi C
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Cl(S)
                        \\;\coloneqq\;
                        \\underset{ {C \subset X\, \text{closed}  }   \atop {S \subset C }  }{\cap} \left( C \right)
                        \\,.
              %li
                %p
                  A subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subset X
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Cl(S) = X
                  is called a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/dense+subset"} dense subset
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X,\tau)
          %p
            Often it is useful to reformulate def.
            %a.maruku-ref{:href => "#ClosedSubset"}
            of
            %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
            as follows:
          #UnionOfOpensGivesClosure.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (alternative characterization of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of its underlying set. Then a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              is contained in the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(S)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubset"}
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Neighbourhood"}
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersects
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi x
                      %mo ∈
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mphantom
                      %mi AA
                    %mo ⇔
                    %mphantom
                      %mi AA
                    %mo ¬
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mfrac{:linethickness => "0"}
                          %mrow
