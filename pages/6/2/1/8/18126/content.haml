                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y,z \in X
              three points and for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                    %mo ,
                    %msub
                      %mi γ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma_1, \gamma_2
                    \\;\colon\;
                    [0,1] \longrightarrow X
            %p
              two paths with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
