          .proof
            %h6#proof_80 Proof
            %p To see the continuity of the evaluation map:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} V \subset Y
              be an open subset. It is sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ev
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} ev^{-1}(V) = \{(x, f) \vert f(x) \in V\}
              is a union of products of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %msup
                      %mi V
                      %mi K
                  %annotation{:encoding => "application/x-tex"} U \times V^K
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U\subset X
              open and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mi K
                    %mo ⊂
                    %msub
                      %mi Hom
                      %mi Set
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V^K \subset Hom_{Set}(K,W)
              a basic open according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#CompactOpenTopology"}
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi ev
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x, f) \in ev^{-1}(V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^{-1}(V) \subset X
              is an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p#LocalCompactnessInProofOfExponentiability
              By local compactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K \subset f^{-1}(V)
              which is still a neighbourhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi K
                    %annotation{:encoding => "application/x-tex"} U \subset K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              also still takes that into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mrow
                      %mi U
                      %mo ×
                      %msup
                        %mi V
                        %mi K
                    %munder
                      %mo ⊂
                      %mtext open
                    %msup
                      %mi ev
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (x,f) \in {U \times V^K} \underset{\text{open}}{\subset} ev^{-1}(V)
            %p
              with respect to the product topology. Since this is still contained in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ev
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ev^{-1}(V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,f)
              as above,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ev
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev^{-1}(V)
              is exhibited as a union of opens, and is hence itself open.
            %p Regarding the second point:
            %p
              In one direction, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi τ
                      %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X, \tau_X) \times (Y, \tau_Y) \to (Z \, \tau_Z)
              be a continuous function, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi U
                      %mi K
                    %mo ⊂
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U^K \subset Maps(X,Y)
              be a sub-basic open. We need to show that the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mi z
                      %mo ∈
                      %mi Z
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi U
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi Z
                  %annotation{:encoding => "application/x-tex"}
