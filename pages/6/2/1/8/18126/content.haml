            %a.existingWikiWord{:href => "/nlab/show/final+topologies"} final topologies
            and the
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
            into
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff
            and
            = succeed "." do
