                        %mo }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    f_j
                    \\right\}_{j \in J}
            %p is a subordinate partition of unity by smooth functions as required.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
