              the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi z
                    %mo{:stretchy => "false"} }
