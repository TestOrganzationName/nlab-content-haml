                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          #CategoryDiff.num_remark
            %h6#remark_32 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
            %p
              In analogy to remark
              %a.maruku-ref{:href => "#TopCategory"}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              called
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi p
                  %annotation{:encoding => "application/x-tex"} {}_p
              (or similar) whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi p
                    %annotation{:encoding => "application/x-tex"} C^p
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
              and whose
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi p
                    %annotation{:encoding => "application/x-tex"} C^p
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N} \cup \{\infty\}
          %p
            The analog of the concept of
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Homeomorphism"}
          #Diffeomorphism.num_defn
            %h6#definition_79 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"}> diffeomorphism
                )
            %p
              Given
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              is called a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟵
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    X \longleftarrow Y \;\colon\; g
            %p
              which is also a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} {}_\infty
              from remark
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryDiff"}
          #BasicPropertiesOfDiffeomorphisms.num_remark
            %h6#remark_33 Remark
            %p
              %strong
                (basic properties of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X,Y
              be
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Diffeomorphism"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g \colon Y \to X
                    \\,.
            %p Then:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is in particular a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Homeomorphism"}
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                %p
                  Because, by definition,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is in particular a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                        %annotation{:encoding => "application/x-tex"} g
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DifferentiableFunctionBetweenCartesianSpaces"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi f
                      %annotation{:encoding => "application/x-tex"} d f
                  of takes values in invertible linear maps, i.e.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %msub
                          %mi f
                          %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi T
                          %mi x
                        %mi X
                        %mover
                          %mo →
                          %mo ≃
                        %msub
                          %mi T
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mi X
                      %annotation{:encoding => "application/x-tex"} d f_x \colon T_x X \overset{\simeq}{\to} T_{f(x)} X
                  is a linear isomorphism for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x \in X
                %p
                  This is because by the
                  %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
                  (prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ChainRuleOnEuclideanSpace"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∘
                        %mi f
                        %mo =
                        %msub
                          %mi id
                          %mi X
                        %mphantom
                          %mi AAAAA
                        %mi f
                        %mo ∘
                        %mi g
                        %mo =
                        %msub
                          %mi id
                          %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        g \circ f = id_X \phantom{AAAAA}  f \circ g = id_{Y}
                %p imply that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %msub
                          %mi g
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi d
                        %msub
                          %mi f
                          %mi x
                        %mo =
                        %mi d
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi x
                        %mo =
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi T
                              %mi x
                            %mi X
                        %mphantom
                          %mi AAAAA
                        %mi d
                        %msub
                          %mi f
                          %mi x
                        %mo ∘
                        %mi d
                        %msub
                          %mi g
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mo =
                        %mi d
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi Y
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi T
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %mi Y
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        d g_{f(x)} \circ d f_x = d (id_X)_x = id_{T_x X}
                        \\phantom{AAAAA}
                        d f_{x} \circ d g_{f(x)} = d (id_Y)_{f(x)} = id_{T_{f(x)} Y}
                        \\,.
          %p
            Beware that just as with homeomorphisms (counter-example
            = succeed ")" do
              %a.maruku-ref{:href => "#ExponentialMapFromHalfOpenIntervalToCircle"}
            %a.existingWikiWord{:href => "/nlab/show/bijective+function"} bijective function
            of underlying sets need not be a diffeomorphism, see example
            %a.maruku-ref{:href => "#BijectiveSmoothFunctionNotADiffeomorphism"}
            below.
          %p
            It is important to note that while being a
            %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            is just a
            %a.existingWikiWord{:href => "/nlab/show/property"} property
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            carries
            %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            encoded in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
          #SmoothStructure.num_defn
            %h6#definition_80 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/smooth+structure"}> smooth structure
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalManifold"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mi n
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi X
                        %mo )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %msub
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mi n
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msub
                              %mi ψ
                              %mi j
                        %msub
                          %mi V
                          %mi j
                        %mo ⊂
                        %mi X
                        %mo )
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\mathbb{R}^n \underoverset{\simeq}{\phi_i}{\longrightarrow} U_i \subset X
                    \\right)_{i \in I}
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\left(
                    \\mathbb{R}^{n} \underoverset{\simeq}{\psi_j}{\longrightarrow} V_j \subset X
                    \\right)_{j \in J}
            %p
              be two
              %a.existingWikiWord{:href => "/nlab/show/atlases"} atlases
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Charts"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            %p
              Then there is a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Diffeomorphism"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mrow
                          %mo (
                          %msup
                            %mi ℝ
                            %mi n
                          %munderover
                            %mo ⟶
                            %mo ≃
                            %mrow
                              %msub
                                %mi ϕ
                                %mi i
                          %msub
                            %mi U
                            %mi i
                          %mo ⊂
                          %mi X
                          %mo )
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mo )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mrow
                      %mo (
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mrow
                          %mo (
                          %msup
                            %mi ℝ
                            %mi n
                          %munderover
                            %mo ⟶
                            %mo ≃
                            %mrow
                              %msub
                                %mi ψ
                                %mi j
                          %msub
                            %mi V
                            %mi j
                          %mo ⊂
                          %mi X
                          %mo )
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    \\left(
                    X
                    \\;,\;
                    \\left(
                    \\mathbb{R}^n \underoverset{\simeq}{\phi_i}{\longrightarrow} U_i \subset X
                    \\right)_{i \in I}
                    \\right)
                    \\overset{\simeq}{\longrightarrow}
                    \\left(
                    X\;,\;
                    \\left(
                    \\mathbb{R}^{n} \underoverset{\simeq}{\psi_j}{\longrightarrow} V_j \subset X
                    \\right)_{j \in J}
                    \\right)
            %p
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              on the underlying set of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              constitutes such a diffeomorphism. (Because if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a diffeomorphism, then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f^{-1}\circ f = id_X
              is a diffeomorphism.)
            %p
              That the identity function is a diffeomorphism between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with these two atlases means, by definition
              = succeed "," do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mrow
                          %mrow
                            %mi j
                            %mo ∈
                            %mi J
                    %mrow
                      %mo (
                      %msubsup
                        %mi ϕ
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi ϕ
                            %mi i
                      %msub
                        %mi V
                        %mi j
                      %mover
                        %mo ⟶
                        %mrow
                          %msubsup
                            %mi ψ
                            %mi j
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %msup
                        %mi ℝ
                        %mi n
                      %mphantom
                        %mi AA
                      %mtext is smooth
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{{i \in I} \atop {j \in J}}{\forall}
                    \\left(
                    \\phi_i^{-1}(V_j) \overset{\phi_i}{\longrightarrow} V_j \overset{\psi_j^{-1}}{\longrightarrow} \mathbb{R}^n
                    \\phantom{AA}
                    \\text{is smooth}
                    \\right)
                    \\,.
            %p Notice that the functions on the right may equivalently be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⊃
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi V
                      %mi j
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi ψ
                          %mi j
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msubsup
                      %mi ψ
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \supset
                    \\,
                    \\phi_i^{-1}(U_i \cap U_j)
                    \\overset{\phi_i}{\longrightarrow}
                    U_i \cap V_j \overset{\psi_j^{-1}}{\longrightarrow} \psi_j^{-1}(U_i \cap V_j) \; \subset \mathbb{R}^n
            %p
              showing their analogy to the gluing functions within a single atlas (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Charts"}
            %p
              Hence diffeomorphism induces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on the set of smooth atlases that exist on a given
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              with respect to this equivalence relation is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Now we finally discuss
            = succeed "." do
              %strong examples of manifolds
          #DifferentiableManifoldCartesianSpace.num_example
            %h6#example_126 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                as a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              consisting of the single
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mi ℝ
                        %mi n
                      %mover
                        %mo →
                        %mi id
                      %msup
                        %mi ℝ
                        %mi n
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbb{R}^n \overset{id}{\to} \mathbb{R}^n
                    \\right\}
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            %p
              Similarly the
              %a.existingWikiWord{:href => "/nlab/show/open+disk"} open disk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              when equipped with the atlas whose single chart is the
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo →
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \to D^n
              = succeed "." do
                %a.maruku-ref{:href => "#OpenBallsHomeomorphicToRn"}
          #BijectiveSmoothFunctionNotADiffeomorphism.num_example
            %h6#counterexample Counter-Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/bijective+function"} bijective
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                which is not a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            %p
              Regard the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              via example
              = succeed "." do
                %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi x
                              %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^1 &amp;\longrightarrow&amp; \mathbb{R}^1
                    \\\
                    x &amp;\mapsto&amp; x^3
                    }
                    \\,.
            %p
              This is clearly a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              and its underlying function of sets is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijective+function"} bijection
            %p
              But it is
              %em not
              a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#Diffeomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              vanishes at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x = 0
              = succeed "." do
                %a.maruku-ref{:href => "#BasicPropertiesOfDiffeomorphisms"}
          #SmoothManifoldnSphere.num_example
            %h6#example_127 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                as a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              becomes a smooth manifold, with
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              consisting of the two
              %a.existingWikiWord{:href => "/nlab/show/local+charts"} local charts
              that are given by the
              %a.existingWikiWord{:href => "/nlab/show/inverse+functions"} inverse functions
              of the
              %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"} stereographic projection
              from the two poles of the sphere onto the
              %a.existingWikiWord{:href => "/nlab/show/equator"} equatorial
              hyperplane
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi ℝ
                          %mi n
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msubsup
                              %mi σ
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %msup
                          %mi S
                          %mi n
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbb{R}^n
                    \\underoverset{\simeq}{\sigma^{-1}_i}{\longrightarrow}
                    S^n
                    \\right\}_{i \in \{+,-\}}
                    \\,.
            %p
              By the formula given in the proof of prop.
              %a.maruku-ref{:href => "#StandardStereographicProjection"}
              the induced
              %a.existingWikiWord{:href => "/nlab/show/gluing+function"} gluing function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \setminus \{0\} \to \mathbb{R}^n \setminus \{0\}
              are
              %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
              and hence
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            %p
              Finally the
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+topological+space"} paracompact Hausdorff topological space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} S^n \subset \mathbb{R}^{n+1}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/compact+subspace"} compact subspace
                  by the
                  %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
                  (prop.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#BorelHeine"}
                  = succeed ")." do
                    %a.maruku-ref{:href => "#CompactSpaceIsParacompact"}
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
                  = succeed ")," do
                    %a.maruku-ref{:href => "#HausdorffMetricSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
                  of Hausdorff spaces are Hausdorff;
              %li
                %p
                  The
                  = succeed "-sphere" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TopologicalnSphereIsPushoutOfBoundaryOfnBallInclusionAlongItself"}
                  %a.existingWikiWord{:href => "/nlab/show/CW-complexes+are+paracompact+Hausdorff+spaces"} CW-complexes are paracompact Hausdorff spaces
                  (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#ParacompactHausdorffCWComplexes"}
          .num_remark
            %h6#remark_34 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/exotic+smooth+structure"}> exotic smooth structure
                )
            %p
              The constructions in example
              %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
              and
              %a.maruku-ref{:href => "#SmoothManifoldnSphere"}
              define
              %a.existingWikiWord{:href => "/nlab/show/smooth+structures"} smooth structures
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothStructure"}
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              underlying the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and the
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
              %em standard smooth structures
              that are used by default whenever these spaces are used in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
              = succeed "." do
                %a{:href => "differential+geometry#Gauss1827"} Gauss 1827
            %p
              But since being a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
              on a topological space (as opposed to being a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/extra+property"} extra property
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              admit
              %em other
              %a.existingWikiWord{:href => "/nlab/show/smooth+structures"} smooth structures
              besides these standard ones. Remarkably, they do, for special values of the
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/exotic+smooth+structures"} exotic smooth structures
            %p
              In dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} \leq 3
              there are no exotic smooth structures: Two smooth manifolds of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} \leq 3
              are
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Diffeomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              are
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Homeomorphism"}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≠
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} n \neq 4
              there is a
              %em unique
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              on the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (the standard one from example
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
            %p
              There are uncountably many exotic smooth structures on Euclidean 4-space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            %p
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 5
                  %annotation{:encoding => "application/x-tex"} n \geq 5
              there is a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              of smooth structures on the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
            %p
              It is still unknown whether there is an exotic smooth structure on the
              %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} S^4
            %p
              The only
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              with no exotic smooth structure in the range
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 5
                    %mo ≤
                    %mi n
                    %mo ≤
                    %mn 61
                  %annotation{:encoding => "application/x-tex"} 5 \leq n \leq 61
              are
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 5
                    %annotation{:encoding => "application/x-tex"} S^5
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 6
                    %annotation{:encoding => "application/x-tex"} S^6
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 12
                    %annotation{:encoding => "application/x-tex"} S^{12}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 56
                  %annotation{:encoding => "application/x-tex"} S^{56}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 61
                    %annotation{:encoding => "application/x-tex"} S^{61}
            %p
              For more on all of this see at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/exotic+smooth+structure"} exotic smooth structure
          #OpenSubsetsOfDifferentiableManifoldsAreDifferentiableManifolds.num_example
            %h6#example_128 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                of differentiable manifolds are again differentiable manifolds)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              carries the structure of a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+embedding"} open
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+differentiable+manifolds"} embedding of differentiable manifolds
          .proof
            %h6#proof_117 Proof
            %p
              Since the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalPropertiesOfLocallyEuclideanSpace"}
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of its
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyConnected"}
              = succeed ")." do
                %a.maruku-ref{:href => "#AlternativeCharacterizationOfLocalConnectivity"}
            %p
              Therefore we are reduced to showing the statement for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a single
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              %a.maruku-ref{:href => "#RegularityConditionsForTopologicalManifoldsComparison"}
              this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/second-countable+topological+space"} second-countable topological space
            %p
              Now a
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of a second-countable Hausdorff space is clearly itself second countable and Hausdorff.
            %p
              Similarly it is immediate that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is still
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+space"} locally Euclidean
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is locally Euclidean every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in S \subset X
              has a Euclidean neighbourhood in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is open there exists an open ball in that (itself
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to Euclidean space) which is a Euclidean neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              For the differentiable structure we pick these Euclidean neighbourhoods from the given atlas. Then the
              %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
              for the Euclidean charts on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #DiffeoCoord.num_example
            %h6#example_129 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coordinate+transformations"} coordinate transformations
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi X
                      %mo ,
                      %msub
                        %mrow
                          %mo {
                          %msup
                            %mi ℝ
                            %mi n
                          %munderover
                            %mo →
                            %mo ≃
                            %mrow
                              %msub
                                %mi ϕ
                                %mi i
                          %msub
                            %mi U
                            %mi i
                          %mo ⊂
                          %mi X
                          %mo }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( X, \left\{ \mathbb{R}^n \underoverset{\simeq}{\phi_i}{\to}  U_i \subset X \right\}_{i \in I} \right)
              be a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %a.maruku-ref{:href => "#OpenSubsetsOfDifferentiableManifoldsAreDifferentiableManifolds"}
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i,j \in I
              the open subsets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_i^{-1}(U_i \cap U_j) \subset \mathbb{R}^n
            %p
              canonically are differentiable manifolds themselves. By definition of differentiable manifolds, the
              %a.existingWikiWord{:href => "/nlab/show/coordinate+transformation"} coordinate transformation
              functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mi j
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msubsup
                      %mi ϕ
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_i^{-1}(U_i \cap U_j)
                    \\overset{\phi_i}{\longrightarrow}
                    U_i \cap U_j
                    \\overset{\phi_j^{-1}}{\longrightarrow}
                    \\phi_j^{-1}(U_i \cap U_j)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ϕ
                          %mi j
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mover
                      %mo ⟶
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_j^{-1}(U_i \cap U_j)
                    \\overset{\phi_j}{\longrightarrow}
                    U_i \cap U_j
                    \\overset{\phi_i^{-1}}{\longrightarrow}
                    \\phi_i^{-1}(U_i \cap U_j)
            %p
              both are differentiable functions. Moreover they are
              %a.existingWikiWord{:href => "/nlab/show/bijective+functions"} bijective functions
              by assumption and by construction. This means that they are
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Diffeomorphism"}
          #SmoothManifoldGeneralLinearGroup.num_example
            %h6#example_130 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                as a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gl
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gl(n,\mathbb{R})
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#GLn"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (as an
              %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open subspace
              of
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi Mat
                        %mrow
                          %mi n
                          %mo ×
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi ℝ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi n
                            %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(n,\mathbb{R}) \subset Mat_{n \times n}(\mathbb{R}) \simeq \mathbb{R}^{(n^2)}
              %a.maruku-ref{:href => "#OpenSubsetsOfDifferentiableManifoldsAreDifferentiableManifolds"}
              and example
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableManifoldCartesianSpace"}
            %p
              The group operations, being
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+functions"} polynomial functions
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              with respect to this smooth manifold structure, and thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n,\mathbb{R})
              is a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
          %p
            Next we want to show that
            %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
            and
            %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ToplogicalProjectiveSpace"}
            = succeed ")." do
              %a.maruku-ref{:href => "#TopologicalProjectiveSpaceStandardOpenCover"}
          #ProjectiveSpaceOpenCoverIsAtlas.num_lemma
            %h6#lemma_29 Lemma
            %p
              %strong
                (standard open cover of
                %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            %p
              The charts of the standard open cover of projective space, from def.
              %a.maruku-ref{:href => "#TopologicalProjectiveSpaceStandardOpenCover"}
              are
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homeomorphic
              to
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k^n
          .proof
            %h6#proof_118 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
