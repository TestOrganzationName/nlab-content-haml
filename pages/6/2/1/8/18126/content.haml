                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (x_n)_{n \in \mathbb{N}}
              be a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_n)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Sequences"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              to a point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn ∞
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x_\infty \in X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mi n
                        %mo →
                        %mn ∞
                    %msub
                      %mi x
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    x_n \overset{n \to \infty}{\longrightarrow} x_\infty
            %p
              if for each
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi x
                          %mn ∞
                  %annotation{:encoding => "application/x-tex"} U_{x_\infty}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} x_\infty
              there exists a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n \geq k
              then
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi n
                      %mo ∈
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi x
                            %mn ∞
                    %annotation{:encoding => "application/x-tex"} x_n \in U_{x_\infty}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi x
                        %mi n
                      %mover
                        %mo ⟶
                        %mrow
                          %mi n
                          %mo →
                          %mn ∞
                      %msub
                        %mi x
                        %mn ∞
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∀
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %msub
                                %mi U
                                %mrow
                                  %msub
                                    %mi x
                                    %mn ∞
                              %mo ∈
                              %msub
                                %mi τ
                                %mi X
                          %mrow
                            %mrow
                              %msub
                                %mi x
                                %mn ∞
                              %mo ∈
                              %msub
                                %mi U
                                %mrow
                                  %msub
                                    %mi X
                                    %mn ∞
                      %mrow
                        %mo (
                        %munder
                          %mo ∃
                          %mrow
                            %mi k
                            %mo ∈
                            %mi ℕ
                        %mrow
                          %mo (
                          %munder
                            %mo ∀
                            %mrow
                              %mi n
                              %mo ≥
                              %mi k
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi x
                            %mi n
                          %mo ∈
                          %msub
                            %mi U
                            %mrow
                              %msub
                                %mi x
                                %mn ∞
                          %mspace{:width => "thinmathspace"}
                          %mo )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    x_n \overset{n \to \infty}{\longrightarrow} x_\infty
                    \\right)
                    \\;\Leftrightarrow\;
                    \\left(
                    \\underset{{U_{x_\infty} \in \tau_X} \atop {x_\infty \in U_{X_\infty}}}{\forall}
                    \\left(
                    \\underset{k \in \mathbb{N}}{\exists}
                    \\left(
                    \\underset{n \geq k}{\forall}
                    \\, x_n \in U_{x_\infty} \,
                    \\right)
                    \\right)
                    \\right)
                    \\,.
          %p Accordingly it makes sense to consider the following:
          #SequentiallyCompactTopologicalSpace.num_defn
            %h6#definition_50 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+topological+space"}> sequentially compact topological space
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+topological+space"} sequentially compact
              if for every
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_n)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
