              into them are in natural bijection with the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cones
                    %mrow
                      %mo (
                      %mi Y
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi X
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
