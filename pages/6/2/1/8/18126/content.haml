          #TopologicalProjectiveSpaceStandardOpenCover.num_defn
            %h6#definition_64 Definition
            %p
              %strong
                (standard open cover of topological
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective space
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %em standard open cover
              of the projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k P^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ToplogicalProjectiveSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi k
                        %msup
                          %mi P
                          %mi n
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_i \subset k P^n
                    \\right\}_{i \in \{1, \cdots, n+1\}}
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo :
                      %mi ⋯
                      %mo :
                      %msub
                        %mi x
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi k
                      %msup
                        %mi P
                        %mi n
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi x
                        %mi i
                      %mo ≠
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_i
                    \\coloneqq
                    \\left\{
                    [x_1 : \cdots : x_{n+1}] \in k P^n
                    \\;\vert\;
                    x_i \neq 0
                    \\right\}
                    \\,.
            %p To see that this is an open cover:
            %ol
              %li
                %p
                  This is a cover because with the origin removed in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mi n
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} k^n \setminus \{0\}
                  at every point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mn 1
                        %mo :
                        %mi ⋯
                        %mo :
                        %msub
                          %mi x
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [x_1: \cdots : x_{n+1}]
                  at least one of the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi i
                      %annotation{:encoding => "application/x-tex"} x_i
                  has to be non-vanishing.
              %li
                %p
                  These subsets are open in the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi kP
                            %mi n
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi k
                            %mi n
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo ∼
                        %annotation{:encoding => "application/x-tex"} kP^n = (k^n \setminus \{0\})/\sim
                  %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
                  under the quotient co-projection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo →
                        %mi k
                        %msup
                          %mi P
                          %mi n
                      %annotation{:encoding => "application/x-tex"} k^{n+1} \setminus \{0\} \to k P^n
                  coincides with the pre-image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi pr
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} pr_i^{-1}( k \setminus \{0\} )
                  under the
                  %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                  onto the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
