                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo ×
