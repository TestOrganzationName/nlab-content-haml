          #TrivialTopologicalVectorBundle.num_example
            %h6#example_115 Example
            %p
              %strong
                (topological
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                and (local) trivialization)
            %p
