                    \\,.
            %p
              This in turn would mean that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %msub
                            %mi i
                            %mi k
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} F_{i_k} = \empty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %msub
                            %mi i
                            %mi k
                    %annotation{:encoding => "application/x-tex"} F_{i_k}
              %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
              that assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              is wrong, and hence that there must exist an element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %munder
                      %mo ∩
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msub
