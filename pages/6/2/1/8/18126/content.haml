                        \\left(
                        \\underset{\longleftarrow}{\lim}_i X_i
                        \\right)
                        \\;\simeq\;
                        \\underset{\longleftarrow}{\lim}_i R(X_i)
                        \\,.
            %p
              This implies that if we have a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi nice
                    %munderover
