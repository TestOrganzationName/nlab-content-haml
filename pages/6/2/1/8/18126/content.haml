              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} X/\sim
              to one of its members
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde f \;\colon\; [x] \mapsto x
            %p
              and that this is well defined and independent of the choice of representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is guaranteed by the condition on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              above.
            %p
              Hence it only remains to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              defined this way is continuous, hence that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} U \subset Y
              an open subset, then its pre-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \tilde f^{-1}(U) \subset X/\sim
              is open in the quotient topology. By definition of the quotient topology (example
              = succeed ")," do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo ∘
                      %mi p
                    %annotation{:encoding => "application/x-tex"} f = \tilde f \circ p
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mrow
                              %mo (
                              %msup
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mrow
                                %mo (
                                %mi U
                                %mo )
                              %mo )
                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                                %mo ∘
                                %mi p
                                %mo )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi f
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p^{-1}
                    \\left(
                    \\tilde f^{-1}
                    \\left(
                    U
                    \\right)
                    \\right)
                    \&amp; =
                    \\left(
                    \\tilde f \circ p
                    \\right)^{-1}(U)
                    \\\
                    \&amp; = f^{-1}(U)
                    \\end{aligned}
                    \\,.
          %p This kind of example we now generalize.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#LimitsAndColimits Limits and colimits
          %p
            We consider now the general definition of
            %a.existingWikiWord{:href => "/nlab/show/free+diagrams"} free diagrams
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            (def.
            %a.maruku-ref{:href => "#Diagram"}
            below), their
            %a.existingWikiWord{:href => "/nlab/show/cones"} cones
            and
            %a.existingWikiWord{:href => "/nlab/show/co-cones"} co-cones
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Cone"}
            %a.existingWikiWord{:href => "/nlab/show/limit"} limiting cones
            and
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimiting cocones
            (def.
            %a.maruku-ref{:href => "#LimitingCone"}
            below).
          %p
            Then we use these concepts to see generally (remark
            %a.maruku-ref{:href => "#CoLimitsInNiceTopologicalSpaces"}
            below) why
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            (such as
            %a.existingWikiWord{:href => "/nlab/show/product+spaces"} product spaces
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi n
                        %mo ≤
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} T_{n \leq 2}
            %a.existingWikiWord{:href => "/nlab/show/sober+spaces"} sober spaces
            are again
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi n
                %annotation{:encoding => "application/x-tex"} T_n
            or sober, respectively, and to see that the correct
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            (such as
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union+spaces"} disjoint union spaces
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
              \-reflection
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#HausdorffReflection"}
            = succeed ")," do
              %a.maruku-ref{:href => "#SoberReflection"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #Diagram.num_defn
            %h6#definition_30 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/free+diagram"} free diagram
                of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/free+diagram"} free diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              or of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{ X_i \}_{i \in I}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  or of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi I
                        %mo ×
                        %mi I
                      %annotation{:encoding => "application/x-tex"} (i,j) \in I \times I
                  of labels, a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi i
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mi α
                        %msub
                          %mi X
                          %mi j
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi α
                            %mo ∈
                            %msub
                              %mi I
                              %mrow
                                %mi i
                                %mo ,
                                %mi j
                      %annotation{:encoding => "application/x-tex"} \{ X_i \overset{ f_\alpha }{\longrightarrow} X_j\}_{\alpha \in I_{i,j}}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#FreeDiagramsExamples Here is a list of basic and important examples of free diagrams
          %ul
            %li
              %p
                %em discrete diagrams and the empty diagram
                (example
                = succeed ");" do
                  %a.maruku-ref{:href => "#DiscreteDiagram"}
            %li
              %p
                %em pairs of parallel morphisms
                (example
                = succeed ");" do
                  %a.maruku-ref{:href => "#ParallelMorphisms"}
            %li
              %p
                %em span and cospan diagram
                (example
                = succeed ");" do
                  %a.maruku-ref{:href => "#SpanDiagram"}
            %li
              %p
                %em tower and cotower diagram
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#TowerDiagram"}
          #DiscreteDiagram.num_example
            %h6#example_60 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty diagram
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi I
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} (i,j) \in I \times I
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} I_{i,j} = \emptyset
              be the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/free+diagrams"} free diagrams
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Diagram"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %p
              For example for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I = \{1,2,3\}
              the set with 3-elements, then such a diagram looks like this:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mphantom
                      %mi AAA
                    %msub
                      %mi X
                      %mn 2
                    %mphantom
                      %mi AAA
                    %msub
                      %mi X
                      %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_1 \phantom{AAA} X_2 \phantom{AAA} X_3
                    \\,.
            %p
              Notice that here the index set may be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} I = \emptyset
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty diagram
          #ParallelMorphisms.num_defn
            %h6#definition_31 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I = \{a, b\}
              be the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              with two elements, and consider the sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mn 2
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo =
                              %mi a
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mtext and
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} (
                              %mi j
                              %mo =
                              %mi b
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I_{i,j}
                    \\;\coloneqq\;
                    \\left\{
                    \\array{
                    \\{ 1,2 \} &amp; \vert &amp; (i = a) \,\text{and}\, (j = b)
                    \\\
                    \\emptyset &amp; \vert &amp; \text{otherwise}
                    }
                    \\right\}
                    \\,.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/free+diagrams"} free diagrams
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Diagram"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/pairs+of+parallel+morphisms"} pairs of parallel morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi a
                    %munderover
                      %mphantom
                        %mi AAAAA
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mn 1
                    %msub
                      %mi X
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_a
                    \\underoverset
                    {\underset{f_2}{\longrightarrow}}
                    {\overset{f_1}{\longrightarrow}}
                    {\phantom{AAAAA}}
                    X_b
                    \\,.
          #SpanDiagram.num_example
            %h6#example_61 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/span"} span
                and
                %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I = \{a,b,c\}
              the set with three elements, and set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi f
                                %mn 1
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo =
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mtext and
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} (
                              %mi j
                              %mo =
                              %mi a
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi f
                                %mn 2
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo =
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mtext and
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} (
                              %mi j
                              %mo =
                              %mi b
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    I_{i ,j}
                    \=
                    \\left\{
                    \\array{
                    \\{f_1\} &amp; \vert &amp; (i = c) \,\text{and}\, (j = a)
                    \\\
                    \\{f_2\} &amp; \vert &amp; (i = c) \,\text{and}\, (j = b)
                    \\\
                    \\emptyset &amp; \vert &amp; \text{otherwise}
