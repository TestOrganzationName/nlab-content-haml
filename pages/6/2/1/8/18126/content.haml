                        \\,.
              %li
                %p
                  There is an evident
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  between the results of the two orders in which to form their
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
                  = succeed ":" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi β
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
