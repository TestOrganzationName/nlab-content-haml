                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi A
                    %mo ≔
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAA
                    %msub
                      %mi U
                      %mi B
                    %mo ≔
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
