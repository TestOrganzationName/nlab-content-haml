                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p Next we need to see how the transition functions behave under isomorphisms of vector bundles.
          #CoboundaryCech.num_defn
            %h6#definition_72 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                between
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
                %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo ∈
                    %msup
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %munder
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mo ̲
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1, c_2 \in C^1(X, \underline{GL(k)})
              be two
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
              %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CocycleCech"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi U
                        %msub
                          %mo ′
                          %mi i
                        %mo ⊂
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ′
                            %mo ∈
                            %mi I
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} \{U'_i \subset X\}_{i' \in I'}
                  two
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo →
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ,
                            %mi j
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{g_{i j} \colon U_i \cap U_j \to GL(n,k)\}_{i,j \in I}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi g
                        %msub
                          %mo ′
                          %mrow
                            %mi i
                            %mo ′
                            %mo ,
                            %mi j
