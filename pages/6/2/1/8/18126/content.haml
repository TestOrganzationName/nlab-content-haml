            %h6#definition_10 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/complete+metric+space"}> complete metric space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchySequence"}
              %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Convergence"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/complete+metric+space"} complete metric space
            %p
              A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/normed+vector+space"} normed vector space
              %a.maruku-ref{:href => "#MetricSpaceFromNormedVectorSpace"}
              that is complete in this sense is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Banach+space"} Banach space
          %p
            Finally recall the concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/compactness"} compactness
            of
            %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/epsilontic+analysis"} epsilontic analysis
          #MetricSpaceSequentiallyCompact.num_defn
            %h6#definition_11 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+metric+space"}> sequentially compact metric space
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricSpace"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+space"} sequentially compact
              if every
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a subsequence (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sequences"}
              %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Convergence"}
          %p
            The key fact to translate this
            %a.existingWikiWord{:href => "/nlab/show/epsilontic+analysis"} epsilontic
            definition of compactness to a concept that makes sense for general
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            (
            %a{:href => "#CompactSpaces"}> below
            ) is the following:
          #CompactnessImpliedBySequentialCompactnessForMetricSpace.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+metric+spaces+are+equivalently+compact+metric+spaces"}> sequentially compact metric spaces are equivalently compact metric spaces
                )
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricSpace"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+space"} sequentially compact
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#OpenSubsetsOfAMetricSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  in that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo =
                          %munder
                            %mo ∪
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} X = \underset{i \in I}{\cup} U_i
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo ⊂
                        %mi I
                      %annotation{:encoding => "application/x-tex"} J \subset I
                  of these open subsets which still covers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  in that also
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo =
                          %munder
                            %mo ∪
                            %mrow
                              %mi i
                              %mo ∈
                              %mi J
                              %mo ⊂
                              %mi I
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} X = \underset{i \in J \subset I}{\cup} U_i
          %p
            The
            %strong proof
            of prop.
            %a.maruku-ref{:href => "#CompactnessImpliedBySequentialCompactnessForMetricSpace"}
            is most conveniently formulated with some of the terminology of topology in hand, which we introduce now. Therefore we postpone the proof to
            = succeed "." do
              %a{:href => "#ProofOfSequentiallyCompactMetricSpacesAreEquivCompact"} below
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            In
            %strong summary
            prop.
            %a.maruku-ref{:href => "#ContinuityBetweenMetricSpacesInTermsOfOpenSets"}
            and prop.
            %a.maruku-ref{:href => "#CompactnessImpliedBySequentialCompactnessForMetricSpace"}
            show that the purely combinatorial and in particular non-
            %a.existingWikiWord{:href => "/nlab/show/epsilontic+analysis"} epsilontic
            concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            captures a substantial part of the nature of
            %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            %em only
            characterized by what counts as their open subsets. These are the
            %em
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            which we turn to now in def.
            %a.maruku-ref{:href => "#TopologicalSpace"}
            (or, more generally, these are the “
            %a.existingWikiWord{:href => "/nlab/show/locales"}> locales
            ”, which we briefly consider below in remark
            = succeed ")." do
              %a.maruku-ref{:href => "#Locales"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#TopologicalSpaces Topological spaces
          %p
            Due to prop.
            %a.maruku-ref{:href => "#ContinuityBetweenMetricSpacesInTermsOfOpenSets"}
            we should pay attention to
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
          #OpenSubsetsOfMetricSpaceClosureProperties.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong (closure properties of open sets in a metric space)
            %p
              The collection of
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              of a
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              as in def.
              %a.maruku-ref{:href => "#OpenSubsetsOfAMetricSpace"}
              has the following properties:
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/union"} union
                  of any
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  of open subsets is again an open subset.
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                  of any
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
                  of open subsets is again an open subset.
          #EmptyIntersection.num_remark
            %h6#remark Remark
            %p
              %strong (empty union and empty intersection)
            %p
              Notice the degenerate case of
              %a.existingWikiWord{:href => "/nlab/show/unions"} unions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cup} U_i
              and
              %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∩
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} U_i
              of
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_i \subset X
              for the case that they are indexed by the
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} I = \emptyset
            %ol
              %li
                %p
                  the
                  %em empty union
                  is the empty set itself;
              %li
                %p
                  the
                  %em empty intersection
                  is all of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
            %p
              (The second of these may seem less obvious than the first. We discuss the general logic behind these kinds of phenomena
              = succeed ".)" do
                %a{:href => "#UniversalConstructions"} below
            %p
              This way prop.
              %a.maruku-ref{:href => "#OpenSubsetsOfMetricSpaceClosureProperties"}
              is indeed compatible with the degenerate cases of examples of open subsets in example
              = succeed "." do
                %a.maruku-ref{:href => "#OpenEmptySet"}
          %p
            Proposition
            %a.maruku-ref{:href => "#OpenSubsetsOfMetricSpaceClosureProperties"}
            motivates the following generalized definition, which abstracts away from the concept of
            %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
            just its system of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
          #TopologicalSpace.num_defn
            %h6#definition_12 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"}> topological spaces
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              of
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of the
              %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(X)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau \subset P(X)
            %p such that this is closed under forming
            %ol
              %li
                %p
                  finite
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
              %li
                %p
                  arbitrary
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/unions"} unions
            %p
              In particular (by remark
              = succeed "):" do
                %a.maruku-ref{:href => "#EmptyIntersection"}
            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \emptyset \subset X
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                (being the union of no subsets)
            %p and
            %ul
              %li
                the whole set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \subset X
                itself is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                (being the intersection of no subsets).
            %p
              A set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with such a
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          .num_remark
            %h6#remark_2 Remark
            %p
              In the field of
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              it is common to eventually simply say “
              %a.existingWikiWord{:href => "/nlab/show/space"}> space
              ” as shorthand for “
              %a.existingWikiWord{:href => "/nlab/show/topological+space"}> topological space
              ”. This is especially so as further qualifiers are added, such as “Hausdorff space” (def.
              %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
              below). But beware that there are other kinds of
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
              in mathematics.
          %p
            In view of example
            %a.maruku-ref{:href => "#MetricTopology"}
            below one generalizes the terminology from def.
            %a.maruku-ref{:href => "#OpenSubsetsOfAMetricSpace"}
            as follows:
          #Neighbourhood.num_defn
            %h6#definition_13 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/neighbourhood"}> neighbourhood
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point. A
              %em
                %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              which contains an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              that still contains
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              An
              %em open neighbourhood
              is a neighbourhood that is itself an open subset, hence an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the same as an open subset containing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          .num_remark
            %h6#remark_3 Remark
            %p
              The simple definition of
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
              in def.
              %a.maruku-ref{:href => "#TopologicalSpace"}
              and the simple implementation of the
              %em principle of continuity
              below in def.
              %a.maruku-ref{:href => "#ContinuousMaps"}
              gives the field of
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              its fundamental and universal flavor. The combinatorial nature of these definitions makes
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              be closely related to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober topological space
              = succeed "." do
                %a{:href => "#SoberSpaces"} below
              %em
