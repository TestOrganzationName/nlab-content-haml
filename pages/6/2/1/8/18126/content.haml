                        %mi S
                  %annotation{:encoding => "application/x-tex"} \{U_{i_s} \to X\}_{s \in S}
              is a finite sub-cover as required.
          #SequentiallyCompactNeitherImpliesNorIsImpliedByCompactness.num_remark
            %h6#remark_17 Remark
            %p
              %strong
                (neither
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compactness
                nor
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+topological+space"} sequential compactness
                implies the other)
            %p
              Beware, in contrast to prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SequentiallyCompactMetricSpacesAreEquivCompact"}
              %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+space"} sequentially compact
              neither implies nor is implied by being
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InfiniteProductTopologicalSpace"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi r
                            %mo ∈
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mi Disc
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \underset{r \in [0,1)}{\prod} Disc(\{0,1\})
                  of copies of the
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CoDiscreteTopology"}
                  %a.existingWikiWord{:href => "/nlab/show/half-open+interval"} half-open interval
                  is compact by the
                  %a.existingWikiWord{:href => "/nlab/show/Tychonoff+theorem"} Tychonoff theorem
                  (prop.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#TychonoffTheorem"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi n
                      %annotation{:encoding => "application/x-tex"} x_n
                  with
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi r
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi n
                        %mtext th digit of the binary expansion of
                        %mspace{:width => "thinmathspace"}
                        %mi r
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_r(x_n) = n\text{th digit of the binary expansion of}\, r
                %p has no convergent subsequence.
              %li
                %p
                  conversely, there are spaces that are sequentially compact, but not compact, see for instance
                  = succeed "." do
                    %a{:href => "sequentially+compact+topological+space#Vermeeren10"} Vermeeren 10, prop. 18
          .num_remark
            %h6#remark_18 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/nets"} nets
                fix the shortcomings of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
            %p
              That
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compactness
              of topological spaces is not detected by
              %a.existingWikiWord{:href => "/nlab/show/convergence"} convergence
              of
              %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#SequentiallyCompactNeitherImpliesNorIsImpliedByCompactness"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/convergence"} convergence
              of sequences only invokes that the natural numbers form a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/directed+set"} directed set
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/directed+set"} directed set
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/net"} net
            %p
              And with these the expected statement does become true (for a
              %a.existingWikiWord{:href => "/nlab/show/proof"} proof
              see
              = succeed "):" do
                %a{:href => "net#CompactSpacesEquivalentlyHaveConvergetSubnets"} here
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"} \;\;\;\;
              %em
                A
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
                is
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                precisely if every
                %a.existingWikiWord{:href => "/nlab/show/net"} net
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                has a
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converging
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/subnet"} subnet
            %p
              In fact convergence of nets also detects
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              in topological spaces (hence their topology as such), and it detects the continuity of functions between topological spaces. It also detects for instance the Hausdorff property. (For detailed statements and proofs see
              = succeed ".)" do
                %em
                  %a{:href => "net#RelationToTopology"} here
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
              is cast in terms of
              %a.existingWikiWord{:href => "/nlab/show/nets"} nets
              instead of just sequences, then it raises to the same level of generality as topology.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#CompactHausdorffSpaces Compact Hausdorff spaces
          %p
            We discuss some important relations between the concepts of
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#CompactTopologicalSpace"}
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+spaces"} Hausdorff topological spaces
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          .num_prop
            %h6#proposition_51 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+Hausdorff+spaces+are+equivalently+compact+subspaces"}> closed subspaces of compact Hausdorff spaces are equivalently compact subspaces
                )
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
                  (def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CompactTopologicalSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Y \subset X
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                  (example
                  = succeed ")." do
                    %a.maruku-ref{:href => "#SubspaceTopology"}
            %p Then the following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Y \subset X
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#ClosedSubset"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
