                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \times k^n \overset{pr_1}{\to} X
            %p
              canonically becomes a topological vector bundle over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi X
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{X \subset X\}
              by the identity function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            %p
              This is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Given any topological vector bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \to X
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              to a trivial bundle (if it exists)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi A
                        %mo ≃
                        %mphantom
                          %mi A
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    E \overset{\phantom{A}\simeq\phantom{A}}{\longrightarrow} X \times k^n
            %p
