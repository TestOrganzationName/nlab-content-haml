          %p
            The terminology “closed” subspace for complements of opens is justified by the following statement, which is a further example of how the combinatorial concept of open subsets captures key phenomena in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
          #ConvergenceInClosedSubspace.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/convergence"} convergence
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+subspaces"} closed subspaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              be a
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via example
              = succeed "," do
                %a.maruku-ref{:href => "#MetricTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \subset X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} V \subset X
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
                  according to def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#ClosedSubset"}
              %li
                %p
                  For every
                  %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi i
                        %mo ∈
                        %mi V
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x_i \in V \subset X
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Sequences"}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
                  as a sequence in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Convergence"}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mn ∞
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x_\infty \in X
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mn ∞
                          %mo ∈
                          %mi V
                          %mo ⊂
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x_\infty \in V \subset X
          .proof
            %h6#proof_6 Proof
            %p
              First assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \subset X
              is closed and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                    %mover
                      %mo ⟶
                      %mrow
                        %mi i
                        %mo →
                        %mn ∞
                    %msub
                      %mi x
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} x_i \overset{i \to \infty}{\longrightarrow} x_{\infty}
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn ∞
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x_\infty \in X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn ∞
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x_\infty \in V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn ∞
                      %mo ∈
                      %mi X
                      %mo ∖
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x_\infty \in X\setminus V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi V
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \setminus V \subset X
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
              such that the
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of radius
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              were still contained in the complement:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi B
                        %mi x
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi X
                      %mo ∖
                      %mi V
                    %annotation{:encoding => "application/x-tex"} B^\circ_x(\epsilon) \subset X \setminus V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi ϵ
                  %annotation{:encoding => "application/x-tex"} N_\epsilon
              such that all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo &gt;
                        %msub
                          %mi N
                          %mi ϵ
                  %annotation{:encoding => "application/x-tex"} x_{i \gt N_{\epsilon}}
              are in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi B
                        %mi x
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B^\circ_x(\epsilon)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∖
                      %mi V
                    %annotation{:encoding => "application/x-tex"} X\setminus V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              are in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proved by contradiction
              that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn ∞
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x_\infty \in V
            %p
              Conversely, assume that for all sequences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              that converge to some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn ∞
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x_\infty \in X
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn ∞
                      %mo ∈
                      %mi V
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x_\infty \in V \subset X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is closed, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi V
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \setminus V \subset X
              is an open subset, hence that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                    %mo ∖
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x \in X \setminus V
              we may find a real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
              such that the
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^\circ_x(\epsilon)
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of radius
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              is still contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∖
                      %mi V
                    %annotation{:encoding => "application/x-tex"} X \setminus V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              did not exist. This would mean that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \geq 1
              then the
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi V
                  %annotation{:encoding => "application/x-tex"} B^\circ_x(1/k) \cap V
              were
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited"} non-empty
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} choose
              points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi k
                    %mo ∈
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x_k \in B^\circ_x(1/k) \cap V
              in these intersections. These would form a sequence which clearly converges to the original
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x \in V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                      %mo ∖
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x \in X \setminus V
              %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proved by contradiction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi V
                  %annotation{:encoding => "application/x-tex"} X \setminus V
              is in fact open.
          %p Often one considers closed subsets inside a closed subspace. The following is immediate, but useful.
          #SubsetsInClosedSubspace.num_lemma
            %h6#lemma_4 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/subsets+are+closed+in+a+closed+subspace+precisely+if+they+are+closed+in+the+ambient+space"}> subsets are closed in a closed subspace precisely if they are closed in the ambient space
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C \subset X
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ClosedSubset"}
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msub
                      %mi τ
                      %mi sub
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\tau_{sub})
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi C
                  %annotation{:encoding => "application/x-tex"} S \subset C
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msub
                      %mi τ
                      %mi sub
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\tau_{sub})
              precisely if it is closed as a subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
          .proof
            %h6#proof_7 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi C
                  %annotation{:encoding => "application/x-tex"} S \subset C
              is closed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msub
                      %mi τ
                      %mi sub
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\tau_{sub})
              this means equivalently that there is an open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mi C
                  %annotation{:encoding => "application/x-tex"} V \subset C
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msub
                      %mi τ
                      %mi sub
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C, \tau_{sub})
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mi C
                    %mo ∖
                    %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S = C \setminus V
                    \\,.
            %p
              But by the definition of the subspace topology, this means equivalently that there is a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              which is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi U
                      %mo ∩
                      %mi C
                    %annotation{:encoding => "application/x-tex"} V = U \cap C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo =
                            %mi C
                            %mo ∖
                            %mi V
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ∩
                            %mi C
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %mo ∖
                            %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S &amp; = C \setminus V
                    \\\
                    \&amp; = C \setminus (U \cap C)
                    \\\
                    \&amp; = C \setminus U
                    \\end{aligned}
                    \\,.
            %p
              But now the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              itself is a closed subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              means equivalently that there is an open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} W \subset X
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mi X
                      %mo ∖
                      %mi W
                    %annotation{:encoding => "application/x-tex"} C = X \setminus W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ,
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} W,U \subset X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∖
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi U
                    %mo =
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S = (X \setminus W) \setminus U
                    \=
                    X \setminus (W \cup U)
                    \\,.
            %p
              Since the union
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ∪
                    %mi U
                  %annotation{:encoding => "application/x-tex"} W \cup U
              is again open, this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is closed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            %p
              Conversely, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is closed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              means that there exists an open
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T \subset X
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo =
                      %mi X
                      %mo ∖
                      %mi T
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} S = X \setminus T \subset X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo =
                      %mi S
                      %mo ∩
                      %mi C
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ∖
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi C
                      %mo =
                      %mi C
                      %mo ∖
                      %mi T
                      %mo =
                      %mi C
                      %mo ∖
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ∩
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S = S \cap C = (X \setminus T) \cap C = C\setminus T = C \setminus (T \cap C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ∩
                    %mi C
                  %annotation{:encoding => "application/x-tex"} T \cap C
              is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msub
                      %mi τ
                      %mi sub
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\tau_{sub})
              by definition of the subspace topology, this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi C
                  %annotation{:encoding => "application/x-tex"} S \subset C
              is closed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %msub
                        %mi τ
                        %mi sub
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (C, \tau_{sub})
          %p A special role in the theory is played by the “irreducible” closed subspaces:
          #ClosedIrreducible.num_defn
            %h6#definition_18 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"}> irreducible closed subspace
                )
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubset"}
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible
              if it is
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} non-empty
              and not the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of two closed proper (i.e. smaller) subsets. In other words, a
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} non-empty
              closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is irreducible if whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mo ,
                    %msub
                      %mi S
                      %mn 2
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_1, S_2 \subset X
              are two
              %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %msub
                      %mi S
                      %mn 1
                    %mo ∪
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    S = S_1 \cup S_2
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mo =
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S_1 = S
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                      %mo =
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S_2 = S
          #IrreducibleClosureOfPoint.num_example
            %h6#example_23 Example
            %p
              %strong (closures of points are irreducible)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              inside a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(\{x\})
              of the
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \{x\} \subset X
              is
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subset"} irreducible
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ClosedIrreducible"}
          .num_example
            %h6#example_24 Example
            %p
              %strong (no nontrivial closed irreducibles in metric spaces)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via its
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              is closed (def
              = succeed ")," do
                %a.maruku-ref{:href => "#ClosedSubset"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \{x\} \subset X
              is irreducible according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#IrreducibleClosureOfPoint"}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              be the 1-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EuclideanNorm"}
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi c
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \lt c \subset \mathbb{R}
              the closed interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} [a,c] \subset \mathbb{R}
              (example
              %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
              ) is
              %em not
              irreducible, since for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b \in \mathbb{R}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                    %mo &lt;
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a \lt b \lt c
              it is the union of two smaller closed subintervals:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ∪
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [a,c] \,=\, [a, b] \cup [b, c]
                    \\,.
            %p
              In fact we will see below (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SoberFromHausdorff"}
          %p Often it is useful to re-express the condition of irreducibility of closed subspaces in terms of complementary open subsets:
          #OpenSubsetVersionOfClosedIrreducible.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong (irreducible closed subsets in terms of prime open subsets)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} P \in \tau
              be a proper
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ≔
                    %mi X
                    %mo ∖
                    %mi P
                  %annotation{:encoding => "application/x-tex"} F \coloneqq X\setminus P
              is a
              %a.existingWikiWord{:href => "/nlab/show/inhabited"} non-empty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is
              %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subspace"} irreducible
              in the sense of def.
              %a.maruku-ref{:href => "#ClosedIrreducible"}
              precisely if whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %msub
                      %mi U
                      %mn 2
                    %mo ∈
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} U_1,U_2 \in \tau
              are open subsets with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset P
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \subset P
              or
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊂
                      %mi P
                    %annotation{:encoding => "application/x-tex"} U_2 \subset P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi X
                      %mo ∖
                      %mi P
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext irreducible
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ∀
                        %mrow
                          %msub
                            %mi U
                            %mn 1
                          %mo ,
                          %msub
                            %mi U
                            %mn 2
                          %mo ∈
                          %mi τ
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msub
                            %mi U
                            %mn 1
                          %mo ∩
                          %msub
                            %mi U
                            %mn 2
                          %mo ⊂
                          %mi P
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo ⇒
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %msub
                            %mi U
                            %mn 1
                          %mo ⊂
                          %mi P
                          %mspace{:width => "thickmathspace"}
                          %mtext or
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi U
                            %mn 2
                          %mo ⊂
                          %mi P
                          %mo )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    X \setminus P \,\,\text{irreducible}
                    \\right)
                    \\;\Leftrightarrow\;
                    \\left(
                    \\underset{U_1, U_2 \in \tau}{\forall }
                    \\left(
                    \\left(
                    U_1 \cap U_2 \subset P
                    \\right)
                    \\;\Rightarrow\;
                    \\left(U_1 \subset P \;\text{or}\; U_2 \subset P\right)
                    \\right)
                    \\right)
                    \\,.
            %p
              The open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \subset X
              with this property are also called the
              %em prime open subsets
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \tau_X
          .proof
            %h6#proof_8 Proof
            %p
              Observe that every
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                    %mo ⊂
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F_i \subset F
              may be exhibited as the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                    %mo =
                    %mi F
                    %mo ∖
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    F_i = F \setminus U_i
            %p
              of some open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ∈
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} U_i \in \tau
              with respect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_1 \cap U_2 \subset P
              is equivalent to the condition that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 1
                      %mo ∪
                      %msub
                        %mi F
                        %mn 2
                      %mo =
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F_1 \cup F_2 = F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              in the following sequence of equations:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                            %mo ∪
                            %msub
                              %mi F
                              %mn 2
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo ∖
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo ∖
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mi X
                              %mo ∖
                              %mo{:stretchy => "false"} (
                              %mi P
                              %mo ∪
                              %msub
                                %mi U
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mo ∪
                            %mrow
                              %mo (
                              %mi X
                              %mo ∖
                              %mi P
                              %mo ∪
                              %msub
                                %mi U
                                %mn 2
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mrow
                              %mo (
                              %mrow
                                %mo (
                                %mi P
                                %mo ∪
                                %msub
                                  %mi U
                                  %mn 1
                                %mo )
                              %mo ∩
                              %mrow
                                %mo (
                                %mi P
                                %mo ∪
                                %msub
                                  %mi U
                                  %mn 2
                                %mo )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo ∩
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo =
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo ⋆
                                %mo{:stretchy => "false"} )
                            %mi X
                            %mo ∖
                            %mi P
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi F
                            %mspace{:width => "thinmathspace"}
                            %mo .
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    F_1 \cup F_2
                    \&amp; =
                    (F \setminus U_1) \cup (F \setminus U_2)
                    \\\
                    \&amp;
                    \= \left( X \setminus (P \cup U_1) \right) \cup \left( X \setminus P \cup U_2 \right)
                    \\\
                    \&amp; = X \setminus
                    \\left(
                    \\left(
                    P \cup U_1
                    \\right)
                    \\cap
                    \\left(
                    P \cup U_2
                    \\right)
                    \\right)
                    \\\
                    \&amp; = X \setminus ( P \cup (U_1 \cap U_2)  )
                    \\\
                    \&amp; \stackrel{(\star)}{=}   X \setminus P
                    \\\
                    \&amp; = F
                    \\,.
                    \\end{aligned}
                    \\,.
            %p
              Similarly, the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U_i \subset P
              is equivalent to the condition that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi i
                      %mo =
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F_i = F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              in the following sequence of equalities:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mi i
                          %mtd
                            %mo =
                            %mi F
                            %mo ∖
                            %msub
                              %mi U
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mo ∪
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo =
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo ⋆
                                %mo{:stretchy => "false"} )
                            %mi X
                            %mo ∖
                            %mi P
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    F_i &amp;= F \setminus U_i
                    \\\
                    \&amp; = X \setminus ( P \cup U_i )
                    \\\
                    \&amp; \stackrel{(\star)}{=} X \setminus P
                    \\\
                    \&amp; =
                    F
                    \\end{aligned}
                    \\,.
            %p Under these identifications, the two conditions are manifestly the same.
          %p
            We consider yet another equivalent characterization of irreducible closed subsets, prop.
            %a.maruku-ref{:href => "#FrameHomomorphismsToPointAreIrrClSub"}
            below, which will be needed in the discussion of the
            %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} separation axioms
            further
            = succeed "." do
              %a{:href => "#SeparationAxioms"} below
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            between
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            if we were to forget the underlying set of points of a topological space, and only remember the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi X
                %annotation{:encoding => "application/x-tex"} \tau_X
            with its operations induced by taking finite intersections and arbitrary unions:
          #HomomorphismOfFramesOfOpens.num_defn
            %h6#definition_19 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
                homomorphisms)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
              be
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                    %mo ⟵
                    %msub
                      %mi τ
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_X \longleftarrow \tau_Y \;\colon\; \phi
            %p
              between their
              %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"} sets of open subsets
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \tau_Y
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              if it preserves
            %ol
              %li
                %p
                  arbitrary
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/unions"} unions
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
            %p
              In other words,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a frame homomorphism precisely if
            %ol
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  and every
                  = succeed "-indexed" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
