            %div{:style => "float:left;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/Figure8Immersion.png", :width => "400"}/
            %p As a concrete examples, consider the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi π
                    %mo ,
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\coloneqq
                    (sin(2-), sin(-)) \;\colon\; (-\pi, \pi) \longrightarrow \mathbb{R}^2
                    \\,.
            %p
              While this is an immersion and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective"} injective
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mo ±
                    %mi π
                  %annotation{:encoding => "application/x-tex"} t = \pm \pi
              “touching” the point at
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t = 0
            %p
              Every open neighbourhood in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              which contains the origin
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,0)
              also contains the image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi π
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi π
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi( (-\pi , -\pi + \epsilon) \sqcup (\pi-\epsilon, \pi) )
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              and hence in the subspace topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi π
                    %mo ,
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} athbb
                    %msup
