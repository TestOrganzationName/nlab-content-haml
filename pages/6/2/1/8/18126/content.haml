              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msub
                      %mi I
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} \alpha \in I_{i,j}
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi α
                      %mo ∘
                      %msub
                        %mi p
                        %mi i
                      %mo =
                      %msub
                        %mi p
                        %mi j
                    %annotation{:encoding => "application/x-tex"} f_\alpha \circ p_i = p_j
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cones
                      %mrow
                        %mo (
                        %mi Y
                        %mo ,
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
