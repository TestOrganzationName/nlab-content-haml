                    \\;\mapsto\;
                    (T_n X \overset{T_n f}{\to} T_n Y)
            %p
              such as to preserve
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of functions as well as
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                    %mi g
                    %mo ∘
                    %msub
                      %mi T
                      %mi n
                    %mi f
                    %mo =
                    %msub
                      %mi T
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %msub
                      %mi T
                      %mi n
                    %msub
                      %mi id
                      %mi X
                    %mo =
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi T
                          %mi n
                        %mi X
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    T_n g \circ T_n f = T_n(g \circ f)
                    \\phantom{AA}
                    \\,,
                    \\phantom{AA}
                    T_n id_X = id_{T_n X}
                    \\,
            %p Finally, the comparison map is compatible with this in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi T
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAA
                    %mi i
                    %mo .
                    %mi e
                    %mo .
                    %mo :
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi t
                                    %mi n
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi t
                                    %mi n
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mi n
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi T
                                  %mi n
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi T
                              %mi n
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    t_n(Y) \circ f
                    \=
                    T_n(f) \circ t_n(X)
                    \\phantom{AAAA}
                    i.e.:
                    \\phantom{AAAA}
                    \\array{
                    X &amp;\overset{f}{\longrightarrow}&amp; Y
                    \\\
                    {}^{\mathllap{t_n(X)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{t_n(Y)}}
                    \\\
                    T_n X &amp;\underset{T_n(f)}{\longrightarrow}&amp; T_n Y
                    }
                    \\,.
          %p
            We
            %strong prove
            this via a concrete construction of
            = succeed "-reflection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
            %a.maruku-ref{:href => "#HausdorffReflectionViaHomsIntoAllHausdorffSpaces"}
            below. But first we pause to comment on the bigger picture of the
            = succeed "-reflection:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_n
          #ReflectiveSubcategory.num_remark
            %h6#remark_9 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"}> reflective subcategories
                )
            %p
              In the language of
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopCategory"}
              = succeed "-reflection" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi n
                    %annotation{:encoding => "application/x-tex"} T_n
              %a.maruku-ref{:href => "#HausdorffReflection"}
              says that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} T_n(-)
                  is a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi n
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Top
                        %mo ⟶
                        %msub
                          %mi Top
                          %mrow
                            %msub
                              %mi T
                              %mi n
                      %annotation{:encoding => "application/x-tex"} T_n \;\colon\; Top \longrightarrow Top_{T_n}
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  of
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mrow
                            %msub
                              %mi T
                              %mi n
                        %mover
                          %mo ↪
                          %mi ι
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Top_{T_n} \overset{\iota}{\hookrightarrow} Top
                  of Hausdorff topological spaces;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi t
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %msub
                          %mi T
                          %mi n
                        %mi X
                      %annotation{:encoding => "application/x-tex"} t_n(X) \colon X \to T_n X
                  is a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
                  on
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  to the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                        %mo ∘
                        %msub
                          %mi T
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \iota \circ T_n
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi n
                      %annotation{:encoding => "application/x-tex"} T_n
                  \-topological spaces form a
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                  of all
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                  in that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi n
                      %annotation{:encoding => "application/x-tex"} T_n
                  is
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  to the inclusion functor
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ι
                        %annotation{:encoding => "application/x-tex"} \iota
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mrow
                            %msub
                              %mi T
                              %mi n
                        %munderover
                          %mo ⊥
                          %munder
                            %mo ↪
                            %mrow
                              %mphantom
                                %mi A
                              %mi ι
                              %mphantom
                                %mi A
                          %mover
                            %mo ⟵
                            %mrow
                              %mphantom
                                %mi A
                              %mi H
                              %mphantom
                                %mi A
                        %mi Top
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Top_{T_n}
                        \\underoverset{\underset{\phantom{A}\iota\phantom{A}}{\hookrightarrow}}{\overset{\phantom{A}H\phantom{A}}{\longleftarrow}}{\bot}
                        Top
                        \\,.
            %p
              Generally, an
              %em
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
              between two
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ↔
                    %mi 𝒟
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi R
                  %annotation{:encoding => "application/x-tex"}
                    L \;\colon\; \mathcal{C} \leftrightarrow \mathcal{D} \;\colon\; R
            %p
              is for all pairs of objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
              a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between sets of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi d
                      %mo }
                    %mphantom
                      %mi A
                    %mo ↔
                    %mphantom
                      %mi A
                    %mrow
                      %mo {
                      %mi c
                      %mo ⟶
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    L(c) \longrightarrow d
                    \\right\}
                    \\phantom{A}
                    \\leftrightarrow
                    \\phantom{A}
                    \\left\{
                    c \longrightarrow R(d)
                    \\right\}
                    \\,.
            %p i.e.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ≃
                        %mphantom
                          %mi AA
                      %mrow
                        %msub
                          %mi ϕ
                          %mrow
                            %mi c
                            %mo ,
                            %mi d
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{D}}(L(c), d)
                    \\underoverset{\phantom{AA}\simeq \phantom{AA}}{\phi_{c,d}}{\longrightarrow}
                    Hom_{\mathcal{C}}(c, R(d))
            %p
              and such that these bijections are “
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"}> natural
              ” in that they for all pairs of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo ′
                    %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} f \colon c' \to c
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi d
                    %mo →
                    %mi d
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g \colon d \to d'
              then the folowing
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ≃
                                %mphantom
                                  %mi AA
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi c
                                    %mo ,
                                    %mi d
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi g
                                %mo ∘
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %mi L
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi R
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %mi f
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ≃
                                %mphantom
                                  %mi AA
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi c
                                    %mo ′
                                    %mo ,
                                    %mi d
                                    %mo ′
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒟
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ′
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{\mathcal{D}}(L(c), d)
                    \&amp;\underoverset{\phantom{AA}\simeq\phantom{AA}}{\phi_{c,d}}{\longrightarrow}&amp;
                    Hom_{\mathcal{C}}(c, R(d))
                    \\\
                    {\mathllap{g \circ (-) \circ L(f)}}\downarrow
                    \&amp;&amp;
                    \\downarrow{\mathrlap{ R(g) \circ (-) \circ f }}
                    \\\
                    Hom_{\mathcal{C}}(L(c'), d')
                    \&amp;\underoverset{\phantom{AA}\simeq\phantom{AA}}{\phi_{c',d'}}{\longrightarrow}&amp;
                    Hom_{\mathcal{D}}(c', R(d'))
                    }
                    \\,.
            %p
              One calls the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi c
                        %mo ,
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{c,L(c)}
              of the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id_{L(x)}
              the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit of the adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi c
                    %mo ⟶
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_x \;\colon\; c \longrightarrow R(L(c))
                    \\,.
            %p
              One may show that it follows that the image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi c
                        %mo ,
                        %mi d
                  %annotation{:encoding => "application/x-tex"} \phi_{c,d}
              of a general morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f \colon c \to d
              (called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed ":" do
