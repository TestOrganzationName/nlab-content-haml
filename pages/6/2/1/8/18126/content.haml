              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
          #CompactClosedInterval.num_example
            %h6#example_91 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/closed+intervals+are+compact+topological+spaces"}> closed intervals are compact topological spaces
                )
            %p
              For any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} a \lt b \in \mathbb{R}
              the
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
