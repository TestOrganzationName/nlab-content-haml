                                          %msub
                                            %mi U
                                            %mi i
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi U
                                  %mi i
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathbb{R}^d \times k^n &amp;&amp; \overset{\psi_i}{\longrightarrow} &amp;&amp; E\vert|_{U_i}
                        \\\
                        \&amp; {}_{\mathllap{\phi_i \circ pr_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{ \pi|\vert_{U_i} }}
                        \\\
                        \&amp;&amp; U_i
                        }
                %p
                  which makes this diagram commute and which is
                  = succeed "-wise" do
                    %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between differentiable vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_1 \overset{\pi_1}{\to}X]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mn 2
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_2 \overset{\pi_2}{\to} X]
              over the same base differentiable manifolds is a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              as in the top of the following
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_1 &amp;&amp; \overset{f }{\longrightarrow} &amp;&amp; E_2
                    \\\
                    \&amp; {}_{\mathllap{\pi_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{\pi_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              which makes this
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
              and which restricts to a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                  %annotation{:encoding => "application/x-tex"}
                    f_x \;\colon\; (E_1)_x \longrightarrow (E_2)_x
            %p
              on the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over each point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
            %p
              More generally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_1 \overset{}{\to} X_1]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mn 2
                    %msub
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_2 \overset{\pi_2}{\to} X_2]
              are differentiable vector bundles over possibly different differentiable base manifolds, then a homomorphism is a differentiable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon E_1 \to E_2
              together with a differentiable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              that make the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mn 2
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_1 &amp;\overset{f}{\longrightarrow}&amp; E_2
                    \\\
                    {}^{\mathllap{\pi_1}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\pi_2}}
                    \\\
                    X &amp;\underset{\tilde f}{\longrightarrow}&amp; Y
                    }
            %p commute and such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_x \;\colon\; (E_1)_x \longrightarrow (E_2)_{f(x)}
            %p
              is a linear map for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
            %p
              This yields a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TopCategory"}
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the differentiable vector bundles;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are the homomorphisms between these.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Diff
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Vect(Diff)
              for this category.
            %p
              Underlying a differentiable vector bundle, is a
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Diff
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U  \;\colon\; Vect(Diff) \longrightarrow Vect(Top)
            %p
              to the category of topological vector bundles from remark
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalVectorBundlesCategory"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#tangent_bundles Tangent bundles
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/TangentSpaceToSphere.png", :width => "250"}/
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
            are
            %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+spaces"} locally Euclidean spaces
            whose
            %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
            respect the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+analysis"} infinitesimal analysis
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+analysis"} infinitesimal analysis
            from
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            to more general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            has associated to each point a
            %em
              %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
            of
            %a.existingWikiWord{:href => "/nlab/show/vectors"} vectors
            that linearly approximate the manifold in the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
            of that point. The union of all these
            %a.existingWikiWord{:href => "/nlab/show/tangent+spaces"} tangent spaces
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of a
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            are therefore a choice of
            %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            for each point of a manifold, varying continuously or in fact differentiably. Such a “field” of tangent vectors is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+field"} tangent vector field
          %p
            One may think of this as specifying a direction along the manifold at each point, and accordingly tangent vector fields
            %a.existingWikiWord{:href => "/nlab/show/integration"} integrate
            to
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            of
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            that “flow along them”. Such
            %a.existingWikiWord{:href => "/nlab/show/flow+of+a+vector+field"} flows
            of tangent vector fields are the basic tool in
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+topology"} differential topology
          %p
            Finally the tangent bundle, via the
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            that is
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            to it, is the basis for all actual
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion-free
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+geometry"} Riemannian geometry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conformal+geometry"} conformal geometry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+geometry"} complex geometry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"} Cartan geometry
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            proper.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #TangencyRelationOnSmoothCurves.num_defn
            %h6#definition_82 Definition
            %p
              %strong (tangency relation on differentiable curves)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point. On the set of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
