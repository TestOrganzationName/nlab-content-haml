          %h3#properties Properties
          %p We discuss some basic general properties of topological vector bundles.
          #FiberwiseIsoisIsomorphismOfVectorBundles.num_lemma
            %h6#lemma_28 Lemma
            %p
              %strong (homomorphism of vector bundles is isomorphism as soon as it is a fiberwise isomorphism)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_1 \to X]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_2 \to X]
              be two topological vector bundles (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon E_1 \longrightarrow E_2
              restricts on the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over each point to a linear isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                  %annotation{:encoding => "application/x-tex"}
