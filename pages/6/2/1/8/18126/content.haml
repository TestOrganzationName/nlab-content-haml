              (def
              = succeed ")" do
                %a.maruku-ref{:href => "#UrysohnFunction"}
          .proof
            %h6#proof_23 Proof
            %p
              In one direction this is the statement of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urysohn+lemma"} Urysohn lemma
              = succeed "." do
                %a.maruku-ref{:href => "#UrysohnLemma"}
            %p
              In the other direction, assume the existence of
              %a.existingWikiWord{:href => "/nlab/show/Urysohn+functions"} Urysohn functions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#UrysohnFunction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A, B \subset X
              be disjoint closed subsets, then we need to show that these have disjoint open neighbourhoods.
            %p
              But let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f \colon X \to [0,1]
              be an Urysohn function with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} f(A) = \{0\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
