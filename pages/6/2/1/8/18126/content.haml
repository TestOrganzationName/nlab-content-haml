          %p And so forth. For instance:
          #InnerProductOnTopologicalVectorBundles.num_defn
            %h6#definition_71 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/inner+product+on+vector+bundles"}> inner product on vector bundles
                )
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/topological+field"} topological field
                  (such as the
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  or
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                  with their
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
                  %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
                  ),
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
