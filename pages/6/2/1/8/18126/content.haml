                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/countable+unions+of+countable+sets+are+countable"} countable unions of countable sets are countable
              we have obtained a countable base for the topology of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is second-countable.
            %p
              %strong
                1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇒
                    %annotation{:encoding => "application/x-tex"} \Rightarrow
                3)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be sigma-compact. We show that then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is paracompact with a countable set of connected components:
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+and+sigma-compact+spaces+are+paracompact"} locally compact and sigma-compact spaces are paracompact
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ParacompactFromLocallyCompactAndSigmacompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is paracompact. By
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} local connectivity
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalPropertiesOfLocallyEuclideanSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of its
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyConnected"}
              = succeed ")." do
                %a.maruku-ref{:href => "#AlternativeCharacterizationOfLocalConnectivity"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is also second-countable it cannot have an uncountable set of connected components. (Because there must be at least one base open contained in every connected component.)
            %p
              %strong
                2)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇒
                    %annotation{:encoding => "application/x-tex"} \Rightarrow
                1)
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be second-countable, we need to show that it is sigma-compact.
            %p
              This follows since
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+and+second-countable+spaces+are+sigma-compact"} locally compact and second-countable spaces are sigma-compact
              (lemma
              = succeed ")." do
                %a.maruku-ref{:href => "#SigmaCompactFromLocallyCompactAndSecondCountable"}
            %p
              %strong
                3)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇒
                    %annotation{:encoding => "application/x-tex"} \Rightarrow
                1)
            %p
              Now let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be paracompact with countably many connected components. We show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is sigma-compact.
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} local compactness
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              such that the topological closures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi K
                      %mi i
                    %mo ≔
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{K_i \coloneqq Cl(U_i) \subset X\}_{i \in I}
              constitute a cover by
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+spaces+are+normal"} paracompact Hausdorff spaces are normal
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ParacompactHausdorffSpacesAreNormal"}
              %a.existingWikiWord{:href => "/nlab/show/shrinking+lemma"} shrinking lemma
              applies (lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#ShrinkingLemmaForLocallyFiniteCountableCovers"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{V} \coloneqq \{V_j \subset X \}_{j \in J}
            %p
              as well as a locally finite cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{Cl(V_j) \subset X\}_{j \in J}
              by closed subsets. Since this is a refinement of the original cover, all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V_j)
              are contained in one of the compact subspaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi i
                    %annotation{:encoding => "application/x-tex"} K_i
              %a.existingWikiWord{:href => "/nlab/show/subsets+are+closed+in+a+closed+subspace+precisely+if+they+are+closed+in+the+ambient+space"} subsets are closed in a closed subspace precisely if they are closed in the ambient space
              (lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#SubsetsInClosedSubspace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V_j)
              are also closed as subsets of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi i
                    %annotation{:encoding => "application/x-tex"} K_i
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets+of+compact+spaces+are+compact"} closed subsets of compact spaces are compact
              (lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubsetsOfCompactSpacesAreCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V_j)
              are themselves compact and hence form a locally finite cover by compact subspaces.
            %p
              Now fix any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mn 0
                      %mo ∈
                      %mi J
                    %annotation{:encoding => "application/x-tex"} j_0 \in J
            %p
              We claim that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j \in J
              there is a finite sequence of indices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi j
                      %mn 0
                    %mo ,
                    %msub
                      %mi j
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi j
                      %mi n
                    %mo ,
                    %msub
                      %mi j
                      %mi n
                    %mo =
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (j_0, j_1, \cdots, j_n, j_{n} = j)
              with the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %msub
                          %mi j
                          %mi k
                    %mo ∩
                    %msub
                      %mi V
                      %mrow
                        %msub
                          %mi j
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} V_{j_k} \cap V_{j_{k+1}} \neq \emptyset
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} k \in \{0, \cdots, n\}
            %p
              To see this, first observe that it is sufficient to show sigma-compactness for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/countable+unions+of+countable+sets+are+countable"} countable unions of countable sets are countable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is connected. It follows from prop.
              %a.maruku-ref{:href => "#PathConnectedFromConnectedLocallyEuclideanSpace"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
            %p
              Hence for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi V
                      %mrow
                        %msub
                          %mi j
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} x \in V_{j_0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} y \in V_{j}
              there is a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma \colon [0,1] \to X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Path"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              is compact (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactClosedInterval"}
              %a.existingWikiWord{:href => "/nlab/show/continuous+images+of+compact+spaces+are+compact"} continuous images of compact spaces are compact
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#ContinuousImageOfACompactSpaceIsCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V_i
              that covers the image of this path. This proves the claim.
            %p It follows that there is a function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒱
                    %mo ⟶
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; \mathcal{V} \longrightarrow \mathbb{N}
            %p
              which sends each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j
              to the
              %a.existingWikiWord{:href => "/nlab/show/minimum"} minimum
              natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              as above.
            %p
              We claim now that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1, \cdots, n\}
              under this function is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %a.existingWikiWord{:href => "/nlab/show/countable+unions+of+countable+sets+are+countable"} countable unions of countable sets are countable
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              serves as a countable enumeration of the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              and hence implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{ Cl(V_j) \subset X\}_{j \in J}
              is a countable cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by compact subspaces, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is sigma-compact.
            %p
              We prove this last claim by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              by construction, since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi j
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} f^{-1}(\{0\}) = V_{j_0}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(\{0,1, \cdots, n\})
              is a finite set. Since finite unions of compact subspaces are again compact (example
              = succeed ")" do
                %a.maruku-ref{:href => "#UnionsAndIntersectionOfCompactSubspaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi n
                    %mo ≔
                    %munder
                      %mo ∪
                      %mrow
                        %mi V
                        %mo ∈
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K_n
                    \\coloneqq
                    \\underset{V \in f^{-1}(\{0,\cdots, n\})}{\cup} Cl(V)
            %p
              is compact. By local finiteness of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi j
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                    %annotation{:encoding => "application/x-tex"} \{Cl(V_j)\}_{j \in J}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi K
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in K_n
              has an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi x
                  %annotation{:encoding => "application/x-tex"} W_x
              that intersects only a finite set of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cl(V_j)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi n
                    %annotation{:encoding => "application/x-tex"} K_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mi x
                    %mo ∩
                    %msub
                      %mi K
                      %mi nfGi
                    %mo ⊂
                    %msub
                      %mi K
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi K
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \{W_x \cap K_nfGi \subset K_n\}_{x \in K_n}
              has a finite subcover. In conclusion this implies that only a finite number of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j
              intersect
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi n
                    %annotation{:encoding => "application/x-tex"} K_n
            %p
              Now by definition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(\{0,1,\cdots, n+1\})
              is a subset of those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j
              which intersect
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi n
                    %annotation{:encoding => "application/x-tex"} K_n
          %p This finally gives a good idea of what the definition of topological manifolds should be:
          #TopologicalManifold.num_defn
            %h6#definition_75 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"}> topological manifold
                )
            %p
              A
              %em
                topological manifold is a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                which is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/locally+Euclidean+topological+space"} locally Euclidean
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#LocallyEuclideanSpace"}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+topological+space"} paracompact Hausdorff
                  (def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#HausdorffTopologicalSpace"}
                  = succeed ")." do
                    %a.maruku-ref{:href => "#ParacompactSpace"}
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/neighbourhoods"} neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \overset{\simeq}{\to} U_x \subset X
              of the points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              are all of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-fold\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          .num_remark
            %h6#remark_31 Remark
            %p
              %strong (varying terminology regarding “topological manifold”)
            %p
              Often a
              %em topological manifold
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalManifold"}
              %a.existingWikiWord{:href => "/nlab/show/second-countable+topological+space"} second-countable
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CountableSecond"}
              %a.existingWikiWord{:href => "/nlab/show/sigma-compact"} sigma-compact
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompactSigma"}
              %a.maruku-ref{:href => "#RegularityConditionsForTopologicalManifoldsComparison"}
              both conditions are implied by def.
              %a.maruku-ref{:href => "#TopologicalManifold"}
              as soon as there is a
              %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable set
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            %ol
              %li
                %p
                  the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Whitney+embedding+theorem"} Whitney embedding theorem
              %li
                %p
                  the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds+into+formal+duals+of+R-algebras"} embedding of smooth manifolds into formal duals of R-algebras
          %p
            Besides the trivial case of
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            themselves, we discuss here three main classes of
            %strong examples
            of manifolds:
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^n
                (example
                %a.maruku-ref{:href => "#SmoothManifoldnSphere"}
                below)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/projective+spaces"} projective spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k P^n
                (example
                %a.maruku-ref{:href => "#SmoothManifoldRealComplexProjectiveSpace"}
                below)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/general+linear+groups"} general linear groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(n,k)
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#SmoothManifoldGeneralLinearGroup"}
          %p
            Since all these examples are not just
            %a.existingWikiWord{:href => "/nlab/show/topological+manifolds"} topological manifolds
            but naturally carry also the structure of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
          #Charts.num_defn
            %h6#definition_76 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+chart"}> local chart
                ,
                %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/gluing+function"} gluing function
            %p
              Given an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicalManifold"}
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/ChartsOfAManifold.png", :width => "400"}/
            %ol
              %li
                %p
                  An
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \subset X
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mi n
                        %mover
                          %mo →
                          %mrow
                            %mphantom
                              %mi A
                            %mo ≃
                            %mphantom
                              %mi A
                        %mi U
                      %annotation{:encoding => "application/x-tex"} \phi \colon \mathbb{R}^n \overset{\phantom{A}\simeq\phantom{A}}{\to} U
                  from the
                  = succeed "-dimensional" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  is also called a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/local+coordinate+chart"} local coordinate chart
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  An
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  by local charts
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msup
                              %mi ℝ
                              %mi n
                            %munderover
                              %mo →
                              %mo ≃
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi i
                            %mi U
                            %mo ⊂
                            %mi X
                            %mo }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \left\{ \mathbb{R}^n \underoverset{\simeq}{\phi_i}{\to} U \subset X \right\}_{i \in I}
                  is called an
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                  of the topological manifold.
              %li
                %p
                  Given such an
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                  then for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i,j \in I
                  the induced homeomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ⊃
                        %mphantom
                          %mi AA
                        %msubsup
                          %mi ϕ
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi A
                            %msub
                              %mi ϕ
                              %mi i
                            %mphantom
                              %mi A
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi A
                            %msubsup
                              %mi ϕ
                              %mi j
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mphantom
                              %mi A
                        %msubsup
                          %mi ϕ
                          %mi j
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mphantom
                          %mi AA
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{R}^n
                        \\supset
                        \\phantom{AA}
                        \\phi_i^{-1}(U_i \cap U_j)
                        \\overset{\phantom{A}\phi_i\phantom{A}}{\longrightarrow}
                        U_i \cap U_j
                        \\overset{\phantom{A}\phi_j^{-1}\phantom{A}}{\longrightarrow}
                        \\phi_j^{-1}(U_i \cap U_j)
                        \\phantom{AA}
                        \\subset
                        \\mathbb{R}^n
                %p
                  is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/coordinate+transformation"} coordinate transformation
                  or
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/gluing+function"} gluing function
                  from chart
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  to chart
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
            %blockquote
              %p
                graphics grabbed from
                %a.existingWikiWord{:href => "/nlab/show/The+Geometry+of+Physics+-+An+Introduction"} Frankel
          %p
            Next we consider the case that the gluing functions of a topological manifold are
            %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
            in which case one speaks of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
            (def.
            %a.maruku-ref{:href => "#DifferentiableManifold"}
            below). For convenience we first recall the definition of
            %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
            between
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
          #DifferentiableFunctionBetweenCartesianSpaces.num_defn
            %h6#definition_77 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                between
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U \subset \mathbb{R}^n
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#EuclideanNorm"}
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; U \longrightarrow \mathbb{R}
              is called
              %strong differentiable
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x\in U
              if there exists a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                    %mo :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} d f_x : \mathbb{R}^n \to \mathbb{R}
              such that the following
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              exists and vanishes as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              approaches zero “from all directions at once”:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi h
                        %mo →
                        %mn 0
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi d
                        %msub
                          %mi f
                          %mi x
                        %mo{:stretchy => "false"} (
                        %mi h
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi h
                        %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lim_{h\to 0} \frac{f(x+h)-f(x) - d f_x(h)}{\Vert h\Vert} = 0.
            %p
              This means that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon \in (0,\infty)
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi x
                    %mo ⊆
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V_x\subseteq U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo +
                    %mi h
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x+h\in V
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo +
                          %mi h
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi d
                          %msub
                            %mi f
                            %mi x
                          %mo{:stretchy => "false"} (
                          %mi h
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi h
                          %mo{:stretchy => "false"} ‖
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \frac{f(x+h)-f(x) - d f_x(h)}{\Vert h\Vert} \lt \epsilon
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em differentiable on
              a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is differentiable at every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} x\in S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em differentiable
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is differentiable on all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em continuously differentiable
              if it is differentiable and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %p
              The function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                  %annotation{:encoding => "application/x-tex"} d f_x
              is called the
              %strong derivative
              or
              = succeed "." do
                %strong
                  differential of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
            %p
              More generally, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2 \in \mathbb{N}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} U\subseteq \mathbb{R}^{n_1}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; U \longrightarrow \mathbb{R}^{n_2}
              is
              %em differentiable
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i \in \{1, \cdots, n_2\}
              the component function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mover
                      %mo ⟶
                      %mi f
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi pr
                          %mi i
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f_i \;\colon\; U \overset{f}{\longrightarrow} \mathbb{R}^{n_2} \overset{pr_i}{\longrightarrow}  \mathbb{R}
            %p is differentiable in the previous sense
            %p
              In this case, the derivatives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} d f_i \colon \mathbb{R}^n \to \mathbb{R}
              of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              assemble into a linear map of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d f_x \;\colon\; \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                    \\,.
            %p
              If the derivative exists at each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} x \in U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %msub
                      %mi Hom
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ,
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ⋅
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    d f \;\colon\; U \longrightarrow Hom_{\mathbb{R}}(\mathbb{R}^{n_1} , \mathbb{R}^{n_2}) \simeq \mathbb{R}^{n_1 \cdot n_2}
            %p
              to the space of
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %em twice continuously differentiable
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d f
              is continuously differentiable.
            %p
              Generally then, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is called
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-fold continuously differentiable
              or
              %em
                of class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi k
                    %annotation{:encoding => "application/x-tex"} C^k
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} j \leq k
              the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mi j
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d^j f
              exists and is a continuous function.
            %p
              Finally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              then it is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              or
              = succeed "." do
                %em
                  of class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            Of the various properties satisfied by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
            %a.maruku-ref{:href => "#TangentBundle"}
            below):
          #ChainRuleOnEuclideanSpace.num_prop
            %h6#proposition_82 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
                for
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                between
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ,
                    %msub
                      %mi n
                      %mn 3
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2, n_3 \in \mathbb{N}
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mover
                      %mo ⟶
                      %mi f
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mover
                      %mo ⟶
                      %mi g
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{n_1}
                    \\overset{f}{\longrightarrow}
                    \\mathbb{R}^{n_2}
                    \\overset{g}{\longrightarrow}
                    \\mathbb{R}^{n_3}
            %p
              be two
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DifferentiableFunctionBetweenCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              of their
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              is the composite of their derivatives:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mo =
                    %mi d
                    %msub
                      %mi g
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi d
                    %msub
                      %mi f
                      %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d(g \circ f)_x = d g_{f(x)} \circ d f_x
                    \\,.
          #DifferentiableManifold.num_defn
            %h6#definition_78 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N} \cup \{\infty\}
              then a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %em
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              or
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi p
                    %annotation{:encoding => "application/x-tex"} C^p
                \-manifold
              for short is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#TopologicalManifold"}
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi ℝ
                          %mi n
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^n \overset{\phi_i}{\to} X\}
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Charts"}
                  %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
                  are
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  times continuously
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable
            %p
              A
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              between
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
