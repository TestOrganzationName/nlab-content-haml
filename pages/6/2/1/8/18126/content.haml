              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi z
                  %annotation{:encoding => "application/x-tex"} \gamma_2(1) = z
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⇝
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} pahntom
                        %mi A
                        %msub
                          %mi γ
                          %mn 1
                        %mphantom
                          %mi A
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi γ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⇝
                      %mrow
                        %mphantom
                          %mi A
                        %msub
                          %mi γ
                          %mn 2
                        %mphantom
                          %mi A
                    %msub
                      %mi γ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma_1(x) \overset{\pahntom{A}\gamma_1\phantom{A}}{\rightsquigarrow} \gamma_1(1) = \gamma_2(0) \overset{ \phantom{A}\gamma_2\phantom{A} }{\rightsquigarrow} \gamma_2(1)
            %p consider the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
