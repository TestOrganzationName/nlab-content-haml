          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            %a.existingWikiWord{:href => "/nlab/show/extreme+value+theorem"} extreme value theorem
            (example
            %a.maruku-ref{:href => "#ExtremeValueTheorem"}
            below) asserts that a
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            on the
            %a.existingWikiWord{:href => "/nlab/show/bounded+subset"} bounded
            %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#OpenAndClosedIntervals"}
            %a.existingWikiWord{:href => "/nlab/show/maximum"} maximum
            and
            = succeed "." do
