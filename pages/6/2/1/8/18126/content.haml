              between
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
            %ol
              %li
                %p
                  the underlying
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding of topological spaces
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#EmbeddingOfTopologicalSpaces"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/immersion+of+smooth+manifolds"} immersion
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#Immersion"}
            %p
              A
              %em closed embedding
              is an embedding such that the image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
