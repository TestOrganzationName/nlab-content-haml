                      %msub
                        %mi U
                        %mrow
                          %mi r
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} x \in U_{r'}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
