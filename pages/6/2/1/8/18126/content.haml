              which is a function over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              it it the linear inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi x
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi x
                    %annotation{:encoding => "application/x-tex"} (f\vert_x)^{-1} \colon (E_2)_x \to (E_1)_x
            %p What we need to show is that this is a continuous function.
            %p
              By remark
              %a.maruku-ref{:href => "#CommonOpenCoverLocalTrivialization"}
              we find an open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              over which both bundles have a local trivialization.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ U_i \underoverset{\simeq}{\phi^1_i}{\to} (E_1)\vert_{U_i}\right\}_{i \in I}
                    \\phantom{AA}
                    \\text{and}
                    \\phantom{AA}
                    \\left\{ U_i \underoverset{\simeq}{\phi^2_i}{\to} (E_2)\vert_{U_i} \right\}_{i \in I}
                    \\,.
            %p
              Restricted to any patch
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              of this cover, the homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                  %annotation{:encoding => "application/x-tex"} f|_{U_i}
              induces a homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo ≔
                    %msubsup
                      %mi ϕ
                      %mi j
                      %mn 2
                    %msup
                      %mo
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi f
                    %mo ∘
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mn 1
                    %mphantom
                      %mi AAAAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi i
                                  %mn 1
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi f
                                  %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mrow
                                      %msub
                                        %mi U
                                        %mi i
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi i
                                  %mn 2
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_i \coloneqq \phi^2_j^{-1} \circ f \circ \phi^1_i
                    \\phantom{AAAAAA}
                    \\array{
                    U_i \times k^n &amp;\underoverset{\simeq}{\phi^1_i}{\longrightarrow}&amp; (E_1)\vert|_{U_i}
                    \\\
                    {}^{f_i}\downarrow &amp;&amp; \downarrow^{\mathrlap{f\vert_{U_i}}}
                    \\\
                    U_i \times k^n &amp;\underoverset{\phi^2_i}{\simeq}{\longrightarrow}&amp; (E_2)\vert_{U_j}
                    }
                    \\,.
            %p
              Also the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              are fiberwise invertible, hence are continuous bijections. We claim that these are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (f_i)^{-1}
              are also continuous.
            %p
              To this end we re-write the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              a little. First observe that by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              and since they fix the base space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              are equivalently given by a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo ⟶
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    h_i \;\colon\; U_i \times k^n \longrightarrow k^n
            %p as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi h
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_i(x,v) = (x, h_i(x,v))
                    \\,.
            %p
              Moreover since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              (as every
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              says (by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#UniversalPropertyOfMappingSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi h
                        %mo{:stretchy => "false"} ˜
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ⟶
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo ,
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde h_i
                    \\;\colon\;
                    U_i \longrightarrow Maps(k^n, k^n)
            %p
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo ,
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Maps(k^n,k^n)
              the set of continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                    %mo →
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n \to k^n
              equipped with the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi i
                  %annotation{:encoding => "application/x-tex"} h_i
              via the
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              map as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mover
                            %mi h
                            %mo{:stretchy => "false"} ˜
                          %mi i
                        %mo ×
                        %msub
                          %mi id
                          %mrow
                            %msup
                              %mi k
                              %mi n
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo ,
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo ⟶
                      %mi ev
                    %msup
                      %mi k
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h_i
                    \\;\colon\;
                    U_i \times k^n
                    \\overset{\tilde h_i \times id_{k^n}}{\longrightarrow}
                    Maps(k^n, k^n) \times k^n
                    \\overset{ev}{\longrightarrow}
                    k^n
                    \\,.
            %p
              By assumption of fiberwise linearity the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi h
                        %mo{:stretchy => "false"} ˜
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \tilde h_i
              in fact take values in the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo ,
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    GL(n,k) \subset Maps(k^n, k^n)
            %p
              and this inclusion is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              onto its image (by
              = succeed ")." do
                %a{:href => "general+linear+group#AsSubspaceOfTheMappingSpace"} this prop.
            %p
              Since passing to
              %a.existingWikiWord{:href => "/nlab/show/inverse+matrices"} inverse matrices
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{-1} \;\colon\; GL(n,k) \longrightarrow GL(n,k)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/rational+function"} rational function
              on its domain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi k
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n,k) \subset Mat_{n \times n}(k) \simeq k^{(n^2)}
              inside
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              and since
              %a.existingWikiWord{:href => "/nlab/show/rational+functions+are+continuous"} rational functions are continuous
              on their domain of definition, it follows that the inverse of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %msub
                          %mover
                            %mi h
                            %mo{:stretchy => "false"} ˜
                          %mi i
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo ×
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo ×
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mo ×
                        %mi ev
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    (f_i)^{-1}
                    \\;\colon\;
                    U_i \times k^n
                    \\overset{(id  , \tilde h_i )  }{\longrightarrow}
                    U_i \times k^n \times GL(n,k)
                    \\overset{ id  \times (-)^{-1} }{\longrightarrow}
                    U_i \times k^n \times GL(n,k)
                    \\overset{id  \times ev}{\longrightarrow}
                    U_i \times k^n
            %p is a continuous function.
            %p
              To conclude that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              is a continuous function we make use prop.
              %a.maruku-ref{:href => "#FromTransitionFunctionsReconstructVectorBundle"}
              to find an isomorphism between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
              and a
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo ⊔
                        %mrow
