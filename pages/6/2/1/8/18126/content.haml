              from example
              = succeed "." do
                %a.maruku-ref{:href => "#BinaryProductTopologicalSpace"}
              %a.maruku-ref{:href => "#ProjectionsAreOpenContinuousFunctions"}
              the two
              %a.existingWikiWord{:href => "/nlab/show/projections"} projections
              out of the product space are
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
