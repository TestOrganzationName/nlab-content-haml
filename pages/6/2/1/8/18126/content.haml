                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} q_i \colon X_i \longrightarrow (S,\tau_{final}(\{f_i\}_{i \in I}))
                  are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                %p
                  Hence a subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊂
                        %mi S
                      %annotation{:encoding => "application/x-tex"} U \subset S
                  is open in the final topology precisely if for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i \in I
                  then the
                  %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi q
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
