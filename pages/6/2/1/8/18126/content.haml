          #SmoothManifoldsEmbedding.num_defn
            %h6#definition_88 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"}> embedding of smooth manifolds
                )
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo ↪
                    %mi Y
