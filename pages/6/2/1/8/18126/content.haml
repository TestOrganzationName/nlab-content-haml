                    %annotation{:encoding => "application/x-tex"} (-\pi,\pi)
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "https://books.google.de/books?id=xygVcKGPsNwC=PP1=PA86=y#v=onepage=false"} Lee
          #ProperInjectiveImmersionsAreEquivalentlyTheClosedEmbeddings.num_prop
            %h6#proposition_84 Proposition
            %p
              %strong (proper injective immersions are equivalently the closed embeddings)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper
                  %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective
                  %a.existingWikiWord{:href => "/nlab/show/immersion"} immersion
                  (def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#ProperContinuous"}
                  = succeed ");" do
                    %a.maruku-ref{:href => "#Immersion"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is a closed
                  %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding of smooth manifolds
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#SmoothManifoldsEmbedding"}
          .proof
            %h6#proof_124 Proof
            %p
              Since topological manifolds are
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+spaces"} locally compact topological spaces
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#LocalPropertiesOfLocallyEuclideanSpace"}
              %a.existingWikiWord{:href => "/nlab/show/injective+proper+maps+to+locally+compact+spaces+are+equivalently+the+closed+embeddings"} injective proper maps to locally compact spaces are equivalently the closed embeddings
              by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#InjectiveProperMapsAreEquivalentlyTheClosedEmbeddings"}
          %p
            We now turn to the construction of
            %a.existingWikiWord{:href => "/nlab/show/embeddings+of+smooth+manifolds"} embeddings of smooth manifolds
            into
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            (prop.
            %a.maruku-ref{:href => "#CompactManifoldEmbedsIntoLargeDimensionalEuclideanSpace"}
            and remark
            %a.maruku-ref{:href => "#EmbeddingWhitney"}
            below). To that end we need to consider
            %em smooth
            partitions of unity, which we discuss now (prop.
            %a.maruku-ref{:href => "#SmoothManifoldAdmitsSmoothPartitionsOfUnity"}
            below).
          %p
            Since manifolds by definition are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+spaces"} paracompact Hausdorff spaces
            %a.existingWikiWord{:href => "/nlab/show/partitions+of+unity"} partitions of unity
            by continuous functions (by prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#ParacompactHausdorffEquivalentToexistenceOfParititionsOfUnity"}
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            even admit partitions of unity by
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth
                %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
          #BumpFunction.num_defn
            %h6#definition_89 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/bump+function"}> bump function
                )
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              on
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{R}
              with values in the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    b
                    \\;\colon\;
                    \\mathbb{R}^n
                    \\longrightarrow
                    \\mathbb{R}
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  is
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#DifferentiableFunctionBetweenCartesianSpaces"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  has
                  %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#PartitionOfUnity"}
          %p The main point of interest about bump functions is that they exist, their precise form is usually not of interest. Here is one of many ways to obtain examples:
          #SomeBumpFunctions.num_example
            %h6#example_133 Example
            %p
              %strong
                (a class of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/closed+ball"} closed ball
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mrow
                        %msub
                          %mi x
                          %mn 0
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo −
                      %msub
                        %mi x
                        %mn 0
                      %mo{:stretchy => "false"} ‖
                    %mo ≤
                    %mi ϵ
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_{x_0}(\epsilon) = \{x \in \mathbb{R}^n \,\vert\, {\Vert x - x_0 \Vert} \leq \epsilon\} \subset \mathbb{R}^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBalls"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b \colon \mathbb{R}^n \to \mathbb{R}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BumpFunction"}
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Supp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Cl
                    %mrow
                      %mo (
                      %msup
                        %mi b
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} Supp(b) \coloneqq Cl\left( b^{-1}( (0,\infty) ) \right)
              being that closed ball:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Supp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi B
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Supp(b) = B_x(\epsilon)
                    \\,.
          .proof
            %h6#proof_125 Proof
            %p Consider the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; \mathbb{R}^n \longrightarrow \mathbb{R}
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi exp
                              %mrow
                                %mo (
                                %mfrac
                                  %mn 1
                                  %mrow
                                    %msup
                                      %mrow
                                        %mo{:stretchy => "false"} ‖
                                        %mi x
                                        %mo{:stretchy => "false"} ‖
                                      %mn 2
                                    %mo −
                                    %mn 1
                                %mo )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mrow
                                %mo{:stretchy => "false"} ‖
                                %mi x
                                %mo{:stretchy => "false"} ‖
                              %mo &lt;
                              %mn 1
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi(x)
                    \\;\coloneqq\;
                    \\left\{
                    \\array{
                    \\exp\left(
                    \\frac{1}{{\Vert x \Vert}^2 - 1}
                    \\right)
                    \&amp; \vert &amp; { \Vert x \Vert} \lt 1
                    \\\
                    0 &amp;\vert &amp; \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p
              By construction the
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              of this function is the closed unit ball at the origin,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Supp
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi B
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Supp(\phi) = B_0(1)
            %p
              We claim that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is smooth. That it is smooth away from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≔
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r \coloneqq {\Vert x \Vert} = 0
              is clear, hence smoothness only need to be checked at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} r = 0
              %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
              of the exponential function vanish as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} r \to 0
            %p But that is the case since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi r
                    %mrow
                      %mo (
                      %mi exp
                      %mrow
                        %mo (
                        %mfrac
                          %mn 1
                          %mrow
                            %msup
                              %mi r
                              %mn 2
                            %mo −
                            %mn 1
                        %mo )
                      %mo )
                    %mo =
                    %mfrac
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 2
                        %mi r
                      %mrow
                        %msup
                          %mrow
                            %mo (
                            %msup
                              %mi r
                              %mn 2
                            %mo −
                            %mn 1
                            %mo )
                          %mn 2
                    %mi exp
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mrow
                          %msup
                            %mi r
                            %mn 2
                          %mo −
                          %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d r}
                    \\left(
                    \\exp\left(
                    \\frac
                    {1}
                    {
                    r^2 - 1
                    }
                    \\right)
                    \\right)
                    \=
                    \\frac{
                    \-2 r
                    }
                    {
                    \\left( r^2 - 1 \right)^2
                    }
                    \\exp\left(
                    \\frac
                    {1}
                    {
                    r^2 - 1
                    }
                    \\right)
                    \\,.
            %p
              This clearly tends to zero as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} r \to 1
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              to see that this tends to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              as
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} r \to 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mrow
                            %mo (
                            %mn 1
                            %mo −
                            %msup
                              %mi r
                              %mn 2
                            %mo )
                          %mn 2
                      %mrow
                        %mn 2
                        %mi r
                    %mi exp
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 1
                          %mo −
                          %msup
                            %mi r
                            %mn 2
                      %mo )
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo !
                    %mfrac
                      %mrow
                        %msup
                          %mrow
                            %mo (
                            %mn 1
                            %mo −
                            %msup
                              %mi r
                              %mn 2
                            %mo )
                          %mn 2
                      %mrow
                        %mn 2
                        %mi r
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo −
                        %msup
                          %mi r
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{
                    \\left( 1- r^2  \right)^2
                    }
                    {
                    2 r
                    }
                    \\exp\left(
                    \\frac
                    {1}
                    {
                    1- r^2
                    }
                    \\right)
                    \=
                    \\sum_{n = 0}^\infty
                    \\frac{1}{n!}
                    \\frac{
                    \\left( 1- r^2  \right)^2
                    }
                    {
                    2 r
                    }
                    \\frac{1}
                    {
                    (1- r^2)^n
                    }
            %p
              The form of the higher derivatives is the same but with higher inverse powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi r
                      %mn 2
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (r^2 -1)
              and so this conclusion remains the same for all derivatives. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is smooth.
            %p
              Now for arbitrary radii
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \varepsilon \gt 0
              define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi ε
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} /
                    %mi ε
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_\varepsilon(x) \coloneqq \phi(x/\varepsilon)
                    \\,.
            %p
              This is clearly still smooth and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϕ
                        %mi ε
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi B
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Supp(\phi_{\varepsilon}) = B_0(\epsilon)
            %p
              Finally the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %msub
                      %mi ϕ
                      %mi ε
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \mapsto \phi_\varepsilon(x-x_0)
              has support the closed ball
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mrow
                          %msub
                            %mi x
                            %mn 0
                      %mo{:stretchy => "false"} (
                      %mi ε
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B_{x_0}(\varepsilon)
          %p
            We want to say that a smooth manifold admits subordinate partitions of unity by bump functions (prop.
            %a.maruku-ref{:href => "#SmoothManifoldAdmitsSmoothPartitionsOfUnity"}
            below). To that end we first need to see that it admits refinements of covers by closed balls.
          #SmoothManifoldClosedBallRefinementOfCover.num_lemma
            %h6#lemma_33 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                admits
                %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
                by
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+balls"} closed balls
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentiableManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi B
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϵ
                          %mi j
                        %mo{:stretchy => "false"} )
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msub
                              %mi ψ
                              %mi j
                        %msub
                          %mi V
                          %mi j
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    B_0(\epsilon_j)
                    \\underoverset{\simeq}{\psi_j}{\to}
                    V_j
                    \\subset
                    X
                    \\right\}_{i \in J}
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              with each patch
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/closed+ball"} closed ball
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBalls"}
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
          .proof
            %h6#proof_126 Proof
            %p
              First consider the special case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompactTopologicalSpace"}
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msup
                        %mi ℝ
                        %mi n
                      %munderover
                        %mo ⟶
                        %mo ≃
                        %mrow
                          %msub
                            %mi ϕ
                            %mi j
                      %msub
                        %mi V
                        %mi j
                      %mo ⊂
                      %mi X
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\mathbb{R}^n
                    \\underoverset{\simeq}{\phi_j}{\longrightarrow}
                    V_j
                    \\subset X
                    \\right\}
            %p
              be a smooth
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              representing the
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothStructure"}
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              by patches which are
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to standard
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi V
                          %mi j
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_i \cap V_j
                    \\right\}_{i \in I, j \in J}
            %p
              still form an open cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j \in J
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi V
