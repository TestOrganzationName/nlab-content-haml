                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi V
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{x\} \subset V \subset Cl(V) \subset U
                    \\,.
          %p
            The
            %strong proof
            of prop.
            %a.maruku-ref{:href => "#T3InTermsOfTopologicalClosures"}
            is the direct specialization of the following proof for prop.
            %a.maruku-ref{:href => "#T4InTermsOfTopologicalClosures"}
            to the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} C = \{x\}
            (using that by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} T_3
            = succeed ")." do
              %a.maruku-ref{:href => "#T1InTermsOfTopologicalClosure"}
          #T4InTermsOfTopologicalClosures.num_prop
            %h6#proposition_21 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} T_4
                in terms of topological closures)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is
              %a.existingWikiWord{:href => "/nlab/show/normal+Hausdorff+space"} normal Hausdorff space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#NormalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C \subset X
              with
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊃
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \supset C
              there exists a smaller open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊃
                    %mi C
                  %annotation{:encoding => "application/x-tex"} V \supset C
              whose
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V)
              is still contained in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi V
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C \subset V \subset Cl(V) \subset U
                    \\,.
          .proof
            %h6#proof_21 Proof
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is normal, and consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C \subset U
                    \\,.
            %p
              It follows that the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is closed and disjoint from
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∩
                    %mi X
                    %mo ∖
                    %mi U
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C \cap X \setminus U = \emptyset
                    \\,.
            %p
              Therefore by assumption of normality of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\tau)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊃
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %mi W
                    %mo ⊃
                    %mi X
                    %mo ∖
                    %mi U
                    %mphantom
                      %mi AA
                    %mtext with
                    %mphantom
                      %mi AA
                    %mi V
                    %mo ∩
                    %mi W
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V \supset C
                    \\,, \phantom{AA}
                    W \supset X \setminus U
                    \\phantom{AA}
                    \\text{with}
                    \\phantom{AA}
                    V \cap W = \emptyset
                    \\,.
            %p But this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mi X
                    %mo ∖
                    %mi W
                  %annotation{:encoding => "application/x-tex"}
                    V \subset X \setminus W
            %p
              and since the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi W
                  %annotation{:encoding => "application/x-tex"} X \setminus W
              of the open set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is closed, it still contains the closure of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi V
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %mo ∖
                    %mi W
                    %mo ⊂
                    %mi U
                  %annotation{:encoding => "application/x-tex"}
                    C \subset V \subset Cl(V) \subset X \setminus W \subset U
            %p as required.
            %p
              In the other direction, assume that for every open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊃
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \supset C
              of a closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              there exists a smaller open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi V
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C \subset V \subset Cl(V) \subset U
                    \\,.
            %p Consider disjoint closed subsets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %msub
                      %mi C
                      %mn 2
                    %mo ⊂
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AAA
                    %msub
                      %mi C
                      %mn 1
                    %mo ∩
                    %msub
                      %mi C
                      %mn 2
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_1, C_2 \subset X
                    \\,,
                    \\phantom{AAA}
                    C_1 \cap C_2 = \emptyset
                    \\,.
            %p We need to produce disjoint open neighbourhoods for them.
            %p From their disjointness it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %msub
                      %mi C
                      %mn 2
                    %mo ⊃
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    X \setminus C_2 \supset C_1
            %p
              is an open neighbourhood. Hence by assumption there is an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊂
                    %mi V
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %mo ∖
                    %msub
                      %mi C
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_1 \subset V \subset Cl(V) \subset X \setminus C_2
                    \\,.
            %p Thus
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊃
                    %msub
                      %mi C
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AAAA
                    %mi X
                    %mo ∖
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊃
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    V \supset C_1
                    \\,, \phantom{AAAA}
                    X \setminus Cl(V) \supset C_2
            %p are two disjoint open neighbourhoods, as required.
          %p
            But the
            = succeed "/normality" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} T_4
            %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+spaces"} paracompact topological spaces
            = succeed ":" do
              %a{:href => "#ParacompactSpaces"} below
          %p
            The following concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/Urysohn+functions"} Urysohn functions
            is another approach of thinking about separation of subsets in a topological space, not in terms of their neighbourhoods, but in terms of continuous real-valued “indicator functions” that take different values on the subsets. This perspective will be useful when we consider
            %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+spaces"} paracompact topological spaces
            = succeed "." do
              %a{:href => "#ParacompactSpaces"} below
          %p
            But the
            %a.existingWikiWord{:href => "/nlab/show/Urysohn+lemma"} Urysohn lemma
            (prop.
            %a.maruku-ref{:href => "#UrysohnLemma"}
            below) implies that this concept of separation is in fact equivalent to that of normality of Hausdorff spaces.
          #UrysohnFunction.num_defn
            %h6#definition_27 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Urysohn+function"}> Urysohn function
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              be disjoint
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %em
                Urysohn function separating
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              is
            %ul
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
