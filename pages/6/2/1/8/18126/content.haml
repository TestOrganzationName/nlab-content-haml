                                %msub
                                  %mi i
                                  %mn 1
                            %mo ∪
                            %msub
                              %mi U
                              %mrow
                                %msub
                                  %mi i
                                  %mn 2
                            %mo ∪
                            %mi ⋯
                            %mo ∪
                            %msub
                              %mi U
                              %mrow
                                %msub
                                  %mi i
                                  %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi U
