                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\lambda_X \;\colon\; \ast \times (X, \tau_X)  \overset{\phantom{AA}\simeq\phantom{AA}}{\longrightarrow} (X,\tau_X)
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mi X
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mo *
                        %mover
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %mo ≃
                            %mphantom
                              %mi AA
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mi X
