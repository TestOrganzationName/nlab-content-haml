                %a.existingWikiWord{:href => "/nlab/show/compact+spaces"} compact spaces
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{(X_i, \tau_i)\}_{i \in I}
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
