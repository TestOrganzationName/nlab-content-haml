          %h2#idea Idea
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            a
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
            whose objects we think of as
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/space"} space
            %strong
              tangent
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mrow
                      %msup
                        %mi K
                        %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"}
                  (T_{K^{op}})^{op} \to K
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %strong
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
              thickenings
            of those of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            More concretely, the tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} T_C \to C
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %msup
                    %mi K
                    %mi op
                %annotation{:encoding => "application/x-tex"} C = K^{op}
            is the fiberwise
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            of the
            %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Func(\Delta[1], C) \to C
          %p
            This generalizes – as discussed at
            %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation theory
            – the classical example of the
            %a.existingWikiWord{:href => "/nlab/show/bifibration"} bifibration
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo →
                %annotation{:encoding => "application/x-tex"} \to
            %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            of the category of all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
            %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            of all commutative rings:
          %p
            the fiber of the tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi C
                %annotation{:encoding => "application/x-tex"} T_C
            over an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} A \in C
            may be thought of as the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %strong square-0-extensions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊕
                  %mi N
                %annotation{:encoding => "application/x-tex"} A \oplus N
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo =
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} K = C^{op}
            we may think of these as being infinitesimal neighbourhoods of 0-sections of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
            – over whatever
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is regarded to be the algebra of functions on.
          %p
            A remarkable amount of information about the geometry of these spaces/objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is encoded in the fiber of the tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo :
                  %mi C
                  %mo →
                  %msub
                    %mi T
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\Omega : C \to T_C
          %p
            to the domain projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dom
                  %mo :
                  %msub
                    %mi T
                    %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} dom : T_C \to C
            turns out to send each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to its
            %a.existingWikiWord{:href => "/nlab/show/cotangent+complex"} cotangent complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega(A)
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differentials"} Kähler differentials
            on the space that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is functions on.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} 1-categorical
            approximation to the notion of tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tangent+category"} tangent category
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
          #FiberwiseStabilization.num_defn
            %h6#definition_2 Definition
            %p
              %strong (fiberwise stabilization)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ′
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}' \to \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} categorical fibration
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %strong fiberwise stabilization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ′
                    %mo →
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab(\mathcal{C}' \to \mathcal{C})
              is – roughly – the fibration universal with the property that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \in C
              its
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo ′
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab(\mathcal{C}'_A)
              of the fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %msub
                      %mo ′
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}'_A
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, section 1.1
            ) formulated in view of (
            %a{:href => "#Lurie"}> Lurie, remark 1.1.8
            ). There
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ′
                  %mo →
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab(\mathcal{C}' \to \mathcal{C})
            is called the
            %em stable envelope
            \.
          #TangentCategory.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (tangent
                = succeed "-category)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
            %p
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} The
              %strong
                tangent
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi 𝒞
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} T_{\mathcal{C}} \to \mathcal{C}
              is
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %em fiberwise stabilization
              of the
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cod
                      %mo :
                      %msup
                        %mi 𝒞
                        %mrow
                          %msup
                            %mi Δ
                            %mn 1
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} cod : \mathcal{C}^{\Delta^1} \to \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi 𝒞
                    %mover
                      %mo →
                      %mi p
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi cod
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (T_{\mathcal{C}} \stackrel{p}{\to} \mathcal{C}) := Stab(Func(\Delta[1], \mathcal{C}) \stackrel{cod}{\to} \mathcal{C}  )
                    \\,.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Deformation+Theory"} DT, def 1.1.12
          %p
            For a maybe more explicit definition see below at
            = succeed "." do
              %em
                %a{:href => "#TangentToposGeneral"} Tangent ∞-topos – General
          %p
            Explicitly, the tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          #TangentCatByExplicitFiberwiseStabilization.num_remark
            %h6#remark Remark
            %p
              Given a presentable
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi cod
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_{cod} \colon \mathcal{C}^{op} \to (\infty,1)Cat
            %p
              which classifies the
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} cod \colon \mathcal{C}^{\Delta^1} \to \mathcal{C}
              under the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              factors through the wide non-full inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mi R
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    (\infty,1)Cat^R \to (\infty,1)Cat
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
              which are
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi StabCat
                      %mi R
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mi R
                  %annotation{:encoding => "application/x-tex"}
                    i \colon (\infty,1)StabCat^R \hookrightarrow (\infty,1)Cat^R
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
              has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ⊣
                    %mi Stab
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (i \dashv Stab)
            %p
              given by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Goodwillie+calculus"} Goodwillie calculus
            %p
              So the classifying map of the codomain fibration factors through this and hence we can postcompose with the
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
              functor to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∘
                    %mi Stab
                    %mi i
                    %msub
                      %mi χ
                      %mi cod
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i \circ Stab i \chi_{cod} \colon \mathcal{C}^{op} \to (\infty,1)Cat
                    \\,.
            %p
              This sends an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              to the
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
              of the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-category"} slice (∞,1)-category
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Stab
                    %mo ∘
                    %msub
                      %mi χ
                      %mi cod
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo ↦
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Stab \circ \chi_{cod} \colon c \mapsto Stab(\mathcal{C}_{/c})
                    \\,.
            %p
              Again by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              this classifies a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
