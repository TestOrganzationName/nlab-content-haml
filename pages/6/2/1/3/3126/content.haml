                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}^{seq}
                    \\coloneqq
                    Func(seq, \mathbf{H})
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              with “fiberwise pre-stabilization”.
            %p
              A genuine
              %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
              is a
              %a.existingWikiWord{:href => "/nlab/show/prespectrum+object"} prespectrum object
              for which all the structure maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Ω
                      %mi B
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_n \stackrel{\simeq}{\longrightarrow} \Omega_B X_{n+1}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalences
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                  %annotation{:encoding => "application/x-tex"}
                    T \mathbf{H} \hookrightarrow \mathbf{H}^{seq}
            %p
              on the genuine
              %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
              is therefore the “fiberwise
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          #SpectrificationLemma.num_lemma
            %h6#lemma Lemma
            %p
              %strong (spectrification is left exact reflective)
            %p
              The inclusion of
              %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{seq}
              is
              %a.existingWikiWord{:href => "/nlab/show/left+exact+%28infinity%2C1%29-functor"} left
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflective
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              –
              %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
              – which preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi L
                            %mi lex
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T \mathbf{H}
                    \\stackrel{\overset{L_{lex}}{\leftarrow}}{\hookrightarrow}
                    \\mathbf{H}^{seq}
                    \\,.
          %p
            (
            %a{:href => "#Joyal08"}> Joyal 08, section 35.1
            )
          .proof
            %h6#proof Proof
            %p
              Forming degreewise
              %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
              constitutes an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi seq
                  %annotation{:encoding => "application/x-tex"} \Omega \colon \mathbf{H}^{seq} \longrightarrow \mathbf{H}^{seq}
              and by definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi seq
                  %annotation{:encoding => "application/x-tex"} seq
              this comes with a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              out of the identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi id
                    %mo ⟶
                    %mi Ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \;\colon\; id \longrightarrow \Omega
                    \\,.
            %p
              This in turn is compatible with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ∘
                    %mi Ω
                    %mo ≃
                    %mi Ω
                    %mo ∘
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo ⟶
                    %mi ρ
                    %mo ∘
                    %mi ρ
                    %mo =
                    %msup
                      %mi ρ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \circ \Omega \simeq \Omega \circ \theta
                    \\;\colon\;
                    \\rho \longrightarrow \rho \circ \rho = \rho^2
                    \\,.
            %p
              Consider then a sufficiently deep
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ρ
                        %mi tf
                    %annotation{:encoding => "application/x-tex"} \rho^{tf}
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              available in the
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              this stabilizes, and hence provides a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi seq
                      %mo ⟶
                      %mi T
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} L \;\colon\; \mathbf{H}^{seq} \longrightarrow T \mathbf{H}
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              is a
              %a.existingWikiWord{:href => "/nlab/show/filtered+%28%E2%88%9E%2C1%29-colimit"} filtered (∞,1)-colimit
              and since in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              these commute with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              %a.existingWikiWord{:href => "/nlab/show/exact+%28%E2%88%9E%2C1%29-functor"} left exact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              over the
              %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/tangent+%28%E2%88%9E%2C1%29-category"} tangent (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} T \mathbf{H}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              over the base
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} T \infty Grpd
              (and hence in particular also over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \infty Grpd
              itself).
          %p
            (
            %a{:href => "#Joyal08"}> Joyal 08, section 35.5
            )
          .proof
            %h6#proof_2 Proof
            %p
              By the the spectrification lemma
              %a.maruku-ref{:href => "#SpectrificationLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} T \mathbf{H}
              has a
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              into the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-presheaf (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi seq
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}^{seq}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              (by the discussion there).
            %p
              Moreover, since both
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              in the
              %a.existingWikiWord{:href => "/nlab/show/global+section+geometric+morphism"} global section geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %munder
                        %mo ⟶
                        %mi Γ
                      %mover
                        %mo ←
                        %mi Δ
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\longrightarrow}} \infty Grpd
              preserve
              %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              they preserve
              %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
              and hence their immediate
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              prolongation immediately restricts to the inclusion of spectrum objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
