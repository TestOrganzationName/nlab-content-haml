                  %a.existingWikiWord{:href => "/nlab/show/New+Spaces+for+Mathematics+and+Physics"} New Spaces for Mathematics and Physics
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/9781108854429.007"} doi:10.1017/9781108854429.007
              = succeed "&rbrack;" do
                %a{:href => "http://mathieu.anel.free.fr/mat/doc/Anel-Joyal-Topo-logie.pdf"} pdf
          %p
            Presentation by
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yonatan+Harpaz"}> Yonatan Harpaz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joost+Nuiten"} Joost Nuiten
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matan+Prasma"} Matan Prasma
                %em Tangent categories of algebras over operads
                (
                %a{:href => "https://arxiv.org/abs/1612.02607"}> arXiv:1612.02607
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yonatan+Harpaz"}> Yonatan Harpaz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joost+Nuiten"} Joost Nuiten
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matan+Prasma"} Matan Prasma
                %em The abstract cotangent complex and Quillen cohomology of enriched categories
                (
                %a{:href => "https://arxiv.org/abs/1612.02608"}> arXiv:1612.02608
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yonatan+Harpaz"}> Yonatan Harpaz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joost+Nuiten"} Joost Nuiten
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matan+Prasma"} Matan Prasma
                = succeed "," do
                  %em The tangent bundle of a model category
                %a{:href => "http://tac.mta.ca/tac/volumes/34/33/34-33abs.html"} journal web site
            %li#BraunackMayer19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vincent+Braunack-Mayer"}> Vincent Braunack-Mayer
                ,
                %em Combinatorial parametrised spectra
                (based on the
                = succeed ")," do
                  %a.existingWikiWord{:href => "/schreiber/show/thesis+Braunack-Mayer"} PhD thesis
              %p
                Algebr. Geom. Topol.
                %strong 21
                (2021) 801-891 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1907.08496"}> arXiv:1907.08496
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2021.21.801"} doi:10.2140/agt.2021.21.801
          %p
            Generalization to parameterized objects in any
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            is discussed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marc+Hoyois"}> Marc Hoyois
              ,
              = succeed "," do
                %em Topoi of parametrized objects
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1611.02267"} arXiv:1611.02267
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/34/9/34-09abs.html"} tac:34-09
          %p
            A more general notion of a
            %em
              tangent structure on an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty, 1)
            was attempted to reformulate the
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie+calculus"} Goodwillie calculus
            in:
          %ul
            %li#BauerBurkeChing21
              %a.existingWikiWord{:href => "/nlab/show/Kristine+Bauer"}> Kristine Bauer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Burke"} Matthew Burke
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"} Michael Ching
              %em
                Tangent
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (
              %a{:href => "https://arxiv.org/abs/2101.07819"}> arXiv:2101.07819
              ).
          %p
            Note that this is an extension to
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty, 1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle+category"} tangent bundle category
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty, 1)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"}> Michael Ching
              ,
              %em Tangent ∞-categories and Goodwillie calculus
              (
              %a{:href => "http://www.math.muni.cz/~bourkej/29CHI/slides.pdf"}> slides
              )
          %p
            Two further examples of tangent structures on an
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Topos"} (∞,1)-Topos
            and its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/opposite+%28infinity%2C1%29-category"} opposite
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"}> Michael Ching
              ,
              = succeed "," do
                %em Dual tangent structures for infinity-toposes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2101.08805"} arXiv:2101.08805
          %p Exposition:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eric+Finster"}> Eric Finster
              \:
              = succeed "," do
                %em A Tour of Parameterized Spectra
              %a{:href => "CQTS#FinsterApr2024"} talk at
              = succeed "," do
                %em
                  %a{:href => "CQTS#RunningHoTT2024"} Running HoTT 2024
              = succeed "@NYUAD" do
                %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
              = succeed "&rbrack;" do
                %a{:href => "https://cdnapisec.kaltura.com/p/1674401/sp/167440100/embedIframeJs/uiconf_id/23435151/partner_id/1674401?iframeembed=true&playerId=kaltura_player&entry_id=1_jf6fy0f2"} kt
