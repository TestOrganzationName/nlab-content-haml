                    Alg_\mathcal{O}(\mathcal{C})
                    \\times_{Func(\mathcal{O}, Alg_\mathcal{O}(\mathcal{C}))}
                    Func_\mathcal{O}(\mathcal{O}, Mod^\mathcal{O}(\mathcal{C}))
            %p
              of presentble
