              be a
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-category"} monoidal (∞,1)-category
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Alg
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \in Alg_\mathcal{O}(\mathcal{C})
            %p
              be an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+%28infinity%2C1%29-operad"} algebra
              in
