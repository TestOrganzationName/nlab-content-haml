                      %annotation{:encoding => "application/x-tex"} A
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module+over+an+%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-operad"} module
          %h3#CotangentComplex Cotangent complex
          %p
            From its definition as the fiberwise stabilization of the
            %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} cod : Func(\Delta[1], C) \to C
            the tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %msub
                    %mi T
                    %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} p : T_C \to C
            inherits a second
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %em domain
            evaluation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dom
                  %mo :
                  %msub
                    %mi T
                    %mi C
                  %mo →
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  dom : T_C \to C
                  \\,.
          #CotangentComplexAdjunction.num_prop
            %h6#definitionproposition Definition/Proposition
            %p
              %strong (cotangent complex)
            %p
              The domain evaluation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dom
                    %mo :
                    %msub
                      %mi T
                      %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} dom : T_C \to C
              admits a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ⊣
                    %mi dom
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi T
                      %mi C
                    %mover
                      %munder
                        %mo →
                        %mi dom
                      %mover
                        %mo ←
                        %mi Ω
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega \dashv dom) : T_C \stackrel{\overset{\Omega}{\leftarrow}}{\underset{dom}{\to}}
                    C
            %p
              that is also a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi T
                      %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p : T_C \to C
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mover
                      %mo →
                      %mi Ω
                    %msub
                      %mi T
                      %mi C
                    %mover
                      %mo →
                      %mi p
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Id
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    (C \stackrel{\Omega}{\to} T_C \stackrel{p}{\to} C) \simeq Id_C
            %p
              and which hence exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
