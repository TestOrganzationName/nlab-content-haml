                            %mn ∞
                      %mover
                        %mo ⟶
                        %mi Ω
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mover
                      %mover
