                    \\;
                    \\colon
                    \\;
                    T(\infty Grpd)
                    \\stackrel{\overset{base}{\longrightarrow}}{\stackrel{\overset{0}{\leftarrow}}{\stackrel{\overset{base}{\longrightarrow}}{\underset{0}{\leftarrow}}}}
                    \\infty Grpd
                    \\,.
            %p
              Recalling that here
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi base
                      %mo =
                      %mi cod
                      %mo ∘
                      %msup
                        %mi Ω
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} base = cod \circ \Omega^\infty
              %a.existingWikiWord{:href => "/nlab/show/cotangent+complex"} cotangent complex
              adjunction due to prop.
              %a.maruku-ref{:href => "#CotangentComplexAdjunction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
