                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            %p
              In particular, it admits all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, prop. 1.1.13
            ).
          %p Moreover:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              A diagram in the tangent
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi 𝒞
