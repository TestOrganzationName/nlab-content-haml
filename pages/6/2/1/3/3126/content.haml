                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
              of the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} over-(∞,1)-category
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is canonically equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Func
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo ,
                    %msubsup
                      %mi Mod
                      %mi A
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func_\mathcal{O}(\mathcal{O}, Mod_A^\mathcal{O}(\mathcal{C}))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Alg
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Func
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo ,
                    %msubsup
                      %mi Mod
                      %mi A
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Stab( Alg_\mathcal{O}(\mathcal{C})/A)
                    \\simeq
                    Func_\mathcal{O}(\mathcal{O}, Mod_A^\mathcal{O}(\mathcal{C}))
                    \\,.
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, theorem 1.5.14
            ).
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^\otimes
              be a
              %a.existingWikiWord{:href => "/nlab/show/coherent+%28%E2%88%9E%2C1%29-operad"} coherent (∞,1)-operad
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒪
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes \to \mathcal{O}^\otimes
              be a
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-category"} monoidal (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msub
                      %mi T
                      %mrow
                        %msub
                          %mi Alg
                          %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi Alg
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi Func
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo ,
                        %msub
