            %a.existingWikiWord{:href => "/nlab/show/tangent+category"} tangent category
            over
            %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            and the category
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            of all
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over commutative rings.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^\otimes
              be a
              %a.existingWikiWord{:href => "/nlab/show/coherent+%28%E2%88%9E%2C1%29-operad"} coherent (∞,1)-operad
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒪
                      %mo ⊗
