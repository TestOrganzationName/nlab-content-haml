                  %a.existingWikiWord{:href => "/nlab/show/relative+%28infinity%2C1%29-limit"} relative (∞,1)-(co-)limit
                  with respect to the projection
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo{:lspace => "verythinmathspace"} :
                          %msub
                            %mi T
                            %mi 𝒞
                          %mo →
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} p \colon T_{\mathcal{C}} \to \mathcal{C}
              %li
                %p
                  its image under this projection is an
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-(co-)limit
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            (
            %a{:href => "#LurieHigherAlgebra"}> Lurie, HigherAlgebra, prop. 7.3.1.12
            )
          %h3#RelationToModules Relation to modules
          %p
            We discuss how the tangent
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
