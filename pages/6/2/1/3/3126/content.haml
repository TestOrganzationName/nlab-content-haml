                      %mi f
                      %mi b
                      %mo *
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n \longrightarrow f_b^\ast Y_n
              into the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              of the components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
