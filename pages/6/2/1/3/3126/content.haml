            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} T \mathbf{H}
            as the result of adjoining to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            a universal “stable object”
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi Ω
                  %msubsup
                    %mi X
                    %mo *
                    %mo •
                  %mo →
                  %msubsup
                    %mi X
                    %mo *
                    %mo •
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T \mathbf{H}\simeq \mathbf{H}[X_\ast][ (\Sigma \Omega X_\ast^\bullet \to X_\ast^\bullet)^{-1} ]
                  \\,.
          %p
            For details see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/excisive+%28%E2%88%9E%2C1%29-functor"} excisive (∞,1)-functor
            the section
            = succeed "." do
              %em
                %a{:href => "excisive+%28%E2%88%9E%2C1%29-functor#CharacterizationViaAGenericStableObject"} Characterization via a generic stable object
          %h4#cohesive_tangent_topos_of_a_cohesive_topos
            Cohesive tangent
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
