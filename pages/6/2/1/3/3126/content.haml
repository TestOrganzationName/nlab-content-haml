            Of an
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss here aspects of the tangent
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"} (∞,1)-toposes
          %p
            First consider the
            %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          #SliceOfinfinityGroupoidsIsFunctorCategory.num_remark
            %h6#remark_5 Remark
            %p
              For each
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} X \in \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo ≃
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\infty Grpd_{/X}
                    \\simeq
                    Func(X, \infty Grpd)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-category"} slice (∞,1)-category
              of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor+%28%E2%88%9E%2C1%29-category"} (∞,1)-functor (∞,1)-category
              of maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} X \to \infty Grpd
          .proof
            %h6#proof_3 Proof
            %p
              By the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For each
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} X \in \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Spec
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    T_X (\infty Grpd) \simeq Func(X, Spec)
            %p
              between the fiber of the tangent (∞,1)-category of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#TangentCategory"}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_4 Proof
            %p
              Applying remark
              %a.maruku-ref{:href => "#SliceOfinfinityGroupoidsIsFunctorCategory"}
              in remark
              %a.maruku-ref{:href => "#TangentCatByExplicitFiberwiseStabilization"}
              yields that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T_X(\infty Grpd) \simeq Stab(Func(X,\infty Grpd))
                    \\,.
            %p
              The statement then follows with the “
              %a{:href => "stable%20%28infinity,1%29-category#StabGiraud"}> stable Giraud theorem
              ”.
          .num_remark
            %h6#remark_6 Remark
            %p
              This means that the tangent
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(\infty Grpd)
              is equivalently what in (
              %a{:href => "#Joyal08"}> Joyal 08, section 30.34
              ) is denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Kan
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(Kan, X)
              in the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi Spec
                  %annotation{:encoding => "application/x-tex"} X = Spec
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+spectra"} (∞,1)-category of spectra
          #TangentOfInfinityGrpdIsTopos.num_prop
            %h6#proposition_7 Proposition
            %p
              The tangent
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T (\infty Grpd)
              is itself an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          .proof
            %h6#proof_5 Proof
            %p
              With the above equivalence this is (
              %a{:href => "#Joyal08"} Joyal 08, section 35.5, 35.6
              (with
              = succeed "))." do
                %a.existingWikiWord{:href => "/nlab/show/Georg+Biedermann"} Georg Biedermann
          .num_remark
            %h6#remark_7 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} T \infty Grpd
              should be the
              %a.existingWikiWord{:href => "/nlab/show/zero+spectrum"} zero spectrum
              regarded as a parameterized spectrum over the point
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi Spec
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \colon \ast \to Spec
                    \\,.
          %p From this it follows that
          .num_remark
            %h6#remark_8 Remark
            %p
              The
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/global+elements"} global elements
              %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
              functor (which forms the
              %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} (∞,1)-categorical mapping space
              out of the terminal object)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ≔
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \coloneqq Hom(\ast, -)
                    \\;\colon\; T(\infty Grpd) \to \infty Grpd
            %p
              sends an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectrum"} parameterized spectrum
              to its base homotopy type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              This functor has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
              and
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              both given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              %a.existingWikiWord{:href => "/nlab/show/zero+spectrum"} zero spectrum
              bundle over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              So we have an infinite chain of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
