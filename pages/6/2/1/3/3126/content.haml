                          %mi 𝒪
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Func
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo ,
                    %msup
                      %mi Mod
                      %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi : T_{Alg_\mathcal{O}(\mathcal{C})}
