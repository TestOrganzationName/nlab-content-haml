                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial^k \epsilon^\alpha}{\partial x^{\mu_1} \cdots \partial x^{\mu_k}}
                    \\;=\;
                    \\frac{\partial^k \epsilon^\alpha}{\partial x^{\mu_1} \cdots \partial x^{\mu_k}}((x^\mu))
            %p
              are the actual
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              of the
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              (which are functions of spacetime).
            %p
              In particular, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
              is assumed to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              that have
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              (
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"}> bump functions
              ). For such compactly supported
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              the infinitesimal symmetry
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(\epsilon)
              is spacetime-compactly supported as in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#NonTrivialImplicitInfinitesimalGaugeSymmetriesPbstructExistenceOfCauchySurfaces"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The following remark
            %a.maruku-ref{:href => "#GeneratingSetOfGaugeTransformations"}
            and def.
            %a.maruku-ref{:href => "#RigidInfinitesimalSymmetriesOfTheLagrangian"}
            introduce some useful terminology:
          #GeneratingSetOfGaugeTransformations.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (generating set of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            %p
              Given a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
              with gauge parameterized
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi R
                    %msub
                      %mi T
                      %mi Σ
                    %mi E
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(\mathcal{G} \times_\Sigma E) \overset{R}{\longrightarrow} T_\Sigma E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParameters"}
              %em choice
              and not uniquely fixed.
            %p
              For example given any such bundle one may form the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %msub
                      %mo ⊕
                      %mi Σ
                    %mi 𝒢
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \oplus_\Sigma \mathcal{G}'
              with any other
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}'
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              by zero to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}'
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterized
              of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ′
                    %msub
                      %mo ⊕
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Σ
                    %mi E
                    %mo{:stretchy => "false"} )
