                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathfrak{g}^\infty \times J^\infty_\Sigma E
                    \&amp;&amp; \overset{\widehat{R(e)}}{\longrightarrow} &amp;&amp;
                    T_\Sigma J^\infty_\Sigma(E)
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; J^\infty_\Sigma(E)
                    }
                    \\,.
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterized
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              by
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
          #LocalOffShellBRSTComplex.num_example
            %h6#example_11 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local
                %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
                and
                %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
                for closed
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo ⟶
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\longrightarrow} \Sigma
              be a bundle of irreducible closed
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
              for the theory (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi J
                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi 𝒢
                            %msub
                              %mo ×
                              %mi Σ
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi R
                          %mtd
                          %mtd
                            %msub
                              %mi T
                              %mi Σ
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    J^\infty_\Sigma( \mathcal{G} \times_\Sigma E )
                    \&amp;&amp; \overset{R}{\longrightarrow} &amp;&amp;
                    T_\Sigma E
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; E
                    }
                    \\,.
            %p
              Assuming that the gauge parameter bundle is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo =
                      %mi 𝔤
                      %mo ×
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} = \mathfrak{g} \times \Sigma
              %a.maruku-ref{:href => "#ActionOfGaugeParameterizedInfinitesimalGaugeSymmetriesOnJetBundle"}
              this induces an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat R
              of a Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\infty
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mi E
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma E
              by
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi 𝔤
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/\mathfrak{g}^\infty
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ActionLieAlgebroid"}
              %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#dgManifolds"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mn ∞
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo ×
                      %mi Σ
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g}^\infty[1] \times J^\infty_\Sigma(E)
                    \\;\simeq\;
                    J^\infty_\Sigma( \mathcal{G}[1] \times_\Sigma E  )
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi BRST
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %msub
                      %mo ×
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    E_{BRST} \;\coloneqq\; E \times_\Sigma \mathcal{G}[1]
            %p
              which regards the
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
              as
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              in degree 1. As such these are called
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mtext ghost field histories
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\text{ghost field histories}
                    \\right\}
                    \\;\coloneqq\;
                    \\Gamma_\Sigma( \mathcal{G}[1] )
                    \\,.
            %p Therefore we write suggestively
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi 𝔤
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    E/\mathcal{G}
                    \\;\coloneqq\;
                    J^\infty_\Sigma(E)/\mathfrak{g}^\infty
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              of the
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterized
              implicit
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %p
              The Chevalley-Eilenberg
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              of the
              %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
              is traditionally denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                    %mo ≔
                    %msub
                      %mi d
                      %mi CE
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_{BRST} \coloneqq d_{CE}
                    \\,.
            %p
              To express this in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              as well as the
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle are
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi^a)
              the
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              coordinates on the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with induced jet coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mi μ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((x^\mu), (\phi^a), (\phi^a_{\mu}), \cdots)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi c
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c^\alpha)
              are
              %a.existingWikiWord{:href => "/nlab/show/ghost+field"} ghost field
              coordinates on the fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}[1]
              with induced jet coordinates
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi c
                        %mi α
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi c
                        %mi μ
                        %mi α
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((x^\mu), (c^\alpha), (c^\alpha_\mu), \cdots)
            %p
              Then in terms of the corresponding coordinate expression for the gauge symmetries
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (2)
              the
              %a.existingWikiWord{:href => "/nlab/show/BRST+differential"} BRST differential
              is given on the
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ϕ
                      %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi c
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                      %mi α
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %msubsup
                      %mi R
                      %mi α
                      %mrow
                        %mi a
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                  %annotation{:encoding => "application/x-tex"}
                    s_{BRST} \, \phi^a
                    \\;=\;
                    c^\alpha_{,\mu_1 \cdots \mu_k}
                    \\underset{k \in \mathbb{N}}{\sum}
                    R^{a \mu_1 \cdots \mu_k}_{\alpha}
            %p
              and on the
              %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi c
                      %mi α
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msup
                      %mi γ
                      %mi α
                    %msub
                      %mrow
                      %mrow
                        %mi β
                        %mi γ
                    %msup
                      %mi c
                      %mi β
                    %msup
                      %mi c
                      %mi γ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    s_{BRST} \, c^\alpha = \tfrac{1}{2}\gamma^\alpha{}_{\beta \gamma} c^\beta c^\gamma
                    \\,,
            %p
              and it extends from there, via prop.
              = succeed "," do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
            %p
              Moreover, since the action of the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              is by definition via prolongations (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
              %a.maruku-eqref{:href => "#eq:ProlongedEvolutionaryVectorFieldContractionAnticommutedWithHorizontalDerivative"} (?)
              this construction descends to the horizontal tangent Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/T\Sigma
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#HorizontalTangentLieAlgebroid"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mi Σ
                      %mo )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi 𝔤
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    E/(\mathcal{G}\times_\Sigma T \Sigma)
                    \\;\coloneqq\;
                    \\left(J^\infty_\Sigma(E)/T\Sigma\right)/\mathfrak{g}^\infty
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E/(\mathcal{G}\times_\Sigma T \Sigma)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo −
                    %msub
                      %mi s
                      %mi BRST
                  %annotation{:encoding => "application/x-tex"}
                    d - s_{BRST}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of functions on this
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+manifold"} differential graded manifold
              %a.maruku-eqref{:href => "#eq:CEAlgebra"} (17)
              is called the
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
          %p
            (
            %a{:href => "local+BRST+cohomology#BarnichBrandtHenneaux94"}> Barnich-Brandt-Henneaux 94
            ,
            = succeed ")." do
              %a{:href => "BRST+complex#Barnich10"} Barnich 10 (35)
          .num_defn
            %h6#definition_9 Definition
            %p
              %strong
                (global
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
            %p
              We may pass from the
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              to the “global” BRST complex by
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Obs(E \times_\Sigma \mathcal{G}[1])
              for the induced graded
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalObservables"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^{p+1,\bullet}_\Sigma(E \times_\Sigma \mathcal{G}[1])
              with corresponding
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi LocObs
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_\Sigma(A) \in LocObs_\Sigma(E \times_\Sigma \mathcal{G}[1])
              its BRST differential is defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi BRST
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    s_{BRST} \tau_{\Sigma}(A) \;\coloneqq\; \tau_{\Sigma}(s_{BRST} A)
            %p
              and extended from there to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Obs(E \times_\Sigma \mathcal{G}[1])
              as a graded derivation.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#ExamplesForLocalBRSTComplexes
            %strong
              Examples of
              %a.existingWikiWord{:href => "/nlab/show/local+BRST+complexes"} local BRST complexes
              of
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian
              %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
          #LocalBRSTComplexForFreeElectromagneticFieldOnMinkowskiSpacetim.num_prop
            %h6#example_12 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
                for
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#ElectromagnetismLagrangianDensity"}
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle as in example
              = succeed "." do
                %a.maruku-ref{:href => "#InfinitesimalGaugeSymmetryElectromagnetism"}
            %p
              By
              %a.maruku-eqref{:href => "#eq:EMProlongedSymmetryVectorField"} (8)
              the action of the
              %a.existingWikiWord{:href => "/nlab/show/BRST+differential"} BRST differential
              is the derivation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi μ
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi a
                          %mi μ
                    %mo +
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi a
                          %mrow
                            %mi μ
                            %mo ,
                            %mi ν
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_{BRST}
                    \\;=\;
                    c_{,\mu} \frac{\partial}{\partial a_\mu}
                    +
                    c_{, \mu \nu} \frac{\partial}{\partial a_{\mu, \nu}}
                    +
                    \\cdots
                    \\,.
            %p
              In particular the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              is BRST-closed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi s
                              %mi BRST
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                          %mtd
                            %mo =
                            %msub
                              %mi s
                              %mi BRST
                            %msub
                              %mi f
                              %mrow
                                %mi μ
                                %mi ν
                            %msup
                              %mi f
                              %mrow
                                %mi μ
                                %mi ν
                            %msub
                              %mi dvol
                              %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi c
                              %mrow
                                %mo ,
                                %mi μ
                                %mi ν
                            %msup
                              %mi f
                              %mrow
                                %mi μ
                                %mi ν
                            %msub
                              %mi dvol
                              %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    s_{BRST} \mathbf{L}
                    \&amp; =
                    s_{BRST} f_{\mu \nu} f^{\mu \nu} dvol_\Sigma
                    \\\
                    \&amp; =
                    c_{,\mu \nu} f^{\mu \nu} dvol_\Sigma
                    \\\
                    \&amp; =
                    0
                    \\end{aligned}
            %p
              as is the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              (due to the symmetry
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %mo =
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi ν
                        %mi μ
                  %annotation{:encoding => "application/x-tex"} c_{,\mu \nu} = c_{,\nu \mu}
              %a.maruku-eqref{:href => "#eq:JetCoodinatesSymmetry"} (?)
              and in contrast to the skew-symmetry
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mrow
                          %mi μ
                          %mi ν
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi f
                        %mrow
                          %mi ν
                          %mi μ
                    %annotation{:encoding => "application/x-tex"} f_{\mu \nu} = - f_{\nu \mu}
          #YangMillsLocalBRSTComplex.num_example
            %h6#example_13 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
                for the
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#YangMillsLagrangian"}
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msubsup
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                      %mi α
                    %msubsup
                      %mi f
                      %mi α
                      %mrow
                        %mi μ
                        %mi ν
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;=\;
                    \\tfrac{1}{2} f^\alpha_{\mu \nu} f_\alpha^{\mu \nu}
            %p
              given by the universal
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              %a.maruku-eqref{:href => "#eq:YangMillsJetFieldStrengthMinkowski"} (?)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                      %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mrow
                      %mo (
                      %msubsup
                        %mi a
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi ν
                          %mo ,
                          %mi μ
                          %mo{:stretchy => "false"} ]
                        %mi α
                      %mo +
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msubsup
                        %mi γ
                        %mrow
                          %mi β
                          %mi γ
                        %mi α
                      %msubsup
                        %mi a
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi μ
                        %mi β
                      %msubsup
                        %mi a
                        %mrow
                          %mi ν
                          %mo{:stretchy => "false"} ]
                        %mi γ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^\alpha_{\mu \nu}
                    \\;\coloneqq\;
                    \\tfrac{1}{2}
                    \\left(
                    a^\alpha_{[\nu,\mu]}
                    +
                    \\tfrac{1}{2} \gamma^\alpha_{\beta \gamma} a^\beta_{[\mu} a^\gamma_{\nu]}
                    \\right)
                    \\,.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ≔
                    %mi Σ
                    %mo ×
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq \Sigma \times \mathfrak{g}
              be the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              with
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi c
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((x^\mu), c^\alpha)
              and consider the
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parametrized
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi c
                        %mrow
                          %mo ,
                          %mi μ
                        %mi α
                      %mo −
                      %msubsup
                        %mi γ
                        %mrow
                          %mi β
                          %mi γ
                        %mi α
                      %msup
                        %mi c
                        %mi β
                      %msubsup
                        %mi a
                        %mi μ
                        %mi γ
                      %mo )
                    %msub
                      %mo ∂
                      %mrow
                        %msubsup
                          %mi a
                          %mi μ
                          %mi α
                  %annotation{:encoding => "application/x-tex"}
                    R
                    \\;=\;
                    \\left(
                    c^\alpha_{,\mu}
                    \-
                    \\gamma^\alpha_{\beta \gamma} c^\beta a^\gamma_\mu
                    \\right)
                    \\partial_{a^\alpha_\mu}
            %p
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#InfinitesimalGaugeSymmetryOfYangMillsTheory"}
            %p
              We claim that these are
              %em
                closed
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
              in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#GaugeParametersClosed"}
              %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
              in the form of example
              %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
              exists.
            %p
              To see this, observe that, by def.
              %a.maruku-ref{:href => "#ActionLieAlgebroid"}
              the candidate BRST differential needs to be of the form
              %a.maruku-eqref{:href => "#eq:OnMinkowskiInfinitesimalGaugeSymmetryForYangMills"} (9)
              plus the
              %a.existingWikiWord{:href => "/nlab/show/linear+dual"} linear dual
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi 𝒢
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [-,-]_{\mathcal{G}}^\ast
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msubsup
                          %mi c
                          %mrow
                            %mo ,
                            %mi μ
                          %mi α
                        %mo −
                        %msubsup
                          %mi γ
                          %mrow
                            %mi β
                            %mi γ
                          %mi α
                        %msup
                          %mi c
                          %mi β
                        %msubsup
                          %mi a
                          %mi μ
                          %mi γ
                        %mo )
                      %msub
                        %mo ∂
                        %mrow
                          %msubsup
                            %mi a
                            %mi μ
                            %mi α
                      %mspace{:width => "thickmathspace"}
                      %mo +
                      %mspace{:width => "thickmathspace"}
                      %mtext prolongation
                      %mo )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi 𝒢
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_{BRST}
                    \\;=\;
                    \\left(
                    \\left(
                    c^\alpha_{,\mu}
                    \-
                    \\gamma^\alpha_{\beta \gamma} c^\beta a^\gamma_\mu
                    \\right)
                    \\partial_{a^\alpha_\mu}
                    \\;+\;
                    \\text{prolongation}
                    \\right)
                    +
                    ([-,-]_{\mathcal{G}})^\ast
                    \\,.
            %p
              Moreover, by def.
              %a.maruku-ref{:href => "#ActionLieAlgebroid"}
              we may equivalently make an Ansatz for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi 𝒢
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} ([-,-]_{\mathcal{G}})^\ast
              and if the resulting differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                  %annotation{:encoding => "application/x-tex"} s_{BRST}
              squares to zero, as this dually defines the required closure bracket
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} [-,-]_\mathcal{G}
            %p We claim that
            #eq:OffShellYangMillsOnMinkowskiBRSTOperator.maruku-equation
              %span.maruku-eq-number (19)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
