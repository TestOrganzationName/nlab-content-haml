                        %mo{:stretchy => "false"} )
                    %msub
                      %mi T
                      %mi Σ
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J^\infty_\Sigma((\mathcal{G}' \oplus_\Sigma \mathcal{G}) \times_\Sigma E) \overset{(0,R)}{\longrightarrow} T_\Sigma E
                    \\,.
            %p
              Conversely, given any
              %a.existingWikiWord{:href => "/nlab/show/subbundle"} subbundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo ′
                      %mo ↪
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}' \hookrightarrow \mathcal{G}
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
