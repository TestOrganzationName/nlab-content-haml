          %p#LieAlgebraActionAndLieAlgebroids
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+actions"} Lie algebra actions
              and
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
          %p
            We have seen above
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            %em implied
            by a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
            %a.existingWikiWord{:href => "/nlab/show/obstructions"} obstructions
            that these
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            cause for the existence of the
            %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            (via prop.
            %a.maruku-ref{:href => "#NonTrivialImplicitInfinitesimalGaugeSymmetriesPbstructExistenceOfCauchySurfaces"}
