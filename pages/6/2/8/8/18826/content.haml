                    \\;\coloneqq\;
                    \\tfrac{1}{2}
                    \\left(
                    a^\alpha_{[\nu,\mu]}
                    +
                    \\tfrac{1}{2} \gamma^\alpha_{\beta \gamma} a^\beta_{[\mu} a^\gamma_{\nu]}
                    \\right)
                    \\,.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ≔
                    %mi Σ
                    %mo ×
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq \Sigma \times \mathfrak{g}
              be the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              with
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
