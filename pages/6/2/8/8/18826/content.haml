                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\kappa^{[a b]} \;\in\; \Omega^{0,0}_\Sigma(E)
            %p such that
            %ol
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi κ
                          %mrow
                            %mi a
                            %mi b
                      %annotation{:encoding => "application/x-tex"} \kappa^{a b}
                  has compact spacetime support (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SpacetimeSupport"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  is skew-symmetric in its indices:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi κ
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mi b
                            %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mi κ
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi b
                            %mi a
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \kappa^{[a b]} = - \kappa^{[b a]}
            %p
              is an implicit infinitesimal gauge symmetry (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ImplicitInfinitesimalGaugeSymmetry"}
            %p This is so for a “trivial reason” namely due to that that skew symmetry:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ℒ
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %mi δ
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi δ
                              %mi EL
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo −
                            %mi d
                            %msub
                              %mi Θ
                              %mi BFV
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mi ϵ
                            %mfrac
                              %mrow
                                %msub
                                  %mi δ
                                  %mi EL
                                %mi L
                              %mrow
                                %mi δ
                                %msup
                                  %mi ϕ
                                  %mi a
                            %mi δ
                            %msup
                              %mi ϕ
                              %mi a
                            %mo +
                            %mi d
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %msub
                              %mi Θ
                              %mi BFV
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %mrow
                                    %mo (
                                    %mfrac
                                      %mrow
                                        %msub
                                          %mi δ
                                          %mi EL
                                        %mi L
                                      %mrow
                                        %mi δ
                                        %msup
                                          %mi ϕ
                                          %mi a
                                    %mo )
                                  %mrow
                                    %mo (
                                    %mfrac
                                      %mrow
                                        %msub
                                          %mi δ
                                          %mi EL
                                        %mi L
                                      %mrow
                                        %mi δ
                                        %msup
                                          %mi ϕ
                                          %mi b
                                    %mo )
                                  %msup
                                    %mi κ
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mi a
                                      %mi b
                                      %mo{:stretchy => "false"} ]
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mspace{:width => "thickmathspace"}
                            %mo +
                            %mspace{:width => "thickmathspace"}
                            %mi d
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
