                    \\mathbf{L}
                    \\;=\;
                    \\tfrac{1}{2} f^\alpha_{\mu \nu} f_\alpha^{\mu \nu}
            %p
              given by the universal
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              %a.maruku-eqref{:href => "#eq:YangMillsJetFieldStrengthMinkowski"} (?)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
