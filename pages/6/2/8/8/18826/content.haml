              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                        %mover
                          %mo ⟶
                          %mi gb
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\longrightarrow} \Sigma
                  over
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  of
                  %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
                  = succeed ";" do
