                    }
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#BRSTComplex
            %strong
              %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
          %p
            With the general concept of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
            %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroids"} action Lie algebroids
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ActionLieAlgebroid"}
            %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroids"} Lie ∞-algebroids
            in hand (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#LInfinityAlgebroid"}
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#GaugeParameters"}
            = succeed "," do
