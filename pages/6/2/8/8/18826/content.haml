                  %annotation{:encoding => "application/x-tex"} f_\alpha^{\mu\nu}
              vanishes, and in the last step we used that for a
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mrow
                        %mi α
                        %mi β
                        %mi γ
                    %mo ≔
                    %msub
                      %mi k
                      %mrow
                        %mi α
                        %mi α
                        %mo ′
                    %msup
                      %mi γ
                      %mrow
                        %mi α
                        %mo ′
                    %msub
                      %mrow
                      %mrow
                        %mi β
                        %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma_{\alpha \beta \gamma} \coloneqq k_{\alpha \alpha'} \gamma^{\alpha'}{}_{\beta \gamma}
              is totally skew symmetric.
            %p
              So the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              of
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
              is strictly invariant under these
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
          #InfinitesimalGaugeSymmetryOfTheBField.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#BFieldLagrangianDensity"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              the
              = succeed "-bundle" do
                %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %msubsup
                      %mo ∧
                      %mi Σ
                      %mn 2
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E = \wedge^2_\Sigma T^\ast \Sigma
              with coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((x^\mu), (b_{\mu \nu}))
              subject to
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mrow
                          %mi μ
                          %mi ν
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi b
                        %mrow
                          %mi ν
                          %mi μ
                    %annotation{:encoding => "application/x-tex"} b_{\mu \nu} = - b_{\nu \mu}
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mi h
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                        %msub
                          %mi μ
                          %mn 3
                    %msup
                      %mi h
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                        %msub
                          %mi μ
                          %mn 3
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;=\;
                    \\tfrac{1}{2}
                    h_{\mu_1 \mu_2 \mu_3} h^{\mu_1 \mu_2 \mu_3} \, dvol_\Sigma
            %p for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                        %msub
                          %mi μ
                          %mn 3
                    %mo =
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                        %mo ,
                        %msub
                          %mi μ
                          %mn 3
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    h_{\mu_1 \mu_2 \mu_3} = b_{[\mu_1 \mu_2, \mu_3]}
            %p
              the universal
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#BFieldJetFaraday"}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ≔
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq T^\ast \Sigma
              be the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Differential1FormsOnCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((x^\mu), (c_\mu))
              as in example
              = succeed "." do
                %a.maruku-ref{:href => "#Electromagnetism"}
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parametrized
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (2)
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi b
                          %mrow
                            %mi μ
                            %mi ν
                  %annotation{:encoding => "application/x-tex"}
                    R
                    \\;=\;
                    c_{\mu,\nu} \partial_{b_{\mu \nu}}
            %p
              with prolongation (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
            #eq:InfinitesimalGaugeSymmetryForBFieldOnMinkowskiSpacetime.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi b
                          %mrow
                            %mi μ
                            %mi ν
                    %mo +
                    %msub
                      %mi c
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                        %mi ρ
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi b
                          %mrow
                            %mi μ
                            %mi ν
                            %mo ,
                            %mi ρ
                    %mo +
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat R
                    \\;=\;
                    c_{\mu,\nu} \partial_{b_{\mu \nu}}
                    +
                    c_{\mu,\nu \rho} \partial_{b_{\mu \nu, \rho}}
                    +
                    \\cdots
            %p
              In fact this leaves the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+function"} Lagrangian function
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              = succeed ":" do
                %a.maruku-ref{:href => "#InfinitesimalGaugeSymmetryElectromagnetism"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi R
                              %mo ^
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msub
                              %mi h
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                                %msub
                                  %mi μ
                                  %mn 2
                                %msub
                                  %mi μ
                                  %mn 3
                            %msup
                              %mi h
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                                %msub
                                  %mi μ
                                  %mn 2
                                %msub
                                  %mi μ
                                  %mn 3
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mover
                                %mi R
                                %mo ^
                              %msub
                                %mi b
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 1
                                  %msub
                                    %mi μ
                                    %mn 2
                                  %mo ,
                                  %msub
                                    %mi μ
                                    %mn 3
                              %mo )
                            %msup
                              %mi h
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                                %msub
                                  %mi μ
                                  %mn 2
                                %msub
                                  %mi μ
                                  %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi c
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi μ
                                  %mn 2
                                %msub
                                  %mi μ
                                  %mn 3
                            %msup
                              %mi h
                              %mrow
                                %msub
                                  %mi μ
                                  %mn 1
                                %msub
                                  %mi μ
                                  %mn 2
                                %msub
                                  %mi μ
                                  %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat{R} \tfrac{1}{2} h_{\mu_1 \mu_2 \mu_3} h^{\mu_1 \mu_2 \mu_3}
                    \&amp; =
                    \\left(
                    \\widehat{R} b_{\mu_1 \mu_2, \mu_3}
                    \\right)
                    h^{\mu_1 \mu_2 \mu_3}
                    \\\
                    \&amp; =
                    c_{\mu_1, \mu_2 \mu_3}
                    h^{\mu_1 \mu_2 \mu_3}
                    \\\
                    \&amp; = 0
                    \\end{aligned}
            %p
              due to the symmetry of
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:JetCoodinatesSymmetry"} (?)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi c
                          %mi μ
                    %mo +
                    %msub
                      %mi h
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi c
                          %mrow
                            %mi μ
                            %mo ,
                            %mi ν
                  %annotation{:encoding => "application/x-tex"}
                    h_{,\mu}\partial_{c_{\mu}}
                    +
                    h_{,\mu \nu}\partial_{c_{\mu,\nu}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi R
                      %mi α
                      %mrow
                        %mi a
                        %mo ,
                        %mi μ
                    %mo =
                    %msub
                      %mi c
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %msubsup
                      %mi R
                      %mrow
                        %mi μ
                        %mo ′
                        %mi ν
                        %mo ′
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi b
                          %mrow
                            %mi μ
                            %mo ′
                            %mi ν
                            %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R_\alpha^{a, \mu}
                    \=
                    c_{\mu,\nu}
                    R^{\mu, \nu}_{\mu' \nu'}
                    \\partial_{b_{\mu' \nu'}}
                    \\,.
            %p
              While so far all this is in direct analogy to the case of the
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#InfinitesimalGaugeSymmetryElectromagnetism"}
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              being
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              now replaced by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+2-forms"} differential 2-forms
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              itself has
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            %p Let
            #eq:SecondOrderGaugeParameterBundleForBFieldOnMinkowskiSpacetime.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi 𝒢
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                          %mtd
                            %mi Σ
                            %mo ×
                            %mi ℝ
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mover
                                %mi gb
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi pr
                                    %mn 1
                        %mtr
                          %mtd
                            %mi Σ
                          %mtd
                            %mo =
                          %mtd
                            %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\overset{(2)}{\mathcal{G}} &amp;\coloneqq&amp; \Sigma \times \mathbb{R}
                    \\\
                    {}^{\overset{(2)}{gb}}\downarrow  &amp;&amp; \downarrow^{\mathrlap{pr_1}}
                    \\\
                    \\Sigma &amp;=&amp; \Sigma
                    }
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              %a.existingWikiWord{:href => "/nlab/show/real+line+bundle"} real line bundle
              with coordinates
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mover
                        %mi c
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((x^\mu), \overset{(2)}{c})
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge-of-gauge+symmetry"} infinitesimal gauge-of-gauge symmetry
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi c
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi c
                          %mi μ
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{(2)}{R}
                    \\;\coloneqq\;
                    \\overset{(2)}{c}_{,\mu} \partial_{c_\mu}
            %p with prolongation
            #eq:SecondOderGaugeSymmetryOfBFieldOnMinkowski.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mover
                        %mi R
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi c
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi c
                          %mi μ
                    %mo +
                    %msub
                      %mover
                        %mi c
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi c
                          %mrow
                            %mi μ
                            %mo ,
                            %mi ν
                    %mo +
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{\overset{(2)}{R}}
                    \\;\coloneqq\;
                    \\overset{(2)}{c}_{,\mu} \partial_{c_\mu}
                    +
                    \\overset{(2)}{c}_{,\mu \nu} \partial_{c_{\mu,\nu}}
                    +
                    \\cdots
            %p has the property that
            #eq:NoetherIdentitySecondOrderForBFieldOnMinkowskiSpacetime.maruku-equation
              %span.maruku-eq-number (13)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mover
                                %mi R
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mo{:stretchy => "false"} )
                              %mo ^
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mover
                                %mi c
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mo{:stretchy => "false"} )
                              %mrow
                                %mo ,
                                %mi μ
                                %mi ν
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %msub
                                  %mi c
                                  %mrow
                                    %mi μ
                                    %mo ,
                                    %mi ν
                            %mrow
                              %mo (
                              %msub
                                %mi c
                                %mrow
                                  %mi μ
                                  %mo ′
                                  %mo ,
                                  %mi ν
                                  %mo ′
                              %msub
                                %mo ∂
                                %mrow
                                  %msub
                                    %mi b
                                    %mrow
                                      %mi μ
                                      %mo ′
                                      %mi ν
                                      %mo ′
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
