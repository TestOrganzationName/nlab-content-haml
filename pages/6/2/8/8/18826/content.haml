                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{R}
              = succeed ")," do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
