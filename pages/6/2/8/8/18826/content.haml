                %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} locally
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of the resulting
            %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ActionLieAlgebroid"}
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local
                %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
            %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
            below.
          %p
            The
            = succeed "-perspective" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
            has been made explicit in (
            %a{:href => "BRST+complex#Barnich10"}> Barnich 10
            ).
          #GaugeParametersClosed.num_defn
            %h6#definition_8 Definition
            %p
              %strong
                (closed
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
