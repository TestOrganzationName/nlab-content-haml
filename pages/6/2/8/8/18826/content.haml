                    \\,,
            %p where now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mo ∂
                          %mi k
                        %msup
                          %mi ϵ
                          %mi α
                      %mrow
                        %mo ∂
