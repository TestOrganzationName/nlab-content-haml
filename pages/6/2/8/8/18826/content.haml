                  is an
                  %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
