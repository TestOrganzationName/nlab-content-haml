                    Q_R = 0
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              Take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              to be as in equation
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:NoetherIExpressionForInfinitesimalGaugeSymmetry"} (3)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi J
                      %mi R
                    %mo =
                    %mi A
                    %mo +
                    %mi d
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d J_R = A + d K
                    \\,.
            %p
              By the construction there,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              manifestly vanishes on the
              %a.existingWikiWord{:href => "/nlab/show/prolonged+shell"} prolonged shell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℰ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}^\infty
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ProlongedShellInJetBundle"} (?)
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivatives"} total spacetime derivatives
              of terms proportional to the components of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's second theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#NoetherIdentities"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} A = 0
              and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi J
                      %mi R
                    %mo −
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d(J_R - K) = 0
                    \\,.
            %p
              Now if the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              and
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle are trivial, then prop.
              %a.maruku-ref{:href => "#HorizontalVariationalComplexOfTrivialFieldBundleIsExact"}
              implies that
            #eq:DecompositionOfGaugSymmetryConservedCurrent.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi R
                    %mo −
                    %mi K
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J_R - K = d(...)
                    \\,.
            %p
              By restricting this equation to the
              %a.existingWikiWord{:href => "/nlab/show/prolonged+shell"} prolonged shell
              and using that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi ℰ
                            %mn ∞
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} K\vert_{\mathcal{E}^\infty} = 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi R
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi ℰ
                            %mn ∞
                      %mo =
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mo .
                      %mo .
                      %mo .
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J_R \vert_{\mathcal{E}^\infty} = d(...)
            %p
              This implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi R
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Q_R = 0
              by prop.
              %a.maruku-ref{:href => "#PullbackAlongJetProlongationIntertwinesHorizontalDerivative"}
              and
              %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#StokesTheorem"}
          %p
            This situation has a concise
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} cohomological
            incarnation:
          #dWCohomology.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorems I and II
                in terms of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/local+BV-cohomology"} local BV-cohomology
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p + 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              = succeed ")." do
                %a.maruku-ref{:href => "#GaugeParametersClosed"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              = succeed "." do
                %a.maruku-ref{:href => "#EulerLagrangeFormIsSectionOfLocalCotangentBundleOfJetBundleGaugeActionLieAlgebroid"}
            %p
              Then in the
              %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BVComplexOfOrdinaryLagrangianDensity"}
            %p
              The
              = succeed "-closure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mi BV
                      %mo +
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (s_{BV} + d)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is characterizes as the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of an
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              which is an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              and the
              %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              that corresponds to it under
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's first theorem
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#NoethersFirstTheorem"}
            %p
              Moreover, such a pair is
              = succeed "-exact" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mi BV
                      %mo +
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (s_{BV} + d)
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              is in fact an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
              as witnessed by
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's second theorem
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#NoetherIdentities"}
          %p
            (
            %a{:href => "local+BRST+cohomology#BarnichBrandtHenneaux94"}> Barnich-Brandt-Henneaux 94, top of p. 20
            )
          .proof
            %h6#proof_5 Proof
            %p
              An element of the
              %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
              in degee
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of a
              %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"} horizontal differential form
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              with the product of a horizontal form of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
              times a function proportional to the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/antifields"} antifields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi J
                              %mi v
                            %mo{:stretchy => "false"} }
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msup
                              %mi v
                              %mi a
                            %msubsup
                              %mi ϕ
                              %mi a
                              %mo ‡
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{J_v\} &amp;&amp;
                    \\\
                    \&amp;&amp;
                    \\\
                    \&amp;&amp; \{ v^a \phi^\ddagger_a dvol_\Sigma\}
                    }
            %p Its closure means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi J
                              %mi v
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mi d
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mover
                              %mover
                                %mrow
                                  %mi d
                                  %msub
                                    %mi J
                                    %mi v
                                  %mo −
                                  %msub
                                    %mi ι
                                    %mi v
                                  %msub
                                    %mi δ
                                    %mi EL
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                %mo ⏞
                              %mrow
                                %mo =
                                %mn 0
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi s
                                  %mi BV
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msup
                              %mi v
                              %mi a
                            %msubsup
                              %mi ϕ
                              %mi a
                              %mo ‡
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{J_v\} &amp;\overset{d}{\longrightarrow}&amp; \{ \overset{= 0}{\overbrace{ d J_v - \iota_v \delta_{EL}\mathbf{L} }} \}
                    \\\
                    \&amp;&amp; \uparrow\mathrlap{s_{BV}}
                    \\\
                    \&amp;&amp; \{ v^a \phi^\ddagger_a dvol_\Sigma\}
                    }
            %p where the equality in the top right corner is euqation
            %p It being exact means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo {
                              %mo .
                              %mo .
                              %mo .
                              %mo }
                          %mtd
                            %mover
                              %mo ⟶
                              %mi d
