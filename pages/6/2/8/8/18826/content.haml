                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}'
              is still a
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterized
              collection of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            %p
              We will see that for the purpose of removing the
              %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
              to the existence of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              %a.existingWikiWord{:href => "/nlab/show/Noether+identities"} Noether identities
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#NoetherIdentities"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
              is a
              = succeed "." do
                %em generating set
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "BRST+complex#Henneaux90"} Henneaux 90, section (2.8)
          #RigidInfinitesimalSymmetriesOfTheLagrangian.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rigid+infinitesimal+symmetries+of+the+Lagrangian"}> rigid infinitesimal symmetries of the Lagrangian
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi R
                    %msub
                      %mi T
                      %mi Σ
                    %mi E
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(\mathcal{G} \times_\Sigma E) \overset{R}{\longrightarrow} T_\Sigma E
              be
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParameters"}
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
              form a generating set (remark
              = succeed ")." do
                %a.maruku-ref{:href => "#GeneratingSetOfGaugeTransformations"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              of
              %em
                %a.existingWikiWord{:href => "/nlab/show/rigid+infinitesimal+symmetries+of+the+Lagrangian"} rigid infinitesimal symmetries of the Lagrangian
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              of the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
              by the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mtext rigid infinitesimal symmetries
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtext infinitesimal symmetries
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo {
                      %mtext infinitesimal gauge symmetries
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ \text{rigid infinitesimal symmetries} \right\}
                    \\;=\;
                    \\left\{
                    \\text{infinitesimal symmetries}
                    \\right\} \,/\,
                    \\left\{ \text{infinitesimal gauge symmetries}  \right\}
                    \\,.
          %p
            The following is a way to identify
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
          #NoetherIdentities.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem II
                –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Noether+identities"} Noether identities
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/bundle+morphism"} bundle morphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi R
                    %msub
                      %mi T
                      %mi Σ
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    J^\infty_\Sigma(\mathcal{G} \times_\Sigma E) \overset{R}{\longrightarrow} T_\Sigma E
            %p
              is a collection of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParameters"}
              %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi c
                        %mi α
                      %msubsup
                        %mi R
                        %mi α
                        %mi a
                      %mo +
                      %msubsup
                        %mi c
