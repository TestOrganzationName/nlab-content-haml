                          %mtd
                            %mo =
                            %mn 0
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat {R} f_{\mu \nu}
                    \&amp;=
                    \\tfrac{1}{2}
                    c_{,\mu' \nu'} \partial_{a_{\mu',\nu'}}
                    \\left(
                    a_{\nu, \mu} - a_{\mu,\nu}
                    \\right)
                    \\\
                    \&amp; =
                    \\tfrac{1}{2}
                    \\left(
                    c_{,\nu\mu} - c_{,\mu \nu}
                    \\right)
                    \\\
                    \&amp; = 0
                    \\,,
                    \\end{aligned}
            %p
              because
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              commute with each other:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %mo =
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi ν
                        %mi μ
                  %annotation{:encoding => "application/x-tex"} c_{,\mu \nu} = c_{,\nu \mu}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:JetCoodinatesSymmetry"} (?)
            %p
              Equivalently, the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
