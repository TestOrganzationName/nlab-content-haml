                              %mi 𝔤
                              %mo *
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            d_{CE} \omega \coloneqq \omega([-,-]) \;\in \; \mathfrak{g}^\ast \wedge \mathfrak{g}^\ast
                            \\,.
            %p In components:
            %p
              Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^n
              is a
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              with
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi^a)
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi c
                      %mi α
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{c_\alpha\}
              be a
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              with dual basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi c
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c^\alpha)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
              and structure constants
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi γ
                      %mi α
                    %mo{:stretchy => "false"} )
                    %msub
                      %mrow
                      %mrow
                        %mi β
                        %mi γ
                  %annotation{:encoding => "application/x-tex"} (\gamma^\alpha){}_{\beta \gamma}
              as in prop.
              %a.maruku-ref{:href => "#LieAlgebraInTermsOfChevalleyEilenbergAlgebra"}
              and with the Lie action given in components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi R
                      %mi α
                      %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R_\alpha^a)
              as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %mi CE
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} /
                                %mi 𝔤
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi c
                              %mi α
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msup
                              %mi γ
                              %mi α
                            %msub
                              %mrow
                              %mrow
                                %mi β
                                %mi γ
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi c
                              %mi β
                            %mo ∧
                            %msup
                              %mi c
                              %mi γ
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %mi CE
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} /
                                %mi 𝔤
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi ϕ
                              %mi a
                          %mtd
                            %mo =
                            %msubsup
                              %mi R
                              %mi α
                              %mi a
                            %msup
                              %mi c
                              %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_{CE(X/\mathfrak{g})} c^\alpha &amp; = \tfrac{1}{2} \gamma^\alpha{}_{\beta \gamma} \, c^\beta \wedge c^\gamma
                    \\\
                    d_{CE(X/\mathfrak{g})} \phi^a &amp; = R^a_\alpha c^\alpha
                    \\end{aligned}
            %p
              We may summarize this by writing the
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_{CE(X/\mathfrak{g})}
              as follows:
            #eq:DifferentialOnActionLieAlgebroid.maruku-equation
              %span.maruku-eq-number (16)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi c
                      %mi α
                    %msubsup
                      %mi R
                      %mi α
                      %mi a
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msup
                      %mi γ
                      %mi α
                    %msub
                      %mrow
                      %mrow
                        %mi β
                        %mi γ
                    %msup
                      %mi c
                      %mi β
                    %msup
                      %mi c
                      %mi γ
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi c
                          %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE(X/\mathfrak{g})}
                    \\;=\;
                    c^\alpha R_\alpha^a \frac{\partial}{\partial \phi^a}
                    \\;+\;
                    \\tfrac{1}{2} \gamma^{\alpha}{}_{\beta \gamma} c^\beta c^\gamma \frac{\partial}{\partial c^\alpha}
                    \\,.
            %p That this squares to zero is equivalently
            %ul
              %li
                %p
                  in degree 0 the
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} action property
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi t
                        %mo ,
                        %mi t
                        %mo ′
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \rho([t, t']) = [\rho(t), \rho(t')]
              %li
                %p
                  in degree 1 the
                  %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                  = succeed "." do
                    %a.maruku-eqref{:href => "#eq:JacobiIdentity"} (14)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mn 0
                    %mphantom
                      %mi AAA
                    %mo ⇔
                    %mphantom
                      %mi AAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mphantom
                              %mi and
                            %mspace{:width => "thinmathspace"}
                            %mtext Jacobi identity
                        %mtr
                          %mtd
                            %mtext and
                            %mspace{:width => "thinmathspace"}
                            %mtext action property
                  %annotation{:encoding => "application/x-tex"}
                    (d_{CE(X/\mathfrak{g})})^2 = 0
                    \\phantom{AAA}
                    \\Leftrightarrow
                    \\phantom{AAA}
                    \\array{
                    \\phantom{and} \, \text{Jacobi identity}
                    \\\
                    \\text{and} \, \text{action property}
                    }
            %p
              Hence as before in prop.
              %a.maruku-ref{:href => "#LieAlgebraInTermsOfChevalleyEilenbergAlgebra"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theoretic
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              is faithfully captured dually by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
            %p
              We call the
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal dual
              of this dgc-superalgebra the
              %em
                %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              acting on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p The concept emerging by this example we may consider generally:
          #LInfinityAlgebroid.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"}> super
                \-
                %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"}> Lie ∞-algebroid
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperSmoothManifolds"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              %em
                connected
                %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super
                %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"} Lie ∞-algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              is a
            %ol
              %li
                %p
                  a sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝔞
                          %mi k
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi k
                            %mo =
                            %mn 1
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} (\mathfrak{a}_k)_{ k = 1 }^\infty
                  of
                  %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
                  of
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                  %a.existingWikiWord{:href => "/nlab/show/rank"} rank
                  over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\infty(X)
                  %a.existingWikiWord{:href => "/nlab/show/graded+module"} graded module
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔞
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
                  in degrees
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} k \geq 1
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi CE
                      %annotation{:encoding => "application/x-tex"} d_{CE}
                  that makes the
                  %a.existingWikiWord{:href => "/nlab/show/graded-commutative+algebra"} graded-commutative algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Sym
                          %mrow
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi 𝔞
                          %mo •
                          %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Sym_{C^\infty(X)}(\mathfrak{a}^\ast_\bullet)
                  into a cochain
                  %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
                  (hence with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi CE
                      %annotation{:encoding => "application/x-tex"} d_{CE}
                  of degree +1) over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  (not necessarily over
                  = succeed ")," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\infty(X)
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔞
                        %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                #eq:CEAlgebra.maruku-equation
                  %span.maruku-eq-number (17)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %msub
                            %mi Sym
                            %mrow
                              %msup
                                %mi C
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi 𝔞
                            %mo •
                            %mo *
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi d
                            %mi CE
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        CE(\mathfrak{a})
                        \\;\coloneqq\;
                        \\left(
                        Sym_{C^\infty(X)}(\mathfrak{a}^\ast_\bullet)
                        \\,,\,
                        d_{CE}
                        \\right)
                        \\,.
            %p
              If we allow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
              to also have terms in non-positive degree, then we speak of a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derived+Lie+algebroid"} derived Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
              is
              %em only
              concentrated in negative degrees, we also speak of a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derived+manifold"} derived manifold
            %p
              With
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              canonically itself regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{a}) \longrightarrow C^\infty(X)
            %p
              which is the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              and zero on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝔞
                        %mrow
                          %mo ≠
                          %mn 0
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}^\ast_{\neq 0}
          %p
            (We discuss
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            between
            %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"} Lie ∞-algebroid
            below in def.
            = succeed ".)" do
              %a.maruku-ref{:href => "#HomomorphismBetweenLieAlgebroids"}
          #dgManifolds.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
                as
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+graded+manifolds"} differential graded manifolds
            %p
              Definition
              %a.maruku-ref{:href => "#LInfinityAlgebroid"}
              of
              %em
                %a.existingWikiWord{:href => "/nlab/show/derived+Lie+algebroids"} derived Lie algebroids
              is an encoding in
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
              (
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"}> homological algebra
              , in this case) of a situation that is usefully thought of in terms of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            %p
              To see this, recall the magic algebraic properties of ordinary
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#AlgebraicFactsOfDifferentialGeometry"}
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds+into+formal+duals+of+R-algebras"}> embedding of smooth manifolds into formal duals of R-algebras
                  ;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/smooth+Serre-Swan+theorem"} embedding of smooth vector bundles into formal duals of modules
            %p
              Together these imply that we may think of the
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
              underlying a
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              as being the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              on a
              %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ×
                    %msub
                      %mi 𝔞
                      %mn 2
                    %mo ×
                    %msub
                      %mi 𝔞
                      %mn 1
                    %mo ×
                    %mi X
                    %mo ×
                    %msub
                      %mi 𝔞
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ×
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \times \mathfrak{a}_2 \times \mathfrak{a}_1 \times X \times \mathfrak{a}_{-1} \times \cdots
            %p
              which is
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
              in non-vanishing degree.
            %p
              The “higher” in
              %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
              refers to the degrees higher than zero. See at
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Higher+Structures"} Higher Structures
              for exposition. Specifically if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
              has components in negative degrees, these are also called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derived+manifolds"} derived manifolds
          #BasicExamplesOfLieAlgebroids.num_example
            %h6#example_8 Example
            %p
              %strong
                (basic examples of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
            %p
              Two basic examples of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
              are:
            %ol
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  any
                  %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#SuperSmoothManifolds"}
                  %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SuperCartesianSpace"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔞
                          %mrow
                            %mo ≠
                            %mn 0
                        %mo ≔
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}_{\neq 0 } \coloneqq 0
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi CE
                        %mo ≔
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d_{CE} \coloneqq 0
                  makes it a Lie algebroid in the sense of def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#LInfinityAlgebroid"}
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                  (prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LieAlgebraInTermsOfChevalleyEilenbergAlgebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                  exhibits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  as a
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                  in the sense of def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#LInfinityAlgebroid"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} B\mathfrak{g}
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \ast/\mathfrak{g}
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  regarded as a
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                  this way.
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  as in the previous items, and for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝔤
                        %mo ×
                        %mi X
                        %mo →
                        %mi T
                        %mi X
                      %annotation{:encoding => "application/x-tex"} R \colon \mathfrak{g} \times X \to T X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(X/\mathfrak{g})
                  from def.
                  %a.maruku-ref{:href => "#ActionLieAlgebroid"}
                  defines a
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                  in the sense of def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#LInfinityAlgebroid"}
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                %p
                  In the special case that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g} = 0
                  this reduces to the first example, while for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} X = \ast
                  this reduces to the second example.
          %p
            Here is another basic examples of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
            that will plays a role:
          #HorizontalTangentLieAlgebroid.num_example
            %h6#example_9 Example
            %p
              %strong
                (horizontal
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              or more generally a
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              or more generally a
              %a.existingWikiWord{:href => "/nlab/show/locally+pro-manifold"} locally pro-manifold
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma/T\Sigma
              for the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and whose
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is generated over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              in degree 1 from the
              %a.existingWikiWord{:href => "/nlab/show/module"} module
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔞
                      %mn 1
                      %mo *
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ≃
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{a}_1^\ast \coloneqq (\Gamma(T \Sigma))^\ast \simeq\Gamma(T^\ast \Sigma) = \Omega^1(\Sigma)
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              and whose
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+dg-algebra"} de Rham dg-algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#deRhamAlgebraOfSuperDifferentialFormsIsDifferentialGradedCommutativeSuperalgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mi dR
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE( \Sigma/T\Sigma ) \coloneqq (\Omega^\bullet(\Sigma), d_{dR})
                    \\,.
            %p
              This is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
              (via remark
              = succeed ")" do
                %a.maruku-ref{:href => "#dgManifolds"}
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/shifted+tangent+bundle"} shifted tangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} T[1] \Sigma
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              More generally, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/T\Sigma
              over the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              being the
              %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal
              part of the
              %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mrow
                      %mo (
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mi Σ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mo •
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi d
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE\left(
                    J^\infty_\Sigma(E)/T\Sigma
                    \\right)
                    \\;\coloneqq\;
                    \\left(\Omega^{\bullet,0}_\Sigma(E), d\right)
                    \\,.
            %p
              The underlying
              %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/T\Sigma
              is the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)\times_\Sigma T[1]\Sigma
              of the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with the
              %a.existingWikiWord{:href => "/nlab/show/shifted+tangent+bundle"} shifted tangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              There is then a canonical homomorphism of Lie algebroids (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomomorphismBetweenLieAlgebroids"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi J
                              %mi Σ
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi E
