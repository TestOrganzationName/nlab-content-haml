                  %annotation{:encoding => "application/x-tex"}
                    v
                    \\;
                    \\coloneqq
                    \\;
                    \\frac{\delta_{EL} L }{\delta \phi^a} \kappa^{[a b]} \, \partial_{\phi^a}
                    \\;\in\;
                    \\Gamma_E^{ev}( T_\Sigma E )
            %p
              by smooth coefficient functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi κ
                      %mrow
                        %mi a
                        %mi b
                  %annotation{:encoding => "application/x-tex"} \kappa^{a b}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi κ
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mi b
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
