            %p
              where now the equality in the second term from the left is equation
              %a.maruku-eqref{:href => "#eq:DecompositionOfGaugSymmetryConservedCurrent"} (5)
              for
              %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
              corresponding to
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ConservedChargeOfInfinitesimalGaugeSymmetryVanishes"}
          %p
            We will need some further technical results on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Noether+identities"} Noether identities
          #NoetherOperator.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Noether+operator"}> Noether operator
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p + 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              = succeed ")." do
                %a.maruku-ref{:href => "#GaugeParametersClosed"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              = succeed "." do
                %a.maruku-ref{:href => "#EulerLagrangeFormIsSectionOfLocalCotangentBundleOfJetBundleGaugeActionLieAlgebroid"}
            %p
              A
              %em Noether operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is a
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialOperator"}
              %a.existingWikiWord{:href => "/nlab/show/vertical+cotangent+bundle"} vertical cotangent bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#VerticalTangentBundle"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              %a.existingWikiWord{:href => "/nlab/show/real+line+bundle"} real line bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi N
                      %mrow
                        %mi a
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                    %mfrac
                      %mrow
                        %msup
                          %mi d
                          %mi k
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                        %mi ⋯
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mi k
                    %msub
                      %mi ω
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    N(\omega)
                    \\;=\;
                    \\underset{k \in \mathbb{N}}{\sum}
                    N^{a \mu_1 \cdots \mu_k}
                    \\frac{d^k}{d x^{\mu_1} \cdots d x^{\mu_k}} \omega_a
            %p
              such that it annihilates the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              (prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi N
                      %mrow
                        %mi a
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                    %mfrac
                      %mrow
                        %msup
                          %mi d
                          %mi k
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                        %mi ⋯
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mi k
                    %mfrac
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                      %mrow
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{k \in \mathbb{N}}{\sum}
                    N^{a \mu_1 \cdots \mu_k}
                    \\frac{d^k}{d x^{\mu_1} \cdots d x^{\mu_k}} \frac{\delta_{EL} L}{\delta \phi^a}
                    \\;=\; 0
                    \\,.
            %p
              Given For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              an
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              which is an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ⋅
                    %mi N
                  %annotation{:encoding => "application/x-tex"} v \cdot N
              by
            #eq:MultiplyingANoetherOperatorWithAnInfinitesimalSymmetry.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ⋅
                    %mi N
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi v
                      %mo ^
                    %mrow
                      %mo (
                      %msup
                        %mi N
                        %mrow
                          %mi a
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi N
                      %mi a
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mi v
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi a
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (v \cdot N)^{a \mu_1 \cdots \mu_k}
                    \\;\coloneqq\;
                    \\widehat{v}\left(
                    N^{a \mu_1 \cdots \mu_k}
                    \\right)
                    \\;-\;
                    N^a \circ (\mathrm{D}_v)^\ast_a
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{v}
              denotes the prolongation of the
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mi v
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (\mathrm{D}_v)^\ast
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally adjoint differential operator
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+derivative"} evolutionary derivative
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FieldDependentDifferentialOperatorDerivative"}
          %p
            (
            %a{:href => "BRST+complex#Barnich10"}> Barnich 10 (3.1) and (3.5)
            )
          #LieAlgebraActionOfInfinitesimalSymmetriesOfTheLagrangianOnNoetherOperators.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                of
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Noether+operators"} Noether operators
            %p
              The operation
              %a.maruku-eqref{:href => "#eq:MultiplyingANoetherOperatorWithAnInfinitesimalSymmetry"} (6)
              exhibits a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldLieAlgebra"}
              = succeed ")," do
                %a.maruku-ref{:href => "#NoetherOperator"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ⋅
                        %mi N
                      %annotation{:encoding => "application/x-tex"} v \cdot N
                  is again a Noether operator;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 2
                        %mo ⋅
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msub
                          %mi v
                          %mn 2
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ⋅
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo ⋅
                        %mi N
                      %annotation{:encoding => "application/x-tex"} v_1 \cdot (v_2 \cdot N) - v_2 \cdot (v_1 \cdot N) = [v_1, v_2] \cdot N
                  \.
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              denotes the map which identifies a
              %a.existingWikiWord{:href => "/nlab/show/Noether+identity"} Noether identity
              with an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
              by
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's second theorem
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#NoetherIdentities"}
            #eq:LieActionOnNoetherOperatorGivesLieBracketUnderNoetherTheorem.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mrow
                      %mo (
                      %mi v
                      %mo ⋅
                      %mi N
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mi v
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \left(
                    v \cdot N
                    \\right)
                    \\;=\;
                    \\left[ v, \rho(N)\right]
                    \\,,
            %p
              where on the right we have again the
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              of
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
              from (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldLieAlgebra"}
          %p
            (
            %a{:href => "BRST+complex#Barnich10"}> Barnich 10, prop. 3.1 and (3.8)
            )
          .proof
            %h6#proof_6 Proof
            %p
              For the first statement observe that by the
              %a.existingWikiWord{:href => "/nlab/show/product+law"} product law
              for
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo =
                            %mover
                              %mi v
                              %mo ^
                            %mrow
                              %mo (
                              %mi N
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi δ
                                %mi EL
                              %mi L
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi v
                              %mo ^
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi k
                                  %mo ∈
                                  %mi ℕ
                              %msup
                                %mi N
                                %mrow
                                  %mi a
                                  %msub
                                    %mi μ
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi μ
                                    %mi k
                              %mo )
                            %mo −
                            %mrow
                              %mo (
                              %msup
                                %mi N
                                %mi a
                              %mo ∘
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi{:mathvariant => "normal"} D
                                %mi v
                              %msubsup
                                %mo{:stretchy => "false"} )
                                %mi a
                                %mi b
                              %mrow
                                %mo (
                                %mfrac
                                  %mrow
                                    %msub
                                      %mi δ
                                      %mi EL
                                    %mi L
                                  %mrow
                                    %mi δ
                                    %msup
                                      %mi ϕ
                                      %mi a
                                %mo )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    0
                    \&amp; =
                    \\widehat{v}\left(
                    N(\delta_{EL} L)
                    \\right)
                    \\\
                    \&amp; =
                    \\widehat{v}
                    \\left(
                    \\underset{k \in \mathbb{N}}{\sum} N^{a \mu_1 \cdots \mu_k}
                    \\right)
                    \-
                    \\left(
                    N^a \circ (\mathrm{D}_v)_a^b\left(  \frac{\delta_{EL} L}{\delta \phi^a} \right)
                    \\right)
                    \\,,
                    \\end{aligned}
            %p
              where on the right we used
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:TowardsProofThatSymmetriesPreserveTheShell"} (?)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Here are examples of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
          #InfinitesimalGaugeSymmetryElectromagnetism.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              of
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#ElectromagnetismLagrangianDensity"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((x^\mu), (a_\mu))
              the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %msup
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;=\;
                    \\tfrac{1}{2} f_{\mu \nu} f^{\mu \nu}
                    \\, dvol_\Sigma
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %mo ≔
                    %msub
                      %mi a
                      %mrow
                        %mi ν
                        %mo ,
                        %mi μ
                  %annotation{:encoding => "application/x-tex"} f_{\mu \nu} \coloneqq a_{\nu,\mu}
              is the universal
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#JetFaraday"}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ≔
                    %mi Σ
                    %mo ×
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq \Sigma \times \mathbb{R}
              be the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+line+bundle"} trivial line bundle
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
              bundle (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((x^\mu), c)
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parametrized
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (2)
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi a
                          %mi μ
                  %annotation{:encoding => "application/x-tex"}
                    R
                    \\;=\;
                    c_{,\mu} \partial_{a_\mu}
            %p
              with prolongation (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
            #eq:EMProlongedSymmetryVectorField.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi a
                          %mi μ
                    %mo +
                    %msub
                      %mi c
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi a
                          %mrow
                            %mi μ
                            %mo ,
                            %mi ν
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat R
                    \\;=\;
                    c_{,\mu} \partial_{a_\mu}
                    +
                    c_{,\mu \nu} \partial_{a_{\mu,\nu}}
                    +
                    \\cdots
                    \\,.
            %p
              This is because already the universal
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              is
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              under this flow:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi R
                              %mo ^
                            %msub
                              %mi f
                              %mrow
                                %mi μ
                                %mi ν
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msub
                              %mi c
                              %mrow
                                %mo ,
                                %mi μ
                                %mo ′
                                %mi ν
                                %mo ′
                            %msub
                              %mo ∂
                              %mrow
                                %msub
                                  %mi a
                                  %mrow
                                    %mi μ
                                    %mo ′
                                    %mo ,
                                    %mi ν
                                    %mo ′
                            %mrow
                              %mo (
                              %msub
                                %mi a
                                %mrow
                                  %mi ν
                                  %mo ,
                                  %mi μ
                              %mo −
                              %msub
                                %mi a
                                %mrow
                                  %mi μ
                                  %mo ,
                                  %mi ν
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mrow
                              %mo (
                              %msub
                                %mi c
                                %mrow
                                  %mo ,
                                  %mi ν
                                  %mi μ
                              %mo −
                              %msub
                                %mi c
                                %mrow
                                  %mo ,
                                  %mi μ
                                  %mi ν
                              %mo )
                        %mtr
