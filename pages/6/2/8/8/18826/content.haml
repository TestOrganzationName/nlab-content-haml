              %a.existingWikiWord{:href => "/nlab/show/BV-complex"} BV-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi ℰ
                          %mi BV
                  %annotation{:encoding => "application/x-tex"} \Omega^{0,0}_\Sigma(E,\varphi)\vert_{\mathcal{E}_{BV}}
              of local observables (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BVComplexOfOrdinaryLagrangianDensity"}
              %a.existingWikiWord{:href => "/nlab/show/homological+resolution"} homological resolution
              of the algebra of functions on the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
              in the
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#ShellForSpacetimeIndependentLagrangians"}
              %a.maruku-eqref{:href => "#eq:ComparisonMorphismFromOrdinaryBVComplexToLocalObservables"} (?)
              is a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              precisely if there is no non-trivial (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialImplicialInfinitesimalGaugeTransformations"}
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#ImplicitInfinitesimalGaugeSymmetry"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mn 0
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi φ
                      %mo{:stretchy => "false"} )
