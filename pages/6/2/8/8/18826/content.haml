                                %mi v
                                %mo{:stretchy => "false"} ^
                            %msub
                              %mi Θ
                              %mi BFV
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{L}_{\hat v} \mathbf{L}
                    \&amp; =
                    \\iota_{\hat v} \delta \mathbf{L}
                    \\\
                    \&amp;=
                    \\iota_{\hat v} ( \delta_{EL}\mathbf{L} - d \Theta_{BFV} )
                    \\\
                    \&amp; =
                    \\iota_\epsilon \frac{\delta_{EL}L}{\delta \phi^a} \delta \phi^a + d \iota_{\hat v}\Theta_{BFV}
                    \\\
                    \&amp; =
                    \\underset{= 0}{
                    \\underbrace{
                    \\left( \frac{\delta_{EL} L }{\delta \phi^a} \right)
                    \\left( \frac{\delta_{EL} L }{\delta \phi^b} \right)
                    \\kappa^{[a b]}
                    }
                    }
                    \\,
                    dvol_\Sigma
                    \\;+\; d \iota_{\hat v} \Theta_{BFV}
                    \\\
                    \&amp; =
                    d \iota_{\hat v} \Theta_{BFV}
                    \\end{aligned}
            %p
              Here the first steps are just recalling those in the proof of
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem I
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#NoethersFirstTheorem"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
            %p Notice that this means that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Noether+current"} Noether current
                  %a.maruku-eqref{:href => "#eq:NoetherCurrent"} (?)
                  vanishes:
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi J
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} J_{\hat v} = 0
              %li
                %p
                  the infinitesimal symmetry vanishes
                  %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                  = succeed ":" do
                    %a.maruku-eqref{:href => "#eq:InclusionOfOnShellSpaceOfFieldHistories"} (?)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %msub
                            %mo{:stretchy => "false"} |
