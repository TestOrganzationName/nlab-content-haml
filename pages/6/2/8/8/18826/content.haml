                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\Omega^{0,0}_{\Sigma}(E,\varphi)\vert_{\mathcal{E}_{BV}}
                    \\overset{\simeq}{\longrightarrow}
                    \\Omega^{0,0}_{\Sigma}(E,\varphi)\vert_{\mathcal{E}}
                    \\right)
                    \\;\Leftrightarrow\;
                    \\left(
                    \\array{
                    \\text{there are no non-trivial}
