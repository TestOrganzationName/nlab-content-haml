                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \hat v \vert_{\mathcal{E}} = 0
            %p
              Therefore these implicit infinitesimal gauge symmetries are called the
              = succeed "." do
                %em trivial infinitesimal gauge transformations
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "BRST+complex#Henneaux90"} Henneaux 90, section 2.5
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Proposition
            %a.maruku-ref{:href => "#NonTrivialImplicitInfinitesimalGaugeSymmetriesPbstructExistenceOfCauchySurfaces"}
            implies that we need a good handle on determining whether the space of non-trivial compactly supported
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
            modulo trivial ones is non-zero. This
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            turns out to be neatly captured by methods of
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            applied to the
            %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
            (def.
            = succeed "):" do
              %a.maruku-ref{:href => "#BVComplexOfOrdinaryLagrangianDensity"}
          #InterpretationCohomologyOfBVComplex.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              is spacetime-independent (example
              = succeed ")," do
                %a.maruku-ref{:href => "#ShellForSpacetimeIndependentLagrangians"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi φ
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \Sigma \times \{\varphi\} \hookrightarrow \mathcal{E}
              be a constant section of the shell
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ConstantSectionOfTrivialShellBundle"} (?)
            %p
              By inspection we find that the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the local
              %a.existingWikiWord{:href => "/nlab/show/BV-complex"} BV-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi ℰ
                          %mi BV
                  %annotation{:encoding => "application/x-tex"} \Omega^{0,0}_{\Sigma,cp}(E,\varphi)\vert_{\mathcal{E}_{BV}}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BVComplexOfOrdinaryLagrangianDensity"}
            %p
              In degree 0 the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the
              %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
              coming from degree -1 and modulo
              = succeed "-exact" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mrow
                      %mo (
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi cp
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %msub
                        %mi T
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi φ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi s
                            %mi BV
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mn 0
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi φ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    im\left( \Gamma_{\Sigma,cp}(J^\infty_\Sigma T_\Sigma(E,\varphi)) \overset{s_{BV}}{\to} \Omega^{0,0}_\Sigma(E,\varphi)/im(d) \right)
            %p
              is the ideal of functions modulo
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(d)
              that vanish
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %em from
              degree 0 to degree 1 vanishes, the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              in this degree is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mn 0
                            %mrow
                              %mo (
                              %msubsup
                                %mi Ω
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mi cp
                                %mrow
                                  %mn 0
                                  %mo ,
                                  %mn 0
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo ,
                              %mi φ
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} |
                                %mrow
                                  %msub
                                    %mi ℰ
                                    %mi BV
                              %mo{:stretchy => "false"} |
                              %mi d
                              %mo )
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi Ω
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi cp
                              %mrow
                                %mn 0
                                %mo ,
                                %mn 0
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo ,
                            %mi φ
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mi ℰ
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    H^0\left(\Omega^{0,0}_{\Sigma,cp}(E,\varphi)\vert_{\mathcal{E}_{BV}}\vert d\right)
                    \&amp; \simeq
                    \\Omega^{0,0}_{\Sigma,cp}(E,\varphi)\vert_{\mathcal{E}}/im(d)
                    \\end{aligned}
            %p
              of functions on the
