                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
