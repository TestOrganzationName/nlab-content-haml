                        %mi d
                        %msup
                          %mi x
                          %mi μ
                    %msup
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %mi δ
                    %msub
                      %mi a
                      %mi ν
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL}\mathbf{L}
                    \\;=\;
                    \\frac{d}{d x^\mu }f^{\mu \nu} \delta a_\nu \, dvol_\Sigma
            %p
              of the theory (example
              = succeed ")," do
                %a.maruku-ref{:href => "#ElectromagnetismEl"}
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#MaxwellVacuumEquation"}
              %a.existingWikiWord{:href => "/nlab/show/Noether+identity"} Noether identity
              (prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#NoetherIdentities"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mi μ
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mi ν
                    %msup
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d x^\mu} \frac{d}{d x^\nu} f^{\mu \nu} = 0
                    \\,,
            %p again due to the fact that partial derivatives commute with each other.
            %p
              This is the archetypical
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
              that gives
              %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
              its name.
          %p More generally:
          #InfinitesimalGaugeSymmetryOfYangMillsTheory.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#YangMillsLagrangian"}
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
