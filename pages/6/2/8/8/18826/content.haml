                    \\,.
            %p
              In terms of the components
              %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (2)
              this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi ϵ
                        %mi α
                      %msubsup
                        %mi R
                        %mi α
                        %mi a
                      %mo +
                      %mfrac
                        %mrow
                          %msup
                            %mo ∂
                            %mn 2
                          %msup
                            %mi ϵ
                            %mi α
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi μ
                      %msubsup
                        %mi R
                        %mi α
                        %mrow
                          %mi a
                          %mi μ
                      %mo +
                      %mfrac
                        %mrow
                          %mo ∂
                          %msup
                            %mi ϵ
                            %mi α
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi μ
                          %mo ∂
                          %msup
                            %mi x
                            %mi ν
                      %msubsup
