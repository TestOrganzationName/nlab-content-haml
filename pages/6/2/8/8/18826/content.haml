                      %mi Σ
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
