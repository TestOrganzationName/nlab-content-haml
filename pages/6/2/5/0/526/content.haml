          %h2#definition Definition
          %p
            A
            %strong comonoid
            (or
            = succeed ")" do
              %strong comonoid object
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℳ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{M}^{op}
            (which canonically becomes a monoidal category via the same
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            operation as in
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
          %p
            With the usual definition of
            %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            as having a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit"} unit
