                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                both on the light cone and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %msub
                        %mi k
                        %mn 0
                      %mo &gt;
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mo ⇔
                      %mspace{:width => "thickmathspace"}
                      %mo ±
                      %msup
                        %mi x
                        %mn 0
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \pm k_0 \gt 0 \;\Leftrightarrow\; \pm x^0 \gt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
