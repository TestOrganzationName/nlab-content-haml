                                    %mo{:stretchy => "false"} →
                                %mo ⏟
                              %mrow
                                %mo ≔
                                %mi H
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi y
                                %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Delta_H(x,y)
                    \&amp; =
                    \\frac{1}{(2\pi)^p}
                    \\int \frac{1}{2 \omega(\vec k)/c}
                    e^{-i \omega(\vec k)(x^0 - y^0)/c + i \vec k \cdot (\vec x - \vec y) }
                    \\, d^p \vec k
                    \\\
                    \&amp; =
                    \\tfrac{i}{2}
                    \\underset{= \Delta_S(x,y)}{
                    \\underbrace{
                    \\frac{-1}{(2\pi)^p}
                    \\int
                    \\frac{1}{\omega(\vec k)/c}
                    \\sin\left( \omega(\vec k)(x^0 - y^0)/c \right)
                    e^{i \vec k \cdot (\vec x - \vec y) }
                    \\, d^p \vec k
                    }}
                    \\;+\;
                    \\underset{
                    \\coloneqq H(x,y)
                    }{
                    \\underbrace{
                    \\frac{1}{(2\pi)^p}
                    \\int \frac{1}{2 \omega(\vec k)/c}
                    \\cos\left( \omega(\vec k)(x^0 - y^0)/c  \right)
                    e^{i \vec k \cdot (\vec x - \vec y) }
                    \\, d^p \vec k
                    }}
                    \\end{aligned}
            %p
              On the left this identifies the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              by
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CausalPropagatorModeExpansionForKleinGordonOnMinkowskiSpacetime"} (13)
              = succeed "." do
                %a.maruku-ref{:href => "#ModeExpansionOfCausalPropagatorForKleinGordonOnMinkowski"}
            %p
              The second summand changes, both under complex conjugation as well as under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo −
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x-y) \mapsto (y-x)
              %a.existingWikiWord{:href => "/nlab/show/change+of+integration+variables"} change of integration variables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} →
                    %mo ↦
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec k \mapsto - \vec k
              (because the
              %a.existingWikiWord{:href => "/nlab/show/cosine"} cosine
              is an even function). This does not change the integral, and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is symmetric.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#FeynmanPropagator
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
          %p
            We have seen that the
            %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive
            %a.existingWikiWord{:href => "/nlab/show/frequency"} frequency
            component of the
            %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi S
                %annotation{:encoding => "application/x-tex"} \Delta_S
            for the
            %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            on
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#AdvancedRetardedPropagatorsForKleinGordonOnMinkowskiSpacetime"}
            %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi H
                %annotation{:encoding => "application/x-tex"} \Delta_H
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#StandardHadamardDistributionOnMinkowskiSpacetime"}
            = succeed "," do
              %a.maruku-ref{:href => "#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
            %a.maruku-eqref{:href => "#eq:DeompositionOfHadamardPropagatorOnMinkowkski"} (17)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi Δ
                            %mi H
                        %mtd
                          %mo =
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi i
                              %mn 2
                          %msub
                            %mi Δ
                            %mi S
                          %mo +
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi i
                              %mn 2
                          %mrow
                            %mo (
                            %msub
                              %mi Δ
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi Δ
                              %mo −
                            %mo )
                          %mo +
                          %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\Delta_H
                  \&amp; =
                  \\tfrac{i}{2} \Delta_S
                  +
                  H
                  \\\
                  \&amp; =
                  \\tfrac{i}{2}
                  \\left(
                  \\Delta_+ - \Delta_-
                  \\right)
                  +
                  H
                  \\end{aligned}
                  \\,.
          %p There is an evident variant of this combination, which will be of interest:
          #FeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                for
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              for the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              is the
              %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mn 2
                    %mrow
                      %mo (
                      %msub
                        %mi Δ
                        %mo +
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi Δ
                        %mo −
