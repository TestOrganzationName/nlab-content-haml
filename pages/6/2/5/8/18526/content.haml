                    \\frac{- 1}{(2\pi)^{2} {\vert \vec x - \vec y\vert}}
                    \\frac{d}{d {\vert \vec x - \vec y \vert } }
                    \\underset{  \kappa \in \mathbb{R}  }{\int}
                    \\frac{ 1 }{ \omega(\kappa)/c }
