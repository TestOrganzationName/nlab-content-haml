              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              according to prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
            %p
