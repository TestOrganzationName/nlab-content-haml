          #SingularSupportOfFeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime.num_prop
            %h6#proposition_13 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                of
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                for
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              of the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
              and of the
              %a.existingWikiWord{:href => "/nlab/show/anti-Feynman+propagator"} anti-Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mover
                        %mi F
                        %mo ¯
                  %annotation{:encoding => "application/x-tex"} \Delta_{\overline{F}}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StandardHadamardDistributionOnMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.existingWikiWord{:href => "/nlab/show/translation"} translation
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariance
              as a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              in a single variable, is the
              %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
              of the origin:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
