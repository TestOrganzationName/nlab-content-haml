              %em
                %a.existingWikiWord{:href => "/nlab/show/anti-Feynman+propagator"} anti-Feynman propagator
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
