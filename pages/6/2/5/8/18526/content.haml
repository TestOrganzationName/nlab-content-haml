                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi C
                      %mrow
                        %mo ±
                        %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G_{\pm}
                    \\;\colon\;
                    C^\infty_{cp}(\mathbb{R}^{p,1})
                    \\longrightarrow
                    C^\infty_{\pm cp}(\mathbb{R}^{p,1})
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functionals"} continuous linear functionals
              in the standard sense of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              %a.existingWikiWord{:href => "/nlab/show/Schwartz+kernel+theorem"} Schwartz kernel theorem
              implies the existence of
              %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
              being
              %a.existingWikiWord{:href => "/nlab/show/distributions+in+two+variables"} distributions in two variables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ±
                    %mo ∈
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_{\pm} \in \mathcal{D}(\mathbb{R}^{p,1} \times \mathbb{R}^{p,1})
            %p
              such that, in the notation of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mo ±
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mi p
                            %mo ,
                            %mn 1
                    %msub
                      %mi Δ
                      %mo ±
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi dvol
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (G_\pm \alpha)(x)
                    \\;=\;
                    \\underset{\mathbb{R}^{p,1}}{\int} \Delta_{\pm}(x,y) \alpha(y) \, dvol(y)
                    \\,.
            %p
              These integral kernels are the advanced/retarded “
              %a.existingWikiWord{:href => "/nlab/show/propagators"}> propagators
              ”. We now compute these
              %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
              by making an Ansatz and showing that it has the defining properties, which identifies them by the uniqueness statement of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctionsForGreenHyperbolicOperatorAreUnique"}
            %p
              We make use of the fact that the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
              is
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              under the defnining
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+group"} Poincaré group
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
              of the
              %a.existingWikiWord{:href => "/nlab/show/translation+group"} translation group
              and the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
              is invariant, in particular, under
              %a.existingWikiWord{:href => "/nlab/show/translations"} translations
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              it is clear that the propagators, as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/distribution+in+two+variables"} distribution in two variables
            #eq:TranslationInvariantKleinGordonPropagatorsOnMinkowskiSpacetime.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ±
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Δ
                      %mo ±
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_{\pm}(x,y) = \Delta_{\pm}(x-y)
                    \\,.
            %p
              Since moreover the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
              is
              %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally self-adjoint
              (
              %a{:href => "Klein-Gordon+equation#FormallySelfAdjointKleinGordonOperator"}> this prop.
              ) this implies that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              the Klein the equation
              %a.maruku-eqref{:href => "#eq:AdvancedRetardedGreenFunctionIsRightInverseToDiffOperator"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∘
                    %msub
                      %mi G
                      %mo ±
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"}
                    P \circ G_\pm  = id
            %p
              is equivalent to the equation
              %a.maruku-eqref{:href => "#eq:AdvancedRetardedGreenFunctionIsLeftInverseToDiffOperator"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo ±
                    %mo ∘
                    %mi P
                    %mo =
                    %mi id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G_\pm \circ P = id
                    \\,.
            %p
              Therefore it is sufficient to solve for the first of these two equation, subject to the defining support conditions. In terms of the
              %a.existingWikiWord{:href => "/nlab/show/propagator"} propagator
              %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
              this means that we have to solve the
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
              equation
            #eq:KleinGordonEquationOnAdvacedRetardedPropagator.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi μ
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi ν
                      %mo −
                      %msup
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi m
                                %mi c
                              %mi ℏ
                          %mo )
                        %mn 2
                      %mo )
                    %msub
                      %mi Δ
                      %mo ±
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\eta^{\mu \nu}
                    \\frac{\partial}{\partial x^\mu}
                    \\frac{\partial}{\partial x^\nu}
                    \-
                    \\left( \tfrac{m c}{\hbar} \right)^2
                    \\right)
                    \\Delta_\pm(x-y)
                    \\;=\;
                    \\delta(x-y)
            %p
              subject to the condition that the
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} distributional support
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mrow
                      %mo (
                      %msub
                        %mi Δ
                        %mo ±
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⊂
                    %mrow
                      %mo {
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo −
                        %mi y
                        %msubsup
                          %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                      %mo &lt;
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mo ±
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mn 0
                      %mo −
                      %msup
                        %mi y
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    supp\left( \Delta_{\pm}(x-y) \right)
                    \\subset
                    \\left\{
                    {\vert x-y\vert^2_\eta}\lt 0
                    \\;\,,\;
                    \\pm(x^0 - y^ 0) \gt 0
                    \\right\}
                    \\,.
            %p
              We make the
              %em Ansatz
              that we assume that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mo ±
                    %annotation{:encoding => "application/x-tex"} \Delta_{\pm}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo −
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x-y
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ±
                    %mo ∈
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_\pm \in \mathcal{S}'(\mathbb{R}^{p,1})
                    \\,,
            %p
              hence amenable to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              = succeed "." do
                %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctionsForGreenHyperbolicOperatorAreUnique"}
            %p
              By
              %a{:href => "Fourier+transform#BasicPropertiesOfFourierTransformOverCartesianSpaces"} this prop.
              the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} distributional Fourier transform
              of equation
              %a.maruku-eqref{:href => "#eq:KleinGordonEquationOnAdvacedRetardedPropagator"} (7)
              is
            #eq:FourierVersionOfPDEForKleinGordonAdvancedRetardedPropagator.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi η
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msub
                                %mi k
                                %mi μ
                              %msub
                                %mi k
                                %mi ν
                              %mo −
                              %msup
                                %mrow
                                  %mo (
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mrow
                                        %mi m
                                        %mi c
                                      %mi ℏ
                                  %mo )
                                %mn 2
                              %mo )
                            %mover
                              %mrow
                                %msub
                                  %mi Δ
                                  %mo ±
                              %mo ^
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mover
                              %mi δ
                              %mo ^
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    
                    \\left(
                    \- \eta^{\mu \nu} k_\mu k_\nu - \left( \tfrac{m c}{\hbar} \right)^2
                    \\right)
                    \\widehat{\Delta_{\pm}}(k)
                    \&amp; =
                    \\widehat{\delta}(k)
                    \\\
                    \&amp; =
                    1
                    \\end{aligned}
                    \\,,
            %p
              where in the second line we used the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              of the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              from
              = succeed "." do
                %a{:href => "Dirac+distribution#FourierTransformOfDeltaDistribution"} this example
            %p
              Notice that this implies that the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              of the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi S
                    %mo ≔
                    %msub
                      %mi Δ
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi Δ
                      %mo −
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_S \coloneqq \Delta_+ - \Delta_-
            %p satisfies the homogeneous equation:
            #eq:FourierVersionOfPDEForKleinGordonCausalPropagator.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi k
                        %mi μ
                      %msub
                        %mi k
                        %mi ν
                      %mo −
                      %msup
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi m
                                %mi c
                              %mi ℏ
                          %mo )
                        %mn 2
                      %mo )
                    %mover
                      %mrow
                        %msub
                          %mi Δ
                          %mi S
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \- \eta^{\mu \nu} k_\mu k_\nu - \left( \tfrac{m c}{\hbar} \right)^2
                    \\right)
                    \\widehat{\Delta_S}(k)
                    \\;=\;
                    0
                    \\,,
            %p
              Hence we are now reduced to finding solutions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi Δ
                          %mo ±
                      %mo ^
                    %mo ∈
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{\Delta_\pm} \in \mathcal{S}'(\mathbb{R}^{p,1})
              to
              %a.maruku-eqref{:href => "#eq:FourierVersionOfPDEForKleinGordonAdvancedRetardedPropagator"} (8)
              such that their
              %a.existingWikiWord{:href => "/nlab/show/Fourier+inversion+theorem"} Fourier inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ±
                  %annotation{:encoding => "application/x-tex"} \Delta_\pm
              has the required
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support
              properties.
            %p
              We discuss this by a variant of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
            %p
              Suppose the following
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              of
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              in the
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{R}^{p,1}
              exists in the space of
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
            #eq:LimitOverImaginaryOffsetForFourierTransformedAdvancedRetardedPropagator.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi ϵ
                            %mo ∈
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mi ϵ
                            %mo →
                            %mn 0
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi k
                          %mn 0
                        %mo ∓
                        %mi i
                        %mi ϵ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo −
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mover
                            %mi k
                            %mo{:stretchy => "false"} →
                          %msup
                            %mo{:stretchy => "false"} |
                            %mn 2
                        %mo −
                        %msup
                          %mrow
                            %mo (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi m
                                  %mi c
                                %mi ℏ
                            %mo )
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{ {\epsilon \in (0,\infty)} \atop { \epsilon \to 0 } }{\lim}
                    \\frac{1}{ (k_0 \mp i \epsilon)^2  - {\vert \vec k\vert^2} - \left( \tfrac{m c}{\hbar} \right)^2 }
                    \\;\in\;
                    \\mathcal{D}'(\mathbb{R}^{p,1})
            %p
              meaning that for each
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^{p,1})
              the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi ϵ
                            %mo ∈
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mi ϵ
                            %mo →
                            %mn 0
                    %munder
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mi p
                            %mo ,
                            %mn 1
                    %mfrac
                      %mrow
                        %mi b
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi k
                          %mn 0
                        %mo ∓
                        %mi i
                        %mi ϵ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo −
                        %msup
