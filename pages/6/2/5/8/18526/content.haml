                    ( k_0 + \omega(\vec k)/c )
                    ( k_0 - \omega(\vec k)/c )
                    }
                    \\,d k_0
                    \\,d^p \vec k
                    \\\
                    \&amp; =
                    (2\pi)^{-(p+1)}
                    2\pi i
                    \\int
                    \\left(
                    \\frac{
                    e^{i \omega(\vec k) (x^0 - y^0)/c} e^{i \vec k \cdot (\vec x - \vec y)}
                    }
                    {
                    2 \omega(\vec k)/c
                    }
