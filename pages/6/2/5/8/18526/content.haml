                    \\frac{
                    e^{ - i \omega(\vec k) (x^0 - y^0)/c} e^{i \vec k \cdot (\vec x - \vec y)}
                    }{
                    2 \omega(\vec k)/c
                    }
                    \\right)
                    \\,d^p \vec k
                    \\\
                    \&amp; =
                    i
                    (2\pi)^{-p}
                    \\int
                    \\frac{1}{\omega(\vec k)/c}
                    sin\left( \omega(\vec k)(x^0 - y^0)/c \right)
                    e^{i \vec k \cdot (\vec x - \vec y)}
