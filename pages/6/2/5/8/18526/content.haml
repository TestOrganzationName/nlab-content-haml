                    \\Delta_{\overline{F}}
                    \\coloneqq
                    \\tfrac{i}{2}
                    \\left(
                    \\Delta_+ + \Delta_-
                    \\right)
                    \-
                    H
                    \\,.
          #ModeExpansionForFeynmanPropagatorOfKleinGordonEquationOnMinkowskiSpacetime.num_prop
