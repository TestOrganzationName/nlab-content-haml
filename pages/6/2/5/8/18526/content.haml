                          %mo{:stretchy => "false"} |
                          %mi k
                          %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mo ±
                        %msub
                          %mi k
                          %mn 0
                        %mo &gt;
                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mo ⇔
                        %mspace{:width => "thickmathspace"}
