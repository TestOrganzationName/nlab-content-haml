            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
