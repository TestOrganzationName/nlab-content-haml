                    \-
                    e^{-i {\vert \vec k\vert}\, {\vert \vec x - \vec y\vert}}
                    \\right)
                    }{
                    \\underbrace{
                    \\underset{ \cos(\theta) \in [-1,1] }{\int}
                    e^{ i {\vert \vec k\vert} {\vert \vec x - \vec y\vert} \cos(\theta) }
                    d \cos(\theta)
                    }
