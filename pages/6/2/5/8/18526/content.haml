                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,k)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
