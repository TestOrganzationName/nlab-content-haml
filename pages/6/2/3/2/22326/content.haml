            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+S.+Howe"}> Paul S. Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"} Dimitrios Tsimpis
                = succeed "," do
                  %em On higher-order corrections in M theory
                = succeed "," do
                  %a{:href => "https://doi.org/10.1088/1126-6708/2003/09/038"} doi:10.1088/1126-6708/2003/09/038
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0305129"} arXiv:hep-th/0305129
            %li#Tsimpis04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"}> Dimitrios Tsimpis
                ,
                = succeed "," do
