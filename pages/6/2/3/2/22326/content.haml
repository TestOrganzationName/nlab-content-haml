                %em
                  %a{:href => "https://inspirehep.net/conferences/976239"} Deserfest: A Celebration of the Life and Works of Stanley Deser
                (2004) 137-149 [
                %a{:href => "https://inspirehep.net/literature/657136"}> inspire:657136
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0408177"} arXiv:hep-th/0408177
            %li#CGNT04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ulf+Gran"} Ulf Gran
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"} Dimitrios Tsimpis
                = succeed "," do
