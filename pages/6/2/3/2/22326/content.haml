          %title Higher curvature corrections to  supergravity
          %h3#ReferencesOnHigherCurvatureCorrectionsIn11dSupergravity
            Higher curvature corrections to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 11
                %annotation{:encoding => "application/x-tex"} D=11
            supergravity
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
            to
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            (i.e. in
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Arkady+Tseytlin"}> Arkady Tseytlin
              ,
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi R
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} R^4
                  terms in 11 dimensions and conformal anomaly of (2,0) theory
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0005072"} arXiv:hep-th/0005072
          %h4#via_11d_superspace_cohomology Via 11d superspace cohomology
          %p
            Via 11d
            = succeed "-cohomology" do
              %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kasper+Peeters"}> Kasper Peeters
                , Pierre Vanhove, Anders Westerberg,
                %em
                  Supersymmetric
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi R
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} R^4
                  actions and quantum corrections to superspace torsion constraints
                (
                %a{:href => "https://arxiv.org/abs/hep-th/0010182"}> arXiv:hep-th/0010182
                )
            %li
              %p
                H. Lu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christopher+Pope"} Christopher Pope
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kellogg+Stelle"} Kellogg Stelle
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
                = succeed "," do
                  %em
                    Supersymmetric Deformations of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} G_2
                    Manifolds from Higher-Order Corrections to String and M-Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0312002"} arXiv:hep-th/0312002
              %p
                (specifically for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/M-theory+on+G%E2%82%82-manifolds"} M-theory on G₂-manifolds
            %li
              %p
                H. Lu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christopher+Pope"} Christopher Pope
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kellogg+Stelle"} Kellogg Stelle
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
                = succeed "," do
                  %em String and M-theory Deformations of Manifolds with Special Holonomy
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0410176"} arXiv:hep-th/0410176
              %p
                (specifically for
                = succeed ")" do
