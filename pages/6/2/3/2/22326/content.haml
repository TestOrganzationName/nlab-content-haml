                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathcal{O}(\ell^3)
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/0407271"} arXiv:hep-th/0407271
                = succeed "]" do
                  %a{:href => "https://doi.org/10.1088/1126-6708/2004/10/046"} doi:10.1088/1126-6708/2004/10/046
