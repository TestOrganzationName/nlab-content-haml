                  %a{:href => "https://tel.archives-ouvertes.fr/tel-01998725"} tel:01998725
                = succeed ")" do
                  %a{:href => "https://tel.archives-ouvertes.fr/tel-01998725/document"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yoshifumi+Hyakutake"}> Yoshifumi Hyakutake
                \:
                %em
                  Effective Action in M-Theory:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mi F
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} (D F)^4
                  Superinvariants
                [
                %a{:href => "https://arxiv.org/abs/2507.14984"}> arXiv:2507.14984
                ]
          %h4#via_superparticle_scattering_in_11d Via superparticle scattering in 11d
          %p
            Via analysis of would-be
            %a.existingWikiWord{:href => "/nlab/show/superparticle"} superparticle
            %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
            on
            %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            backgrounds:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kasper+Peeters"}> Kasper Peeters
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jan+Plefka"} Jan Plefka
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Steffen+Stern"} Steffen Stern
              = succeed "," do
                %em Higher-derivative gauge field terms in the M-theory action
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0507178"} arXiv:hep-th/0507178
          %h4#via_exceptional_geometry Via exceptional geometry
          %p
            Via
            %a.existingWikiWord{:href => "/nlab/show/geodesic"} geodesic
            motion on the
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            of the
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            %a.existingWikiWord{:href => "/nlab/show/Kac-Moody+group"} Kac-Moody group
            %a.existingWikiWord{:href => "/nlab/show/E10"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 10
                  %annotation{:encoding => "application/x-tex"} E_{10}
            by its “maximal compact” subgroup
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 10
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(E_{10})
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thibault+Damour"}> Thibault Damour
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
              = succeed "," do
                %em
                  Higher order M theory corrections and the Kac-Moody algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 10
                      %annotation{:encoding => "application/x-tex"} E_{10}
              %strong 22
              (2005) 2849-2880 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/0504153"}> arXiv:hep-th/0504153
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1088/0264-9381/22/14/003"} doi:10.1088/0264-9381/22/14/003
              %blockquote
                %p
                  (relating to
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
          %h4#via_lifting_10d_stringy_corrections Via lifting 10d stringy corrections
          %p
            From lifting
            = succeed "-corrections" do
              %a.existingWikiWord{:href => "/nlab/show/string+length+scale"} alpha'
            %a.existingWikiWord{:href => "/nlab/show/type+IIA+string+theory"} type IIA string theory
            through the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} duality between M-theory and type IIA string theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/James+Liu"}> James Liu
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
              = succeed "," do
                %em Higher-derivative couplings in string theory: dualities and the B-field
          %p
            Via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+IIB+supergravity"} type IIB supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/James+Liu"}> James Liu
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
              %em Type IIB at eight derivatives: insights from Superstrings, Superfields and Superparticles
              [
              %a{:href => "https://arxiv.org/abs/2205.11530"}> arXiv:2205.11530
              ]
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mohammad+R.+Garousi"}> Mohammad R. Garousi
                \:
                %em
                  Type IIA supergravity at one loop:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %msup
                          %mo ′
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} \alpha'^3
                  terms in the metric-dilaton-RR one-form sector
                [
                %a{:href => "https://arxiv.org/abs/2508.10529"}> arXiv:2508.10529
                ]
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mohammad+R.+Garousi"}> Mohammad R. Garousi
                \:
                %em
                  Dimensional reduction of the M-theory Chern-Simons term at order
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi ℓ
                          %mi p
                          %mn 6
                      %annotation{:encoding => "application/x-tex"} \ell_p^6
                [
                %a{:href => "https://arxiv.org/abs/2509.13726"}> arXiv:2509.13726
                ]
          %h4#via_the_abjm_m2brane_model Via the ABJM M2-brane model
          %p
            From the
            %a.existingWikiWord{:href => "/nlab/show/ABJM+model"} ABJM model
            for the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
          %ul
            %li
              Damon J. Binder,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Shai+Chester"} Shai Chester
              %em
                Absence of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mn 4
                      %msup
                        %mi R
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} D^4 R^4
                in M-Theory From ABJM
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1808.10554"}> arXiv:1808.10554
              \&amp;rbrack;
          %p
            In terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D%3D4+supergravity"} D=4 supergravity
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nikolay+Bobev"}> Nikolay Bobev
                , Anthony M. Charles,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kiril+Hristov"} Kiril Hristov
                = succeed "," do
                  %em
                    The Unreasonable Effectiveness of Higher-Derivative Supergravity in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} AdS_4
                    Holography
                %strong 125
                131601 (2020) [
                %a{:href => "https://doi.org/10.1103/PhysRevLett.125.131601"}> doi:10.1103/PhysRevLett.125.131601
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/2006.09390"} arXiv:2006.09390
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nikolay+Bobev"}> Nikolay Bobev
                , Anthony M. Charles,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dongmin+Gang"} Dongmin Gang
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kiril+Hristov"} Kiril Hristov
                = succeed "," do
                  %em
                    Higher-Derivative Supergravity, Wrapped M5-branes, and Theories of Class
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℛ
                        %annotation{:encoding => "application/x-tex"} \mathcal{R}
                %strong 2021
                58 (2021) [
                %a{:href => "https://doi.org/10.1007/JHEP04(2021)058"}> doi:10.1007/JHEP04(2021)058
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/2011.05971"} arXiv:2011.05971
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kiril+Hristov"}> Kiril Hristov
                ,
                = succeed "," do
                  %em
                    ABJM at finite
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    via 4d supergravity
                %strong 2022
                190 (2022) [
                %a{:href => "https://doi.org/10.1007/JHEP10(2022)190"}> doi:10.1007/JHEP10(2022)190
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/2204.02992"} arXiv:2204.02992
          %h4#see_also See also
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mohammad+Garousi"}> Mohammad Garousi
              ,
              %em
                Minimal gauge invariant couplings at order
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ℓ
                        %mi p
                        %mn 6
                    %annotation{:encoding => "application/x-tex"} \ell^6_p
                in M-theory
              (
              %a{:href => "https://arxiv.org/abs/2102.00639"}> arXiv:2102.00639
              )
          %p
            Discussion in view of the
            %a.existingWikiWord{:href => "/nlab/show/Starobinsky+model+of+cosmic+inflation"} Starobinsky model of cosmic inflation
            is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Katrin+Becker"}> Katrin Becker
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Melanie+Becker"} Melanie Becker
                = succeed "," do
                  %em Supersymmetry Breaking, M-Theory and Fluxes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0107044"} arXiv:hep-th/0107044
            %li
              %p
                Kazuho Hiraga,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Yoshifumi+Hyakutake"} Yoshifumi Hyakutake
                = succeed "," do
                  %em Inflationary Cosmology via Quantum Corrections in M-theory
                %strong 2018
                11 (2018) 113B03 [
                %a{:href => "https://doi.org/10.1093/ptep/pty126"}> doi:10.1093/ptep/pty126
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/1809.04724"} arXiv:1809.04724
            %li
              %p
                Kazuho Hiraga,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Yoshifumi+Hyakutake"} Yoshifumi Hyakutake
                = succeed "," do
                  %em Scalar Cosmological Perturbations in M-theory with Higher Derivative Corrections
                %strong 2020
                11 (2020) 113B03 [
                %a{:href => "https://doi.org/10.1093/ptep/ptaa142"}> doi:10.1093/ptep/ptaa142
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/1910.12483"} arxiv:1910.12483
          %p
            and in view of
            %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"} de Sitter spacetime
            vacua:
          %ul
            %li
              Johan Blåbäck,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"} Ulf Danielsson
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Dibitetto"} Giuseppe Dibitetto
              %em Constructing stable de Sitter in M-theory from higher curvature corrections
              (
              %a{:href => "https://arxiv.org/abs/1902.04053"}> arXiv:1902.04053
              )
