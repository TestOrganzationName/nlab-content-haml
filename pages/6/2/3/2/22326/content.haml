                %a{:href => "https://doi.org/10.1103/PhysRevD.74.025022"}> doi:10.1103/PhysRevD.74.025022
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0508204"} arXiv:hep-th/0508204
            %li
              %p
