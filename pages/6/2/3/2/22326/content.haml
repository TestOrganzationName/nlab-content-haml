                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0409107"} arXiv:hep-th/0409107
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yoshifumi+Hyakutake"}> Yoshifumi Hyakutake
                , Sachiko Ogushi:
