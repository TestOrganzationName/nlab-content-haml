          %title Contents
          %blockquote
            %p under construction
          .rightHandSide
            .toc.clickDown{:tabindex => "0"}
              %h3#context Context
              %h4#philosophy Philosophy
              .hide
                %div
                  %p
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/philosophy"} philosophy
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/ontology"} ontology
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/logos+%28in+philosophy%29"}> logos
                            ,
                            %em
                              %a.existingWikiWord{:href => "/nlab/show/Science+of+Logic"} Science of Logic
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/being"}> being
                            ,
                            %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
                  %h3#schools Schools
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/objective+idealism"} objective idealism
                  %h3#of_mathematics Of mathematics
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/philosophy+of+mathematics"} philosophy of mathematics
                  %h3#of_physics Of physics
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/natural+philosophy"} natural philosophy
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/philosophy+of+physics"} philosophy of physics
          %p This page is about
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Georg+Hegel"} Georg Hegel
              %p
                %em Wissenschaft der Logik
                (
                = succeed ")" do
                  %em Science of Logic
              %p
                Volume 1,
                = succeed "," do
                  %em The Objective Logic
              %ul
                %li
                  %p The Doctrine of Being;
                %li
                  %p The Doctrine of Essence.
              %p
                Volume 2,
                = succeed "," do
                  %em The Subjective Logic
              %ul
                %li The Doctrine of the Notion
              %p 1812, 1831
              %p
                (
                %a{:href => "http://www.marxists.org/reference/archive/hegel/works/hl/"}> English hyperlinked version
                ,
                = succeed "," do
                  %a{:href => "http://hegel.logik.2.abcphil.de"} German hyperlinked version
                = succeed "," do
                  %a{:href => "http://www.gutenberg.org/cache/epub/6729/pg6729.html"} German html raw text version
                = succeed "," do
                  %a{:href => "http://hegel.net/hegelwerke/"} full text pdf-s
                = succeed ")" do
                  %a{:href => "http://en.wikipedia.org/wiki/Science_of_Logic"} Wikipedia entry
              %p English translation by A. V. Miller in 1969. More recently George di Giovanni has published a new translation, Cambridge University Press, 2010.
          %p and about the further body of text that this is a part of, which consists of the later
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Georg+Hegel"}> Georg Hegel
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Enzyklop%C3%A4die+der+Philosophischen+Wissenschaften+im+Grundrisse"} Enzyklopädie der Philosophischen Wissenschaften im Grundrisse
              %ol
                %li
                  %p
                    %em Die Wissenschaft der Logik
                %li
                  %p
                    %em Die Philosophie der Natur
                    \/
                    %em
                      %a{:href => "#PhilosophyOfNature"} The Philosophy of Nature
                %li
                  %p
                    %em Die Philosophie des Geistes
                    \/
                    %em
                      %a{:href => "#PhilosophyOfSpirit"} The Philosophy of Spirit
              %p 1817, 1827, 1830, 1845
              %p
                (1830) W. Bonsiepen und H.-C. Lucas (eds.) in
                = succeed "," do
                  %em Gesammelte Werke
                = succeed ")" do
                  %a{:href => "http://www.marxists.org/reference/archive/hegel/sl_index.htm"} English hyperlinked version
          %p which itself subsumes, in outline, the earlier
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Georg+Hegel"}> Georg Hegel
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Phenomenology+of+Spirit"} Phänomenologie des Geistes
          %p
            that, in turn, is claimed (
            %a{:href => "#50"}> §50
            ,
            = succeed ")" do
              %a{:href => "#51"} §51
            %em Science
            that the
            %em Science of Logic
            develops.
          %p
            Together these texts lay out what has come to be called
            %em Hegel’s system
            (
            %a{:href => "#1805"}> §1805
            ) (following
            %em
              %a.existingWikiWord{:href => "/nlab/show/Spinoza%27s+system"} Spinoza's system
            (
            %a{:href => "#1287"}> §1287
            ); Hegel himself speaks of the
            %em system of pure reason
            = succeed ")." do
              %a{:href => "#53b"} §53b
            %em
              %a.existingWikiWord{:href => "/nlab/show/Encyclopedia+of+the+Philosophical+Sciences"} Encyclopedia of the Philosophical Sciences
            , widely known as the “Shorter Logic”, covers the material of the
            %em Science of Logic
            in more condensed but also slightly re-worked form. Similarly the topics of the
            %em Phenomenology of Spirit
            re-appear in condensed and slightly re-worked form inside the third piece of the Encyclopedia.
          %p
            Here the
            %em
              %a.existingWikiWord{:href => "/nlab/show/objective+logic"} objective logic
            is not
            %em
              %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            in the usual sense – that usual sense of logic (in fact
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Aristotle%27s+logic"} Aristotle's logic
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/subjective+logic"} subjective logic
            %em objective logic
            is rather like the
            %em
              %a.existingWikiWord{:href => "/nlab/show/logos"} logos
            in the old sense of
            %a.existingWikiWord{:href => "/nlab/show/Heraclitus"} Heraclitus
            (
            %a{:href => "Heraclitus#HegelHistory1b"}> HistPhil
            ,
            = succeed "," do
              %a{:href => "#Heidegger58"} Heidegger 58
            = succeed "))" do
              %a{:href => "#Lambek82"} Lambek 82
            %em
              %a.existingWikiWord{:href => "/nlab/show/Nous"} Nous
            in the sense of
            %a.existingWikiWord{:href => "/nlab/show/Anaxagoras"} Anaxagoras
            (
            %a{:href => "#54"}> §54
            ,
            = succeed ")" do
              %a{:href => "Phenomenology+of+Spirit#Vorrede55"} PoS pref. §55
            %em
              %a.existingWikiWord{:href => "/nlab/show/metaphysics"} metaphysics
            (
            %a{:href => "#85"}> §85
            ), which Hegel views as the “
            %a.existingWikiWord{:href => "/nlab/show/substance"}> substantial
            ” aspect of logic
            = succeed "." do
              %a{:href => "#48"} §48
          %p
            Hegel’s system is meant to be the revelation of a dynamical
            %a.existingWikiWord{:href => "/nlab/show/ontology"} ontological
            process (a diagram is
            = succeed ")" do
              %a{:href => "#Process"} below
            %em
              %a.existingWikiWord{:href => "/nlab/show/logos+%28in+philosophy%29"} logos
            develops from nothingness over various stages of
            %em determinations of being
            (Seinsbestimmungen) to, roughly,
            = succeed "," do
              %em the Idea
            %a.existingWikiWord{:href => "/nlab/show/doctrine+of+ideas"} doctrine of ideas
            = succeed "." do
              %a{:href => "#55"} §55
            %em appears
            in the
            %em Essence
            (erscheint im Wesen), next
            %em externalizes
            itself in the form of
            = succeed "," do
              %em Nature
            %a{:href => "#PN308"} PN§308
            of nature (
            %a.existingWikiWord{:href => "/nlab/show/nous"}> nous
            ) and of its life forms, it grows into the conscious and then self-conscious
            = succeed "." do
              %em Spirit
            = succeed "," do
              %a{:href => "#1812"} §1812
            = succeed ")." do
              %a{:href => "#1814"} §1814
          %p
            Other philosophical systems, Hegel claims (see also (
            %a.existingWikiWord{:href => "/nlab/show/Lectures+on+the+History+of+Philosophy"}> Lect Hist Phil
            ,
            = succeed "))," do
              %a{:href => "Lectures+on+the+History+of+Philosophy#BisHierher"} Result
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Parmenides"}> Parmenides
                ‘
                %em
                  %a.existingWikiWord{:href => "/nlab/show/being"} being
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Heraclitus"}> Heraclitus
                ‘s
                %em
                  %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
                and the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/logos+%28in+philosophy%29"} logos
                (
                %a{:href => "Heraclitus#HegelHistory1b"}> HistPhil
                ),
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Plato"}> Plato
                ‘s
                %a.existingWikiWord{:href => "/nlab/show/doctrine+of+ideas"} doctrine of ideas
                as “actualized” by
                %a.existingWikiWord{:href => "/nlab/show/Aristotle"} Aristotle
                (
                %a{:href => "doctrine+of+ideas#HegelPerspective"}> HistPhil
                ),
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zeno"}> Zeno
                ‘s,
                = succeed "\u2019s/" do
                  %a.existingWikiWord{:href => "/nlab/show/Plato"} Plato
                = succeed "\u2019s" do
                  %a.existingWikiWord{:href => "/nlab/show/Parmenides"} Parmenides
                = succeed "\u2019s" do
                  %a.existingWikiWord{:href => "/nlab/show/Kant"} Kant
                %em
                  %a.existingWikiWord{:href => "/nlab/show/dialectics"} dialectics
                (
                %a{:href => "#62"}> §62
                ,
                = succeed "," do
