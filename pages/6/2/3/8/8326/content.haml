                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo →
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}G \to \ast
                  %td{:style => "text-align: left;"}
