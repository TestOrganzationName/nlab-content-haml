            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/measurable+function"} measurable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
