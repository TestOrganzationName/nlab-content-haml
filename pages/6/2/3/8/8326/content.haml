                    \/
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/context+extension"} context extension
                    along
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo →
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}G \to \ast
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
                    along
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo →
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}G \to \ast
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+invariants"}> homotopy invariants
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+cohomology"} ∞-group cohomology
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
                    of
                    %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                    along
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
