            had no
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+transformations"} higher gauge transformations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
