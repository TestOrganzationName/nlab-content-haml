            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mi X
