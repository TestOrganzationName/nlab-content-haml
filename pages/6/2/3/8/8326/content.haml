                              %mi moment
                              %mspace{:width => "thickmathspace"}
                              %mi of
                            %mrow
                              %mi discreteness
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mi moment
                              %mspace{:width => "thickmathspace"}
                              %mi of
                            %mrow
                              %mi continuity
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\flat X &amp;\longrightarrow&amp; X &amp;\longrightarrow&amp; \sharp X
                  \\\
                  {moment\;of \atop discreteness}
                  \&amp;&amp;
                  \&amp;&amp;
                  {moment\;of \atop continuity}
                  }
          %p
            Hence we add to the
