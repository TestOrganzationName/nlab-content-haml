            in (stable)
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theory
            (e.g.
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization+and+generalized+differential+cohomology"} Freed 00
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
