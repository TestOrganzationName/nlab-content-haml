                    %mrow
                      %mn 0
                      %mo{:stretchy => "false"} |
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0|1}
            which exhibits
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                  %annotation{:encoding => "application/x-tex"} \R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
