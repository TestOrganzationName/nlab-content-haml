          #SublationsRealized.num_prop
            %h6#proposition_18 Proposition
            %p
              The model in def.
              %a.maruku-ref{:href => "#SupergeometricModel"}
              verfies the required Aufhebungen
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ♯
                        %mi ∅
                        %mo ≃
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ⇝
                        %mi ℑ
                        %mo ≃
                        %mi ℑ
                      %annotation{:encoding => "application/x-tex"} \rightsquigarrow \Im \simeq \Im
                  \.
          .proof
            %h6#proof_5 Proof
            %p
              For the statement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                    %mi ∅
                    %mo ≃
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \sharp \emptyset \simeq \emptyset
              consider the following:
            %p
              Since the site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ≔
                    %mi SuperFormalSmooth
                    %mn ∞
                    %mi Grpds
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} \coloneqq SuperFormalSmooth\infty Grpds
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X\in \mathbf{H}
              any sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X \colon \mathcal{S}^{op}\to Set
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi X
                    %mo ≃
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\flat X \simeq X(\ast)
            %p
              (where we may leave the constant re-embedding implicit, due to it being
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
            %p
              Moreover, for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} U\in \mathcal{S}
              there exists a morphism
