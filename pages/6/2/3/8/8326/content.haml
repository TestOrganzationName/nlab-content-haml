              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔻
                      %mi e
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}^V_e
              by def.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralLinearGroup"}
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ⋊
                      %mi V
                    %annotation{:encoding => "application/x-tex"} GL(V) \rtimes V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
