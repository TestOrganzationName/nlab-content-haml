          %p
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo +
                  %mn 2
                %annotation{:encoding => "application/x-tex"} p+2
            in the
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #FormRefinementOfCocycle.num_defn
            %h6#definition_11 Definition
            %p
              Given a group cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              and a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+filtration"} Hodge filtration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^1_{flat}(-,\mathfrak{g})
              fitting into a square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi flat
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi μ
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi cl
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mo ♭
                              %mi dR
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mo ♭
                                  %mi dR
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                          %mtd
                            %msub
                              %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi 𝔾
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{\Omega}^1_{flat}(-,\mathfrak{g})
                    \&amp;\stackrel{\mu}{\longrightarrow}&amp;
                    \\mathbf{\Omega}^2_{cl}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\flat_{dR} \mathbf{B}G
                    \&amp;\stackrel{\flat_{dR}\mathbf{c}}{\longrightarrow}&amp;
                    \\flat_{dR} \mathbf{B}^2 \mathbb{G}
                    }
                    \\,.
            %p Given this, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                    %mo ≔
                    %mi G
                    %munder
                      %mo ×
                      %mrow
                        %msub
                          %mo ♭
                          %mi dR
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde G
                    \\coloneqq G \underset{\flat_{dR}\mathbf{B}G}{\times} \mathbf{\Omega}^1_{flat}(-,\mathfrak{g})
          .num_example
            %h6#example_6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              0-truncated, then the canonical choice is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi flat
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ♭
                        %mi dR
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^1_{flat}(-,\mathfrak{g}) = \flat_{dR}\mathbf{B}G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ˜
                      %mo ≃
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \tilde G \simeq G
            %p
              On the other extreme, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} G = \mathbf{B}^{p+1}\mathbb{G}
              then the canonical choice is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi flat
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi cl
                        %mrow
                          %mi p
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^1_{flat}(-,\mathfrak{g}) = \mathbf{\Omega}^{p+2}_{cl}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ˜
                      %mo ≃
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %msub
                        %mi 𝔾
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \tilde G \simeq \mathbf{B}^{p+1}\mathbb{G}_{conn}
            %p
              This means that in general
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde G
              is a homotopy fiber product of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %msub
                        %mi 𝔾
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^{p+1}\mathbb{G}_{conn}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is a pair of a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Sigma \to G
              and of
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              content of higher
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/gauged+WZW+models"} gauged WZW models
          #WZWTermFromCocycle.num_prop
            %h6#proposition_11 Proposition
            %p
              Given a group cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{c} \colon \mathbf{B}G \to \mathbf{B}^{p+2}
              and a form refinement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FormRefinementOfCocycle"}
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi WZW
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                    %mo ⟶
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi conn
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{WZW}
                    \\;\colon\;
                    \\tilde G \longrightarrow \mathbf{B}^{p+1}_{conn}
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi θ
                      %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu(\theta_G)
              whose underlying
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi p
                      %mi 𝔾
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^p\mathbb{G}
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                    %annotation{:encoding => "application/x-tex"} \Omega \mathbf{c}
            %p
              We call this the
              %em
                %a.existingWikiWord{:href => "/nlab/show/WZW+term"} WZW term
              whose
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi θ
                        %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mu(\theta_G)
          %h5#Manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            \-Manifolds
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+manifolds+and+orbifolds"} geometry of physics – manifolds and orbifolds
          #LocalDiffeomorphisms.num_defn
            %h6#definition_12 Definition
            %p
              Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X,Y\in \mathbf{H}
              then a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X\longrightarrow Y
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
              if its naturality square of the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℑ
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; \Im X
                    \\\
                    \\downarrow^{\mathrlap{f}} &amp;&amp; \downarrow^{\mathrlap{\Im f}}
                    \\\
                    Y &amp;\longrightarrow&amp; \Im Y
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              square.
          .num_remark
            %h6#remark_8 Remark
            %p
              The abstract definition
              %a.maruku-ref{:href => "#LocalDiffeomorphisms"}
              comes down to being the appropriate
              = succeed "-version" do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+supergeometry"} synthetic differential supergeometry
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
              if the diagram of
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi T
                                  %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi T
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T X &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow^{\mathrlap{T f}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    T Y &amp;\longrightarrow&amp; Y
                    }
            %p
              To see this, notice by the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [D,X]
              is the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with jets of order as encoded by the infinitesimal order of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔻
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}^1(1)
              is the first order infinitesimal interval defined by the fact that its
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              is the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+dual+numbers"} algebra of dual numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo ⊕
                      %mi ϵ
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϵ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{D}^1(1)) = (\mathbb{R} \oplus \epsilon \mathbb{R})/(\epsilon^2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝔻
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    [\mathbb{D}^1(1), X]\simeq T X
            %p
              is the ordinary
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [D,-]
              preserves
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              in its second argument, and that, by the hom-adjunction,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi D
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(U, [D,X]) \simeq \mathbf{H}(U \times D, X)
              and finally use that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %mi D
                      %mo ,
                      %mi ℑ
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi ℜ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}(U \times D, \Im X)\simeq \mathbf{H}(\Re(U \times D), X)\simeq \mathbf{H}(U,X)
          %p
            Let now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} V \in \mathbf{H}
            be given, equipped with the structure of a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            (
            %a.existingWikiWord{:href => "/nlab/show/infinity-group"}> infinity-group
            ).
          #VManifold.num_defn
            %h6#definition_13 Definition
            %p
              A
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              is an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              such that there exists a
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; U
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    V &amp;&amp; &amp;&amp; X
                    }
            %p
              with both morphisms being
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphisms"} local diffeomorphisms
              = succeed "," do
                %a.maruku-ref{:href => "#LocalDiffeomorphisms"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
          .num_prop
            %h6#proposition_12 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
              = succeed "," do
                %a.maruku-ref{:href => "#LocalDiffeomorphisms"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ⇝
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi X
                      %mo ⇝
                    %mo ⟶
                    %mover
                      %mi Y
                      %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \stackrel{\rightsquigarrow}{f}\colon \stackrel{\rightsquigarrow}{X} \longrightarrow \stackrel{\rightsquigarrow}{Y}
              under the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic modality
          .proof
            %h6#proof_2 Proof
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic modality
              provides
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℜ
                    %mo ⊣
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Re\dashv \Im
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇝
                      %mi ℑ
                      %mo ≃
                      %mi ℑ
                    %annotation{:encoding => "application/x-tex"} \rightsquigarrow \Im \simeq \Im
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                    %mo ⇝
                    %mo ≃
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Im \rightsquigarrow \simeq \Im
              anyway. Finally
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \rightsquigarrow
              preserves
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              (being in particular a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℑ
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; \Im X
                    \\\
                    \\downarrow^{\mathrlap{f}} &amp;&amp; \downarrow^{\mathrlap{\Im f}}
                    \\\
                    Y &amp;\longrightarrow&amp; \Im Y
                    }
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"} \rightsquigarrow\;\;
              yields a pullback diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi X
                              %mo ⇝
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mover
                              %mi X
                              %mo ⇝
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi f
                                  %mo ⇝
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℑ
                                  %mover
                                    %mi f
                                    %mo ⇝
                        %mtr
                          %mtd
                            %mover
                              %mi Y
                              %mo ⇝
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mover
                              %mi Y
                              %mo ⇝
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\stackrel{\rightsquigarrow}{X} &amp;\longrightarrow&amp; \Im \stackrel{\rightsquigarrow}{X}
                    \\\
                    \\downarrow^{\mathrlap{\stackrel{\rightsquigarrow}{f}}} &amp;&amp; \downarrow^{\mathrlap{\Im \stackrel{\rightsquigarrow}{f}}}
                    \\\
                    \\stackrel{\rightsquigarrow}{Y} &amp;\longrightarrow&amp; \Im \stackrel{\rightsquigarrow}{Y}
                    }
          .num_cor
            %h6#corollary Corollary
            %p
              The bosonic space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \stackrel{\rightsquigarrow}{X}
              underlying a
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#VManifold"}
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi V
                        %mo ⇝
                    %annotation{:encoding => "application/x-tex"} \stackrel{\rightsquigarrow}{V}
          %h5#FrameBundles Frame bundles
          #InfinitesimalDiskBundle.num_defn
            %h6#definition_14 Definition
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              %em infinitesimal disk bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi inf
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_{inf} X\to X
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
              of the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
              along itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mi inf
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T_{inf} X &amp;\stackrel{}{\longrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\longrightarrow&amp; \Im X
                    }
                    \\,.
            %p
              Given a point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \;\colon\;  \ast \to X
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %msub
                      %mi 𝔻
                      %mi x
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \ast \to \mathbb{D}_x \to X
              of that point is the further
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the infinitesimal disk bundle to this point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝔻
                              %mi x
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi T
                              %mi inf
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mi x
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{D}_x &amp;\longrightarrow &amp; T_{inf} X &amp;\stackrel{}{\longrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\ast &amp;\stackrel{x}{\longrightarrow} &amp; X &amp;\longrightarrow&amp; \Im X
                    }
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              then the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi ℑ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T_{(k)} X &amp;\stackrel{}{\longrightarrow}&amp; \Im_{(k)} X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\longrightarrow&amp; \Im X
                    }
            %p
              and accordigly the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝔻
                            %mo{:stretchy => "false"} (
                            %mi k
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi x
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi T
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi ℑ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mi x
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{D}(k)_x &amp;\longrightarrow &amp; T_{(k)} X &amp;\stackrel{}{\longrightarrow}&amp; \Im_{(k)}X
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\ast &amp;\stackrel{x}{\longrightarrow} &amp; X &amp;\longrightarrow&amp; \Im X
                    }
                    \\,.
          %p
            It is natural not to pick any point, but to collect all infinitesimal disks around
            %em all
            the points of a space:
          #RelativeFlat.num_defn
            %h6#definition_15 Definition
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/relative+flat+modality"} relative flat modality
              is the operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ♭
                      %mi rel
                  %annotation{:encoding => "application/x-tex"} \flat^{rel}
              that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mo ♭
                              %mi rel
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo ♭
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\flat^{rel} &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\flat X &amp;\longrightarrow&amp; \Im X
                    }
                    \\,.
            %p
              More generally, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              then the
              %em
                order
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                relative flat modality
              is the pullback in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mo ♭
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                              %mi rel
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi ℑ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo ♭
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℑ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\flat^{rel}_{(k)} &amp;\longrightarrow&amp; \Im_{(k)} X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\flat X &amp;\longrightarrow&amp; \Im X
                    }
                    \\,.
          #GeneralLinearGroup.num_defn
            %h6#definition_16 Definition
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(V)
              is the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+infinity-group"} automorphism infinity-group
              of the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝔻
                        %mi e
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}^V_e
              = succeed "," do
                %a.maruku-ref{:href => "#InfinitesimalDiskBundle"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %msubsup
                        %mi 𝔻
                        %mi e
                        %mi V
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} e \colon \ast \to \mathbb{D}^V_e \to V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝔻
                      %mi e
                      %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    GL(V) \coloneqq \mathbf{Aut}(\mathbb{D}^V_e)
                    \\,.
          #FrameBundle.num_prop
            %h6#proposition_13 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "-manifold," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.maruku-ref{:href => "#VManifold"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi inf
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T_{inf} X \to X
              = succeed "," do
                %a.maruku-ref{:href => "#InfinitesimalDiskBundle"}
              %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated
              to a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(V)
              %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundle"} principal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Fr(X) \to X
              – to be called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
              %a.existingWikiWord{:href => "/nlab/show/modulating+morphism"} modulated
              by a map to be called
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \tau_X
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mi inf
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi τ
                                  %mi X
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Fr
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi τ
                                  %mi X
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T_{inf} X &amp;\longrightarrow&amp; V/GL(V)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\stackrel{\tau_X}{\longrightarrow}&amp; \mathbf{B} GL(V)
                    }
                    \\;\;\;
                    \\array{
                    Fr(X) &amp;\longrightarrow&amp; \ast
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
