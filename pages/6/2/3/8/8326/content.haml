                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;#643; &amp;\dashv&amp; \flat
                  \\\
                  \\bot &amp;&amp; \bot
                  \\\
                  \\flat &amp;\dashv&amp; \sharp
                  }
          %p expresses.
          %p
            Recall the
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
            from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
          .num_prop
            %h6#proposition_8 Proposition
            %p
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+types"} Stable homotopy types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              are equivalently
              %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theories"} generalized cohomology theories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              via
            .maruku-equation
