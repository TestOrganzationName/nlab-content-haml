          %title Relation between adjunctions and monads
          %h3#RelationBetweenAdjunctionsAndMonads Relation between adjunctions and monads
          %p
            There is a close relation between
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            (
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"}> adjoint functors
            ) and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monads"} monads
          %ul
            %li
              %p
                %a{:href => "#MonadInducedByAnAdjunction"} Monad induced by an adjunction
            %li
              %p
                %a{:href => "#CategoryOfAdjunctionResolutionsOfAMonad"} Category of adjunction-resolutions of a monad
            %li
              %p
                %a{:href => "#SemanticsStructureAdjunction"} Semantics-Structure adjunction
          %h4#MonadInducedByAnAdjunction Monad induced by an adjunction
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊣
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L \dashv R)
            induces a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∘
                  %mi L
                %annotation{:encoding => "application/x-tex"} R \circ L
            and a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∘
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L \circ R
          %p
            (
            %a{:href => "monad#Huber61"}> Huber 1961, §4
            ; see eg.
            = succeed ";" do
              %a{:href => "monad#MacLane71"} MacLane 1971, §VI.1 (p 134)
            = succeed ")." do
              %a{:href => "monad#Borceux94"} Borceux 1994, vol. 2, prop. 4.2.1
          %p In detail:
          %p
          .num_prop
            %h6 Proposition
            %p
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %mo ,
                    %mi F
                    %mo ,
                    %mi U
                    %mo ,
                    %mi η
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\mathcal{D},F,U,\eta,\epsilon)
              be a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              ie
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊣
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F \dashv U
              are adjoint functors where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒞
                      %mo →
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \rightarrow \mathcal{D}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒟
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} U \colon\mathcal{D} \rightarrow \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi A
                    %mo :
                    %mi A
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_{A}:A \rightarrow U(F(A))
              is the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi B
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \epsilon_{B} \colon F(U(B)) \rightarrow B
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∘
                        %mi F
                      %annotation{:encoding => "application/x-tex"} U \circ F
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  and multiplication
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ϵ
                            %mrow
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} U(\epsilon_{F(A)}):U(F(U(F(A)))) \rightarrow U(F(A))
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ∘
                        %mi U
                      %annotation{:encoding => "application/x-tex"} F \circ U
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \mathcal{D}
                  %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                  and comultiplication
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi η
                            %mrow
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mi B
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} (
