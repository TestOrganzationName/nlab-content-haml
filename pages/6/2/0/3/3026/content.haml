                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℕ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{N}\cup\{\infty\})
              %a.existingWikiWord{:href => "/nlab/show/subsequential+spaces"} subsequential spaces
              are a subcategory of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/concrete+sheaves"} concrete sheaves
          %h3#ExamplesSpheres Euclidean spaces compactify to spheres
          %p
            We discuss how the
