            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
          #nSphereIsOnePointCompactificationOfRn.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
                of
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean n-space
                is the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              with its standard
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              (e.g. as a
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              with its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to the one-point compactification (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OnePointExtension"}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n \simeq (\mathbb{R}^n)^\ast
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              Pick a point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mo ∈
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \infty \in S^n
              %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"} stereographic projection
              we have a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n \setminus \{\infty\} \simeq \mathbb{R}^n
                    \\,.
            %p
              With this it only remains to see that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn ∞
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_\infty \supset \{\infty\}
              an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              then the complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ∖
                    %msub
                      %mi U
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} S^n \setminus U_\infty
              is compact closed, and conversely that the complement of every compact closed subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S^n \setminus \{\infty\}
              is an open neighbourhood of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\infty\}
            %p
              Observe that under
              %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"} stereographic projection
              the open subspaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn ∞
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi S
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_\infty \setminus \{\infty\} \subset S^n \setminus \{\infty\}
              are identified precisely with the
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
              and
              %a.existingWikiWord{:href => "/nlab/show/bounded+subsets"} bounded subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mo ∈
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{\infty\} \in S^n
              needs to contain an open ball around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ≃
                    %msup
                      %mi S
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}^n \simeq S^n \setminus \{-\infty\}
              in the
              %em other
              stereographic projection, which under change of chart gives a bounded subset. )
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
              the closed and bounded subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              are precisely the compact, and hence the compact closed, subsets of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ≃
                      %msup
                        %mi S
                        %mi n
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \simeq S^n \setminus \{\infty\}
          #RelevanceForMonopolesAndInstantons.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (relevance for
                %a.existingWikiWord{:href => "/nlab/show/solitons"} solitons
                and
                %a.existingWikiWord{:href => "/nlab/show/instantons"} instantons
                in
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            %p
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              %a.maruku-ref{:href => "#nSphereIsOnePointCompactificationOfRn"}
              governs the phenomenon of
              %a.existingWikiWord{:href => "/nlab/show/solitons"} solitons
              and
              %a.existingWikiWord{:href => "/nlab/show/instantons"} instantons
              for
              %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              or
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/field+history"} field configuration
              carries a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/energy"} energy
              requires that
              %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"} vanish at infinity
            %p
              This means that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              for the corresponding gauge field – e.g.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A = B G
              for
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
              with
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              – and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn ∞
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a_\infty \in A
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} base point
              witnessing vanishing fields, then a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/field+configuration"} field configuration
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo ⟶
                      %mi c
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n
                    \\overset{c}{\longrightarrow}
                    A
            %p
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} cohomology
              %em
                %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"} vanishes at infinity
              if outside any
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              its value is the vanishing field configuration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} a_\infty
            %p
              But by Def.
              %a.maruku-ref{:href => "#OnePointExtension"}
              this is equivalent to the cocycle
              %a.existingWikiWord{:href => "/nlab/show/extension"} extends
              to the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              as a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ≃
                            %msup
                              %mi S
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mi c
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mn ∞
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi a
                              %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\big(
                    \\mathbb{R}^n
                    \\big)
                    \\simeq S^n
                    \&amp;
                    \\overset{c}{\longrightarrow}
                    \&amp;
                    A
                    \\\
                    \\infty &amp;\mapsto&amp; a_\infty
                    }
            %p
              The following graphics illustrates this for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A = S^n
              an
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              itself, hence for charges in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cohomotopy+cohomology+theory"} Cohomotopy cohomology theory
            %center
              %a{:href => "https://arxiv.org/pdf/1909.12277.pdf#page=9"}
                %img{:src => "https://ncatlab.org/schreiber/files/CohomotopyOfEuclideanNSpaceVanishingAtInfinity.jpg", :width => "640"}/
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "cohomotopy+charge#SatiSchreiber19"} SS 19
            %p
              For more see at
              = succeed "." do
                %em
                  %a{:href => "Yang-Mills+instanton#FromTheMathsToThePhysicsStory"} Yang-Mills instanton – SU(2)-instantons from the correct maths to the traditional physics story
          %h3#linear_representations_compactify_to_representation_spheres Linear representations compactify to representation spheres
          %p
            Via the presentation of example
            = succeed "," do
              %a.maruku-ref{:href => "#nSphereIsOnePointCompactificationOfRn"}
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(N)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            induces an action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            (the “point at infinity”).
          %p
            This construction presents the
            %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-homomorphism
            in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            and is encoded for instance in the definition of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
          %p
            Slightly more generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            any real
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            one has
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^n \simeq (V)^\ast
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi V
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi V
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  S^V \coloneqq (V)^\ast
          %p
            for the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            obtained as the one-point compactification of the vector space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            As a special case of Prop.
            %a.maruku-ref{:href => "#OnePointCompactificationAndSmashProduct"}
            we have:
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ,
                    %mi W
                    %mo ∈
                    %msub
                      %mi Vect
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} V,W \in Vect_{\mathbb{R}}
              two real
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi V
                    %mo ∧
                    %msup
                      %mi S
                      %mi W
                    %mo ≃
                    %msup
                      %mi S
                      %mrow
                        %mi V
                        %mo ⊕
                        %mi W
                  %annotation{:encoding => "application/x-tex"}
                    S^V \wedge S^W \simeq S^{V\oplus W}
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of their one-point compactifications and the one-point compactification of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
          .num_remark
            %h6#remark_3 Remark
            %p
              In particular, it follows directly from this that the
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma(-) \simeq S^1 \wedge (-)
              of the
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-sphere," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Σ
                            %msup
                              %mi S
                              %mi n
                          %mtd
                            %mo ≃
                            %msup
                              %mi S
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi S
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mn 1
                                %mo ⊕
                                %msup
                                  %mi ℝ
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi S
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Sigma S^n
                    \&amp; \simeq S^{\mathbb{R}^1} \wedge S^{\mathbb{R}^n}
                    \\\
                    \&amp; \simeq S^{\mathbb{R}^1 \oplus \mathbb{R}^n}
                    \\\
                    \&amp; \simeq S^{\mathbb{R}^{n+1}}
                    \\\
                    \&amp; \simeq S^{n+1}
                    \\end{aligned}
                    \\,.
          %p
            %br/
          %h3#thom_spaces Thom spaces
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V \to X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the) one-point compactification of the total space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is the
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(V)/S(V)
          %p
            For a simple example: the real
            %a.existingWikiWord{:href => "/nlab/show/projective+plane"} projective plane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝℙ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{RP}^2
            is the one-point compactification of the ‘open’
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Moebius+strip"} Möbius strip
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝℙ
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{RP}^{n+1}
            is the Thom space of the
            %a.existingWikiWord{:href => "/nlab/show/tautological+line+bundle"} tautological line bundle
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝℙ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{RP}^n
          %h3#locally_compact_hausdorff_spaces Locally compact Hausdorff spaces
          #LocallyCompatcHausdorffSpaceIsOpenSubspaceOfCompactHausdorffSpace.num_example
            %h6#example_2 Example
            %p
              %strong
                (every
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
                is an
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
          .proof
            %h6#proof_7 Proof
            %p
              In one direction the statement is that
              %a.existingWikiWord{:href => "/nlab/show/open+subspaces+of+compact+Hausdorff+spaces+are+locally+compact"} open subspaces of compact Hausdorff spaces are locally compact
              (see there for the proof). What we need to show is that every locally compact Hausdorff spaces arises this way.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a locally compact Hausdorff space. By prop.
              %a.maruku-ref{:href => "#OnePointExtensionIsCompact"}
              and prop.
              %a.maruku-ref{:href => "#HausdorffOnePointCompactification"}
              its one-point extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X^\ast
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OnePointExtension"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %a.maruku-ref{:href => "#InclusionIntoOnePointExtensionIsOpenEmbedding"}
              the canonical inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X \to X^\ast
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding of topological spaces
