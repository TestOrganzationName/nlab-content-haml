                %a.existingWikiWord{:href => "/nlab/show/open+point"} open point
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+point"} closed point
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
