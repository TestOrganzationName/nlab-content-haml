                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}\cup\{\infty\}\to X
              to a topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is to give a convergent sequence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/Johnstone%27s+topological+topos"} Johnstone's topological topos
              is a category of
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              on the continuous
              %a.existingWikiWord{:href => "/nlab/show/endofunctions"} endofunctions
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
