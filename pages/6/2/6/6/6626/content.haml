                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi P
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mo ↔
                  %mspace{:width => "thickmathspace"}
                  %mi a
                  %mo ∈
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo ∧
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} a \in \{ X | P \} \;\leftrightarrow\; a \in X \;\wedge\; P(a) .
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi P
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{X|P\}
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            It is important to specify what language
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            can be written in. This connects the axiom to
            %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations of mathematics
            %a.existingWikiWord{:href => "/nlab/show/first-order+logic"} first-order logic
            developed in order to explain the meaning of
            = succeed "'s" do
              %a.existingWikiWord{:href => "/nlab/show/Ernst+Zermelo"} Ernst Zermelo
            %em
              %a.existingWikiWord{:href => "/nlab/show/axiom+scheme"} scheme
            because there is one axiom for each way to state a property in the language. (We also allow parameters in
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %h2#statements Statements
          %p From weaker to stronger:
          %ul
            %li
              %p
                For
                %strong bounded separation
                aka
                %strong restricted separation
                aka
                = succeed "," do
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi Δ
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \Delta_0
                    \-separation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                must be written in the language of first-order set theory and all
                %a.existingWikiWord{:href => "/nlab/show/quantifications"} quantifications
                must be guarded by a set: of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \forall x \in A
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∃
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \exists x \in A
                for some set
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                For
                %strong limited separation
                aka
                = succeed "," do
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msubsup
                            %mi Δ
                            %mn 0
                            %mi 𝒫
                        %annotation{:encoding => "application/x-tex"} \Delta_0^{\mathcal{P}}
                    \-separation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                must be written in the language of first-order set theory and all quantifications must be guarded by a set or a
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/power+class"} power class
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∀
                        %mi x
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \forall x \in A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∃
                        %mi B
                        %mo ⊆
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \exists B \subseteq A
                %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
                exist.
            %li
              %p
                For
                %strong full separation
                aka simply
                = succeed "," do
                  %strong separation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                must be written in the language of first-order set theory, but otherwise anything goes; in a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/class+theory"} class theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                must be guarded by a class. Full separation trivially implies limited separation.
            %li
              %p
                For
                = succeed "," do
                  %strong large separation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                must be written in the language of first-order class theory; of course, this only makes sense
                %em in
                a class theory. The difference in strength between the class theories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi MK
                    %annotation{:encoding => "application/x-tex"} MK
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi NBG
                    %annotation{:encoding => "application/x-tex"} NBG
                is precisely that the former has large separation but the latter does not.
            %li
              %p
                Separation is sometimes called
                = succeed ";" do
                  %strong restricted comprehension
                = succeed "," do
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/full+comprehension"} full comprehension
                = succeed "," do
                  %strong comprehension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                needs to be given ahead of time. Full comprehension was proposed by
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gottlob+Frege"} Gottlob Frege
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Russell%27s+paradox"} Russell's paradox
                %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/paraconsistent+logic"} paraconsistent logic
            %li
              %p
                For
                = succeed "," do
                  %strong stratified comprehension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is given, but
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                is restricted to stratified formulas, in which each
                %a.existingWikiWord{:href => "/nlab/show/variable"} variable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                can be given a consistent
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sigma(x)
                (its stratification) such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \in y
                appears in the formula only if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \sigma(y) = \sigma(x) + 1
                = succeed "'s" do
                  %a.existingWikiWord{:href => "/nlab/show/Van+Quine"} Van Quine
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/New+Foundations"} New Foundations
          %h2#in_structural_set_theory In structural set theory
          %p
            Set theory is usually given in
            %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material
            form, with a language based on a global membership relation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \in
            %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
            (although full comprehension does not, except in a structural class theory with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/class+of+all+sets"} class of all sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi P
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ X | P \} = \{ a\colon X \;|\; P(a) \}
          %p
            and an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi P
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} {
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mi P
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} i_P\colon \{X|P\} \to X
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi b
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi a
                  %mo =
                  %msub
                    %mi i
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ↔
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \exists b\colon S,\; a = i_P(b) \;\leftrightarrow\; P(a) .
          %p
            Note that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mi P
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{X|P\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi P
                  %annotation{:encoding => "application/x-tex"} i_P
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in the structural sense.
          %p
            The structural axioms can of course be stated even in a material set theory, where they are actually weaker than the corresponding material axioms; however, the material axioms follow (as usual) from the structural axioms using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+replacement"} restricted replacement
          %p
            If a structural set theory is given by stating axioms for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+category"} Heyting category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+collection"} axiom of collection
            is equivalent to saying that the category of sets is
            %span.newWikiWord
              autological
              %a{:href => "/nlab/new/autological+category"} ?
            (see
            %a{:href => "https://arxiv.org/abs/1004.3802"} here
            for now for a definition of autological categories).
          %p The axiom schema of restricted separation is formally expressed by the rules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi S
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} set
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi S
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} |
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} set
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash S \; \mathrm{set} \quad \Gamma, x \in S \vdash P(x) \; \mathrm{prop}}{\Gamma \vdash \{x \in S \vert P(x)\} \; \mathrm{set}}
          .maruku-equation
