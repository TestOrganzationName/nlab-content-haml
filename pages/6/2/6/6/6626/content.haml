                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi y
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} |
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mi z
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} |
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} (
