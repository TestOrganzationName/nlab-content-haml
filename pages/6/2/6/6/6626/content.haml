                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi R
                      %mo ,
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo ⊢
                      %mo ∃
                      %mi y
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} |
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo .
                      %mi x
                      %mo =
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash S \; \mathrm{set} \quad \Gamma, x \in S \vdash P(x) \; \mathrm{prop}}{\Gamma, x \in R, P(x) \; \mathrm{true} \vdash \exists y \in \{x \in S \vert P(x)\}.x = i(y) \; \mathrm{true}}
          %h2#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mo ∈
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, \in)
            of
            %a.existingWikiWord{:href => "/nlab/show/pure+sets"} pure sets
            which behaves as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi V
                    %mo ⊢
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi y
                        %mo :
                        %mi V
                    %mi y
                    %mo ∈
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x:V \vdash \sum_{y:V} y \in x
            %strong axiom schema of separation
            is given by the following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rule"} inference rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi V
                      %mo ⊢
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msubsup
                        %mi{:mathvariant => "normal"} seperation
                        %mi V
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo :
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi x
                            %mo :
                            %mi V
                        %mi{:mathvariant => "normal"} isProp
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi V
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi S
                          %mo :
                          %mi V
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi V
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∈
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:V \vdash \phi(x) \; \mathrm{type}}{\Gamma \vdash \mathrm{seperation}_V^{\phi(-)}:\left(\prod_{x:V} \mathrm{isProp}(\phi(x))\right) \to \prod_{a:V} \sum_{S:V} \prod_{x:V} (x \in a) \to (\phi(x) \simeq (x \in S))}
          %h2#in_hyperdoctrines In hyperdoctrines
          %h3#LawvereDefinition Lawvere’s definition
          %p
            %a.existingWikiWord{:href => "/nlab/show/Lawvere"} Lawvere
            gives a definition (
            %a{:href => "#Lawvere70"}> Lawvere70, p. 12-13
            ) of comprehension in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hyperdoctrines"} hyperdoctrines
          #LawvereianComprehension.num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon E \to B
              be a
              %a.existingWikiWord{:href => "/nlab/show/bifibration"} bifibration
              over the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/fibre"} fibre
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi X
                  %annotation{:encoding => "application/x-tex"} E_X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi X
                    %annotation{:encoding => "application/x-tex"} T_X
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} t \colon Y \to X
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %em image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mi t
                  %annotation{:encoding => "application/x-tex"} im t
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              to be the pushforward (
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"}> dependent sum
              )
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mo !
                      %msub
                        %mi T
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} t_! T_Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %msub
                      %mi E
                      %mi X
                  %annotation{:encoding => "application/x-tex"} im \colon B/X \to E_X
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is said to
              = succeed "," do
                %em have comprehension
              = succeed "," do
                %em comprehension schema
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} }
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi E
                        %mi X
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \{-\} \colon E_X \to B/X
          .num_remark
            %h6#remark Remark
            %p
              This means that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %msub
                      %mi E
                      %mi X
                  %annotation{:encoding => "application/x-tex"} P \in E_X
              there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} {
                    %mi P
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_P \colon \{ P \} \to X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              such that there is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between commuting triangles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %msub
                      %mi i
                      %mi P
                    %mo ∘
                    %mi t
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} t = i_P \circ t'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mi t
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} im t \to P
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi X
                    %annotation{:encoding => "application/x-tex"} E_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi P
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \{P\} \to X
              the
              %em
                %a.existingWikiWord{:href => "/nlab/show/extension+%28semantics%29"} extension
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              satisfies the comprehension schema if the extensions of all predicates exist.
          %h3#ehrhards_reformulation Ehrhard’s reformulation
          %p
            Notice that, in the above situation, morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                  %mi t
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} \im t \to P
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi X
                %annotation{:encoding => "application/x-tex"} E_X
            are in bijection with morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi Y
                  %mo →
                  %msup
                    %mi t
                    %mo *
                  %mi P
                %annotation{:encoding => "application/x-tex"} T_Y \to t^* P
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} E_Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi Y
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} T_Y \to P
            in the total category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            that lie over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %a{:href => "#Ehrhard88"} Ehrhard 1988
            (see also
            = succeed "," do
              %a{:href => "#Jacobs93"} Jacobs 1993
            = succeed ")," do
              %a{:href => "#Jacobs99"} Jacobs 99
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            being a bifibration.
          %p
            Suppose the fibres
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi X
                %annotation{:encoding => "application/x-tex"} E_X
            have terminal objects that are preserved by the reindexing functors. This is equivalent to saying that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p:E\to B
            has a section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi B
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} T:B\to E
            taking each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to a terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi X
                %annotation{:encoding => "application/x-tex"} T_X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi X
                %annotation{:encoding => "application/x-tex"} E_X
            and each morphism to a cartesian arrow; such a functor is then automatically
            %a.existingWikiWord{:href => "/nlab/show/fully+faithful"} fully faithful
            and
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p:E\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            has a terminal object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            has a terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                %annotation{:encoding => "application/x-tex"} T_1
            preserved by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^*(T_1)
            will be terminal in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi X
                %annotation{:encoding => "application/x-tex"} E_X
            by combining the universal properties of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} X^*
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a bifibration, as in Lawvere’s definition, then the reindexing functors are right adjoints and hence automatically preserve all terminal objects.
          %p
            Comprehension in the sense above is equivalent to the existence of a further right adjoint to the terminal-object functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo :
                    %mi B
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} T:B\to E
          %p
            The implication from
            %a{:href => "#LawvereDefinition"} Lawvere’s definition
            to Ehrhard’s is clear. Conversely, if a fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p \colon E \to B
            satisfies the Ehrhard definition, then there is a bijection between morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi Y
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} T_Y \to P
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            and morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mi P
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Y \to \{P\}
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi P
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \{P\} \to X
            (given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            applied to the counit
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi P
                        %mo{:stretchy => "false"} }
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} T_{\{P\}} \to P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            applied to the morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mo{:stretchy => "false"} {
                    %mi P
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} Y \to \{P\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} B/X
            of the right sort. But in fact the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mi P
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Y \to \{P\}
            is unique with the property that applying the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} T_{-}
            and composing with the counit gives the morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi Y
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} T_Y \to P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to this commuting triangle in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            produces the required one in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %h3#examples Examples
          %h4#subsets Subsets
          %p
            The tautological example which is useful to see what the abstract
            %a{:href => "#LawvereDefinition"} definition by Lawvere
            axiomatizes is the following.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                %annotation{:encoding => "application/x-tex"} B =
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            be the category of sets and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi X
                %annotation{:encoding => "application/x-tex"} E_X
            be the
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            about elements in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            regarded as an object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi X
                %annotation{:encoding => "application/x-tex"} E_X
            (hence regarded as a proposition) to the same subset, but now regarded as a
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            More generally, the same construction works for the posets of subobjects in any
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
          %h4#presheaves Presheaves
          %p
            There is a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Cat
                      %mn 1
                      %mi op
                    %mo →
                    %msub
                      %mi CAT
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Cat_1^{op} \to CAT_1
            %a.existingWikiWord{:href => "/nlab/show/large+category"} large
            %a.existingWikiWord{:href => "/nlab/show/Cat"} 1-category of categories
            and functors to the ‘
            %a.existingWikiWord{:href => "/nlab/show/very+large+category"}> very large
            ’ 1-category of large categories and functors, that sends a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C^{op}, Set]
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F \colon C \to D
            to the pullback functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F^* \colon [D^{op}, Set] \to [C^{op}, Set]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
          %p
            %a{:href => "#Lawvere70"} Lawvere 70
            shows that this fibration has comprehension, with the
            %a.existingWikiWord{:href => "/nlab/show/extension+%28semantics%29"} extension
            of a presheaf given by its
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            together with the canonical projection from this to the base category.
          %h4#ExamplesDependentLinearTypeTheory In dependent linear type theory
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/hyperdoctrine"} hyperdoctrine
            has
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/linear+type+theories"} linear type theories
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
            as fibers, then it is more natural to consider in def.
            %a.maruku-ref{:href => "#LawvereianComprehension"}
            not the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            in some fiber (if any) but the
            %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
            (which of course happens to be the terminal object in the case of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal
          %p
            In this case then the image functor in def.
            %a.maruku-ref{:href => "#LawvereianComprehension"}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mover
                    %mo →
                    %mi f
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi f
                  %msub
                    %mn 1
                    %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma_X \;\colon\; (Y \stackrel{f}{\to} X) \mapsto \underset{f}{\sum} 1_Y
                  \\,.
          %p
            If this has a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi X
                  %annotation{:encoding => "application/x-tex"} R_X
            = succeed "," do
              %a.maruku-ref{:href => "#LawvereianComprehension"}
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo !
                    %mi X
                  %mo ≔
                  %msub
                    %mi Σ
                    %mi X
                  %mo ∘
                  %msub
                    %mi R
                    %mi X
                %annotation{:encoding => "application/x-tex"}
                  \!_X \coloneqq \Sigma_X \circ R_X
          %p
            is (the
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent
            version of) the canonical
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical interpretation
            of the
            %a.existingWikiWord{:href => "/nlab/show/exponential+modality"} exponential modality
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            %em
              %a{:href => "http://ncatlab.org/nlab/show/dependent+linear+type+theory#TheCanonicalComodality"} dependent linear type theory – The canonical co-modality
            for more.
          %h3#the_comprehensive_factorization_system The comprehensive factorization system
          %p
            If the extension functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi X
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} E_X \to B/X
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful"} fully faithful
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            into a ‘fibrewise
            = succeed "\u2019" do
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/stable+factorization+system"} stable factorization system
          %p
            Call a morphism of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi P
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \{P\} \to X
            a
            = succeed "." do
              %em subtype inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} t \colon Y \to X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            factors through one such by means of the unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi t
                %annotation{:encoding => "application/x-tex"} \eta_t
            of the adjunction
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo ⊣
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} im \dashv \{-\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi η
                                %mi t
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} {
                          %mi im
                          %mi t
                          %mo{:stretchy => "false"} }
                      %mtr
                        %mtd
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mi t
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                          %mpadded{:width => "0"}
                            %mrow
                              %msub
                                %mi i
                                %mi t
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Y &amp; &amp; \overset{\eta_t}{\to} &amp; &amp; \{ im t \} \\
                  \&amp; \mathllap{t}\searrow &amp; &amp; \swarrow\mathrlap{i_t} &amp; \\
                  \&amp; &amp; X &amp; &amp;
                  }
          %p
            This gives rise to an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
            precisely when each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi t
                %annotation{:encoding => "application/x-tex"} \eta_t
            is
            %a.existingWikiWord{:href => "/nlab/show/orthogonal"} orthogonal
            to all subtype inclusions. It is shown by
            %a{:href => "#Carboni97"} (Carboni et. al., section 2.12)
            that this holds if and only if subtype inclusions are closed under composition.
          %p
            For the subobject fibration of a regular category, this gives the usual (
            %a.existingWikiWord{:href => "/nlab/show/regular+epimorphism"}> regular epi
            ,
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} mono
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            it gives the factorization of a functor into a
            %a.existingWikiWord{:href => "/nlab/show/final+functor"} final functor
            followed by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+fibration"} discrete fibration
            %a.existingWikiWord{:href => "/michaelshulman/show/comprehensive+factorization"} comprehensive factorization
            for a description of the latter as a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/factorization+system+in+a+2-category"} factorization system in a 2-category
          %h2#axiom_or_axiom_scheme Axiom or axiom scheme?
          %p
            Although usually presented as an axiom scheme, in many cases, all instances of separation follow from finitely many special cases (which can then be packaged into a single axiom, using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/and"} conjunction
            %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            (a structural set theory that satisfied bounded separation) and
            %a.existingWikiWord{:href => "/nlab/show/NBG"} NBG
            (a material class theory that satisfies full separation). In
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type-theoretic
            foundations of mathematics, separation is usually invisible, but again some form (generally only bounded) can again be proved from a few specific axioms or constructions.
          %h2#relation_to_the_axiom_of_replacement Relation to the axiom of replacement
          %p
            Full separation follows from the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+replacement"} axiom of replacement
            and the principle of
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            (along with the axiom of the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            %a.existingWikiWord{:href => "/nlab/show/ZFC"} ZFC
            (the usually accepted foundation of mathematics). In versions of set theory for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+full+comprehension"} axiom of full comprehension
          %h2#references References
          %h3#general General
          %p (…)
          %h3#in_hyperdoctrines_2 In hyperdoctrines
          %ul
            %li#Lawvere70
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lawvere"}> Lawvere
                , F. W.
                = succeed "." do
                  %em Equality in hyperdoctrines and comprehension schema as an adjoint functor
                = succeed "," do
                  %em Proc. New York Symp. on Applications of Categorical Algebra
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/LawvereComprehension.pdf", :title => "pdf"} pdf
            %li#Lawvere73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lawvere"}> Lawvere
                , F. W.
                %em Metric spaces, generalized logic and closed categories
                Rend. Sem. Mat. Fis. Milano, 43:135–166 (1973). Reprints in Theory and Applications of Categories, No. 1 (2002) pp 1-37 (
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/1/tr1abs.html"}> tac
                )
            %li#Ehrhard88
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Ehrhard"}> Thomas Ehrhard
                \. A Categorical Semantics of Constructions. LICS 1988. (
                %a{:href => "https://www.irif.univ-paris-diderot.fr/~ehrhard/pub/categ-sem-constr.pdf"}> pdf
                )
            %li#Jacobs93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bart+Jacobs"}> Bart Jacobs
                \. Comprehension categories and the semantics of type dependency.
                %em Theoretical Computer Science
                107:2 (1993), pp. 169-207.
            %li#Jacobs99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bart+Jacobs"}> Bart Jacobs
                \.
                = succeed "." do
                  %em Categorical Logic and Type Theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Finn+Lawler"}> Finn Lawler
                , section “Tabulation and comprehension” in:
                %em
                  %a.existingWikiWord{:href => "/finnlawler/show/thesis+outline"} Fibrations of predicates and bicategories of relations
                (2014)
            %li#Carboni97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
