                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi i
                      %mo :
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi S
