                      %mi{:mathvariant => "normal"} true
                      %mo ⊢
                      %mi y
                      %mo =
                      %mi z
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash S \; \mathrm{set} \quad \Gamma, x \in S \vdash P(x) \; \mathrm{prop}}{\Gamma, y \in \{x \in S \vert P(x)\}, z \in \{x \in S \vert P(x)\}, i(y) = i(z) \; \mathrm{true} \vdash y = z \; \mathrm{true}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
