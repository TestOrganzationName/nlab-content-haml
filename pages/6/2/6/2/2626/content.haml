                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511623868"} doi:10.1017/CBO9780511623868
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Turaev"}> Vladimir Turaev
                \:
                = succeed "," do
                  %em Quantum invariants of knots and 3-manifolds
                = succeed "," do
                  %strong 18
                = succeed "," do
                  %a{:href => "https://doi.org/10.1515/9783110435221"} doi:10.1515/9783110435221
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/turaev5.pdf"} pdf
            %li
              %p
                Colin C. Adams,
                = succeed "," do
                  %em The Knot Book – An elementary Introduction to the Mathematical Theory of Knots
                = succeed "&rbrack;" do
                  %a{:href => "https://bookstore.ams.org/KNOT"} ISBN:978-0-8218-3678-1
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nick+Gilbert"}> Nick Gilbert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"} Tim Porter
                = succeed "," do
                  %em Knots and surfaces
                = succeed "&rbrack;" do
                  %a{:href => "https://global.oup.com/academic/product/knots-and-surfaces-9780198514909?cc=de&lang=en&"} ISBN:9780198514909
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tomotada+Ohtsuki"}> Tomotada Ohtsuki
                \:
                = succeed "," do
                  %em Quantum Invariants – A Study of Knots, 3-Manifolds, and Their Sets
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/4746"} doi:10.1142/4746
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Seiichi+Kamada"}> Seiichi Kamada
                \:
                = succeed "," do
                  %em Classical Braids and Links
                = succeed "," do
                  %em Braid and Knot Theory in Dimension Four
                = succeed "," do
                  %strong 95
                = succeed "&rbrack;" do
                  %a{:href => "https://bookstore.ams.org/view?ProductCode=SURV/95"} ISBN:978-0-8218-2969-1
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dale+Rolfsen"}> Dale Rolfsen
                ,
                = succeed "," do
                  %em Knots and links
                %strong 346
                (2003) &amp;lbrack;
                %a{:href => "https://bookstore.ams.org/chel-346-h"}> ams:chel-346-h
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/rolfsen.pdf"} pdf
            %li#Sossinsky23
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexei+B.+Sossinsky"}> Alexei B. Sossinsky
                ,
                = succeed "," do
                  %em Knots, Links and Their Invariants: An Elementary Course in Contemporary Knot Theory
                = succeed "," do
                  %strong 101
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1090/stml/101"} doi:10.1090/stml/101
          %p In higher dimensions:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Ranicki"}> Andrew Ranicki
              \:
              = succeed "," do
                %em High-dimensional knot theory – Algebraic Surgery in Codimension 2
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/978-3-662-12011-8"} doi:10.1007/978-3-662-12011-8
              = succeed "&rbrack;" do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/knot.pdf"} pdf
              %blockquote
                %p
                  (via
                  %a.existingWikiWord{:href => "/nlab/show/surgery"} surgery
                  and
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/L-theory"} L-theory
          %h3#relation_to_physics Relation to physics
          %p
            Relation of knot theory to
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Louis+Kauffman"}> Louis Kauffman
                ,
                = succeed "," do
                  %em Knots and physics
                = succeed "," do
                  %em Knots and Everything
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/1116"} doi:10.1142/1116
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Louis+Kauffman"} Louis Kauffman
                (ed.)
                = succeed "," do
                  %em The Interface of Knots and Physics
              %p
                Volume 51 (1996) (
                %a{:href => "http://www.csee.umbc.edu/~lomonaco/kelvin/kelvin23.pdf"}> pdf
                ,
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1090/psapm/051"} doi:10.1090/psapm/051
          %p
            and with emphasis on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/TQFT"} TQFT
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitry+Melnikov"}> Dmitry Melnikov
              \:
              %em A Tutorial on Knots and Quantum Mechanics
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2503.08846"}> arXiv:2503.08846
              \&amp;rbrack;
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            (
            %a.existingWikiWord{:href => "/nlab/show/NS5-branes"}> NS5-branes
            \/
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"}> M5-branes
            ):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              = succeed "," do
                %em Fivebranes and Knots
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1101.3216"} arXiv:1101.3216
              = succeed ")" do
                %a{:href => "https://www.ems-ph.org/journals/show_abstract.php?issn=1663-487X&vol=3&iss=1&rank=1"} doi:10.4171/QT/26
          %p
            For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/knot+invariants+via+topological+strings+and+5-branes+--+references"} knot invariants via topological strings and 5-branes – references
          %h3#higher_dimensional_knots Higher dimensional knots
