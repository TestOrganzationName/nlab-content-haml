            %li#Selinger04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Selinger"}> Peter Selinger
                ,
                = succeed "," do
                  %em Towards a quantum programming language
                %strong 14
                4 (2004) 527–586 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0960129504004256"}> doi:10.1017/S0960129504004256
                ,
                = succeed "," do
                  %a{:href => "https://www.mathstat.dal.ca/~selinger/papers/qpl.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://www.mathstat.dal.ca/~selinger/papers.html#qpl"} web
            %li#GurevichBlass21
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Gurevich"}> Yuri Gurevich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andreas+Blass"} Andreas Blass
                = succeed "," do
                  %em Quantum circuits with classical channels and the principle of deferred measurements
                %strong 920
                (2022) 21–32 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2107.08324"}> arXiv:2107.08324
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.tcs.2022.02.002"} doi:10.1016/j.tcs.2022.02.002
          %p Standard textbook accounts:
          %ul
            %li#NielsenChuang00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+A.+Nielsen"}> Michael A. Nielsen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Isaac+L.+Chuang"} Isaac L. Chuang
                = succeed "," do
                  %em Quantum computation and quantum information
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/CBO9780511976667"} doi:10.1017/CBO9780511976667
                = succeed "," do
                  %a{:href => "http://csis.pace.edu/~ctappert/cs837-19spring/QC-textbook.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/NielsenChuangQuantumComputation.pdf", :title => "pdf"} pdf
            %li#Miszczak11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jaros%C5%82aw+Adam+Miszczak"}> Jarosław Adam Miszczak
                , Sec. 3 of:
                = succeed "," do
                  %em Models of quantum computation and quantum programming languages
                %strong 59
                3 (2011)305-324 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1012.6035"}> arXiv:1012.6035
