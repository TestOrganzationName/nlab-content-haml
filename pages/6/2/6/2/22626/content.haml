          %p
            On quantum circuits for
            %a.existingWikiWord{:href => "/nlab/show/mixed+quantum+states"} mixed quantum states
            (with
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/density+matrices"} density matrices
          %ul
            %li#AharonovKitaevNisan98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dorit+Aharonov"}> Dorit Aharonov
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexei+Kitaev"} Alexei Kitaev
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Noam+Nisan"} Noam Nisan
                = succeed "," do
                  %em Quantum Circuits with Mixed States
                %em Proceedings of the Thirtieth Annual ACM Symposium on Theory of Computation (STOC)
                (1998) 20-30 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/quant-ph/9806029"}> arXiv:quant-ph/9806029
                ,
