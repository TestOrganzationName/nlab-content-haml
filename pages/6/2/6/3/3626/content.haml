                (2014). (
                %a{:href => "https://arxiv.org/abs/1401.5980"}> arXiv:1401.5980
                )
          %p
            Frobenius algebras in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+categories"} linearly distributive categories
          %ul
            %li#Egger10
