          %h2#references References
          %p
            Frobenius algebras were introduced by
            %a.existingWikiWord{:href => "/nlab/show/Brauer"} Brauer
            and Nesbitt and were named after
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ferdinand+Frobenius"} Ferdinand Frobenius
          %p See for instance
          %ul#Aguiar2000
            %li#Eilenberg1955
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tadasi+Nakayama"} Tadasi Nakayama
                = succeed "," do
                  %em On the dimension of modules and algebras. II. Frobenius algebras and quasi-Frobenius rings
                %em Nagoya Math. J.
                %strong 9
                (1955) 1-16 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S0027763000023229"}> doi:10.1017/S0027763000023229
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcelo+Aguiar"} Marcelo Aguiar
                (2000),
                = succeed "," do
                  %em A note on strongly separable algebras
                = succeed "," do
                  %strong 65
                = succeed ")" do
                  %a{:href => "http://www.math.cornell.edu/~maguiar/strongly.pdf"} pdf
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Baker"}> Andrew Baker
              ,
              %em Frobenius algebras
              2010 (
              %a{:href => "http://www.maths.gla.ac.uk/~ajb/dvi-ps/Frobenius-talk.pdf"}> pdf
              )
          %p
            On the role of Frobenius algebras in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/2d+TQFT"} 2d TQFT
          %ul
            %li#Abrams96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lowell+Abrams"}> Lowell Abrams
                ,
                = succeed "," do
                  %em Two-dimensional topological quantum field theories and Frobenius algebra
                = succeed "," do
                  %strong 5
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/S0218216596000333"} doi:10.1142/S0218216596000333
                = succeed "&rbrack;" do
                  %a{:href => "http://home.gwu.edu/~labrams/docs/tqft.ps"} ps
            %li#BaezTWF
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
                , This Week’s Finds in Mathematical Physics,
                %a{:href => "http://math.ucr.edu/home/baez/week268.html"} week268
                and
                = succeed "." do
                  %a{:href => "http://math.ucr.edu/home/baez/week299.html"} week299
            %li#Kock2004
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"}> Joachim Kock
                ,
                = succeed "," do
                  %em Frobenius Algebras and 2d Topological Quantum Field Theories
                = succeed "," do
                  %a{:href => "https://www.cambridge.org/core/books/frobenius-algebras-and-2d-topological-quantum-field-theories/A6438118DFADFD27175779F1FC0FF7CB"} doi:10.1017/CBO9780511615443
                = succeed "," do
                  %a{:href => "http://mat.uab.cat/~kock/TQFT.html"} webpage
                = succeed "," do
                  %a{:href => "http://mat.uab.es/~kock/TQFT/FS.pdf"} course notes pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Kock-FrobAlgTQFT-short.pdf", :title => "pdf"} pdf
            %li#Kock2006
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"}> Joachim Kock
                , Remarks on the history of the Frobenius equation (2006) &amp;lbrack;
                %a{:href => "http://mat.uab.es/~kock/TQFT.html#history"}> web
                \&amp;rbrack;
            %li#Lauda2006
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aaron+Lauda"}> Aaron Lauda
                \:
                = succeed "," do
                  %em Frobenius algebras and ambidextrous adjunctions
                %strong 16
                4 (2006) 84-122 &amp;lbrack;
                %a{:href => "http://tac.mta.ca/tac/volumes/16/4/16-04abs.html"}> tac:16-04
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://arxiv.org/abs/math/0502550"} arXiv:math/0502550
              %blockquote
                %p
                  (relating to
                  %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunctions"} ambidextrous adjunctions
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Frobenius+monads"} Frobenius monads
            %li#Lauda2008
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aaron+Lauda"}> Aaron Lauda
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hendryk+Pfeiffer"} Hendryk Pfeiffer
                %em Topology Appl.
                %strong 155
                (2005) 623-666 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0510664"}> arXiv:0510664
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.topol.2007.11.005"} doi:10.1016/j.topol.2007.11.005
          %p
            For applications in proof theory of classical and
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            or linguistics:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Hyland"}> Martin Hyland
