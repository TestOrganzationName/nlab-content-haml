            %p
          %h3#from_symmetric_powers_to_functorial_special_bicommutative_graded_bimonoid From symmetric powers to functorial special bicommutative graded bimonoid
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℚ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}^{+}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a symmetric monoidal category enriched over
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi n
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi n
                        %mo ≤
                        %mi p
                  %annotation{:encoding => "application/x-tex"} (S_{n}:\mathcal{C} \rightarrow \mathcal{C})_{0 \le n \le p}
              of endofunctors such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi I
                  %annotation{:encoding => "application/x-tex"} S_{0}(A)=I
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi A
                    %annotation{:encoding => "application/x-tex"} S_{1}(A)=A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi n
                    %mo :
                    %msup
                      %mi A
                      %mrow
                        %mo ⊗
                        %mi n
                    %mo →
                    %msub
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi n
                        %mo ≤
                        %mi p
                  %annotation{:encoding => "application/x-tex"} (r_{n}:A^{\otimes n} \rightarrow S_{n}(A))_{0 \le n \le p}
              of natural transformations which make
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
