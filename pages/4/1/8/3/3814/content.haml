                  e^{2 \pi i \tfrac{1}{2}} \mathbf{1}_2\;,\;
                  e^{2 \pi i \tfrac{1}{3}} \mathbf{1}_3
                  \\right)
                  \\;\in\;
                  U(1) \times SU(2) \times SU(3)
                  \\,.
          %p
            (See
            %a{:href => "#BaezHuerta09"} Baez-Huerta 09, p. 33-36
            for a fairly comprehensive discussion; also e.g.
            = succeed "." do
              %a{:href => "#HMY13"} HMY 13, p. 2
          %p
            This is in the sense that all
            %em known
            %a.existingWikiWord{:href => "/nlab/show/elementary+particles"} elementary particles
            in the standard model are
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 6
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/6
            subgroup. In principle it could be that as yet undetected heavy particles break this invariance after all, cf.
            = succeed ".)" do
              %a{:href => "#LiXu24"} Li &amp; Xu 2024
          %p
            Strikingly, this exact gauge group
            %a.maruku-eqref{:href => "#eq:ExactGSM"} (1)
            of the standard model of particle physics happens to coincide with…
          %ol
            %li
              %p …the group
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi SM
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mi S
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ⊂
                      %mspace{:width => "thickmathspace"}
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 5
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      G_{SM}
                      \\;\simeq\;
                      S\big(U(2) \times U(3)\big)
                      \\;\subset\;
                      SU(5)
              %p
                of
                = succeed "-1" do
                  %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
                %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(2) \times U(3)
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                of the
                %a.existingWikiWord{:href => "/nlab/show/simple+Lie+group"} simple Lie group
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} SU(5)
              %p
                This is the basis of “
                %a.existingWikiWord{:href => "/nlab/show/grand+unified+theories"}> grand unified theories
                ” (
                %a.existingWikiWord{:href => "/nlab/show/GUT"}> GUT
                ), speculative extensions of the standard model trying to understand its gauge group as being a
                %a.existingWikiWord{:href => "/nlab/show/spontaneously+broken+symmetry"} spontaneously broken
                = succeed "-" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/simple+Lie+group"} simple Lie group
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/symmetry"} symmetry
            %li
