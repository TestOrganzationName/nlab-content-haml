                    \\stackrel{F(\mu_A)}{\to}
                    F(A)
                    \\,.
            %p This construction defines a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Mon
