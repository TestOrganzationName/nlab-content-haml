                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Mon(f) : Mon(C) \to Mon(D)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/categories+of+monoids"} categories of monoids
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          %p
            More generally, lax functors send
            %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            to enriched categories, an operation known as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/change+of+enriching+category"} change of enriching category
          %p Similarly:
          #OplaxSendsComonoidsToComonoids.un_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/oplax+monoidal+functors"} oplax monoidal functors
                sends
                %a.existingWikiWord{:href => "/nlab/show/comonoids"} comonoids
                to comonoids)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\otimes)
              a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}C
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %p
              Lax monoidal functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f : C \to D
              correspond to
              %a.existingWikiWord{:href => "/nlab/show/lax+2-functor"} lax 2-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi F
