          %h2#idea Idea
          %p
            A
            %em monoidal functor
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            that preserves the monoidal structure: a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of monoidal categories.
          %h2#definition Definition
          #LaxMonoidalFunctor.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes_{\mathcal{C}}, 1_{\mathcal{C}})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
