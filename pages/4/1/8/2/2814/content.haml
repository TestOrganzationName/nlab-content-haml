                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F : (C,\otimes) \to (D,\otimes)
              is a lax monoidal functor and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∈
                    %mi C
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi μ
                      %mi A
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo →
                    %mi A
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi i
                      %mi A
                    %mo :
                    %mi I
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (A \in C,\;\; \mu_A : A \otimes A \to A, \; i_A : I \to A)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(A)
              is naturally equipped with the structure of a monoid in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi I
                      %mi D
                    %mover
                      %mo →
                      %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mi A
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_{F(A)} : I_D \stackrel{}{\to} F(I_C) \stackrel{F(i_A)}{\to} F(A)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
