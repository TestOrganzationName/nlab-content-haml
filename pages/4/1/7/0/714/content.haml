                    %mrow
                      %msub
                        %mi Span
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Span_1(C)
                be the 1-category of
                %a.existingWikiWord{:href => "/nlab/show/spans"} spans
                up to isomorphism: its morphisms are spans with one leg labeled as source, the other labeled as target. Then the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo †
                      %mo :
                      %msub
                        %mi Span
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo →
                      %msub
                        %mi Span
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \dagger : Span_1(C)^{op} \to Span_1(C)
                which just exchanges this labeling is a †-structure on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Span
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Span_1(C)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℛ
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{R}(G)
                , the category of unitary
                %a.existingWikiWord{:href => "/nlab/show/representation"} representations
                of a (discrete)
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                and intertwining maps, is a †-category. For an intertwiner
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %mi R
                        %mo →
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \phi : R \rightarrow S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mo †
                      %mo :
                      %mi S
                      %mo →
                      %mi R
                    %annotation{:encoding => "application/x-tex"} \phi^\dagger : S \rightarrow R
                be the adjoint of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Hilb"} Hilb
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/category+of+couplings"} category of couplings
                between
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/probability+spaces"} probability spaces
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/symmetric+proset"} symmetric proset
                is a
                %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
                †-category.
          %h2#variants Variants
          %ul
            %li
              %p
                %span.newWikiWord
                  strict dagger category
                  %a{:href => "/nlab/new/strict+dagger+category"} ?
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/univalent+dagger+category"} univalent dagger category
          %h3#monoidal_categories Monoidal †-categories
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monoidal+dagger+category"} monoidal dagger category
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+dagger+category"} braided monoidal dagger category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+dagger+category"} symmetric monoidal dagger category
                %li
                  %p
                    %span.newWikiWord
                      compact closed dagger category
                      %a{:href => "/nlab/new/compact+closed+dagger+category"} ?
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+dagger+category"} cartesian monoidal dagger category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/cocartesian+monoidal+dagger+category"} cocartesian monoidal dagger category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/semiadditive+dagger+category"} semiadditive dagger category
          %h3#2posets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo †
                %annotation{:encoding => "application/x-tex"} \dagger
            \-2-posets
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/dagger+2-poset"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
              \-2-poset
            is a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-poset"} 2-poset
            = succeed "-2-posets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            %a.existingWikiWord{:href => "/nlab/show/allegories"} allegories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bicategories+of+relations"} bicategories of relations
          %h3#ModelStructure Model structure on †-categories
          %blockquote
            %p
              the following is based on a remark by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
              %a{:href => "https://github.com/punkdit/categories/blob/master/gmane/science/mathematics/categories/5477"} posted
              to the CategoryTheory mailing list on Jan 5, 2010, with a
              %a{:href => "https://github.com/punkdit/categories/blob/master/gmane/science/mathematics/categories/5487"} follow-up
              on Jan 6.
          %p
            Consider †-categories from the point of view of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            Recall that the category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            of
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small categories
            naturally admits the
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/folk+model+structure+on+Cat"} folk model structure on Cat
          %p
            The category of small †-categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DCat
                %annotation{:encoding => "application/x-tex"} DCat
            also admits a “natural”
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure:
          %ul
            %li
              %p
                †-functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f:A \to B
                is a weak equivalence iff it is
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"}> full and faithful
                    ;
                %li
                  %p
                    and unitary surjective, meaning that every object of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                        %annotation{:encoding => "application/x-tex"} B
                    is unitary isomorphic to an object in the image of the functor
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                          %annotation{:encoding => "application/x-tex"} f
            %li
              %p
                the cofibrations and the trivial fibrations are as in
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/folk+model+structure+on+Cat"} Cat
            %li
              %p
                fibrations are the unitary isofibration: maps having the
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                for unitary isomorphisms.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DCat
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} DCat \to Cat
            is a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            but it is not a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} right Quillen functor
            with respect to the natural model structures on these categories.
          %p
            Moreover, a forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi XStruc
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} XStruc \to Cat
            should reflect weak equivalences in addition to preserving them. The forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DCat
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} DCat\to Cat
            preserves weak equivalences but it does not reflect them. Because two objects in a †-category can be isomorphic without been unitary isomorphic.
          %p
            In other words the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DCat
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} DCat\to Cat
            is wrong. This may explains why a †-category cannot be regarded as a category equipped a homotopy invariant structure, as discussed in more detail in the example sections of the entry
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
          %p
            But the notion of †-category is perfectly reasonable from an homotopy theoretic point of view. This is because the model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi DCat
                %annotation{:encoding => "application/x-tex"} DCat
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to the model category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DCat
                  %annotation{:encoding => "application/x-tex"} DCat
          %h3#simplicial_set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo †
                %annotation{:encoding => "application/x-tex"} \dagger
            \-simplicial set
          %blockquote
            %p
              the following is based on a remark by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
          %p
            A †-
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            can be defined to be a simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with an involutive
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo †
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mi X
                    %mi op
                %annotation{:encoding => "application/x-tex"} \dagger :X\to X^{op}
            which is the identity on 0-cells. The category of †-simplicial sets (and dagger preserving maps) is the category of
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
            on the category whose objects are the ordinals
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [m]\to [n]
            are order reversing or preserving.
          %h4#graphs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo †
                %annotation{:encoding => "application/x-tex"} \dagger
            \-Graphs
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/dagger-graph"} dagger-graph
          %h3{:id => "#oo1Version"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-†-categories
          %blockquote
            %p
              the following is based on a remark by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
          %p
            There should be a notion of †-
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            based on
            = succeed "-simplicial" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          %p (…)
          %h2#properties Properties
          %h3#relation_to_antiinvolutive_monoids Relation to anti-involutive monoids
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            of an
            %a.existingWikiWord{:href => "/nlab/show/anti-involution"} anti-involutive
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            is a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          %h3#relation_to_symmetric_prosets Relation to symmetric prosets
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/symmetric+proset"} symmetric proset
            is a
            %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            %a.existingWikiWord{:href => "/nlab/show/groupoidal+categorification"} groupoidal categorification
            of a symmetric proset is a
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo †
                %annotation{:encoding => "application/x-tex"} \dagger
            operation being the groupoidal categorification of the symmetric property.
          %h3#relation_to_staralgebras Relation to star-algebras
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category+convolution+algebra"} category convolution algebra
            of a dagger category is naturally a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+functions"} pullback of functions
            along the
            = succeed "-functor." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          %h2#applications Applications
          %h3#quantum_mechanics_in_terms_of_compact_categories
            Quantum mechanics in terms of
            = succeed "-compact" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+Hilbert+spaces"} finite-dimensional Hilbert spaces
            of interest in
            %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory"} quantum information theory
            and
            %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
            form
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            %a.existingWikiWord{:href => "/nlab/show/compact+closed+categories"} compact closed categories
            (
            %a.existingWikiWord{:href => "/nlab/show/dagger+compact+categories"}> dagger compact categories
            ), a fact that allow a
            = succeed "-calculus" do
              %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics+in+terms+of+%E2%80%A0-compact+categories"} quantum mechanics in terms of †-compact categories
            which motivates much of the contemporary discussion of dagger-categories, starting with
            = succeed "." do
              %a{:href => "#AbramskyCoecke04"} Abramsky &amp; Coecke 2004
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pseudograph"} pseudograph
            %li
              %p
