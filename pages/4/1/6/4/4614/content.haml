          .proof
            %h6#proof_3 Proof
            %p
              Applying Lemma
              %a.maruku-ref{:href => "#DiagonalIsRealization"}
              as above, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi S
