                        %mi n
                    %annotation{:encoding => "application/x-tex"} {|\Delta^n_{sSet}|} = \Delta^n_{Top}
          %p This fact is attributed to Tornehave by Quillen on page 94 of his ‘Higher Algebraic K-theory I’.
          %p
            Finally, for any simplicial space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
