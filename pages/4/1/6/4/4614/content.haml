                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
