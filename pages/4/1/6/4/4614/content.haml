                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi l
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [k] \to [l]
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi f
                    %mo *
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi X
                    %mi l
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Top
                    %mi l
                %annotation{:encoding => "application/x-tex"} (x,f_* p) \in X_l \times \Delta^l_{Top}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi X
                      %mi k
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (f^* x,p) \in X_k \times \Delta^k_{Top}
          %p
            This form of geometric realization of simplicial topological spaces goes back to (
            %a{:href => "#Segal68"}> Segal 1968
            ). An early reference that realizes this construction as a
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            is (
            %a{:href => "#MacLane"}> MacLane
            ).
          %p
            One also considers geometric realization after
            %a{:href => "semi-simplicial+set#AdjunctionWithSimplicialSets"} restricting
            to the subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo +
                  %mover
                    %mo ↪
                    %mrow
                      %msup
                        %mi j
                        %mi op
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta_+ \overset{j^{op}}{\hookrightarrow} \Delta
            of the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            on the strictly increasing maps (that is, the coface maps only—no codegeneracies). (This yields the underlying
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/semi-simplicial+set"} semi-simplicial set
          #FatGeometricRealization.num_defn
            %h6#definition_3 Definition
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              is called the
              %strong fat geometric realization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} ‖
                    %mo ≔
                    %msup
                      %mo ∫
                      %mrow
                        %mi n
                        %mo ∈
                        %msub
                          %mi Δ
                          %mo +
                    %msub
                      %mi X
                      %mi n
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\Vert X_\bullet\Vert} \coloneqq   \int^{n \in \Delta_+} X_n \times \Delta^n_{Top}
                    \\,.
          %p
            This is called
            %em fat
            , because it does not
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            out the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
          %p
            Explicitly, this is the
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            given by the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} ‖
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi n
                  %msub
                    %mi X
                    %mi n
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Top
                    %mi n
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mo ∼
                      %mo +
                %annotation{:encoding => "application/x-tex"}
                  {\Vert X_\bullet \Vert} = \coprod_{n} X_n\times \Delta^n_{Top} /{\sim_+}
          %p
            where the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mo ∼
                    %mo +
                %annotation{:encoding => "application/x-tex"} \sim_+
            ” identifies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi f
                    %mo *
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi X
                    %mi l
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Top
                    %mi l
                %annotation{:encoding => "application/x-tex"} (x,f_* p) \in X_l\times \Delta^l_{Top}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mo *
                  %mi x
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi X
                    %mi k
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi Top
                    %mi k
                %annotation{:encoding => "application/x-tex"} (f^* x,p) \in X_k\times \Delta^k_{Top}
            only when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi l
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [k] \to [l]
            is a coface map.
          #GeometricRealizationOfThePoint.num_example
            %h6#example Example
            %p
              The geometric realization of the point — the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
              that is in each degree the 1-point topological space — is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              to the point, but the fat geometric realization of the point is an “infinite dimensional topological ball”: the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo *
                      %mo{:stretchy => "false"} |
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ≃
                          %mi iso
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    {\vert * \vert} \stackrel{\simeq_{iso}}{\longrightarrow} *
            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mo *
                      %mo{:stretchy => "false"} ‖
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ≃
                          %mrow
                            %mi h
                            %mo .
                            %mi e
                            %mo .
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    {\Vert * \Vert} \stackrel{\simeq_{h.e.}}{\longrightarrow} *
            %p
              is just a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          .num_remark
            %h6#remark Remark
            %p
              The ordinary geometric realization can be described as the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+functors"} tensor product of functors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} |
                      %mo =
                      %msup
                        %mi Δ
                        %mo •
                      %msub
                        %mo ⊗
                        %mi Δ
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} {|X_\bullet|}=\Delta^\bullet \otimes_{\Delta} X_\bullet
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} ‖
                      %mo =
                      %msup
                        %mi i
                        %mo *
                      %msup
                        %mi Δ
                        %mo •
                      %msub
                        %mo ⊗
                        %mrow
                          %msub
                            %mi Δ
                            %mo +
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} {\Vert X_\bullet\Vert} = i^* \Delta^\bullet \otimes_{\Delta_+} i^* X_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Δ
                      %mo +
                    %mo ↪
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} i\colon \Delta_+ \hookrightarrow \Delta
              is the inclusion. By general facts about tensor product of functors (essentially, the associativity of composition of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} ‖
                      %mo ≅
                      %msup
                        %mi Δ
                        %mo •
                      %msub
                        %mo ⊗
                        %mi Δ
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Lan
                        %mi i
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi X
                        %mo •
                      %mo ≅
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi Lan
                          %mi i
                        %msup
                          %mi i
                          %mo *
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\Vert X_\bullet\Vert} \cong \Delta^\bullet \otimes_{\Delta} \Lan_i i^* X_\bullet \cong {| Lan_i i^* X_\bullet |}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is the ordinary geometric realization of a “fattened up” version of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              and then “freely throwing in new ones.”
          %h2#reminder_on_nice_simplicial_topological_spaces Reminder on nice simplicial topological spaces
          %p
            Simplicial topological spaces are in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            presentations for certain
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+%E2%88%9E-groupoid"} topological ∞-groupoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
          %p
            Recall the following definitions and facts from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nice+simplicial+topological+space"} nice simplicial topological space
          #GoodAndProper.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} X \colon  \Delta^{op} \to Top
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
            %p
              Such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
            %ul
              %li
                %p
                  %strong good
                  (
                  %a{:href => "#Segal73"}> Segal 1973, App. 2
                  ;
                  = succeed ")" do
                    %a{:href => "#Segal74"} Segal 1974, Def. A.4
                %p
                  if all the degeneracy maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ↪
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X_{n-1} \hookrightarrow X_n
                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+cofibrations"} closed cofibrations
              %li
                %p
                  %strong proper
                  (
                  %a{:href => "#May72"}> May 1972
                  )
                %p
                  if the inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %msub
                          %mi X
                          %mi n
                        %mo ↪
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} s X_n \hookrightarrow X_n
                  of the degenerate simplices is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/closed+cofibration"} closed cofibration
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %msub
                            %mi X
                            %mi n
                          %mo =
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                            %mi i
                          %msub
                            %mi s
                            %mi i
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} s X_n = \bigcup_i s_i(X_{n-1})
            %p
              Noticing that the union of degenerate simplices appearing here is a
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} latching object
              and that closed cofibrations are cofibrations in the
              %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} Strøm model structure
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
                is
                %strong proper
                if it is cofibrant in the
                %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi op
                      %mo ,
                      %msub
                        %mi Top
                        %mi Strom
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi Reedy
                    %annotation{:encoding => "application/x-tex"} [\Delta^{op}, Top_{Strom}]_{Reedy}
                on
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                with respect to the
                %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} Strøm model structure
                on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          #GoodImpliesProper.num_prop
            %h6#proposition Proposition
            %p A good simplicial topological space is proper:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mi good
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mi proper
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (X_\bullet \; good) \Rightarrow (X_\bullet\; proper)
                    \\,.
          %p
            (
            %a{:href => "#RobertsStevenson"}> Roberts &amp; Stevenson 2012, App. A
            , following hints in
            = succeed ")" do
              %a{:href => "#GaunceLewis82"} Gaunce Lewis 1982
          %h3#bisimplicial_sets_and_good_resolutions Bisimplicial sets and good resolutions
          %p
            We now discuss the
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of any simplicial topological space by a good one. Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                  %mo ⊣
                  %mi Sing
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Top
                  %mover
                    %munder
                      %mo ⟶
                      %mi Sing
                    %mover
                      %mo ⟵
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  ({\vert- \vert} \dashv Sing)
                  \\colon
                  Top
                  \\stackrel{\overset{{|-|}}{\longleftarrow}}{\underset{Sing}{\longrightarrow}}
                  sSet
          %p
            for the ordinary
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Top
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} {|Sing(-)|}\colon Top\to Top
            is a cofibrant replacement functor: for any space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|Sing(X)|}
            is a CW complex and comes with a natural map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Sing
                    %mi X
                    %mo{:stretchy => "false"} |
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} {|Sing X|} \to X
            (the
            %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
            of the adjunction
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mo ⊣
                    %mi Sing
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ({|-|} \dashv Sing)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          #GoodResolution.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              be a simplicial topological space. Then the simplicial topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi Top
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    {|Sing(X_\bullet)|} \in [\Delta^{op}, Top] \,,
            %p
              obtained by applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Top
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} {|Sing(-)|} \colon  Top \to Top
              degreewise, is good and hence proper. Moreover, we have a natural morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Sing
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} |
                    %mo →
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    {|Sing X_\bullet|} \to X_\bullet
            %p which is degreewise a weak homotopy equivalence.
          .proof
            %h6#proof Proof
            %p
              Each space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Sing
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |Sing X_n|
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+equi-connected+space"} locally equi-connected space
              = succeed ")" do
                %a{:href => "#GaunceLewis82"} Gaunce Lewis 1982, p. 153
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/closed+cofibration"} closed cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Sing
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |Sing X_\bullet|
              are closed cofibrations.
            %p The second sentence follows directly by the remarks above.
          %p#OtherGoodResolutions
            Note that there is nothing special about
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|Sing(-)|}
            in the proof; any functorial CW replacement would do just as well (such as that obtained by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau(-)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi simp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} simp(-)
            in
            = succeed ")." do
              %a{:href => "#Segal74"} Segal 1974, p. 308-309
          %p
            However,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|Sing(-)|}
            has the advantage that its geometric realization can be computed alternately in terms of diagonals of bisimplicial sets, as we now show.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mo •
                      %mo ,
                      %mo •
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Δ
                    %mi op
                  %mo ×
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} S_{\bullet,\bullet} \colon  \Delta^{op} \times \Delta^{op} \to Set
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} bisimplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi S
                %annotation{:encoding => "application/x-tex"} d S
            for its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %msup
                    %mi Δ
                    %mi op
                  %mo ×
                  %msup
                    %mi Δ
                    %mi op
                  %mover
                    %mo ⟶
                    %mi S
                  %mi Set
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Delta^{op} \to \Delta^{op} \times \Delta^{op} \stackrel{S}{\longrightarrow} Set.
          %p
            On the other hand, we can also consider a bisimplicial set as a simplicial object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            and take its “geometric realization”:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi S
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msup
                        %mi Δ
                        %mi op
                  %msub
                    %mi S
                    %mrow
                      %mi n
                      %mo ,
                      %mo •
                  %mo ×
                  %msubsup
                    %mi Δ
                    %mi sSet
                    %mi n
                %annotation{:encoding => "application/x-tex"} {|S_{\bullet,\bullet}|} \coloneqq \int^{[n]\in\Delta^{op}} S_{n,\bullet} \times \Delta^n_{sSet}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Δ
                    %mi sSet
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Delta^n_{sSet}
            denotes the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \Delta(-,[n])\colon \Delta^{op}\to Set
          #DiagonalIsRealization.num_lemma
            %h6#lemma Lemma
            %p
              For a bisimplicial set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mrow
                          %mo •
                          %mo ,
                          %mo •
                    %annotation{:encoding => "application/x-tex"} S_{\bullet,\bullet}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi S
                      %mo ≅
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi S
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} d S \cong {|S|}
          .proof
            %h6#proof_2 Proof
            %p
              Both functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|-|}
              are
              %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous
              functors between
              %a.existingWikiWord{:href => "/nlab/show/presheaf+categories"} presheaf categories
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                          %mo ×
                          %msup
                            %mi Δ
                            %mi op
                      %mo →
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\Delta^{op}\times\Delta^{op}} \to Set^{\Delta^{op}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Delta\times\Delta)(-,([n],[m]))
              is called a
              %em bisimplex
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mrow
                          %mi n
                          %mo ,
                          %mi m
                    %annotation{:encoding => "application/x-tex"} \Delta^{n,m}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mi Δ
                      %mrow
                        %mi n
                        %mo ,
                        %mi m
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi Δ
                      %mi sSet
                      %mi n
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mi sSet
                      %mi m
                    %mo .
                  %annotation{:encoding => "application/x-tex"} (d \Delta^{n,m})(-) = \Delta(-,n) \times \Delta(-,m) = \Delta^n_{sSet} \times \Delta^m_{sSet}.
            %p
              Now note that geometric realization of a bisimplicial set is left adjoint to the “singular complex”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mo{:lspace => "verythinmathspace"} :
                    %mi sSet
                    %mo →
                    %msup
                      %mi sSet
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Sing\colon sSet \to sSet^{\Delta^{op}}
              defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mi Map
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi sSet
                      %mi n
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi m
                    %mo =
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi sSet
                      %mi n
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mi sSet
                      %mi m
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mi Δ
                      %mrow
                        %mi n
                        %mo ,
                        %mi m
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing(X_\bullet)(n,m) = \underline{Map}(\Delta^n_{sSet}, X_\bullet)_m = sSet(\Delta^n_{sSet} \times \Delta^m_{sSet}, X_\bullet) = sSet(d \Delta^{n,m}, X_\bullet)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Map
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{Map}(-,-)
              denotes the simplicial mapping space between two simplicial sets. But by the Yoneda lemma,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi sSet
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mrow
                          %mi n
                          %mo ,
                          %mi m
                      %mo ,
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sing(X_\bullet)(n,m) = sSet^{\Delta^{op}}(\Delta^{n,m},Sing(X_\bullet))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msup
                      %mi Δ
                      %mrow
                        %mi n
                        %mo ,
                        %mi m
                  %annotation{:encoding => "application/x-tex"} d \Delta^{n,m}
              has the same universal property as
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mi Δ
                          %mrow
                            %mi n
                            %mo ,
                            %mi m
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|\Delta^{n,m}|}
          %p In particular, the lemma implies that for the two different ways of considering a bisimplicial set as a simplicial simplicial set (“vertically” or “horizontally”), the resulting “geometric realizations” as simplicial sets are isomorphic (since both are isomorphic to the diagonal, which is symmetrically defined).
          %p
            Note that Lemma
            %a.maruku-ref{:href => "#DiagonalIsRealization"}
            can be interpreted as an isomorphism between two
            %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mi ⇸
                    %mi Δ
                    %mo ×
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta &amp;#8696; \Delta\times\Delta
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            by the diagonal functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo →
                    %mi Δ
                    %mo ×
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta \to \Delta\times\Delta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mrow
                      %mo •
                      %mo ,
                      %mo •
                %annotation{:encoding => "application/x-tex"} S_{\bullet,\bullet}
            is a bisimplicial object in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi S
                    %mrow
                      %mo •
                      %mo ,
                      %mo •
                  %mo ≅
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                  %msub
                    %mi S
                    %mrow
                      %mi n
                      %mo ,
                      %mo •
                  %mspace{:width => "thinmathspace"}
                  %mo ×
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Δ
                    %mi sSet
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} d S_{\bullet,\bullet} \cong \int^{[n]\in\Delta} S_{n,\bullet}\,\times \,(\Delta^n_{sSet})_{\bullet}
          %p
            where the right-hand side is a “realization” functor from bisimplicial objects to simplicial objects in any cocomplete category. On the other hand, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a bisimplicial
            = succeed "," do
              %em space
            %em levelwise
            realization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
