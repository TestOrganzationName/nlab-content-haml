                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Sing(X_\bullet)_\bullet
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Sing
