              %em
                %a.existingWikiWord{:href => "/nlab/show/universal+principal+simplicial+complex"} universal principal simplicial complex
          #SimplicialTopologicalUniversalBundle.num_prop
            %h6#proposition_10 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+group"} simplicial topological group
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is a globally Kan simplicial topological space;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi W
                          %mo ¯
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \overline{W} G
                  is a globally Kan simplicial topological space;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mi G
                        %mo →
                        %mover
                          %mi W
                          %mo ¯
                        %mi G
                      %annotation{:encoding => "application/x-tex"} W G \to \overline{W} G
                  is a global Kan fibration.
          .proof
            %h6#proof_6 Proof
            %p
              The first statement appears as (
              %a{:href => "#BrownSzczarba"}> Brown &amp; Szczarba, theorem 3.8
              ), the second is noted in (
              %a{:href => "#RobertsStevenson"}> Roberts &amp; Stevenson
              ), the third appears as (
              %a{:href => "#BrownSzczarba"}> Brown &amp; Szczarba, lemma 6.7
              ).
          #BarWGIsGoodIfGIsWellSectioned.num_prop
            %h6#proposition_11 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a
              %a.existingWikiWord{:href => "/nlab/show/well-pointed+simplicial+topological+group"} well-pointed simplicial topological group
              then both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W} G
              are
              = succeed "." do
                %a{:href => "#GoodAndProper"} good simplicial topological spaces
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo{:stretchy => "false"} ¯
                  %mi G
                %annotation{:encoding => "application/x-tex"} \bar W G
            this is (
            %a{:href => "#RobertsStevenson"}> RobertsStevenson, prop. 19
            ). For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mi G
                %annotation{:encoding => "application/x-tex"} W G
            this follows with (
            %a{:href => "#RobertsStevenson"}> RobertsStevenson, lemma 10, lemma 11
            ) which says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mi G
                  %mo =
                  %msub
                    %mi Dec
                    %mn 0
                  %mover
                    %mi W
                    %mo{:stretchy => "false"} ¯
                  %mi G
                %annotation{:encoding => "application/x-tex"} W G = Dec_0 \bar W G
            and the observations in the proof of (
            %a{:href => "#RobertsStevenson"}> RobertsStevenson, prop. 16
            ) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Dec
                    %mn 0
                  %mi X
                %annotation{:encoding => "application/x-tex"} Dec_0 X
            is good if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is.
          #RealizationSimplicialTopologicalUniversalBundle.num_prop
            %h6#proposition_12 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/well-pointed+simplicial+topological+group"} well-pointed simplicial topological group
              %a.existingWikiWord{:href => "/nlab/show/universal+simplicial+principal+bundle"} universal simplicial principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G \to \bar W G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi W
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ¯
                      %mi G
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    {\vert W G \vert} \to {\vert \bar W G \vert}
            %p
              is a fibration
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              of the point inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi B
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} * \to B{|G|}
              into the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              of the geometric realization of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            This is (
            %a{:href => "#RobertsStevenson"}> RobertsStevenson, prop. 14
            ).
          #SimplicialTopolgicalBundleIsGood.num_prop
            %h6#proposition_13 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              be a
              %a{:href => "#GoodAndProper"} good
              %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/well-pointed+simplicial+topological+group"} well-pointed simplicial topological group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\tau \colon  X \to \bar W G
            %p
              the corresponding topological
              %a.existingWikiWord{:href => "/nlab/show/simplicial+principal+bundle"} simplicial principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is itself a good simplicial topological space.
          .proof
            %h6#proof_7 Proof
            %p
              The bundle is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %mover
                          %mi W
                          %mo ¯
                        %mi G
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P = X \times_{\overline{W} G} W G
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sTop
                  %annotation{:encoding => "application/x-tex"} sTop
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi τ
                          %mtd
                            %mover
                              %mi W
                              %mo ¯
                            %mi G
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P
                    \&amp;\longrightarrow&amp;
                    W G
                    \\\
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\\
                    X
                    \&amp;\stackrel{\tau}{\longrightarrow}&amp;
                    \\overline{W} G
                    \\mathrlap{\,.}
                    }
            %p
              By assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and using prop.
              %a.maruku-ref{:href => "#BarWGIsGoodIfGIsWellSectioned"}
              we have that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              are all good simplicial spaces.
            %p
              This means that the degeneracy maps of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mo •
                  %annotation{:encoding => "application/x-tex"} P_\bullet
              are induced degreewise by morphisms between pullbacks in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              that are degreewise
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+cofibrations"} closed cofibrations
              %a.existingWikiWord{:href => "/nlab/show/closed+cofibration"} closed cofibration
              (
              %a{:href => "Hurewicz+cofibration#InteractionWithPullbacks"}> here
              ), this implies that also these degeneracy maps of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mo •
                  %annotation{:encoding => "application/x-tex"} P_\bullet
              are closed cofibrations.
          %p
            Let for the following
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi s
                  %mo ↪
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top_s \hookrightarrow Top
            be any
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
          #SimpTopAsSimpPresheaves.num_defn
            %h6#definition_6 Definition
            %p
              Under the degreewise
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sTop
                      %mi s
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Top
                      %mi s
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} sTop_s \hookrightarrow [Top_s^{op}, sSet]
              simplicial topological spaces embed into the category of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi s
                    %annotation{:encoding => "application/x-tex"} Top_s
            %p
              We equip this with the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi Top
                        %mi s
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [Top_s^{op}, sSet]_{proj}
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sTop
                  %annotation{:encoding => "application/x-tex"} sTop
              under this embedding.
          #GlobalKanFibImpliesProjectiveFib.num_prop
            %h6#proposition_14 Proposition
            %p
              Under this embedding a
              %a{:href => "#GloballyKanSimplicialTopologicalSpace"} global Kan fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon  X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sTop
                      %mi s
                  %annotation{:encoding => "application/x-tex"} sTop_s
              maps to a fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi Top
                        %mi s
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [Top_s^{op}, sSet]_{proj}
          .proof
            %h6#proof_8 Proof
            %p
              By definition, a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon  X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Top
                      %mi s
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [Top_s^{op}, sSet]_{proj}
              is a fibration if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} U \in Top
              and all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq i \leq n
              diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi i
                            %mo ⋅
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda[n]_i \cdot U &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \\Delta[n] \cdot U &amp;\to&amp; Y
                    }
            %p
              have a lift. This is equivalent to saying that the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi U
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi i
                        %mo ⋅
                        %mi U
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi i
                    %mo ⋅
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\Delta[n]\cdot U, X)
                    \\to
                    Hom(\Delta[n]\cdot U,Y)
                    \\times_{Hom(\Lambda[n]_i \cdot U, Y)}
                    Hom(\Lambda[n]_i \cdot U, X)
            %p is surjective. Notice that we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msubsup
                                  %mi Top
                                  %mi s
                                  %mi op
                                %mo ,
                                %mi sSet
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mi U
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mi sTop
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mi U
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %msub
                              %mi Hom
                              %mi Top
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi k
                            %mo ×
                            %mi U
                            %mo ,
                            %msub
                              %mi X
                              %mi k
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %msub
                              %mi Hom
                              %mi Top
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi k
                            %mo ,
                            %msub
                              %mi X
                              %mi k
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mi Top
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %msub
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi k
                            %mo ,
                            %msub
                              %mi X
                              %mi k
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mi Top
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %mi sTop
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mi Top
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %msub
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Hom_{[Top_s^{op}, sSet]}(\Delta[n]\cdot U, X)
                    \&amp; =
                    Hom_{sTop}(\Delta[n]\cdot U, X)
                    \\\
                    \&amp; = \int_{[k] \in \Delta} Hom_{Top}( \Delta[n]_k \times U, X_k)
                    \\\
                    \&amp; = \int_{[k] \in \Delta} Hom_{Top}(U, [\Delta[n]_k, X_k])
                    \\\
                    \&amp; = Hom_{Top}(U, \int_{[k] \in \Delta} [\Delta[n]_k, X_k])
                    \\\
                    \&amp; = Hom_{Top}(U, sTop(\Delta[n], X))
                    \\\
                    \&amp; = Hom_{Top}(U, X_n)
                    \\end{aligned}
            %p and analogously for the other factors in the above morphism. Therefore the lifting problem equivalently says that the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                    %msub
                      %mo ×
                      %mrow
                        %mi sTop
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi i
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi sTop
                    %mo{:stretchy => "false"} (
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi i
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Top}(U, \; X_n \to Y_n \times_{sTop(\Lambda[n]_i, Y)} sTop(\Lambda[n]_i,X) \;)
            %p
              is surjective. But by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon  X \to Y
              is a global Kan fibration of simplicial topological spaces, def.
              = succeed "," do
                %a.maruku-ref{:href => "#GloballyKanSimplicialTopologicalSpace"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi Y
                        %mi n
                      %msub
                        %mo ×
                        %mrow
                          %mi sTop
                          %mo{:stretchy => "false"} (
                          %mi Λ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Y
                      %mi sTop
                      %mo{:stretchy => "false"} (
                      %mi Λ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi i
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \sigma \colon  Y_n \times_{sTop(\Lambda[n]_i), Y} sTop(\Lambda[n]_i,X) \to X_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{Top}(U, \sigma)
              is a section of our function.
          #HocolimPreservesHomotopyFibers.num_prop
            %h6#proposition_15 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              operation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sTop
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Top
                      %mi s
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mover
                      %mo →
                      %mi hocolim
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    sTop \hookrightarrow [Top_s^{op}, sSet]_{proj} \stackrel{hocolim}{\to} Top_{Quillen}
            %p
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \tau \colon  X \to \bar W G
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              good and globally Kan and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              well-pointed.
          .proof
            %h6#proof_9 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#SimplicialTopologicalUniversalBundle"}
              and prop.
              %a.maruku-ref{:href => "#GlobalKanFibImpliesProjectiveFib"}
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G \to \bar W G
              is a fibration
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of the point inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} * \to \bar W G
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Top
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [Top^{op}, sSet]_{proj}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              this means that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \tau \colon  X \to \bar W G
              is computed as the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi τ
                          %mtd
                            %mover
                              %mi W
                              %mo{:stretchy => "false"} ¯
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P &amp;\to&amp; W G
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\stackrel{\tau}{\to}&amp; \bar W G
                    }
            %p
              (since all objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              are fibrant and at least one of the two morphisms in the pullback diagram is a fibration) and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    hofib(\tau) \simeq P
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#SimplicialTopologicalUniversalBundle"}
              and prop.
              %a.maruku-ref{:href => "#SimplicialTopolgicalBundleIsGood"}
              it follows that all objects here are good simplicial topological spaces. Therefore by prop.
              %a.maruku-ref{:href => "#RealizationOfGoodSimplicialSpacesIsHomotopyColimit"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hocolim
                    %msub
                      %mi P
                      %mo •
                    %mo ≃
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi P
                        %mo •
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    hocolim P_\bullet \simeq {|P_\bullet|}
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
              %a.maruku-ref{:href => "#RealizationPreservesPullbacks"}
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} |
                    %msub
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                        %mi G
                        %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi W
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots = {|X_\bullet|} \times_{|\bar W G|} {|W G|}
                    \\,.
            %p
              But prop.
              %a.maruku-ref{:href => "#RealizationSimplicialTopologicalUniversalBundle"}
              says that this is again the presentation of a homotopy pullback/homotopy fiber by an ordinary pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi P
                              %mo{:stretchy => "false"} |
                          %mtd
                            %mo →
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi W
                              %mi G
                              %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi X
                              %mo{:stretchy => "false"} |
                          %mtd
                            %mover
                              %mo →
                              %mi τ
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mover
                                %mi W
                                %mo{:stretchy => "false"} ¯
                              %mi G
                              %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    {|P|} &amp;\to&amp; {|W G|}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    {|X|} &amp;\stackrel{\tau}{\to}&amp; {|\bar W G|}
                    }
                    \\,,
            %p
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi W
                    %mi G
                    %mo{:stretchy => "false"} |
                    %mo →
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |W G| \to |\bar W G|
              is again a fibration resolution of the point inclusion. Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hocolim
                    %msub
                      %mi P
                      %mo •
                    %mo ≃
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi τ
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    hocolim P_\bullet \simeq hofib( {|\tau|} )
                    \\,.
            %p
              Finally by prop.
              %a.maruku-ref{:href => "#RealizationOfGoodSimplicialSpacesIsHomotopyColimit"}
              and using the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              are both good, this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi hocolim
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq hofib (hocolim \tau)
                    \\,.
            %p In total we have shown
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hocolim
                    %mo{:stretchy => "false"} (
                    %mi hofib
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi hocolim
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    hocolim (hofib \tau) \simeq hofib (hocolim \tau)
                    \\,.
          %h3#ClassifyingSpaces Classifying spaces
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            for its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mor
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi G
                  %annotation{:encoding => "application/x-tex"} Mor_{\mathbf{B}G}(*,*) \coloneqq  G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} N \mathbf{B}G
            of this topological groupoid is naturally a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ↦
                  %msup
                    %mi G
                    %mrow
                      %msub
                        %mo ×
                        %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N \mathbf{B}G \colon  [n] \mapsto G^{\times_n}
                  \\,.
          #ClassifyingSpaceByGeometricRealization.num_prop
            %h6#proposition_16 Proposition
            %p
              The geometric realization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} N \mathbf{B}G
              is a model for the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi N
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} |
                    %mo ≃
                    %mi B
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {|N \mathbf{B}G|} \simeq B G
                    \\,.
          %p
            An early reference for this classical fact is (
            %a{:href => "#Segal68"}> Segal68
            ).
          #OmegaBGisaWHE.num_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/well-pointed+simplicial+topological+group"} well-pointed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              its
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Omega B G
              the
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
              of the classifying space.
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi B
                    %mi G
                    %mover
                      %mo →
                      %mo ≃
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega B G \stackrel{\simeq}{\to} G
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#ClassifyingSpaceByGeometricRealization"}
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} B G \simeq |\mathbf{B}G|
              (we suppress the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              operation notationally, which injects
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              = succeed "s)." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %p
              By standard facts about the
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar W
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+principal+bundle"} simplicial principal bundle
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              square of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi W
                              %mo{:stretchy => "false"} ¯
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp;\to&amp; W G
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    * &amp;\to&amp; \bar W G
                    }
            %p
              exhibiting the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                    \\\
                    * &amp;\to&amp; \mathbf{B}G
                    }
                    \\,.
            %p Under geoemtric realization this maps to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                    \\\
                    * &amp;\to&amp; B G
                    }
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.maruku-ref{:href => "#HocolimPreservesHomotopyFibers"}
              this is still a homotopy pullback, and hence exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              as the
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} B G
          %h3#CechNerves Cech nerves
          #RealizationOfCechNerveIsWHE.num_prop
            %h6#proposition_17 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X,Y
              be
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi \colon  Y \to X
              a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              that admits local
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi sTop
                  %annotation{:encoding => "application/x-tex"} C(\pi) \in sTop
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            %p Then the canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi π
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    {|C(\pi)|} \to X
            %p
              from the geometric realization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              back to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              then it is even a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %p
            For paracompact
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            this goes back to (
            %a{:href => "#Segal68"}> Segal68
            ). The general case is discussed in (
            %a{:href => "#DuggerIsaksen"}> DuggerIsaksen
            ). A generalization to parameterized spaces is in (
            %a{:href => "#RobertsStevenson"}> RobertsStevenson, lemma 22
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"}> simplicial topological space
                ,
                %a.existingWikiWord{:href => "/nlab/show/nice+simplicial+topological+space"} nice simplicial topological space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+group"} simplicial topological group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+categories"}> of categories
                  ,
                  = succeed "," do
                    %strong of simplicial topological spaces
                  %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+cohesive+%E2%88%9E-groupoids"} of cohesive ∞-groupoids
          %h2#references References
          %h3#General General
          %p
            The realization construction of simplicial topological spaces is implicit in classical discussion of
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
          %ul
            %li#Milgram67
              %a.existingWikiWord{:href => "/nlab/show/R.+James+Milgram"}> R. James Milgram
              ,
              = succeed "," do
                %em The bar construction and abelian H-spaces
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/journals/illinois-journal-of-mathematics/volume-11/issue-2/The-bar-construction-and-abelian-H-spaces/10.1215/ijm/1256054662.full"} doi:10.1215/ijm/1256054662
          %p
            which may be understood as the realization of the
            %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            of their
            %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological
            %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⇉
                    %mo *
                  %annotation{:encoding => "application/x-tex"} G \rightrightarrows \ast
          %p
            More explicit allusion to realization at least of
            %a.existingWikiWord{:href => "/nlab/show/semi-simplicial+objects"} semi-simplicial
            %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+categories"} topological categories
            appeared, without details, in:
          %ul
            %li#Segal68
              %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
              , Section 2 of:
              = succeed "," do
                %em Classifying spaces and spectral sequences
              = succeed ")" do
                %a{:href => "http://www.numdam.org/item?id=PMIHES_1968__34__105_0"} numdam:PMIHES_1968__34__105_0
          %p
            The detailed
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            formula for and the relevance of
            %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            for
            %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preservation
            at least of
            %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            is due (with reference to
            = succeed ")" do
              %a{:href => "#Milgram67"} Milgram 1967
          %ul
            %li#MacLane
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              , Section 6 of:
              = succeed "," do
                %em The Milgram bar construction as a tensor product of functors
              %em The Steenrod Algebra and Its Applications: A Conference to Celebrate N.E. Steenrod’s Sixtieth Birthday
              Lecture Notes in Mathematics
              = succeed "," do
                %em 168
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/BFb0058523"} doi:10.1007/BFb0058523
              = succeed ")" do
                %a{:href => "https://link.springer.com/content/pdf/10.1007/BFb0058523.pdf"} pdf
          %p Further details, including proof of the preservation not just of binary products but also of pullbacks appears in:
          %ul
            %li#May72
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              , Section 11 of:
              = succeed "," do
                %em The geometry of iterated loop spaces
              = succeed "," do
                %a{:href => "https://www.math.uchicago.edu/~may/BOOKS/geom_iter.pdf"} pdf
              = succeed ")" do
                %a{:href => "https://link.springer.com/book/10.1007/BFb0067491"} doi:10.1007/BFb0067491
          %p
            The notion of
            %em good
            simplicial spaces is due to
          %ul
            %li#Segal73
              %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
              , Appendix 2 of:
              = succeed "," do
                %em Configuration-spaces and iterated loop-spaces
              %strong 21
              (1973), 213–221. (
              %a{:href => "https://doi.org/10.1007/BF01390197"}> doi:10.1007/BF01390197
              ,
              = succeed "," do
                %a{:href => "http://dodo.pdmi.ras.ru/~topology/books/segal.pdf"} pdf
          %p
            and the notion of
            %em fat
            geometric realization together with its homotopy equivalence to ordinary realization for good simplicial spaces is due to:
          %ul
            %li#Segal74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                , Appendix A of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/files/SegalCategoriesAndCohomologyTheories.pdf", :title => "Categories and cohomology theories"} Categories and cohomology theories
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0040-9383(74)90022-6"} doi:10.1016/0040-9383(74)90022-6
            %li#tomDieck74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                ,
                = succeed "," do
                  %em On the homotopy type of classifying spaces
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF01189090"} doi:10.1007/BF01189090
          %p
            Discussion of fat geometric realization as representing the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            (as a
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coend"} homotopy coend
          %ul
            %li#ArkhipovOrsted18
              %a.existingWikiWord{:href => "/nlab/show/Sergey+Arkhipov"}> Sergey Arkhipov
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sebastian+%C3%98rsted"} Sebastian Ørsted
              %em Homotopy (co)limits via homotopy (co)ends in general combinatorial model categories
              (
              %a{:href => "https://arxiv.org/abs/1807.03266"}> arXiv:1807.03266
              )
          %p More discussion of the comparison of different realization functors is in:
          %ul
            %li#Wang17
              %p
                Yi-Sheng Wang,
                %em Fat realization and Segal’s classifying space
                (
                %a{:href => "https://arxiv.org/abs/1710.03796"}> arXiv:1710.03796
                )
            %li#Wang18
              %p
                Yi-Sheng Wang,
                %em Geometric realization and its variants
                (
                %a{:href => "https://arxiv.org/abs/1804.00345"}> arXiv:1804.00345
                )
          %p
            A proof that good simplicial spaces are proper is implicit in the proof of
            = succeed "." do
              %a{:href => "#Segal74"} Segal 1974, Lemma A.5
          %ul
            %li#GaunceLewis82
              %a.existingWikiWord{:href => "/nlab/show/L.+Gaunce+Lewis%2C+Jr."}> L. Gaunce Lewis, Jr.
              ,
              %em
                When is the natural map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Ω
                      %mi Σ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X\to \Omega \Sigma X
                a cofibration?
              , Trans. Amer. Math. Soc.
              %strong 273
              (1982) no. 1, 147–155 (
              %a{:href => "https://www.jstor.org/stable/1999197"}> jstor:1999197
              )
          %p
            A generalization of the statement that good implies proper to other
            %a.existingWikiWord{:href => "/nlab/show/topological+concrete+categories"} topological concrete categories
            and a discussion of the geometric realization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mi G
                  %mo →
                  %mover
                    %mi W
                    %mo{:stretchy => "false"} ¯
                  %mi G
                %annotation{:encoding => "application/x-tex"} W G \to \bar W G
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+group"} simplicial topological group
            is in
          %ul
            %li#RobertsStevenson
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
                = succeed "," do
                  %em Simplicial principal bundles in parametrized spaces
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1203.2460"} arXiv:1203.2460
                = succeed ")" do
                  %a{:href => "http://nyjm.albany.edu/j/2016/22-19.html"} nyjm:22-19
            %li#Stevenson
              %p
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"}> Danny Stevenson
                ,
                %em Classifying theory for simplicial parametrized groups
                (
                %a{:href => "http://arxiv.org/abs/1203.2461"}> arXiv:1203.2461
                )
          %p
            Comments on the relation between properness and cofibrancy in the
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Delta^{op}, Set]
            are made in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kristen+Schemmerhorn"} Kristen Schemmerhorn
              %em Model Categories and Simplicial Methods
              (
              %a{:href => "http://www.math.northwestern.edu/~pgoerss/papers/ucnotes.pdf"}> pdf
              ).
          %p
            The relation between (fat) geometric realization and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
          %ul
            %li#Dugger
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
              ,
              %em A primer on homotopy colimits
              (
              %a{:href => "http://pages.uoregon.edu/ddugger/hocolim.pdf"}> pdf
              )
          %p The proof that geometric realization of proper simplicial spaces preserves weak equivalences is from
          %ul
            %li#May_Einf
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              ,
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} E_\infty
                  \-spaces, group completions, and permutative categories
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/CBO9780511662607.008"} doi:10.1017/CBO9780511662607.008
              = succeed ")" do
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/13.pdf"} pdf
          %p A definition of the Bousfield-Kan map, and the Reedy model category theory necessary to show that it is a weak equivalence, can be found in
          %ul
            %li
              Hirschhorn,
              = succeed "," do
                %em Model categories and their localizations
          %p
            On the (fat) geometric realization of (
            %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            of)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+groupoids"} topological groupoids
          %ul
            %li#GepnerHenriques07
              %a.existingWikiWord{:href => "/nlab/show/David+Gepner"}> David Gepner
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Henriques"} André Henriques
              %em Homotopy theory of orbispaces
              (
              %a{:href => "https://arxiv.org/abs/math/0701916"}> arXiv:math/0701916
              )
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Carchedi"}> David Carchedi
              , section 3.2 of
              %em On The Homotopy Type of Higher Orbifolds and Haefliger Classifying Spaces
              (
              %a{:href => "http://arxiv.org/abs/1504.02394"}> arXiv:1504.02394
              )
          %p On globally Kan simplicial spaces:
          %ul
            %li#BrownSzczarba
              %a.existingWikiWord{:href => "/nlab/show/Edgar+H.+Brown"}> Edgar H. Brown
              , R. H. Szczarba,
              %em Continuous cohomology and real homotopy type
              , Trans. Amer. Math. Soc. 311 (1989), no. 1, 57 (
              %a{:href => "http://www.ams.org/journals/tran/1989-311-01/S0002-9947-1989-0929667-6/S0002-9947-1989-0929667-6.pdf"}> pdf
              )
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to geometric realization of simplicial topological spaces
          %ul
            %li#Seymour
              R. M. Seymour,
              %em Kan fibrations in the category of simplicial spaces
              Fund. Math., 106(2):141-152, 1980.
          %p
            On geometric relatization of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/semi-simplicial+topological+spaces"} semi-simplicial topological spaces
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Johannes+Ebert"}> Johannes Ebert
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Oscar+Randal-Williams"} Oscar Randal-Williams
              = succeed "," do
                %em Semi-simplicial spaces
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1705.03774"} arXiv:1705.03774
          %p
            On geometric realization of general
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerves"} Cech nerves
          %ul
            %li#DuggerIsaksen
              %a.existingWikiWord{:href => "/nlab/show/Dan+Dugger"}> Dan Dugger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dan+Isaksen"} Dan Isaksen
              %em
                Topological hypercovers and
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          %p
            On geometric realization of simplicial spaces as a
            %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
            on the
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+category"} Reedy model category
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Lars+Hesselholt"}> Lars Hesselholt
              ,
              = succeed "," do
                %em Reedy model structure on the category of simplicial spaces; geometric realization is a left Quillen functor
              = succeed "," do
                %a{:href => "https://www.math.nagoya-u.ac.jp/~larsh/teaching/S2008/"} Algebraic Topology I
              = succeed "," do
                %a{:href => "https://www.math.nagoya-u.ac.jp/~larsh/teaching/S2008/lecture11.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Hesselholt_RealSimpSpOnReedy.pdf", :title => "pdf"} pdf
          %h3#ReferencesCompatibilityHomotopyPullback (Non-)Compatibility with homotopy pullbacks
          %p
            Discussion of sufficient conditions (cf.
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%CF%80-Kan+condition"} π-Kan condition
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
          %ul
            %li#BousfieldFriedlander78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eric+Friedlander"} Eric Friedlander
                = succeed "," do
                  %em
                    Homotopy theory of
                    = succeed "-spaces," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Γ
                          %annotation{:encoding => "application/x-tex"} \Gamma
                = succeed "," do
                  %a{:href => "https://web.math.rochester.edu/people/faculty/doug/otherpapers/bousfield-friedlander.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/BousfieldFriedlanderSpectra.pdf", :title => "pdf"} pdf
            %li#Anderson78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Donald+Werner+Anderson"}> Donald Werner Anderson
                ,
                = succeed "," do
                  %em Fibrations and geometric realization
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.bams/1183541139"} euclid:1183541139
            %li#Lurie11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em Simplicial spaces
                = succeed "," do
                  %em
                    %a{:href => "https://www.math.ias.edu/~lurie/287x.html"} Algebraic L-theory and Surgery
                = succeed ")" do
                  %a{:href => "https://www.math.ias.edu/~lurie/287xnotes/Lecture7.pdf"} pdf
            %li#Rezk14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                ,
                = succeed "," do
                  %em When are homotopy colimits compatible with homotopy base change?
                = succeed "," do
                  %a{:href => "https://faculty.math.illinois.edu/~rezk/i-hate-the-pi-star-kan-condition.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/RezkHomotopyColimitsBaseChange.pdf", :title => "pdf"} pdf
            %li
              %p
                Edoardo Lanari,
                %em Compatibility of homotopy colimits and homotopy pullbacks of simplicial presheaves
                (
                %a{:href => "http://algant.eu/documents/theses/lanari.pdf"}> pdf
                ,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/LanariHomotopyColimitsBaseChange.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (expanded version of
                  = succeed ")" do
                    %a{:href => "#Rezk14"} Rezk 14
            %li#MazelGee14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aaron+Mazel-Gee"}> Aaron Mazel-Gee
                ,
                %em
                  Model
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                (
                %a{:href => "https://arxiv.org/abs/1412.8411"}> arXiv:1412.8411
                )
            %li#LurieHigherAlgebra
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , around Lem. 5.5.6.17 in:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
                (~2017)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , Thms. A.5.4.1,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Spectral+Algebraic+Geometry"} Spectral Algebraic Geometry
                (2018) &amp;lbrack;
                %a{:href => "https://math.harvard.edu/~lurie/papers/SAG-rootfile.pdf"}> pdf
                \&amp;rbrack;
            %li#BEBP19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Berwick-Evans"}> Daniel Berwick-Evans
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pedro+Boavida"} Pedro Boavida
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Pavlov"} Dmitri Pavlov
                = succeed "," do
                  %em Classifying spaces of infinity-sheaves
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/1912.10544"} arXiv:1912.10544
          %h3#realization_of_topological_stacks Realization of topological stacks
          %p
            On geometric realizations of
            = succeed ":" do
