                        %mo •
                        %mo ,
                        %mo •
                    %mo ≅
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %msub
                      %mi S
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mi sSet
                      %mi n
                  %annotation{:encoding => "application/x-tex"} d S_{\bullet,\bullet} \cong \int^{[n]\in \Delta} S_{n,\bullet} \times \Delta^n_{sSet}
            %p If we then take the realization of these simplicial spaces, we find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
