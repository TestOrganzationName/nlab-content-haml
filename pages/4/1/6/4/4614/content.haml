                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Δ
                      %msub
                        %mi S
                        %mrow
                          %mi n
                          %mo ,
                          %mo •
                      %mo ×
                      %msubsup
                        %mi Δ
                        %mi sSet
                        %mi n
                      %mo |
                    %mo ≅
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
