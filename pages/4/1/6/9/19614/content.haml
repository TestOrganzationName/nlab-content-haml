            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aleksandar+Mikovi%C4%87"}> Aleksandar Miković
                ,
                %em Piecewise Flat Metrics and Quantum Gravity
                (
                %a{:href => "https://arxiv.org/abs/2001.11439"}> arXiv:2001.11439
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aleksandar+Mikovi%C4%87"}> Aleksandar Miković
