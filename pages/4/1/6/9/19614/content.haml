                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2412.17465"}> arXiv:2412.17465
                \&amp;rbrack;
          %p See also
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Regge_calculus"} Regge calculus
          %p
            Application to
            %a.existingWikiWord{:href => "/nlab/show/FRW+models"} FRW models
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cosmology"} cosmology
