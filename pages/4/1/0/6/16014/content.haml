                  %msub
                    %mi p
                    %mi B
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{C}_\bullet \;\coloneqq\; (p_B)^\ast \mathbb{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi ℂ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi LinType
                %annotation{:encoding => "application/x-tex"}
                  b \colon B
                  \\;\;\;\vdash\;\;\;
                  \\mathbb{C} \;\colon\; LinType
          %p
            (which is the
            %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
            in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi LinType
                      %mi B
                  %annotation{:encoding => "application/x-tex"} LinType_B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript ℋ
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo □
                    %mi B
                  %msub
                    %mi ℂ
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  \\mathscr{H} \;\coloneqq\; \Box_B \mathbb{C}_\bullet
          %p
            as the
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            which is spanned by a measurement basis
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi b
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \vert b \rangle
          %p From all this we find, first of all, that
          %ol
            %li
              %p
                the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
                %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
                exhibits the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/collapse+of+the+wavefunction"} collapse
                of
                %a.existingWikiWord{:href => "/nlab/show/quantum+states"} quantum states
                under a
                %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
                in the
                = succeed "-basis" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
            %li
              %p
                the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
                %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
                exhibits the condition quantum state preparation in this basis:
          %div{:style => "margin: -30px 0px 20px 10px"}
            %img{:src => "/nlab/files/QCwthLHT-QuantumNecessity-221021.jpg", :width => "900px"}/
          %p
          .num_remark
            %h6 Remark
            %p
              The
              = succeed "-principle" do
                %a.existingWikiWord{:href => "/nlab/show/collapse+of+the+wavefunction"} collapse
              %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
              accurately expressed by the above linear
              %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
              = succeed "actuality" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo →
                    %annotation{:encoding => "application/x-tex"} \to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \to
              %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
              map was maybe first highlighted and made explicit in
              = succeed "," do
                %a{:href => "wave+function+collapse#vonNeumann32"} von Neumann (1932), §III.3
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript ℋ
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}_\bullet \,=\, (p_B)^\ast \mathbb{C}
              (cf.
              = succeed ")." do
                %a{:href => "wave+function+collapse#Lüders51"} Lüders (1951)
          %p
          .num_remark
            %h6 Remark
            %p
              We see that the base type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              %a.maruku-eqref{:href => "#eq:FiniteBaseType"} (5)
              %em
                of
                %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
                outcomes
              plays the role of
              %em both
            %ol
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/possible+worlds+semantics"} possible worlds
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/modal+logic"} classical modal logicians
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/many-worlds+interpretation+of+quantum+mechanics"} many worlds
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/interpretation+of+quantum+mechanics"} quantum interpretationists
            %p
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modal+logic"}> modal logic
                ,
                %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/epistemic+modal+logic"} epistemic modal logic
          %h2#references References
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
            of necessity and possibility goes back to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Aristotle"} Aristotle
          %ul
            %li#LemmonScott77
              %a.existingWikiWord{:href => "/nlab/show/E.+John+Lemmon"} E. John Lemmon
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dana+Scott"} Dana Scott
              = succeed "," do
                %em An Introduction to Modal Logic – The “Lemmon Notes”
              = succeed "&rbrack;" do
                %a{:href => "https://archive.org/details/introductiontomo0000lemm/"} ark:/13960/t3gz25k3h
          %p In
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kant"}> Kant
              ,
              %em Critique of pure reason
              1781
          %p
            is discussion of
            %em modality
            as one of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+%28philosophy%29"} categories of pure thought
            = succeed "," do
              %em necessity
            %em possibility
            and
            %em actuality
            (Wirklichkeit).
          %p In
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Georg+Hegel"}> Georg Hegel
              ,
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/Science+of+Logic#DieWirklichkeit"} book 2, section 3
              %a{:href => "http://ncatlab.org/nlab/show/Science+of+Logic#DieWirklichkeitKapitel2"} book 2, section 3, chapter 2
              in
              %em
                %a.existingWikiWord{:href => "/nlab/show/Science+of+Logic"} Science of Logic
              (1812)
          %p
            this is picked up and claimed to be refined to a
            %a.existingWikiWord{:href => "/nlab/show/dialectic"} dialectic
            system of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unity+of+opposites"} unities of opposites
          %p
            Early discussion in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/alethic+modal+logic"} alethic modal logic
          %ul
            %li#Wright51
              %a.existingWikiWord{:href => "/nlab/show/Georg+H.+von+Wright"}> Georg H. von Wright
              ,
              = succeed "," do
                %em An Essay in Modal Logic
          %p See also:
          %ul
            %li#Kripke80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+Kripke"}> Saul Kripke
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Naming+and+Necessity"} Naming and Necessity
                (1980)
            %li
              %p
                Stanford Encyclopedia of Philosophy,
                %em
                  %a{:href => "http://plato.stanford.edu/entries/logic-modal/#PosWorSem"} Modal Logic
          %p
            Making explicit the
            %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
            %a.existingWikiWord{:href => "/nlab/show/modal+operator"} modal operator
            as a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
          %ul
            %li#BiermanDePaiva96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gavin+M.+Bierman"}> Gavin M. Bierman
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Valeria+de+Paiva"} Valeria de Paiva
                = succeed "," do
                  %em Intuitionistic necessity revisited
                = succeed "," do
                  %a{:href => "https://www.researchgate.net/publication/2810611_Intuitionistic_Necessity_Revisited"} researchgate
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Bierman-dePaiva-NecessityRevisited.pdf", :title => "pdf"} pdf
            %li#BiermanDePaiva00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gavin+M.+Bierman"}> Gavin M. Bierman
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Valeria+de+Paiva"} Valeria de Paiva
                = succeed "," do
                  %em On an Intuitionistic Modal Logic
                %strong 65
                (2000) 383–416 &amp;lbrack;
                %a{:href => "https://doi.org/10.1023/A:1005291931660"}> doi:10.1023/A:1005291931660
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.researchgate.net/profile/Valeria-De-Paiva/publication/226515897_On_An_Intuitionistic_Modal_Logic/links/00b4951ed416906ccc000000/On-An-Intuitionistic-Modal-Logic.pdf"} pdf
            %li#Kobayashi97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Satoshi+Kobayashi"}> Satoshi Kobayashi
                ,
                = succeed "," do
                  %em Monad as modality
                %strong 175
                1 (1997) 29-74 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/S0304-3975(96)00169-7"}> doi:10.1016/S0304-3975(96)00169-7
                \&amp;rbrack;
            %li
              %p
                Natasha Alechina, Michael Mendler,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Valeria+de+Paiva"} Valeria de Paiva
                = succeed "," do
                  %em Categorical and Kripke Semantics for Constructive S4 Modal Logic
                %em Computer Science Logic. CSL 2001
                Lecture Notes in Computer Science
                = succeed "," do
                  %strong 2142
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/3-540-44802-0_21"} doi:10.1007/3-540-44802-0_21
          %p
            The understanding of
            %a.existingWikiWord{:href => "/nlab/show/Kripke+semantics"} Kripke semantics
            for
            %a.existingWikiWord{:href => "/nlab/show/S5+modal+logic"} S5 modal logic
            as
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            is indicated in:
          %ul
            %li#Awodey06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steve+Awodey"}> Steve Awodey
                , p. 279 in:
                = succeed "," do
                  %em Category theory
                = succeed "," do
                  %a{:href => "https://doi.org/10.1093/acprof:oso/9780198568612.001.0001"} doi:10.1093/acprof:oso/9780198568612.001.0001
                = succeed "," do
                  %a{:href => "https://global.oup.com/ukhe/product/category-theory-9780199237180"} ISBN:9780199237180
                = succeed "&rbrack;" do
                  %a{:href => "http://englishonlineclub.com/pdf/Category%20Teory%20%5BEnglishOnlineClub.com%5D.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Corfield"}> David Corfield
                , Chap. 4 of:
                %em
                  %a{:href => "https://ncatlab.org/davidcorfield/show/Modal+Homotopy+Type+Theory"} Modal Homotopy Type Theory: The Prospect of a New Logic for Philosophy
                (2020)
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jake+Chandler"}> Jake Chandler
                ,
                = succeed "," do
                  %em Modality: Necessity and Possibility
                = succeed ")" do
                  %a{:href => "http://www.jakechandler.com/assets/2006MetaphysicsBBK/%5B6%5D%20%5BModality%5D.pdf"} pdf
            %li#Simpson
              %p
