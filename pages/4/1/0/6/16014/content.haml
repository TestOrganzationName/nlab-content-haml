            %a.existingWikiWord{:href => "/nlab/show/full+%28infinity%2C1%29-subcategory"} embed
            as their
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectra"} Eilenberg-MacLane
            %a.existingWikiWord{:href => "/nlab/show/module+spectra"} module spectra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
