                  \\array{ \bullet \\ \uparrow \\ \bullet \\ \uparrow \\ \bullet \\ \vdots }
                  \\quad\quad\quad\quad
                  \\array{
                  \&amp;          &amp;          &amp;          &amp; \bullet \\
                  \&amp;          &amp;          &amp; \nearrow &amp;         &amp; \nwarrow\\
