                  \&amp; \nearrow &amp;          &amp;          &amp;         &amp; \nearrow &amp;         &amp; \nwarrow\\
                  \\udots &amp;          &amp;          &amp;          &amp; \bullet &amp;          &amp;         &amp;          &amp; \bullet\\
                  \&amp;          &amp;          &amp; \nearrow &amp;         &amp;          &amp;         &amp; \nearrow &amp;         &amp; \nwarrow\\
                  \&amp;          &amp; \udots   &amp;          &amp;         &amp;          &amp; \udots  &amp;          &amp;         &amp;          &amp; \ddots
