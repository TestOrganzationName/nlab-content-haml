                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ν
                        %mrow
                          %msub
                            %mi b
                            %mn 2
                          %mo ≤
                          %mo •
                      %mo ∈
                      %msub
                        %mi U
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \nu_{b_2 \leq \bullet} \in U_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is directed, there would then be an upper bound
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≥
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} b \geq b_1, b_2
              of these two elements. This hence satisfies both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \nu_{f(e)} \in U_x
              as well as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi i
                        %mi x
                      %mo{:stretchy => "false"} }
                      %mo ⊂
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \{i_x\} \subset f(b_1) \subset f(b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \nu_{f(b)}
              is not in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                    %annotation{:encoding => "application/x-tex"} U_x
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          %h3#LogicOfNets Logic of nets
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/property"} property
            of
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            of a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (given by the
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} S \subset X
            of those elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            satisfying this property) may be applied to nets in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Being eventually in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %a.maruku-ref{:href => "#EventuallyAndFrequently"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (given by the
            %a.existingWikiWord{:href => "/nlab/show/universal+quantifier"} universal quantifier
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∀
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} \forall_\nu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a strengthening of being sometime in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (given by the
            %a.existingWikiWord{:href => "/nlab/show/particular+quantifier"} particular quantifier
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} \exists_\nu
            %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
            out of these. Use
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %mo ∀
                  %mi i
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ν
                    %mi i
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \ess\forall i, p[\nu_i]
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mi p
                %annotation{:encoding => "application/x-tex"} \ess\forall_\nu p
            to mean that a predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is eventually true, and use
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %mo ∃
                  %mi i
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ν
                    %mi i
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \ess\exists i, p[\nu_i]
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mi p
                %annotation{:encoding => "application/x-tex"} \ess\exists_\nu p
            to mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is frequently true. Then we have:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∀
                    %mi ν
                  %mi p
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mi p
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mi p
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ∃
                    %mi ν
                  %mi p
                %annotation{:encoding => "application/x-tex"} \forall_\nu p \;\Rightarrow\; \ess\forall_\nu p \;\Rightarrow\; \ess\exists_\nu p \;\Rightarrow\; \exists_\nu p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ∧
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mi p
                  %mo ∧
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mi q
                %annotation{:encoding => "application/x-tex"} \ess\forall_\nu (p \wedge q) \;\Leftrightarrow\; \ess\forall_\nu p \wedge \ess\forall_\nu q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ∧
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mi p
                  %mo ∧
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mi q
                %annotation{:encoding => "application/x-tex"} \ess\exists_\nu (p \wedge q) \;\Rightarrow\; \ess\exists_\nu p \wedge \ess\exists_\nu q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ∨
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇐
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mi p
                  %mo ∧
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mi q
                %annotation{:encoding => "application/x-tex"} \ess\forall_\nu (p \vee q) \;\Leftarrow\; \ess\forall_\nu p \wedge \ess\forall_\nu q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ∨
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mi p
                  %mo ∨
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mi q
                %annotation{:encoding => "application/x-tex"} \ess\exists_\nu (p \vee q) \;\Leftrightarrow\; \ess\exists_\nu p \vee \ess\exists_\nu q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∀
                    %mi ν
                  %mo ¬
                  %mi p
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mo ¬
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ess
                  %msub
                    %mo ∃
                    %mi ν
                  %mi p
                %annotation{:encoding => "application/x-tex"} \ess\forall_\nu \neg{p} \;\Leftrightarrow\; \neg\ess\exists_\nu p
          %p
            and other analogues of theorems from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/predicate+logic"} predicate logic
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            even though its analogue from ordinary predicate logic does not.
          %p
            A similar logic is satisfied by ‘
            %a.existingWikiWord{:href => "/nlab/show/almost+everywhere"}> almost everywhere
            ’ and its dual (‘not almost nowhere’ or ‘somewhere significant’) in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measure+spaces"} measure spaces
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sequential+net"} sequential net
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+net"} limit of a net
            %li
              %p
                %a{:href => "Tychonoff+theorem#ProofViaNets"} Tychonoff theorem – Proof via net convergence
          %h2#references References
          %p A textbook account is in
          %ul
            %li#Schechter96
              %a.existingWikiWord{:href => "/nlab/show/Eric+Schechter"}> Eric Schechter
              , sections 7.14–7.21 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Analysis+and+its+Foundations"} Handbook of Analysis and its Foundations
          %p Lecture notes include
          %ul
            %li#Vermeeren10
              %a.existingWikiWord{:href => "/nlab/show/Stijn+Vermeeren"}> Stijn Vermeeren
              ,
              = succeed "," do
                %em Sequences and nets in topology
              = succeed ")" do
                %a{:href => "http://stijnvermeeren.be/download/mathematics/nets.pdf"} pdf
