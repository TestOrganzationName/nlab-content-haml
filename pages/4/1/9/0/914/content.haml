          #IfEveryNetHasConvergentSubnetThenSpaceIsCompact.num_example
            %h6#lemma_2 Lemma
            %p
              Assuming
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/net"} net
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a
              %a.existingWikiWord{:href => "/nlab/show/subnet"} subnet
              that
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
          .proof
            %h6#proof_5 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              we may equivalently prove the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/contrapositive"} contrapositive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is not compact, then not every net in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a convergent subnet.
            %p
              Hence assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is not compact. We need to produce a net without a convergent subnet.
            %p
              Again by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              %a{:href => "finite+intersection+property#CompactnessInTermsOfFiniteIntersectionProperty"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              not being compact means equivalently that there exists a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
              of
              %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              satisfying the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∩
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi C
                        %mi i
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i = \emptyset
            %p
              Consider then
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mi fin
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P_{fin}(I)
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{C_i \subset X\}_{i \in I}
              satisfies the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} choose
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ∈
                    %msub
                      %mi P
                      %mi fin
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J \in P_{fin}(I)
              an element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi J
                    %mo ∈
                    %munder
                      %mo ∩
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                    %msub
                      %mi C
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x_J \in \underset{i \in J \subset I}{\cap} C_i
                    \\,.
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi fin
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P_{fin}(X)
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/preordered+set"} preordered set
              under inclusion of subsets is clearly a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/directed+set"} directed set
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/union"} union
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi P
                              %mi fin
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo ⊂
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ν
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mi J
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %msub
                              %mi x
                              %mi J
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P_{fin}(X)_{\subset} &amp;\overset{\nu}{\longrightarrow}&amp; X
                    \\\
                    J &amp;\overset{\phantom{AAA}}{\mapsto}&amp; x_J
                    }
                    \\,.
            %p We will show that this net has no converging subnet.
            %p Assume on the contrary that there were a subnet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi P
                              %mi fin
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mi ν
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; P_{fin}(X)
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow_{\nu}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              which converges to some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
            %p
              By the assumption that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∩
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi C
                        %mi i
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} C_i = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i_x \in I
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %msub
                        %mi C
                        %mrow
                          %msub
                            %mi i
                            %mi x
                    %annotation{:encoding => "application/x-tex"} x \neq C_{i_x}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi i
                  %annotation{:encoding => "application/x-tex"} C_i
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                      %mo ∩
                      %msub
                        %mi C
                        %mrow
                          %msub
                            %mi i
                            %mi x
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U_x \cap C_{i_x} = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi J
                    %mo ≠
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} x_J \neq U_x
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
