                        %mo ≃
                      %mi E
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi Th
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \phi_E \;\colon\; E(X) \overset{\simeq}{\to} E\big( Th(V)\big)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi H
                        %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Td
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ch
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{H\mathbb{Q}}
                    \\big(
                    Td(V)
                    \\big)
                    \\;=\;
                    ch\big( th(V) \big)
                    \\,.
            %p
              More generally , for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in K(X)
              any class, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi H
                        %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ch
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi Td
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ch
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi ϕ
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{H\mathbb{Q}}
                    \\big(
                    ch(x)
                    \\cup
                    Td(V)
                    \\big)
                    \\;=\;
                    ch\big( \phi_{K}(x) \big)
                    \\,,
            %p
              which specializes to the previous statement for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} x = 1
          %p
            (
            %a{:href => "rational+Todd+class+is+Chern+character+of+Thom+class#Karoubi78"}> Karoubi 78, Chapter V, Theorem 4.4
            )
          %h3#relation_to_trivializations Relation to trivializations
          %p
            The relation (equivalence) between choices of
            %a.existingWikiWord{:href => "/nlab/show/Thom+classes"} Thom classes
            and trivializations of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-line+bundles"} (∞,1)-line bundles
            is discussed e.g. in
            %a{:href => "#AndoHopkinsRezk10"} Ando-Hopkins-Rezk 10, section 3.3
          %h3#RelationToGenera Relation to genera
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+orthogonal+group"} stable orthogonal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                  %mo →
                  %mi B
                  %mi O
                %annotation{:encoding => "application/x-tex"} B G \to B O
            for the corresponding map of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mi O
                  %mo ⟶
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J \colon B O \longrightarrow B GL_1(\mathbb{S})
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-homomorphism
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B GL_1(\mathbb{S}) \to B GL_1(E)
            between the
            %a.existingWikiWord{:href => "/nlab/show/deloopings"} deloopings
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups+of+units"} ∞-groups of units
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                  %mo →
                  %mi B
                  %mi O
                  %mover
                    %mo →
                    %mi J
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  B G \to B O \stackrel{J}{\to} B GL_1(\mathbb{S}) \to B GL_1(E)
          %p
            is a universal
            = succeed "-orientation" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} E Mod
            this induces a homomorphism of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-modules"} ∞-modules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi M
                  %mi G
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  \\sigma \;\colon\; M G \to E
          %p
            from the universal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            If here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \to GL_1(\mathbb{S})
            is the
            = succeed "-component" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            then this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            is a homomorphism of
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+rings"} E-∞ rings
            and in this case there is a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            between universal orientations and such
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            = succeed ")." do
              %a{:href => "#AndoHopkinsRezk10"} Ando-Hopkins-Rezk 10, prop. 2.11
          %p
            The latter, on passing to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %a.existingWikiWord{:href => "/nlab/show/genera"} genera
            on manifolds with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
          %h3#relation_to_cubical_structures Relation to cubical structures
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
            %a.existingWikiWord{:href => "/nlab/show/weakly+periodic+cohomology+theory"} weakly periodic
            %a.existingWikiWord{:href => "/nlab/show/complex+orientable+cohomology+theory"} complex orientable cohomology theory
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %msup
                    %mi E
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} ⟨
                  %mn 6
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec E^0(B U\langle 6\rangle)
            is naturally equivalent to the space of
            %a.existingWikiWord{:href => "/nlab/show/cubical+structure+on+a+line+bundle"} cubical structures
            on the trivial line bundle over the
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            In particular,
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of maps of
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
            spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MU
                  %mo{:stretchy => "false"} ⟨
                  %mn 6
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} MU\langle 6\rangle \to E
            from the
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MU
                    %mo{:stretchy => "false"} ⟨
                    %mn 6
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} MU\langle 6\rangle
            %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orientations
            (see there) of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            are in natural bijection with these cubical structures.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/cubical+structure"} cubical structure
            for more details and references. This way for instance the
            %a.existingWikiWord{:href => "/nlab/show/string+orientation+of+tmf"} string orientation of tmf
            has been constructed. See there for more.
