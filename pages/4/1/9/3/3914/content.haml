                                %mn 1
                              %mi ℬ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi Maps
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi S
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi ξ
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mo *
                          %mtd
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %msub
                              %mi E
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge Th(V^{\mathcal{B}}_n)
                    \&amp;\overset{S^1 \wedge \xi_n}{\longrightarrow}&amp;
                    S^1 \wedge E_n
                    \\\
                    {}^{\mathllap{\sigma^{M\mathcal{B}}_n}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\sigma^E_n}}
                    \\\
                    Th(V^{\mathcal{B}}_{n+1})
                    \&amp;\underset{\xi_{n+1}}{\longrightarrow}&amp;
                    E_{n+1}
                    }
                    \\;\;\;\;\;\;\;\;\;
                    \\leftrightarrow
                    \\;\;\;\;\;\;\;\;\;
                    \\array{
                    Th(V^{\mathcal{B}}_n)
                    \&amp;\overset{\xi_n}{\longrightarrow}&amp;
                    E_n
                    \\\
                    {}^{\mathllap{\tilde \sigma^{M\mathcal{B}}_n}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\tilde \sigma^E_n}}
                    \\\
                    Maps(S^1,Th(V^{\mathcal{B}}_{n+1}))
                    \&amp;\underset{Maps(S^1,\xi_{n+1})_\ast}{\longrightarrow}&amp;
                    Maps(S^1, E_{n+1})_{\ast}
                    }
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              First of all this means (via the identification given by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#AdditiveReducedCohomologyTheoryRepresentedByOmegaSpectrum"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ξ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \xi_n
              are equivalently representatives of elements in the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ξ
                      %mi n
                    %mo ∈
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\xi_n \in \tilde E^n(Th(V^{\mathcal{B}}_n))
            %p (which we denote by the same symbol, for brevity).
            %p
              Now by the definition of universal
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectra"} Thom spectra
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#UniversalThomSpectrum"}> def.
              ,
              = succeed ")," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#UniversalThomSpectrumForBfStructure"} def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mrow
                        %mi M
                        %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \sigma_n^{M\mathcal{B}}
              is just the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo ⊕
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_n \colon \mathbb{R}\oplus Th(V^{\mathcal{B}}_n)\to Th(V_{n+1}^{\mathcal{B}})
              from above.
            %p
              Moreover, by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mi n
                      %mi E
                    %mo ∘
                    %msub
                      %mi ξ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \tilde \sigma_n^E \circ \xi_n
              (on the right) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mi n
                      %mi E
                    %mo ∘
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi ξ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma^E_n \circ S^1 \wedge \xi_n
              (on the left) is what represents (again by
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#AdditiveReducedCohomologyTheoryRepresentedByOmegaSpectrum"} this prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ξ
                      %mi n
                    %mo ∈
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\xi_n \in E^n(Th(V^{\mathcal{B}}_n))
            %p
              under the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
              %a.existingWikiWord{:href => "/nlab/show/commutative+square"} commutativity
              of the above squares is equivalently the first compatibility condition from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#EOrientationOfABfStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ξ
                      %mi n
                    %mo ≃
                    %msubsup
                      %mi ϕ
                      %mi n
                      %mo *
                    %msub
                      %mi ξ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \xi_n \simeq \phi_n^\ast \xi_{n+1}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo ⊕
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde E^{n+1}(Th(\mathbb{R}\oplus V_n^{\mathcal{B}}))
            %p
              Next,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              being a homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/ring+spectra"} ring spectra
              means equivalently (we should be modelling
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} M\mathcal{B}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              as
              %a.existingWikiWord{:href => "/nlab/show/structured+spectra"} structured spectra
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1#DiagramSpectra"}> here.
              ) to be more precise on this point, but the conclusion is the same) that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2\in \mathbb{N}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi V
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                              %mi ℬ
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi V
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                              %mi ℬ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ξ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                  %mo ∧
                                  %msub
                                    %mi ξ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 2
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ξ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                      %mo +
                                      %msub
                                        %mi n
                                        %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msub
                              %mi E
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                          %mtd
                            %munder
                              %mo ⟶
                              %mo ⋅
                          %mtd
                            %msub
                              %mi E
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                                %mo +
                                %msub
                                  %mi n
                                  %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Th(V_{n_1}^{\mathcal{B}}) \wedge Th(V_{n_2}^{\mathcal{B}})
                    \&amp;\overset{}{\longrightarrow}&amp;
                    Th(V_{n_1 + n_2})
                    \\\
                    {}^{\mathllap{\xi_{n_1} \wedge \xi_{n_2}}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\xi_{n_1 + n_2}}}
                    \\\
                    E_{n_1} \wedge E_{n_2}
                    \&amp;\underset{\cdot}{\longrightarrow}&amp;
                    E_{n_1 + n_2}
                    }
                    \\,.
            %p
              This is equivalently the condition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ξ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ⋅
                      %msub
                        %mi ξ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ≃
                      %msub
                        %mi ξ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \xi_{n_1} \cdot \xi_{n_2} \simeq \xi_{n_1  + n_2}
            %p
              Finally, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} M\mathcal{B}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mi e
                    %mi M
                    %mi ℬ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}
                    \\overset{e}{\longrightarrow}
                    M\mathcal{B}
                    \\,.
            %p This is given by the component maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    e_n
                    \\;\colon\;
                    S^n
                    \\simeq
                    Th(\mathbb{R}^n)
                    \\longrightarrow
                    Th(V_{n}^{\mathcal{B}})
            %p
              that are induced by including the fiber of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi V
                        %mi n
                        %mi ℬ
                    %annotation{:encoding => "application/x-tex"} V_{n}^{\mathcal{B}}
            %p Accordingly the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mi e
                    %mi M
                    %mi ℬ
                    %mover
                      %mo ⟶
                      %mi ξ
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}
                    \\overset{e}{\longrightarrow}
                    M\mathcal{B}
                    \\overset{\xi}{\longrightarrow}
                    E
            %p
              has as components the restrictions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi ξ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} i^\ast \xi_n
              appearing in def.
              = succeed "." do
                %a.maruku-ref{:href => "#EOrientationOfAVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a ring spectrum, hence it also has an essentially unique multiplicative morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕊
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \mathbb{S} \to E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} i^\ast \xi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+ring+spectrum"} symmetric ring spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} e_0
              is the identity element in degree 0 (being a unit of an ordinary ring, by definition) and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi n
                  %annotation{:encoding => "application/x-tex"} e_n
              is necessarily its image under the suspension isomorphism, due to compatibility with the structure maps and using the above analysis.
          %h3#abstractly Abstractly
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be a
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} \mathbb{S}
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
          %p
            For the following see also May,Sigurdsson:
            %em
              %a.existingWikiWord{:href => "/nlab/show/Parametrized+Homotopy+Theory"} Parametrized Homotopy Theory
            (
            %a{:href => "http://mathoverflow.net/a/107837/381"}> MO comment
            )
          %h4#principal_bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(R)
            \-principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mo ×
                %annotation{:encoding => "application/x-tex"} R^\times
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(R)
            for the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            of the
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn ∞
                  %mi R
                %annotation{:encoding => "application/x-tex"} \Omega^\infty R
            on those points that map to multiplicatively invertible elements in the ordinary ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(R)
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(R)
            is itself an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinite+loop+space"} infinite loop space
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B GL_1(R)
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(R)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi Top
                %annotation{:encoding => "application/x-tex"} X \in Top
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ζ
                  %mo :
                  %mi X
                  %mo →
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \zeta : X \to B GL_1(R)
            a map, its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi GL
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi P
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi x
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi ζ
                        %mtd
                          %mi B
                          %msub
                            %mi GL
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  GL_1(R) &amp;\to&amp; P &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  * &amp;\stackrel{x}{\to}&amp; X
                  \&amp;\stackrel{\zeta}{\to}&amp;
                  B GL_1(R)
                  }
          %p
            is the
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(R)
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            classified by that map.
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} R = \mathbb{S}
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B GL_1(\mathbb{S})
              is the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              for spherical fibrations.
          .num_example
            %h6#example_2 Example
            %p There is a canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi O
                    %mo →
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B O \to B GL_1(\mathbb{S})
            %p
              from the classifying space of the
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              to that of the
              %a.existingWikiWord{:href => "/nlab/show/infinity-group+of+units"} infinity-group of units
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-homomorphism
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              to sphere bundles. This is what is modeled by the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo :
                    %mi V
                    %mo ↦
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"}
                    J : V \mapsto S^V
            %p
              which sends each fiber to its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
          %h4#associated_bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(R)
            \-associated
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(R)
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            there is canonically the corresponding
            %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
            with fiber
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab(Top)
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Spectra
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %msup
                          %mi Ω
                          %mn ∞
                    %mover
                      %mo ←
                      %mrow
                        %msup
                          %mi Σ
                          %mn ∞
                  %mi Top
                %annotation{:encoding => "application/x-tex"}
                  Stab(Top) \simeq Spectra
                  \\stackrel{\overset{\Sigma^\infty}{\leftarrow}}{\underset{\Omega^\infty}{\to}}
                  Top
          %p
            the associated bundle is the
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma^\infty GL_1(R)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi ζ
                  %mo :
                  %mo =
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi P
                  %msub
                    %mo ∧
                    %mrow
                      %msup
                        %mi Σ
                        %mn ∞
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                  %mi R
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X^\zeta := \Sigma^\infty P \wedge_{\Sigma^\infty GL_1(R)} R
                  \\,.
          %p
            This is the generalized
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi K
                  %mi O
                %annotation{:encoding => "application/x-tex"} R = K O
            the real
            %a.existingWikiWord{:href => "/nlab/show/K-theory+spectrum"} K-theory spectrum
            this is given by the ordinary
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            construction on a
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
          %p
            An
            = succeed "-orientation" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V \to X
            is a trivialization of the
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"} E \wedge S^V
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            with the
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi R
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} f : R \to S
              a morphism of
              = succeed "-rings," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                    %mo :
                    %mi X
                    %mo →
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \zeta : X \to B GL_1(R)
              the classifying map for an
              = succeed "-bundle," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi ζ
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi f
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \stackrel{\zeta}{ \to } B GL_1(R) \stackrel{f}{\to} B GL_1(S)
            %p
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mi f
                        %mo ∘
                        %mi ζ
                    %mo ≃
                    %msup
                      %mi X
                      %mi ζ
                    %msub
                      %mo ∧
                      %mi R
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X^{f \circ \zeta} \simeq X^\zeta \wedge_R S
                    \\,.
          %p
            This appears as (
            %a{:href => "#Hopkins"}> Hopkins, bottom of p. 6
            ).
          %h4#orientations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            \-Orientations
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mi ζ
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \stackrel{\zeta}{\to} B GL_1(\mathbb{S})
            a sphere bundle, an
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              \-orientation
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi ζ
                %annotation{:encoding => "application/x-tex"} X^\zeta
            is a trivialization of the associated
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi ζ
                    %mo ∧
                    %mi R
                  %annotation{:encoding => "application/x-tex"} X^\zeta \wedge R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mi ζ
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ι
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  X \stackrel{\zeta}{\to} B GL_1(\mathbb{S})
                  \\stackrel{\iota}{\to}
                  B GL_1(R)
                  \\,,
          %p
            where the second map comes from the unit of
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} \mathbb{S} \to R
            (the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            is the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            in
            = succeed "-rings)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            Specifically, for
