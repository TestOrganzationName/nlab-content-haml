          %h3#relation_to_the_todd_class Relation to the Todd class
          #RationalToddClassIsChernCharacterOfThomClass.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rational+Todd+class+is+Chern+character+of+Thom+class"}> rational Todd class is Chern character of Thom class
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
