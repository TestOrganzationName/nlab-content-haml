              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              in
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
              equals the
              %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ch
                  %annotation{:encoding => "application/x-tex"} ch
              of the
              %a.existingWikiWord{:href => "/nlab/show/Thom+class"} Thom class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi K
