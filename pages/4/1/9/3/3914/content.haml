                    %msub
                      %mi 𝒱
                      %mi X
                    %mo ;
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} th \;\in\; H^{2n}\big( \mathcal{V}_X; \mathbb{Z} \big)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒱
                      %mi X
