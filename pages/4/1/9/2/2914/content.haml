                    \\;\;\;\;\;\;
                    \\in
                    (sSet_{Qu})_{/B}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+weak+homotopy+equivalence"} simplicial weak homotopy equivalence
              (hence a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              in the slice model structure, from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SliceModelStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              %a.existingWikiWord{:href => "/nlab/show/base+changes"} base changes
              by
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi b
                  %annotation{:encoding => "application/x-tex"} X_b
