                              %mspace{:width => "thickmathspace"}
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
