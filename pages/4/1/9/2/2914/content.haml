          .proof
            %h6 Proof
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a weak equivalence. By Prop.
              %a.maruku-ref{:href => "#LeftBaseChangeQuillenEquivalence"}
              the pullback operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mo *
                  %annotation{:encoding => "application/x-tex"} b^\ast
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"} Ken Brown's lemma
              (
              %a{:href => "factorization+lemma#KenBrownLemma"}> here
              ) implies that it preserves weak equivalences between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} p'
              are fibrant by assumption, this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b^\ast(f)
              is a weak equivalence.
            %p
              In the other direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b^\ast(f)
              is a weak equivalence for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi B
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} b \,\in\, B_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x \,\in\, X_0
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} b \,\coloneqq\, p(x) \,\in\, B_0
              and consider the resulting
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
