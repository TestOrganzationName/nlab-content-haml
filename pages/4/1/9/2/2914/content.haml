            %p
              Now the (
              %a{:href => "five+lemma#InHomologicalCategories"}> non-abelian
              )
              %a.existingWikiWord{:href => "/nlab/show/five+lemma"} five lemma
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(f,x)
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}_+
              and all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
            %p
              It only remains to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(f)
              is an isomorphism. This follows by the same argument after replacing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              by the
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mover
                      %mo ↪
                      %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo =
                    %mi B
                    %mo ⊔
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ∖
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde B \xhookrightarrow{\;} B = B \sqcup (B \setminus \tilde B)
              which are, under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \pi_0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
