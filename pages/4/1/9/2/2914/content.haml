              of
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Fib
                      %mi p
                    %mi B
                  %annotation{:encoding => "application/x-tex"} X \underoverset{\in Fib}{p}{\longrightarrow} B
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ′
                      %munderover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %mi Fib
                        %mrow
                          %mi p
                          %mo ′
                      %mi B
                    %annotation{:encoding => "application/x-tex"} X' \underoverset{\in Fib}{p'}{\longrightarrow} B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi f
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                            %msub
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi p
                                  %mo ′
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \&amp;&amp;
                    \\xrightarrow{\;\; f \;\;}
                    \&amp;&amp;
                    X
                    \\\
                    \&amp;
                    {}_{\mathllap{p}}\searrow
                    \&amp;&amp;
                    \\swarrow{}_{\mathrlap{p'}}
                    \\\
