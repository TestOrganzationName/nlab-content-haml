            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"}> Borel model structure
                )
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
