                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(sSet)
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \overline{W}G \,\in\, sSet
              its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              = succeed ")" do
                %a.maruku-ref{:href => "#SliceModelStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W}G
              of the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              is
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/actions"} actions
              (see
              = succeed "):" do
                %a{:href => "Borel+model+structure\#{QuillenEquivalenceToSliceOverSimplicialClassifyingSpace"} this Prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi W
                          %mi G
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ×
                            %mrow
                              %mover
                                %mi W
                                %mo ¯
                              %mi G
                          %mi W
                          %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mover
                          %mi W
                          %mo ¯
                        %mi G
                  %annotation{:encoding => "application/x-tex"}
                    G Act\big(sSet_{Qu}\big)_{proj}
                    \\underoverset
                    {\underset{ \big((-) \times W G\big)/G }{\longrightarrow}}
                    {\overset{ (-) \times_{\overline{W}G} W G  }{\longleftarrow}}
                    {\bot}
                    \\big(sSet_{Qu}\big)_{/\overline{W}G}
            %p
              For more on this see also at
              = succeed "." do
                %em
