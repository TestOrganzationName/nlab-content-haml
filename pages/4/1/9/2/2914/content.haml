          %h2#definition Definition
          %p
          #SliceModelStructure.num_prop
            %h6 Proposition
            %p
              %strong (slice model structure)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
              as well as the
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/}
              inherit themselves structures of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              and
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              are precisely the morphism whose images under the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functors"} forgetful functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X} \to \mathcal{C}
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/} \to \mathcal{C}
              are fibrations, cofibrations or weak equivalences, respectively, in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            (
            %a{:href => "#Hirschhorn02"}> Hirschhorn 2002, Thm. 7.6.5
            ,
            = succeed ")" do
              %a{:href => "#MayPonto12"} May &amp; Ponto 2012, Th. 15.3.6
          %h2#properties Properties
          %h3#cofibrant_generation_properness_combinatoriality Cofibrant generation, properness, combinatoriality
          #ModelStructureInheritsGoodProperties.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              %li
                %p
                  or a
                  %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
              %li
                %p
                  or a
                  %a.existingWikiWord{:href => "/nlab/show/cellular+model+category"} cellular model category
            %p
              then so are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/}
            %p
              More in detail, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ,
                    %mi J
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I,J \subset Mor(\mathcal{C})
              are the classes of
              %a.existingWikiWord{:href => "/nlab/show/generating+cofibrations"} generating cofibrations
              and of generating acylic cofibrations of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %ul
              %li
                the generating (acyclic) cofibrations of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/}
                are the image under
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊔
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \sqcup(-)
                of those of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            (
            %a{:href => "#Hirschhorn21"}> Hirschhorn (2021)
            ;
            = succeed ")." do
              %a{:href => "#MayPonto12"} May &amp; Ponto (2012, Th. 15.3.6)
          #ModelStructureInheritsCombinatorial.num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
          .proof
            %h6#proof Proof
            %p
              By
              %a{:href => "locally+presentable+category#Properties"} basic properties
              of
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
              they are stable under slicing. Hence with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              locally presentable also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
              is, and by prop.
              %a.maruku-ref{:href => "#ModelStructureInheritsGoodProperties"}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              cofibrantly generated also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
              is.
          #ModelStructureInheritsEnriched.num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              over a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+model+category"} cartesian closed model category
              %a.existingWikiWord{:href => "/nlab/show/enriched+slice+category"} enriched slice category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
          .proof
            %h6#proof_2 Proof
            %p
              By basic properties of
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              over
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+categories"} cartesian closed categories
              they are stable under slicing, where tensoring is computed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (see at
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/enriched+slice+category"} enriched slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              enriched also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
              is. The
              %a.existingWikiWord{:href => "/nlab/show/pushout+product+axiom"} pushout product axiom
              now follows from the fact that in overcategories pushouts are reflected in the underlying category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (by
              = succeed ")." do
                %a{:href => "over+category#LimitsAndColimits"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/unit+axiom"} unit axiom
              follows from the unit axiom of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              using the fact that tensorings are computed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h3#as_presentations_for_over_1categories As presentations for over (∞,1)-categories
          %p
            When restricted to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
            %a.existingWikiWord{:href => "/nlab/show/over+%28%E2%88%9E%2C1%29-category"} over (∞,1)-category
            of an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          %p
            More explicitly, for any
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          #eq:LocalizationFunctor.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo ⟶
                  %msub
                    %mi L
                    %mi W
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  \\gamma \colon \mathcal{C} \longrightarrow L_W \mathcal{C}
          %p
            denote the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28infinity%2C1%29-category"} localization
            (as an
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            (as e.g. given by
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+relative+categories"} model structure on relative categories
          #PresentationOfSliceInfinityCatAlt.num_prop
            %h6#proposition_4 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              %a.maruku-eqref{:href => "#eq:LocalizationFunctor"} (1)
              induces an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo →
                      %msub
                        %mi L
                        %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}/X \to L_W(\mathcal{C})/\gamma(X)
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi L
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_W(\mathcal{C}/X)
                    \\overset{\simeq}{\longrightarrow}
                    L_W(\mathcal{C})/\gamma(X)
                    \\,.
          %p
            This main result is corollary 7.6.13 of
            = succeed "." do
              %a{:href => "#Cisinski20"} Cisinski 20
            = succeed "." do
              %a{:href => "#Cisinski20"} Cisinski Def. 7.4.12
          %p
            We spell out a proof for the special case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            carries the
            %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            of a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            (this proof was written
            %a{:href => "https://ncatlab.org/nlab/revision/model+structure+on+an+over+category/7"} in 2011
            when no comparable statement seemed to be available in the literature):
          #PresentationOfSliceInfinityCat.num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
              %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}/X
              with the above slice model structure is a
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentation
              of the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} over-(∞,1)-category
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi W
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L_W \mathcal{C} / \gamma(X)
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mi W
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_W(\mathcal{C}/X) \simeq  (L_W\mathcal{C}) / \gamma(X)
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              We write equivalently
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                      %mo ≔
                      %msub
                        %mi L
                        %mi W
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-)^\circ \coloneqq L_W(-)
            %p
              It is clear that we have an
              %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+%28%E2%88%9E%2C1%29-functor"} essentially surjective (∞,1)-functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mo ∘
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^\circ/X \to (\mathcal{C}/X)^\circ
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              in that it is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              on all
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mo ∘
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^\circ/X(a,b) \simeq (\mathcal{C}/X)^\circ(a,b)
            %p
              To see this, notice that the hom-space in an
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} over-(∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ∘
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\circ/X
              between objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} a \colon A \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} b \colon B \to X
              is given (as discussed there) by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi 𝒞
                              %mo ∘
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mover
                              %mo →
                              %mi a
                            %mi X
                            %mo ,
                            %mi B
                            %mover
                              %mo →
                              %mi b
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi 𝒞
                              %mo ∘
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi b
                                    %mo *
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mi a
                          %mtd
                            %msup
                              %mi 𝒞
                              %mo ∘
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}^\circ/X(A \stackrel{a}{\to} X, B \stackrel{b}{\to} X)
                    \&amp;\to&amp; \mathcal{C}^\circ(A,B)
                    \\\
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow^{\mathrlap{b_*}}
                    \\\
                    {*} &amp;\stackrel{a}{\to}&amp; \mathcal{C}^\circ(A,X)
                    }
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \in C
              be a cofibrant representative and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} b \colon B \to X
              be a fibration representative in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              (which always exists) of the objects of these names in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} C^\circ
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                          %mtd
                            %mo ↪
                          %mtd
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi a
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;&amp;\hookrightarrow&amp;&amp; A
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{a}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}/X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              as a cofibrant object of
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}/X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi b
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi b
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi Id
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B &amp;&amp;\stackrel{b}{\to}&amp;&amp; X
                    \\\
                    \&amp; {}_{\mathllap{b}}\searrow &amp;&amp; \swarrow_{\mathrlap{Id}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}/X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              as a fibrant object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}/X
            %p
              Moreover, the diagram in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi b
                                    %mo *
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mi a
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}/X(a, b) &amp;\longrightarrow&amp; \mathcal{C}(A,B)
                    \\\
                    \\big\downarrow &amp;&amp; \big\downarrow^{\mathrlap{b_*}}
                    \\\
                    {*} &amp;\overset{a}{\longrightarrow}&amp; \mathcal{C}(A,X)
                    }
            %p is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  diagram in
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  (by the definition of morphism in an ordinary
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                  in the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
                  %a.existingWikiWord{:href => "/nlab/show/pullback+power+axiom"} pullback power axiom
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi Quillen
                      %annotation{:encoding => "application/x-tex"} {}_{Quillen}
                  %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  and the above (co)fibrancy assumptions, all objects are
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
                  and the right vertical morphism is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %li
                %p
                  has in the top left the correct
                  %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-space
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} /
                        %mi X
                      %annotation{:encoding => "application/x-tex"} C/X
                  (since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  is cofibrant and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  fibrant).
            %p
              This means that this correct hom-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}/X(a,b) \simeq (\mathcal{C}/X)^\circ(a,b) \in sSet
              is indeed a model for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mo ∘
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^\circ/X(a,b) \in \infty Grpd
          %h3#PropertiesQuillenAdjunctions Quillen adjunctions
          %h4#BaseChangeQuillenAdjunction Base change Quillen adjunction
          %p
          #LeftBaseChangeQuillenAdjunction.num_prop
            %h6 Proposition
            %p
              %strong (left base change Quillen adjunction)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1 \xrightarrow{f} c_2
              any
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_! \dashv f^\ast)
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              is
              %a.existingWikiWord{:href => "/nlab/show/postcomposition"} postcomposition
              with and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              is
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              between the slice model structures (from Prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#SliceModelStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi c
                          %mn 1
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ⊥
                          %mpadded{:width => "0"}
                            %mi Qu
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟵
                        %mrow
                          %msup
                            %mi f
                            %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mo !
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi c
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_{/c_1}
                    \\underoverset
                    {\underset{f^\ast}{\longleftarrow}}
                    {\overset{f_!}{\longrightarrow}}
                    {\;\;\;\;\bot_{\mathrlap{Qu}}\;\;\;\;}
                    \\mathcal{C}_{/c_2}
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              is the
              %a.existingWikiWord{:href => "/nlab/show/postcomposition"} postcomposition
              operation, it manifestly preserves the classes of
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              morphisms, hence in particular preserves the classes of (acyclic) cofibrations in the slice model structure (by Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#SliceModelStructure"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
          %p
          #LeftBaseChangeQuillenEquivalence.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/left+base+change+Quillen+equivalence"}> left base change Quillen equivalence
                )
              %br/
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi{:mathvariant => "normal"} W
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \phi \colon S \overset{ \in \mathrm{W} }{\longrightarrow} T
              be a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Then the left base change Quillen adjunction along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LeftBaseChangeQuillenAdjunction"}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi T
                    %munderover
                      %mrow
                        %mphantom
                          %mrow
                            %msub
                              %mrow
                              %mi Qu
                        %msub
                          %mo ≃
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi ϕ
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi ϕ
                            %mo !
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_{/T}
                    \\underoverset
                    {\underset{\phi^*}{\longrightarrow}}
                    {\overset{\phi_!}{\longleftarrow}}
                    {\phantom{{}_{Qu}}\simeq_{Qu}}
                    \\mathcal{C}_{/S}
            %p
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              has this property:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast)
              %em
                The
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                (
                %a.existingWikiWord{:href => "/nlab/show/base+change"}> base change
                ) of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                along any
                %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
                is still a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
          Notice that the property
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mo{:stretchy => "false"} (
                %mo *
                %mo{:stretchy => "false"} )
              %annotation{:encoding => "application/x-tex"} (\ast)
          of
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi ϕ
              %annotation{:encoding => "application/x-tex"} \phi
          is implied as soon as either:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic fibration
            %li
              %p
                both
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                are
                %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
          %p
            (for the first this follows by definition; for the second by the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \phi^\ast
            is a
            %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
            by Prop.
            = succeed ";" do
              %a.maruku-ref{:href => "#LeftBaseChangeQuillenAdjunction"}
            %a{:href => "homotopy+pullback#HomotopyPullbackByOrdinaryPullback"} this Prop.
            on recognizing
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
          .proof
            %h6 Proof
            %p
              Using the characterization of Quillen equivalences by derived adjuncts (
              %a{:href => "Quillen+equivalence#AdjunctOfWeakEquivalence"}> here
              ), the base change adjunction is a Quillen equivalence iff for
            %ul
              %li
                %p
                  any
                  %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi S
                      %annotation{:encoding => "application/x-tex"} X \to S
                  in the slice over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  (i.e.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is cofibrant in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Y
                        %mo →
                        %mi T
                      %annotation{:encoding => "application/x-tex"} p \colon Y \to T
                  in the slice over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  (i.e.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
                  in
                  = succeed ")," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p we have that
            %p
              (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %msub
                      %mo ×
                      %mi T
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to \phi^*(Y) = S \times_T Y
              is a weak equivalence
            %p iff
            %p
              (2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \phi_!(X) \to Y
              is a weak equivalence.
            %p
              But the latter morphism is the top composite in the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi S
                            %msub
                              %mo ×
                              %mi T
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi p
                                  %mo *
                                %mi ϕ
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mo
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi pb
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi p
                                  %mo ∈
                                  %mi Fib
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi S
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi ϕ
                                %mo ∈
                                %mi{:mathvariant => "normal"} W
                          %mtd
                            %mi T
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \&amp;\longrightarrow&amp;
                    S \times_T Y
                    \&amp;\overset{p^\ast \phi}{\longrightarrow}&amp;
                    Y
                    \\\
                    \&amp;\searrow&amp;
                    \\big\downarrow
                    \&amp;{}^{_{(pb)}}&amp;
                    \\big\downarrow {}^{\mathrlap{p \in Fib}}
                    \\\
                    \&amp;&amp; S &amp;\underset{\phi \in \mathrm{W} }{\longrightarrow}&amp; T
                    }
            %p
              Hence the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} p^\ast \phi
              is a weak equivalence.
            %p
              Conversely, taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to \phi^\ast(X)
              to be a weak equivalence (hence a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi^\ast(X)
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              implies that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mo !
                    %mo ⊣
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi_! \dashv \phi^\ast)
              is a Quillen equivalence, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} p^\ast \phi
              is a weak equivalence.
          %p In particular:
          %p
          #RightPropernessAndLeftQuillenBaseChange.num_prop
            %h6 Proposition
            %p The following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper model category
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi c
                          %mn 1
                        %mo →
                        %msub
                          %mi c
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} f \colon c_1 \to c_2
                  is any
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mo !
                        %mo ⊣
                        %msup
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f_! \dashv f^\ast)
                  (from Prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LeftBaseChangeQuillenAdjunction"}
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            %p
          %p
            This is due to
            = succeed "." do
              %a{:href => "#Rezk02"} Rezk 02, Prop. 2.5
          %h4#sliced_quillen_adjunctions Sliced Quillen adjunctions
          %p
          #SlicedQuillenAdjunction.num_prop
            %h6 Proposition
            %p
              %strong (slice Quillen adjunctions)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ⊥
                          %mpadded{:width => "0"}
                            %mi Qu
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mi L
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}
                    \\underoverset
                    {\underset{R}{\longrightarrow}}
                    {\overset{L}{\longleftarrow}}
                    {\;\;\;\;\bot_{\mathrlap{Qu}}\;\;\;\;}
                    \\mathcal{C}
                    \\,,
            %p then:
            %ol
              %li
                %p
                  for any
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} b \in \mathcal{C}
                  the
                  %a{:href => "over+category#OnSlices"} sliced adjunction
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                  between the corresponding slice model categories (Prop.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#SliceModelStructure"}
                #eq:SlicedQuillenAdjointFunctorsOverLb.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒟
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                        %munderover
                          %mrow
                            %msub
                              %mo ⊥
                              %mpadded{:width => "0"}
                                %mi Qu
                          %munder
                            %mo ⟶
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi R
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi b
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                          %mover
                            %mo ⟵
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi L
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi b
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi b
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{D}_{/L(b)}
                        \\underoverset
                        {\underset{\;\;\;\;R_{/b}\;\;\;\;}{\longrightarrow}}
                        {\overset{\;\;\;\;L_{/b}\;\;\;\;}{\longleftarrow}}
                        {\bot_{\mathrlap{Qu}}}
                        \\mathcal{C}_{/b}
                        \\mathrlap{\,,}
              %li
                %p
                  for any
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} b \in \mathcal{D}
                  the
                  %a{:href => "over+category#OnSlices"} sliced adjunction
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                  between the corresponding slice model categories (Prop.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#SliceModelStructure"}
                #eq:SlicedQuillenAdjointFunctorsOverRb.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒟
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi b
                        %munderover
                          %mrow
                            %msub
                              %mo ⊥
                              %mpadded{:width => "0"}
                                %mi Qu
                          %munder
                            %mo ⟶
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi R
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi b
