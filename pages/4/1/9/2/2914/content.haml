            %p
              and, in turn, the induced morphim of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+of+homotopy+groups"} long exact sequences of homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} n \,\in\, \mathbb{N}_+
              (where
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x' \,\coloneqq\, f(x)
