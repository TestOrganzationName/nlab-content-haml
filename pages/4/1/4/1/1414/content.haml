                          %mo ,
                          %mn 3
                          %mo ,
                          %mn 4
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo ,
                          %mn 2
                          %mo ,
                          %mn 4
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ↘
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 2
                          %mo ,
                          %mn 3
                          %mo ,
                          %mn 4
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 2
                          %mo ,
                          %mn 4
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (0,1,2,3,4) &amp;\to&amp; (0,1,2,4)
                  \\\
                  \\downarrow &amp;\searrow&amp; \downarrow
                  \\\
                  (0,2,3,4) &amp;\to&amp; (0,2,4)
                  }
          %p
            which does not correspond to associativity: instead, this encodes the
            %a.existingWikiWord{:href => "/nlab/show/exchange+law"} exchange law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
