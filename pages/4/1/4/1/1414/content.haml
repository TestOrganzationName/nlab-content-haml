                  %mn 3
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi S
                  %mo{:stretchy => "false"} [
