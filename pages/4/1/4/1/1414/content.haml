                %use{:x => "83.333", "xlink:href" => "#3WsYT-KqWhDMP6oJapyJ22DTeIs=-glyph-1-3", :y => "59.493"}
                %use{:x => "87.567514", "xlink:href" => "#3WsYT-KqWhDMP6oJapyJ22DTeIs=-glyph-1-4", :y => "59.493"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "143.71", "xlink:href" => "#3WsYT-KqWhDMP6oJapyJ22DTeIs=-glyph-0-3", :y => "82.905"}
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0,1,2)
            is a product of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0,1)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,2)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,2) \cdot (0,1) \Rightarrow (0,2)
          %p
            Everything else, in higher dimensions, is degenerate, so
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} S[2](0,2)\cong \Delta[1]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [2]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} S[n]
            in general has a nice interpretation in terms of higher dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rewriting"} rewriting
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/polygraph"} polygraph
            = succeed "s.)" do
              %a.existingWikiWord{:href => "/nlab/show/computad"} computad
          %p
            In this example there are no significant compositions. To see examples of those, you need to look at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} S[3]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mn 3
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S[3](i,j)
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i,j) \neq (0,3)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S[3](0,3)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mn 3
                %annotation{:encoding => "application/x-tex"} 0\to 3
            and then the three others. Rewriting the direct path can be done in two immediate ways, to go via the left or via the right route. Each of these can be ‘rewritten’ to give the longest path / largest subset. There is also, of course, an inclusion of the smallest to the largest of these, so that in total the poset here looks like:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 3
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 3
                            %mo{:stretchy => "false"} }
                    %mo }
                  %mo =
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo ×
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P_{0,3}
                  \=
                  \\left\{
                  \\array{
                  \\{0,1,2,3\}&amp;\rightarrow &amp; \{0,1,3\}
                  \\\
                  \\downarrow &amp; \searrow &amp;\downarrow\\
                  \\{0,2,3\}&amp;\rightarrow &amp;\{0,3\}
                  }
                  \\right\}
                  \=
                  \\Delta[1]^{\times 2}
                  \\,.
          %p
            In addition, there will be 2-simplexes filling the two triangles, coming from the chains
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{0,1,2,3\}\subset \{0,1,3\}\subset \{0,3\}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{0,1,2,3\}\subset \{0,2,3\}\subset \{0,3\}
            in the poset.
