              %li
                %a{:href => "#related_concepts"} Related concepts
              %ul
                %li
                  %a{:href => "#comonadic_resolution"} Comonadic resolution
                %li
                  %a{:href => "#WConstruction"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
                    \-Construction of topological operads
                %li
                  %a{:href => "#relation_to_quasicategories"} Relation to quasi-categories
                %li
                  %a{:href => "#models_for_categories"}
                    Models for
                    = succeed "-categories" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                %li
                  %a{:href => "#other_kinds_of_nerves"} Other kinds of nerves
              %li
                %a{:href => "#history"} History
              %li
                %a{:href => "#references_and_literature"} References and Literature.
          %h2#idea Idea
          %p
            The
            %em homotopy coherent nerve
            (also called
            = succeed ")" do
              %em simplicial nerve
            %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
            is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            which includes information about all the higher homotopies present in the hom-spaces. It generalizes the ordinary
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            of an ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %p The homotopy coherent nerve operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:lspace => "verythinmathspace"} :
                  %mi sSet
                  %mtext -
                  %mi Cat
                  %mo ⟶
                  %mi sSet
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N \colon sSet\text{-}Cat \longrightarrow sSet
                  \\,.
          %p
            is induced, by the general machinery of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo ⟶
                  %mi sSet
                  %mtext -
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  \\Delta \longrightarrow sSet\text{-}Cat
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            to the category of
            %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+categories"} simplicially enriched categories
            which regards each
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            as a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            objects analogous to how the
            %a.existingWikiWord{:href => "/nlab/show/orientals"} orientals
            regard the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+omega-category"}
                strict
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %h2#definitions Definitions
          %h3#the_cosimplicial_category
            The cosimplicial
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
          %p
            We here describe the cosimplicial
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Δ
                  %mo ⟶
                  %mi sSet
                  %mtext -
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  S \colon \Delta \longrightarrow sSet\text{-}Cat
          %p that induces the homotopy coherent nerve.
          %h3#a_categorical_description A categorical description
          %p
            Recall that a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graph"} graph
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %em
              %a.existingWikiWord{:href => "/nlab/show/reflexive+graph"} reflexive
            if for each
            %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            it is equipped with a (specified)
            %a.existingWikiWord{:href => "/nlab/show/edge"} edge
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo →
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v \to v
            %strong
              reflexive
              %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
            has a specified identity edge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} i_X \colon X \to X
            on each object (vertex)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
            on a reflexive directed graph has
          %ul
            %li
              %p
                as
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                the
                %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
                of the graph,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
                corresponding to the identity edges,
            %li
              %p non-identity morphisms consisting of sequences of non-identity edges.
          %p
            The
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi ReflxDGraph
                  %mo ⟶
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  F
                  \\;\colon\;
                  ReflxDGraph \longrightarrow Cat
          %p
            and as such is
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Cat
                  %mo ⟶
                  %mi ReflxDGraph
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F
                  \\;\colon\;
                  Cat \longrightarrow ReflxDGraph
                  \\,.
          %p
            Hence the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi F
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Cat
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} G = F U \colon Cat\to Cat
            constitutes a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/simplicial+resolution"} simplicial resolution
            of this comonad gives an augmented simplicial
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Δ
                  %mo ⟶
                  %mi sSet
                  %mtext -
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} S \colon \Delta \longrightarrow sSet\text{-}Cat
            with natural augmentation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} S\to Id
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+replacement"} cofibrant replacement
            %a.existingWikiWord{:href => "/nlab/show/Bergner+model+structure"} Bergner model structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                  %mo −
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} sSet-Cat
            (“model structure for simplicially enriched categories”).
          %p
          .num_remark
            %h6 Remark
            %p
              Some
              = succeed "," do
                %em words of caution
            %p
              Because of this, it is always important to test the definition being used on a simple example,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [2]
              will do, before commiting to the use of any specific formulae. We will see this again in another Remark later on in this entry.
          %h3#a_combinatorial_description A combinatorial description
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            the finite
            %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo &lt;
                  %mn 1
                  %mo &lt;
                  %mi ⋯
                  %mo &lt;
                  %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} [n] \coloneqq \{0 \lt 1 \lt  \cdots \lt n\}
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[n]
            be standard
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplex"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-simplex
            %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} S[n]
            as follows:
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} S[n]
                are
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{0,1, \cdots, n\}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %mo ∈
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} S[n]_{i,j} \in sSet
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} i, j \in \{0,1,\cdots, n\}
                are the
                %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi N
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi P
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      S[n](i,j) \coloneqq N(P_{i,j})
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                    %annotation{:encoding => "application/x-tex"} P_{i,j}
                which is equivalently
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                    of
                    %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [i,j]
                    that contain both
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
                    (so in particular if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo &gt;
                          %mi j
                        %annotation{:encoding => "application/x-tex"} i \gt j
                    then
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} P(i,j)
                    is
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                    and hence so is its nerve) with the partial order is given by reverse inclusion.
                %li
                  %p
                    the poset of
                    %a.existingWikiWord{:href => "/nlab/show/path+category"} paths
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [n]
                    that start at
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                    and finish at
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
                    (hence is empty if
                    = succeed ")," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                            %mo &gt;
                            %mi j
                          %annotation{:encoding => "application/x-tex"} i\gt j
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
                    is less than path
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                        %annotation{:encoding => "application/x-tex"} b
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} P(i,j)
                    if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
                    visits all the vertices that
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                        %annotation{:encoding => "application/x-tex"} b
                    does … and perhaps some others as well.
                  %p
                    Of course, the way you go between the two descriptions is that a path corresponds to the set of vertices it visits and
                    = succeed "." do
                      %em vice versa
          %p
            Notice that the simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(P_{i,j})
            is
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            to the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo −
                  %mi i
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} j-i-1
            cube in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo −
                      %mi i
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N(P_{i,j}) = (\Delta[1])^{\times (j-i-1)}
                  \\,.
          %p
            Under this isomorphism for instance the vertex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo −
                      %mi i
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0,0,1,0,1) \in (\Delta[1])^{\times (j-i-1)}
            corresponds to the subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mo ,
                  %mi i
                  %mo +
                  %mn 3
                  %mo ,
                  %mi i
                  %mo +
                  %mn 5
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %mo{:stretchy => "false"} [
                  %mi i
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \{i,i+3,i+5,j\} \subset [i,j]
            and to the path
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo →
                    %mi i
                    %mo +
                    %mn 3
                    %mo →
                    %mi i
                    %mo +
                    %mn 5
                    %mo →
                    %mi j
                    %mo =
                    %mi i
                    %mo +
                    %mn 6
                  %annotation{:encoding => "application/x-tex"} i \to i+3 \to i+5 \to j=i+6
          %p (We will look at an example after this definition.)
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                operation on hom-objects
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                          %mo ,
                          %mi k
                      %mo :
                      %mi S
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %mo ×
                      %mi S
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi j
                          %mo ,
                          %mi k
                      %mo →
                      %mi S
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi i
                          %mo ,
                          %mi k
                    %annotation{:encoding => "application/x-tex"}
                      \\circ_{i,j,k} : S[n]_{i,j} \times S[n]_{j,k} \to S[n]_{i,k}
              %p is induced by ‘concatenation of the corresponding paths’ and thus essentially by union of the sets involved.
          .num_remark
            %h6#remark Remark
            %p
              The choice to order paths by reverse inclusion agrees with constructions such as the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Duskin+nerve"} Duskin nerve
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
              definition 1.1.5.1., and corresponds to the convention used in the original paper by Cordier (see earlier Remark). The resulting theory is more or less equivalent in as much as the results true when using one convention have analogous results when using the other.
          %h3#the_homotopy_coherent_nerve The homotopy coherent nerve
          %p
            The
            %strong homotopy coherent nerve
            functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ≔
                  %msub
                    %mi Hom
                    %mrow
                      %mi sSet
                      %mi Cat
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mo •
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi sSet
                  %mi Cat
                  %mo ⟶
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  N
                  \\coloneqq
                  Hom_{sSet Cat}(S[\bullet],-)
                  \\colon sSet Cat \longrightarrow sSet
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            defined by the
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
            %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Δ
                  %mo →
                  %mi sSet
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} S \colon \Delta \to sSet Cat
            defined above.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                  %mi sSet
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} C \in sSet Cat
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(C)
            is the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            uniquely characterized as giving a
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi SSet
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Hom
                    %mrow
                      %mi SSet
                      %mi Cat
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi C
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_{SSet}\big(\Delta[n], N(C)\big)
                  \\;\simeq\;
                  Hom_{SSet Cat}\big(S[n], C\big)
                  \\,.
          %p
            By the general logic of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi SSet
                  %mo →
                  %mi SSet
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  S(-) \colon SSet \to SSet Cat
          %p
            the
            %strong realization
            functor given by the
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                  %msub
                    %mi X
                    %mi n
                  %mo ⋅
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  S(X)
                  \\coloneqq
                  \\int^{[n] \in \Delta} X_n \cdot S[n]
                  \\,,
          %p
            also known as the operation of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/rigidification+of+quasi-categories"} rigidification of quasi-categories
          %p
            This functor does extend the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi Δ
                  %mo →
                  %mi sSet
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} S : \Delta \to sSet Cat
            in that there is a canonical isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  S(\Delta[n]) \cong S[n]
          %p
            and hence may consistently be named
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %h2#examples_and_illustrations Examples and illustrations
          %h3#IllustratOfCosimpSSetCat
            For the cosimplicial
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
          %p
            We illustrate here the nature of the cosimplicial
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} S : [n] \mapsto S[n]
          %p We will examine the lowest dimensional cases.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n = 0
            there is nothing of note.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            we have that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 1
                  %mo =
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo }
                  %mo =
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  P_{0,1} = \left\{ (0,1) \right\} = \Delta[0] = \Delta[1]^0
          %p is the poset with a single object.
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [2]
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0]
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [2]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} S[2]
            are copies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[0]
            (or, if you prefer, of
            = succeed "!)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta[1]^0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S[2](0,2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{0,1,2\}
            containing both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [2]
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            so is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 1
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 0\to 1\to 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 2
                  %mo =
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo }
                  %mo =
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  P_{0,2} =
                  \\left\{
                  (0,1,2) \to (0,2)
                  \\right\}
                  \=
                  \\Delta[1]
                  \\,,
          %p
            so in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S[2](0,2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            starting at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
