                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; 1 &amp;&amp;&amp;&amp; 3
                  \\\
                  \&amp; \nearrow &amp;\Downarrow&amp; \searrow &amp;&amp; \nearrow &amp;&amp; \searrow
                  \\\
                  0 &amp;&amp;\to&amp;&amp; 2 &amp;&amp;  &amp;&amp; 4
                  \\\
