                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |N(P_{0,4})|
            correspond to the associativity of composition of triples of composable morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 4
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [4]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 4
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[4]
            %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
            and at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          %p But the cube has one more face
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
