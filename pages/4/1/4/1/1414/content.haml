                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; \nearrow &amp;&amp; \searrow^{\mathrlap{\{0,3\}}}
                  \\\
                  \&amp; &amp; \Uparrow
                  \\\
                  0  &amp;&amp;\stackrel{\{0,1,3\}}{\to}&amp;&amp; 3
                  \\\
                  \&amp;&amp; \Uparrow
                  \\\
