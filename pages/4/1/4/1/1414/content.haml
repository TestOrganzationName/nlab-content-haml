                  \\\
                  0 &amp;&amp;\to&amp;&amp; 2 &amp;&amp; \to &amp;&amp; 4
                  }
                  \\;\;\;\;\;\;
                  \\simeq
                  \\;\;\;\;\;\;
                  \\array{
                  \&amp;&amp; 1 &amp;&amp;&amp;&amp; 3
                  \\\
                  \&amp; \nearrow &amp;&amp; \searrow &amp;&amp; \nearrow &amp;\Downarrow&amp; \searrow
                  \\\
