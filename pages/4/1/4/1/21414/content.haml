          %p
            Basic properties of underlying
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
