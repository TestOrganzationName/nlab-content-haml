                = succeed ")" do
                  %a{:href => "http://www.tac.mta.ca/tac/volumes/35/24/35-24abs.html"} tac:35-24
            %li#Henry20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                ,
                = succeed "," do
