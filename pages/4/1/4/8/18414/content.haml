                            %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mn 2
                            %mspace{:width => "thickmathspace"}
                            %mn 3
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mn 3
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mn 3
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (1\; 2\; 3)
                    \\\
                    (1 \; 2) (3)
                    \\\
                    (1) (2) (3)
                    
                    }
            %p The corresponding covering spaces of the circle are shown in the graphics.
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "homotopy+equivalence#Hatcher"} Hatcher
