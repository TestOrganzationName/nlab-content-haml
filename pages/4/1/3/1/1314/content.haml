                    %annotation{:encoding => "application/x-tex"} [n] \coloneqq \{0 \lt 1 \lt \cdots \lt n\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi smth
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
