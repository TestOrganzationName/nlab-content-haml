          #SmoothDifferentialFormsOnSmoothnSimplex.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (smooth differential forms on the smooth
                = succeed "-simplex)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              then a
              %a.existingWikiWord{:href => "/nlab/show/smooth+differential+k-form"} smooth differential k-form
              on the smooth
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %a.maruku-ref{:href => "#SmoothnSimplex"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              with
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+corners"} corners
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 0
                        %mi n
                      %msub
                        %mi x
                        %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 1
                      %mo }
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    F^n
                    \\;\coloneqq\;
                    \\left\{
                    (x_0, x_1, \cdots, x_n)
                    \\in
                    \\mathbb{R}^{n+1}
                    \\;\vert\;
                    \\underoverset{i = 0}{n}{\sum}
                    x_i
                    \\; = \; 1
                    \\right\}
                    \\hookrightarrow
                    \\mathbb{R}^{n+1}
            %p
              be the affine plane in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              that contains
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n_{smth}
              in its defining inclusion from def.
              = succeed "." do
                %a.maruku-ref{:href => "#SmoothnSimplex"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            %p
              A smooth differential form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n_{smth}
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a collection of
              %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mi k
                    %msub
                      %mi T
                      %mi x
                    %msup
                      %mi F
                      %mi n
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^k T_x F^n \longrightarrow \mathbb{R}
            %p
              out of the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tensor+power"} tensor power
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi n
                  %annotation{:encoding => "application/x-tex"} F^n
              at some point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x \in \Delta^n_{smth}
              such that this extends to a smooth differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mi n
                    %annotation{:encoding => "application/x-tex"} F^n
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Delta^n_{smth})
              for the graded
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              defined this way. By definition there is then a canonical linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi F
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(F^n) \longrightarrow \Omega^\bullet(\Delta^n_{smth})
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi n
                  %annotation{:encoding => "application/x-tex"} F^n
              and there is a unique structure of a
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Delta^n_{smth})
              that makes is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              form the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+algebra"} de Rham algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mi n
                    %annotation{:encoding => "application/x-tex"} F^n
              = succeed "-simplex." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f \colon [n_1] \to [n_2]
              a homomorphism of finite non-empty
              %a.existingWikiWord{:href => "/nlab/show/linear+orders"} linear orders
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi smth
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo →
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \Delta_{smth}(f) \colon \Delta^{n_1}_{smth} \to \Delta^{n_2}_{smth}
              the corresponding smooth function according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothnSimplex"}
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebras"} differential graded-commutative algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi smth
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\Delta_{smth}(f))^\ast
                    \\;\colon\;
                    \\Omega^\bullet(\Delta^{n_2}_{smth})
                    \\longrightarrow
                    \\Omega^\bullet(\Delta^{n_1}_{smth})
            %p
              induced from the usual
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mi n
                    %annotation{:encoding => "application/x-tex"} F^n
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebras"} differential graded-commutative algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Δ
                      %mi op
                    %mo ⟶
                    %msub
                      %mi dgcAlg
                      %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(\Delta^{(-)}_{smth})
                    \\;\colon\;
                    \\Delta^{op}
                    \\longrightarrow
                    dgcAlg_{\mathbb{R}}
                    \\,.
          %p
            The standard proof of the
            %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+lemma"} Poincaré lemma
            applies to show that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Δ
                    %mi smth
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^\bullet(\Omega^\bullet(\Delta^n_{smth})) \simeq \mathbb{R}
                  \\,.
          %p
            Each element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi poly
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^p_{poly}(\Delta^n)
            may be uniquely written
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mn 1
                      %mo ≤
                      %msub
                        %mi i
                        %mn 1
                      %mo &lt;
                      %mi …
                      %mo &lt;
                      %msub
                        %mi i
                        %mi p
                      %mo ≤
                      %mi n
                  %msub
                    %mi Φ
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mi …
                      %msub
                        %mi i
                        %mi p
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ∧
                  %mi …
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mi p
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \Phi =\sum_{1\leq i_1\lt\ldots\lt i_p\leq n}\Phi_{i_1\ldots i_p}d b_{i_1}\wedge\ldots d b_{i_p},
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi j
                %annotation{:encoding => "application/x-tex"} b_j
            is as above the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mi th
                %annotation{:encoding => "application/x-tex"} j^{th}
            barycentric coordinate function and each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mi …
                      %msub
                        %mi i
                        %mi p
                %annotation{:encoding => "application/x-tex"} \Phi_{i_1\ldots i_p}
            is a
            = succeed "-function" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}^n
          %p
            With this representation the multiplication and differential are given by the usual formulae. The multiplication is defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo ∧
                  %mi Ψ
                %annotation{:encoding => "application/x-tex"} \Phi \wedge \Psi
            and extends linearly the product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ∧
                  %mi …
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mi p
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                  %mo ∧
                  %mi …
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi j
                        %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ∧
                  %mi …
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mi p
                  %mo ∧
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                  %mo ∧
                  %mi …
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi j
                        %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (d b_{i_1}\wedge\ldots d b_{i_p})\wedge (d b_{j_1}\wedge\ldots d b_{j_q}) = (d b_{i_1}\wedge\ldots d b_{i_p}\wedge d b_{j_1}\wedge\ldots d b_{j_q})
          %p
            on the generating forms. Now if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a differentiable function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi f
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi n
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi f
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi i
                  %mi d
                  %msub
                    %mi x
                    %mi i
                  %mo ,
                %annotation{:encoding => "application/x-tex"} d f = \sum_{i=1}^{n} \frac{\partial f}{\partial x^i}d x_i,
          %p so if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mn 1
                      %mo ≤
                      %msub
                        %mi i
                        %mn 1
                      %mo &lt;
                      %mi …
                      %mo &lt;
                      %msub
                        %mi i
                        %mi p
                      %mo ≤
                      %mi n
                  %msub
                    %mi Φ
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mi …
                      %msub
                        %mi i
                        %mi p
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ∧
                  %mi …
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mi p
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \Phi =\sum_{1\leq i_1\lt \ldots\lt i_p\leq n}\Phi_{i_1\ldots i_p}d b_{i_1}\wedge\ldots d b_{i_p},
          %p then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi Φ
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mn 1
                      %mo ≤
                      %msub
                        %mi i
                        %mn 1
                      %mo &lt;
                      %mi …
                      %mo &lt;
                      %msub
                        %mi i
                        %mi p
                      %mo ≤
                      %mi n
                  %mi d
                  %msub
                    %mi Φ
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mi …
                      %msub
                        %mi i
                        %mi p
                  %mo ∧
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ∧
                  %mi …
                  %mi d
                  %msub
                    %mi b
                    %mrow
                      %msub
                        %mi i
                        %mi p
                  %mo ,
                %annotation{:encoding => "application/x-tex"} d\Phi =\sum_{1\leq i_1\lt\ldots\lt i_p\leq n} d\Phi_{i_1\ldots i_p} \wedge d b_{i_1} \wedge \ldots d b_{i_p},
          %h3#Polynomial Polynomial differential forms
          #PolynomialDifferentialForms.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Sym
                      %mi ℚ
                      %mo •
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi t
                      %mi n
                    %mo ,
                    %mi d
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi d
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %msub
                        %mi t
                        %mi i
                      %mo −
                      %mn 1
                      %mo ,
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi d
                      %msub
                        %mi t
                        %mi i
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{poly}^{\bullet}(\Delta^n)
                    \\;\coloneqq\;
                    Sym^\bullet_{\mathbb{Q}}
                    \\langle t_0, \cdots, t_n, d t_0, \cdots, d t_n\rangle/\left(\sum t_i -1, \sum d t_i \right)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
              over the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_i
              in degree 0 and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d t_i
              of degree 1.
            %p
              In particular, in degree 0 these are called the
              %em polynomial functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ℚ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi t
                        %mi i
                      %mo =
                      %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^0_{poly}(\Delta^n)
                    \\;=\;
                    \\mathbb{Q}[t_0, t_1, \cdots t_n]/\left( \underset{i}{\sum} t_i = 0 \right)
            %p due to the canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^0_{poly}(\Delta^n)
                    \\hookrightarrow
                    C^\infty(\Delta^n_{smth})
            %p
              into the
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on the
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothDifferentialFormsOnSmoothnSimplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_i
              as the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              of the polynomial differential forms over these polynomial functions with the
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on the
              = succeed "-simplex," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Delta^n_{smth})
              of smooth
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              = succeed ":" do
                %a.maruku-ref{:href => "#SmoothDifferentialFormsOnSmoothnSimplex"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi poly
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mi n
                        %mo{:stretchy => "false"} )
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(\Delta^n_{smth})
                    \\simeq
                    C^\infty(\Delta^n_{smth}) \otimes_{\Omega^0_{poly}(\Delta^n)}
                    \\Omega^\bullet_{poly}(\Delta^n)
            %p
              where moreover the generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d t_i
              are identified with the de Rham differential of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            %p This defines a canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(\Delta^n)
                    \\hookrightarrow
                    \\Omega^\bullet(\Delta^n_{smth})
            %p
              and there is uniquely the structure of a
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{poly}(\Delta^n)
              that makes this a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              = succeed "." do
                %em dg-algebra of polynomial differential forms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f \colon [n_1] \to [n_1]
              a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of finite non-empty
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+orders"} linear orders
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(f)
                    \\;\colon\;
                    \\Omega^\bullet_{poly}(\Delta^{n_2}) \to \Omega^\bullet_{poly}(\Delta^{n_1})
            %p be the morphism of dg-algebras given on generators by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi t
                      %mi i
                    %mo ↦
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi i
                    %msub
                      %mi t
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(f) : t_i \mapsto \sum_{f(j) = i} t_j
                    \\,.
            %p
              This yields a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %msub
                      %mi cdgAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(\Delta^{(-)}) : \Delta^{op} \to cdgAlg_k
            %p which is a sub-simplicial object of that of smooth differential form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_{poly}(\Delta^{(-)})
                    \\hookrightarrow
                    \\Omega^\bullet(\Delta_{smth}^{(-)})
                    \\,.
          %h3#PiecewisePolynomialDifferentialForms Piecewise polynomial differential forms
          %p
            By left
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            the functor of polynomial differential forms from def.
            %a.maruku-ref{:href => "#PolynomialDifferentialForms"}
            yields a functor on all
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi poly
                    %mo •
                  %mo{:lspace => "verythinmathspace"} :
                  %mi sSet
                  %mo ⟶
                  %msubsup
                    %mi cdgAlg
                    %mi k
                    %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet_{poly} \colon sSet \longrightarrow cdgAlg_k^{op}
                  \\,.
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            in a
            %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Ω
                    %mi poly
                    %mo •
                  %mo ⊣
                  %msub
                    %mi 𝒦
                    %mi poly
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi dgcAlg
                    %mrow
                      %mi ℚ
                      %mo ,
                      %mo ≥
                      %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %munderover
                    %mo ⊥
                    %munder
                      %mo ⟶
                      %mrow
                        %msub
                          %mi K
                          %mi poly
                    %mover
                      %mo ⟵
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi poly
                          %mo •
                  %mi sSet
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\Omega^\bullet_{poly} \dashv \mathcal{K}_{poly})
                  \\;\colon\;
                  (dgcAlg_{\mathbb{Q}, \geq 0})^{op}
                  \\underoverset
                  {\underset{K_{poly}}{\longrightarrow}}
                  {\overset{\Omega^\bullet_{poly}}{\longleftarrow}}
                  {\bot}
                  sSet
                  \\,.
          %p
            Composing with the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sing
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Top
                  %mo ⟶
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  Sing \;\colon\; Top \longrightarrow sSet
          %p
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi pwpoly
                    %mo •
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Top
                  %mover
                    %mo ⟶
                    %mi Sing
                  %mi sSet
                  %mover
                    %mo ⟶
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi poly
                        %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi dgcAlg
                    %mrow
                      %mi ℚ
                      %mo ,
                      %mo ≥
                      %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet_{pwpoly}
                  \\;\colon\;
                  Top
                  \\overset{Sing}{\longrightarrow}
                  sSet
                  \\overset{\Omega^\bullet_{poly}}{\longrightarrow}
                  (dgcAlg_{\mathbb{Q}, \geq 0})^{op}
          %p which we may think of as assigning “piecewise polynomial” differential forms.
          %p
            This is the starting point of the Sullivan approach to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %h2#Properties Properties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            0. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi poly
                    %mo •
                  %mo :
                  %mi sSet
                  %mo →
                  %msubsup
                    %mi cdgAlg
                    %mi k
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{poly} : sSet \to cdgAlg_k^{op}
            be the left
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi poly
                    %mo •
                  %mo :
                  %mi Δ
                  %mo →
                  %msubsup
                    %mi cdgAlg
                    %mi k
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{poly} : \Delta \to cdgAlg_k^{op}
            from
            = succeed "." do
              %a{:href => "#Polynomial"} above
          .num_defn
            %h6#definition_5 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} S \in sSet
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mo :
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int : \Omega^\bullet_{poly}(S) \to C^\bullet(S, k)
            %p
              from polynomial differential forms on simplices to
              %a.existingWikiWord{:href => "/nlab/show/cochains+on+simplicial+sets"} cochains on simplicial sets
              by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n_{poly}(K)
              to the cochain that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msub
                      %mi K
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma \in K_n
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi σ
                    %mi f
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mi n
                    %msub
                      %mi f
                      %mi max
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mi d
                    %msub
                      %mi t
                      %mn 1
                    %mo ∧
                    %mi ⋯
                    %mi d
                    %msub
                      %mi t
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\int_\sigma f := \int_{\Delta^n} f_{max}(\sigma) d t_1 \wedge \cdots d t_n
                    \\,,
            %p
              where on the right we have the ordinary
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              of the
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 1,\cdots,n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
          .num_prop
            %h6#proposition Proposition
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                  %annotation{:encoding => "application/x-tex"} \int
              is a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              of cochain complexes.
          %p
            This is (
            %a{:href => "#BousfieldGugenheim"}> Bousfield-Gugenheim, theorem 2.2, corollary 3.4
            ).
          %p
            The following is the central fact of the Sullivan approach to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{poly}
              is the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              of a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi sSet
                    %munderover
                      %mo ⊥
                      %munder
                        %mo →
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi poly
                            %mo •
                      %mover
                        %mo ←
                        %mi R
                    %msubsup
                      %mi cdgAlg
                      %mi k
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega^\bullet_{poly} \dashv R)
                    \\;\colon\;
                    sSet
                    \\underoverset
                    {\underset{\Omega^\bullet_{poly}}{\to}}
                    {\overset{R}{\leftarrow}}
                    {\bot}
                    cdgAlg_k^{op}
            %p
              for the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              and the projective
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} model structure on commutative dg-algebras
          %p
            This is shown in (
            %a{:href => "#BousfieldGugenheim"}> Bousfield-Gugenheim, section 8
            ).
          %p
            So in particular
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi poly
                    %mo •
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{poly}
            sends cofibrations of simplicial sets to fibrations of dg-algebras. Hence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} i : \partial \Delta[k] \hookrightarrow \Delta[k]
            a boundary inclusion the corresponding restriction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo :
                  %msubsup
                    %mi Ω
                    %mi poly
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
