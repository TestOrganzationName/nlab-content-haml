          %h2#idea Idea
          %p
            The
            %em Yang-Mills-Higgs equations
            (or
            = succeed ")" do
              %em YMH equations
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higgs+field"} Higgs field
          %h2#definition Definition
          %p In the following, consider
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                be a
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %li
              %p
                with
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ↠
                      %mi B
                    %annotation{:encoding => "application/x-tex"} P \twoheadrightarrow B
                a
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"}
                  principal
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                over
            %li
              %p
                a compact
                %a.existingWikiWord{:href => "/nlab/show/orientable"} orientable
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (B,g)
          %p and write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ad
                        %mi P
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mi P
                      %msub
                        %mo ×
                        %mi G
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} Ad_P \,\coloneqq\, P \times_G \mathfrak{g}
                for its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+bundle"} adjoint bundle
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Γ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Ad
                        %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma^\infty(Ad_P)
                for the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/space+of+smooth+sections"} space of smooth sections
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi conn
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ;
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ;
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1_{conn}(P;\mathfrak{g}) \subset \Omega^1(P;\mathfrak{g})
                for the
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+1-forms"} Lie algebra valued differential 1-forms
                which are (
                %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"}> Ehresmann
                )
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connection forms
              %p
                (and
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} recall
                that the
                %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge-invariants
                of the
                %a.existingWikiWord{:href => "/nlab/show/curvature+2-form"} curvature 2-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi A
                    %annotation{:encoding => "application/x-tex"} F_A
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi conn
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ;
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in \Omega^1_{conn}(P;\mathfrak{g})
                descend to, hence are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pulled back from
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                on
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
          %p
            If the base space is not
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi conn
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ;
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1_{conn}(P;\mathfrak{g})
            and the
            %a.existingWikiWord{:href => "/nlab/show/Higgs+field"} Higgs field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo ∈
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ad
                    %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma^\infty(Ad_P)
            are required to
            %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"} vanish at infinity
            (cf.
            = succeed ")." do
              %a{:href => "#Taubes82a"} Taubes 1982a, Equation (2.3)
          %h3#ActionFunctional Action functional
          %p
            The
            %em
              Yang-Mills-Higgs
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            (or
            = succeed ")" do
              %em YMH action functional
          #eq:TheActionFunctional.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mpadded{:lspace => "-100%width", :width => "0"}
                          %mrow
                            %msub
                              %mi S
                              %mi YMH
                            %mspace{:width => "thinmathspace"}
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Ω
                          %mi conn
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ;
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %msup
                          %mi Γ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Ad
                          %mi P
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mo ⟶
                      %mtd
                        %mi ℝ
                    %mtr
                      %mtd
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi A
                        %mo ,
                        %mi Φ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtd
                        %mo ↦
                      %mtd
                        %msub
                          %mi S
                          %mi YMH
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mpadded{:width => "0"}
                          %mrow
                            %mo ≔
                            %mstyle{:displaystyle => "false"}
                              %mrow
                                %msub
                                  %mo ∫
                                  %mi B
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mo{:stretchy => "false"} ‖
                              %msub
                                %mi F
                                %mi A
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                              %mo +
                              %mo{:stretchy => "false"} ‖
                              %msub
                                %mi{:mathvariant => "normal"} d
                                %mi A
                              %mi Φ
                              %msup
                                %mo{:stretchy => "false"} ‖
                                %mn 2
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mi{:mathvariant => "normal"} d
                              %msub
                                %mo{:lspace => "0em", :rspace => "thinmathspace"} vol
                                %mi g
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  \\mathllap{
                  S_{YMH}
                  \\,\colon\,
                  }
                  \\Omega^1_{conn}(P;\mathfrak{g})
                  \\times
                  \\Gamma^\infty(Ad_P)
                  \&amp;\longrightarrow&amp;
                  \\mathbb{R}
                  \\\
                  \\big(A, \Phi\big)
                  \&amp;\mapsto&amp;
                  S_{YMH}(A,\Phi)
                  \\mathrlap{
                  \\coloneqq
                  \\textstyle{\int_B}
                  \\big(
                  \\|F_A\|^2
                  +
                  \\|\mathrm{d}_A\Phi\|^2
                  \\big)
                  \\mathrm{d}\vol_g
                  \\,.
                  }
                  \\end{array}
          %p
            (cf.
            = succeed ")" do
              %a{:href => "#Taubes82a"} Taubes 1982a, Equation (2.1)
          %h3#yangmillshiggs_equations_and_pairs Yang-Mills-Higgs equations and pairs
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            consisting of a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi conn
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ;
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A\in\Omega^1_{conn}(P;\mathfrak{g})
            and a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo ∈
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msub
                    %mi Ad
                    %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi\in\Gamma^\infty(B,Ad_P)
            is called a
            %em Yang-Mills-Higgs pair
            (or
            = succeed ")" do
              %em YMH pair
            %a.existingWikiWord{:href => "/nlab/show/critical+point"} critical point
            of the Yang-Mills-Higgs action functional
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:TheActionFunctional"} (1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi{:mathvariant => "normal"} d
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi t
                  %msub
                    %mi S
                    %mi YMH
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi φ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mi t
                      %mo =
                      %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\mathrm{d}}{\mathrm{d}t}
                  S_{YMH}\big(
                  \\alpha(t),
                  \\varphi(t)
                  \\big)\vert_{t=0}
                  \\;=\;
                  0
          %p for all pairs of smooth families
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mpadded{:lspace => "-100%width", :width => "0"}
                          %mrow
                            %mi α
                            %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ε
                        %mo ,
                        %mi ε
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mo ⟶
                      %mtd
                        %msubsup
                          %mi Ω
                          %mi conn
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ;
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mtr
                      %mtd
                        %mpadded{:lspace => "-100%width", :width => "0"}
                          %mrow
                            %mi φ
                            %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ε
                        %mo ,
                        %mi ε
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mo ⟶
                      %mtd
                        %msup
                          %mi Γ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Ad
                          %mi P
                        %mo{:stretchy => "false"} )
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  \\mathllap{
                  \\alpha\colon
                  }
                  (-\varepsilon, \varepsilon)
                  \&amp;
                  \\longrightarrow
                  \&amp;
                  \\Omega^1_{conn}(P;\mathfrak{g})
                  \\\
                  \\mathllap{
                  \\varphi\colon
                  }
                  (-\varepsilon,\varepsilon)
                  \&amp;
                  \\longrightarrow
                  \&amp;
                  \\Gamma^\infty(Ad_P)
                  \\mathrlap{\,,}
                  \\end{array}
          %p
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mi and
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \alpha(0)=A and \varphi(0)=\Phi
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ϵ
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} (-\epsilon, \epsilon) \subset \mathbb{R}
            denotes an
            %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
            around the origin of the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
          %p
            This is the case iff the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            are satisfies, here called the
            %em Yang-Mills-Higgs equations
            (or
            = succeed "):" do
              %em YMH equations
          #eq:YMHEquations.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %mo ⋆
                        %msub
                          %mi F
                          %mi A
                        %mo +
                        %mo ⋆
                        %mo{:stretchy => "false"} [
                        %mi Φ
                        %mo ,
                        %msub
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %mi Φ
                        %mo{:stretchy => "false"} ]
                      %mtd
                        %mo =
                      %mtd
                        %mn 0
                    %mtr
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %mo ⋆
                        %msub
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %mi Φ
                      %mtd
                        %mo =
                      %mtd
                        %mn 0
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  \\mathrm{d}_A \star F_A
                  +
                  \\star[\Phi,\mathrm{d}_A\Phi]
                  \&amp;=&amp;
                  0
                  \\\
                  \\mathrm{d}_A\star\mathrm{d}_A\Phi
                  \&amp;=&amp;
                  0
                  \\mathrlap{\,.}
                  \\end{array}
          %p
            (cf.
            = succeed "," do
              %a{:href => "#Taubes82a"} Taubes 1982a, Eq. (2.2a) and (2.2b)
            = succeed "," do
              %a{:href => "#Taubes84"} Taubes 1984, Eq. (1)
            = succeed "," do
              %a{:href => "#Taubes85"} Taubes 1985, Eq. (A.1.1a) and (A.1.1b)
            %a{:href => "#Taubes84"} Taubes 1984, Eq. (1)
            is missing the second
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            in the first
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills-Higgs+equation"} Yang-Mills-Higgs equation
            = succeed ")" do
              %a{:href => "#Naber11"} Naber 11, Eq. (2.5.12)
          %p
            Furthermore, the following
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            hold:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %msub
                          %mi F
                          %mi A
                      %mtd
                        %mo =
                      %mtd
                        %mn 0
                    %mtr
                      %mtd
                        %msub
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %msub
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %mi Φ
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi Φ
                        %mo ,
                        %msub
                          %mi F
                          %mi A
                        %mo{:stretchy => "false"} ]
                      %mtd
                        %mo =
                      %mtd
                        %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  \\mathrm{d}_A F_A
                  \&amp;=&amp;
                  0
                  \\\
                  \\mathrm{d}_A\mathrm{d}_A\Phi
                  +[\Phi,F_A]
                  \&amp;=&amp;
                  0
                  \\end{array}
          %p
            (cf.
            = succeed "," do
              %a{:href => "#Taubes82a"} Taubes 1982a, Eq. (2.2c) and (2.2d)
            = succeed ")" do
              %a{:href => "#Naber11"} Naber 11, Eq. (2.5.13)
          %p
            Using
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ⋆
                    %mn 2
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mi k
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \star^2=(-1)^{k(n-k)}
            (see
            = succeed ")" do
              %a{:href => "Hodge+star+operator#BasicProperties"} there
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi A
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 1
                  %mo ⋆
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \delta_A=(-1)^{n(k+1)+1}\star\mathrm{d}_A\star
            when applied to
            = succeed "-forms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.maruku-eqref{:href => "#eq:YMHEquations"} (2)
            is equivalent to:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi A
                  %msub
                    %mi F
                    %mi A
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi Φ
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mi Φ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta_A F_A
                  +
                  [\Phi,\mathrm{d}_A\Phi]
                  \\;=\;
                  0
                  \\mathrlap{\,.}
          %p and the second one to:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi A
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mi Φ
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mpadded{:width => "0"}
                    %mrow
                      %mo ,
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta_A\mathrm{d}_A\Phi
                  \\;=\;
                  0
                  \\mathrlap{,.}
          %p
          .num_remark
            %h6 Remark
            %p
              For an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structure+group"} structure group
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              is also abelian and hence all
              %a.existingWikiWord{:href => "/nlab/show/Lie+brackets"} Lie brackets
              vanish and the YMH equations
              %a.maruku-eqref{:href => "#eq:YMHEquations"} (2)
              reduce to:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mo ⋆
                          %mi{:mathvariant => "normal"} d
                          %mi A
                        %mtd
                          %mo =
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mo ⋆
                          %mi{:mathvariant => "normal"} d
                          %mi Φ
                        %mtd
                          %mo =
                        %mtd
                          %mn 0
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathrm{d}\star\mathrm{d}A
                    \&amp;=&amp;
                    0
                    \\\
                    \\mathrm{d}\star\mathrm{d}\Phi
                    \&amp;=&amp;
                    0
                    \\mathrlap{\,.}
                    \\end{array}
            %p
          %h2#properties Properties
          %h3#general General
          %p Essentially by definition:
          %p
          .num_lemma
            %h6 Lemma
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi conn
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ;
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\in\Omega^1_{conn}(P; \mathfrak{g})
              is a Yang-Mills connection (a solution of the plain
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi conn
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi Γ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Ad
                      %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,0)\in\Omega^1_{conn}(P)\times\Gamma^\infty(Ad_P)
              is a Yang-Mills-Higgs pair.
          %h3#relation_to_generalized_laplace_equation Relation to generalized Laplace equation
          %p Let:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi δ
                    %mi A
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mo +
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %msub
                    %mi δ
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Ad
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Ad
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Delta_A
                  \\;\coloneqq\;
                  \\delta_A\mathrm{d}_A
                  +
                  \\mathrm{d}_A\delta_A
                  \\;\colon\;
                  \\Omega^k(B,\operatorname{Ad}(E))
                  \\longrightarrow
                  \\Omega^k(B,\operatorname{Ad}(E))
          %p
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+Laplace+operator"} generalized Laplace operator
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %msub
                    %mi F
                    %mi A
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathrm{d}_A F_A=0
            and the first
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills-Higgs+equation"} Yang-Mills-Higgs equation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi A
                  %msub
                    %mi F
                    %mi A
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} [
                  %mi Φ
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %mi Φ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \delta_A F_A=-[\Phi,\mathrm{d}_A\Phi]
            combine to:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
