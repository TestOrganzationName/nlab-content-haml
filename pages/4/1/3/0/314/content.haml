                  \\,.
          %p
            An illustrative example is the following: a limit of the
            %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mi c
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} Id_c:C\to C
            is, if it exists, an
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#global_definition_in_terms_of_adjoint_of_the_constant_diagram_functor Global definition in terms of adjoint of the constant diagram functor
          %p
            Given categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} D^{op} \to C
            may exist for some functors, but not for all. If it does exist for all functors, then the above
            %em local definition
            of limits is equivalent to the following
            = succeed "." do
              %em global definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any category, the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi D
                    %mi op
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [D^{op},C]
            is the category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagrams
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                  %mo →
                  %mi pt
                %annotation{:encoding => "application/x-tex"} D^{op} \to pt
            to the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
            category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pt
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo •
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} pt = \{\bullet\}
            induces a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi const
                  %mo :
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi D
                    %mi op
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  const :  C \to [D^{op},C]
          %p
            which sends every object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the diagram functor constant on this object.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} left adjoint
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi colim
                    %mi D
                  %mo :
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi D
                    %mi op
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  colim_D : [D^{op},C] \to C
          %p
            of this functor is, if it exists, the functor which sends every diagram to its
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            and the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} right adjoint
            is, if it exists, the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lim
                    %mi D
                  %mo :
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi D
                    %mi op
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  lim_D : [D^{op},C] \to C
          %p
            which sends every diagram to its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunctions
            state precisely the universal property of
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            and
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            given above.
          %p
            Concretely this means that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            we have a bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi lim
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi D
                        %mi op
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi const
                    %mi c
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_C(c, \lim F)
                  \\simeq
                  Hom_{[D^{op},C]}(const_c, F)
                  \\,.
          %p
            From this perspective, a limit is a special case of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point"} point
          %h3#generalizations Generalizations
          %p
            The notion of limit, being fundamental to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %ul
            %li
              In
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
              one has the notion of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
            %li
              Weighted limits generalize further to the notion of limit in a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-category+equipped+with+proarrows"} 2-category equipped with proarrows
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+structure"} Yoneda structure
            %li
              In
              %a.existingWikiWord{:href => "/nlab/show/2-category+theory"} 2-category theory
              one has the notion of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
            %li
              Similarly, in
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-category
              theory there is a notion of a limit. Using quasicategories as a model for
              = succeed "-categories," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+a+quasi-category"} quasi-categorical terminal object
              in the quasicategory of cones. See
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limit+in+quasi-categories"} limit in quasi-categories
            %li
              One expects that similarly, all sorts of
              %a.existingWikiWord{:href => "/nlab/show/higher+categories"} higher categories
              have their own appropriate notions of limit and colimit.
          %h2#examples Examples
          %p The central point about examples of limits is:
          %p
            %em> Categorical limits are ubiquitous
            \.
          %p
            To a fair extent,
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            is all about limits and the other
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal constructions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extensions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functors
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functors
          %p
            Listing examples of limits in
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            is much like listing examples of
            %a.existingWikiWord{:href => "/nlab/show/integral"} integrals
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            for more).
          %p Keeping that in mind, we do list some special cases and special classes of examples that are useful to know. But any list is necessarily wildly incomplete.
          %h3#general General
          %ul
            %li
              For a pedagogical list of examples see
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} limits and colimits by example
          %p
            Here are some important examples of limits, classified by the shape of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          %ul
            %li
              A limit of the
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty diagram
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %li
              A limit of a diagram consisting of two (or more) objects and no nontrivial morphisms is their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
            %li
              A limit of a
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            %li
              A limit of a pair (or more) of
              %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            %li
              A limit over a
              %a.existingWikiWord{:href => "/nlab/show/finite+category"} finite category
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
            %li
              Another important “shape” of limits are those that give rise to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/end"} ends
            %li
              A limit of a diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : D \to C
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              admits an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(I)
          %h3#limits_in_analysis Limits in analysis
          %p
            The concept of
            %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit of a sequence
            in
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            is a special case of category theoretic limits, see
            = succeed "." do
              %a{:href => "limit+of+a+sequence#RelationToLimitsInCategoryTheory"} there
          %h2#properties Properties
          %h3#ConstructionFromProductsAndEqualizers Existence: construction from products and equalizers
          %p Frequently some limits can be computed in terms of other limits. This makes things easier since we only have to assume that categories have, or functors preserve, some easier-to-verify class of limits in order to obtain results about a larger one.
          %p
            The most common example of this is the computation of limits in terms of products and equalizers. Specifically, if the limit of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi D
                    %mi op
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : D^{op} \to C
            and the
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{d\in Obj(D)} F(d)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo ∈
                      %mi Mor
                      %mi d
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{f\in Mor{d}} F(s(f))
            all exist, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %mi F
                %annotation{:encoding => "application/x-tex"} lim F
            is a
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi d
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{d\in Obj(D)} F(d)
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                  %mi F
