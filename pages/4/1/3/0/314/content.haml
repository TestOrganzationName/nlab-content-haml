                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi j
