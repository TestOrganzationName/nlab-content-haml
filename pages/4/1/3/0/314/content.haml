                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} D'
              be
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a category which admits
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              as well as
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              of shape
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} D'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi D
                      %mi op
                    %mo ×
                    %msup
                      %mrow
                        %mi D
                        %mo ′
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : D^{op} \times {D'}^{op} \to C
              a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              , with corresponding induced functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi D
                    %mo :
                    %msup
                      %mrow
                        %mi D
                        %mo ′
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F_D : {D'}^{op} \to [D^{op},C]
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %mi D
                          %mo ′
                      %mo :
                      %msup
                        %mi D
                        %mi op
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msup
                        %mrow
                          %mi D
                          %mo ′
                        %mi op
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} F_{D'} : {D}^{op} \to [{D'}^{op},C]
            #eq:ComparisonMorphismForCommutingLimits.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                    %mi F
                    %mo ≃
                    %msub
                      %mi lim
                      %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi lim
                      %mrow
                        %mi D
                        %mo ′
                    %msub
                      %mi F
                      %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi lim
                      %mrow
                        %mi D
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi lim
                      %mi D
                    %msub
                      %mi F
                      %mrow
                        %mi D
                        %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    lim F \simeq lim_{D}  (lim_{D'} F_D )
                    \\simeq
                    lim_{D'}  (lim_{D} F_{D'} )
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_2 Proof
            %p
              Since the
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              functor to the
              %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant
              = succeed "-functor," do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              %em
                %a.existingWikiWord{:href => "/nlab/show/right+adjoints+preserve+limits"} right adjoints preserve limits
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#RightAdjointsPreserveLimits"}
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} limits and colimits by example
            for what formula
            %a.maruku-eqref{:href => "#eq:ComparisonMorphismForCommutingLimits"} (1)
            says for instance for the special case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          .num_remark
            %h6#remark Remark
            %p
              %strong (general non-commutativity of limits with colimits)
            %p
              In general limits do
              %em not
              commute with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/commutativity+of+limits+and+colimits"} commutativity of limits and colimits
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %strong limit
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/internal+limit"} internal limit
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/colimit"}> colimit
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/universal+construction"} universal construction
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/end"} end
                    %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/lim%5E1+and+Milnor+sequences"} lim^1 and Milnor sequences
          %h2#references References
          %p
            Limits and
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            were defined in
            %a.existingWikiWord{:href => "/nlab/show/Daniel+M.+Kan"} Daniel M. Kan
            in Chapter II of the paper that also defined
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extensions"} Kan extensions
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Daniel+M.+Kan"}> Daniel M. Kan
              ,
              = succeed "," do
                %em Adjoint functors
              = succeed ")" do
                %a{:href => "https://doi.org/10.1090/s0002-9947-1958-0131451-0"} doi:10.1090/s0002-9947-1958-0131451-0
          %p
            This paper refers to limits as
            = succeed "." do
              %em inverse limits
          %p
            The observation that limits can be constructed from
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            and
            %a.existingWikiWord{:href => "/nlab/show/equalisers"} equalisers
            is due to:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J.-M.+Maranda"}> J.-M. Maranda
              ,
              = succeed "." do
                %em Some remarks on limits in categories
              %strong 5
              2 (1962) 133-146 &amp;lbrack;
              %a{:href => "https://doi.org/10.4153/CMB-1962-015-0"}> doi:10.4153/CMB-1962-015-0
              \&amp;rbrack;
          %p
            That, more generally, it suffices to consider only equalisers of
            %a.existingWikiWord{:href => "/nlab/show/reflexive+pairs"} reflexive pairs
            is due to:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ernest+Manes"}> Ernest Manes
                ,
                = succeed "," do
                  %em A triple miscellany: Some aspects of the theory of algebra over a triple
                = succeed "&rbrack;" do
                  %a{:href => "https://github.com/CategoryTheoryArchive/archive/blob/main/resources/1967_manes_triple-miscellany.pdf"} pdf
            %li
              %p
                S. A. Huq and R. Cornu.
                = succeed "." do
                  %em A remark on the existence of limits in categories
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1002/mana.19730550111"} doi:10.1002/mana.19730550111
          %p Textbook accounts:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              , §III.4 of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Categories+for+the+Working+Mathematician"} Categories for the Working Mathematician
              %strong 5
              Springer (second ed. 1997) &amp;lbrack;
              %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-4721-8"}> doi:10.1007/978-1-4757-4721-8
              \&amp;rbrack;
