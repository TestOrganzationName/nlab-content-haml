              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \times_G V\to X
              is equivalently (regarded as a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
