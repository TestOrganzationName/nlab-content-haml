              of the
              = succeed "-projection" do
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo ⫽
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} p_\rho \colon V \sslash G \to \mathbf{B}G
