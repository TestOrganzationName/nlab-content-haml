          %h2#definition Definition
          %p
            A
            %em cyclic group
            is a
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            of the additive group of
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            (hence of the
            %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
            on the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
          %p
            Generally one considers cyclic groups as abstract
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            %em
              %a{:href => "#Ring"} Ring structure
            below.
          %h2#Examples Examples
          %p
            There is (up to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} /
                  %mspace{:width => "negativethinmathspace"}
                  %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}\!/\!n
                  \\,\coloneqq\,
                  \\mathbb{Z}/n\mathbb{Z}
          %p
            for every
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            by the (necessarily
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mi ℤ
                  %mo ↪
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} n \mathbb{Z} \hookrightarrow \mathbb{Z}
            of integers divisible by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n = 0
            this subgroup is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            itself
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} /
                  %mspace{:width => "negativethinmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ≃
                  %mspace{:width => "thinmathspace"}
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}\!/\!0 \,\simeq\, \mathbb{Z}
                  \\,,
          %p
            as such also called the
            = succeed "," do
              %em infinite cyclic group
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            is
            %a.existingWikiWord{:href => "/nlab/show/countable+set"} countably
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinite+set"} infinite
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            (
            %a.existingWikiWord{:href => "/nlab/show/cardinality"}> cardinality
            ) of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} /
                  %mspace{:width => "negativethinmathspace"}
                  %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}\!/\!n
            is the
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ord
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ℤ
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} /
                  %mspace{:width => "negativethinmathspace"}
                  %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi card
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ℤ
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} /
                  %mspace{:width => "negativethinmathspace"}
                  %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ord\big(
                  \\mathbb{Z}\!/\!n
                  \\big)
                  \\;=\;
                  card\big(
                  \\mathbb{Z}\!/\!n
                  \\big)
                  \\;=\;
                  n
                  \\,.
          %p Explicitly this means that
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/elements"} elements
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\!/\!n
                are
                %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [k]
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                is “
                %a.existingWikiWord{:href => "/nlab/show/modulo"} modulo
                = succeed "\u201D:" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo ′
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi ℤ
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                      %mi n
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⇔
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ∃
                        %mrow
                          %mi r
                          %mo ∈
                          %mi ℤ
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi k
                      %mo ′
                      %mo =
                      %mi k
                      %mo +
                      %mi r
                      %mo ⋅
                      %mi n
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [k] = [k']
                      \\;\;\;
                      \\in
                      \\;
                      \\mathbb{Z}\!/\!n
                      \\;\;\;\;\;\;\;\;\;
                      \\Leftrightarrow
                      \\;\;\;\;\;\;\;\;\;
                      \\underset{r \in \mathbb{Z}}{\exists}
                      \\big(
                      k ' = k + r \cdot n
                      \\big)
                      \\,.
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/binary+operation"} binary operation
                in the group is
                %a.existingWikiWord{:href => "/nlab/show/addition"} addition
                of representatives
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                              %mspace{:width => "negativethinmathspace"}
                              %mo{:stretchy => "false"} /
                              %mspace{:width => "negativethinmathspace"}
                              %mi n
                              %mo ×
                              %mi ℤ
                              %mspace{:width => "negativethinmathspace"}
                              %mo{:stretchy => "false"} /
                              %mspace{:width => "negativethinmathspace"}
                              %mi n
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi ℤ
                              %mspace{:width => "negativethinmathspace"}
                              %mo{:stretchy => "false"} /
                              %mspace{:width => "negativethinmathspace"}
                              %mi n
                          %mtr
                            %mtd
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi k
                                %mn 1
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi k
                                %mn 2
                              %mo{:stretchy => "false"} ]
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi k
                                %mn 1
                              %mo +
                              %msub
                                %mi k
                                %mn 2
                              %mo{:stretchy => "false"} ]
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbb{Z}\!/\!n \times \mathbb{Z}\!/\!n
                      \&amp;\longrightarrow&amp;
                      \\mathbb{Z}\!/\!n
                      \\\
                      \\big( [k_1], \, [k_2] \big)
                      \&amp;\mapsto&amp;
                      [k_1 + k_2]
                      \\,.
                      }
          %p
            The cyclic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} /
                  %mspace{:width => "negativethinmathspace"}
                  %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}\!/\!n
            of order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            may also be identified with a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of the multiplicative
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mo ×
                  %mo ↪
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times \hookrightarrow \mathbb{C}
            of
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            (or
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+numbers"} algebraic numbers
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/roots+of+unity"} roots of unity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ℤ
                          %mspace{:width => "negativethinmathspace"}
                          %mo{:stretchy => "false"} /
                          %mspace{:width => "negativethinmathspace"}
                          %mi n
                        %mtd
                          %mover
                            %mo ↪
                            %mphantom
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %msup
                            %mi ℂ
                            %mo ×
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↦
                        %mtd
                          %mi exp
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mn 2
                          %mi π
                          %mi{:mathvariant => "normal"} i
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi k
                              %mi n
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbb{Z}\!/\!n
                  \&amp;\xhookrightarrow{\phantom{---}}&amp;
                  \\mathbb{C}^\times
                  \\\
                  [k] &amp;\mapsto&amp; \exp\big(2 \pi \mathrm{i} \tfrac{k}{n}\big)
                  \\mathrlap{\,.}
                  }
          %p Dedicated entries exist for the examples of the
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+3"} cyclic group of order 3
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+4"} cyclic group of order 4
          %h2#Notation Notation
          %p Some alternative notations for the finite cyclic groups are in use. Many authors use subscript notation
          %ul
            %li
              “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n
              ” for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                      %mi n
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\!/\! n \mathbb{Z}
          %p
            However, at least for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mi p
                %annotation{:encoding => "application/x-tex"} n = p
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                \-adic integers
          %p
            Therefore, in fields where both
            %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            as well as
            %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
            play an important role (such as in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/cyclotomic+spectra"} cyclotomic spectra
          %ul
            %li
              “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_n
              ” for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                      %mi n
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\!/\! n \mathbb{Z}
          %p
            Here “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            ” is, of course, for “cyclic”. Other authors may keep the letter “Z” with a subscript but resort to another font, such as
          %ul
            %li
              “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Z_n
              ” for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                      %mi n
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}\!/\! n \mathbb{Z}
          %p
            Often this last notation is meant to indicate that not just the group but the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            inherited from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is referred to, see
            %a{:href => "#Ring"} below
            (which of course makes the possible confusion with notation for the
            %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
            only worse).
          %p
            Incidentally, while the notation “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            ” for the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            derives from the German word
            %em Zahl
            (for
            = succeed ")," do
              %em number
            %em zyklisch
            (for
            = succeed ")." do
              %em cyclic
          %h2#properties Properties
          %h3#Ring Ring structure
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a cyclic group, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            be a generator of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (making the original group the additive group of the ring) such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is the multiplicative identity
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            If we identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with the additive group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n
            and pick (the equivalence class of) the integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n
          %p
            In this way, a cyclic group equipped with the
            %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            of a generator is the same thing (in the sense that their
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            are
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            %a.existingWikiWord{:href => "/nlab/show/extra+property"} extra property
            that the underlying additive group is cyclic.
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(n)
            %span.newWikiWord
              Euler totient
              %a{:href => "/nlab/new/totient+function"} ?
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            that are
            %a.existingWikiWord{:href => "/nlab/show/relatively+prime+numbers"} relatively prime
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi(1) = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \phi(n) \gt 1
            (another way to see that we have a structure and not just a property). For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            itself, there are two ring structures, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            are the generators (and these are relatively prime to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p \lineabreak
          %h3#FundamentalTheoremOfCyclicGroups Fundamental theorem of cyclic groups
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of the cyclic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{N}
            of
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
            for each factor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo{:stretchy => "false"} /
                    %mi d
                    %mo ∈
                    %mi ℤ
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n/d \in \mathbb{Z} \to \mathbb{Z}/n\mathbb{Z}
          %p
            Moreover, the
            %a.existingWikiWord{:href => "/nlab/show/lattice+of+subgroups"} lattice of subgroups
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
            is equivalently the dual of the lattice of natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                  %mi n
                %annotation{:encoding => "application/x-tex"} \leq n
            ordered by divisibility.
          %p
            (e.g
            = succeed ")" do
              %a{:href => "#Aluffi09"} Aluffi 09, pages 83-84
          %p
            This is a special case of the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+finitely+generated+abelian+groups"} fundamental theorem of finitely generated abelian groups
          %h3#relation_to_finite_abelian_groups Relation to finite abelian groups
          .num_prop
            %h6#proposition Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/finite+abelian+group"} finite abelian group
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+abelian+groups"} direct sum of abelian groups
              over cyclic groups.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/finite+abelian+group"} finite abelian group
            for details.
          %h3#group_cohomology Group cohomology
          %p
            For discussion of the
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            of cyclic groups see
          %ul
            %li
              %p
                at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
                the section
                %em
                  %a{:href => "http://ncatlab.org/nlab/show/projective+resolution#CohomologyOfCyclicGroups"} Cohomology of cyclic groups
            %li
              %p
                at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/finite+rotation+group"} finite rotation group
                the section
                %em
                  %a{:href => "finite+rotation+group#GroupCohomology"} Group cohomology
            %li
              %p
                in
                %a{:href => "#GolasińskiGonçalves11"} Golasiński &amp; Gonçalves 2011
                for the cases
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi Grp
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} /
                      %mi mathbb
                      %mi Z
                      %mo{:stretchy => "false"} /
                      %mi n
                      %mo ;
                      %mspace{:width => "thinmathspace"}
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^n_{Grp}(/mathbb{Z}/n;\, \mathbb{Z}/m)
          %p
            For example, relevant for
            %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theory"} Dijkgraaf-Witten theory
            is the fact:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi grp
                    %mn 3
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^3_{grp}\big(\mathbb{Z}/n\mathbb{Z}, U(1)\big)
                  \\;\simeq\;
                  \\mathbb{Z}/n\mathbb{Z}
                  \\,.
          %h3#linear_representations Linear representations
          %p
            We discuss some of the
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            of cyclic groups.
          #IrreducibleRealRepresentationsOfCyclicGroups.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
                %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n \geq 2
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
              of the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n
              are given by precisely the following:
            %ol
              %li
                %p
                  the 1-
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
                  %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbf{1}
              %li
                %p
                  the 1-
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
                  %a.existingWikiWord{:href => "/nlab/show/sign+representation"} sign representation
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mn 1
                            %mi sgn
                        %annotation{:encoding => "application/x-tex"} \mathbf{1}_{sgn}
              %li
                %p
                  the 2-
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
                  standard representations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mn 2
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \mathbf{2}_k
                  of
                  %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+plane"} Euclidean plane
                  by
                  %a.existingWikiWord{:href => "/nlab/show/angles"} angles
                  that are
                  %a.existingWikiWord{:href => "/nlab/show/integer"} integer
                  multiples of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mi π
                          %mi k
                          %mo{:stretchy => "false"} /
                          %mi n
                        %annotation{:encoding => "application/x-tex"} 2 \pi k/n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 0
                          %mo &lt;
                          %mi k
                          %mo &lt;
                          %mi n
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} 0 \lt k \lt n/2
                %p
                  hence the
                  %a.existingWikiWord{:href => "/nlab/show/restricted+representations"} restricted representations
                  of the defining real rep of
                  %a.existingWikiWord{:href => "/nlab/show/SO%282%29"} SO(2)
                  under the
                  %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                  inclusions
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi n
                          %mo ↪
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n \hookrightarrow SO(2)
                  %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2 \times 2
                  %a.existingWikiWord{:href => "/nlab/show/trigonometric+function"} trigonometric
                  %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mn 2
                              %mi k
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi cos
                                  %mo{:stretchy => "false"} (
                                  %mi θ
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi sin
                                  %mo{:stretchy => "false"} (
                                  %mi θ
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                  %mi sin
                                  %mo{:stretchy => "false"} (
                                  %mi θ
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mphantom
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi cos
                                  %mo{:stretchy => "false"} (
                                  %mi θ
                                  %mo{:stretchy => "false"} )
                          %mo )
                        %mphantom
                          %mi AA
                        %mtext with
                        %mspace{:width => "thickmathspace"}
                        %mi θ
                        %mo =
                        %mn 2
                        %mi π
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi k
                            %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{\mathbf{2}_k}(1)
                        \\;=\;
                        \\left(
                        \\array{
                        cos(\theta) &amp; -sin(\theta)
                        \\\
                        sin(\theta) &amp; \phantom{-}cos(\theta)
                        }
                        \\right)
                        \\phantom{AA}
                        \\text{with}
                        \\;
                        \\theta = 2 \pi \tfrac{k}{n}
                        \\,,
            %p
              (For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi n
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k = n/2
              the corresponding 2d representation is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of two copies of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sign+representation"} sign representation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mo ≃
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mi sgn
                      %mo ⊕
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mi sgn
                    %annotation{:encoding => "application/x-tex"} \mathbf{2}_{n/2} \simeq \mathbf{1}_{sgn} \oplus \mathbf{1}_{sgn}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/irrep"} irreducible
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &gt;
                    %mi n
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k \gt n/2
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}_{k}
              is irreducible, but
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo ≃
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbf{2}_{n-k} \simeq \mathbf{2}_{-k}
            %p In summary:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Rep
                      %mi ℝ
                      %mi irr
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mi sgn
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mo &lt;
                    %mi k
                    %mo &lt;
                    %mi n
                    %mo{:stretchy => "false"} /
                    %mn 2
