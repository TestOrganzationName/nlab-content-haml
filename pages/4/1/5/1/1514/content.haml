                    %mi I
                  %mo{:stretchy => "false"} ⟩
                  %mo .
                %annotation{:encoding => "application/x-tex"} \langle \psi_F|e^{-iHt}|\psi_I\rangle.
          %p
            Chop this up into time steps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi t
                  %mo =
                  %mi t
                  %mo{:stretchy => "false"} /
                  %mi N
                %annotation{:encoding => "application/x-tex"} \Delta t = t/N
            and use the fact that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
