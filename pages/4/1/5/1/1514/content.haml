                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mi Δ
                              %mi t
                              %msup
                                %mo{:stretchy => "false"} ]
                                %mn 2
                          %mo .
                %annotation{:encoding => "application/x-tex"} \array{\langle q_{n+1}| e^{-iH\Delta t} \left(\int_{-\infty}^{\infty} \frac{dp}{2\pi}|p\rangle \langle p|\right)|q_{n} \rangle &amp;=&amp; \int_{-\infty}^{\infty} \frac{dp}{2\pi} e^{-ip^2\Delta t/2m} \langle q_{n+1}|p\rangle \langle p|q_{n} \rangle \\ &amp;=&amp; \int_{-\infty}^{\infty} \frac{dp}{2\pi} e^{-ip^2\Delta t/2m} e^{ip(q_{n+1}-q_n)} \\ &amp;=&amp; \left(\frac{-i 2\pi m}{\Delta t}\right)^{\frac{1}{2}} e^{i \Delta t (m/2)[(q_{n+1}-q_n)/\Delta t]^2}.}
          %p Defining
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi Dq
                  %mo =
                  %munder
                    %mi lim
                    %mrow
                      %mi N
                      %mo →
                      %mn ∞
                  %msup
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi i
                          %mn 2
                          %mi π
                          %mi m
                        %mrow
                          %mi Δ
                          %mi t
                      %mo )
                    %mfrac
                      %mi N
                      %mn 2
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mrow
                      %mi N
                      %mo −
                      %mn 1
                  %mo ∫
                  %msub
                    %mi dq
                    %mi n
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int Dq = \lim_{N \to \infty} \left(\frac{-i 2\pi m}{\Delta t}\right)^{\frac{N}{2}} \prod_{n=0}^{N-1} \int dq_n,
          %p
            and letting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi t
                  %mo →
                  %mn 0
                  %mo ,
                  %mi N
                  %mo →
                  %mn ∞
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \Delta t \to 0, N \to \infty,
            we get
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi ψ
                    %mi F
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi iHt
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi ψ
                    %mi I
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo ∫
                  %mi Dq
                  %msup
                    %mi e
                    %mrow
                      %mi i
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mi t
                      %mi dt
                      %mfrac
                        %mn 1
                        %mn 2
                      %mi m
                      %msup
                        %mover
                          %mi q
                          %mo ˙
                        %mn 2
                  %mo .
                %annotation{:encoding => "application/x-tex"} \langle \psi_F|e^{-iHt}|\psi_I\rangle = \int Dq e^{i \int_0^t dt \frac{1}{2}m \dot{q}^2}.
          %p
            For arbitrary Hamiltonians
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mfrac
                    %mrow
                      %msup
                        %mi p
                        %mn 2
                    %mrow
                      %mn 2
                      %mi m
                  %mo +
                  %mi V
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} H = \frac{p^2}{2m} + V(x),
            we get
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi ψ
                            %mi F
                          %mo{:stretchy => "false"} |
                          %msup
                            %mi e
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi iHt
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi ψ
                            %mi I
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mo =
                        %mtd
                          %mo ∫
                          %mi Dq
                          %msup
                            %mi e
                            %mrow
                              %mi i
                              %msubsup
                                %mo ∫
                                %mn 0
                                %mi t
                              %mi dt
                              %mfrac
                                %mn 1
                                %mn 2
                              %mi m
                              %msup
                                %mover
                                  %mi q
                                  %mo ˙
                                %mn 2
                              %mo −
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mo ∫
                          %mi Dq
                          %msup
                            %mi e
                            %mrow
                              %mi i
                              %msubsup
                                %mo ∫
                                %mn 0
                                %mi t
                              %mi ℒ
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi q
                                %mo ˙
                              %mo ,
                              %mi q
                              %mo{:stretchy => "false"} )
                              %mi dt
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mo ∫
                          %mi Dq
                          %msup
                            %mi e
                            %mrow
                              %mi iS
                              %mo{:stretchy => "false"} (
                              %mi q
                              %mo{:stretchy => "false"} )
                          %mo ,
                %annotation{:encoding => "application/x-tex"} \array{\langle \psi_F|e^{-iHt}|\psi_I\rangle &amp;=&amp; \int Dq e^{i \int_0^t dt \frac{1}{2}m \dot{q}^2 - V(x)} \\ &amp;=&amp; \int Dq e^{i\int_0^t\mathcal{L}(\dot{q},q) dt} \\ &amp;=&amp; \int Dq e^{iS(q)}, }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(q)
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          %h3#AsAnIntegralAgainstTheWienerMeasure As an integral against the Wiener measure
          %p
            More abstractly, the Euclidean path integral for the
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            of a
            %a.existingWikiWord{:href => "/nlab/show/charged+particle"} charged particle
            may be defined by
            %a.existingWikiWord{:href => "/nlab/show/integration"} integration
            of the gauge-coupling action against the
            %a.existingWikiWord{:href => "/nlab/show/Wiener+measure"} Wiener measure
            on the space of paths.
          %p
            Consider a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            – hence a
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            – and a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla : X \to \mathbf{B}U(1)_{conn}
            – hence an
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
          %p
            The gauge-coupling
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            term is given by the
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            of this connection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi i
                  %msub
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %msub
                        %mi x
                        %mn 1
                  %mo →
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                  %mo ,
                  %msub
                    %mi E
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S)
                  \\coloneqq
                  \\exp(2\pi i \int_{(-)} [(-),\nabla] )
                  \\colon
                  [I, X]_{x_0,x_1} \to Hom(E_{x_0}, E_{x_1})
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            is the
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
            which is
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Wiener+measure"} Wiener measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi μ
                    %mi W
                %annotation{:encoding => "application/x-tex"} d\mu_W
            on the space of stochastic paths in
            = succeed ",we" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi μ
                    %mi W
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi S
                    %mi kin
                  %mo{:stretchy => "false"} )
                  %mi D
                  %mi γ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  d\mu_W = [\exp(-S_{kin})D\gamma]
          %p
            for it combines what in the physics literature is the
            %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic action
            and a canonical measure on paths.
          %p
            (This is a general phenomenon in formalizations of the process of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic action
            (the
            = succeed "-part" do
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            against with the remaining
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            terms are integrated. )
          %p
            Then one has (e.g.
            = succeed "," do
              %a{:href => "#Norris"} Norris92, theorem (34)
            = succeed "):" do
              %a{:href => "#Charles99"} Charles 99, theorem 6.1
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
            for the time evolution propagator is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi γ
                  %mi tra
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi S
                    %mi kin
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi D
                  %mi γ
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  U(x_0,x_1) = \int_{\gamma} tra(\nabla)(\gamma) \, [\exp(-S_{kin}(\gamma)) D\gamma]
                  \\,,
          %p
            hence the
            %a.existingWikiWord{:href => "/nlab/show/integration"} integration
            of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            against the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Wiener+measure"} Wiener measure
          %p
            (To make sense of this one first needs to extend the
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            from smooth paths to stochastic paths, see the references
            = succeed ".)" do
              %a{:href => "#ReferencesForChargedParticle"} below
          #WorldlineFormalism.num_remark
            %h6#remark Remark
            %p
              This “holonomy integrated against the Wiener measure” is the path integral in the form in which it notably appears in the
              %em
                %a.existingWikiWord{:href => "/nlab/show/worldline+formalism"} worldline formalism
              for computing
              %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              = succeed ")." do
                %a{:href => "#Strassler92"} Strassler 92, (2.9), (2.10)
              %a.existingWikiWord{:href => "/nlab/show/Wick+rotation"} Wick rotated
              form: the
              %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic action
              is not a
              %a.existingWikiWord{:href => "/nlab/show/complex+phase"} complex phase
              but a real exponential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi S
                      %mi kin
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(- S_{kin})
              while the
              %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              term (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %msub
                        %mo ∫
                        %mi γ
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(i \int_\gamma A)
          .num_remark
            %h6#remark_2 Remark
            %p
              From the point of view of
              %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+field+theory"} higher prequantum field theory
              this means that the path integral sends a
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"} slice (infinity,1)-topos
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"} smooth infinity-groupoids
              over the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi I
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mn 0
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mn 1
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %msub
                              %mo ⇙
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi S
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi χ
                                  %mo{:stretchy => "false"} (
                                  %mo ∇
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi χ
                                  %mo{:stretchy => "false"} (
                                  %mo ∇
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; [I,X]
                    \\\
