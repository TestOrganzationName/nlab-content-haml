                              %mo (
                              %mfrac
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi i
                                  %mn 2
                                  %mi π
                                  %mi m
                                %mrow
                                  %mi Δ
                                  %mi t
                              %mo )
                            %mfrac
                              %mn 1
                              %mn 2
                          %msup
                            %mi e
                            %mrow
                              %mi i
                              %mi Δ
                              %mi t
                              %mo{:stretchy => "false"} (
                              %mi m
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi q
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                              %mo −
