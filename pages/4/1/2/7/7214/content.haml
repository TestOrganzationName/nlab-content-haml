                is
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equvialent
                to the
                %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
                of
                %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
                regarded as
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                of the
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
                of
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
