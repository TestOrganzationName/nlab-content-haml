          %div
            %p
            #TopologicalHomotopyTypeIsCohesiveShapeOfCdfflg.num_prop
              %h6 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
