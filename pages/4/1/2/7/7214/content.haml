            %p
              (e.g.
              = succeed ")" do
                %a{:href => "diffeological+space#ChristensenWu13"} Christensen-Wu 13, Def. 4.3
            #DiffeologicalSingularSetIsPathGroupoid.num_remark
              %h6#remark Remark
              %p
                %strong
                  (diffeological singular simplicial set as
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
              %p
                Regarding
