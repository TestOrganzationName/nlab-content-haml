                    %a.existingWikiWord{:href => "/nlab/show/continuous+diffeology"} continuous diffeology
                %br/
                For every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                    %annotation{:encoding => "application/x-tex"} X \in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/TopologicalSpaces"} TopologicalSpaces
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+shape"} cohesive shape
                %a.existingWikiWord{:href => "/nlab/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
                presented by its
                %em diffeological singular simplicial set
                (Def.
                = succeed "," do
                  %a.maruku-ref{:href => "#DiffeologicalSingularSimplicialSet"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#DiffeologicalSingularSetIsPathGroupoid"}
                %a.existingWikiWord{:href => "/nlab/show/continuous+diffeology"} continuous diffeology
                is
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturally
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thinmathspace"}
                    %annotation{:encoding => "application/x-tex"} \,
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalent
                to the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                presented by the ordinary
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+set"} singular simplicial set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sing
                        %mi diff
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi Cdfflg
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %munderover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi{:mathvariant => "normal"} W
                            %mi wh
                        %mrow
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sing_{diff}
                      \\big(
                      Cdfflg(X)
                      \\big)
                      \\underoverset
                      { \in \mathrm{W}_{wh} }
                      {}
                      {\longrightarrow}
                      Sing(X)
                      \\,.
              %p
            %p
              (
              %a{:href => "diffeological+space#ChristensenWu13"}> Christensen &amp; Wu 2013, Prop. 4.14
              )
          %h3#ModelCategoryStructure Model category structure
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+Delta-generated+topological+spaces"}> model structure on Delta-generated topological spaces
                )
              %br/
              The category of
              = succeed "-generated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
              of a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              with the same generating (acyclic) cofibrations as for the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              and such that the
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflection
              into all
              %a.existingWikiWord{:href => "/nlab/show/Top"} TopologicalSpaces
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjunctionBetweenTopologicalSpacesAndDiffeologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
          %p
            (
            %a{:href => "#Haraguchi13"}> Haraguchi 13, Theorem 3.3
            )
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            factors through the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+compactly+generated+topological+spaces"} model structure on compactly generated topological spaces
            (e.g.
            = succeed "):" do
              %a{:href => "#Gaucher07"} Gaucher 2007, p. 7
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi Qu
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ≃
                        %mpadded{:width => "0"}
                          %mi Qu
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟶
                      %mi k
                    %mo ↩
                  %mi k
                  %msub
                    %mi Top
                    %mi Qu
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ≃
                        %mpadded{:width => "0"}
                          %mi Qu
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟶
                      %mi D
                    %mo ↩
                  %mi D
                  %msub
                    %mi Top
                    %mi Qu
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Top_{Qu}
                  \\underoverset
                  { \underset{ k }{\longrightarrow} }
                  { {\hookleftarrow} }
                  { \;\;\;\;\;\;\simeq_{\mathrlap{Qu}}\;\;\;\;\;\; }
                  k Top_{Qu}
                  \\underoverset
                  { \underset{ D }{\longrightarrow} }
                  { {\hookleftarrow} }
                  { \;\;\;\;\;\;\simeq_{\mathrlap{Qu}}\;\;\;\;\;\; }
                  D Top_{Qu}
                  \\,.
          %h3#AsAConvenientCategoryOfTopologicalSpaces As a convenient category of topological spaces
          %p
          #CartesianClosure.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/D-topological+spaces"} D-topological spaces
              = succeed "-generated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              = succeed ")" do
                %a.maruku-ref{:href => "#DeltaGeneratedSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+closed+category"} Cartesian closed category
            %p
              Explicitly, the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi DTop
                  %annotation{:encoding => "application/x-tex"} Maps_{DTop}
              is, equivalently:
            %ul
              %li
                %p
                  the image under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cdfflg
                      %annotation{:encoding => "application/x-tex"} Cdfflg
                  %a.maruku-eqref{:href => "#eq:DeltaGeneratedSpacesInIdempotentAdjunction"} (2)
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Maps
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Maps_{Top}(X,Y)
                  with the
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Maps
                          %mi DTop
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Cdfflg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi Maps
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Maps_{DTop}(X,Y)
                        \\;\simeq\;
                        Cdfflg
                        \\big(
                        Maps_{Top}
                        (
                        X
                        ,\,
                        Y
                        )
                        \\big)
                        \\,,
              %li
                %p
                  the image under
                  %a.existingWikiWord{:href => "/nlab/show/D-topology"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Dtplg
                        %annotation{:encoding => "application/x-tex"} Dtplg
                  %a.maruku-eqref{:href => "#eq:AdjointFunctorsBetweenTopSpAndDifflgSp"} (1)
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Maps
                          %mi Dfflg
                      %annotation{:encoding => "application/x-tex"} Maps_{Dfflg}
                  formed in
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Maps
                          %mi DTop
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Dtplg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi Maps
                          %mi Dfflg
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Maps_{DTop}(X,Y)
                        \\;\simeq\;
                        Dtplg
                        \\big(
                        Maps_{Dfflg}
                        (
                        X
                        ,\,
                        Y
                        )
                        \\big)
                        \\,.
            %p
          .proof
            %h6 Proof
            %p
              The first statement is a special case of
              = succeed "," do
                %a{:href => "#Vogt71"} Vogt 1971, Thm. 3.6
              = succeed "." do
                %a{:href => "#Gaucher07"} Gaucher 2007, Sec. 2
              %a{:href => "convenient+category+of+topological+spaces#EscardoLawsonSimpson04"} Escardo, Lawson &amp; Simpson 2004
              (where “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Cdfflgcl
                  %annotation{:encoding => "application/x-tex"} Cdfflgcl
              ” is denoted “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(-)
              ” on p. 6, “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} Maps_{Top}
              ” is denoted “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %msub
                      %mo ⇒
                      %mrow
                        %msub
                          %mo ≪
                          %mi 𝒞
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X \Rightarrow_{\ll_{\mathcal{C}}} Y]
              ” in Rem. 5.20, “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi DTop
                  %annotation{:encoding => "application/x-tex"} Maps_{DTop}
              ” is denoted “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %msub
                      %mo ⇒
                      %mi 𝒞
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi 𝒞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Map
                      %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} [X \Rightarrow_{\mathcal{C}} Y] = \mathcal{C}\big(Map_{\mathcal{C}}[X,Y]\big)
              ” on bottom of p. 14, where “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi Map
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Map_{\mathcal{C}}
              ” is defined in Lemma 3.8, and finally the statement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Map
                      %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi X
                    %msub
                      %mo ⇒
                      %mrow
                        %msub
                          %mo ≪
                          %mi 𝒞
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Map_{\mathcal{C}}[X,Y] = [X \Rightarrow_{\ll_{\mathcal{C}}} Y]
              is Prop. 5.21 on p. 21). The second statement is the image of
              %a{:href => "#SYH10"} SYH 10, Prop. 4.7
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dtplg
                  %annotation{:encoding => "application/x-tex"} Dtplg
              (using that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                      %mo =
                      %mi T
                      %mo ∘
                      %mi D
                    %annotation{:encoding => "application/x-tex"} \nu = T \circ D
          %p
            In fact,
            %a{:href => "#SYH10"} SYH 10, Prop. 4.7
            state something stronger, topologically characterizing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Maps
                    %mi Dfflg
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Maps_{Dfflg}(X,Y)
            even before applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Dtplg
                %annotation{:encoding => "application/x-tex"} Dtplg
            to it. This stronger statement has a nice form when specialized to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
          %p
          #CWComplexesAreDTopologicalSpaces.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean-generated+spaces"} Euclidean-generated spaces
              = succeed "-generated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              = succeed ")" do
                %a.maruku-ref{:href => "#DeltaGeneratedSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              %br/
          (
          %a{:href => "#SYH10"}> SYH 10, Cor. 4.4
          )
          %p
          #DiffeologicalMapsOutOfCWComplexes.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                out of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              %br/
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DTopSp
                  %annotation{:encoding => "application/x-tex"} DTopSp
              via Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CWComplexesAreDTopologicalSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi DTopSp
                  %annotation{:encoding => "application/x-tex"} A \,\in\, DTopSp
              their
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              formed in
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cdffl
                  %annotation{:encoding => "application/x-tex"} Cdffl
              %a.maruku-eqref{:href => "#eq:AdjointFunctorsBetweenTopSpAndDifflgSp"} (1)
              of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} Maps_{Top}
              with its
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/compact+open+topology"} compact open topology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi CWComplex
                    %mo ↪
                    %mi DTopSp
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∀
                      %mrow
                        %mi A
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi DTopSp
                    %msub
                      %mi Maps
                      %mi Dfflg
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mi Cdfflg
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Maps
                      %mi Top
                    %mrow
                      %mo (
                      %mi X
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \,\in\, CWComplex \hookrightarrow DTopSp
                    \\;\;\;\;\;\;
                    \\Rightarrow
                    \\;\;\;\;\;\;
                    \\underset{
                    A \,\in\, DTopSp
                    }{\forall}
                    Maps_{Dfflg}
                    \\big(
                    X
                    ,\,
                    A
                    \\big)
                    \\;\;
                    \\simeq
                    Cdfflg
                    \\,
                    Maps_{Top}
                    \\left(
                    X
                    ,\,
                    A
                    \\right)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              This is the following combination of statements from
              = succeed ":" do
                %a{:href => "#SYH10"} SYH 10
            %ol
              %li
                %p Prop. 4.7 there says that, in general:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Maps
                          %mi Dfflg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi X
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi A
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Cdfflgl
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi smap
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        Maps_{Dfflg}\big( X ,\, A\big)
                        \\;\simeq\;
                        Cdfflgl
                        \\big(
                        \\mathbf{smap}(X,Y)
                        \\big)
                %p
                  (where “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi smap
                      %annotation{:encoding => "application/x-tex"} \mathbf{smap}
                  ” is defined on their p. 6),
              %li
                %p
                  Prop. 4.3 there implies that, when
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a CW-complex, as assumed here:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cdfflg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi smap
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Cdfflg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi Maps
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Cdfflg
                        \\big(
                        \\mathbf{smap}(X,Y)
                        \\big)
                        \\;\simeq\;
                        Cdfflg
                        \\big(
                        Maps_{Top}(X,Y)
                        \\big)
                        \\,.
            %p
          %p In summary:
          #EuclideanGeneratedSpacesAreConvenient.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (D-topological spaces are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of D-topological spaces/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              \-generated spaces (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DeltaGeneratedSpace"}
              %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
              in that:
            %ul
              %li
                %p
                  it is
                  %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective
                  in
                  %a.existingWikiWord{:href => "/nlab/show/TopSp"} TopSp
                  (by Prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#AdjunctionBetweenTopologicalSpacesAndDiffeologicalSpaces"}
              %li
                %p
                  it is
                  %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
                  and
                  %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
            %p
              (by
              = succeed ";" do
                %a{:href => "#Vogt71"} Vogt 1971
              = succeed ")" do
                %a{:href => "#SYH10"} SYH 10, Prop. 3.4
            %ul
              %li
                %p
                  it is
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
                  (
                  %a{:href => "#FajstrupRosicky08"}> FR 08, Cor. 3.7
                  ),
              %li
                %p
                  it contains all
                  %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
                  (Prop.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#CWComplexesAreDTopologicalSpaces"}
              %li
                %p
                  it is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/cartesian+closed"} cartesian closed
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  expressible as in Prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#CartesianClosure"}
          %p
            Moreover, in further summary of the discussion further above, this
            %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
            is:
          %ol
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of the
                %a.existingWikiWord{:href => "/nlab/show/quasi-topos"} quasi-topos
                of
                %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
                (see
                = succeed ")," do
                  %a{:href => "diffeological+space#RelationToTopologicalSpaces"} there
            %li
              %p
                which is in turn a
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of the
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
                (see
                = succeed ");" do
                  %a{:href => "geometry+of+physics+--+smooth+sets#DiffeologicalSpacesAreTheConcreteSmoothSets"} there
            %li
              %p
                which in turn is a
                %a.existingWikiWord{:href => "/nlab/show/full+sub-%28infinity%2C1%29-category"}
                  full sub-
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                  \-category
                of the
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
                  cohesive
                  = succeed "-topos" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"}
                  smooth
                  = succeed "-groupoids" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          %p
            such that the canonical
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/shape+via+cohesive+path+%E2%88%9E-groupoid"} smooth path ∞-groupoid construction
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of topological spaces (
            %a.existingWikiWord{:href => "/schreiber/show/Proper+Orbifold+Cohomology"}> SS20, Ex. 3.18
            , see also at
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+Delta-generated+topological+spaces"} model structure on Delta-generated topological spaces
          %div{:style => "margin: -40px 0px 20px 10px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/TopologicalConvenienceBySmoothGroupoids210930.jpg", :width => "800px"}/
              %figcaption{:style => "text-align: center"}
                From
                %a{:href => "https://ncatlab.org/schreiber/show/Equivariant+principal+infinity-bundles"} SS21
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              which is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+space"} locally path-connected
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/first-countable+topological+space"} first-countable
            %p is Delta-generated.
          (cf.
          = succeed ")" do
            %a{:href => "#CSW13"} CSW 2013 Prop 3.11 (1)
          %p
          .num_remark
            %h6 Example
            %p
              All
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              are Delta-generated.
              %br/
          (cf.
          = succeed ")" do
            %a{:href => "#SYH10"} SYH 10, Cor. 4.4
          %p More generally:
          %p
          #RetractsOfCellComplexesAreDeltaGenerated.num_remark
            %h6 Example
            %p
              All topological
              %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
              and all their
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              are Delta-generated, hence all the
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+objects"} cofibrant objects
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
          .proof
            %h6 Proof
            %p
              The first statement follows since
              %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
              are, by definition,
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              of
              %a.existingWikiWord{:href => "/nlab/show/disks"} disks
              and
              %a.existingWikiWord{:href => "/nlab/show/spheres"} spheres
              (which are Delta-generated) and since colimits of Delta-generated spaces are Delta-generated by the
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflection
              discussed
              %a{:href => "#CoreflectionIntoAllTopologicalSpaces"} above
              (and using that
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits"} left adjoints preserve colimits
              = succeed "." do
                %a{:href => "convenient+category+of+topological+spaces#RetractsOfCGeneratedSpacesAreCGenerated"} here
          %p
            In particular,
            %a.existingWikiWord{:href => "/nlab/show/topological+manifolds"} topological manifolds
            are Delta-generated. Moreover:
          %p
          #DtopologyOfSmoothManifolds.num_remark
            %h6 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi sm
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,sm_X)
              — hence a
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sm
                      %mi X
                  %annotation{:encoding => "application/x-tex"} sm_X
              — canonically regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              %a.maruku-eqref{:href => "#eq:DeltaGeneratedSpacesInIdempotentAdjunction"} (2)
              coincides with its ordinary topology:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dtplg
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi sm
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Dtplg(X,sm_X) \,\simeq\, X
                    \\,.
            %p
          (cf.
          = succeed ")" do
            %a{:href => "#CSW13"} CSW 2013 Ex 3.2 (1)
          %p
          .num_remark
            %h6 Remark
            %p
              Together with the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              of Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#AdjunctionBetweenTopologicalSpacesAndDiffeologicalSpaces"}
              %a.maruku-ref{:href => "#DtopologyOfSmoothManifolds"}
              implies that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi sm
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,sm_X)
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              a general topological space, there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              between
            %ol
              %li
                %p
                  morphisms of
                  %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi sm
                            %mi X
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %mi Cdfflg
                          %mo{:stretchy => "false"} (
                          %mi 𝒜
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \;(X,sm_X) \longrightarrow Cdfflg(\mathcal{A})
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mi X
                          %mo ⟶
                          %mi 𝒜
                        %annotation{:encoding => "application/x-tex"} \;X \longrightarrow \mathcal{A}
            %p because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Hom
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi sm
                            %mi X
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi Cdfflg
                          %mo{:stretchy => "false"} (
                          %mi 𝒜
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo ≃
                        %mtd
                          %mi Hom
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi Dtplg
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi sm
                            %mi X
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒜
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mtext by adjunction
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                        %mtd
                          %mi Hom
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi X
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒜
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mtext by the example.
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcll}
                    Hom\big(
                    (X,sm_X)
                    ,\,
                    Cdfflg(\mathcal{A})
                    \\big)
                    \&amp;\simeq&amp;
                    Hom\big(
                    Dtplg(X,sm_X)
                    ,\,
                    \\mathcal{A}
                    \\big)
                    \&amp;
                    \\text{by adjunction}
                    \\\
                    \&amp;\simeq&amp;
                    Hom\big(
                    X
                    ,\,
                    \\mathcal{A}
                    \\big)
                    \&amp;
                    \\text{by the example.}
                    \\end{array}
            %p
          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space"} compactly generated topological space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Euclidean-generated+%E2%88%9E-groupoid"} Euclidean-generated ∞-groupoid
          %h2#references References
          %h3#general General
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            \-generated spaces were originally proposed by
            %a.existingWikiWord{:href => "/nlab/show/Jeff+Smith"} Jeff Smith
            as a
            %a.existingWikiWord{:href => "/nlab/show/nice+category+of+spaces"} nice category of spaces
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %ul
            %li#Smith
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jeff+Smith"}> Jeff Smith
                ,
                %em A really convenient category of topological spaces
                (unpublished and possibly non-existent, according to
                = succeed ")" do
                  %a{:href => "#Dugger03"} Dugger 03, p. 4
            %li#Dugger03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
                ,
                = succeed "," do
                  %em Notes on Delta-generated spaces
                = succeed "," do
                  %a{:href => "https://pages.uoregon.edu/ddugger/delta.html"} web
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/DuggerDeltaGenerated.pdf", :title => "pdf"} pdf
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/proof"} proof
            that the category of
            = succeed "-generated" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
            is in:
          %ul
            %li#FajstrupRosicky08
              %a.existingWikiWord{:href => "/nlab/show/Lisbeth+Fajstrup"}> Lisbeth Fajstrup
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Rosick%C3%BD"} Jiří Rosický
              = succeed "," do
                %em A convenient category for directed homotopy
              %strong 21
              1 (2008) 7-20 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0708.3937"}> arXiv:0708.3937
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/21/1/21-01abs.html"} tac:21-01
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+theory"} directed homotopy theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+Delta-generated+topological+spaces"} model structure on Delta-generated topological spaces
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            is due to
          %ul
            %li#Haraguchi13
              %a.existingWikiWord{:href => "/nlab/show/Tadayuki+Haraguchi"}> Tadayuki Haraguchi
              \:
              = succeed "," do
                %em On model structure for coreflective subcategories of a model category
              %strong 57
              (2015) 79–84 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1304.3622"}> arXiv:1304.3622
              , MR3289294, Zbl 1311.55027)&amp;rbrack;
          %p
            Discussion in the generality of subcategory-generated spaces, including
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
          %ul
            %li#Gaucher07
              %a.existingWikiWord{:href => "/nlab/show/Philippe+Gaucher"}> Philippe Gaucher
              , Section 2 of:
              = succeed "," do
                %em Homotopical interpretation of globular complex by multipointed d-space
              %strong 22
              22 (2009) 588-621&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0710.3553"}> arXiv:0710.3553
              \&amp;rbrack;
          %p along the lines of
          %ul
            %li#Vogt71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rainer+M.+Vogt"}> Rainer M. Vogt
                \:
                = succeed "," do
                  %em Convenient categories of topological spaces for homotopy theory
                %strong 22
                (1971) 545–555 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01222616"}> doi:10.1007/BF01222616
                \&amp;rbrack;
            %li#EscardoLawsonSimpson04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mart%C3%ADn+Escard%C3%B3"}> Martín Escardó
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jimmie+Lawson"} Jimmie Lawson
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alex+Simpson"} Alex Simpson
                = succeed "," do
                  %em Comparing Cartesian closed categories of (core) compactly generated spaces
                %strong 143
                1–3 (2004) 105-145 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/j.topol.2004.02.011"}> doi:10.1016/j.topol.2004.02.011
                \&amp;rbrack;
          %p
            Discussion about the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/q-model+structure"} q-model structure
