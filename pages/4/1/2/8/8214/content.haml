          %h2#idea Idea
          %p
            A natural
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            of
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            that makes the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            into a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo =
                  %mi R
                %annotation{:encoding => "application/x-tex"} \mathcal{A} = R
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
            for the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            of
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          #ExplicitDefinition.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X,Y \in Ch_\bullet(\mathcal{A})
              any two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [X,Y] \in Ch_\bullet(\mathcal{A})
              to have components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℤ
                    %msub
                      %mi Hom
                      %mrow
                        %mi R
                        %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi Y
                      %mrow
                        %mi i
                        %mo +
                        %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [X,Y]_n
                    \\,\coloneqq\,
                    \\prod_{i \in \mathbb{Z}} Hom_{R Mod}(X_i, Y_{i+n})
            %p
              (the collection of degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              maps between the underlying
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              modules) and whose
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is defined on homogeneously graded elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f \in [X,Y]_n
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi d
                      %mi Y
                    %mo ∘
                    %mi f
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mi f
                    %mo ∘
                    %msub
                      %mi d
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d f
                    \\,\coloneqq\,
                    d_Y \circ f - (-1)^{n} f \circ d_X
                    \\,.
            %p
              This defines a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ×
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [-,-]
                    \\;\colon\;
                    Ch_\bullet(\mathcal{A})^{op}
                    \\times
                    Ch_\bullet(\mathcal{A})
                    \\longrightarrow
                    Ch_\bullet(\mathcal{A})
                    \\,.
          %h2#Properties Properties
          .num_prop
            %h6#proposition Proposition
            %p
              The internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExplicitDefinition"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mtext -
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\text{-})\otimes (\text{-})
              endow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
              with the structure of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The collection of
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              of the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,Y]
              in degree 0 coincides with the external
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi Ch
                          %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Z_0\big([X,Y]\big)
                    \\,\simeq\,
                    Hom_{Ch_\bullet}(X,Y)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              of the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,Y]
              in degree 0 coincides with the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+maps"} chain maps
          .proof
            %h6#proof Proof
            %p
              By Definition
              %a.maruku-ref{:href => "#ExplicitDefinition"}
              the 0-cycles in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,Y]
              are collections of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mi k
                    %mo →
                    %msub
                      %mi Y
                      %mi k
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{f_k \colon X_k \to Y_k\}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ∘
                    %msub
                      %mi d
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mi Y
                    %mo ∘
                    %msub
                      %mi f
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_{k+1} \circ d_X \;=\; d_Y \circ f_k
                    \\,.
            %p
              This is precisely the condition for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            %p
              Similarly, the
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              in degree 0 are precisely the collections of morphisms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ∘
                    %msub
                      %mi d
                      %mi X
                    %mo +
                    %msub
                      %mi d
                      %mi Y
                    %mo ∘
                    %msub
                      %mi λ
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\lambda_{k+1} \circ d_X + d_Y \circ \lambda_k
            %p
              for a collection of maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi λ
                        %mi k
                      %mo :
                      %msub
                        %mi X
                        %mi k
                      %mo →
                      %msub
                        %mi Y
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\lambda_k : X_k \to Y_{k+1}\}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/null+homotopies"} null homotopies
          %p
            From the
            %a{:href => "tensor+product+of+chain+complexes#CanonicalForgetfulFunctor"} remark
            at
            %em
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
            we have that the canonical forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi Ch
                  %mo ≔
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi I
                    %mi Ch
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} U_{Ch} \coloneqq Ch_\bullet(\mathcal{A})(I_{Ch},-) \colon Ch_\bullet(\mathcal{A}) \to \mathcal{A}
            takes a chain complex to its 0-cycles.
          %p
            Thus the description of the 0-cycles in the above proposition is equivalent to the statement
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi Ch
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_{Ch}([-,-]) \cong Ch_\bullet(\mathcal{A})(-,-)
