                          %mn 1
                        %annotation{:encoding => "application/x-tex"} 1
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum (n-1)-bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/infinity-Wess-Zumino-Witten+model"} WZW bundle (n-2)-gerbe
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum (n-k)-bundle
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n-1
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum 1-bundle
                  %td{:style => "text-align: left;"}
                    (off-shell)
                    %a.existingWikiWord{:href => "/nlab/show/prequantum+bundle"} prequantum bundle
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/prequantum+0-bundle"} prequantum 0-bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          %h2#details Details
          %blockquote
            %p under construction
          %p
            We discuss local (“
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"}> extended
            ”)
            %a.existingWikiWord{:href => "/nlab/show/topological+field+theory"} topological
            prequantum field theory.
          %p
            The following originates in the lecture notes (
            %a{:href => "#SchreiberPittLectures"}> Schreiber Pittsburgh13
            ) and draws on material that is discussed more fully in (
            %a{:href => "#FiorenzaValentino"}> Fiorenza-Valentino
            ) and (
            %a{:href => "#hCSlpQFT"}> hCSlpQFT
            ).
          %p After a technical preliminary to set the stage in
          %ul
            %li
              %em>
                %a{:href => "#TheTopos"} The ambient topos
              ,
          %p the first section gives the the definitions and general properties of
          %ul
            %li
              %em>
                %a{:href => "#LocalPrequantumFieldTheory"} Local prequantum field theory
              \.
          %p To digest this the reader may first or in parallel want to look at the simplest examples of these general considerations, which we discuss below in the first subsections of
          %ul
            %li
              %em>
                %a{:href => "#HigherDijkgraafWittenLocalPrequantumFieldTheory"} Higher Dijkgraaf-Witten prequantum field theory
              \.
          %p After that we turn to the general case of examples of
          %ul
            %li
              %em>
                %a{:href => "#HigherChern-SimonsLocalPrequantumFieldTheory"} Higher Chern-Simons prequantum field theory
              \.
          %p Here the pattern of the discussion of examples is the following:
          %br/
          %h3#TheTopos The ambient topos
          %p
            Prequantum field theory deals with “spaces of
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} physical fields
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            are, in general, richer than just plain
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            in two ways
          %ol
            %li
              %p
                Spaces of
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                carry
                %a.existingWikiWord{:href => "/nlab/show/geometry"} geometric
                structure, notably they may be
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                form a smoothly parameterized collection. This is for instance the structure invoked (often implicitly) when performing
                %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
                on spaces of
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                in order to find their classical
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            %li
              %p
                Spaces of fields have
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
                between their points and possibly
                %a.existingWikiWord{:href => "/nlab/show/higher+gauge+transformations"} higher gauge transformations
                between these, meaning that they are in fact
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                and possibly
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"} higher groupoids
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal
                approximation to these gauge transformations, in which case the spaces of fields are described by
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/BRST+complexes"} BRST complexes
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                or
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid"} L-∞ algebroid
                of fields.
          %p
            Taken together this means that spaces of fields are
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} geometric higher groupoids
            %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
            and more generally
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-groupoids"} Lie 2-groupoids
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
          %p
            A collection of all such geometric higher groupoids for a chosen flavor of
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            – for instance
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            or
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            or
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            (for the description of
            %a.existingWikiWord{:href => "/nlab/show/fermion"} fermion
            fields) or
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+supergeometry"} synthetic differential supergeometry
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-topos"} ∞-topos
          %p
            Not quite every
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-topos"} ∞-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            serves as a decent context for collections (moduli stacks) of
            %a.existingWikiWord{:href => "/nlab/show/physical+fields"} physical fields
            though. In the following we need at least that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            has a reasonable notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
            so that we can identify the geometrically discrete spaces in there. We here need this to mean the following
          #ShapeAndFlatModality.num_defn
            %h6#definition Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-topos"} ∞-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected
              and
              %em
                %a.existingWikiWord{:href => "/nlab/show/globally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} globally ∞-connetced
              if the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"} locally constant ∞-stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                    %mo{:lspace => "verythinmathspace"} :
                  %annotation{:encoding => "application/x-tex"} LConst \colon
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \to \mathbf{H}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective embedding
            %p The corresponding reflector we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi \colon \mathbf{H} \to \infty Grpd \hookrightarrow \mathbf{H}
            %p
              and also call the
              %em
                %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                  %annotation{:encoding => "application/x-tex"} LConst
              is also a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective
              embedding; the corresponding coreflector we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo →
                      %mi Γ
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\flat \colon \mathbf{H} \stackrel{\Gamma}{\to} \infty Grpd \hookrightarrow \mathbf{H}
            %p
              and call the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
          .num_example
            %h6#example Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              is in particular globally and locally
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \mathbf{H} =
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                  for
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dijkgraaf-Witten+theories"} ∞-Dijkgraaf-Witten theories
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \mathbf{H} =
                  %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
                  for
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theories"} ∞-Chern-Simons theories
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \mathbf{H} =
                  %a.existingWikiWord{:href => "/nlab/show/SuperSmooth%E2%88%9EGrpd"} SuperSmooth∞Grpd
                  for
                  %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theories"} ∞-Chern-Simons theories
                  with
                  %a.existingWikiWord{:href => "/nlab/show/fermions"} fermions
                  and
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \mathbf{H} =
                  %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
                  for
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/AKSZ+sigma-models"} AKSZ sigma-models
          %h3#LocalPrequantumFieldTheory Local prequantum field theory
          %p After sketching out the general
          %ul
            %li
              %em
                %a{:href => "#PrequantumFieldTheoryIdea"} Idea
          %p we formulate first
          %ul
            %li
              %em>
                %a{:href => "#BulkFieldTheory"} Bulk field theory
              ,
          %p
            which concerns the case where the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            on which the
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} physical fields
            propagate has no
            %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
            with
            %a.existingWikiWord{:href => "/nlab/show/boundary+conditions"} boundary conditions
            imposed (no “
            %a.existingWikiWord{:href => "/nlab/show/branes"}> branes
            ” or “
            %a.existingWikiWord{:href => "/nlab/show/domain+walls"}> domain walls
            ” or “
            %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"}> defects
            ”). The point of this section is to see how the “space of fields” – or rather: the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of fields – on a point induces the corresponding spaces/moduli stacks of fields on an arbitrary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
            %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum n-bundle
            on the space over fields over the point induces the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            in
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            0.
          %p
            However, what makes local prequantum field theory rich is that it naturally incorporates extra structure on
            %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic principle
          %ul
            %li
              %em>
                %a{:href => "#BoundaryFieldTheory"} Boundary field theory
              \.
          %p
            But plain boundaries are just the first example of a general phenomenon known as “
            %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"}> defects
            ” or “phase dualities” or “singularities” in field theories. Notably the boundary field theory itself may have boundaries, in which case this means that the original theory had
            %em
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+corners"} corners
            where different boundary pieces meet. This we discuss in
          %ul
            %li
              %em>
                %a{:href => "#CornerFieldTheory"} Corner field theory
              \.
          %p Generally there are fields theories with general such singularties:
          %div
            %table
              %thead
                %tr
                  %th singularity
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/field+theory+with+singularities"} field theory with singularities
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/boundary+condition"}> boundary condition
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/brane"} brane
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/domain+wall"}> domain wall
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/bi-brane"} bi-brane
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} QFT with defects
          %h4#PrequantumFieldTheoryIdea Idea
          %p
            A
            %em prequantum field theory
            is, at its heart, an assignment that sends a piece of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            – technically a
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            with
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            and
            %a.existingWikiWord{:href => "/nlab/show/corners"} corners
            – to the
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/space"} space
                of
                %a.existingWikiWord{:href => "/nlab/show/physical+field"} field configurations
                over incoming and outgoing pieces of worldvolume/spacetime;
            %li
              %p
                the space of field configurations over the bulk worldvolume/spacetime – the
                %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
                of fields;
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                that assigns to all these field configurations
                %a.existingWikiWord{:href => "/nlab/show/phases"} phases
                in a compatible manner.
          %p
            These field configurations and spaces of
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            between them are represented by
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            of (
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"}> moduli
            \-)spaces of fields (
            %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"}> moduli stacks
            , really), hence
            %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi in
                  %mo ←
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi out
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}_{in}
                  \\leftarrow
                  \\mathbf{Fields}
                  \\rightarrow
                  \\mathbf{Fields}_{out}
                  \\,.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi in
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}_{in}
            is to be thought of as the space of incoming fields,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi out
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}_{out}
            that of outgoing fields, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
            the space of all fields on some
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            connecting the incoming and the outgoing pieces of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %p Given two such spans/correspondences, that share a common field configuration as in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mn 1
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi in
                                %mn 1
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi out
                                %mn 1
                          %mo =
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi in
                                %mn 2
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi out
                                %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{Fields}_1 &amp;&amp; &amp;&amp; \mathbf{Fields}_2
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\mathbf{Fields}_{in_1}
                  \&amp;&amp; &amp;&amp;
                  \\mathbf{Fields}_{out_1} = \mathbf{Fields}_{in_2}
                  \&amp;&amp; &amp;&amp;
                  \\mathbf{Fields}_{out_2}
                  }
          %p
            can be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/composition"} composed
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mn 1
                  %munder
                    %mo ×
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi out
                                %mn 1
                      %mrow
                        %mrow
                          %mo =
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi in
                                %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}_1 \underset{{\mathbf{Fields}_{out_1}} \atop {=\mathbf{Fields}_{in_2}}}{\times} \mathbf{Fields}_2
            which sits in a new
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mrow
                      %msub
                        %mi in
                        %mn 1
                  %mo ←
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mn 1
                  %munder
                    %mo ×
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi out
                                %mn 1
                      %mrow
                        %mrow
                          %mo =
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mrow
                              %msub
                                %mi in
                                %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mn 2
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mrow
                      %msub
                        %mi out
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}_{in_1}
                  \\leftarrow
                  \\mathbf{Fields}_1 \underset{{\mathbf{Fields}_{out_1}} \atop {=\mathbf{Fields}_{in_2}}}{\times} \mathbf{Fields}_2
                  \\rightarrow
                  \\mathbf{Fields}_{out_2}
          %p
            exhibiting the composite of the previous two. This way, spaces of fields with spans/correspondences between them form a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Span
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span_1(\mathbf{H})
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            denotes the ambient context (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p
            If two cobordisms run in parallel, then the field configurations on their union are pairs of the original field configurations, which are elements in the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            of spaces of fields. Hence the operations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mi in
                    %mo ←
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mi out
                    %mo )
                  %mo ⊗
                  %mrow
                    %mo (
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                        %mo{:stretchy => "false"} ˜
                      %mi in
                    %mo ←
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                        %mo{:stretchy => "false"} ˜
                      %mi out
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mi in
                    %mo ×
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                        %mo{:stretchy => "false"} ˜
                      %mi in
                    %mo ←
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo ×
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mi out
                    %mo ×
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                        %mo{:stretchy => "false"} ˜
                      %mi out
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\mathbf{Fields}_{in}
                  \\leftarrow
                  \\mathbf{Fields}
                  \\rightarrow
                  \\mathbf{Fields}_{out}
                  \\right)
                  \\otimes
                  \\left(
                  \\tilde \mathbf{Fields}_{in}
                  \\leftarrow
                  \\tilde \mathbf{Fields}
                  \\rightarrow
                  \\tilde\mathbf{Fields}_{out}
                  \\right)
                  \\;\;\coloneqq\;\;
                  \\left(
                  \\mathbf{Fields}_{in} \times \tilde\mathbf{Fields}_{in}
                  \\leftarrow
                  \\mathbf{Fields} \times \tilde\mathbf{Fields}
                  \\to
                  \\mathbf{Fields}_{out} \times \tilde\mathbf{Fields}_{out}
                  \\right)
          %p
            make this category of fields and correspondence into a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          %p
            Then a choice of field configurations for a (not yet localized) field theory in dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            from a
            %a.existingWikiWord{:href => "/nlab/show/category+of+cobordisms"} category of cobordisms
            of dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            to such a category of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:lspace => "verythinmathspace"} :
                  %msubsup
                    %mi Bord
                    %mi n
                    %mo ⊗
                  %mo →
                  %msub
                    %mi Span
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \colon Bord_n^\otimes \to Span_1(\mathbf{H})^\otimes
                  \\,,
          %p
            namely a consistent assignment that to each
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma_{n-1}
            of dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n-1)
            assigns a space of field configurations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}(\Sigma_{n-1})
            and that to each
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi in
                  %mo →
                  %mi Σ
                  %mo ←
                  %msub
                    %mi Σ
                    %mi out
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma_{in} \to \Sigma \leftarrow \Sigma_{out}
          %p
            assigns a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            of spaces of field configurations and trajectories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mi in
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mrow
                      %msub
                        %mi Σ
                        %mi out
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}(\Sigma_{in})
                  \\leftarrow
                  \\mathbf{Fields}(\Sigma)
                  \\rightarrow
                  \\mathbf{Fields}_{\Sigma_{out}}
                  \\,.
          %p
            Apart from the field configurations themselves, prequantum field theory assigns to each
            %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
            a “
            %a.existingWikiWord{:href => "/nlab/show/phase"}> phase
            ” – an element in the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            – by a map called the (exponentiated)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            as above, it is useful to think of the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            here as being the
            %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            of something. This is universally accomplished by taking it to be the automorphisms of the unique point in the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mover
                      %mo →
                      %mrow
                        %mi c
                        %mo ∈
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo *
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1) = \{\ast \stackrel{c \in U(1)}{\to} \ast\}
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            is below in
            = succeed ".)" do
              %a{:href => "#GroupoidsAndBasicHomotopy1TypeTheory"} Groupoids and basic homotopy 1-type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            as the space of
            %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
            from the point to itself in the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            (a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            diagram)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %mo ⇙
                        %mtd
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; U(1)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\ast &amp;&amp; \swArrow &amp;&amp; \ast
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)
                  }
                  \\,.
          %p
            Using this, if we assume for simplicity that the in- and outgoing field configurations are sent constantly to the point in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            on the space of trajectories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i S) \colon \mathbf{Fields} \to U(1)
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            as shown on the left of the following diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Fields
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi in
                        %mtd
                        %mtd
                          %mo ⇙
                        %mtd
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi out
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mn 0
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mn 0
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Fields
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi S
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %mo ⇙
                        %mtd
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{Fields}
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\mathbf{Fields}_{in}
                  \&amp;&amp; \swArrow &amp;&amp;
                  \\mathbf{Fields}_{out}
                  \\\
                  \&amp; {}_{\mathllap{0}}\searrow &amp;&amp; \swarrow_{\mathrlap{0}}
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)
                  }
                  \\;\;\;\;
                  \\simeq
                  \\;\;\;\;
                  \\array{
                  \&amp;&amp; \mathbf{Fields}
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{\exp(i S)}}
                  \\\
                  \&amp;&amp; U(1)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\ast &amp;&amp; \swArrow &amp;&amp; \ast
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)
                  }
                  \\,.
          %p
            Hence action functionals are naturally incorporated into
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            of
            %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
            of fields simply by regarding these to be formed not in the ambient
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            itself, but in its
            %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}U(1)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            and each morphism with a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            between the corresponding maps.
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Span
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Span}_1(\mathbf{H}, \mathbf{B}U(1))
            for the category of spans/correspondences as before, but now equipped with maps to, and transformations over,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            as in the above diagram.
          %p
            Then an
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            for a choice of field configurations that itself is given as a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:lspace => "verythinmathspace"} :
                  %msubsup
                    %mi Bord
                    %mi n
                    %mo ⊗
                  %mo →
                  %msub
                    %mi Span
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields} \colon Bord_n^\otimes \to Span_1(\mathbf{H})
            as above is a monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:lspace => "verythinmathspace"} :
                  %msubsup
                    %mi Bord
                    %mi n
                    %mo ⊗
                  %mo →
                  %msub
                    %mi Span
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  S \colon Bord_n^\otimes \to Span_1(\mathbf{H}, \mathbf{B}U(1))
          %p such that the spans of spaces of fields are those specified before, hence such that it fits as a lift into the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Span
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi S
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
