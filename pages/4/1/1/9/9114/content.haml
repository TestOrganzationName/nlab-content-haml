                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mover
                          %mo ←
                          %mrow
                        %mi L
                        %mo →
                        %mi Z
                      %annotation{:encoding => "application/x-tex"}
                        Y \stackrel{}{\leftarrow} L \rightarrow Z
                %p their composite is the span which is the outer part of the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
