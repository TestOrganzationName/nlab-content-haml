                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi S
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Span
                                    %mi n
                                  %mrow
                                    %mo (
                                    %munder
                                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                      %mrow
                                        %mo ♭
                                        %msup
                                          %mstyle{:mathvariant => "bold"}
                                            %mi B
                                          %mi n
                                        %mi U
                                        %mo{:stretchy => "false"} (
                                        %mn 1
                                        %mo{:stretchy => "false"} )
                                    %mo )
                        %mtr
                          %mtd
                            %msubsup
                              %mi Bord
                              %mi n
                              %mi S
                          %mtd
                            %munder
                              %mo →
                              %mstyle{:mathvariant => "bold"}
                                %mi Fields
                          %mtd
                            %msub
                              %mi Span
                              %mi n
                            %mo{:stretchy => "false"} (
