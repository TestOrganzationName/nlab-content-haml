            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+cobordisms"} category of cobordisms
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            of cobordisms, which we will still denote
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
