          .num_defn
            %h6#definition_13 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%282%2C1%29-category"} symmetric monoidal (2,1)-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
