          #CorrespondencesInInfinityTopos.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-topos"} ∞-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Span_n(\mathbf{H}) \in Cat_{(\infty,n)}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+spans"} (∞,n)-category of spans
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
              structure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              this inherits the structure of a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
              which we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
