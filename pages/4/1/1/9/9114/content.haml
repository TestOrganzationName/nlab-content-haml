                                    %mi S
                                    %mi tYM
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ♭
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Omega^{n+1}_{cl}
                    \\\
                    \\downarrow^{\mathrlap{\exp(i S_{tYM})}}
                    \\\
                    \\mathbf{B}^{n+1} \flat U(1)
                    }
            %p
              of prop.
              %a.maruku-ref{:href => "#ClosedFormsInDeRhamCoefficients"}
              as a local action functional for an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/topological+Yang-Mills+theory"} topological Yang-Mills theory
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theories"} boundary field theories
              now.
          %h4#HigherChernSimonsPrequantumFieldTheory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mi n
                  %mo +
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d = n + 0
            , Higher Chern-Simons field theories
          %p
            We consider now the
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theories"} boundary field theories
            for the “universal topological Yang-Mills theory” of def.
            = succeed "." do
              %a.maruku-ref{:href => "#GeneralHighertYM"}
          %h5#UniversalStYMBoundaryAndDifferentialCohomology
            Universal boundary condition for
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi tYM
                  %annotation{:encoding => "application/x-tex"} S_{tYM}
          %p
            Where the plain
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} (∞,n)-category of cobordisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bord
                    %mi n
                %annotation{:encoding => "application/x-tex"} Bord_n
            is freely generated from the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            alone, so the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\emptyset \to \ast
          %p
            which we think of as being the interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mn 1
                %annotation{:encoding => "application/x-tex"} D^1
            with one end “marked”. Now a local field theory with local action functional according to def.
            %a.maruku-ref{:href => "#LocalPrequantumFieldWithAction"}
            encodes not only the value on the point, which we now take to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mo ↦
                  %mrow
                    %mo [
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %msub
                                    %mi S
                                    %mi tYM
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ♭
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S)
                  \\colon
                  \\ast
                  \\mapsto
                  \\left[
                  \\array{
                  \\Omega^{n+1}_{cl}
                  \\\
                  \\downarrow^{\mathrlap{\exp(i S_{tYM})}}
                  \\\
                  \\mathbf{B}^{n+1} \flat U(1)
                  }
                  \\right]
                  \\,,
          %p
            but moreover one morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Span
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo ♭
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Span_n(\mathbf{H}, \mathbf{B}^{n+1}\flat U(1))
            from the trivial field configuration with trivial action to this data, hence (as amplified in
            = succeed ")" do
              %a{:href => "#FiorenzaValentino"} FV
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo ∂
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %mo ⇙
                        %mtd
                        %mtd
                          %msubsup
                            %mi Ω
                            %mi cl
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo ♭
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{Fields}^{\partial}
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\ast &amp;&amp; \swArrow &amp;&amp; \Omega^{n+1}_{cl}
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; \mathbf{B}^{n+1}\flat U(1)
                  }
                  \\,.
          %p
            Therefore defining such boundary data means defining a
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo ∂
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}^{\partial}
            of boundary field configurations, together with a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            filling the above diagram which encodes the relative action functional on this boundary data.
          %p
            In order to find all possible such boundary data for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mi S
                      %mi tYM
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(i S_{tYM})
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            construction of def.
            %a.maruku-ref{:href => "#HomotopyFiberProductOfKanComplexes"}
            to find the
            %em universal
            such boundary data, the one through which any other one factors.
          #DiffCohomologyIsTerminalBoundaryForStYM.num_prop
            %h6#proposition_15 Proposition
            %p
              The universal boudnary condition for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi i
                      %msub
                        %mi S
                        %mi tYM
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(i S_{tYM})
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %munder
                        %mo ×
                        %mrow
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo ♭
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %msubsup
                        %mi Ω
                        %mi cl
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \ast \underset{\mathbf{B}^{n+1}\flat U(1)}{\times} \Omega^{n+1}_{cl}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan map
              = succeed "," do
                %a.maruku-ref{:href => "#DoldKanMap"}
              %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo ≔
                    %mi DK
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi U
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi d
                        %mi log
                    %msup
                      %mi Ω
                      %mn 1
                    %mover
                      %mo →
                      %mi d
                    %mi ⋯
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mover
                      %mo →
                      %mi d
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}^n U(1)_{conn}
                    \\coloneqq
                    DK(
                    \\underline{U}(1) \stackrel{d log}{\to} \Omega^1 \stackrel{d}{\to} \cdots \to \Omega^{n-1} \stackrel{d}{\to} \Omega^n
                    )
                    \\,,
            %p hence the universal boundary data is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi F
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mo ⇙
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ♭
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{B}^n U(1)_{conn}
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow^{\mathrlap{F_{(-)}}}
                    \\\
                    \\ast &amp;&amp; \swArrow &amp;&amp; \Omega^{n+1}_{cl}
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbf{B}^{n+1}\flat U(1)
                    }
                    \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            defined this way we may call
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cheeger-Simons+differential+character"} Cheeger-Simons field theory
          %h5#GenralBoundaryForStYMAndHigherChernSimons
            General boundary condition for
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi tYM
                  %annotation{:encoding => "application/x-tex"} S_{tYM}
            = succeed "-Chern-Simons" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            we then have the following statement.
          #HigherCSAsBoundaryTheory.num_prop
            %h6#proposition_16 Proposition
            %p
              Boundary field theories for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mi S
                      %mi tYM
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(i S_{tYM})
              are equivalently
              %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields} \in \mathbf{H}
              equipped with maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msub
                      %mi S
                      %mi CS
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(i S_{CS})
                    \\colon
                    \\mathbf{Fields} \to \mathbf{B}^n U(1)_{conn}
            %p
              hence equipped with a
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
              (the
              %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum n-bundle
              of the boundary theory).
          %p
            Moreover, the universal property of the
            %a.existingWikiWord{:href => "/nlab/show/Cheeger-Simons+differential+character"} Cheeger-Simons
            field theory identifies all these boundary theories as being of higher Chern-Simons type, in that they have a
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            associated to them which is an invariant differential form (
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"}> invariant polynomial
            ) on the moduli stack
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi Fields
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi i
                                %msub
                                  %mi S
                                  %mi CS
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %msub
                                  %mi F
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mo ∧
                                %mi ⋯
                                %msub
                                  %mi F
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi F
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                        %mtd
                          %msubsup
                            %mi Ω
                            %mi cl
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{Fields}
                  \\\
                  {}^{\mathllap{\exp(i S_{CS})}}\downarrow &amp; \searrow^{\mathrlap{\langle F_{(-)} \wedge \cdots F_{(-)}\rangle}}
                  \\\
                  \\mathbf{B}^n U(1)_{conn} &amp;\underset{F_{(-)}}{\to}&amp; \Omega^{n+1}_{cl}
                  }
                  \\,.
          %p
            We call these theories of
            = succeed "-type." do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
          .num_example
            %h6#example_21 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a simply connected simple Lie group and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo ≔
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
