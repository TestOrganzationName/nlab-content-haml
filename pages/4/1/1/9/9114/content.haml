                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              and homotopies between these.
          .num_remark
            %h6#remark_10 Remark
            %p
              Even though all these models of the circle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(S^1)
              are equivalent, below the special appearance of the circle in the proof of prop.
              %a.maruku-ref{:href => "#FreeLoopSpaceOfGroupoid"}
              as the combination of two semi-circles will be important for the following proofs. As we see in a moment, this is the natural way in which the circle appears as the composition of an
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              with a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coevaluation+map"} coevaluation map
          #AdjointActionGroupoidFromFreeLoopSpaceObject.num_example
            %h6#example_13 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              of its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} /
                        %mi ad
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G//_{ad} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              = succeed "," do
                %a.maruku-ref{:href => "#ActionGroupoid"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}G] \simeq G//_{ad} G
                    \\,.
          .num_example
            %h6#example_14 Example
            %p
              For an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \flat U(1)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}\flat U(1)]
                    \\simeq
                    \\flat U(1)//_{ad} \flat U(1)
                    \\simeq
                    (\flat U(1)) \times (\mathbf{B}\flat U(1))
                    \\,.
          #GroupCharacterAsClassFunctionByFreeLoopSpace.num_example
            %h6#example_15 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \colon G \to \flat U(1)
              be a group homomorphism, hence a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+character"} group character
              %a.maruku-ref{:href => "#DeloopingGroupoid"}
              this has a
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              to a groupoid homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}c \;\colon\; \mathbf{B}G \to \mathbf{B}\flat U(1)
                    \\,.
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              construction this becomes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}c]
                    \\;\colon\;
                    [\Pi(S^1), \mathbf{B}G]
                    \\to
                    [\Pi(S^1), \mathbf{B}\flat U(1)]
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mi G
                    %mo →
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}c]
                    \\;\colon\;
                    G//_{ad}G
                    \\to
                    \\flat U(1) \times \mathbf{B}U(1)
                    \\,.
            %p
              So by postcomposing with the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              on the first factor we recover from the general
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of groupoids the statement that a group character is a
              %a.existingWikiWord{:href => "/nlab/show/class+function"} class function
              on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mi G
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}c]
                    \\;\colon\;
                    G//_{ad}G
                    \\to
                    U(1)
                    \\,.
          %h5#CorrespondencesOfGroupoids Trajectories of fields: Correspondences of groupoids
          %p
            With some basic
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            in hand, we can now talk about
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            in finite gauge theories, namely about
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            of groupoids and their composition. These correspondences of groupoids encode
            = succeed "/histories" do
              %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field configurations
          %p
            Namely consider a groupoid to be called
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields} \in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            in some field theory, or equivalently and specifically as the
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            of a
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            field theory. This just means that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            any
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            thought of as
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}(\Sigma)
            of the field theory on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is the
            %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            (
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"}> internal hom
            ) from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
            = succeed "," do
              %a.maruku-ref{:href => "#MappingGroupoid"}
            = succeed "," do
              %a.maruku-ref{:href => "#FundamentalGroupoid"}
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}(\Sigma) = [\Pi_1(\Sigma), \mathbf{Fields}]
                  \\,.
          %p
            We think of the
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of the groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Pi_1(\Sigma), \mathbf{Fields}]
            as being the fields themselves, and of the
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            as being the
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            between them.
          %p
            The example to be of interest in a moment is that where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields} = \mathbf{B}G
            is a
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            groupoid as in def.
            = succeed "," do
              %a.maruku-ref{:href => "#DeloopingGroupoid"}
            %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            = succeed "," do
              %a.maruku-ref{:href => "#DiscreteGroupoidIsDijointUnioonOfDeloopings"}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
          %p
            The simple but crucial observation that shows why
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            of groupoids show up in prequantum field theory is the following.
          .num_example
            %h6#example_16 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
              with incoming
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi in
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_{in} \hookrightarrow \Sigma
              and outgoing boundary components
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi out
                      %mo ↪
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma_{out} \hookrightarrow \Sigma
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              of manifolds
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mi Σ
                              %mi in
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Σ
                              %mi out
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \Sigma
                    \\\
                    \&amp; \nearrow &amp;&amp; \nwarrow
                    \\\
                    \\Sigma_{in}
                    \&amp;&amp; &amp;&amp;
                    \\Sigma_{out}
                    }
            %p is sent under the operation of mapping into the moduli space of fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Mfds
                      %mi op
                    %mo →
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi_1(-), \mathbf{Fields}]
                    \\;\colon\;
                    Mfds^{op} \to Grpd
            %p
              to a
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Σ
                              %mi in
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Σ
                              %mi out
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; [\Pi_1(\Sigma), \mathbf{Fields}]
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    [\Pi_1(\Sigma_{in}), \mathbf{Fields}]
                    \&amp;&amp; &amp;&amp;
                    [\Pi_1(\Sigma_{out}), \mathbf{Fields}]
                    }
                    \\,.
            %p
              Here the left and right homomorphisms are those which take a field configuration on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              and restrict it to the incoming and to the outgoing field configuration, respectively. (And this being a homomorphism of groupoids means that everything respects the
              %a.existingWikiWord{:href => "/nlab/show/gauge+symmetry"} gauge symmetry
              on the fields.) Hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Σ
                      %mrow
                        %mi in
                        %mo ,
                        %mi out
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Pi_1(\Sigma_{in,out}),\mathbf{Fields}]
              is thought of as the spaces of incoming and outgoing field configurations, respectively, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Pi_1(\Sigma), \mathbf{Fields}]
              is to be interpreted as the space of
              %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
              (sometimes:
              = succeed ")" do
                %em histories
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
              %a.existingWikiWord{:href => "/nlab/show/worldvolumes"} worldvolumes
              of shape
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          %p This should make it plausible that specifying the field content of a 1-dimensional discrete gauge field theory is a functorial assignsment
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Bord
                    %mn 1
                  %mo →
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \\;\colon\;
                  Bord_1
                  \\to Span(Grpd)
          %p
            from a
            %a.existingWikiWord{:href => "/nlab/show/category+of+cobordisms"} category of cobordisms
            of dimension one into a category of such
            %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            of groupoids. It sends points to spaces of field configurations on the point and 1-dimensional manifolds such as the circle as spaces of trajectories of field configurations on them.
          %p
            Moreover, for a
            %em local
            field theory it should be true that the field configurations on the circle, say, are determined from gluing the field configurations on any decomposition of the circle, notably a decomposition into two semi-circles. But since we are dealing with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+field+theory"} topological field theory
          %p
            The way that the fields on higher spheres in a topological field theory are induced from the fields on the point is by an analog of
            %em
              %a.existingWikiWord{:href => "/nlab/show/traces"} traces
            for spaces of fields, and higher traces of such correspondences (the “
            %a.existingWikiWord{:href => "/nlab/show/span+trace"}> span trace
            ”). This is because by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+theorem"} cobordism theorem
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            are given by the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/span+trace"} span trace
            of the field configurations on the point, the trace of the traces of the … of the 1-trace. This is because for instance the 1-sphere, hence the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            is, regarded as a 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            itself pretty much manifestly a
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            on the point in the
            %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
            formulation of traces.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo *
                            %mo −
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↖
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↗
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo *
                            %mo +
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp;  \ast^-
                  \\\
                  \&amp; \swarrow &amp; &amp; \nwarrow
                  \\\
                  \\downarrow &amp;&amp; &amp;&amp; \uparrow
                  \\\
                  \&amp; \searrow &amp;&amp; \nearrow
                  \\\
                  \&amp;&amp; \ast^+
                  }
                  \\,.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo *
                    %mo +
                %annotation{:encoding => "application/x-tex"} \ast^+
            is the point with its potitive orientation, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo *
                    %mo −
                %annotation{:encoding => "application/x-tex"} \ast^-
            is its
            %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+cobordisms"} category of cobordisms
            %a.existingWikiWord{:href => "/nlab/show/coevaluation+map"} coevaluation map
            and
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            map on the point regarded as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
            %a.existingWikiWord{:href => "/nlab/show/topological+field+theory"} topological field theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Bord
                      %mi n
                    %mo →
                    %msub
                      %mi Span
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z \colon Bord_n \to Span_n(\mathbf{H})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} Span_n(\mathbf{H})^\otimes
            %a.existingWikiWord{:href => "/nlab/show/span+trace"} span trace
            on the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}(\ast)
            over the point. This we discuss now.
          %p Before talking about correspondences of groupoids, we need to organize the groupoids themselves a bit more.
          #TwoOneCategory.num_defn
            %h6#definition_10 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a collection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_0
                  – the “collection of
                  = succeed "\u201D;" do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi 𝒞
                          %mn 0
                        %mo ×
                        %msub
                          %mi 𝒞
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} (X,Y) \in \mathcal{C}_0 \times \mathcal{C}_0
                  a
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y)
                  – the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  to
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/triple"} triple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi 𝒞
                          %mn 0
                        %mo ×
                        %msub
                          %mi 𝒞
                          %mn 0
                        %mo ×
                        %msub
                          %mi 𝒞
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} (X,Y,Z) \in \mathcal{C}_0 \times \mathcal{C}_0 \times \mathcal{C}_0
                  a groupoid homomorphism (
                  %a.existingWikiWord{:href => "/nlab/show/functor"}> functor
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∘
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                            %mo ,
                            %mi Z
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\circ_{X,Y,Z} \colon \mathcal{C}(X,Y) \times \mathcal{C}(Y,Z) \to \mathcal{C}(X,Z)
                %p
                  called
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  or
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
                  for emphasis;
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/quadruple"} quadruple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mo ,
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo ,
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (W,X,Y,Z,)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                  – the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  –
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi Y
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi Y
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ⇙
                                  %mrow
                                    %msub
                                      %mi α
                                      %mrow
                                        %mi W
                                        %mo ,
                                        %mi X
                                        %mo ,
                                        %mi Y
                                        %mo ,
                                        %mi Z
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathcal{C}(W,X) \times \mathcal{C}(X,Y) \times \mathcal{C}(Y,Z)
                        \&amp;\stackrel{}{\to}&amp;
                        \\mathcal{C}(W,Y) \times \mathcal{C}(Y,Z)
                        \\\
                        \\downarrow &amp;\swArrow_{\alpha_{W,X,Y,Z}}&amp; \downarrow
                        \\\
                        \\mathcal{C}(W,X) \times \mathcal{C}(X,Z)
                        \&amp;\stackrel{}{\to}&amp;
                        \\mathcal{C}(W,Z)
                        }
                %p
                  (…) and similarly a
                  %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
                  homotopy (…)
            %p
              such that for each
              %a.existingWikiWord{:href => "/nlab/show/quintuple"} quintuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi W
                    %mo ,
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,W,X,Y,Z)
              the associators satisfy the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pentagon+identity"} pentagon identity
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y)
              we call the
              %em
                %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\to} Y
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y)
              we call the
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⇓
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\\
                    \&amp; \nearrow \searrow^{\mathrlap{f}}
                    \\\
                    X &amp;\Downarrow&amp;  Y
                    \\\
                    \&amp; \searrow \nearrow_{\mathrlap{g}}
                    }
                    \\,.
            %p
              If all associators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
