            for the resulting
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+spans"} (∞,n)-category of spans
          %p
            In order to still have an
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            on trajectories is
            = succeed "-0" do
              %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            %a.existingWikiWord{:href => "/nlab/show/delooping"} deloop
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "-times" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
