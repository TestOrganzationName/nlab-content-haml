                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi ci
                        %mtd
                          %mo ←
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi cc
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi co
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi oi
