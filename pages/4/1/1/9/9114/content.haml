              is the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
              which to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} U \in \mathcal{C}
              assigns the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categorical+hom+space"} (∞,1)-categorical hom space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
