                  %mo ♭
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S) \colon \mathbf{Fields} \to \flat \mathbf{B}^{n+1}U(1)
                  \\,,
          %p
            for any object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields} \in \mathbf{H}
          %p First we now observe in
          %ul
            %li
              %em
                %a{:href => "#TopologicalYangMillsLocalPrequantumFieldTheory"} Universal topological Yang-Mills theory
          %p
            that there is a fairly canonical such morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi tYM
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{n+1}_{tYM}
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            relative to
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \flat \mathbf{B}^{n+1}U(1)
            given by the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} closed differential (n+1)-forms
            = succeed "," do
              %a.maruku-ref{:href => "#LocalPrequantumFieldWithAction"}
            %a.existingWikiWord{:href => "/nlab/show/topological+Yang-Mills+theory"} topological Yang-Mills
            prequantum field theory. What this means becomes clear when we analyze the possible
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theories"} boundary field theories
            of this theory.
          %ul
            %li
              %p
                %em
