                  %msub
                    %mi{:mathvariant => "normal"} Span
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Grpd
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo ♭
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  S
                  \\;\coloneqq\;
                  \\left[
                  \\array{
                  \\mathbf{B}G
                  \\\
                  \\downarrow^{\mathrlap{c}}
                  \\\
                  \\mathbf{B}\flat U(1)
                  }
                  \\right]
                  \\;\in \;
                  \\mathrm{Span}_1(Grpd, \mathbf{B}\flat U(1))
          %p
            in a
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            of correspondences of groupoids as in def.
            = succeed "," do
              %a.maruku-ref{:href => "#OneSpansInOneGroupoids"}
            %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\flat U(1)
            %a.maruku-ref{:href => "#OneSpansInOneGroupoidsOverBU"}
            below. Before stating this, we recall for the 1-dimensional case the general story of def.
            = succeed "." do
              %a.maruku-ref{:href => "#LocalPrequantumFieldWithAction"}
          #HomotopyAsActionFunctional.num_example
            %h6#example_17 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/discrete+groupoid"} discrete groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(i S) \colon X \to \flat U(1)
            %p
              are in
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              with
              %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
