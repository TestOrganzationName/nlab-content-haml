                    %mo →
                    %mover
                      %mi Y
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mover
                      %mi X
