            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/prequantum+geometry"} prequantum geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higher+prequantum+geometry"} higher prequantum geometry
            %li
              %p
