              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
              represented by a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
