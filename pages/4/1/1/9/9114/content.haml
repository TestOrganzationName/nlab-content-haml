                    \\mathbf{H}(\Pi(\Sigma_k)\times U , \mathbf{Fields})
                    \\,,
            %p
              hence the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              of fields on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \Pi(\Sigma_k) \times U
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
              is a
              %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
              of
              %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
              for some
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-group"} smooth ∞-group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
