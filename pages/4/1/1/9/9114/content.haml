                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                  are
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/spans"} spans
                  %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mo ←
                              %mtd
                                %mi X
                              %mtd
                                %mo →
                              %mtd
                                %mi B
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        A
                        \&amp;\leftarrow&amp;
                        X
                        \&amp;\rightarrow&amp;
                        B
                        }
                        \\,;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi X
                                  %mn 1
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mo ⇘
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
