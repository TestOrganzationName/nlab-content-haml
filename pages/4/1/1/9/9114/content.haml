                      %mi Bord
                      %mi n
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} Bord_n^\otimes
            = succeed "-2" do
              %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/corners"} corners
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi ii
                        %mtd
                          %mo ←
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
