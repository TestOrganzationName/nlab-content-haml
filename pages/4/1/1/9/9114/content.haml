                        %mi G
                        %mo{:stretchy => "false"} |
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
