            %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span_n(\mathbf{H}, \mathbf{B}^n U(1))
          %p All this we now describe more formally.
          %h4#BulkFieldTheory Bulk field theory
          %p
            We now first consider the formalization of prequantum field theory in the absence of any data such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/boundary+conditions"} boundary conditions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/domain+walls"} domain walls
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} defects
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/bulk"} bulk
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            where they are not. Therefore it makes sense to speak of
            %em bulk field theory
            in this case.
          #nCategoryOfCobordisms.num_defn
            %h6#definition_2 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Bord
                      %mi n
                      %mo ⊗
                    %mo ∈
                    %msub
                      %mi E
                      %mn ∞
                    %mi Alg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Bord_n^\otimes \in E_\infty Alg(Cat_{(\infty,n)})
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} of cobordisms
              with
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/framed+manifold"} framing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \to O(n)
              a homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
              (may be modeled by a homomorphism of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              (or homotopy-equivalently its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                    %mo ∈
                    %msub
                      %mi E
                      %mn ∞
                    %mi Alg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (Bord_n^S)^\otimes \in E_\infty Alg(Cat_{(\infty,n)})
            %p
              for the corresponding symmetric monoidal
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n)
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} S-structure
              on their
              = succeed "-stabilized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
          .num_remark
            %h6#remark Remark
            %p In this notation we have an identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bord
                      %mi n
                    %mo ≃
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mi S
                        %mo ≔
                        %mo *
                  %annotation{:encoding => "application/x-tex"}
                    Bord_n \simeq Bord_n^{S \coloneqq \ast}
            %p
              because a
              %a.existingWikiWord{:href => "/nlab/show/framing"} framing
              of the
              = succeed "-stabilized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              the trivial group. In (
              %a{:href => "#LurieTFT"}> LurieTFT
              ) this is denoted by “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi fr
                  %annotation{:encoding => "application/x-tex"} Bord_n^{fr}
              ”.
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/cobordism+theorem"} cobordism theorem
              asserts, essentially, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bord
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Bord_n
              is the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
              with
              %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+objects"} full duals
              which is
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              on a single generator, the point. In itself this is a deep statement about the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/categories+of+cobordisms"} categories of cobordisms
              %em definition
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Bord
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Bord_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bord
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Bord_n
              a very simple object, as long as we are just mapping out of it, which we do.
            %p
              What this means then is that a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2Cn%29-functor"} monoidal (∞,n)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Bord
                      %mi n
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"}
                    Z \colon Bord_n^\otimes \to \mathcal{C}^\otimes
            %p
              sends the point to some
              %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"} fully dualizable object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Z(\ast) \in \mathcal{C}
              and sends
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/trace"} trace
