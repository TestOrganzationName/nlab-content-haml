                  %annotation{:encoding => "application/x-tex"} n
          %p
            Here we review how to formalize this and then consider the example of DW theory in arbitrary dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h5#EssenceOfHigherGaugeTheoryBasicHomotopyTheory
            Essence of higher gauge theory:
            = succeed "-Groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We briefly recall here some basic definitions and facts of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            and their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theory"} Dijkgraaf-Witten theory
            and generally in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dijkgraaf-Witten+theory"} ∞-Dijkgraaf-Witten theory
          %h6#HeuristicsOnCompositionAndInverses Higher gauge transformations: Simplicial sets and Kan complexes
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            is first of all supposed to be a structure that consists of
            %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k \geq 1
            go between
            = succeed "-morphisms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
          %p
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
            is the notion of a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/geometric+shape+for+higher+structures"} shape
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            – a
            %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k = 0
            %a.existingWikiWord{:href => "/nlab/show/edge"} edge
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
            %a.existingWikiWord{:href => "/nlab/show/triangle"} triangle
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k = 2
            %a.existingWikiWord{:href => "/nlab/show/tetrahedron"} tetrahedron
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} k = 3
          %p
            This means that a simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mo •
                %annotation{:encoding => "application/x-tex"} K_\bullet
            is a sequence of
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi K
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \{K_n\}_{n \in \mathbb{N}}
            (sets of
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi K
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo →
                  %msub
                    %mi K
                    %mi k
                %annotation{:encoding => "application/x-tex"} d_i \colon K_{k+1} \to K_{k}
            that send a
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi K
                    %mi k
                  %mo →
                  %msub
                    %mi K
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_i \colon K_k \to K_{k+1}
            that over a
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-simplex\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/identities"} identities
          %p
            If we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are abstract cellular
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            and whose morphisms are all cellular maps between these, then such a simplicial set is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  K \colon \Delta^{op} \to Set
          %p Hence we think of this as assigning
          %ul
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} [0] \mapsto K_0
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} [1] \mapsto K_1
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} [2] \mapsto K_2
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 3
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} [3] \mapsto K_3
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/3-morphism"} 3-morphism
          %p and generally
          %ul
            %li
              a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi K
                      %mi k
                  %annotation{:encoding => "application/x-tex"} [k] \mapsto K_k
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
          %p as well as specifying
          %ul
            %li
              %p
                functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %msub
                        %mi K
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([n] \hookrightarrow [n+1]) \mapsto (K_{n+1} \to K_n)
                that send
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n+1
                = succeed "-morphisms;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mi n
                      %mo →
                      %msub
                        %mi K
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([n+1] \to [n]) \mapsto (K_{n} \to K_{n+1})
                that send
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+1)
          %p
            The fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is supposed to be a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            enforces that these assignments of sets and functions satisfy conditions that make consistent our interpretation of them as sets of
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
          %p
            But apart from this source-target matching, a generic simplicial set does not yet encode a notion of
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of these morphisms.
          %p
            For instance for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^1[2]
            the simplicial set consisting of two attached 1-cells
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mn 2
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda^1[2] = \left\{
                  \\array{
                  \&amp;&amp; 1
                  \\\
                  \&amp; \nearrow &amp;&amp; \searrow
                  \\\
                  0 &amp;&amp;&amp;&amp; 2
                  }
                  \\right\}
          %p
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} (f,g) : \Lambda^1[2] \to K
            an image of this situation in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mover
                    %mo →
                    %mi f
                  %msub
                    %mi x
                    %mn 1
                  %mover
                    %mo →
                    %mi g
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_0 \stackrel{f}{\to} x_1 \stackrel{g}{\to} x_2
            of two
            %em composable
            1-morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            that may be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mover
                    %mo →
                    %mi h
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_0 \stackrel{h}{\to} x_2
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            (and not to violate the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mpadded{:width => "0"}
                              %mo ≃
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow &amp;\Downarrow^{\mathrlap{\simeq}}&amp;
                  \\searrow^{\mathrlap{g}}
                  \\\
                  x_0 &amp;&amp;\stackrel{h}{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            From the picture it is clear that this is equivalent to demanding that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^1[2] \hookrightarrow \Delta[2]
            the obvious inclusion of the two abstract composable 1-morphisms into the 2-simplex we have a diagram of morphisms of simplicial sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Λ
                            %mn 1
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo ,
                              %mi g
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi K
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∃
                                %mi h
                      %mtr
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Lambda^1[2] &amp;\stackrel{(f,g)}{\to}&amp; K
                  \\\
                  \\downarrow &amp; \nearrow_{\mathrlap{\exists h}}
                  \\\
                  \\Delta[2]
                  }
                  \\,.
          %p
            A simplicial set where for all such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,g)
            a corresponding such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            exists may be thought of as a collection of higher morphisms that is equipped with a notion of composition of adjacent 1-morphisms.
          %p
            For the purpose of describing
            = succeed "al" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mn 2
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda^2[2] = \left\{
                  \\array{
                  \&amp;&amp; 1
                  \\\
                  \&amp; &amp;&amp; \searrow
                  \\\
                  0 &amp;&amp;\to&amp;&amp; 2
                  }
                  \\right\}
          %p the simplicial set consisting of two 1-morphisms that touch at their end, hence for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Λ
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"}
                  (g,h) : \Lambda^2[2] \to K
          %p
            two such 1-morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            had an inverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} g^{-1}
            we could use the above composition operation to compose that with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            and thereby find a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            connecting the sources of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Λ
                            %mn 2
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo ,
                              %mi h
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi K
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∃
                                %mi f
                      %mtr
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Lambda^2[2] &amp;\stackrel{(g,h)}{\to}&amp; K
                  \\\
                  \\downarrow &amp; \nearrow_{\mathrlap{\exists f}}
                  \\\
                  \\Delta[2]
                  }
                  \\,.
          %p
            Demanding that all such diagrams exist is therefore demanding that we have on 1-morphisms a composition operation with inverses in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            In order for this to qualify as an
            = succeed "-groupoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/associativity+law"} associativity law
            up to
            %a.existingWikiWord{:href => "/nlab/show/coherent"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/tetrahedron"} tetrahedron
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %em pentagonators
            and ever so on. It is a nontrivial but true and powerful fact, that all these
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
            conditions are captured by generalizing the above conditions to all dimensions as in the definition of Kan complexes.
          %p
            In order to conceive of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            for higher
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            as “
            %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %em
              %a.existingWikiWord{:href => "/nlab/show/orientals"} orientals
            (due to
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
          %p
            The
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(k)
            is precisely the prescription for how exactly to think of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            as being a
            %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            in an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:rowalign => "center"}
                      %mtr
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mo =
                        %mtd
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                      %mtr
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo =
                        %mtd
                          %mrow
                            %mo {
                            %mn 0
                            %mo →
                            %mn 1
                            %mo }
                      %mtr
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                        %mtd
                          %mrow
                            %mo {
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"}
                                        [[!include oriental &gt; Delta2]]
                            %mo }
                      %mtr
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 3
                          %mo{:stretchy => "false"} )
                          %mo =
                        %mtd
                          %mrow
                            %mo {
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"}
                                        [[!include oriental &gt; Delta3]]
                            %mo }
                      %mtr
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 4
                          %mo{:stretchy => "false"} )
                          %mo =
                        %mtd
                          %mrow
                            %mo {
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"}
                                        [[!include oriental &gt; Delta4]]
                            %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\array{\arrayopts{\rowalign{center}}
                  O(\Delta^0) = &amp; \{ 0\} \\
                  O(\Delta^1) = &amp; \left\{ 0 \to 1\right\} \\
                  O(\Delta^2) = &amp; \left\{
                  \\array{\begin{svg}
                  [[!include oriental &gt; Delta2]]
                  \\end{svg}}
                  \\right\}\\
                  O(\Delta^3) = &amp; \left\{
                  \\array{\begin{svg}
                  [[!include oriental &gt; Delta3]]
                  \\end{svg}}\right\}\\
                  O(\Delta^4) = &amp; \left\{
                  \\array{\begin{svg}
                  [[!include oriental &gt; Delta4]]
                  \\end{svg}}
                  \\right\}
                  }
          %p
            In fact, the
            %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(K)
            of an
            %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            whose collection of
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi K
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo :
                  %mo =
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(K)_k := Hom(O(k),K)
            is precisely the collection of images of the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(k)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            This is fully formally the prescription of how to think of a Kan complex as an
            = succeed "-groupoid:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
            of an
            %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
            in which all morphism are invertible:
          %ul
            %li
              %p
                the
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi k
                    %annotation{:encoding => "application/x-tex"} C_k
                are precisely the collection of
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(k)
            %li
              %p
                the
                = succeed "-filler" do
                  %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              %ol
                %li
                  %p
                    there exists a notion of composition of adjacent k-morphisms in the
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
                %li
                  %p
                    under this composition all
                    = succeed "-morphisms" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi k
                          %annotation{:encoding => "application/x-tex"} k
          %p This is easy to see in low dimensions:
          %ul
            %li
              %p
                a 1-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \phi \in C_1
                in the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has a single source 0-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mo =
                      %msub
                        %mi d
                        %mn 1
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} x := d_1 \phi
                and a single target 0-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mo =
                      %msub
                        %mi d
                        %mn 0
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} y := d_0 \phi
                and hence may be pictured as a
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo →
                        %mi ϕ
                      %mi y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      x \stackrel{\phi}{\to} y
                      
                      \\,.
            %li
              %p
                a 2-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \phi \in C_2
                in the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has two incoming 1-cells
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 2
                      %mi ϕ
                      %mo ,
                      %msub
                        %mi d
                        %mn 0
                      %mi ϕ
                      %mo ∈
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} d_2 \phi, d_0 \phi \in C_1
                and one outgoing 1-cell
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %mi ϕ
                        %mo ∈
                        %msub
                          %mi C
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} d_1 \phi \in C_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                here as a globular 2-morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi x
                                %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 2
                                    %mi ϕ
                              %mo ↗
                            %mtd
                              %msup
                                %mo ⇓
                                %mi ϕ
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 0
                                    %mi ϕ
                          %mtr
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                            %mtd
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                                  %mi ϕ
                            %mtd
                            %mtd
                              %msub
                                %mi x
                                %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; x_1
                      \\\
                      \&amp; {}^{\mathllap{d_2 \phi}}\nearrow &amp;\Downarrow^\phi&amp; \searrow^{\mathrlap{d_0 \phi}}
                      \\\
                      x_0 &amp;&amp;\underset{d_1 \phi}{\to}&amp;&amp; x_2
                      }
                      \\,.
          %p
            More in detail, one may think of the incoming two adjacent
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %em not
            being the composite of these two morphism, but just as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/composable+pair"} composable pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            here as being a
            %strong compositor
            in a
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            that shows how the composable pair is composed to the morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} d_1 \phi
          %p
            So if an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/geometric+shapes+for+higher+structures"} globular
            %a.existingWikiWord{:href => "/nlab/show/Batanin+%E2%88%9E-category"} ∞-category
            in which all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            or rather the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-nerve"} ∞-nerve
            of this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-category"} ∞-category
          %p
            Notably if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is to be regarded as (the nerve of) an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %em unique
            2-cell
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi f
                          %mo ↗
                        %mtd
                          %mo ⇓
                        %mtd
                          %msup
                            %mo ↘
                            %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi h
                              %mo =
                              %mi g
                              %mo ∘
                              %mi f
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{f}\nearrow &amp;\Downarrow&amp; \searrow^{g}
                  \\\
                  x_0 &amp;&amp;\underset{h = g \circ f}{\to}&amp;&amp; x_2
                  }
          %p
            that is the unique
            %strong identity 2-morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi f
                  %mover
                    %mo ⇒
                    %mo =
                  %mi h
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  g \circ f \stackrel{=}{\Rightarrow} h
                  \\,.
          %p
            More generally, in a
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            there may be non-identity 2-morphisms, and hence for any 1-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi k
                    %mi x
                  %msub
                    %mo
                    %mn 0
                  %mo →
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} k _ x_0 \to x_2
            2-isomorphic to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo ⇒
                    %mi k
                  %annotation{:encoding => "application/x-tex"} g \circ f \Rightarrow k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi f
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mo ≃
                        %mtd
                          %msup
                            %mo ↘
                            %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mi k
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{f}\nearrow &amp;\Downarrow^{\simeq}&amp; \searrow^{g}
                  \\\
                  x_0 &amp;&amp;\underset{k }{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            All we can say for sure is that
            %em at least
            one such 2-cell exists, and that the 2-cells themselves may be composed in some way. This is precisely what the horn-filler conditions in a Kan complex encode.
          %p
            We have already seen in low dimension how the existence of composites in an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            To see in a similar fashion that the Kan condition ensures the existence of
            %em inverses
            consider an
            %em outer horn
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow
                  \\\
                  x_0 &amp;&amp;\underset{h}{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            In general given such a diagram in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            composed with the morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mo ≃
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mi h
                                %mo ∘
                                %msup
                                  %mi f
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow
                  \&amp;\Downarrow^{\simeq}&amp; \searrow^{\mathrlap{h \circ f^{-1}}}
                  \\\
                  x_0 &amp;&amp;\underset{h}{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            A similar analysis for higher dimensional cells shows that the fact that a Kan complex has all horn fillers encodes precisely the fact that it is the
            %a.existingWikiWord{:href => "/nlab/show/omega-nerve"} omega-nerve
            of an
            %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-category
            in which
            %em all
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            are composable if adjacent and have a weak inverse.
          %h6#1GroupoidsAsKanComplexes 1-Groupoids as Kan complexes
          %p
            We review how
            %a.existingWikiWord{:href => "/nlab/show/1-groupoids"} 1-groupoids
            are incarnated as Kan complexes via their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+homotopy+types"} geometry of physics – homotopy types
          #Groupoid.num_defn
            %h6#definition_15 Definition
            %p
              A (
              %a.existingWikiWord{:href => "/nlab/show/small+category"}> small
              )
              %em
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              is
            %ul
              %li
                %p
                  a pair of
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒢
                          %mn 0
                        %mo ∈
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}_0 \in Set
                  (the set of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒢
                          %mn 1
                        %mo ∈
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \in Set
                  (the set of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %li
                %p
                  equipped with
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi 𝒢
                                  %mn 1
                                %msub
                                  %mo ×
                                  %mrow
                                    %msub
                                      %mi 𝒢
                                      %mn 0
                                %msub
                                  %mi 𝒢
                                  %mn 1
                              %mtd
                                %mover
                                  %mo →
                                  %mo ∘
                              %mtd
                                %msub
                                  %mi 𝒢
                                  %mn 1
                              %mtd
                                %mover
                                  %mover
                                    %munder
                                      %mo →
                                      %mi s
                                    %mover
                                      %mo ←
                                      %mi i
                                  %mover
                                    %mo →
                                    %mi t
                              %mtd
                                %msub
                                  %mi 𝒢
                                  %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathcal{G}_1 \times_{\mathcal{G}_0} \mathcal{G}_1
                        \&amp;\stackrel{\circ}{\to}&amp;
                        \\mathcal{G}_1
                        \&amp; \stackrel{\overset{t}{\to}}{\stackrel{\overset{i}{\leftarrow}}{\underset{s}{\to}}}&amp;
                        \\mathcal{G}_0
                        }\,,
                %p
                  where the
                  %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                  on the left is that over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 1
                          %mover
                            %mo →
                            %mi t
                          %msub
                            %mi 𝒢
                            %mn 0
                          %mover
                            %mo ←
                            %mi s
                          %msub
                            %mi 𝒢
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \stackrel{t}{\to} \mathcal{G}_0 \stackrel{s}{\leftarrow} \mathcal{G}_1
            %p such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  takes values in
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ∘
                        %mi i
                        %mo =
                        %mi s
                        %mo ∘
                        %mi i
                        %mo =
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 0
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"}
                        t \circ i = s \circ i =   id_{\mathcal{G}_0}, \;\;\;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∘
                      %annotation{:encoding => "application/x-tex"} \circ
                  defines a partial
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  operation which is
                  %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
                  and
                  %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒢
                          %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i(\mathcal{G}_0)
                  the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/identities"} identities
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ∘
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s (g \circ f) = s(f)
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi t
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} t (g \circ f) = t(g)
              %li
                %p
                  every morphism has an
                  %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
                  under this composition.
          #NerveOfGroupoid.num_defn
            %h6#definition_16 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              = succeed "," do
                %a.maruku-ref{:href => "#Groupoid"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+nerve"} simplicial nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} N(\mathcal{G}_\bullet)_\bullet
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≔
                    %msubsup
                      %mi 𝒢
                      %mn 1
                      %mrow
                        %msubsup
                          %mo ×
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 0
