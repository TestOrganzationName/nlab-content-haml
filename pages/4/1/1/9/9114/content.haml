                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mo •
                      %mi I
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)^I_\bullet
              whose objects are elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
