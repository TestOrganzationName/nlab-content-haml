                                    %mo ≃
                              %mtd
                                %mo ⇙
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                              %mtd
                                %mo ↖
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↗
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi X
                                  %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; X_1
                        \\\
