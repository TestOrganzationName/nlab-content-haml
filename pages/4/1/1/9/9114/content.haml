          .proof
            %h6#proof_3 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#GroupoidInSpanOneIsSelfDual"}
              the
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              of the identity is given by the composite span
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %munder
                              %mo ×
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi Π
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi S
                                  %mn 1
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} ]
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mo ⇙
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; &amp;&amp; X \underset{[\Pi_1(S^1), X]}{\times} X
                    \\\
                    \&amp;&amp; &amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \&amp;&amp; X &amp;&amp; \swArrow &amp;&amp; X
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                    \\\
