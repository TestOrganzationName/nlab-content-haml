                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    KanCplx \hookrightarrow sSet
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of Kan complexes, which is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of that of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              on the Kan complexes.
          .num_remark
            %h6#remark_14 Remark
            %p
              This means that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} X_\bullet,Y_\bullet \in KanCplx
              two Kan complexes, an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon X_\bullet \to Y_\bullet
              in the
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi KanCplx
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{KanCplx}(X_\bullet,Y_\bullet)
              is
            %ul
              %li
                a sequences of
                %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mi n
                      %mo →
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f_n \colon X_n \to Y_n
                for all
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p such that
            %ul
              %li
                these respect all the face maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi k
                    %annotation{:encoding => "application/x-tex"} d_k
                and the degeneracy maps
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mi k
                      %annotation{:encoding => "application/x-tex"} s_k
          #MappingObjectOfKanComplexes.num_defn
            %h6#definition_18 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} X_\bullet,Y_\bullet \in KanCplx
              two Kan complexes, their
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"}
                    Maps(X_\bullet,Y_\bullet)_\bullet \in KanCplx
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi sSet
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ×
                    %msubsup
                      %mi Δ
                      %mo •
                      %mi n
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Maps(X_\bullet,Y_\bullet) \colon [k] \mapsto Hom_{sSet}(X_\bullet \times \Delta^n_\bullet, Y_\bullet)
                    \\,.
          .num_prop
            %h6#proposition_10 Proposition
            %p
              The construction in def.
              %a.maruku-ref{:href => "#MappingObjectOfKanComplexes"}
              defines an
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              of Kan complexes.
          .num_remark
            %h6#remark_15 Remark
            %p
              As such it is also common to write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^X
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Maps(X,Y)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [X,Y]
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Maps(X,Y)
          %p
            It follows that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KanCplx
                %annotation{:encoding => "application/x-tex"} KanCplx
            is naturally
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over itself.
          %p We now have the following immediate generalizations of the corresponding constructions seen above for 1-groupoids.
          #PathSpaceObjectOfKanComplexes.num_example
            %h6#example_18 Example
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo •
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    I_\bullet \coloneqq \{0 \stackrel{\simeq}{\to} 1\}
            %p
              for the Kan complex which is
              %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-groupoid
              with two objects and one nontrivial morphism and its inverse between them. This comes with two inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"}
                    i_0, i_1 \colon \ast \to I
            %p of its endpoints.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in KanCplx
              any other Kan complex, the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [I,X]_\bullet
              from def.
              %a.maruku-ref{:href => "#MappingObjectOfKanComplexes"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi I
                      %mo •
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet \stackrel{[i_0,X_\bullet]}{\leftarrow} [I_\bullet,X_\bullet]_\bullet \stackrel{[i_1,X]}{\to} X_\bullet
                    \\,.
          %p
            A 1-cell in the mapping Kan complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mo •
                  %mo ,
                  %msub
                    %mi Y
                    %mo •
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [X_\bullet, Y_\bullet]_\bullet
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            between two morphisms of Kan complexes:
          .num_defn
            %h6#definition_19 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo ,
                    %msub
                      %mi g
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet, g_\bullet \colon X_\bullet \to Y_\bullet
              two morphisms between two Kan complexes, hence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo •
                      %mo ,
                      %msub
                        %mi g
                        %mo •
                      %mo ∈
                      %msub
                        %mi Hom
                        %mi KanCplx
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_\bullet,g_\bullet \in Hom_{KanCplx}(X,Y)
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo ⇒
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \eta \colon f \Rightarrow g
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi I
                      %mo •
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \eta_\bullet \colon X_\bullet \to [I_\bullet,X_\bullet]_\bullet
              into the
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              of def.
              %a.maruku-ref{:href => "#PathSpaceObjectOfKanComplexes"}
              such that we have a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mo •
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mi i
                                    %mn 0
                                  %mo ,
                                  %msub
                                    %mi X
                                    %mo •
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi η
                                  %mo •
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi I
                              %mo •
                            %mo ,
                            %msub
                              %mi Y
                              %mo •
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi g
                                    %mo •
                            %mo ↘
                          %mtd
                            %msub
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mi i
                                    %mn 1
                                  %mo ,
                                  %msub
                                    %mi X
                                    %mo •
                                  %msub
                                    %mo{:stretchy => "false"} ]
                                    %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                            %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y_\bullet
                    \\\
                    \&amp; {}^{\mathllap{f_\bullet}}\nearrow &amp; \uparrow^{\mathrlap{[i_0, X_\bullet]_\bullet}}
                    \\\
                    X_\bullet &amp;\stackrel{\eta_\bullet}{\to}&amp; [I_\bullet, Y_\bullet]
                    \\\
                    \&amp; {}_{\mathllap{g_\bullet}}\searrow &amp; \downarrow_{\mathrlap{[i_1, X_\bullet]_\bullet}}
                    \\\
                    \&amp;&amp;  Y \bullet
                    }
                    \\,.
          .num_remark
            %h6#remark_16 Remark
            %p
              Hence a
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              between two maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet \to Y_\bullet
              of Kan complexes is precisely a 1-cell in the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [X_\bullet, Y_\bullet]_\bullet
              of def.
              = succeed "." do
                %a.maruku-ref{:href => "#MappingObjectOfKanComplexes"}
          #HomotopyEquivalenceOfKanComplexes.num_defn
            %h6#definition_20 Definition
            %p
              We say that a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet \to Y_\bullet
              of
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              if it has a left and right
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi X
                        %mo •
                      %mo ,
                      %msub
                        %mi Y
                        %mo •
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi_0[X_\bullet, Y_\bullet]
          .num_example
            %h6#example_19 Example
            %p
              For Kan complexes which are
              %a.existingWikiWord{:href => "/nlab/show/1-groupoids"} 1-groupoids
              hence which are
              %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyEquivalenceOfGroupoids"}
          #KanComplexesAsHomotopyTypes.num_defn
            %h6#definition_21 Definition
            %p
              We may write
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"} KanCplx
              regarded as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KanCplx
                    %annotation{:encoding => "application/x-tex"} KanCplx
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (without the subscript) for a Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              regarded as an object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \infty Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (or its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              itself “is” the canonical
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
          %p
            The following is the immediate generalization of def.
            = succeed "." do
              %a.maruku-ref{:href => "#HomotopyFiberProductOfGroupoids"}
          #HomotopyFiberProductOfKanComplexes.num_defn
            %h6#definition_22 Definition
            %p
              Given two morphisms of
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ←
                      %mi f
                    %mi B
                    %mover
                      %mo →
                      %mi g
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\leftarrow} B \stackrel{g}{\to} Y
              their
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %munder
                              %mo ×
                              %mi B
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo →
                              %mi g
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \underset{B}{\times} Y
                    \&amp;\stackrel{}{\to}&amp; X
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    Y &amp;\underset{g}{\to}&amp; B
                    }
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mo •
                            %munder
                              %mo ×
                              %mrow
                                %msub
                                  %mi B
                                  %mo •
                            %msubsup
                              %mi B
                              %mo •
                              %mi I
                            %munder
                              %mo ×
                              %mrow
                                %msub
                                  %mi B
                                  %mo •
                            %msub
                              %mi Y
                              %mo •
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi B
                              %mo •
                              %mi I
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ev
                                  %mn 0
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mo •
                          %mtd
                            %msub
                              %mi B
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ev
                                    %mn 1
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo •
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mo •
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msub
                                  %mi g
                                  %mo •
                          %mtd
                            %msub
                              %mi B
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_\bullet \underset{B_\bullet}{\times} B^I_\bullet
                    \\underset{B_\bullet}{\times} Y_\bullet
                    \&amp;\to&amp; &amp;\to&amp; X_\bullet
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{f_\bullet}}
                    \\\
                    \&amp;&amp; B^I_\bullet &amp;\underset{(ev_0)_\bullet}{\to}&amp; B_\bullet
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{(ev_1)_\bullet}}
                    \\\
                    Y_\bullet &amp;\underset{g_\bullet}{\to}&amp; B_\bullet
                    }
                    \\,,
            %p
              hence the ordinary iterated
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              over the
              %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
              Kan complex, as indicated.
          %h6#DoldKanCorrespondenceInPrequantumFieldTheory
            Higher phases: Homological algebra and abelian
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            An important class of examples of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            are those which are presented under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            by
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            of abelian groups.
          %p
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
          .num_defn
            %h6#definition_23 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ch
                      %mrow
                        %mo •
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} Ch_{\bullet \geq 0}
              for the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              (of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              in non-negative degree).
            %p
              As usual, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A[n]
              for the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and 0 in all other degrees (the
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/suspension+of+a+chain+complex"} suspension of a chain complex
          .num_defn
            %h6#definition_24 Definition
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/sAb"} sAb
              for the category of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+groups"} simplicial abelian groups
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi sAb
                    %mo →
                    %msub
                      %mi Ch
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\;\colon\;
                    sAb
                    \\to
                    Ch_\bullet
            %p
              for the
              = succeed "-functor," do
                %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet
              to the chain complex whose
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/chains"} chains
              are the non-degenerate elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A_n
              and whose
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is the alternating sum of the face maps of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mo •
                    %annotation{:encoding => "application/x-tex"} A_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %msubsup
                      %mi d
                      %mi i
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d^{N(A)} = \sum_{i = 0}^n (-1)^i d^A_i
                    \\,.
          %p Of relevance now are the following two standard facts.
          #DoldKanAndMooreTheorem.num_prop
            %h6#proposition_11 Proposition
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"}> Dold-Kan
                  \: The functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi Ch
                          %mrow
                            %mo •
                            %mo ≥
                            %mn 0
                        %mo →
                        %mi sAb
                      %annotation{:encoding => "application/x-tex"} N \colon Ch_{\bullet \geq 0} \to sAb
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ξ
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi Ch
                          %mrow
                            %mo •
                            %mo ≥
                            %mn 0
                        %mover
                          %mo →
                          %mo ≃
                        %mi sAb
                      %annotation{:encoding => "application/x-tex"}
                        \\Xi \colon Ch_{\bullet \geq 0} \stackrel{\simeq}{\to} sAb
                %p
                  sends a chain complex to the simplicial abelian group whose
                  = succeed "-simplices" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(\mathbb{Z}(\Delta^n))
                  of chains
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}(\Delta^n)
                  the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %li
                %p
                  %a{:href => "simplicial+group#MooreTheorem"}> Moore
                  \: The
                  %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sAb
                        %mo →
                        %mi sSet
                      %annotation{:encoding => "application/x-tex"} sAb \to sSet
                  which sends a simplicial abelian group to its underlying simplicial set factors through Kan complexes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi forget
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi sAb
                        %mo →
                        %mi KanCplx
                        %mo ↪
                        %mi sSet
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        forget \; \colon \; sAb \to KanCplx \hookrightarrow sSet
                        \\,.
          %p Taken together, this provides us with the following very useful construction.
          #DoldKanMap.num_defn
            %h6#definition_25 Definition
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DK
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ch
                      %mrow
                        %mo •
                        %mo ≥
                        %mn 0
                    %munderover
                      %mo →
                      %mo ≃
                      %mi Ξ
                    %mi sAb
                    %mover
                      %mo →
                      %mi forget
                    %mi KanCplx
                    %mo ↪
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    DK \;\colon\;
                    Ch_{\bullet \geq 0}
                    \\underoverset{\simeq}{\Xi}{\to}
                    sAb
                    \\stackrel{forget}{\to}
                    KanCplx
                    \\hookrightarrow
                    sSet
            %p
              for the composite of the two functors of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#DoldKanAndMooreTheorem"}
          %p
            We refer to this as the “Dold-Kan map”, or say “by Dold-Kan”, etc. It provides us with a rich supply of Kan complexes, hence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            into the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            in that it is a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
          #DoldKanRespectsWeakEquivalences.num_prop
            %h6#proposition_12 Proposition
            %p
              The Dold-Kan map of def.
              %a.maruku-ref{:href => "#DoldKanMap"}
              sends
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              to
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyEquivalenceOfKanComplexes"}
          %p Notably we have the following example
          .num_defn
            %h6#definition_26 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi DK
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi KanCplx
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}^n \flat U(1) \coloneqq DK(\flat U(1)[n])
                    \\in KanCplx
            %p
              for the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/suspension+of+a+chain+complex"} suspension
              of the
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              Kan complex of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \flat U(1)
          .num_example
            %h6#example_20 Example
            %p
              Since the first
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              that contains a non-degenerate
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n\flat U(1)
              is trivial in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \lt n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                    %mo =
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}^n \flat U(1))_{k \lt n} = \ast
                    \\,.
            %p
              Then since there is a unique non-degenerate
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              we next have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}^n \flat U(1))_{n} = \flat U(1)
                    \\,.
            %p
              Next there are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+2)
              non-degenrate
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \Delta^{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              of their images in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \flat U(1)
              determines the last one (as their oriented product), hence next
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mo ×
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}^n \flat U(1))_{n+1} = (\flat U(1))^{\times^{n+1}}
                    \\,.
            %p
              Similarly for arbitary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}^n \flat U(1))_k
              is some
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian power
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \flat U(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \flat U(1)
              as an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
          %p
            Below in
            %em
              %a{:href => "#HigherChern-SimonsLocalPrequantumFieldTheory"} Higher Chern-Simons theory
            the
            %em smooth
            version of the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            plays a role. In order to amplify that here we are just dealing with the
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            underlying
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♭
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi disc
                %annotation{:encoding => "application/x-tex"}
                  \\flat U(1) \coloneqq U(1)_{disc}
          %p for it.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mo ♭
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi disc
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^n \flat U(1) \coloneqq DK([U(1)_{disc}[n]])
                  \\,.
          .num_prop
            %h6#proposition_13 Proposition
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \flat U(1)
              is naturally an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              and its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              is indeed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^{n+1}\flat U(1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega \mathbf{B}^{n+1} \flat U(1) \simeq \mathbf{B}^n \flat U(1)
                    \\,.
          %h5#local_dw_action_functionals_higher_group_cohomology Local DW action functionals: Higher group cohomology
          #GroupCohomologyByHomotopyClassesOfMaps.num_prop
            %h6#proposition_14 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a discrete
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Grp
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi Grpd
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{Grp}^n(G,A) \simeq \pi_0 Grpd_\infty(\mathbf{B}G, \mathbf{B}^n A)
            %p
              between the degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and the connected components of maps of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              from the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              to the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            This means that local action functionals for higher Dijkgraaf-Witten type theories, hence maps of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msubsup
                    %mi S
                    %mi DW
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo ♭
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mo ♭
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i S_{DW}^n) \colon \mathbf{B} \flat G \to \mathbf{B}^n \flat U(1)
            are equivalently
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi c
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msubsup
                    %mi H
                    %mi Grp
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo ♭
                  %mi G
                  %mo ,
                  %mo ♭
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [c] \in H^n_{Grp}(\flat G,\flat U(1))
            in degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msubsup
                    %mi S
                    %mi DW
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S_{DW}^n) = \mathbf{B}c
                  \\,.
          %p
            In particular the original 3d
            %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theory"} Dijkgraaf-Witten theory
            appears this way as the theory of a group 3-cocycle.
          %p (…)
          %h3#HigherChern-SimonsLocalPrequantumFieldTheoryLevels Higher Chern-Simons local prequantum field theory – Levels
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in Grp(\mathbf{H})
            be a simply connected compact simple Lie group. and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ∈
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in Smooth\infty Grpd
            for its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            stack. By the discussion at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Lie+group+cohomology"} Lie group cohomology
            there is a bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi Grp
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi ℤ
                  %msub
                    %mo{:stretchy => "false"} }
                    %mo ∼
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n_{Grp}(G,\mathbb{Z})
                  \\simeq
                  \\{\mathbf{B}G \to \mathbf{B}^n \mathbb{Z}\}_\sim
                  \\,.
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mn 2
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ⟶
                  %msup
                    %mi B
                    %mn 4
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c}_2 \colon \mathbf{B}G\longrightarrow B^4 \mathbb{Z}
          %p
            for a representative of the
            %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
            under this bijection. We may regard this map as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mn 2
                  %mo ∈
                  %msub
                    %mi Corr
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi B
                        %mn 4
                      %mi ℤ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mo ⊗
                        %mi phased
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c}_2 \in Corr_3(\mathbf{H}_{/B^4 \mathbb{Z}})^{\otimes_{phased}}
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+correspondences"} (∞,n)-category of correspondences
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi B
