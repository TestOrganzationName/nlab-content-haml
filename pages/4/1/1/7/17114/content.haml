                        %msub
                          %mi n
                          %mn 2
                    %mover
                      %mo ⟶
                      %mi σ
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ∧
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    b_{n_1,n_2}
                    \\;\colon\;
                    S^{n_1} \wedge S^{n_2}
                    \\stackrel{\sigma}{\longrightarrow}
                    S^{n_2} \wedge S^{n_1}
            %p
              is given by permuting the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x_1, \cdots, x_{n_1}, y_1, \cdots, y_{n_2})
                    \\mapsto
                    (y_1, \cdots, y_{n_2}, x_1, \cdots, x_{n_1})
                    \\,.
            %p
              This has
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+map"} degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} (-1)^{n_1 n_2}
              \.
          %p
            This statement passes to the
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectra"} suspension spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Sigma^\infty S^n
            of the spheres (
            %a{:href => "#Adams74"}> Adams 74, part III, prop. 4.8
            ,
            = succeed ")." do
              %a{:href => "#Schwede12"} Schwede 12, chapter II.4, prop. 4.4
          #WhySequentialSpectraHaveNoSymmetricSmashProduct.num_remark
            %h6#remark Remark
            %p
              The phenomenon in prop.
              %a.maruku-ref{:href => "#GradedCommutativityOfSmashOfSpheres"}
              is the reason why there is no
              %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+product+of+spectra"} symmetric smash product of spectra
              on plain
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            %p
              To see this, observe, by
              = succeed "," do
                %a{:href => "sequential+spectrum#QuillenEquivalenceBetweenSequentialBFAndExcisiveFunctors"} this proposition
              %a.existingWikiWord{:href => "/nlab/show/excisive+%28infinity%2C1%29-functors"} excisive (infinity,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Exc
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %msubsup
                      %mi Grpd
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %msubsup
                      %mi Grpd
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Exc^1(\infty Grpd^{\ast/}_{fin}, \infty Grpd^{\ast/}) \hookrightarrow
                    Func(\infty Grpd^{\ast/}_{fin}, \infty Grpd^{\ast/})
            %p
              under an equivalence given by restricting from the domain of all
              %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+types"} pointed
              %a.existingWikiWord{:href => "/nlab/show/finite+homotopy+types"} finite homotopy types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %msubsup
                      %mi Grpd
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \infty Grpd_{fin}^{\ast/}
              to its non-full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi StdSpheres
                  %annotation{:encoding => "application/x-tex"} StdSpheres
              of standard spheres with just the adjuncts of suspension maps between them.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %mi StdSpheres
                    %mo ↪
                    %mn ∞
                    %msubsup
                      %mi Grpd
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \colon StdSpheres \hookrightarrow \infty Grpd^{\ast/}_{fin}
                    \\,.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Exc
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %msubsup
                      %mi Grpd
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msup
                          %mi ι
                          %mo *
                    %mi SeqSpectra
                  %annotation{:encoding => "application/x-tex"}
                    Exc^1(\infty Grpd^{\ast/}_{fin}, \infty Grpd^{\ast/})
                    \\underoverset{\simeq}{\iota^\ast}{\longrightarrow}
                    SeqSpectra
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi StdSpheres
                  %annotation{:encoding => "application/x-tex"} StdSpheres
              has objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi std
                      %mi n
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∧
                        %mi n
                  %annotation{:encoding => "application/x-tex"} S^n_{std} \coloneqq (S^1)^{\wedge n}
              and as hom-spaces it has
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi StdSpheres
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mi m
                      %mo ,
                      %msup
                        %mi S
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi S
                        %mrow
                          %mi max
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mi m
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} StdSpheres(S^{m}, S^{n}) = S^{max(n-m,0)}
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of the canonical isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi m
                      %mo ∧
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mi m
                      %mo →
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^m \wedge S^{n-m} \to S^n
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \iota^\ast
              identifies the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(S^n)
              of an excisive functor on the
              = succeed "-sphere," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi E
                      %mi n
                    %mo →
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1 \wedge E_n \to E_{n+1}
              with part of the
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functoriality
              of the excisive functor.
            %p
              Now in the model category of excisive functors, the correct smash product of spectra is the
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              over the symmetric monoidal category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %msubsup
                        %mi Grpd
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ,
                      %mo ∧
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty Grpd^{\ast/}_{fin},\wedge)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi StdSpheres
                  %annotation{:encoding => "application/x-tex"} StdSpheres
              do not see the non-trivial
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              of spheres in prop.
              %a.maruku-ref{:href => "#GradedCommutativityOfSmashOfSpheres"}
              anymore.
            %p
              More concretely, the enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi StdSpheres
                  %annotation{:encoding => "application/x-tex"} StdSpheres
              does not inherit monoidal structure: defining the smash product on hom spaces requires permuting smash copies of spheres, which is not available. Thus there is no Day convolution product on sequential spectra at all.
            %p
              One could further restrict along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo →
                    %mi StdSpheres
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \to StdSpheres
              and use the monoidal structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N},+)
              to define at least a smash product on sequences of pointed spaces by
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N},+)
              as in (
              %a{:href => "#MMSS00"}> MMSS 00, example 4.1
              ,
              = succeed ")." do
                %a{:href => "#HoveyShipleySmith00"} Hovey-Shipley-Smith 00, below prop. 2.3.4
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N},+)
              is trivially
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided
              and so, again, under restriction of excisive functors to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              there is no way to recover the information in the smash product of spectra that is encoded in the non-trivial braiding of the smash product of spheres.
          %h2#definitions Definitions
          %ul
            %li
              %p
                %em
                  %a{:href => "sequential+spectrum#SmashProduct"} smash product of sequential spectra
            %li
              %p
                %em
                  %a{:href => "model+structure+for+excisive+functors#SmashProduct"} smash product of excisive functors
            %li
              %p
                %em
                  %a{:href => "symmetric+spectrum#SmashProduct"} smash product of symmetric spectra
            %li
              %p
                %em
                  %a{:href => "orthogonal+spectrum#SmashProduct"} smash product of orthogonal spectra
          %h2#references References
          %p
            The original “handicrafted” constructions of the smash product on the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            are due to
          %ul
            %li#Boardman65
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Boardman"}> Michael Boardman
                ,
                = succeed "," do
                  %em Stable homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rainer+Vogt"}> Rainer Vogt
                ,
                = succeed "," do
                  %em Boardman’s stable homotopy category
            %li#Puppe73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dieter+Puppe"}> Dieter Puppe
                ,
                = succeed "," do
                  %em On the stable homotopy category
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/PuppeStableHomotopyCategory.pdf", :title => "pdf"} pdf
            %li#Adams74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frank+Adams"}> Frank Adams
                , part III, section 4 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Stable+homotopy+and+generalised+homology"} Stable homotopy and generalised homology
          %p
            The smash product on
            %a.existingWikiWord{:href => "/nlab/show/connective+spectra"} connective spectra
            modeled as
            %a.existingWikiWord{:href => "/nlab/show/Gamma+spaces"} Gamma spaces
            is discussed in
          %ul
            %li#Lydakis98
              Lydakis,
              = succeed "," do
                %em
                  Smash products and
                  = succeed "-spaces" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")" do
                %a{:href => "http://hopf.math.purdue.edu/Lydakis/smash_gamma.pdf"} pdf
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+product+on+spectra"} symmetric smash product on spectra
            (see there for more) on
            %a.existingWikiWord{:href => "/nlab/show/highly+structured+ring+spectra"} highly structured ring spectra
            is discussed for instance in
          %p
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/S-modules"} S-modules
          %ul
            %li#ElmendorfKrizMay95
              %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"} Igor Kriz
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Modern+foundations+for+stable+homotopy+theory"} Modern foundations for stable homotopy theory
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ioan+Mackenzie+James"} Ioan Mackenzie James
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Algebraic+Topology"} Handbook of Algebraic Topology
              = succeed ")" do
                %a{:href => "http://hopf.math.purdue.edu/Elmendorf-Kriz-May/modern_foundations.pdf"} pdf
          %p
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
          %ul
            %li#HoveyShipleySmith00
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeff+Smith"} Jeff Smith
                = succeed "," do
                  %em Symmetric spectra
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/9801077"} arXiv:math/9801077
            %li#Schwede12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                = succeed "," do
                  %em Symmetric spectra
                = succeed ")" do
                  %a{:href => "http://www.math.uni-bonn.de/people/schwede/SymSpec-v3.pdf"} pdf
          %p
            Discussion of the smash product as a suitable
            %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            is, for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/highly+structured+spectra"} highly structured spectra
          %ul
            %li#MMSS00
              %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"}> Michael Mandell
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"} Stefan Schwede
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
              = succeed "," do
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/mmssLMSDec30.pdf"} pdf
              = succeed ")" do
                %a{:href => "http://plms.oxfordjournals.org/content/82/2/441.short?rss=1&ssource=mfc"} publisher
          %p
            and for
            %a.existingWikiWord{:href => "/nlab/show/excisive+functors"} excisive functors
            in
          %ul
            %li#Lydakis98
              Lydakis,
              %em Simplicial functors and stable homotopy theory
              Preprint, available via Hopf archive, 1998 (
              %a{:href => "http://hopf.math.purdue.edu/Lydakis/s_functors.pdf"}> pdf
              )
          %p The uniqueness of the smash product on spectra is discussed in
          %ul
            %li#Shipley01
              %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"}> Brooke Shipley
              ,
              = succeed "," do
                %em Monoidal uniqueness of Stable homotopy theory
              = succeed ")" do
                %a{:href => "http://homepages.math.uic.edu/~bshipley/ideal.pdf"} pdf
        .revisedby
