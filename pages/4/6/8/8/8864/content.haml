          %h3#characteristic_classes_of_whitney_sums Characteristic classes of Whitney sums
          #EulerClassOfWhitneySumIsCupProductOfEulerClasses.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
                takes
                %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"} Whitney sum
                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            %p
              The Euler class of the
              %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"} Whitney sum
              of two
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} oriented
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundles"} real vector bundles
              to the
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              of the separate Euler classes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ⊕
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⌣
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi( E \oplus F )
                    \\;=\;
                    \\chi(E)  \smile \chi(F)
                    \\,.
          %p
            For details see at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            = succeed "." do
              %a{:href => "Euler+class#EulerClassOfWhitneySumIsCupProductOfEulerClasses"} this Prop.
