          %h2#examples Examples
          #DirectSumOnDisjointUnionSpace.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \sqcup Y
              for their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
            %p
              Then every
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \sqcup Y
              is the direct sum of a vector bundle that has
              %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              zero on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and one that has rank zero on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p More explicitiy: let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊔
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_X \colon Vect(X) \longrightarrow Vect(X \sqcup Y)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi Y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_Y \colon Vect(Y) \longrightarrow Vect(X \times Y)
            %p
              be the operations of extending a vector bundle on the other
              %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              by a rank-0 vector bundle, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msub
                          %mi i
                          %mi X
                        %msub
                          %mo ⊕
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ⊔
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi i
                          %mi Y
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊔
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Vect(X) \times Vect(Y)
                    \\underoverset{\simeq}{ i_X \oplus_{(X \sqcup Y)} i_Y }{\longrightarrow}
                    Vect(X \sqcup Y)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of vector bundles (and an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              of
              %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"} categories of vector bundles
              before passing to isomorphism classes).
          %h2#properties Properties
          %h3#whitney_summands_of_trivial_vector_bundles Whitney summands of trivial vector bundles
          #TopologicalSubBundlesOverParacompactHausdorffSpacesAreDirectSummands.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (sub-bundles over
                %a.existingWikiWord{:href => "/nlab/show/paracompact+spaces"} paracompact spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct summands
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \to X
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
            %p
              Then every vector subbundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ↪
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E_1 \hookrightarrow E
              is a direct vector bundle summand, in that there exists another vector subbundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo ↪
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E_2 \hookrightarrow E
              such that their direct sum of vector bundles (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DirectSumOfTopologicalVectorBundlesViaTotalspaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi E
                      %mn 2
                    %mo ≃
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_1 \oplus E_2 \simeq E
                    \\,.
          %p
            (
            %a{:href => "#Hatcher"}> e.g. Hatcher, prop. 1.3
            )
          .proof
            %h6#proof Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is assumed to be paracompact Hausdorff, there exists a
              %a.existingWikiWord{:href => "/nlab/show/inner+product+on+vector+bundles"} inner product on vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %msub
                      %mo ⊕
                      %mi X
                    %mi E
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle
                    \\;\colon\;
                    E \oplus_X E
                    \\longrightarrow
                    X \times \mathbb{R}
            %p
              (by
              = succeed ")." do
                %a{:href => "inner+product+of+vector+bundles#ExistenceOfInnerProductOfTopologicalVectorBundlesOverParacompactHausdorffSpaces"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              the
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+complement"} orthogonal complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ′
                      %mi x
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo ⊂
                    %msub
                      %mi E
                      %mi x
                  %annotation{:encoding => "application/x-tex"} (E'_x)^\perp \subset E_x
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msub
                        %mo ′
                        %mi x
                      %mo ↪
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E'_x \hookrightarrow E
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of these orthogonal complements is readily checked to be a
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ′
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ⊥
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} (E')^\perp \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ′
                    %msub
                      %mo ⊕
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ′
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \;\simeq\; E' \oplus_X (E')^\perp
                    \\,.
          #OverCompactHausdorffSpacesEveryTopologicalVectorBundleIsDirectSummandOfATrivialBundle.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (over
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
                every vector bundle is
                %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct summand
                of a trivial bundle)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \to X
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
            %p
              Then there exists another topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tilde E \to X
              such that the direct sum of vector bundles (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DirectSumOfTopologicalVectorBundlesViaTotalspaces"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X \times \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ⊕
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \oplus \tilde E
                    \\;\simeq\;
                    X \times \mathbb{R}^n
                    \\,.
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Hatcher"} Hatcher, prop. 1.4
            = succeed ")" do
              %a{:href => "#Friedlander"} Friedlander, ptop. 3.1
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              has a
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi ϕ
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi U
                          %mi i
                        %mo ×
                        %msup
                          %mi ℝ
                          %mi n
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi E
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\phi_i
                    \\;\colon\;
                    U_i \times \mathbb{R}^n
                    \\overset{\simeq}{\longrightarrow}
                    E\vert_{U_i}
                    \\right\}_{i \in I}
                    \\,.
            %p
              By compactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+cover"} finite sub-cover
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such tat
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\{U_i \subset X\}_{i \in J \subset I}
            %p
              is still an open cover over which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              trivializes.
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+spaces+equivalently+admit+subordinate+partitions+of+unity"} paracompact Hausdorff spaces equivalently admit subordinate partitions of unity
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi f
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    f_i \;\colon\; X \to [0,1]
                    \\right\}_{i \in J}
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} supp(f_i) \subset U_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                          %mtd
                            %mover
                              %mo ⟶
                              %mphantom
                                %mi AAAA
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                            %mi v
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %msub
                              %mi f
                              %mi i
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E\vert_{U_i}
                    \&amp;\overset{\phantom{AAAA}}{\longrightarrow}&amp;
                    U_i \times \mathbb{R}^n
                    \\\
                    v
                    \&amp;\overset{\phantom{AAA}}{\mapsto}&amp;
                    f_i(x) \cdot \phi_i^{-1}(v)
                    }
            %p extend by 0 to vector bundle homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo ⋅
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ⟶
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_i \cdot \phi^{-1}_i
                    \\;\colon\;
                    E
                    \\longrightarrow
                    X \times \mathbb{R}^n
                    \\,.
            %p
              The finite pointwise
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these yields a vector bundle homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                    %msub
                      %mi f
                      %mi i
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo ⊕
                        %mrow
                          %mi i
                          %mo ∈
                          %mi J
                      %msup
                        %mi ℝ
                        %mi n
                      %mo )
                    %mo ≃
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi J
                            %mo{:stretchy => "false"} |
                          %mo ˙
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in J}{\oplus} f_i \cdot \phi_i
                    \\;\colon\;
                    E
                    \\longrightarrow
                    X \times \left(
                    \\underset{i \in J}{\oplus}
                    \\mathbb{R}^n
                    \\right)
                    \\simeq
                    X \times \mathbb{R}^{n \dot {\vert J\vert}}
                    \\,.
            %p
              Observe that, as opposed to the single
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi i
                      %mo ⋅
                      %msubsup
                        %mi ϕ
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} f_i \cdot \phi^{-1}_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              is non-vanishing. Hence this is an injection of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              into a trivial vector bundle.
            %p
              With this the statement follows by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalSubBundlesOverParacompactHausdorffSpacesAreDirectSummands"}
          .num_remark
            %h6#remark Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#OverCompactHausdorffSpacesEveryTopologicalVectorBundleIsDirectSummandOfATrivialBundle"}
              is key for the construction of
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              groups on compact Hausdorff spaces.
          %p
            Remark : Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 1
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} E_1\rightarrow M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 2
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} E_2\rightarrow M
            be vector bundles over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 1
                  %mo ×
                  %msub
                    %mi E
                    %mn 2
                  %mo →
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} E_1\times E_2\rightarrow M\times M
            which is still a vector bundle. Consider diagonal map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo :
                  %mi M
                  %mo →
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} d:M\rightarrow M\times M
            given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m\mapsto (m,m)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 1
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} E_1\rightarrow M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 2
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} E_2\rightarrow M
            is the pull back of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
