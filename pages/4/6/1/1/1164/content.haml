          %p (…)
          %h3#FundamentalCategoryOfAGSpace Equivariant fundamental groupoid
          %p
          #EquivariantFundamentalGroupoid.num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
