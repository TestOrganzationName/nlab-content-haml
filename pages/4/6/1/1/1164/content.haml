          #GActionsAndGOrbits.num_remark
            %h6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/G-set"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
