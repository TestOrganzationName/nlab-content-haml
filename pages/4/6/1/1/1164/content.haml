                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Orb
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \operatorname{Orb}_G
              (denoted also
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi G
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_G
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/homogeneous+spaces"} homogeneous spaces
                  (
                  %a.existingWikiWord{:href => "/nlab/show/coset+spaces"}> coset spaces
                  ,
                  = succeed "-" do
