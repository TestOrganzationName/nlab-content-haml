                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thinmathspace"}
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \; x_X \,\colon\, G/H \to X
                  %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
