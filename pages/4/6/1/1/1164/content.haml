              %a{:href => "#tomDieck87"}> tom Dieck 1987 (10.7)
              ,
              = succeed ")" do
                %a{:href => "#Lueck89"} Lück 1989, 8.15
              %em equivariant fundamental groupoid
              (
              %a{:href => "#PronkScull21"}> Pronk &amp; Scull 2021, Def. 3.1
              )
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  consisting of a
                  %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo ⊂
                        %mi G
                      %annotation{:encoding => "application/x-tex"} H \subset G
                  and a
                  = succeed "-" do
