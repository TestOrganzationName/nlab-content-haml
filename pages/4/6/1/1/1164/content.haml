                %use{:x => "264.08", "xlink:href" => "#TLwot0Ir8sfJC1pnbe749hgL23U=-glyph-7-1", :y => "27.302"}
            %p
              That the right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is fully faithful is most readily seen by direct inspection: A map between
              = succeed "-sets" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi G
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{G}
              acts only through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is evidently
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi G
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{G}
              = succeed "-equivariant." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbit"}> orbit
                ,
                %a.existingWikiWord{:href => "/nlab/show/orbit+type"} orbit type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/global+orbit+category"}> global orbit category
                ,
                %a.existingWikiWord{:href => "/nlab/show/global+equivariant+stable+homotopy+theory"} global equivariant stable homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bredon+cohomology"}> Bredon cohomology
                ,
                %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/vector+G-space"} vector G-space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+dgc-algebra"} equivariant dgc-algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+rational+homotopy+theory"} equivariant rational homotopy theory
          %h2#references References
          %p
            The notion of the orbit category (for use in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Bredon+cohomology"} Bredon cohomology
          %ul
            %li#Bredon67b
              %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
              , Section I.3. of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Equivariant+cohomology+theories"} Equivariant cohomology theories
              = succeed ")" do
                %a{:href => "https://link.springer.com/book/10.1007/BFb0082690"} doi:10.1007/BFb0082690
          %p announced in
          %ul
            %li#Bredon67a
              %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
              ,
              = succeed "," do
                %em Equivariant cohomology theories
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/euclid.bams/1183528794"} educlid:1183528794
          %p
            and there considered specifically for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
          %p
            Discussion for any
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            (and further generalization) is considered (together with the
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category theoretic
            proof of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
          %ul
            %li#DwyerKan84
              %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
              = succeed "," do
                %em Singular functors and realization functors
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/1385-7258(84)90016-7"} doi:10.1016/1385-7258(84)90016-7
          %p Textbook accounts:
          %ul
            %li#tomDieck87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                , Section I.10 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Transformation+Groups"} Transformation Groups
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1515/9783110858372"} doi:10.1515/9783110858372
            %li#Lueck89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wolfgang+L%C3%BCck"}> Wolfgang Lück
                , (8.16) in
                = succeed "," do
                  %em Transformation Groups and Algebraic K-Theory
                %strong 1408
                (Springer 1989) (
                %a{:href => "https://doi.org/10.1007/BFb0083681"}> doi:10.1007/BFb0083681
                )
            %li#May96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                , Section I.4 of:
                %em Equivariant homotopy and cohomology theory
                CBMS Regional Conference Series in Mathematics, vol. 91, Published for the Conference Board of the Mathematical Sciences, Washington, DC, 1996 (
                %a{:href => "https://bookstore.ams.org/cbms-91"}> ISBN:978-0-8218-0319-6
                ,
                = succeed "," do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/alaska.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://ncatlab.org/nlab/files/MayEtAlEquivariant96.pdf"} pdf
          %p Lecture notes:
          %ul
            %li#tomDieck09
              %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
              , Section 1.3 of:
              = succeed "," do
                %em Representation theory
              = succeed ")" do
                %a{:href => "http://www.uni-math.gwdg.de/tammo/rep.pdf"} pdf
          %p
            For more in relation to
            %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"} global equivariant homotopy theory
            see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Global+Homotopy+Theory+and+Cohesion"} Global Homotopy Theory and Cohesion
          %p
            The notion of fundamental category of a
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %ul
            %li
              %p
                %a{:href => "#tomDieck87"} tom Dieck 1987
            %li
              %p
                %a{:href => "#Lueck89"} Lück 1989, 8.15
          %p with further discussion in
          %ul
            %li#PronkScull21
              %a.existingWikiWord{:href => "/nlab/show/Dorette+Pronk"}> Dorette Pronk
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Laura+Scull"} Laura Scull
              = succeed "," do
                %em The Equivariant Fundamental Groupoid as an Orbifold Invariant
              %strong 23
              1 (2021) (
              %a{:href => "https://arxiv.org/abs/1908.01201"}> arXiv:1908.01201
              ,
              = succeed ")" do
                %a{:href => "https://dx.doi.org/10.4310/HHA.2021.v23.n1.a3"} doi:10.4310/HHA.2021.v23.n1.a3
        .revisedby
