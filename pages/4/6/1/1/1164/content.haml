                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi x
                          %mi H
                        %mover
                          %mo →
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi γ
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mi x
                        %msub
                          %mo ′
                          %mrow
                            %mi H
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} \;\;x_H \xrightarrow{ (\phi,[\gamma]) } x'_{H'}
                  are
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  consisting of a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi H
                        %mover
                          %mo →
                          %mi ϕ
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi H
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} G/H \xrightarrow{ \phi } G/H'
                  and a relative
                  = succeed "-homotopy" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi γ
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\gamma]
                  of a continuous path
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi G
