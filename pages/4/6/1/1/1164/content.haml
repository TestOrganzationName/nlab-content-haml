                  %annotation{:encoding => "application/x-tex"} G \curvearrowright X \,\in\, G Act(TopSp)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+G-space"}
                  topological
                  = succeed "-space" do
