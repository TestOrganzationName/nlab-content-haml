          .num_remark
            %h6#remark Remark
            %p
              Warning: This should not be confused with the situation where a group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acts on a groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              so that one obtains the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orbit+groupoid"} orbit groupoid
          .num_remark
            %h6#remark_2 Remark
            %p
              For suitable
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              %a.existingWikiWord{:href => "/nlab/show/actions"} actions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              of the action is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to one of the
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
              (the
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+group"} stabilizer group
              of any point in the orbit is conjugate to
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.maruku-ref{:href => "#TheOrbitCategory"}
