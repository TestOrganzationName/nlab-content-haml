          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#abstract"} Abstract
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#statement"} Statement
              %li
                %a{:href => "#preconditions_needed_for_the_proof"} Preconditions Needed for the Proof
