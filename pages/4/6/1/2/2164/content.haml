          .num_remark
            %h6#remark_2 Remark
            %p
              Since in particular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi x
                      %mi j
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x_j^2 = 0
              for all elements of the infinitesimal
              = succeed "-disk," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    D(n) \subset D^n
            %p
              which is proper if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo &gt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \gt 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D(1) = D
            %p
              While
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(n)
              is closed under multiplication by elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %msub
                      %mi d
                      %mn 2
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi D
                  %annotation{:encoding => "application/x-tex"} d_1,d_2 \in D(1) = D
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo +
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d_1 + d_2
              (the operation being in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %msub
                      %mi d
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d_1,d_2)
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(2)
          %h3#the_infinitesimal_neighbourhood The infinitesimal neighbourhood
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            a point in a manifold, the infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi p
                %annotation{:encoding => "application/x-tex"} U_p
            is the intersection of all open neighbourhoods of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f : X \to \mathbb{R}
            along the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi p
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U_p \to X
            is precisely the “infinitesimal
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/germ"} germ
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p All of the infinitesimal spaces above are contained in the corresponding infinitesimal neighbourhood. So this is the “largest” of the infinitesimal spaces discussed here.
          %h3#SpacOfInfSimpl
            Spaces of infinitesimal
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %blockquote
            %p
              Much of this is being reworked at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+algebroid"} infinity-Lie algebroid
          %h4#idea_2 Idea
          %p
            An
            %strong
              infinitesimal
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mi n
                %annotation{:encoding => "application/x-tex"} R^n
            based at the origin is a collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi ϵ
                      %mo{:stretchy => "false"} →
                    %mi i
                  %mo ∈
                  %msup
                    %mi R
                    %mi n
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi k
                %annotation{:encoding => "application/x-tex"} (\vec \epsilon_i \in R^n)_{i = 1}^k
            of points in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                  %annotation{:encoding => "application/x-tex"} R^n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi i
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mover
                      %mi ϵ
                      %mo{:stretchy => "false"} →
                    %mi i
                  %mo ∼
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\forall i : \;\; \vec \epsilon_i \sim 0
          %p and each are infinitesimal neighbours of each other
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi i
                  %mo ,
                  %mi j
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi ϵ
                      %mo{:stretchy => "false"} →
                    %mi i
                  %mo −
                  %msub
                    %mover
                      %mi ϵ
                      %mo{:stretchy => "false"} →
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\forall i,j: \;\; (\vec \epsilon_i - \vec \epsilon_j) \sim 0
                  \\,.
          %p Following section 1.2 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
              ,
              %em Synthetic differential geometry of manifolds
              (
              %a{:href => "http://home.imf.au.dk/kock/SGM-final.pdf"}> pdf
              )
          %p
            we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tilde D(k,n)
            for the space of all infinitesimal
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                  %annotation{:encoding => "application/x-tex"} R^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\tilde D(k,n))
            defined as follows.
          %p
            Functions on spaces of infinitesimal
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-differential" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi x
                  %mo ∧
                  %mi dy
                %annotation{:encoding => "application/x-tex"} d x \wedge dy
            etc as products of infinitesimals. As the following computations do show, the skew-commutativity of the wedge product is an inherent consequence of the nature of infinitesimals.
          %h4#definition_2 Definition
          .num_defn
            %h6#definition_3 Definition
            %p
              The algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\tilde D(k,n))
              is the commutative
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \times n
              generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mi i
                      %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi i
                        %mo ≤
                        %mi n
                        %mo ,
                        %mn 1
                        %mo ≤
                        %mi j
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} (\epsilon_i^j)_{1 \leq i \leq n, 1 \leq j \leq n}
              subject to the relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi i
                    %mo ,
                    %mi j
                    %mo ,
                    %mi j
                    %mo ′
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ϵ
                      %mi i
                      %mi j
                    %msubsup
                      %mi ϵ
                      %mi i
                      %mrow
                        %mi j
                        %mo ′
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\forall i, j,j' : \;\; \epsilon_i^{j} \epsilon_i^{j'} = 0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi i
                    %mo ,
                    %mi i
                    %mo ′
                    %mo ,
                    %mi j
                    %mo ,
                    %mi j
                    %mo ′
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mi i
                      %mi j
                    %mo −
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi i
                        %mo ′
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϵ
                      %mi i
                      %mrow
                        %mi j
                        %mo ′
                    %mo −
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi i
                        %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\forall i,i',j,j'   : \;\;\;
                    (\epsilon_i^j - \epsilon_{i'}^j) (\epsilon_i^{j'} - \epsilon_{i'}^{j'}) = 0
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p By multiplying out the latter set of relations and using the former, these relations are seen to be equivalent to the set of relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi i
                    %mo ,
                    %mi i
                    %mo ′
                    %mo ,
                    %mi j
                    %mo ,
                    %mi j
                    %mo ′
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ϵ
                      %mi i
                      %mi j
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi i
                        %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo +
                    %msubsup
                      %mi ϵ
                      %mrow
                        %mi i
                        %mo ′
                      %mi j
                    %msubsup
                      %mi ϵ
                      %mi i
                      %mrow
                        %mi j
                        %mo ′
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\forall i,i',j,j' : \;\;\;
                    \\epsilon_i^j \epsilon_{i'}^{j'}
                    + \epsilon_{i'}^j \epsilon_{i}^{j'} = 0
                    \\,.
            %p Notice that this implies also that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
