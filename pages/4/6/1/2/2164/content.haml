                              %mi ϵ
                              %mn 1
                              %mn 2
                            %mo +
                            %msub
                              %mi b
                              %mn 1
                            %msubsup
                              %mi ϵ
                              %mn 2
                              %mn 1
                            %mo +
                            %msub
                              %mi b
                              %mn 2
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ω
                              %mn 1
                            %msub
                              %mi λ
                              %mn 2
                            %mo −
                            %msub
                              %mi ω
                              %mn 2
                            %msub
                              %mi λ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mfrac
                              %mn 1
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 1
                            %msubsup
                              %mi ϵ
                              %mn 2
                              %mn 2
                            %mo −
