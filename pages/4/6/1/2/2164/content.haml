                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\tilde D(k,n))_{top} \subset C^\infty(\tilde D(k,n))
          %h4#the_tangent_lie_algebroid_and_differential_forms The tangent Lie algebroid and differential forms
          %p
            The collection of the spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mi n
                  %mo ×
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} (
                  %mi k
