              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde D(k,n)
              is regarded as an object of a suitable
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Alg
                      %mi ℝ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Alg_{\mathbb{R}}^{op}
              or in the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
