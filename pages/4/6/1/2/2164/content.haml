                            %mo{:stretchy => "false"} (
                            %mi ω
                            %mo ⋅
                            %msub
                              %mi ϵ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo ⋅
                            %msub
                              %mi ϵ
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi f
                            %mo +
                            %msub
                              %mi a
                              %mn 1
                            %msubsup
                              %mi ϵ
                              %mn 1
                              %mn 1
                            %mo +
