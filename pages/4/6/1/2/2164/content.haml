            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mn 1
                    %mo ∧
                    %msup
                      %mi ω
                      %mn 2
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msup
                      %mi ω
                      %mi k
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ω
