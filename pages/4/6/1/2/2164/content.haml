                              %mi ϵ
                              %mn 2
                              %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    f
                    +
                    a \cdot \epsilon_1
                    + b \cdot \epsilon _2
                    + (\omega \cdot \epsilon_1) (\lambda \cdot \epsilon_2)
                    \&amp;=
                    f +
                    a_1 \epsilon_1^1
                    + a_2 \epsilon_1^2
                    + b_1 \epsilon_2^1
                    + b_2 \epsilon_1^2
                    \\\
                    \&amp; + (\omega_1 \lambda_2 - \omega_2 \lambda_1)
                    \\frac{1}{2}(\epsilon_1^1 \epsilon_2^2 - \epsilon_1^2 \epsilon_2^1)
                    \\end{aligned}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \in \mathbb{R}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi ω
                    %mo ,
                    %mi λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
