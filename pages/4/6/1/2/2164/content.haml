                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k = 2
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
