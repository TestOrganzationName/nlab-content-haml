          .num_prop
            %h6#proposition Proposition
            %p
              The elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi D
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi k
