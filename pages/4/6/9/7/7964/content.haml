                %a.existingWikiWord{:href => "/nlab/show/Yutaka+Hosotani"}> Yutaka Hosotani
                ,
                = succeed "," do
                  %em Gauge-Higgs EW and Grand Unification
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1606.08108"} arXiv:1606.08108
            %li#Hosotani17
