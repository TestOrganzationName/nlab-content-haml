            %li#HINSS18
              %p
                Manami Noumi Hashi, Hiroshi Isono, Toshifumi Noumi,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gary+Shiu"} Gary Shiu
                = succeed "," do
                  %em Higgs Mechanism in Nonlocal Field Theories
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1805.02676"} arXiv:1805.02676
          %p
