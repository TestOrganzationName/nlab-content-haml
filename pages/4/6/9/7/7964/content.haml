            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/inflaton+field"} inflaton field
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/composite+Higgs+model"} composite Higgs model
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higgsino"} higgsino
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Higgs+bundle"} Higgs bundle
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
                %a.existingWikiWord{:href => "/nlab/show/standard+model+of+cosmology"} and cosmology
            %table
