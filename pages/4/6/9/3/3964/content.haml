          %h1#pointed_derivators Pointed derivators
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#relative_diagram_categories"} Relative diagram categories
                %li
                  %a{:href => "#pointed_exactness"} Pointed exactness
                %li
                  %a{:href => "#extraordinary_inverse_images"} Extraordinary inverse images
                %li
                  %a{:href => "#loop_and_suspension"} Loop and suspension
                %li
                  %a{:href => "#enrichment_over_pointed_sets"} Enrichment over pointed sets
              %li
                %a{:href => "#the_pointed_reflection"} The pointed reflection
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/derivator"} derivator
            is
            %em pointed
            if it has a
            %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            in the sense appropriate to a derivator.
          %h2#definition Definition
          %p
            A derivator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Dia
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} D\colon Dia^{op} \to Cat
            is
            = succeed "," do
              %strong pointed
            = succeed "," do
              %strong zero object
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(X)
            has a zero object.
          %p
            Note that these zero objects are automatically preserved by all the
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo !
                    %mo ,
                    %msup
                      %mi u
                      %mo *
                    %mo ,
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_!,u^*,u_*
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoints
            on one side or the other.
          %h2#properties Properties
          %p This simple definition hides a lot of structure.
          %h3#relative_diagram_categories Relative diagram categories
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a pointed derivator and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ↪
                  %mi B
                %annotation{:encoding => "application/x-tex"} i\colon A\hookrightarrow B
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(B,A)
            for the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mi B
                %annotation{:encoding => "application/x-tex"} D B
            on those diagrams
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi D
                  %mi B
                %annotation{:encoding => "application/x-tex"} X\in D B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} i^*X
            is null.
          #SieveRel.num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is the inclusion of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_*\colon D(A) \to D(B)
              is
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful
              and its
              %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo ∖
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(B,B\setminus A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a cosieve, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
              identifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(A)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo ∖
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(B,B\setminus A)
          .proof
            %h6#proof Proof
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a sieve. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is in particular fully faithful, so is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              by general arguments (see
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+exact+square"} homotopy exact square
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a sieve, the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi i
                        %mtr
                          %mtd
                            %mi B
                            %mo ∖
                            %mi A
                          %mtd
                            %munder
                              %mo →
                              %mi j
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ \emptyset &amp; \to &amp; A\\
                    \\downarrow &amp; &amp; \downarrow^i\\
                    B\setminus A &amp; \underset{j}{\to} &amp; B}
            %p
              is homotopy exact (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is the inclusion). Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo *
                    %msub
                      %mi i
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j^* i_* X
              is terminal for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X\in D(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              lands inside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo ∖
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(B,B\setminus A)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo ∖
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X\in D(B,B\setminus A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi i
                      %mo *
                    %msup
                      %mi i
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to i_* i^* X
              is an isomorphism on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              is fully faithful) and on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∖
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B\setminus A
              (since both are terminal there), hence is itself an isomorphism; so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is in the essential image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mo *
                    %annotation{:encoding => "application/x-tex"} i_*
          %p
            The following theorem is stated as Proposition 7.4 of
            %a{:href => "#HellerStable"} Heller’s paper
            “Stable homotopy theories and stabilization”.
          #RelRefl.num_theorem
            %h6#theorem Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B,A)
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
              and
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective
              subcategory of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(B)
          .proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi i
                  %annotation{:encoding => "application/x-tex"} M i
              denote the “codirected
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/mapping+cylinder"} mapping cylinder
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ↪
                      %mi B
                    %annotation{:encoding => "application/x-tex"} i\colon A \hookrightarrow B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} B\times I
              on the objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,0)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x\in B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i(x),1)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\in A
              (here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is the
              %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0\to 1)
              %span.newWikiWord
                cocomma object
                %a{:href => "/nlab/new/cocomma+object"} ?
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} ↑
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B \uparrow i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mover
                      %mo →
                      %mi u
                    %mi M
                    %mi i
                    %mover
                      %mo →
                      %mi p
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \overset{u}{\to} M i \overset{p}{\to} B
              for the evident inclusion and projection.
            %p Consider the adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi i
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⇄
                      %mrow
                        %msup
                          %mi p
                          %mo *
                      %mrow
                        %msub
                          %mi p
                          %mo !
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} D(M i) \underoverset{p^*}{p_!}{\rightleftarrows} D(B).
            %p We claim that this restricts to an adjunction
            #eq:ppadj.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi i
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⇄
                      %mrow
                        %msup
                          %mi p
                          %mo *
                      %mrow
                        %msub
                          %mi p
                          %mo !
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(M i,A) \underoverset{p^*}{p_!}{\rightleftarrows} D(B,A)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              denotes the subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi i
                  %annotation{:encoding => "application/x-tex"} M i
              on the objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i(x),1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^*
              takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B,A)
              into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mi i
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(M i,A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ↪
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i\colon A \hookrightarrow B
              is the composite
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ↪
                      %mi M
                      %mi i
                      %mover
                        %mo →
                        %mi p
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \hookrightarrow M i \overset{p}{\to} B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ↪
                          %mtd
                            %mi M
                            %mi i
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi p
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo →
                              %mi i
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{A &amp; \hookrightarrow &amp; M i \\
                    \\downarrow &amp; &amp; \downarrow^p\\
                    A &amp; \underset{i}{\to} &amp; B }
            %p
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+exact+square"} homotopy exact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo !
                  %annotation{:encoding => "application/x-tex"} p_!
              takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi i
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(M i,A)
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(B,A)
            %p
              Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is the inclusion of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
              identifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mi i
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(M i,A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B,A)\hookrightarrow D(B)
              can be identified with the restricted right adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                      %mo{:lspace => "verythinmathspace"} :
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mi i
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^*\colon D(B,A) \to D(M i,A)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo !
                    %annotation{:encoding => "application/x-tex"} p_!
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo !
                      %msub
                        %mi u
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p_! u_*
            %p The proof of coreflectivity is of course dual, using the directed mapping cylinder instead of the codirected one.
          %p
            Note that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ′
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ′
                  %mo ↪
                  %mi B
                  %mo ′
                %annotation{:encoding => "application/x-tex"} i'\colon A'\hookrightarrow B'
            is another full inclusion and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi A
                          %mo ′
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi i
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi i
                              %mo ′
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %munder
                            %mo →
                            %mi g
                        %mtd
                          %mi B
                          %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\array{A &amp; \overset{f}{\to} &amp; A'\\
                  ^i\downarrow &amp;&amp; \downarrow^{i'}\\
                  B&amp; \underset{g}{\to} &amp; B'}
          %p
            commutes, then we have a restriction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo ,
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g,f)^*\colon D(B',A') \to D(B,A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo !
                %annotation{:encoding => "application/x-tex"} (g,f)_!
            given by the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi g
                        %mo !
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi L
                        %mrow
                          %mi B
                          %mo ′
                          %mo ,
                          %mi A
                          %mo ′
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ′
                  %mo ,
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(B,A) \hookrightarrow D(B) \overset{g_!}{\to} D(B') \overset{L_{B',A'}}{\to} D(B',A')
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mi B
                      %mo ,
                      %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L_{B,A}\colon D(B) \to D(B,A)
            denotes the reflection. It also has a right adjoint defined dually.
          %h3#pointed_exactness Pointed exactness
          %p
            Define a
            %strong category with zeros
            to be a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            equipped with a full subcategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} B_0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+exact+squares"} homotopy exact squares
          %p
            Since the Beck-Chevalley transformation relating composites of these adjoints is the composite of the corresponding transformation for the unpointed diagram and a Beck-Chevalley transformation relating the restriction functors to the reflections
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B) \to D(B,B_0)
          #LocallyNullFinal.num_defn
            %h6#definition_2 Definition
            %p
              A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A \to B
              between categories with zeros is
              %strong locally null-final
              if for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a\in A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 0
                      %mo ∈
                      %msub
                        %mi B
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} b_0 \in B_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi b
                        %mn 0
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi\colon b_0 \to f(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 0
                    %mo ∈
                    %msub
                      %mi A
                      %mn 0
                    %mo ,
                    %msub
                      %mi a
                      %mn 0
                    %mover
                      %mo →
                      %mi α
                    %mi a
                    %mo ,
                    %msub
                      %mi b
                      %mn 0
                    %mover
                      %mo →
                      %mi β
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_0\in A_0, a_0 \xrightarrow{\alpha} a, b_0 \xrightarrow{\beta} f(a_0))
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \phi = f(\alpha).\beta
              has a contractible nerve.
          #LocallyNullFinalLemma.num_lemma
            %h6#lemma_2 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A \to B
              is
              %a{:href => "#LocallyNullFinal"} locally null-final
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a pointed derivator, then the functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^*\colon D(B) \to D(A)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msub
                      %mi A
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^*\colon D(B,B_0) \to D(A,A_0)
              commute with the reflections of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(A)
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B,B_0)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msub
                        %mi A
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(A,A_0)
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msub
                                  %mi L
                                  %mi A
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi L
                                  %mi B
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %msub
                              %mi A
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ,
                            %msub
                              %mi B
                              %mn 0
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D(A) &amp; \xleftarrow{f^*} &amp; D(B)
                    \\\
                    ^{L_A}\downarrow &amp; \seArrow &amp; \downarrow^{L_B}
                    \\\
                    D(A,A_0) &amp; \xleftarrow{f^*} &amp; D(B,B_0)
                    }
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_2 Proof
            %p
              Recall that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi A
                  %annotation{:encoding => "application/x-tex"} L_A
              is computed as the composite
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi u
                            %mo *
                      %mi D
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi M
                        %mi A
                      %mo ,
                      %msub
                        %mi A
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mo !
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msub
                        %mi A
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(A) \xrightarrow{u_*} D(M_A, A_0) \xrightarrow{p_!} D(A,A_0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi A
                  %annotation{:encoding => "application/x-tex"} M_A
              is the codirected mapping cylinder of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 0
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A_0\to A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msub
                                  %mi u
                                  %mo *
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi u
                                  %mo *
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi M
                              %mi A
                            %mo ,
                            %msub
                              %mi A
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi M
                              %mi B
                            %mo ,
                            %msub
                              %mi B
                              %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msub
                                  %mi p
                                  %mo !
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi p
                                  %mo !
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %msub
                              %mi A
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ,
                            %msub
                              %mi B
                              %mn 0
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D(A) &amp; \xleftarrow{f^*} &amp; D(B) \\
                    ^{u_*}\downarrow &amp; &amp; \downarrow^{u_*} \\
                    D(M_A,A_0) &amp; \xleftarrow{f^*} &amp; D(M_B,B_0)\\
                    ^{p_!}\downarrow &amp; &amp; \downarrow^{p_!} \\
                    D(A,A_0) &amp; \xleftarrow{f^*} &amp; D(B,B_0)}
            %p It suffices, therefore, to show that the squares
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %msub
                              %mi M
                              %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi f
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %msub
                              %mi M
                              %mi B
                    %mspace{:width => "2em"}
                    %mtext and
                    %mspace{:width => "2em"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi M
                              %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %msub
                              %mi M
                              %mi B
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mi p
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi p
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{A &amp; \xrightarrow{u} &amp; M_A \\
                    ^f \downarrow &amp; &amp; \downarrow^f \\
                    B &amp; \xrightarrow{u} &amp; M_B}
                    \\qquad\text{and}\qquad
                    \\array{M_A &amp; \xrightarrow{f} &amp; M_B\\
                    ^p\downarrow &amp; &amp; \downarrow^p\\
                    A &amp; \xrightarrow{f} &amp; B}
            %p are homotopy exact.
            %p
              For the first square, consider first a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b\in B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                    %mo ⊂
                    %msub
                      %mi M
                      %mi A
                  %annotation{:encoding => "application/x-tex"} a\in A\subset M_A
              and a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \varphi\colon f(a)\to b
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ⊂
                      %msub
                        %mi M
                        %mi B
                    %annotation{:encoding => "application/x-tex"} B\subset M_B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ′
                    %mo ,
                    %mi a
                    %mo →
                    %mi a
                    %mo ′
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a', a\to a', f(a')\to b)
              which compose to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
              is contractible, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi id
                      %mi a
                    %mo ,
                    %mi φ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a, id_a, \varphi)
              is an initial object. Second, we should consider a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b\in B
              and an
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn 0
                      %mo ∈
                      %msub
                        %mi A
                        %mn 0
                      %mo ⊂
                      %msub
                        %mi M
                        %mi A
                    %annotation{:encoding => "application/x-tex"} a_0\in A_0 \subset M_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \varphi\colon f(a_0)\to b
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mn 0
                    %mo ⊂
                    %msub
                      %mi M
                      %mi B
                  %annotation{:encoding => "application/x-tex"} B_0 \subset M_B
              — but by definition of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi B
                    %annotation{:encoding => "application/x-tex"} M_B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
              can exist. Thus, the first square is always homotopy exact.
            %p
              In fact, however, the preceeding argument is unnecessary, because we have seen that with their targets restricted as above, the functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
              are equivalences, and the
              %a.existingWikiWord{:href => "/nlab/show/mate"} mate
              of an isomorphism with respect to any pair of adjoint equivalences is again an isomorphism. Note that the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
              is an equivalence was already used in making the assertion that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo !
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_! u_*
              is a left adjoint to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msub
                        %mi A
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(A,A_0) \hookrightarrow D(A)
            %p
              For the second square, consider first an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a\in A
              and a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                      %mo ⊂
                      %msub
                        %mi M
                        %mi B
                    %annotation{:encoding => "application/x-tex"} b\in B\subset M_B
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi b
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \varphi\colon b \to f(a)
            %ul
              %li
                triples
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ′
                      %mo ∈
                      %mi A
                      %mo ,
                      %mi b
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi a
                      %mo ′
                      %mo →
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a'\in A, b\to f(a'), a' \to a)
                which compose to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi φ
                      %annotation{:encoding => "application/x-tex"} \varphi
              %li
                triples
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 0
                      %mo ∈
                      %msub
                        %mi A
                        %mn 0
                      %mo ,
                      %mi b
                      %mo →
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi a
                        %mn 0
                      %mo →
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a_0 \in A_0, b\to f(a_0), a_0 \to a)
                which compose to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi φ
                      %annotation{:encoding => "application/x-tex"} \varphi
            %p
              By definition of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi A
                    %annotation{:encoding => "application/x-tex"} M_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} A_0
              is coreflective in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi A
                    %annotation{:encoding => "application/x-tex"} M_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi φ
                    %mo ,
                    %msub
                      %mi id
                      %mi a
