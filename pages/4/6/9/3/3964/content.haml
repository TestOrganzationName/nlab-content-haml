                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (z\in L_0, x\xrightarrow{\alpha} z, z\xrightarrow{\beta} y)
                  such that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi β
                          %mi α
                          %mo =
                          %mi φ
                        %annotation{:encoding => "application/x-tex"} \beta\alpha=\varphi
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi z
                          %mn 1
                        %mo →
                        %msub
                          %mi z
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} z_1\to z_2
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  commuting with the given morphisms
                  %em and
                  such that either
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi z
                          %mn 1
                        %mo ∈
                        %msub
                          %mover
                            %mi L
                            %mo{:stretchy => "false"} ^
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} z_1 \in \hat{L}_0
                  or
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi z
                            %mn 2
                          %mo ∉
                          %msub
                            %mover
                              %mi L
                              %mo{:stretchy => "false"} ^
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} z_2 \notin \hat{L}_0
              %li
                %p
                  For every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mover
                            %mi L
                            %mo{:stretchy => "false"} ˇ
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} x\in \check{L}_0
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi K
                      %annotation{:encoding => "application/x-tex"} y\in K
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mover
                          %mo →
                          %mi φ
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \xrightarrow{\varphi} g(y)
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo ∈
                        %msub
                          %mi K
                          %mn 0
                        %mo ∩
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mover
                            %mi L
                            %mo{:stretchy => "false"} ˇ
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi x
                        %mover
                          %mo →
                          %mi α
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi z
                        %mover
                          %mo →
                          %mi β
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (z\in K_0 \cap g^{-1}(\check{L}_0), x\xrightarrow{\alpha} g(z), z \xrightarrow{\beta} y)
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi β
                        %mo{:stretchy => "false"} )
                        %mo .
                        %mi α
                        %mo =
                        %mi φ
                      %annotation{:encoding => "application/x-tex"} g(\beta).\alpha= \varphi
                  has a contractible nerve (“relative local null-finality”).
            %p Then for any pointed derivator, the induced transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo ,
                            %msub
                              %mi I
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo ,
                            %msub
                              %mi J
                              %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msub
                                  %mi h
                                  %mo !
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi k
                                  %mo !
                        %mtr
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo ,
                            %msub
                              %mi K
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi g
                                  %mo *
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo ,
                            %msub
                              %mi L
                              %mn 0
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ D(I,I_0) &amp; \xleftarrow{f^*} &amp; D(J,J_0) \\
                    ^{h_!}\downarrow &amp; \seArrow &amp; \downarrow^{k_!}\\
                    D(K,K_0) &amp; \xleftarrow{g^*} &amp; D(L,L_0)}
            %p is an isomorphism.
          .proof
            %h6#proof_5 Proof
            %p
              %strong (Sketch)
              Because of the second condition in the theorem, instead of the reflection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mi L
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(L) \to D(L,L_0)
              it will suffice to consider the reflection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mover
                        %mrow
                          %msub
                            %mi L
                            %mn 0
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %msub
                        %mi L
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(L,\hat{L_0}) \to D(L,L_0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              commutes with this reflection.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi M
                        %mo{:stretchy => "false"} ^
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \hat{M}_L
              be the codirected mapping cylinder of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi L
                          %mo{:stretchy => "false"} ˇ
                        %mn 0
                      %mo ↪
                      %mi L
                    %annotation{:encoding => "application/x-tex"} \check{L}_0 \hookrightarrow L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mover
                      %mo →
                      %mi u
                    %msub
                      %mover
                        %mi M
                        %mo{:stretchy => "false"} ^
                      %mi L
                    %mover
                      %mo →
                      %mi p
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L \xrightarrow{u} \hat{M}_L \xrightarrow{p} L
              are as before, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
              identifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(L,\hat{L}_0)
              with the subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi M
                        %mo{:stretchy => "false"} ^
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\hat{M}_L)
              consisting of diagrams which are zero on the copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ˇ
                      %mi l
                  %annotation{:encoding => "application/x-tex"} \check{L}_l
              that is the target end of the mapping cylinder and on the copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ^
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \hat{L}_0
              inside the copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              that is the source end; call this subcategory
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %msub
                        %mover
                          %mi M
                          %mo{:stretchy => "false"} ^
                        %mi L
                      %mo ,
                      %msub
                        %mover
                          %mi L
                          %mo{:stretchy => "false"} ^
                        %mn 0
                      %mo ∪
                      %msub
                        %mover
                          %mi L
                          %mo{:stretchy => "false"} ˇ
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(\hat{M}_L, \hat{L}_0 \cup \check{L}_0)
            %p
              Now if the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo !
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi M
                        %mo{:stretchy => "false"} ^
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mo ⇄
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_! \colon D(\hat{M}_L) \rightleftarrows D(L) \;: p^*
              restricts to an adjunction
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %msub
                        %mover
                          %mi M
                          %mo{:stretchy => "false"} ^
                        %mi L
                      %mo ,
                      %msub
                        %mover
                          %mi L
                          %mo{:stretchy => "false"} ^
                        %mn 0
                      %mo ∪
                      %msub
                        %mover
                          %mi L
                          %mo{:stretchy => "false"} ˇ
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ⇄
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %msub
                        %mi L
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(\hat{M}_L, \hat{L}_0 \cup \check{L}_0)\rightleftarrows D(L,L_0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mi L
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(L,\hat{L}_0) \to D(L,L_0)
              as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo !
                      %msub
                        %mi u
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p_! u_*
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi L
                                %mo{:stretchy => "false"} ^
                              %mn 0
                            %mo ∪
                            %msub
                              %mover
                                %mi L
                                %mo{:stretchy => "false"} ˇ
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mover
                                %mi M
                                %mo{:stretchy => "false"} ^
                              %mi L
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ \hat{L}_0 \cup \check{L}_0 &amp; \to &amp; \hat{M}_L \\
                    \\downarrow &amp; &amp; \downarrow \\
                    L_0 &amp; \to &amp; L }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo ∪
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ˇ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \hat{L}_0 \cup \check{L}_0
              denotes the same full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi M
                        %mo{:stretchy => "false"} ^
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \hat{M}_L
              as above. Exactness of this square can be verified to be equivalent to the third condition in the theorem.
            %p
              Finally, modifying the proof of Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyNullFinalLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                  %annotation{:encoding => "application/x-tex"} g^*
              with this reflection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo !
                      %msub
                        %mi u
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p_! u_*
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \hat{L}_0 = \emptyset
            %a.maruku-ref{:href => "#HomotopyExactWithZeros2"}
            are vacuous and it reduces to Theorem
            = succeed "." do
              %a.maruku-ref{:href => "#HomotopyExactWithZeros1"}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi L
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo =
                    %msub
                      %mi L
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \hat{L}_0 = L_0
            %a.maruku-ref{:href => "#HomotopyExactWithZeros2"}
            are vacuous and the third becomes “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi k
                    %mo !
                %annotation{:encoding => "application/x-tex"} k_!
            maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo ,
                  %msub
                    %mi J
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(J,J_0)
            into
            = succeed ".\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mi L
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(L,L_0)
          %h3#extraordinary_inverse_images Extraordinary inverse images
          #EOInv.num_theorem
            %h6#theorem_4 Theorem
            %p
              A derivator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is pointed if and only if whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} u\colon A\to B
              is a
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Dia
                    %annotation{:encoding => "application/x-tex"} Dia
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u_* \colon D(A) \to D(B)
              has a right adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi u
                        %mo !
                    %annotation{:encoding => "application/x-tex"} u^!
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is a cosieve, the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo !
                  %annotation{:encoding => "application/x-tex"} u_!
              has a left adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi u
                        %mo ?
                    %annotation{:encoding => "application/x-tex"} u^?
          .proof
            %p
              The “if” direction of this is easy, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ∅
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} u\colon \emptyset \to B
              is always a sieve, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u_*\colon * \to U(B)
              assigns the terminal object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
              has a further right adjoint, it must preserve colimits, and in particular its value on the unique object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\emptyset)
              must be an initial object (as well as a terminal one).
            %p
              Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is pointed and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is a sieve, then by Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#SieveRel"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
              identifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(A)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi B
                      %mo ∖
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(B,B\setminus A)
              = succeed "," do
                %a.maruku-ref{:href => "#RelRefl"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi B
                    %mo ∖
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(B,B\setminus A)\hookrightarrow D(B)
              has a right adjoint. The other case is dual.
          %p
            The functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} u^!
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo ?
                %annotation{:encoding => "application/x-tex"} u^?
            are sometimes referred to as
            %em extraordinary
            and
            %em co-extraordinary inverse image
            functors. Our proof shows that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo ?
                    %mo =
                    %msup
                      %mi u
                      %mo *
                    %msub
                      %mi p
                      %mo !
                    %msub
                      %mi v
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u^? = u^* p_! v_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            are respectively the inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            in the codirected mapping cylinder of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∖
                    %mi A
                    %mo ↪
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B\setminus A \hookrightarrow B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            In the literature, the existence of these functors is often taken as the definition of when a derivator is pointed. The equivalence of the two definitions is a “super-difficult” exercise in
            = succeed "." do
              %a{:href => "http://people.math.jussieu.fr/~maltsin/Seville/Lecture_III_Derivators.pdf"} Maltsionitis’ notes
          %h3#loop_and_suspension Loop and suspension
          %p
            In a pointed derivator, we have a
            %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mn 1
                  %mo →
                  %mi D
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma\colon D 1 \to D 1
            defined as the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mn 1
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi a
                        %mo *
                  %mi D
                  %mi Γ
                  %mover
                    %mo →
                    %mrow
                      %mi a
                      %mi b
                      %msub
                        %mi c
                        %mo !
                  %mi D
                  %mo □
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi d
                        %mo *
                  %mi D
                  %mn 1
                %annotation{:encoding => "application/x-tex"} D 1 \overset{a_*}{\to} D \Gamma \overset{a b c_!}{\to} D \square \overset{d^*}{\to} D 1
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
            denotes the category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi a
                        %mtd
                          %mo →
                        %mtd
                          %mi b
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi c
                        %mtd
                          %mo →
                        %mtd
                          %mi d
                %annotation{:encoding => "application/x-tex"} \array{ a &amp; \to &amp; b \\ \downarrow &amp; &amp; \downarrow \\ c &amp; \to &amp; d }
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            its full subcategory on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{a,b,c\}
          %p Equivalently, the suspension can be defined as the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mn 1
                  %mo =
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi ∅
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo !
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mo □
                  %mo ,
                  %mi b
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi ∅
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi D
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} D 1 = D(1,\emptyset) \overset{(a,\emptyset)_!}{\to} D(\square,b c) \overset{(d,\emptyset)^*}{\to} D(1,\emptyset) = D 1.
          %p
            This follows because we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mn 1
                    %mo ≃
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D 1 \simeq D(\Gamma,b c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi ∅
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo !
                %annotation{:encoding => "application/x-tex"} (a,\emptyset)_!
            is isomorphic to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mi c
                    %mo ,
                    %mi b
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mo □
                    %mo ,
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a b c,b c)_!\colon D(\Gamma,b c) \to D(\square,b c)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mo □
                        %mo ,
                        %mi b
                        %mi c
                    %mo ∘
                    %mi a
                    %mi b
                    %msub
                      %mi c
                      %mo !
                  %annotation{:encoding => "application/x-tex"} L_{\square,b c} \circ a b c_!
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi b
                  %msub
                    %mi c
                    %mo !
                %annotation{:encoding => "application/x-tex"} a b c_!
            is fully faithful since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi b
                  %mi c
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Γ
                  %mo ↪
                  %mo □
                %annotation{:encoding => "application/x-tex"} a b c\colon \Gamma \hookrightarrow \square
            is, and so it already takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo ,
                  %mi b
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(\Gamma,b c)
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mo □
                    %mo ,
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\square,b c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mo □
                      %mo ,
                      %mi b
                      %mi c
                %annotation{:encoding => "application/x-tex"} L_{\square,b c}
            is doing nothing, so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi ∅
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo !
                %annotation{:encoding => "application/x-tex"} (a,\emptyset)_!
            is essentially just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi b
                  %msub
                    %mi c
                    %mo !
                %annotation{:encoding => "application/x-tex"} a b c_!
            which appeared in our previous definition of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mo *
                %annotation{:encoding => "application/x-tex"} a_*
            essentially implements the equivalence
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mn 1
                    %mo ≃
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D 1 \simeq D(\Gamma,b c)
          %p
            Similarly, we have a
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mn 1
                  %mo →
                  %mi D
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Omega\colon D 1 \to D 1
            defined as the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mn 1
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mo !
                  %mi D
                  %msup
                    %mi Γ
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %mi b
                      %mi c
                      %msub
                        %mi d
                        %mo *
                  %mi D
                  %mo □
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi a
                        %mo *
                  %mi D
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} D 1 \overset{d_!}{\to} D \Gamma^{op} \overset{b c d_*}{\to} D \square \overset{a^*}{\to} D 1.
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Gamma^{op}
            is the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo ,
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{b,c,d\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mn 1
                  %mo =
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi ∅
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo *
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mo □
                  %mo ,
                  %mi bc
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi ∅
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi D
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} D 1 = D(1,\emptyset) \overset{(d,\emptyset)_*}{\to} D(\square,bc) \overset{(a,\emptyset)^*}{\to} D(1,\emptyset) = D 1.
          %p
            The description in terms of relative diagram categories makes it clear that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ⊣
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Sigma \dashv \Omega
          %p
            We can also describe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            in terms of the extraordinary inverse image functors. Since the square
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Γ
                        %mtd
                          %mo →
                        %mtd
                          %mi Γ
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi r
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi a
                              %mi b
                              %mi c
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %munder
                            %mo →
                            %mi d
                        %mtd
                          %mo □
                %annotation{:encoding => "application/x-tex"}
                  \\array{ \Gamma &amp; \to &amp; \Gamma \\
                  ^r\downarrow &amp; &amp; \downarrow^{a b c}\\
                  * &amp; \underset{d}{\to} &amp; \square}
          %p
            is homotopy exact, the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mo *
                  %mi a
                  %mi b
                  %msub
                    %mi c
                    %mo !
                %annotation{:encoding => "application/x-tex"} d^* a b c_!
            in our first definition is the same as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mo !
                  %annotation{:encoding => "application/x-tex"} r_!
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mo *
                %annotation{:encoding => "application/x-tex"} a_*
            can in turn be decomposed as a composite
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msub
                      %mi b
                      %mo *
                    %msub
                      %mi s
                      %mo *
                  %annotation{:encoding => "application/x-tex"} a b_* s_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} s\colon * \to I
            is the inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            into the interval category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo →
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s\to t)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ab
                  %mo{:lspace => "verythinmathspace"} :
                  %mi I
                  %mo →
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} ab\colon I\to \Gamma
            is the inclusion into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{a,b\}
          %p
            Therefore we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ≅
                    %msub
                      %mi r
                      %mo !
                    %mi a
                    %msub
                      %mi b
                      %mo *
                    %msub
                      %mi s
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Sigma \cong r_! a b_* s_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            can be identified with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi s
                %annotation{:encoding => "application/x-tex"} M s
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi b
                %annotation{:encoding => "application/x-tex"} a b
            with the inclusion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo ↪
                    %mi M
                    %mi s
                  %annotation{:encoding => "application/x-tex"} u\colon I \hookrightarrow M s
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            factors as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi s
                  %mover
                    %mo →
                    %mi p
                  %mi I
                  %mover
                    %mo →
                    %mi q
                  %mo *
                %annotation{:encoding => "application/x-tex"} M s \overset{p}{\to} I \overset{q}{\to} *
            so that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mo !
                    %mo ≅
                    %msub
                      %mi q
                      %mo !
                    %msub
                      %mi p
                      %mo !
                  %annotation{:encoding => "application/x-tex"} r_! \cong q_! p_!
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi t
                        %mtd
                          %mi I
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi q
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\array{* &amp; \overset{t}{\to} &amp; I\\
                  \\downarrow &amp; &amp; \downarrow^q\\
                  *&amp; \to &amp; *}
          %p
            is homotopy exact, so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mo !
                  %mo ≅
                  %msup
                    %mi t
                    %mo *
                %annotation{:encoding => "application/x-tex"} q_! \cong t^*
            and thus
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ≅
                  %msup
                    %mi t
                    %mo *
                  %msub
                    %mi p
                    %mo !
                  %msub
                    %mi u
                    %mo *
                  %msub
                    %mi s
                    %mo *
                  %mo ≅
                  %msup
                    %mi t
                    %mo ?
                  %msub
                    %mi s
                    %mo *
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Sigma \cong t^* p_! u_* s_* \cong t^? s_*.
          %p
            Dually, we can identify
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo ≅
                    %msup
                      %mi s
                      %mo !
                    %msub
                      %mi t
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \Omega \cong s^! t_!
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ⊣
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Sigma \dashv \Omega
          %h3#enrichment_over_pointed_sets Enrichment over pointed sets
          %p
            Every pointed derivator can be canonically “
            %a.existingWikiWord{:href => "/nlab/show/enriched+derivator"}> enriched
            ” over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ′
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Set
                    %mo *
                  %mi Cat
                  %mspace{:width => "thickmathspace"}
                  %mo →
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Set
                    %mo *
                  %mi CAT
                %annotation{:encoding => "application/x-tex"} D': \; Set_* Cat \; \to\; Set_* CAT
          %p
            from small
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{C}
            to be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with a
            %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            adjoined. (Note that zero objects are
            %a.existingWikiWord{:href => "/nlab/show/absolute+colimits"} absolute colimits
            in
            = succeed "-categories.)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D'(C) = D(\bar{C},0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(\bar{C})
            on those diagrams which send the zero object to zero.
          %p
            Any
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi x
                %annotation{:encoding => "application/x-tex"} id_x
            is the basepoint of the pointed homset
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hom(x,x)
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} u:A\to B
            induces a relative functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (u,0):(\bar{A},0) \to (\bar{B},0)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo :
                    %mi D
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u^* = (u,0)^*:D'(B) \to D'(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} u_!
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            followed by reflection or coreflection from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(\bar{B})
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\bar{B},0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mn 0
                %annotation{:encoding => "application/x-tex"} (u,0)/0
            has a terminal object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} u_!
            already maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(\bar{A},0)
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\bar{B},0)
          %p
            Thus we have a
            = succeed "-analogue" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the unit
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi S
                      %mn 0
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mn 1
                      %mi x
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} hom(x,x) = S^0 = \{1_x, 0\}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D'(I) \simeq D(*)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Set
                    %mo *
                %annotation{:encoding => "application/x-tex"} Set_*
            functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} I \to A
            for any
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            gives rise a family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} *\to \bar{A}
            picking out the nonzero objects, but since any two zero objects are isomorphic, (Der2) for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            implies that the resulting family of functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D'(A) \to D'(I)
            are jointly conservative.
          %p We can also conclude a version of the axiom (Der4) about exact squares from the above theorems about exactness for categories with zeros. Namely, if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mo →
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"} \array{ A &amp; \to &amp; B \\ \downarrow &amp; \swArrow &amp; \downarrow \\ C &amp; \to &amp; D }
          %p
            is a comma square of
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ¯
                        %mtd
                          %mo →
                        %mtd
                          %mover
                            %mi B
                            %mo{:stretchy => "false"} ¯
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mover
                            %mi C
                            %mo{:stretchy => "false"} ¯
                        %mtd
                          %mo →
                        %mtd
                          %mover
                            %mi D
                            %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \array{ \bar{A} &amp; \to &amp; \bar{B} \\ \downarrow &amp; \swArrow &amp; \downarrow \\ \bar{C} &amp; \to &amp; \bar{D} }
          %p
            is homotopy exact when considered as a square of ordinary categories. Moreover, the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{C} \to \bar{D}
            is always locally null-final. Thus, by Theorem
            = succeed "," do
              %a.maruku-ref{:href => "#HomotopyExactWithZeros1"}
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
          %p
            It remains to consider the axiom (Der1) regarding coproducts. The coproduct “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi A
                  %mo ∨
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\vee B
            ” of two
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ,
                  %mi j
                %annotation{:encoding => "application/x-tex"} i,j
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are fully faithful, however, and the induced functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi i
                    %mo{:stretchy => "false"} ¯
                  %mo{:lspace => "verythinmathspace"} :
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mover
                    %mrow
                      %mi A
                      %mo ∨
                      %mi B
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \bar{i}\colon \bar{A}\to \overline{A\vee B}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi j
                    %mo{:stretchy => "false"} ¯
                  %mo{:lspace => "verythinmathspace"} :
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mover
                    %mrow
                      %mi A
                      %mo ∨
                      %mi B
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \bar{j}\colon \bar{B}\to \overline{A\vee B}
            are locally null-final; hence the left extensions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i_! \colon D'(A) \to D'(A\vee B)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j_!\colon D'(B) \to D'(A\vee B)
            are also fully faithful.
          %p
            By exactness with zeros, we can show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %msub
                    %mi i
                    %mo !
                %annotation{:encoding => "application/x-tex"} j^* i_!
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} i^* j_!
            send everything to zero. Therefore, if we define a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi j
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i,j)_!\colon D'(A) \times D'(B) \to D'(A\vee B)
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mo !
                    %mi X
                    %mo +
                    %msub
                      %mi j
                      %mo !
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i,j)_!(X,Y) = (i_! X + j_! Y)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %mo ,
                    %msup
                      %mi j
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mo ≅
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} (i^*, j^*)(i,j)_! \cong Id
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                %annotation{:encoding => "application/x-tex"} i_!
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                  %annotation{:encoding => "application/x-tex"} j_!
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo ∈
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z\in D'(A\vee B)
            the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %msup
                    %mi i
                    %mo *
                  %mi Z
                  %mo →
                  %mi Z
                %annotation{:encoding => "application/x-tex"} i_! i^* Z \to Z
            is an isomorphism on objects of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            and
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi j
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo !
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi i
                    %mo *
                  %mo ,
                  %msup
                    %mi j
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi Id
                %annotation{:encoding => "application/x-tex"} (i,j)_! (i^*,j^*) \cong Id
            as well. In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi i
                    %mo *
                  %mo ,
                  %msup
                    %mi j
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i^*,j^*)
            is an equivalence of categories, providing the
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
          .query
            %p What about (Der5)?
          %p
            Conversely, given a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ′
                %annotation{:encoding => "application/x-tex"} D'
            as above satisfying the axioms as given above, we can define
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi D
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(A) = D'(A')
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            denotes the free
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (i.e. adjoin a new zero morphism between each pair of objects). This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            will automatically satisfy axioms (Der3) (homotopy Kan extensions) and (Der2) (conservativity on objects) since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ′
                %annotation{:encoding => "application/x-tex"} D'
            does, and it satisfies (Der1) on coproducts since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ′
                %annotation{:encoding => "application/x-tex"} D'
            does and since
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ′
                    %mo ≅
                    %mi A
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} (A+B)' \cong A' + B'
          .query
            %p Does (Der4) on Beck-Chevalley conditions carry back over? Does this require a “pointed version of Cisinski’s theorem”?
          %p
            Finally, of course each category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi D
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(A) = D'(A')
            has a zero object, so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a pointed derivator. Thus, it seems that
            = succeed "-enrichment" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
          .query
            %p
              However, what is not immediately clear is that passing from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} D'
              and back to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              again gives the same derivator. At first sight this seems to require a stronger theorem about homotopy exactness with zeros than is stated above, one in which the square need not be homotopy exact without zeros.
          %h2#the_pointed_reflection The pointed reflection
          %p
            Every derivator can be made pointed in a universal way; given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            we define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D_*(A)
            to be the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(A\times I)
            which is terminal when restricted along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi A
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 0\colon A\to A\times I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D_*(A) \hookrightarrow D(A\times I)
            has a left adjoint (the “mapping cone”), which can be constructed just as in the proof of Theorem
            = succeed "." do
              %a.maruku-ref{:href => "#RelRefl"}
            = succeed "." do
              %a{:href => "#HellerHomotopy"} Heller’s memoir
          %h2#references References
