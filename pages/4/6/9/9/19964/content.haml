                          %annotation{:encoding => "application/x-tex"} SU(3)
                      skyrmion with vector mesons
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1016/0375-9474(89)90029-8"} doi:10.1016/0375-9474(89)90029-8
            %p
