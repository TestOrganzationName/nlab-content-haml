                  %annotation{:encoding => "application/x-tex"} [..]
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} 1/N expansion
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
              %a.existingWikiWord{:href => "/nlab/show/Skyrmion"} Skyrmion
              physics rationally comprehensible.
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+D%27Hoker"}> Eric D'Hoker
                , Edward Farhi,
                = succeed "," do
