            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Mannque+Rho"}> Mannque Rho
                , D. O. Riska, N. N. Scoccola, above (2.1) in:
                = succeed "," do
                  %em The energy levels of the heavy flavour baryons in the topological soliton model
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF01283544"} doi:10.1007/BF01283544
            %h4#WZWTermOfChiralPerturbationTheoryReferencesIncludingHeavyVectorMesons Including heavy vector mesons
            %p
              Inclusion of
              %a.existingWikiWord{:href => "/nlab/show/heavy+mesons"} heavy
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/vector+mesons"} vector mesons
            %p
              specifically
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/K%2A-mesons"} K*-mesons
            %ul
              %li
                S. Ozaki, H. Nagahiro,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Atsushi+Hosaka"} Atsushi Hosaka
                = succeed "," do
                  %em Magnetic interaction induced by the anomaly in kaon-photoproductions
                = succeed "," do
