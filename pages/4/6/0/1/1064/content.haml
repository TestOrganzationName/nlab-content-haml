          %h2#definitions Definitions
          %p
            There is a sequence of extra
            %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} structure and property
            on a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            that makes this category behave like a general context for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
          %ol
            %li
              %p
                %strong>
                  %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
                \: a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                that is
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            %li
              %p
                %strong>
                  %a.existingWikiWord{:href => "/nlab/show/pre-additive+category"} pre-additive category
                \: an
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ab
                      %annotation{:encoding => "application/x-tex"} Ab
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                or
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                and therefore a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
                = succeed "-enriched." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ab
                      %annotation{:encoding => "application/x-tex"} Ab
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/pseudo-abelian+category"}> pseudo-abelian category
                  \: a pre-additive category such that every
                  %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  and
                  %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
            %li
              %p
                %strong>
                  %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
                \: a pre-additive category that admits binary
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
                %a.existingWikiWord{:href => "/nlab/show/semiadditive+category"} semiadditive category
                (equivalently, an
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ab
                      %annotation{:encoding => "application/x-tex"} Ab
            %li
              %p
                %strong>
                  %a.existingWikiWord{:href => "/nlab/show/pre-abelian+category"} pre-abelian category
                \: an additive category that admits
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ab
                      %annotation{:encoding => "application/x-tex"} Ab
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                = succeed "s);" do
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %li
              %p
                %strong>
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
                \: a pre-abelian category such that every
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                is a kernel and every
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                is a cokernel (and many other equivalent definitions).
