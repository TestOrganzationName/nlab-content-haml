                  %path{:d => "M -6.51629 142.21212 C -14.948936 156.163535 -15.214901 169.575198 -7.576238 183.436653 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.998723,0,0,-0.998723,323.672029,209.358591)"}
                  %path{:d => "M -2.488261 2.868174 C -2.030649 1.146385 -1.021337 0.336013 -0.00128744 0.000491075 C -1.019061 -0.332634 -2.031632 -1.145223 -2.487713 -2.870352 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.482023,-0.874661,-0.874661,-0.482023,316.2198,25.948329)"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "288.591896", "xlink:href" => "#7NIZrlCPdDP7reeNtOp4kNg0-DI=-glyph1-5", :y => "60.411092"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "292.409513", "xlink:href" => "#7NIZrlCPdDP7reeNtOp4kNg0-DI=-glyph3-1", :y => "62.166347"}
                    %use{:x => "298.413059", "xlink:href" => "#7NIZrlCPdDP7reeNtOp4kNg0-DI=-glyph3-3", :y => "62.166347"}
                    %use{:x => "301.245807", "xlink:href" => "#7NIZrlCPdDP7reeNtOp4kNg0-DI=-glyph3-2", :y => "62.166347"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "314.074304", "xlink:href" => "#7NIZrlCPdDP7reeNtOp4kNg0-DI=-glyph9-1", :y => "42.478028"}
                  %g{:style => "fill:rgb(39.216614%,39.216614%,39.216614%);fill-opacity:1;"}
                    %use{:x => "321.104313", "xlink:href" => "#7NIZrlCPdDP7reeNtOp4kNg0-DI=-glyph10-1", :y => "173.702195"}
            %p
              Then we have an
              %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"} g_{\alpha,\beta}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                    %mo ×
                    %mi F
                  %annotation{:encoding => "application/x-tex"} U_{\alpha,\beta} \times F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi α
                          %mo ,
                          %mi β
                  %annotation{:encoding => "application/x-tex"} C/{U_{\alpha,\beta}}
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mrow
                          %mi α
                          %mo ,
                          %mi β
                      %mo =
                      %msub
                        %mi t
                        %mrow
                          %mi β
                          %mo ,
                          %mi α
                      %mo ∘
                      %msubsup
                        %mi t
                        %mrow
                          %mi α
                          %mo ,
                          %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} g_{\alpha,\beta} = t_{\beta,\alpha} \circ t_{\alpha,\beta}^{-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"} g_{\alpha,\beta}
              are the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/transition+morphisms"} transition morphisms
              of the locally trivial fibre bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              in fact admits a
              %em global
              %a.existingWikiWord{:href => "/nlab/show/trivial+fiber+bundle"} trivialisation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo ≃
                      %mi B
                      %mo ×
                      %mi F
                    %annotation{:encoding => "application/x-tex"} t \colon E \simeq B \times F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"} t_{\alpha,\beta}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mi β
                        %mo ,
                        %mi α
                  %annotation{:encoding => "application/x-tex"} t_{\beta,\alpha}
              are equal to the pullback of (the commutative triangle formed by)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mrow
                          %mi α
                          %mo ,
                          %mi β
                      %mo :
                      %msub
                        %mi U
                        %mrow
                          %mi α
                          %mo ,
                          %mi β
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} j_{\alpha,\beta} : U_{\alpha,\beta} \to B
              %a.existingWikiWord{:href => "/nlab/show/transition+morphisms"} transition morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"} g_{\alpha,\beta}
              are all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identities
          %p
            Often one considers special kinds of bundles, by requiring structure on the standard fibre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and/or conditions on the
            %a.existingWikiWord{:href => "/nlab/show/transition+morphisms"} transition morphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"} g_{\alpha,\beta}
          %h2#special_cases Special cases
          %h3#bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-bundle
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            that
            %a.existingWikiWord{:href => "/nlab/show/action"} acts
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-bundle
            (or bundle with
            %strong structure group
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with standard fibre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a locally trivial fibre bundle over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with standard fibre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            together with morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mrow
                      %mi α
                      %mo ,
                      %mi β
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} U_{\alpha,\beta} \to G
            that, relative to the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"} g_{\alpha,\beta}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mrow
                      %mi α
                      %mo ,
                      %mi β
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} U_{\alpha,\beta} \to G
            is also written
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"} g_{\alpha,\beta}
          %h3#principal_bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-principal bundles
          %p
            More specifically, a (right or left)
            %strong
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with standard fibre
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on itself by (right or left) multiplication.
          %h3#structurepreserving_bundles Structure-preserving bundles
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is an object of a
            %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            such that the transition morphisms are structure-preserving morphisms. If the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut(F)
            can be internalised in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-bundle," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(F)
          %h3#vector_bundles Vector bundles
          %p
            As a fairly specific example, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a
            %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
            (and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a category with structure to support this, such as
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            or
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            %strong
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with standard fibre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(F)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with standard fibre
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(F)
            is the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            with its defining action on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %h3#associated_bundles Associated bundles
          %p
            Given a right
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \pi: P\to X
            and a left
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (such as
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %a.existingWikiWord{:href => "/nlab/show/quotient+object"} quotient object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi F
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} P\times_G F = (P\times F)/{\sim}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ×
                  %mi F
                %annotation{:encoding => "application/x-tex"} P \times F
            is a
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            is the smallest
            %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
            such that (using
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mi g
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi g
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p g,f)\sim (p,g f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %msub
                    %mo ×
                    %mi G
                  %mi F
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P\times_G F\to X
            where the class of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
