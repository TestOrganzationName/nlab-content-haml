            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anton+Zeitlin"}> Anton Zeitlin
                ,
                = succeed "," do
                  %em Beta-gamma systems and the deformations of the BRST operator
                %a{:href => "https://doi.org/10.1088/1751-8113/42/35/355401"} doi
                = succeed ")" do
