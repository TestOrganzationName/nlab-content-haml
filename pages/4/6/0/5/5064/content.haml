          %ul
            %li
              %span.newWikiWord
                pure spinor formalism
                %a{:href => "/nlab/new/pure+spinor+formalism"} ?
          %h2#references References
          %h3#general General
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nikita+Nekrasov"}> Nikita Nekrasov
