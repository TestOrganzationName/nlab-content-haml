          %h2#examples Examples
          %h3#0th_stem 0th stem
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hopf+degree+theorem"} Hopf degree theorem
          %h3#1st_stem 1st stem
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/first+stable+homotopy+group+of+spheres"} first stable homotopy group of spheres
            (the first
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stable+stem"} stable stem
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
          #eq:ComplexHopfFibrationGeneratingpi1.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi π
                            %mn 1
                            %mi s
                        %mtd
                          %mo ≃
                        %mtd
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi h
                            %mi ℂ
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↔
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_1^s &amp;\simeq&amp; \mathbb{Z}/2
                  \\\
                  [h_{\mathbb{C}}] &amp;\leftrightarrow&amp; [1]
                  }
          %p
            where the generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} [1] \in \mathbb{Z}/2
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 3
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi h
                          %mi ℂ
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^3 \overset{h_{\mathbb{C}}}{\longrightarrow} S^2
          .float_right_image{:style => "margin: -40px 0px 20px 20px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/PuncturedSphereBordismBetweenTwoCircles.jpg", :width => "200px"}/
              %figcaption{:style => "text-align: center"}
                from
                %a{:href => "https://ncatlab.org/schreiber/show/Equivariant+Cohomotopy+and+Oriented+Cohomology+Theory"} SS21
          %p
            Under the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+isomorphism"} Pontrjagin-Thom isomorphism
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            with the
            %a.existingWikiWord{:href => "/nlab/show/bordism+ring"} bordism ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mo •
                    %mi fr
                %annotation{:encoding => "application/x-tex"} \Omega^{fr}_\bullet
            of
            %a.existingWikiWord{:href => "/nlab/show/stable+framing"} stably framed
            manifolds (see at
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/MFr"} MFr
            %a.maruku-eqref{:href => "#eq:ComplexHopfFibrationGeneratingpi1"} (1)
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/1-sphere"} 1-sphere
            (with its left-invariant framing induced from the identification with the
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/U%281%29"} U(1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi π
                            %mn 1
                            %mi s
                        %mtd
                          %mo ≃
                        %mtd
                          %msubsup
                            %mi Ω
                            %mn 1
                            %mi fr
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi h
                            %mi ℂ
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↔
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msubsup
                            %mi S
                            %mrow
                              %mi fr
                              %mo =
                              %mn 1
                            %mn 1
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_1^s &amp; \simeq &amp; \Omega_1^{fr}
                  \\\
                  [h_{\mathbb{C}}] &amp; \leftrightarrow &amp; [S^1_{fr=1}]
                  \\,.
                  }
          %p
            Moreover, the relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi S
                    %mi Lie
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ≃
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 2 \cdot [S^1_{Lie}] \,\simeq\, 0
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/bordism"} bordism
            which is the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of 2
            %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
            inside
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
          %h3#2nd_stem 2nd stem
          %p
            The
            = succeed "\u2026" do
              %a.existingWikiWord{:href => "/nlab/show/second+stable+homotopy+group+of+spheres"} second stable homotopy group of spheres
          %h3#3rd_stem 3rd stem
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/third+stable+homotopy+group+of+spheres"} third stable homotopy group of spheres
            (the third
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stable+stem"} stable stem
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            of
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            24:
          #eq:QuaternionicHopfFibrationGeneratingpi3.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi π
                            %mn 3
                            %mi s
                        %mtd
                          %mo ≃
                        %mtd
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 24
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi h
                            %mi ℍ
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↔
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_3^s &amp;\simeq&amp; \mathbb{Z}/24
                  \\\
                  [h_{\mathbb{H}}] &amp;\leftrightarrow&amp; [1]
                  }
          %p
            where the generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 24
                %annotation{:encoding => "application/x-tex"} [1] \in \mathbb{Z}/24
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi h
                          %mi ℍ
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^7 \overset{h_{\mathbb{H}}}{\longrightarrow} S^4
          .float_right_image{:style => "margin: -40px 0px 20px 20px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/K3CobordismBetween24ThreeSpheres.jpg", :width => "260px"}/
              %figcaption{:style => "text-align: center"}
                from
                %a{:href => "https://ncatlab.org/schreiber/show/Equivariant+Cohomotopy+and+Oriented+Cohomology+Theory"} SS21
