                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mi mod
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"} n = 0 \;mod \;
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mi mod
                        %mspace{:width => "thickmathspace"}
                        %mn 8
                      %annotation{:encoding => "application/x-tex"} n = 1 \;mod \; 8
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  positive the J-homomorphism is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/injection"} injective
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
