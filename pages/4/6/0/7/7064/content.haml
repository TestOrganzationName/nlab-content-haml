              are the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of the (
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"}> cyclic
              )
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-homomorphism
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Adams+e-invariant"} Adams e-invariant
            %p Moreover,
            %ul
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
