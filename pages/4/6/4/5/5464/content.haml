                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \mapsto \mathbf{Sh}(X)
            into two steps. First, we forget the points of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/open+sets"} open sets
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of ‘
            %a.existingWikiWord{:href => "/nlab/show/sheaves"}> sheaves
            ’ on that ordered
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            (defined as for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          #defno.num_defn.thdefn
            %h6#definition_7 Definition
            %p
              A
              %strong
                %em{:style => "font-style: normal"}
