                        %mo ⊥
                        %mspace{:width => "1em"}
                      %mo ←
                      %mo →
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⊗
                      %mi I
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Psh}(X) = \mathbf{Set}^{\mathbf{Open}(X)^{\mathrm{op}}} \underoverset{Hom(I,-)}{-\otimes I}{\underoverset{\leftarrow }{\rightarrow }{\quad \perp \quad }} \mathbf{TopSp}/X.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\mathrm{Hom}(I, Y))(U) = \mathbf{TopSp}/X \, (I(U), Y)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo )
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y = \left ( \begin{matrix} Y\\ \downarrow \mathrlap{p}\\ X\end{matrix}\;\right ) \in \mathbf{TopSp}/X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Open
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \in \mathbf{Open}(X)
            = succeed "(" do
              %a{:href => "#defni"} 9
            = succeed "):" do
              %a{:href => "#enumiDd"} 4
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            defined there is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Hom
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Hom}(I, Y)
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            can be described as a
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            or
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in \mathbf{Psh}(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊗
                  %mi I
                  %mo =
                  %msup
                    %mo ∫
                    %mi U
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi I
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mstyle{:displaystyle => "true"}
                    %munder
                      %mi lim
                      %mrow
                        %mo →
                        %mi U
                        %mo ,
                        %mi s
                    %mspace{:width => "thinmathspace"}
                    %mi U
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo →
                    %mi X
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                %annotation{:encoding => "application/x-tex"}
                  F \otimes I = \int ^{U} F(U) \times I(U) = \Bigl ( \bigl ( \displaystyle \lim _{\rightarrow U, s}\, U \bigr ) \to X \Bigr )
          %p
            where the
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            is over all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi Open
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U \in \mathbf{Open}(X)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s \in F(U)
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the canonical one.
          #padjneqv
          %p
            Second, every
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            restricts canonically to an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            between
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/full+subcategories"} full subcategories
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            at which the
            %a.existingWikiWord{:href => "/nlab/show/unit+of+the+adjunction"} unit of the adjunction
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            at which the
            %a.existingWikiWord{:href => "/nlab/show/counit"} counit
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            obtained from the
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            above as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %munderover
                    %mrow
                      %mspace{:width => "1em"}
                      %mo ≃
                      %mspace{:width => "1em"}
                    %mo ←
                    %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Et
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Sh}(X) \underoverset{\leftarrow }{\rightarrow }{\quad \simeq \quad } \mathbf{Et}(X).
          %p
            It can be shown that this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(X)
            is the same
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            as before. In this way, the notion of
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            arises canonically from the very simple
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi Open
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi TopSp
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} I\colon \mathbf{Open}(X) \to \mathbf{TopSp}/X
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+space"} étale bundle
            also arises canonically:
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+space"} étale bundles
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are (by definition, if you like) the
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Et}(X)
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            shows that every
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            is of the form described in Example 
            %a{:href => "#defni"}> 9
            (
            %a{:href => "#enumiDd"}> 4
            ). See
            %a{:href => "#citeMaMo"} Mac Lane and Moerdijk
            (
            %a{:href => "#citeMaMo"}> 1994
            ) for details.
          %p
            One way or another, we have the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(X)
            of
            %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mtext open subsets of
                  %mi U
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega (U) = \{ \text{open subsets of } U \} .
          %p
            The crucial fact about
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(X)
            is that—modulo a small lie that I will repair later—
          %div{:style => "text-align: center"}
            %p
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                can be recovered from
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(X)
          %p
            So the
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            embeds into the
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            as generalized
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
          %p
            A common technique in
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            is to take a concept from
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            or
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            and extend it to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            = succeed "\u2019." do
              %a.existingWikiWord{:href => "/nlab/show/connected+toposes"} connected toposes
            %a.existingWikiWord{:href => "/nlab/show/property"} property
            of the
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(X)
            corresponds to connectedness of the
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
          %p The next few subsections are all examples of this generalization process.
          %h3#geometric_morphisms Geometric morphisms
          %p
            So far I have said nothing about maps between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            should be: a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            preserving
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponentials
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifiers"} subobject classifiers
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            is called a
            = succeed "." do
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            that has been found much more useful. It can be derived by generalizing from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
          %p
            Every map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f\colon X \to Y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                %annotation{:encoding => "application/x-tex"} \mathbf{TopSp}
            induces an
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          #eq:eqShGM.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %munderover
                    %munderover
                      %mrow
                        %mspace{:width => "1em"}
                        %mstyle{:scriptlevel => "1"}
                          %mstyle{:scriptlevel => "1"}
                            %mo ⊥
                            %mspace{:width => "1em"}
                      %mo →
                      %mo ←
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %mrow
                      %msup
                        %mi f
                        %mo *
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Sh}(X) \underoverset{f_{*}}{f^{*}}{\underoverset{\rightarrow }{\leftarrow }{\quad \scriptsize \scriptsize \bot \quad }} \mathbf{Sh}(Y).
          %p
            This is not obvious. The
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_{*}
            is easy to construct—
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mo *
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (f_{*} F)(V) = F(f^{-1} V)
          %p
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi F
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F \in \mathbf{Sh}(X)
            ,
            = succeed ")\u2014but" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Open
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in \mathbf{Open}(Y)
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^{*}
            is harder. It can be made easy by invoking the
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            between
            %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
            and
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+space"} étale bundles
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^{*}
          %p
            It is a fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^{*}
            preserves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            between
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            and
            = succeed "\u00A0" do
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            %a.maruku-eqref{:href => "#eq:eqShGM"} (6)
            in which the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            preserves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            look like in
            = succeed "-theoretic" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          #defnj.num_defn.thdefn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} f\colon \mathcal{E}\to \mathcal{F}
              is an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %munderover
                      %munderover
                        %mrow
                          %mspace{:width => "1em"}
                          %mstyle{:scriptlevel => "1"}
                            %mstyle{:scriptlevel => "1"}
                              %mo ⊥
                              %mspace{:width => "1em"}
                        %mo →
                        %mo ←
                      %mrow
                        %msub
                          %mi f
                          %mo *
                      %mrow
                        %msup
                          %mi f
                          %mo *
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E} \underoverset{f_{*}}{f^{*}}{\underoverset{\rightarrow }{\leftarrow }{\quad \scriptsize \scriptsize \bot \quad }} \mathcal{F}
            %p
              in which the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^{*}
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              %a.existingWikiWord{:href => "/nlab/show/left+exact"} left exact
              = succeed "\u2019.)" do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_{*}
              is called the
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              part of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^{*}
              is the
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              part.
          %p
            I will write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Topos
                %annotation{:encoding => "application/x-tex"} \mathbf{Topos}
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Topos
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Sh}\colon \mathbf{TopSp}\to \mathbf{Topos}
          %p
            which is (2-categorically)
            %a.existingWikiWord{:href => "/nlab/show/full"} full
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/faithful"} faithful
          #defnk.num_defn.thdefn
            %h6#examples_4 Examples
            %p  
            %ol
              %li
                %p
                #enumiEa.num_enume
                %p
                  Every
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi ℂ
                        %mo →
                        %mi 𝔻
                      %annotation{:encoding => "application/x-tex"} f\colon \mathbb{C} \to \mathbb{D}
                  induces a string of
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ℂ
                          %mo ^
                        %mspace{:width => "thinmathspace"}
                        %munderover
                          %mrow
                            %mo ⟵
                            %mstyle{:scriptlevel => "1"}
                              %msup
                                %mi f
                                %mo *
                            %mo −
                          %munderover
                            %mo →
                            %mrow
                              %msub
                                %mi f
                                %mo *
                            %mo ⊥
                          %munderover
                            %mo →
                            %mo ⊥
                            %mrow
                              %msub
                                %mi f
                                %mo !
                        %mspace{:width => "thinmathspace"}
                        %mover
                          %mi 𝔻
                          %mo ^
                      %annotation{:encoding => "application/x-tex"}
                        \\widehat{\mathbb{C}} \, \underoverset{\underoverset{f_{*}}{\perp }{\rightarrow }}{ \underoverset{\perp }{f_{!}}{\rightarrow }}{ \longleftarrow {\scriptsize f^{*}} - } \, \widehat{\mathbb{D}}
                %p
                  between
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/presheaf+categories"} presheaf categories
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mo *
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ∘
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f^{*} = -\circ f
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo !
                      %annotation{:encoding => "application/x-tex"} f_{!}
