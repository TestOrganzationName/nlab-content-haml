            = succeed "\u2019" do
              %a.existingWikiWord{:href => "/nlab/show/the+category+of+sets"} the category of sets
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            = succeed "," do
              %a{:href => "#sectionb"} 2
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/the+category+of+sets"} the category of sets
            %a.existingWikiWord{:href => "/nlab/show/inverse+images"} inverse images
