                  %annotation{:encoding => "application/x-tex"} f_{*}
              is
              %a.existingWikiWord{:href => "/nlab/show/full"} full
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/faithful"} faithful
          %p
            We then say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            is a
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            is actually a (
            %a.existingWikiWord{:href => "/nlab/show/full"}> full
            )
            %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_{*}
            is the inclusion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}\hookrightarrow \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_{*}
            to be any old
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            induces an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            to its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/image"} image
          %p
            Probably the easiest
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            are the
            = succeed ":" do
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/presheaf+toposes"} presheaf toposes
            %a.existingWikiWord{:href => "/nlab/show/equivalent"} equivalent
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℂ
                    %mo ^
                  %mo =
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mrow
                      %msup
                        %mi ℂ
                        %mi{:mathvariant => "normal"} op
                %annotation{:encoding => "application/x-tex"} \widehat{\mathbb{C}} = \mathbf{Set}^{\mathbb{C}^{\mathrm{op}}}
            for some
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/presheaf+toposes"} presheaf toposes
            are relatively easy too. They have a special name:
          #defnn.num_defn.thdefn
            %h6#definition_6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              is
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
              if it is (
              %a.existingWikiWord{:href => "/nlab/show/equivalent"} equivalent
              to) a
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
              of some
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
          %p
            For instance, we saw in Example 
            %a{:href => "#defnk"}> 11
            (
            %a{:href => "#enumiEb"}> 2
            ) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(X)
            is a
            %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Open
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \mathbf{Psh}(X) = \widehat{\mathbf{Open}(X)}
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(X)
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
          %p
            Being
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
            is generally thought of as a mild condition on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            has all small
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            such as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi FinSet
                  %annotation{:encoding => "application/x-tex"} \mathbf{FinSet}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi FinSet
                      %mrow
                        %msup
                          %mi ℂ
                          %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} \mathbf{FinSet}^{\mathbb{C}^{\mathrm{op}}}
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            arising from
            %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            (or
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            subject to some other
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            bound), most of the
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            that people have worked with are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/effective+topos"} effective topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+toposes"} Grothendieck toposes
            occur in the
            = succeed "-theoretic" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
          %p
            There is a theorem of Giraud giving a list of conditions on a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/equivalent"} equivalent
            to it being a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            such as ‘there is a small
            = succeed "\u2019." do
              %a.existingWikiWord{:href => "/nlab/show/generating+set"} generating set
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+toposes"} Grothendieck toposes
            are sometimes regarded as the nice
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            is not as nice as the definition of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
          %p
            Definition 
            %a{:href => "#defnn"} 14
            is not the definition of
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            that you will find in most books. I will now give a brief indication of what the standard definition is and why it is equivalent to the one above.
