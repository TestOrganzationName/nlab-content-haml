                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathbf{Set}\to \mathcal{E}
          %h3#embeddings_and_grothendieck_toposes Embeddings and Grothendieck toposes
          %p
            For any
            %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            of a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y \hookrightarrow X
            is an
            = succeed "," do
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            to its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/image"} image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
