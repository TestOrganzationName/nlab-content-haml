            of the same shape. (They have to be the same shape in order for expressions such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, y)
            to make sense.) And just as for ordinary
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi xy
                %annotation{:encoding => "application/x-tex"} xy
            instead of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m(x, y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} x^{-1}
            instead of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i(x)
          %p
            More valuably still,
            %em proofs
            written down in the classical
            = succeed "-theoretic" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            is also true for
            %a.existingWikiWord{:href => "/nlab/show/generalized+elements"} generalized elements
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi a
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x, y, a \in X
          #eq:eqcancellation.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi a
                  %mo =
                  %mi y
                  %mi a
                  %mo ⇒
                  %mi x
                  %mo =
                  %mi y
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  x a = y a \implies x = y.
          %p Proof:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi x
                          %mi a
                          %mo =
                          %mi y
                          %mi a
                        %mtd
                          %mo ⇒
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mi a
                          %mo{:stretchy => "false"} )
                          %msup
                            %mi a
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mi a
                          %mo{:stretchy => "false"} )
                          %msup
                            %mi a
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo ⇒
                          %mi x
                          %mo{:stretchy => "false"} (
                          %mi a
                          %msup
                            %mi a
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi y
                          %mo{:stretchy => "false"} (
                          %mi a
                          %msup
                            %mi a
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ⇒
                          %mi x
                          %mi e
                          %mo =
                          %mi y
                          %mi e
                          %mo ⇒
                          %mi x
                          %mo =
                          %mi y
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  x a = y a &amp; \implies (x a)a^{-1} = (y a)a^{-1} \implies x(a a^{-1}) = y(a a^{-1}) \\ &amp; \implies x e = y e \implies x = y.
                  \\end{aligned}
          %p
            We can immediately conclude that the
            = succeed "\u00A0" do
              %a.existingWikiWord{:href => "/nlab/show/implication"} implication
            %a.maruku-eqref{:href => "#eq:eqcancellation"} (4)
            holds whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            in an arbitrary
            %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi a
                %annotation{:encoding => "application/x-tex"} x, y, a
            are
            %a.existingWikiWord{:href => "/nlab/show/generalized+elements"} generalized elements
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of the same shape. Indeed, each step in the proof is an application of an
            %a.existingWikiWord{:href => "/nlab/show/axiom"} axiom
            such as 
            %a.maruku-eqref{:href => "#eq:eqassoc"} (3)
            valid in the general setting.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            is a massively labour-saving device. To prove that an equation valid in ordinary
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            is also valid for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+groups"} internal groups
            %a.existingWikiWord{:href => "/nlab/show/generalized+elements"} generalized elements
            too. In contrast, try proving the internal version of the equation
          #eq:eqinverse.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi y
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi x
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mi y
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  y^{-1} x^{-1} = (x y)^{-1}
          %p
            by diagrammatic methods. First it has to be
            %em stated
            diagrammatically. It says that the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                        %mtd
                          %mover
                            %semantics
                              %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                            %mtext sym
                          %mspace{:width => "thickmathspace"}
                          %mi X
                          %mo ×
                          %mi X
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %semantics
                              %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                            %mrow
                              %mi i
                              %mo ×
                              %mi i
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %mspace{:width => "1em"}
                              %mi m
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %semantics
                                    %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrow]]
                        %mtd
                        %mtd
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %semantics
                                    %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrow]]
                          %mpadded{:width => "0"}
                            %mi m
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %munder
                            %semantics
                              %annotation-xml{:encoding => "SVG1.1"} [[!include SVG triplelengthrightarrow]]
                            %mi i
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix} X \times X &amp; \overset{\text{sym}}{\begin{svg} [[!include SVG rightarrow]]\end{svg}}\; X \times X\; \overset{i \times i}{\begin{svg} [[!include SVG rightarrow]]\end{svg}} &amp; X \times X \\ \mathllap{\quad m} \array{\begin{svg} [[!include SVG downarrow]]\end{svg}} &amp;&amp; \array{\begin{svg} [[!include SVG downarrow]]\end{svg}} \mathrlap{m} \\ X &amp; \underset{i}{\begin{svg} [[!include SVG triplelengthrightarrow]]\end{svg}} &amp; X \end{matrix}
          %p
            commutes. Then it has to be
            = succeed "," do
              %em proved
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            %a.maruku-eqref{:href => "#eq:eqinverse"} (5)
            chosen was very simple: for more complex statements, the benefits of the
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            become clearer still.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            is similar to that of
            %a.existingWikiWord{:href => "/nlab/show/finite+product"} finite product
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, y)
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/generalized+elements"} generalized elements
            %a.existingWikiWord{:href => "/nlab/show/generalized+elements"} generalized elements
            of exponentials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mi X
                %annotation{:encoding => "application/x-tex"} Y^{X}
            (to be thought of as
            %a.existingWikiWord{:href => "/nlab/show/families"} families
            of maps
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
            %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
            such as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi X
                  %mspace{:width => "mediummathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "mediummathspace"}
                  %mi f
                  %mi x
                  %mo =
                  %mi g
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{ x \in X \:|\:f x = g x \}
          %p
            (the
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %munderover
                      %mo ⇉
                      %mrow
                        %mspace{:width => "1em"}
                        %mi g
                        %mspace{:width => "1em"}
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \underoverset{\quad g \quad }{f}{\rightrightarrows } Y
            %a.existingWikiWord{:href => "/nlab/show/the+category+of+sets"} the category of sets
            can be reproduced in an arbitrary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %a.existingWikiWord{:href => "/nlab/show/constructive"} constructive
            proof, in a sense that can be made precise—generalizes to an arbitrary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p
            Phrases with more or less the same meaning as ‘
            %a.existingWikiWord{:href => "/nlab/show/internal+language"}> internal language
            ’ are ‘
            %a.existingWikiWord{:href => "/nlab/show/Mitchell--B%C3%A9nabou+language"}> Mitchell–Bénabou language
            ’ and ‘
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"}> internal logic
            ’. See, for instance,
            %a{:href => "#citeMaMo"} Mac Lane and Moerdijk
            (
            %a{:href => "#citeMaMo"}> 1994
            ) or
            %a{:href => "#citeJohSE"} Johnstone
            (
            %a{:href => "#citeJohSE"}> 2003
            ). There you can also find more spectacular applications of
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/forcing"} forcing
          #sectionc.num_section
          %h2#toposes_and_geometry.num_section Toposes and geometry
          %p
            This section covers concepts such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            (map of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            has inspired so much of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
          %h3#sheaves Sheaves
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to denote an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            of a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Open
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Open}(X)
            for its
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi Open
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} op
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} F\colon \mathbf{Open}(X)^{\mathrm{op}}\to \mathbf{Set}
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(U)
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            are called
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            (for reasons to be explained). It also assigns to each open
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊆
                  %mi U
                %annotation{:encoding => "application/x-tex"} V \subseteq U
            a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(U) \to F(V)
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and denoted by
            = succeed "." do
