                  %em{:style => "font-style: normal"} inclusion
              %a.existingWikiWord{:href => "/nlab/show/direct+image+functor"} direct image functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
