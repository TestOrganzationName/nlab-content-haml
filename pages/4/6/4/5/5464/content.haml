                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            = succeed "-theoretic" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %span.newWikiWord
              notation
              %a{:href => "/nlab/new/notation"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi …
                  %mspace{:width => "mediummathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "mediummathspace"}
                  %mi …
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ \ldots \:|\:\ldots \}
            are something to do with the
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p
            (There are actually
            %em several
            possible
            %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            %a.existingWikiWord{:href => "/nlab/show/models"} models
            in
            = succeed "\u2014namely," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            = succeed "\u2014but" do
              %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            %a.existingWikiWord{:href => "/nlab/show/models"} models
            in other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            is obtained by changing
            = succeed "\u00A0" do
              %a.existingWikiWord{:href => "/nlab/show/axiom"} axiom
            %a.maruku-eqref{:href => "#eq:eqfieldmain"} (8)
            to ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ∀
                  %mi x
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} \forall x \in R
            ,
            = succeed "\u2019." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mspace{:width => "negativethinmathspace"}
                    %mo ∃
                    %mi y
                    %mo :
                    %mi x
                    %mi y
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mi x
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (\not \!\exists y: x y = 1) \implies x = 0
            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            such as 
            %a.maruku-eqref{:href => "#eq:eqfieldnontriv"} (7)
            and 
            %a.maruku-eqref{:href => "#eq:eqfieldmain"}> (8)
            , there is an automatic process converting it into a definition that makes sense in an arbitrary
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p You now have the choice between a short story and a long story.
          %p
            The short story is that what we did for
            %a.existingWikiWord{:href => "/nlab/show/finite+product"} finite product
            and
            %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            can also be done for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            corresponding to
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            are called the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+theories"} geometric theories
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            corresponding to a particular
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            is called its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
          %p
            The long story is longer because there are two different notions of map of
            = succeed "\u2014and" do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            is in order to state the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            resulting from a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/theory"} theory
          %p
            The more obvious but less used notion of map of
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            preserving all the
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            in sight:
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponentials
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            = succeed "." do
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/logical+morphisms"} logical morphisms
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            = succeed "\u2019," do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} higher-order theory
            %em
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            of a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            you can also quantify over
            %em
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            get along well with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/logical+morphisms"} logical morphisms
            %a.existingWikiWord{:href => "/nlab/show/logical+morphisms"} logical morphisms
            preserve everything. So you can tell a similar story for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            %a.existingWikiWord{:href => "/nlab/show/logical+morphisms"} logical morphisms
            and
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} higher order theories
            as for
            %a.existingWikiWord{:href => "/nlab/show/finite+product"} finite product
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            = succeed "-preserving" do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theories"} algebraic theories
          %p
            The more popular notion of map of
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            is that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            = succeed "," do
              %a{:href => "#sectionc"} 3
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            between
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            with a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            = succeed "-preserving" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            are the
            = succeed "." do
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/geometric+theories"} geometric theories
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            is first-order, and almost every first-order
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            that one encounters is geometric.
          %p
            Given a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            for the
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            is a
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            with the property that for any
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/models"} models
            of the
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            correspond naturally to
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}\to \mathcal{T}
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            has a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
          %p
            There are two surprises here. One is the appearance of the word ‘
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"}> cocomplete
            ’, which I will not explain and will not bother inserting below. It is generally thought of as a mild condition (satisfied by any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
          %p
            The bigger surprise is the reversal of direction. The previous cases lead us to expect
            %a.existingWikiWord{:href => "/nlab/show/models"} models
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            to correspond to maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}\to \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            is a pair of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+algebra"} universal algebra
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            is dual to
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            would then have been a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            = succeed "-preserving" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            preserving
            %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            and small
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          %p
            If a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            is thought of as a generalized
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            (as in Section 
            %a{:href => "#sectionc"}> 3
            ) then the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            of a
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            can be thought of as its
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/models"} models
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            is (by Definition 
            %a{:href => "#defnl"}> 12
            ) a
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}\to \mathcal{T}
            %a.existingWikiWord{:href => "/nlab/show/model"} model
            of the
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            can be construed as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+toposes"} classifying toposes
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            of
            = succeed "\u2019" do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+cuts"} Dedekind cuts
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(\mathbb{R})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            regarded as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p
            Given how much structure a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            contains, it is surprising how many
            %a.existingWikiWord{:href => "/nlab/show/classifying+toposes"} classifying toposes
            can be described simply. I will now describe the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            of any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
          %p
            We will need the notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+finitely+presentable+category"} finite presentability
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            (in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/locally+finitely+presentable+category"} finitely presentable
            if it admits a presentation by a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            of
            %a.existingWikiWord{:href => "/nlab/show/generators"} generators
            subject to a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relations"} relations
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of finitely presentable
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            and all
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            between them will be written
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Grp
                      %mi{:mathvariant => "normal"} fp
                  %annotation{:encoding => "application/x-tex"} \mathbf{Grp}_{\mathrm{fp}}
          %div{:style => "margin-left: 2em"}
            %h5#aside Aside
            %p
              %a.existingWikiWord{:href => "/nlab/show/locally+finitely+presentable+category"} Finite presentability
              is a more categorical concept than it might seem. Writing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} T\colon \mathbf{Set}\to \mathbf{Set}
              for the
              %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/generators"} generators
              is an
              %a.existingWikiWord{:href => "/nlab/show/element"} element
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi X
                      %mo ×
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T X \times T X
              %a.existingWikiWord{:href => "/nlab/show/family"} family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (r_{i})_{i \in I}
              of relations is a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo →
                      %mi T
                      %mi X
                      %mo ×
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} I \to T X \times T X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⇉
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    I \rightrightarrows T X
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi I
                    %mo ⇉
                    %mi F
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    F I \rightrightarrows F X
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Grp
                    %annotation{:encoding => "application/x-tex"} \mathbf{Grp}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Grp
                  %annotation{:encoding => "application/x-tex"} F\colon \mathbf{Set}\to \mathbf{Grp}
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              presented by these
              %a.existingWikiWord{:href => "/nlab/show/generators"} generators
              and relations is the
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              of this
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Grp
                    %annotation{:encoding => "application/x-tex"} \mathbf{Grp}
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              is finitely presentable precisely when it is the
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              of some diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi I
                    %mo ⇉
                    %mi F
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F I \rightrightarrows F X
              in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            %p
              This formulation of
              %a.existingWikiWord{:href => "/nlab/show/finite"} finite
              presentability in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Grp
                  %annotation{:encoding => "application/x-tex"} \mathbf{Grp}
              uses the
              %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/finite"} finite
              presentability of an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              of any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
          %p
            As promised, the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            for
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            is easy to describe:
          #defnp.num_defn.thplain
            %h6#theorem Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
              for
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Set
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Grp
                            %mi{:mathvariant => "normal"} fp
                    %annotation{:encoding => "application/x-tex"} \mathbf{Set}^{\mathbf{Grp}_{\mathrm{fp}}}
          %p
            In other words, for any
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is the same thing as a
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi Grp
                          %mi{:mathvariant => "normal"} fp
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}\to \mathbf{Set}^{\mathbf{Grp}_{\mathrm{fp}}}
          %p
            The same goes for other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theories"} algebraic theories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/theory+of+objects"} theory of objects
            %a.existingWikiWord{:href => "/nlab/show/models"} models
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            are simply
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            is just a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            correspond to
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                      %mstyle{:mathvariant => "bold"}
                        %mi FinSet
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}\to \mathbf{Set}^{\mathbf{FinSet}}
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mstyle{:mathvariant => "bold"}
                      %mi FinSet
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}^{\mathbf{FinSet}}
            is therefore called the
            = succeed "." do
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
          %p
            We have been asking, for a given
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            classifies it?’ But we can turn the question round and ask, for a given
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            classify?’ In other words, what are the
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            from an arbitrary
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            into
            = succeed "?" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
            %em every
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            of some
            = succeed "\u2014although" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            that is, perhaps this does not say very much.
          %p
            There are clean answers to this reversed question for many
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            is the
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}(\mathbb{C}, J)
            of
            %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
            on a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            (Section 
            %a{:href => "#sectionc"}> 3
            ). Here I will just tell you the answer for a smaller class of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
          #defnq.num_defn.thplain
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℂ
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathbb{C}}
              classifies
              = succeed "-preserving" do
                %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite-limit
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              out of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            In other words, for any
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mo →
                  %mover
                    %mi ℂ
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \mathcal{E}\to \widehat{\mathbb{C}}
            is the same thing as a
            = succeed "-preserving" do
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite-limit
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} \to \mathcal{E}
          %p
            (If you know about
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/flat+functors"} flat functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            has
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℂ
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{\mathbb{C}}
            classifies
            %a.existingWikiWord{:href => "/nlab/show/flat+functors"} flat functors
            out of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+Theorem"} Diaconescu's Theorem
          %p
            So there is a back-and-forth translation between
            %a.existingWikiWord{:href => "/nlab/show/geometric+theories"} geometric theories
            and the
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            that classify them. In many cases, this translation is surprisingly straightforward.
