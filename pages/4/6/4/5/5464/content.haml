                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f\colon X \to Y
            of
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            and a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⊆
