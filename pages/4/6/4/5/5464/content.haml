                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Topos
                %annotation{:encoding => "application/x-tex"} \mathbf{Sh}\colon \mathbf{TopSp}\to \mathbf{Topos}
            factorizes as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
