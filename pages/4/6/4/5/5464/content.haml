                      %annotation{:encoding => "application/x-tex"} s
                  is precisely a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/right+inverse"} right inverse
                  = succeed "\u2019," do
                    %a.existingWikiWord{:href => "/nlab/show/section"} section
