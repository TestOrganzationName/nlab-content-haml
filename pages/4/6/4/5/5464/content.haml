                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
          %p
            There is also an abstract categorical explanation of where the concept of
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            comes from. Fix a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Open
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  I\colon \mathbf{Open}(X) \to \mathbf{TopSp}/X
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                %annotation{:encoding => "application/x-tex"} \mathbf{TopSp}
            is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi TopSp
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{TopSp}/X
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ↪
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I(U) = (U \hookrightarrow X)
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            embodies the simple thought that an
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            can be treated as a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            in its own right. We now apply to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            two very general categorical constructions, from which the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            concept will appear automatically.
          %p
            First, purely because the
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is small and the
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            has small
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Open
                      %mo{:stretchy => "false"} (
                      %mi X
