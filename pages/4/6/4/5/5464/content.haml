                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix} P &amp; \begin{svg} [[!include SVG rightarrow]]\end{svg} &amp; 1 \\ \array{\begin{svg} [[!include SVG downarrowtail]]\end{svg}} \mathrlap{\array{\arrayopts{\align{bottom}}\space{0}{30}{10}\begin{svg} [[!include SVG pullback]]\end{svg}}} &amp;&amp; \array{\begin{svg} [[!include SVG downarrowtail]]\end{svg}}\mathrlap{1} \\ R \times R &amp; \begin{svg} [[!include SVG rightarrow]]\end{svg} &amp; R. \end{matrix}
          %p
            Now we want to define the ‘
            %a.existingWikiWord{:href => "/nlab/show/set"}> set
            ’
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of
            %a.existingWikiWord{:href => "/nlab/show/units"} units
            as the
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of the
            %a.existingWikiWord{:href => "/nlab/show/composite"} composite
            map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mrow
                    %mo (
                    %mi P
                    %mo ↣
                    %mi R
