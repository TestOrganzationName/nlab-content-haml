            be a
            %a.existingWikiWord{:href => "/nlab/show/family"} family
            of
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
