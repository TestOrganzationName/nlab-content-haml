                %annotation{:encoding => "application/x-tex"} f\colon Y \to X
            of
            %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            is an
            %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            if and only if the
            %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            part
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_{*}
            of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f\colon \mathbf{Sh}(Y) \to \mathbf{Sh}(X)
            is
            %a.existingWikiWord{:href => "/nlab/show/full"} full
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/faithful"} faithful
          #defnm.num_defn.thdefn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℱ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} f\colon \mathcal{F}\to \mathcal{E}
