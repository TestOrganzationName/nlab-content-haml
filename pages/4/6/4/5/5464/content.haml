            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/ordinals"} ordinals
            %a.existingWikiWord{:href => "/nlab/show/algebras+for+an+operad"} algebras for an operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            the free
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            containing a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functors"} monoidal functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                  %mo →
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{T}\to \mathcal{E}
            correspond to
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            We might define a
            %strong
              %em{:style => "font-style: normal"}
                monoidal
                %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            to be a small
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/PROPs"} PROPs
            %a.existingWikiWord{:href => "/nlab/show/dimensional"} dimensional
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theories"} topological quantum field theories
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            of (or, ‘
            %a.existingWikiWord{:href => "/nlab/show/PROP"} PROP
            for’) commutative
            %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebras"} Frobenius algebras
            is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of smooth 1-
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            and
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            classes of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cobordisms"} cobordisms
          %p
            All of this is to give an impression of how far-reaching these ideas are. It is a sketch of the context in which
            %a.existingWikiWord{:href => "/nlab/show/classifying+toposes"} classifying toposes
            can be understood.
          %p
            You will have guessed that the same kind of thing can be said for
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            as for
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            with
            %a.existingWikiWord{:href => "/nlab/show/finite"} finite
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            have very rich structure (
            %em much
            more than just
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %a.existingWikiWord{:href => "/nlab/show/theories"} theories
            indeed.
          %p
            An example of the kind of
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            that can be interpreted in a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            is the
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            is, of course, a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
