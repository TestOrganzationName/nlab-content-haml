              %a.existingWikiWord{:href => "/nlab/show/monic"} monic
          #defna.num_defn.thdefn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              %strong
                %em{:style => "font-style: normal"}
                  %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              together with a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝗍
                    %mo{:lspace => "verythinmathspace"} :
                    %mn 1
                    %mo →
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} &amp;#x1D5CD;\colon 1 \to \Omega
              such that for every
              %a.existingWikiWord{:href => "/nlab/show/mono"} mono
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ↣
                      %mi m
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \stackrel{m}{\rightarrowtail } X
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \chi \colon X \to \Omega
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %semantics
                                %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                              %mstyle{:scriptlevel => "1"}
                                %mo !
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi m
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrowtail]]
                          %mtd
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrow]]
                            %mpadded{:width => "0"}
                              %mi 𝗍
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %semantics
                                %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                              %mstyle{:scriptlevel => "1"}
                                %mi χ
                          %mtd
                            %mi Ω
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{matrix} A &amp; \overset{\scriptsize !}{\begin{svg} [[!include SVG rightarrow]]\end{svg}} &amp; 1 \\ \mathllap{m}\array{\begin{svg} [[!include SVG downarrowtail]]\end{svg}} &amp;&amp; \array{\begin{svg} [[!include SVG downarrow]]\end{svg}} \mathrlap{&amp;#x1D5CD;} \\ X &amp; \underset{\scriptsize \chi }{\begin{svg} [[!include SVG rightarrow]]\end{svg}} &amp; \Omega \end{matrix}
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback+square"} pullback square
          %p
            So, we have just observed that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi A
                %annotation{:encoding => "application/x-tex"} \chi _{A}
            (or properly,
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \chi _{m}
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/characteristic+function"} characteristic function
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (or
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
          %p To understand this further, we need two lemmas.
          #defnb.num_defn.thplain
            %h6#lemma Lemma
            %p
              In any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of a
              %a.existingWikiWord{:href => "/nlab/show/mono"} mono
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/mono"} mono
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo ⋅
                          %mtd
                            %semantics
                              %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                          %mtd
                            %mo ⋅
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi m
                                %mo ′
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrow]]
                          %mtd
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrow]]
                            %mpadded{:width => "0"}
                              %mi m
                        %mtr
                          %mtd
                            %mo ⋅
                          %mtd
                            %semantics
                              %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                          %mtd
                            %mo ⋅
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{matrix} \cdot &amp; \begin{svg} [[!include SVG rightarrow]]\end{svg} &amp; \cdot \\ \mathllap{m'}\array{\begin{svg} [[!include SVG downarrow]]\end{svg}} &amp;&amp; \array{\begin{svg} [[!include SVG downarrow]]\end{svg}} \mathrlap{m} \\ \cdot &amp; \begin{svg} [[!include SVG rightarrow]]\end{svg} &amp; \cdot \end{matrix}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pullback+square"} pullback square
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mono"} mono
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} m'
          #defnc.num_defn.thplain
            %h6#lemma_2 Lemma
            %p
              In any
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              is a mono.
          %p
            So, pulling
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝗍
                  %mo{:lspace => "verythinmathspace"} :
                  %mn 1
                  %mo →
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} &amp;#x1D5CD;\colon 1 \to \Omega
            back along
            %em any
            map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} X \to \Omega
            gives a mono into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            It will also help to know the result of the following little exercise (
            %a{:href => "#citeJohSE"} Johnstone
            (
            %a{:href => "#citeJohSE"}> 2003
            ), A1.6.1). It says, roughly, that in the definition of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is
            %a.existingWikiWord{:href => "/nlab/show/terminal"} terminal
            comes for free.
          #defnd.num_defn.thplain
            %h6#fact Fact
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mover
                      %mo ↣
                      %mi 𝗍
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} T \stackrel{&amp;#x1D5CD;}{\rightarrowtail } \Omega
              be a mono in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ↣
                      %mi m
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \stackrel{m}{\rightarrowtail } X
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \chi \colon X \to \Omega
              such that there is a
              %a.existingWikiWord{:href => "/nlab/show/pullback+square"} pullback square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %semantics
                              %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                          %mtd
                            %mi T
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi m
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrowtail]]
                          %mtd
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrowtail]]
                            %mpadded{:width => "0"}
                              %mi 𝗍
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %semantics
                                %annotation-xml{:encoding => "SVG1.1"} [[!include SVG rightarrow]]
                              %mstyle{:scriptlevel => "1"}
                                %mi χ
                          %mtd
                            %mi Ω
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{matrix} A &amp; \begin{svg} [[!include SVG rightarrow]]\end{svg} &amp; T \\ \mathllap{m}\array{\begin{svg} [[!include SVG downarrowtail]]\end{svg}} &amp;&amp; \array{\begin{svg} [[!include SVG downarrowtail]]\end{svg}} \mathrlap{&amp;#x1D5CD;} \\ X &amp; \underset{\scriptsize \chi }{\begin{svg} [[!include SVG rightarrow]]\end{svg}} &amp; \Omega . \end{matrix}
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is
              %a.existingWikiWord{:href => "/nlab/show/terminal"} terminal
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            This leads to a second description of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifiers"} subobject classifiers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Mono
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Mono}(\mathcal{E})
            be the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are monos in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            and whose maps are
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            squares. Then a
            %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            is exactly a
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Mono
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Mono}(\mathcal{E})
          %p
            Here is a third way of looking at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifiers"} subobject classifiers
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            and an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %strong
              %em{:style => "font-style: normal"}
                %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is officially an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} isomorphism class
            of monos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ↣
                    %mi m
                  %mi X
                %annotation{:encoding => "application/x-tex"} A \stackrel{m}{\rightarrowtail } X
            (where
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            is taken in the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}/X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}= \mathbf{Set}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ↣
                    %mi m
                  %mi X
                  %mo ,
                  %mspace{:width => "1em"}
                  %mi A
                  %mo ′
                  %mover
                    %mo ↣
                    %mrow
                      %mi m
                      %mo ′
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  A \stackrel{m}{\rightarrowtail } X, \quad A' \stackrel{m'}{\rightarrowtail } X
          %p
            are
            %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            if and only if they have the same
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/image"} image
            %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            correspond one-to-one with
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            of
            = succeed "\u2019" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "\u2019," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Sub
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Sub}(X)
            be the
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of
            %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
            (in the official sense) of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/well-powered+category"} well-powered
