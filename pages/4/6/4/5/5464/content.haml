                        %mtd
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %semantics
                                    %annotation-xml{:encoding => "SVG1.1"} [[!include SVG downarrowtail]]
                          %mpadded{:width => "0"}
                            %mrow
                              %mtable{:align => "bottom"}
                                %mtr
                                  %mtd
                                    %mspace{:depth => "3.0ex", :height => ".0ex", :width => "1.0em"}
                                    %semantics
                                      %annotation-xml{:encoding => "SVG1.1"} [[!include SVG pullback]]
                        %mtd
                        %mtd
                          %mrow
                            %mtable
