              is a
              %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
              such that every
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              has a
              %a.existingWikiWord{:href => "/nlab/show/join"} join
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
