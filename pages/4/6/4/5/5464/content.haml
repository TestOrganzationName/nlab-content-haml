                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom"} axiom
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↣
                  %mi R
                %annotation{:encoding => "application/x-tex"} U \rightarrowtail R
            consisting of the
            %a.existingWikiWord{:href => "/nlab/show/units"} units
            (
            %a.existingWikiWord{:href => "/nlab/show/invertible+elements"}> invertible elements
            ). The ‘
            %a.existingWikiWord{:href => "/nlab/show/set"}> set
            ’
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
