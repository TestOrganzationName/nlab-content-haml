          %h2#idea Idea
          %p
            The
            %strong zeta polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z_P(n)
            of a finite
            %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            counts the number of multichains (also known as “weakly increasing sequences”) of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %h2#definition Definition
          %p
            By a
            %em multichain
            of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ≤
                    %msub
                      %mi x
                      %mn 1
                    %mo ≤
                    %mi ⋯
                    %mo ≤
                    %msub
                      %mi x
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x_0 \le x_1 \le \cdots \le x_n
            %a.existingWikiWord{:href => "/nlab/show/order-preserving+function"} order-preserving function
            from the
            %a.existingWikiWord{:href => "/nlab/show/linear+order"} linear order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo &lt;
                  %mn 1
                  %mo &lt;
                  %mi ⋯
                  %mo &lt;
                  %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} [n] = \{ 0 \lt 1 \lt \cdots \lt n \}
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} |
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} Z_P(n) = |Hom([n],P)|
          %p
            defines a
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %sup#fnref:1
              %a{:href => "#fn:1", :rel => "footnote"} 1
            first observe that any function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} [n] \to P
            factors as a
            %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            onto some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo &lt;
                  %mn 1
                  %mo &lt;
                  %mi ⋯
                  %mo &lt;
                  %mi k
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} [k] = \{ 0 \lt 1 \lt \cdots \lt k \}
            (where
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \le n
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [k]
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            can therefore be calculated explicitly as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %mi d
                  %msub
                    %mi b
                    %mi k
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mi n
                      %mi k
                    %mo )
                %annotation{:encoding => "application/x-tex"} Z_P(n) = \sum_{k=0}^{d} b_k \binom{n}{k}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi k
                %annotation{:encoding => "application/x-tex"} b_k
            is the number of
            %em chains
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mo &lt;
                  %msub
                    %mi x
                    %mn 1
                  %mo &lt;
                  %mi ⋯
                  %mo &lt;
                  %msub
                    %mi x
                    %mi k
                %annotation{:encoding => "application/x-tex"} x_0 \lt x_1 \lt \cdots \lt x_k
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            (i.e., injective order-preserving functions from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [k]
            to
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is the length of the longest chain. Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z_P(n)
            is a polynomial of degree equal to the length of the longest chain in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %h2#examples Examples
          %p
            The zeta polynomial of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo &lt;
                  %mn 1
                  %mo &lt;
                  %mn 2
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} [2] = \{ 0 \lt 1 \lt 2 \}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 3
                  %mo +
                  %mn 3
                  %mi n
                  %mo +
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mi n
                      %mn 2
                    %mo )
                  %mo =
                  %mfrac
                    %mrow
                      %msup
                        %mi n
                        %mn 2
                      %mo +
                      %mn 5
                      %mi n
                      %mo +
                      %mn 6
                    %mn 2
                %annotation{:encoding => "application/x-tex"} 3 + 3n + \binom{n}{2} = \frac{n^2 + 5n + 6}{2}
          %p
            For example, evaluating the polynomial at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n=0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            confirms that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [2]
            contains 3 points and 6
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/intervals"} intervals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n=2
            confirms that there are 10 order-preserving functions from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [2]
            to itself.
          %p The zeta polynomial of the 5-element poset
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi v
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi u
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↖
                        %mtd
                      %mtr
                        %mtd
                          %mi y
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi z
                      %mtr
                        %mtd
                        %mtd
                          %mo ↖
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi x
                        %mtd
                        %mtd
                %annotation{:encoding => "application/x-tex"} P = \array{&amp;&amp;v&amp;&amp; \\ &amp;&amp;\uparrow&amp;&amp; \\ &amp;&amp;u&amp;&amp; \\ &amp;\nearrow&amp; &amp;\nwarrow&amp; \\ y &amp;&amp;&amp;&amp; z \\ &amp;\nwarrow&amp; &amp;\nearrow&amp; \\ &amp;&amp;x&amp;&amp;}
          %p
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 5
                    %mo +
                    %mn 9
                    %mi n
                    %mo +
                    %mn 7
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mi n
                        %mn 2
                      %mo )
                    %mo +
                    %mn 2
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mi n
                        %mn 3
                      %mo )
                    %mo =
                    %mfrac
                      %mrow
                        %mn 2
                        %msup
                          %mi n
                          %mn 3
                        %mo +
                        %mn 15
                        %msup
                          %mi n
                          %mn 2
                        %mo +
                        %mn 37
                        %mi n
                        %mo +
                        %mn 30
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} 5 + 9n + 7\binom{n}{2} + 2\binom{n}{3} = \frac{2n^3 + 15n^2 + 37n + 30}{6}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n=1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            contains 14 distinct intervals.
          %h2#properties Properties
          %h3#relation_to_order_polynomial Relation to order polynomial
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/order+polynomial"} order polynomial
            is related to the zeta polynomial by the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Z
                    %mrow
                      %msup
                        %mi P
                        %mo{:stretchy => "false"} ↓
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Omega_P(n+2) = Z_{P^\downarrow}(n)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo{:stretchy => "false"} ↓
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi P
                %annotation{:encoding => "application/x-tex"} P^\downarrow \cong (2)^P
            is the lattice of
            %a.existingWikiWord{:href => "/nlab/show/lower+sets"} lower sets
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %a.existingWikiWord{:href => "/nlab/show/currying"} currying
            isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msup
                    %mi P
                    %mo{:stretchy => "false"} ↓
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi P
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ↓
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom([n], P^\downarrow) \cong Hom([n] \times P, (2)) \cong Hom(P, [n]^\downarrow)
          %p
            together with the isomorphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ↓
                    %mo ≅
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [n]^\downarrow \cong [n+1] \cong (n+2)
          %h3#relation_to_zeta_function Relation to zeta function
          %p
            Using the formalism of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/incidence+algebras"} incidence algebras
            %em zeta function
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            (defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \zeta_P(x,y) = 1
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\le y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \zeta_P(x,y) = 0
            otherwise):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi P
                  %msubsup
                    %mi ζ
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z_P(n) = \sum_{x,y\in P} \zeta_P^n(x,y)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ζ
                    %mi P
                    %mi n
                %annotation{:encoding => "application/x-tex"} \zeta_P^n
            is the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ζ
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \zeta_P
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⋅
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo ≤
                      %mi z
                      %mo ≤
                      %mi y
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f\cdot g)(x,y) = \sum_{x \le z \le y} f(x,z) \cdot g(z,y)
          %p
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ζ
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \zeta_P^n(x,y)
            computes the number of multichains of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
          %p
            As a special case, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            has both a
            %a.existingWikiWord{:href => "/nlab/show/bottom"} bottom
            element 0 and a
            %a.existingWikiWord{:href => "/nlab/show/top"} top
            element 1, then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi ζ
                    %mi P
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z_P(n) = \zeta_P^{n+2}(0,1)
          %p
            since an arbitrary multichain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mo ≤
                  %msub
                    %mi x
                    %mn 1
                  %mo ≤
                  %mi ⋯
                  %mo ≤
                  %msub
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x_0 \le x_1 \le \cdots \le x_n
            of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            can be extended to a multichain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≤
                  %msub
                    %mi x
                    %mn 0
                  %mo ≤
                  %msub
                    %mi x
                    %mn 1
                  %mo ≤
                  %mi ⋯
                  %mo ≤
                  %msub
                    %mi x
                    %mi n
                  %mo ≤
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \le x_0 \le x_1 \le \cdots \le x_n \le 1
            of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
