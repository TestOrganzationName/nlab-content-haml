                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitry+Volkov"} Dmitry Volkov
                = succeed "," do
                  %em Superstrings and supermembranes in the doubly supersymmetric geometrical approach
                %strong 446
                (1995) 79-118 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9501113"}> arXiv:hep-th/9501113
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em Superbrane actions and geometrical approach
                = succeed "," do
