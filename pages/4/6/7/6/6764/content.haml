                          %mo ¬
                          %mi S
                        %annotation{:encoding => "application/x-tex"} \neg{S}
              %p
                In light of this, the most common definition of algebra is probably to use this fact together with (1,2); then (3) follows because
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ∖
                      %mi S
                      %mo =
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ∪
                      %mo ¬
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T \setminus S = \neg(S \cup \neg{T})
                and (4) follows because
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mo ¬
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} X = \neg\empty
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"} de Morgan duality
              %p
                The term ‘field’ here is even more archaic than the term ‘ring’ above; indeed the only field in this sense which is a
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                (in the usual sense) under symmetric difference and intersection is the field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
