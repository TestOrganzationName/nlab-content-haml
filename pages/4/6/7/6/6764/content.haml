                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}
                %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \neg{S}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                      %mo ,
                      %msub
                        %mi S
                        %mn 2
                      %mo ,
                      %msub
                        %mi S
                        %mn 3
                      %mo ,
                      %mi …
                    %annotation{:encoding => "application/x-tex"} S_1, S_2, S_3, \ldots
                are in
