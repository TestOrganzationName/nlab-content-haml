            = succeed "s)." do
              %a.existingWikiWord{:href => "/nlab/show/finitely+additive+measure"} finitely additive measure
            = succeed "\u2011" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-valued" do
