          %h2#idea Idea
          %p
            The
            %em Gelfand-Naimark-Segal construction
            (“GNS construction”) represents a
            %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state on a star-algebra
            over the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            — which
            %em a priori
            is defined purely algebraically as a non-degenerate positive linear function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒜
                  %mo ⟶
                  %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\colon\; \mathcal{A} \longrightarrow \mathbb{C}
                  \\,,
          %p
            — by a
            %a.existingWikiWord{:href => "/nlab/show/vector"} vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo ∈
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} \psi \in \mathcal{H}
            in a
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi ρ
                %annotation{:encoding => "application/x-tex"} \mathcal{H}_\rho
            as the “
            %a.existingWikiWord{:href => "/nlab/show/expectation+value"}> expectation value
            ”
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} ⟨
                          %mi ψ
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thinmathspace"}
                          %mi A
                          %mspace{:width => "thinmathspace"}
                          %mo{:stretchy => "false"} |
                          %mi ψ
                          %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                        %mtd
                          %mo ≔
                          %mo{:stretchy => "false"} ⟨
                          %mi ψ
                          %mo ,
                          %mi π
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mi ψ
                          %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\rho(A)
                  \&amp; = \langle \psi \vert \, A \, \vert \psi \rangle
                  \\\
                  \&amp; \coloneqq \langle \psi, \pi(A) \psi \rangle
                  \\end{aligned}
          %p
            with respect to some
            %a.existingWikiWord{:href => "/nlab/show/star-representation"} star-representation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒜
                  %mo ⟶
                  %mi End
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℋ
                    %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\pi \;\colon\; \mathcal{A} \longrightarrow End(\mathcal{H}_\rho)
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            on (a
            %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
            of)
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℋ
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}_\rho
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian
            %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
          %p
            It follows that every
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/mixed+state"} mixed state
            %a.existingWikiWord{:href => "/nlab/show/density+matrix"} density matrix
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi ρ
                %annotation{:encoding => "application/x-tex"} \mathcal{H}_\rho
            gives another algebraic state on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            arising this way are called the
            %strong folium
            of states corresponding to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            = succeed "," do
              %a{:href => "#Haag96"} Haag 1996 p 124
            = succeed "&rbrack;." do
              %a{:href => "#Moretti17"} Moretti 2017 Def. 14.9
          %p
            Originally and typically by default the GNS construction is considered for
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
            and
            %a.existingWikiWord{:href => "/nlab/show/C%2A-representations"} C*-representations
            (
            %a{:href => "#GelfandNaimark43"}> Gelfand &amp; Naimark 1943
            ,
            = succeed "," do
              %a{:href => "#Segal47"} Segal 1947
            = succeed ")," do
              %a{:href => "#Schmuedgen90"} Schmüdgen 1990
            %a.existingWikiWord{:href => "/nlab/show/unital+algebra"} unital
            %a.existingWikiWord{:href => "/nlab/show/star+algebras"} star algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            (
            %a{:href => "#KhavkineMoretti15"}> Khavkine &amp; Moretti 2015
            ) as well as to other
            %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebras"} formal power series algebras
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{C}[ [\hbar] ]
            (
            %a{:href => "#BordemannWaldmann96"}> Bordemann &amp; Waldmann 1996
            ).
          %p
            The GNS-construction plays a central role in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+quantum+field+theory"} algebraic quantum field theory
            (cf.
            = succeed "," do
              %a{:href => "#Haag96"} Haag 1996
            = succeed "," do
              %a{:href => "#Moretti17"} Moretti 2017
            = succeed ")," do
              %a{:href => "#KhavkineMoretti15"} Khavkine &amp; Moretti 2015
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            plays the role of an
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒜
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \rho \colon \mathcal{A} \to \mathbb{C}
            the role of an actual
            %a.existingWikiWord{:href => "/nlab/show/state"} state
            of a
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            (whence the terminology) jointly constituting the “
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+picture"}> Heisenberg picture
            ”-perspective of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum physics
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert
            %a.existingWikiWord{:href => "/nlab/show/space+of+states"} space of states
            as in the
            %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+picture"} Schrödinger picture
            of quantum physics. In this context the version for
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
            corresponds to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebras"} formal power series algebras
            corresponds to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
          %h2#details Details
          %blockquote
            %p under construction
          %h3#ForCStarAlgebras
            For
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          .num_theorem
            %h6#theorem Theorem
            %p Given
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒜
                        %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒜
                        %mo →
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \rho \;\colon\; \mathcal{A} \to \mathbb{C}
                  in the sense of
                %ol
                  %li
                    %p
                      a
                      %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                      on the
                      %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                      %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                    #eq:UnderlyingLinearMapOfStateExpectationValue.maruku-equation
                      %span.maruku-eq-number (1)
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ρ
                            %mspace{:width => "thinmathspace"}
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thinmathspace"}
                            %mi 𝒜
                            %mo →
                            %mi ℂ
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                          %annotation{:encoding => "application/x-tex"}
                            \\rho \,\colon\, \mathcal{A} \to \mathbb{C}
                            \\,,
                  %li
                    %p
                      which takes star-involution to
                      %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
                    #eq:StateRespectsStar.maruku-equation
                      %span.maruku-eq-number (2)
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                            %mo ∈
                            %mi 𝒜
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⊢
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi A
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo =
                            %mover
                              %mrow
                                %mi ρ
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo{:stretchy => "false"} )
                              %mo ¯
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                          %annotation{:encoding => "application/x-tex"}
                            A \in \mathcal{A}
                            \\;\;\;
                            \\vdash
                            \\;\;\;
                            \\rho\big(A^\ast\big) = \overline{\rho(A)}
                            \\,,
                  %li
                    %p
                      and satisfies “
                      %a{:href => "state+on+a+star-algebra#PositivityCondition"}> positivity
                      ” in the sense that
                    #eq:StateSatisfiesPositivity.maruku-equation
                      %span.maruku-eq-number (3)
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                            %mo ∈
                            %mi 𝒜
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⊢
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi A
                              %mo *
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ∈
                            %msub
                              %mi ℝ
                              %mrow
                                %mo ≥
                                %mn 0
                            %mo ⊂
                            %mi ℂ
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                          %annotation{:encoding => "application/x-tex"}
                            A \in \mathcal{A}
                            \\;\;\;
                            \\vdash
                            \\;\;\;
                            \\rho(A^\ast A)
                            \\in
                            \\mathbb{R}_{\geq 0} \subset \mathbb{C}
                            \\,,
            %p then there exists
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-representation"} C*-representation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒜
                        %mo ⟶
                        %mi End
                        %mo{:stretchy => "false"} (
                        %mi ℋ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\pi
                        \\;\colon\;
                        \\mathcal{A}
                        \\longrightarrow
                        End(\mathcal{H})
                %p
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  on some
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℋ
                      %annotation{:encoding => "application/x-tex"} \mathcal{H}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+vector"} cyclic vector
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ψ
                          %mi ρ
                        %mo ∈
                        %mi ℋ
                      %annotation{:encoding => "application/x-tex"} \psi_\rho \in \mathcal{H}
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is the
              %a.existingWikiWord{:href => "/nlab/show/pure+state"} pure state
              corresponding to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ψ
                        %mi ρ
                    %annotation{:encoding => "application/x-tex"} \psi_\rho
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %msub
                              %mi ψ
                              %mi ρ
                            %mo{:stretchy => "false"} |
                            %mspace{:width => "thinmathspace"}
                            %mi A
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi ψ
                              %mi ρ
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} ⟨
                            %msub
                              %mi ψ
                              %mi ρ
                            %mo ,
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi ψ
                              %mi ρ
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\rho(A)
                    \&amp; = \langle \psi_\rho \vert\, A \, \vert \psi_\rho \rangle
                    \\\
                    \&amp; \coloneqq
                    \\langle \psi_\rho , \pi(A) \psi_\rho \rangle
                    \\end{aligned}
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
          %p
          #ProofOfGNS.proof
            %h6 Proof
            %p
              Consider on the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              the
              %a.existingWikiWord{:href => "/nlab/show/sesquilinear+form"} sesquilinear form
              (
              %a.existingWikiWord{:href => "/nlab/show/inner+product"}> inner product
              )
            #eq:InnerProductBeforeDevidingOutNullVectors.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi A
                    %mo ,
                    %mi B
                    %msub
                      %mo{:stretchy => "false"} ⟩
                      %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi A
                      %mo *
                    %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle A,B \rangle_\rho
                    \\;\coloneqq\;
                    \\rho
                    \\big(
                    A^\ast B
                    \\big)
                    \\,.
            %p
              By the “
              %a{:href => "state+on+a+star-algebra#PositivityCondition"}> positivity
              ”-condition
              %a.maruku-eqref{:href => "#eq:StateSatisfiesPositivity"} (3)
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle-,-\rangle
              is
              = succeed "," do
                %a{:href => "sesquilinear+form#Definity"} positive semi-definite
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy-Schwarz+inequality"} Cauchy-Schwarz inequality
            #eq:CauchySchwarzBeforeDividingOutNullVectors.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                        %mi ρ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi A
                          %mo *
                        %mi B
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi A
                      %mo *
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi B
                      %mo *
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\big\vert
                    \\rho\big( A^\ast B \big)
                    \\big\vert}^2
                    \\;\leq\;
                    \\rho\big(A^\ast A\big)
                    \\,
                    \\rho(B^\ast B)
                    \\,.
            %p
              However,
              %a.maruku-eqref{:href => "#eq:InnerProductBeforeDevidingOutNullVectors"} (4)
              will in general not be definite, in that there may be a non-trivial
              %a.existingWikiWord{:href => "/nlab/show/linear+subspace"} linear subspace
              of
              = succeed "=0" do
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            #eq:TheNullIdeal.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒩
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                    %mi A
                    %mo ∈
                    %mi 𝒜
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mi ρ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi A
                      %mo *
                    %mi A
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %mn 0
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{N}
                    \\;\coloneqq\;
                    \\Big\{
                    A \in \mathcal{A}
                    \\,\vert\,
                    \\rho\big(A^\ast A\big) = 0
                    \\Big\}
                    \\,,
            %p and hence we have to quotient out by this null-space in order to produce the desired Hilbert space.
            %p
              Observe that this null space
              %a.maruku-eqref{:href => "#eq:TheNullIdeal"} (6)
              is not just a
              %a.existingWikiWord{:href => "/nlab/show/linear+subspace"} linear subspace
              but a left
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              for the algebra structure, as follows by the
              %a.existingWikiWord{:href => "/nlab/show/Cauchy-Schwarz+inequality"} Cauchy-Schwarz inequality
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:CauchySchwarzBeforeDividingOutNullVectors"} (5)
            #eq:NullSpaceIsLeftIdeal.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi N
                            %mo ∈
                            %mi 𝒩
                        %mtr
                          %mtd
                            %mi A
                            %mo ∈
                            %mi 𝒜
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mi N
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mi A
                            %mi N
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                              %mn 2
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi N
                              %mo *
                            %msup
                              %mi A
                              %mo *
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mi N
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                              %mn 2
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≤
                            %mspace{:width => "thickmathspace"}
                            %mi ρ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi N
                              %mo *
                            %msup
                              %mi A
                              %mo *
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi N
                              %mo *
                            %msup
                              %mi A
                              %mo *
                            %mi A
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %munder
                              %munder
                                %mrow
                                  %mi ρ
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                  %msup
                                    %mi N
                                    %mo *
                                  %mi N
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mspace{:width => "thinmathspace"}
                                  %mo .
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\left.
                    \\begin{array}{l}
                    N \in \mathcal{N}
                    \\\
                    A \in \mathcal{A}
                    \\end{array}
                    \\right\}
                    \\;\;\;
                    \\vdash
                    \\;\;\;
                    \\left\{
                    \\begin{array}{l}
                    \\big\vert
                    \\rho\big(
                    (A N)^\ast
                    A N
                    \\big)
                    \\big\vert^2
                    \\\
                    \\;=\;
                    \\big\vert
                    \\rho\big(
                    (N^\ast A^\ast A) N
                    \\big)
                    \\big\vert^2
                    \\\
                    \\;\leq\;
                    \\rho\big(
                    (N^\ast A^\ast A)
                    (N^\ast A^\ast A)^\ast
                    \\big)
                    \\,
                    \\underset{
                    \= 0
                    }{
                    \\underbrace{
                    \\rho\big(
                    N^\ast N
                    \\big)
                    \\,.
                    }
                    }
                    \\end{array}
                    \\right.
            %p
              Similarly, the
              %a.existingWikiWord{:href => "/nlab/show/Cauchy-Schwarz+inequality"} Cauchy-Schwarz inequality
              %a.maruku-eqref{:href => "#eq:CauchySchwarzBeforeDividingOutNullVectors"} (5)
              implies that any inner product with a null vector vanishes:
            #eq:InnerProductWithNullVectorIsNullVector.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi N
                            %mo ∈
                            %mi 𝒩
                        %mtr
                          %mtd
                            %mi A
                            %mo ∈
                            %mi 𝒜
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi A
                      %mo *
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left.
                    \\begin{array}{l}
                    N \in \mathcal{N}
                    \\\
                    A \in \mathcal{A}
                    \\end{array}
                    \\right\}
                    \\;\;
                    \\Rightarrow
                    \\;\;
                    \\rho\big(
                    A^\ast N
                    \\big)
                    \\;=\;
                    0
                    \\,.
            %p
              Therefore,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle-,-\rangle
              first of all descends to the
              %a.existingWikiWord{:href => "/nlab/show/quotient+vector+space"} quotient vector space
            #eq:HilbertSpaceAsQuotientOfStarAlgebraByNullSpace.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒜
                    %mo{:stretchy => "false"} /
                    %mi 𝒩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{H}
                    \\;\coloneqq\;
                    \\mathcal{A}/\mathcal{N}
                    \\,,
            %p because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %msub
                            %mi A
                            %mn 1
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi A
                            %mn 2
                          %mo +
                          %msub
                            %mi N
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≡
                          %mspace{:width => "thickmathspace"}
                          %mi ρ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mi A
                            %mn 1
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi A
                            %mn 2
                          %mo +
                          %msub
                            %mi N
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi ρ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mi A
                            %mn 1
                            %mo *
                          %msub
                            %mi A
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo +
                          %mi ρ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mi A
                            %mn 1
                            %mo *
                          %msub
                            %mi N
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi ρ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mi A
                            %mn 1
                            %mo *
                          %msub
                            %mi A
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\big\langle
                    A_1
                    ,\,
                    A_2 + N_2
                    \\big\rangle
                    \\\
                    \\;\equiv\;
                    \\rho\big(
                    A_1^\ast
                    (A_2 + N_2)
                    \\big)
                    \\\
                    \\;=\;
                    \\rho\big(
                    A_1^\ast
                    A_2
                    \\big)
                    +
                    \\rho\big(
                    A_1^\ast
                    N_2
                    \\big)
                    \\\
                    \\;=\;
                    \\rho\big(
                    A_1^\ast
                    A_2
                    \\big)
                    \\,,
                    \\end{array}
            %p
              where in the last step we used
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:InnerProductWithNullVectorIsNullVector"} (8)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %msub
                            %mi A
                            %mn 1
                          %mo +
                          %msub
                            %mi N
                            %mn 1
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi A
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mrow
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                              %msub
                                %mi A
                                %mn 2
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi A
                                %mn 1
                              %mo +
                              %msub
                                %mi N
                                %mn 1
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                            %mo ¯
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mrow
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                              %msub
                                %mi A
                                %mn 2
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi A
                                %mn 1
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                            %mo ¯
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %msub
                            %mi A
                            %mn 1
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi A
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\big\langle
                    A_1 + N_1
                    ,\,
                    A_2
                    \\big\rangle
                    \\\
                    \\;=\;
                    \\overline{
                    \\big\langle
                    A_2
                    ,\,
                    A_1 + N_1
                    \\big\rangle
                    }
                    \\\
                    \\;=\;
                    \\overline{
                    \\big\langle
                    A_2
                    ,\,
                    A_1
                    \\big\rangle
                    }
                    \\;=\;
                    \\big\langle
                    A_1
                    ,\,
                    A_2
                    \\big\rangle
                    \\,,
                    \\end{array}
            %p
              where in the first and last step we used
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:StateRespectsStar"} (2)
            %p
              Descended to the quotient this way, the pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle-,-\rangle
              becomes
              %a{:href => "sesquilinear+form#Definity"} positive definite
              by construction, so that it defines a
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian
              (by
              = succeed ")" do
                %a.maruku-eqref{:href => "#eq:StateRespectsStar"} (2)
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℋ
                    %annotation{:encoding => "application/x-tex"} \mathscr{H}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            %p
              Finally, again by the left-ideal property
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:NullSpaceIsLeftIdeal"} (7)
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              on itself also descends to an action on the quotient Hilbert space
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:HilbertSpaceAsQuotientOfStarAlgebraByNullSpace"} (9)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒜
                            %mo ⊗
                            %mi ℋ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi π
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi ℋ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi ψ
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi A
                            %mo ⋅
                            %mi ψ
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{A} \otimes \mathcal{H}
                    \&amp;
                    \\overset{
                    \\;\;\;\;\;
                    \\pi
                    \\;\;\;\;\;
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    \\mathcal{H}
                    \\\
                    (A, [\psi]) &amp;\mapsto&amp; [A \cdot \psi]
                    \\,,
                    }
            %p
              and so the cyclic vector in question is that represented by the
              %a.existingWikiWord{:href => "/nlab/show/unit+element"} unit element
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} 1 \in \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi.mathscript ℋ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi_\rho
                    \\;\coloneqq\;
                    [1]
                    \\;\in\;
                    \\mathscr{H}
                    \\,.
            %p
              Hence on this Hilbert space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℋ
                    %annotation{:encoding => "application/x-tex"} \mathscr{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is now represented by the tautological
              %a.existingWikiWord{:href => "/nlab/show/density+matrix"} density matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %msub
                        %mi ψ
                        %mi ρ
                      %mo ⟩
                    %mrow
                      %mo ⟨
                      %msub
                        %mi ψ
                        %mi ρ
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\vert
                    \\psi_\rho
                    \\right\rangle
                    \\left\langle
                    \\psi_\rho
                    \\right\rangle
                    \\;=\;
                    {\big\vert [1] \big\rangle}
                    {\big\langle [1] \big\vert}
                    \\,.
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              In summary, the GNS construction constitutes a kind of
              %em
                %a.existingWikiWord{:href => "/nlab/show/operator-state+correspondence"} operator-state correspondence
              modulo null-operators:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi 𝒜
                          %mo{:stretchy => "false"} /
                          %mi 𝒩
                        %mtd
                          %mover
                            %mo ↔
                            %mphantom
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %mi.mathscript ℋ
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi A
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↦
                        %mtd
                          %mi A
                          %mo ⋅
                          %msub
                            %mi ψ
                            %mi ρ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcl}
                    \\mathcal{A}/\mathcal{N}
                    \&amp;\xleftrightarrow{\phantom{---}}&amp;
                    \\mathscr{H}
                    \\\
                    [A]
                    \&amp;\mapsto&amp;
                    A \cdot \psi_\rho
                    \\end{array}
            %p
          %h3#ForCStarCategories
            For
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          %p
            The GNS construction for
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            %a{:href => "#GhezLinaRoberts85"} Ghez, Lina &amp; Roberts 1985, Prop. 1.9
            applied to
            %a.existingWikiWord{:href => "/nlab/show/C%2A-categories"} C*-categories
            (the
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            of
            = succeed "-algebras):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/C-star+category"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                  \-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Ob
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} A \in \operatorname{Ob}\mathcal{C}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              be a state on the
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}(A,A)
              = succeed "-representation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Hilb
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_\sigma \colon \mathcal{C} \to \mathbf{Hilb}
            %p
              together with a cyclic vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %msub
                      %mi ρ
                      %mi σ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \in \rho_\sigma(A)
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in \mathcal{C}(A,A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi ξ
                    %mo ,
                    %msub
                      %mi ρ
                      %mi σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi ξ
                    %mo{:stretchy => "false"} ⟩
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma(x) = \langle \xi, \rho_\sigma(x)\xi \rangle.
          %p
