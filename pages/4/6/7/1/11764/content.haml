                        %a.existingWikiWord{:href => "/nlab/show/super+Riemann+surface"} super Riemann surface
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau manifold
                      %ul
                        %li
                          %math#mathml_0840443566213f96efc91cbad84ec37a8bb42e6b_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                            %semantics
                              %mrow
                                %mi dim
                                %mo =
                                %mn 2
