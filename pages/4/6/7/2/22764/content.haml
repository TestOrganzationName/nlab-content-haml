          %h2#idea Idea
          %p
            The idea of a closed midpoint algebra comes from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Peter+Freyd"} Peter Freyd
          %h2#definition Definition
          %p
            A
            %strong closed midpoint algebra
            is a
            %a.existingWikiWord{:href => "/nlab/show/cancellative+midpoint+algebra"} cancellative midpoint algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,\vert)
            equipped with two chosen elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                  %mo :
                  %mi M
                %annotation{:encoding => "application/x-tex"} \bot:M
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                    %mo :
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \top:M
          %h2#examples Examples
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} |
                    %mi b
                    %mo ≔
                    %mfrac
                      %mrow
                        %mi a
                        %mo +
                        %mi b
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a \vert b \coloneqq \frac{a + b}{2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \bot = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \top = 1
            is an example of a closed midpoint algebra.
          %p
            The set of truth values in Girard’s
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            is a closed midpoint algebra.
          %h2#properties Properties
          %p
            Every closed midpoint algebra with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                  %mo =
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \bot = \top
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/trivial+object"} trivial
          %h3#partial_order Partial order
          %p
            Every closed midpoint algebra has a natural
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
            defined as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≤
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \leq b
            for elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            if there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} |
                    %mo ⊤
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} |
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a \vert \top = b \vert c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≤
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \leq b
            for elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            if there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo =
                    %mo ⊥
                    %mo{:stretchy => "false"} |
                    %mi b
                  %annotation{:encoding => "application/x-tex"} c \vert a = \bot \vert b
          %p
            Every closed midpoint algebra
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monotone"} monotone
          %h3#function_algebras Function algebras
          %p
            For any set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and any closed midpoint algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a closed midpoint algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo →
                    %mi M
                    %mo ,
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi S
                        %mo →
                        %mi M
                    %mo ,
                    %msub
                      %mo ⊥
                      %mrow
                        %mi S
                        %mo →
                        %mi M
                    %mo ,
                    %msub
                      %mo ⊤
                      %mrow
                        %mi S
                        %mo →
                        %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S\to M,\vert_{S\to M},\bot_{S\to M},\top_{S\to M})
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mi S
                          %mo →
                          %mi M
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi M
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f\vert_{S\to M} g)(x) = f(x)\vert_M g(x)
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo :
                      %mi S
                      %mo →
                      %mi M
                    %annotation{:encoding => "application/x-tex"} f,g:S\to M
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi M
                    %annotation{:encoding => "application/x-tex"} x:M
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ⊥
                        %mrow
                          %mi S
                          %mo →
                          %mi M
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ⊥
                        %mi M
                    %annotation{:encoding => "application/x-tex"} (\bot_{S\to M})(x) = \bot_M
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi M
                    %annotation{:encoding => "application/x-tex"} x:M
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ⊤
                        %mrow
                          %mi S
                          %mo →
                          %mi M
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ⊤
                        %mi M
                    %annotation{:encoding => "application/x-tex"} (\top_{S\to M})(x) = \top_M
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi M
                    %annotation{:encoding => "application/x-tex"} x:M
          %h3#definite_integration Definite integration
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            be
            %a.existingWikiWord{:href => "/nlab/show/continuous+space"} continuous
            closed midpoint algebras and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %msub
                    %mo →
                    %mi C
                  %mi N
                %annotation{:encoding => "application/x-tex"} M\to_C N
            be the space of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %a.existingWikiWord{:href => "/nlab/show/operator"} operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msub
                    %mo →
                    %mi C
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msub
                    %mo →
                    %mi C
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int (-)(x) \mathrm{d}x: (M\to_C N)\to (M\to_C N)
            called
            %strong
              %a.existingWikiWord{:href => "/nlab/show/definite+integration"} definite integration
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %msub
                    %mo ⊤
                    %mrow
                      %mi M
                      %mo →
                      %mi N
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %msub
                    %mo ⊤
                    %mi N
                %annotation{:encoding => "application/x-tex"} \int \top_{M\to N}(x) \mathrm{d}x = \top_N
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %msub
                    %mo ⊥
                    %mrow
                      %mi M
                      %mo →
                      %mi N
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %msub
                    %mo ⊥
                    %mi N
                %annotation{:encoding => "application/x-tex"} \int \bot_{M\to N}(x) \mathrm{d}x = \bot_N
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi N
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %mo ∫
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi N
                  %mo ∫
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                %annotation{:encoding => "application/x-tex"} \int f(x) \vert_N g(x) \mathrm{d}x = \int f(x) \mathrm{d}x \vert_N \int g(x) \mathrm{d}x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %mo ∫
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ⊥
                    %mi M
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi M
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi N
                  %mo ∫
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi M
                  %msub
                    %mo ⊤
                    %mi M
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                %annotation{:encoding => "application/x-tex"} \int f(x) \mathrm{d}x = \int f(\bot_M \vert_M x) \mathrm{d}x \vert_N \int f(x \vert_M \top_M) \mathrm{d}x
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the
            %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
            on the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is an interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,b]
            on the real numbers, written in conventional notation the axioms become:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mi a
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %mi a
                %annotation{:encoding => "application/x-tex"} \int_{0}^{1} a(x) \mathrm{d}x = a
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mi b
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %mi b
                %annotation{:encoding => "application/x-tex"} \int_{0}^{1} b(x) \mathrm{d}x = b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mn 2
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %mfrac
                    %mrow
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mn 1
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} d
                      %mi x
                      %mo +
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mn 1
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} d
                      %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \int_{0}^{1} \frac{f(x) + g(x)}{2} \mathrm{d}x = \frac{\int_{0}^{1} f(x) \mathrm{d}x + \int_{0}^{1} g(x) \mathrm{d}x}{2}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo =
                  %mfrac
                    %mrow
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mn 1
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mfrac
                        %mrow
                          %mn 0
                          %mo +
                          %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} d
                      %mi x
                      %mo +
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mn 1
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mfrac
                        %mrow
                          %mi x
                          %mo +
                          %mn 1
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} d
                      %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \int_{0}^{1} f(x) \mathrm{d}x = \frac{\int_{0}^{1} f(\frac{0 + x}{2}) \mathrm{d}x + \int_{0}^{1} f(\frac{x + 1}{2}) \mathrm{d}x}{2}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/definite+integration"} definite integration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cancellative+midpoint+algebra"} cancellative midpoint algebra
            %li
