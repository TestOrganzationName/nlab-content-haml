                            %mi{:mathvariant => "normal"} G
                            %mo +
                            %msub
                              %mi P
                              %mi χ
                            %mo ∘
                            %mi{:mathvariant => "normal"} G
                          %mtd
                            %mo =
                            %mi id
                            %mo ,
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} G
                            %mo ∘
                            %msub
                              %mi P
                              %mi χ
                            %mo +
                            %msub
                              %mi{:mathvariant => "normal"} G
                              %mi χ
                            %mo ∘
                            %mi P
                          %mtd
                            %mo =
                            %mi id
                            %mo ,
                        %mtr
