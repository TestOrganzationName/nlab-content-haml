                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} /
                                %mi p
                                %mo{:stretchy => "false"} )
                                %mi cp
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mtext future/past compact support
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi tcp
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mtext timelike compact support
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_{cp}(-) &amp; \text{compact support}
                    \\\
                    \\Gamma_{\Sigma,\pm cp}(-) &amp; \text{compactly sourced future/past support}
                    \\\
                    \\Gamma_{\Sigma,scp}(-) &amp; \text{spacelike compact support}
                    \\\
                    \\Gamma_{\Sigma,(f/p)cp}(-) &amp; \text{future/past compact support}
                    \\\
                    \\Gamma_{\Sigma,tcp}(-) &amp; \text{timelike compact support}
                    }
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/linear+subspaces"} linear subspaces
              on those smooth sections whose
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              is
            %ol
              %li
