                      %annotation{:encoding => "application/x-tex"} tcp
                  ) inside the future of one Cauchy surface and the past of another (
                  %a{:href => "#Sanders12"}> Sanders 13, def. 3.2
                  )
          %p
            (
            %a{:href => "#Baer14"}> Bär 14, section 1
            ,
            = succeed ")" do
              %a{:href => "#Khavkine14"} Khavkine 14, def. 2.1
          #FormallyAdjointDifferentialOperators.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operators"}> formally adjoint differential operators
                )
            %p
              Two
              %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %msup
                      %mi P
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P, P^\ast
                    \\;\colon\;
                    \\Gamma_\Sigma(E)
                    \\longrightarrow
                    \\Gamma_\Sigma(\tilde E^\ast)
            %p
              are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operators"} formally adjoint differential operators
              via a
              %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
            #eq:FormallyAdjointDifferentialOperatorWitness.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mi p
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K \;\colon\;
                    \\Gamma_\Sigma(E) \otimes \Gamma_\Sigma(E)
                    \\longrightarrow
                    \\Gamma_\Sigma(\wedge^{p} T^\ast \Sigma)
            %p
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mn 1
                    %mo ,
                    %msub
                      %mi Φ
                      %mn 2
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_1, \Phi_2 \in \Gamma_\Sigma(E)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi Φ
                      %mn 2
                    %mo −
                    %msub
                      %mi Φ
                      %mn 1
                    %mo ⋅
                    %msup
                      %mi P
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mn 1
                    %mo ,
                    %msub
                      %mi Φ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P(\Phi_1) \cdot \Phi_2
                    \-
                    \\Phi_1 \cdot P^\ast(\Phi_2)
                    \\;=\;
                    d K(\Phi_1, \Phi_2)
          %p
            (
            %a{:href => "#Baer14"} Bär 14, 3. (1)
            = succeed ")" do
              %a{:href => "#Khavkine14"} Khavkine 14, def. 2.4
          #AdvancedAndRetardedGreenFunctions.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+Green+functions"} advanced and retarded Green functions
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/causal+Green+function"} causal Green function
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/causal+structure"} causal structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \to \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \;\colon\;\Gamma_\Sigma(E) \to \Gamma_\Sigma(\tilde E^\ast)
              be a
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              on its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/space+of+smooth+sections"} space of smooth sections
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mrow
                        %mi P
                        %mo ,
                        %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mo ±
                        %mi cp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{G}_{P,\pm}
                    \\;\colon\;
                    \\Gamma_{\Sigma, cp}(\tilde E^\ast)
                    \\longrightarrow
                    \\Gamma_{\Sigma, \pm cp}(E)
            %p
              from spaces of sections of
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              to spaces of sections of causally sourced future/past support (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/advanced+or+retarded+Green+function"} advanced or retarded Green function
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %ol
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Φ
                        %mo ∈
                        %msub
                          %mi Γ
                          %mrow
                            %mi Σ
                            %mo ,
                            %mi cp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_{\Sigma,cp}(E_1)
                  we have
                #eq:AdvancedRetardedGreenFunctionIsLeftInverseToDiffOperator.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi P
                            %mo ,
                            %mo ±
                        %mo ∘
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Φ
                      %annotation{:encoding => "application/x-tex"}
                        G_{P,\pm} \circ P(\Phi) = \Phi
                %p and
                #eq:AdvancedRetardedGreenFunctionIsRightInverseToDiffOperator.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo ∘
                        %msub
                          %mi G
                          %mrow
                            %mi P
                            %mo ,
                            %mo ±
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Φ
                      %annotation{:encoding => "application/x-tex"}
                        P \circ G_{P,\pm}(\Phi) = \Phi
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/support"} support
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi P
                            %mo .
                            %mo ±
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G_{P.\pm}(\Phi)
                  is in the
                  %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
                  or
                  %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
                  of the support of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Φ
                        %annotation{:encoding => "application/x-tex"} \Phi
            %p
              If the advanced/retarded Green functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mrow
                        %mi P
                        %mo ±
                  %annotation{:encoding => "application/x-tex"} G_{P\pm}
              exists, then the difference
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mi P
                    %mo ≔
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mrow
                        %mi P
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo −
                    %msub
                      %mi{:mathvariant => "normal"} G
                      %mrow
                        %mi P
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{G}_P \coloneqq \mathrm{G}_{P,+} - \mathrm{G}_{P,-}
            %p
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/causal+Green+function"} causal Green function
          %p
            (
            %a{:href => "#Baer14}"}> Bär 14, def. 3.2, cor. 3.10
            )
          #GreenHyperbolicDifferentialOperator.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"}> Green hyperbolic differential operator
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              over a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/causal+structure"} causal structure
            %p
