          #GreenHyperbolicKleinGordonOperator.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"} Green hyperbolic
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              a
              %a.existingWikiWord{:href => "/nlab/show/globally+hyperbolic+spacetimes"} globally hyperbolic spacetimes
              then the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mo □
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi m
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} P = \Box - m^2
              (i.e. the
              %a.existingWikiWord{:href => "/nlab/show/wave+operator"} wave operator
              for
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} m = 0
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"} Green hyperbolic
              according to def.
              %a.maruku-ref{:href => "#GreenHyperbolicDifferentialOperator"}
              (e. g.
              = succeed ")" do
                %a{:href => "#BaerGinouxPfaeffle07"} Bär-Ginoux-Pfaeffle 07
              = succeed ")." do
                %a{:href => "formal+adjoint+differential+operator#FormallySelfAdjointKleinGordonOperator"} this example
              = succeed "-Peierls" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              = succeed ")" do
                %a.maruku-ref{:href => "#BracketPSymplecticAndPPeierls"}
