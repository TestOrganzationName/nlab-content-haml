        #revision
          %h1#idea Idea
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
                is the ‘algebraic core’ of a
                = succeed "-" do
                  %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} cat
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \cat^1
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cat-1-group"} group
                = succeed "-group" do
                  %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} cat
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \cat^1
                = succeed "-group" do
                  %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} cat
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \cat^1
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/crossed+square"} crossed square
                is similarly the ‘algebraic core’ of a
                %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} cat
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \cat^2
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cat-2-group"} group
            %li
              %p
                A
                %em
                  crossed
                  = succeed "-cube" do
                    %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                should be the ‘algebraic core’ of a
                = succeed "-" do
                  %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} cat
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \cat^n
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cat-n-group"} group
          %p
            A crossed square in the Guin-Valery Loday specification has quite a few axioms, many more than those for a crossed module. Does that mean that crossed
            = succeed "-cubes" do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ")?" do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Finally a particular example of a
            %a.existingWikiWord{:href => "/nlab/show/crossed+square"} crossed square
            is given by a group with two
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            normal subgroups, all the intersections and all the commutator maps, formed an example of a crossed
            = succeed "-cube." do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-maps," do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
            = succeed "-cube" do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The result (definition due to Graham Ellis and Richard Steiner, reference below) is a set of 11 axioms. That is all, and these objects model all homotopy
            = succeed "-" do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} types
          %h1#definition Definition
          %p
            We denote by
            %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle n \rangle
            the set
            = succeed "." do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1,2,\ldots, n\}
          %p
            A
            = succeed "," do
              %em
                crossed
                = succeed "-cube" do
                  %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi M
                      %mi A
                    %mo :
                    %mi A
                    %mo ⊆
                    %mo{:stretchy => "false"} ⟨
                    %mi n
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{M_A: A \subseteq  \langle n \rangle\}
            = succeed "," do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi i
                    %mo :
                    %msub
                      %mi M
                      %mi A
                    %mo →
                    %msub
                      %mi M
                      %mrow
                        %mi A
                        %mo −
                        %mo{:stretchy => "false"} {
                        %mi i
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mu_i :M_A \rightarrow  M_{A-\{i\}}
            = succeed "," do
              %math#mathml_b47a16b22a88d03bdda6315862da2fe4e1bd5502_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} ⟨
                    %mi n
                    %mo{:stretchy => "false"} ⟩
                    %mo ,
                    %mi A
                    %mo ⊆
                    %mo{:stretchy => "false"} ⟨
                    %mi n
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    i \in  \langle n \rangle
