          .un_prop
            %h6#proposition_2 Proposition 2
            %p If every internal reflexive relation is an internal equivalence relation, then the composite of any two internal equivalence relations is also an internal equivalence relation.
          .proof
            %h6#proof_2 Proof
            %p
              The hypothesis is that internal reflexive relations and internal equivalence relations coincide. But (internal) reflexive relations are clearly closed under composition:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo =
                      %mi Δ
                      %mo ∘
                      %mi Δ
                      %mo ⊆
                      %mi R
                      %mo ∘
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \Delta = \Delta \circ \Delta \subseteq R \circ S
          .un_prop
            %h6#proposition_3 Proposition 3
            %p If internal equivalence relations are closed under composition, then composition of internal equivalence relations is commutative.
          .proof
            %h6#proof_3 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are equivalence relations and so is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∘
                      %mi R
                    %annotation{:encoding => "application/x-tex"} S \circ R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∘
                    %mi R
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∘
                    %mi R
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo =
                    %msup
                      %mi R
                      %mi op
                    %mo ∘
                    %msup
                      %mi S
                      %mi op
                    %mo =
                    %mi R
                    %mo ∘
                    %mi S
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} S \circ R = (S \circ R)^{op} = R^{op} \circ S^{op} = R \circ S,
            %p as desired.
          .un_prop
            %h6#proposition_4 Proposition 4
            %p
