                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                    %mspace{:width => "2em"}
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \phi(t) = b \qquad \psi(t) = a
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be the equivalence relation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(3)
              given by the kernel pair of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be the kernel pair of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(x, y)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S(y, z)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ∘
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (S \circ R)(x, z)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ∘
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R \circ S)(x, z)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(x, t)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(t, z)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(x) = \psi(t)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi(t) = \phi(z)
          %h2#examples Examples
          %ul
            %li
              %p
                The theory of
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi x
                        %msup
                          %mi y
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi z
                      %annotation{:encoding => "application/x-tex"} t(x, y, z) = x y^{-1} z
            %li
              %p
                The theory of
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/Heyting+algebra"} Heyting algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo ⇒
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ⇒
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} t(x, y, z) = ((z \Rightarrow y) \Rightarrow x) \wedge ((x \Rightarrow y) \Rightarrow z),
              %p is Malcev.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is Malcev, and if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo →
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} T \to T'
                is a morphism of algebraic theories, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} T'
                is Malcev. From this point of view, the theory of groups is Malcev because the theory of heaps is Malcev, and the theory of Heyting algebras is Malcev because the theory of
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/meet-semilattice"} meet-semilattice
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Malcev+category"} Malcev category
          %h2#the_lattice_of_congruences_
            The lattice of congruences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equiv
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Equiv(X)
          %h3#_is_a_modular_lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equiv
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Equiv(X)
            is a modular lattice
          %p
            In any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finitely+complete+category"} finitely complete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a congruence, so that the set of equivalence relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equiv
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Equiv(X)
            is a meet-semilattice.
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            such as a variety of algebras, where there is a sensible calculus of relations and relational composition, it is a simple matter to prove that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equiv
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Equiv(X)
            is closed under relational composition, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∘
                  %mi S
                %annotation{:encoding => "application/x-tex"} R \circ S
            is the join
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∨
                  %mi S
                %annotation{:encoding => "application/x-tex"} R \vee S
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Equiv(X)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ,
                    %mi S
                    %mo ∈
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R, S \in Equiv(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi R
                  %mo ∘
                  %mi Δ
                  %mo ⊆
                  %mi R
                  %mo ∘
                  %mi S
                  %mo ,
                  %mspace{:width => "2em"}
                  %mi S
                  %mo =
                  %mi Δ
                  %mo ∘
                  %mi S
                  %mo ⊆
                  %mi R
                  %mo ∘
                  %mi S
                %annotation{:encoding => "application/x-tex"} R = R \circ \Delta \subseteq R \circ S, \qquad S = \Delta \circ S \subseteq R \circ S
          %p
            while if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ,
                  %mi S
                  %mo ⊆
                  %mi T
                %annotation{:encoding => "application/x-tex"} R, S \subseteq T
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Equiv(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∘
                  %mi S
                  %mo ⊆
                  %mi T
                  %mo ∘
                  %mi T
                  %mo ⊆
                  %mi T
                  %mo .
                %annotation{:encoding => "application/x-tex"} R \circ S \subseteq T \circ T \subseteq T.
          .un_prop
            %h6#proposition Proposition
            %p
              In a regular category, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Equiv(X)
              is closed under relational composition (equivalently, if composition of equivalence relations is commutative), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Equiv(X)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modular+lattice"} modular lattice
          .proof
            %h6#proof_5 Proof
            %p
              The (poset-enriched) category of relations in a regular category is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∘
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi S
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi op
                    %mo ∘
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \wedge (S \circ T) \subseteq S \circ ((S^{op} \circ R) \wedge T)
            %p
              whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} T: X \to Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo :
                      %mi Y
                      %mo →
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} S: Y \to Z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi X
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} R: X \to Z
              are relations. As we have just seen, the hypothesis implies that joins in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Equiv(X)
              are given by composition (so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Equiv(X)
              is a lattice), and so for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ,
                    %mi S
                    %mo ,
                    %mi T
                    %mo ∈
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R, S, T \in Equiv(X)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∨
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi S
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∨
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} R \wedge (S \vee T) \subseteq S \vee ((S \vee R) \wedge T).
            %p
              Therefore, if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi R
                    %annotation{:encoding => "application/x-tex"} S \subseteq R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∨
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi S
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ∧
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \wedge (S \vee T) \subseteq S \vee (R \wedge T)
            %p
              and also
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∨
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ∧
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi R
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ∨
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S \vee (R \wedge T) \subseteq R \wedge (S \vee T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} S \subseteq R
              implies
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ∨
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ∧
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo ∨
                      %mi S
                    %annotation{:encoding => "application/x-tex"} R \wedge (T \vee S) = (R \wedge T) \vee S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Equiv
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Equiv(X)
          .un_cor
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a Malcev theory, then the lattice of congruences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Equiv(X)
              on any
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a modular lattice.
          %h3#_is_a_desarguesian_lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equiv
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Equiv(X)
            is a Desarguesian lattice
          %p
            A similar argument shows that congruence lattices for
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            a Malcev theory, satisfy the following property (stronger than the modular property):
          %ul
            %li
              %span.newWikiWord>
                Desarguesian property
                %a{:href => "/nlab/new/Desarguesian+axiom"} ?
              \: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi i
                    %mo ,
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %msub
                      %mi T
                      %mi i
                    %mo ∈
                    %mi Equiv
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R_i, S_i, T_i \in Equiv(X)
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                      %mo ,
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} i = 1, 2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mn 1
                      %mo ∨
                      %msub
                        %mi R
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 1
                      %mo ∨
                      %msub
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %msub
                        %mi T
                        %mn 1
                      %mo ∨
                      %msub
                        %mi T
                        %mn 2
                      %mspace{:width => "2em"}
                      %mi implies
                      %mspace{:width => "2em"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mn 1
                      %mo ∨
                      %msub
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mn 2
                      %mo ∨
                      %msub
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mn 1
                      %mo ∨
                      %msub
                        %mi T
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mn 2
                      %mo ∨
                      %msub
                        %mi T
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∨
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 1
                      %mo ∨
                      %msub
                        %mi T
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 2
                      %mo ∨
                      %msub
                        %mi T
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R_1 \vee R_2) \wedge (S_1 \vee S_2)) \subseteq T_1 \vee T_2 \qquad implies \qquad (R_1 \vee S_1) \wedge (R_2 \vee S_2) \subseteq ((R_1 \vee T_1) \wedge (R_2 \vee T_2)) \vee ((S_1 \vee T_1) \wedge (S_2 \vee T_2))
          %p
            Freyd-Scedrov’s
            %a.existingWikiWord{:href => "/nlab/show/Categories%2C+Allegories"} Categories, Allegories
            (2.157, pp. 206-207) gives the following argument: given relations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 1
                    %mo ,
                    %msub
                      %mi S
                      %mn 1
                    %mo ,
                    %msub
                      %mi T
                      %mn 1
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} R_1, S_1, T_1: X \to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mn 2
                  %mo ,
                  %msub
                    %mi S
                    %mn 2
                  %mo ,
                  %msub
                    %mi T
                    %mn 2
                  %mo :
                  %mi Y
                  %mo →
                  %mi Z
                %annotation{:encoding => "application/x-tex"} R_2, S_2, T_2: Y \to Z
            between sets, it is “easily verified” that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mn 2
                  %msub
                    %mi R
                    %mn 1
                  %mo ∩
                  %msub
                    %mi S
                    %mn 2
                  %msub
                    %mi S
                    %mn 2
                  %mo ⊆
                  %msub
                    %mi T
                    %mn 2
                  %msub
                    %mi T
                    %mn 1
                  %mspace{:width => "2em"}
                  %mi implies
                  %mspace{:width => "2em"}
                  %msub
                    %mi S
                    %mn 1
                  %msubsup
                    %mi R
                    %mn 1
                    %mi op
                  %mo ∩
                  %msubsup
                    %mi S
                    %mn 2
                    %mi op
                  %msub
                    %mi R
                    %mn 2
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mn 1
                  %msubsup
                    %mi T
                    %mn 1
                    %mi op
                  %mo ∧
                  %msubsup
                    %mi S
                    %mn 2
                    %mi op
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mn 1
                  %msubsup
                    %mi R
                    %mn 1
                    %mi op
                  %mo ∩
                  %msubsup
                    %mi T
                    %mn 2
                    %mi op
                  %msub
                    %mi R
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_2 R_1 \cap S_2 S_2 \subseteq T_2 T_1 \qquad implies \qquad S_1 R_{1}^{op} \cap S_{2}^{op} R_2 \subseteq (S_1 T_{1}^{op} \wedge S_{2}^{op} T_2)(T_1 R_{1}^{op} \cap T_{2}^{op}R_2)
          %p
            Then, under the assumption that equivalence relations internal to
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} Alg
            commute (so that the join of equivalence relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ,
                  %mi S
                %annotation{:encoding => "application/x-tex"} R, S
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is their relational composite
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi S
                    %mo =
                    %mi R
                    %mo ∘
                    %mi S
                  %annotation{:encoding => "application/x-tex"} R S = R \circ S
          %h2#generalized_malcev_operations_and_connection_to_unorderability_and_recursion Generalized Malcev operations and connection to unorderability and recursion
          %p
            An algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            for a theory is
            %em unorderable
            if there is no non-trivial compatible
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
            structure on it. It is
            %em absolutely unorderable
            if whenever there is an embedding
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is unorderable.
          %p
            Every algebra in a Malcev variety is absolutely unorderable. For if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ≤
                    %mi u
                  %annotation{:encoding => "application/x-tex"} t\leq u
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo =
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi t
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi u
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi t
                  %mo ,
                %annotation{:encoding => "application/x-tex"} u= M(t,t,u) \leq M(t,u,u) = t,
          %p
            hence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mi u
                  %annotation{:encoding => "application/x-tex"} t=u
          .un_prop
            %h6#theorem Theorem
            %p
              An algebra has a
              %em generalized
              Malcev operation if and only if it is absolutely unorderable.
          %p
            Here, a generalized Malcev operation is a finite sequence of ternary operations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 1
                  %mi …
                  %msub
                    %mi M
                    %mi n
                %annotation{:encoding => "application/x-tex"} M_1\dots M_n
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %msub
                    %mi M
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi u
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi M
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi t
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi M
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi u
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi M
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi t
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi M
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi u
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi …
                  %msub
                    %mi M
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi t
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi u
                  %mo .
                %annotation{:encoding => "application/x-tex"} t = M_1(t,u,u);\ \  M_1(t,t,u)=M_2(t,u,u);\ \  M_2(t,t,u) = M_3(t,u,u);\ \  \dots M_n(t,t,u)=u.
          %h3#recursion_and_the_lambda_calculus Recursion and the lambda calculus
          %p
            Orders are often used to explain
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursion
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kleene%27s+fixed+point+theorem"} Kleene's fixed point theorem
            %a.existingWikiWord{:href => "/nlab/show/lambda+calculus"} lambda calculus
            is a famous calculus for computation and recursion, there is a question (attributed to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Gordon+Plotkin"} Gordon Plotkin
            %a.existingWikiWord{:href => "/nlab/show/lambda+calculus"} lambda calculus
            is necessarily orderable to some extent.
            %a.existingWikiWord{:href => "/nlab/show/Peter+Selinger"} Peter Selinger
            then asked, is the lambda calculus inconsistent with Malcev operators?
          .un_prop
            %h6#theorem_2 Theorem
            %p
              (Plotkin, Simpson, Selinger) There can be no generalized Malcev operator with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n=1
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n=2
              in the lambda calculus.
          .un_prop
            %h6#question Question
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo &gt;
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n\gt 2
          %h2#references References
          %p
            See the monograph
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Borceux-Bourn"} Borceux-Bourn
          %p For the connection to unorderability and recursion, see the following article and references therein:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Selinger"}> Peter Selinger
              ,
              = succeed "," do
                %a{:href => "https://www.mscs.dal.ca/~selinger/papers/cmaa.pdf"}
                  %em Order-Incompleteness and Finite Lambda Reduction Models
          %p
            For the characterisation of
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            which are
            %a.existingWikiWord{:href => "/nlab/show/localizations"} localizations
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Maltsev+varieties"} Maltsev varieties
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marino+Gran"} Marino Gran
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} Enrico Vitale
              = succeed "," do
                %em Localizations of Maltsev varieties
              %strong 5
              12 (1999) 281-291 &amp;lbrack;
              %a{:href => "http://www.tac.mta.ca/tac/volumes/1999/n12/5-12abs.html"}> TAC
              \&amp;rbrack;
          %h2#spelling Spelling
          %p The original is ‘Мальцев’; Malcev spelled his name as ‘Malcev’ in his non-Russian papers. This has also been transliterated ‘Malʹcev’, ‘Malʹtsev’ and ‘Maltsev’.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/invertible+quasigroup"} invertible quasigroup
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pseudo-torsor"}> pseudo-torsor
                ,
                %a.existingWikiWord{:href => "/nlab/show/heap"} heap
