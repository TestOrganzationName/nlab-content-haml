                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %em Möbius transformation
            (also called a
            = succeed "," do
              %em homography
            = succeed "," do
              %em linear fractional transformation
            = succeed ")" do
              %em fractional linear transformation
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi ℙ
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi ℙ
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f: \mathbb{P}^1(k) \to \mathbb{P}^1(k)
            defined by the rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi a
                      %mi x
                      %mo +
                      %mi b
                    %mrow
