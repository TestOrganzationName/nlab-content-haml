            (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            to the
            %a.existingWikiWord{:href => "/nlab/show/projective+linear+group"} projective linear group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PGL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi k
