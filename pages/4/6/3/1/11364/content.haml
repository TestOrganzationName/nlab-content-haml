          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo ,
                  %mi d
                  %mo ∈
                  %mi k
                %annotation{:encoding => "application/x-tex"} a, b, c, d \in k
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi d
                  %mo −
                  %mi b
                  %mi c
