                = succeed "&rbrack;" do
                  %a{:href => "https://youtu.be/j6fQsTpU2-g?list=PLtTPtV8SRcxgDSzmQZ5X9WcHV2PMehPBj"} YT
            %li
              %p
                Charles Gould,
                = succeed "," do
                  %em Debunking the data behind the “Chiral Majorana fermion modes” claim
                = succeed "," do
