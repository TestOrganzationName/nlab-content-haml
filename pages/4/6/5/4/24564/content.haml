                %a.existingWikiWord{:href => "/nlab/show/Sergey+M.+Frolov"}> Sergey M. Frolov
                ,
                = succeed "," do
                  %em Quantum computing’s reproducibility crisis: Majorana fermions
                %strong 592
                (2021) 350-352 &amp;lbrack;
                %a{:href => "https://doi.org/10.1038/d41586-021-00954-8"}> doi:10.1038/d41586-021-00954-8
                \&amp;rbrack;
            %li#Mourik24
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vincent+Mourik"}> Vincent Mourik
                ,
                = succeed "," do
                  %em You uncovered unreliable research. What happens next?
                = succeed "," do
