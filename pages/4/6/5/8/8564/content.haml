              %a.existingWikiWord{:href => "/nlab/show/invertible+matrices"} invertible matrices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \in Mat_{n \times n}(R)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
