                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi m
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Mat_{n \times m}(R)
              with entries in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is
              %a.existingWikiWord{:href => "/nlab/show/matrix+equivalence"} matrix equivalent
              to a
              %a.existingWikiWord{:href => "/nlab/show/diagonal+matrix"} diagonal matrix
              filled up with zeros:
            %p
