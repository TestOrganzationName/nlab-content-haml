                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Smith+normal+form"} Smith normal form
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
