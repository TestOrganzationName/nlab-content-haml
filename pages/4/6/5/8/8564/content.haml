          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+ideal"} principal ideal
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+ideal+ring"} principal ideal ring
