          #ReconstructionOfFractureSquare.num_lemma
            %h6#lemma Lemma
            %p For
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  a
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
                  %a.existingWikiWord{:href => "/nlab/show/modal+type"} modal type
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
