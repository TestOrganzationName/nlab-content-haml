          #TheDifferentialFractureSquare.num_prop
            %h6#proposition Proposition
            %p
              %strong (differential fracture square)
            %p
              For every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msub
                      %mi T
                      %mo *
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \hat E \in T_\ast \mathbf{H}
              the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
