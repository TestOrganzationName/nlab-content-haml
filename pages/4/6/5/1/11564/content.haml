                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi pb
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi E
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ch
                                  %mi E
                          %mtd
                            %mi Π
                            %msub
                              %mo ♭
                              %mi dR
                            %mover
                              %mi E
                              %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\hat E &amp;\stackrel{}{\longrightarrow}&amp; \flat_{dR} \hat E
                    \\\
                    \\downarrow &amp;{}^{(pb)}&amp; \downarrow
                    \\\
                    \\Pi(\hat E) &amp;\stackrel{ch_E}{\longrightarrow}&amp; \Pi \flat_{dR} \hat E
                    }
            %p
              (of the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              applied to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
              of the
              = succeed ")" do
