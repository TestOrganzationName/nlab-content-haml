                              %mi Π
                              %mi dR
                            %mover
                              %mi E
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi Π
                              %mi dR
                            %msub
                              %mo ♭
                              %mi dR
                            %mover
                              %mi E
                              %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
