                  \\array{
                  \&amp;&amp;  {{connection\;forms}\atop{on\;trivial\;bundles}} &amp;&amp; \stackrel{de\;Rham\;differential}{\longrightarrow} &amp;&amp; {{curvature}\atop{forms}}
                  \\\
