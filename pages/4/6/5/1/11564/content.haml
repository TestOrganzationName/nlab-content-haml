          .proof
            %h6#proof Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
              and
              %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category"} stability
              we have the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
