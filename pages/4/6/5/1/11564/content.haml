                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Pi_{dR} \flat \hat E &amp;\longrightarrow&amp; \Pi_{dR} \hat E
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\flat \hat E &amp; \longrightarrow &amp; \hat E
