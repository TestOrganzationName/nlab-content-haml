                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo ⋅
                          %mi U
                        %mi x
                    %mi U
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                    %mover
                      %mo →
                      %mi ω
                    %mi V
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
