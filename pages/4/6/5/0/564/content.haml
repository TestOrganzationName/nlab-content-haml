                    %mo →
                    %mn 2
                    %mtext -
                    %mi Pull
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi: Adj_{rep}(U, V) \to 2\text{-}Pull(U, V)
          %p Here then is one key definition.
          #ambi.num_defn
            %h6#definition_2 Definition
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo :
                      %mi A
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} U: A \to Set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo :
                      %mi B
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} V: B \to Set
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U, V)
              %strong dualizing object
              (or
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U, V)
              = succeed ")" do
                %em ambimorphic object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                    %mo ,
                    %mi ω
                    %mo :
                    %mi U
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                    %mover
                      %mo →
                      %mo ∼
                    %mi V
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{a}, \mathbf{b}, \omega: U \mathbf{a} \stackrel{\sim}{\to} V \mathbf{b})
              in the essential image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
          %h3#naturally_represented_adjunctions Naturally represented adjunctions
          %p
            Definition
            %a.maruku-ref{:href => "#ambi"}
            is reasonably general and is one of several notions of “schizophrenic object” given in
            = succeed "." do
              %a{:href => "#DT93"} Dimov-Tholen93
            %a{:href => "#DT89"} Dimov-Tholen 89
            and
            %a{:href => "#PorstTholen91"} Porst-Tholen 91
            and which covers many cases that arise in practice, involves initial lifts through the functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            Again, suppose given contravariant adjoint functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ,
                  %mi T
                %annotation{:encoding => "application/x-tex"} S, T
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mi S
                %annotation{:encoding => "application/x-tex"} U S
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi T
                %annotation{:encoding => "application/x-tex"} V T
            representable as above. We have maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mover
                    %mo →
                    %mrow
                      %mi U
                      %mi η
                  %mi U
                  %mi S
                  %mi T
                  %mo ≅
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo −
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "2em"}
                  %mi δ
