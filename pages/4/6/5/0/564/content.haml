                            %mo →
                            %mrow
                              %mi ϵ
                              %mo ′
                        %mtd
                          %msub
                            %mn 1
                            %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  1_A &amp; \stackrel{\eta'}{\to} &amp; S' T' &amp; &amp; &amp; &amp; &amp; &amp; T S' &amp; \stackrel{T \alpha}{\to} &amp; T S \\
                  _\mathllap{\eta} \downarrow &amp; &amp; \downarrow_\mathrlap{S' \beta} &amp; &amp; &amp; &amp; &amp; &amp; _\mathllap{\beta S'} \downarrow &amp; &amp; \downarrow_\mathrlap{\epsilon} \\
                  S T &amp; \underset{\alpha T}{\to} &amp; S' T &amp; &amp; &amp; &amp; &amp; &amp; T' S' &amp; \underset{\epsilon'}{\to} &amp; 1_B
                  }
          %p
            commute. We define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mtext -
                  %mi Pull
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 2\text{-}Pull(U, V)
            to be the
            %a.existingWikiWord{:href => "/nlab/show/2-pullback"} 2-pullback
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            (i.e., the bi-iso-comma-object). In conjunction with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
