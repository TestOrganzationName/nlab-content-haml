                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in Ob(B)
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %msub
                      %mi Adj
                      %mi rep
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 2
                    %mtext -
                    %mi Pull
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi: Adj_{rep}(U, V) \to 2\text{-}Pull(U, V)
              to the full subcategory whose objects are naturally represented adjoint pairs is full and faithful.
          %p
            See
            = succeed "," do
              %a{:href => "#DT93"} Dimov-Tholen
          %p
            Let us denote the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            on the module
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi A
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U: A \to Set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %mi a
                    %mo →
                    %mi U
                    %mi a
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A(a, a') \times U a \to U a'
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi f
                    %msub
                      %mo ⋅
                      %mi U
                    %mi x
                  %annotation{:encoding => "application/x-tex"} (f, x) \mapsto f \cdot_U x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi U
                  %mi a
                %annotation{:encoding => "application/x-tex"} x \in U a
            induces a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ⋅
                      %mi U
                    %mi x
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                  %annotation{:encoding => "application/x-tex"} - \cdot_U x: A(a, \mathbf{a}) \to U \mathbf{a}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ∈
                  %mi V
