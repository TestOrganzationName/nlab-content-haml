          %title Contents
          %blockquote
            %p
              This entry is about a concept of duality in general
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
              as used in
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
              and
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
              see at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/dualizing+object+in+a+closed+category"} dualizing object in a closed category
