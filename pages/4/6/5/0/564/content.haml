            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ⋅
                      %mi V
                    %mi y
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi V
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                  %annotation{:encoding => "application/x-tex"} - \cdot_V y: B(b, \mathbf{b}) \to V \mathbf{b}
          #natural.num_defn
            %h6#definition_4 Definition
            %p
              A
              = succeed "-ambimorphic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U, V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                    %mo ,
                    %mi ω
                    %mo :
                    %mi U
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                    %mover
                      %mo →
                      %mo ∼
                    %mi V
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{a}, \mathbf{b}, \omega: U \mathbf{a} \stackrel{\sim}{\to} V \mathbf{b})
              is
              %em natural
              if for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
