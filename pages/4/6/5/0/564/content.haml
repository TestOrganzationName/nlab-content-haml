                        %mi U
                        %mi a
                  %annotation{:encoding => "application/x-tex"} \{A(a, \mathbf{a}) \stackrel{- \cdot_U x}{\to} U \mathbf{a} \stackrel{\omega}{\to} V \mathbf{b}\}_{x \in U a}
            %p
              admits an
              %a.existingWikiWord{:href => "/nlab/show/topological+concrete+category"} initial lift
              targeted at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \mathbf{b}
              (so a suitable diagram of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mi x
                    %mo :
                    %mi T
                    %mi a
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \gamma_x: T a \to \mathbf{b}
              indexed over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                      %mi a
                    %annotation{:encoding => "application/x-tex"} x \in U a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi a
                  %annotation{:encoding => "application/x-tex"} T a
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi Ob
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in Ob(B)
              = succeed "-structured" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi b
                    %mo{:stretchy => "false"} )
                    %mover
