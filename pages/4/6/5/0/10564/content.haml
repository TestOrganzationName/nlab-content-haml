                  = succeed "," do
                    %a{:href => "http://www.ams.org/bookstore-getitem/item=PSPUM-81"} vol 81
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/1002.3004"} arXiv:1002.3004
              %li#ChenHanZhang10
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Qingtao+Chen"}> Qingtao Chen
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Fei+Han"} Fei Han
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Weiping+Zhang"} Weiping Zhang
                  = succeed "," do
                    %em Generalized Witten Genus and Vanishing Theorems
                  = succeed ")" do
