              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
            we have a
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %msub
                    %mi Top
                    %mi G
                  %mover
                    %mo ⟶
                    %mo ≃
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Orb
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L Top_G
                  \\stackrel{\simeq}{\longrightarrow}
                  PSh_\infty(Orb(G))
                  \\,.
          %p
            Let the
            %a.existingWikiWord{:href => "/nlab/show/global+points"} global points
            of the
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi E
                %annotation{:encoding => "application/x-tex"} Spec E
            be equipped with an
            %em orientation
            in the sense of a non-degenerate
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            homomorphism of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  B U(1) \longrightarrow A(Spec E)
          .num_prop
            %h6#proposition Proposition
            %p
              Induced form this (…) is an
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Orb
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                        %mover
                          %mo ←
                          %mrow
                      %mover
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ⊗
                            %mi G
                          %mi A
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Aff
                      %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi A
                          %mi G
                  %annotation{:encoding => "application/x-tex"}
                    PSh_\infty(Orb(G))
                    \\stackrel{\overset{(-)\otimes_G A}{\longrightarrow}}{\stackrel{\overset{}{\leftarrow}}{\underset{}{\longrightarrow}}}
                    Sh_\infty(Aff_E)_{/A_G}
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi G
                    %annotation{:encoding => "application/x-tex"} A_G
          %p
            (
            %a{:href => "#Gepner05"}> Gepner 05, theorem 3
            )
          .num_defn
            %h6#definition_3 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Aff
                      %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Aff
                      %mi E
                    %mo ≃
                    %mi E
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}
                    \\;\colon\;
                    Sh_\infty(Aff_E)
                    \\longrightarrow
                    Aff_E
                    \\simeq
                    E Alg^{op}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
              as discussed at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras on ∞-stacks
          .num_prop
            %h6#proposition_2 Proposition
            %p The composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %msub
                      %mi Top
                      %mi G
                    %mo ↪
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Orb
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi G
                        %mi A
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Aff
                      %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi A
                          %mi G
                    %mover
                      %mo ⟶
                      %mi 𝒪
                    %mi E
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    L Top_G
                    \\hookrightarrow
                    PSh_\infty(Orb(G))
                    \\stackrel{(-)\otimes_G A}{\longrightarrow}
                    Sh_\infty(Aff_E)_{/A_G}
                    \\stackrel{\mathcal{O}}{\longrightarrow}
                    E Alg^{op}
            %p
              takes a space with
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              to its
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            (
            %a{:href => "#Gepner05"}> Gepner 05, theorem 4
            )
          %h3#2EquivariantEllipticCohomology 2-Equivariant elliptic cohomology
          %blockquote
            %p under construction, tentative
          %p
            %a{:href => "#Lurie"} Lurie, section 5.1
            makes a vague mentioning of a more general perspective, where one evaluates elliptic cohomology not just on
            %a.existingWikiWord{:href => "/nlab/show/action+groupoids"} action groupoids
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            but also on
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotients"} homotopy quotients
            by
            %a.existingWikiWord{:href => "/nlab/show/infinity-actions"} actions
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-groups"} 2-groups
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
          %p
            The following are some remarks on how to possibly realize this and at the same time refine it to geometric cohomology (
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"}> differential cohomology
            ). Tentative – handle with care.
          %p
            So let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a simple, simply connected
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
          %p
            Regard
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            in
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            \=
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi SmthMfd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_\infty(SmthMfd)
            %em
              %a.existingWikiWord{:href => "/nlab/show/Lie+group+cohomology"} Lie group cohomology
            we have:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi ℂ
                    %mo ×
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ≃
                  %mi H
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi B
                  %mi G
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ≃
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_0
                  \\mathbf{H}\big(
                  \\mathbf{B}G
                  ,\,
                  \\mathbf{B}\mathbb{C}^\times
                  \\big)
                  \\simeq
                  H\big(
                  B G
                  ,\,
                  K(\mathbb{Z},4)
                  \\big)
                  \\simeq
                  \\mathbb{Z}
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
            classified by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℤ
                  %mo ∈
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi ℂ
                    %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{Z} \in \pi_0\mathbf{H}(\mathbf{B}G, \mathbf{B}\mathbb{C}^\times)
            is the
            %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            at level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msup
                            %mi ℂ
                            %mo ×
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi String
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mi k
                              %mstyle{:mathvariant => "bold"}
                                %mi c
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %msup
                            %mi ℂ
                            %mo ×
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}\mathbb{C}^\times &amp;\longrightarrow&amp; \mathbf{B}String_k(G)
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B}G &amp;\stackrel{k\mathbf{c}}{\longrightarrow}&amp; \mathbf{B}^3 \mathbb{C}^\times
                  }
          %p
            This cocycle has a
            = succeed "-refinement" do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/universal+Chern-Simons+3-connection"} universal Chern-Simons 3-connection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %msubsup
                    %mi ℂ
                    %mi conn
                    %mo ×
                %annotation{:encoding => "application/x-tex"}
                  k \mathbf{L} \;\colon\; \mathbf{B}G_{conn} \longrightarrow \mathbf{B}^3 \mathbb{C}^\times_{conn}
          %p
            Now given a
            %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %msup
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E = T^2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of the defining cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mrow
                    %mo (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mi ℏ
                    %mstyle{:displaystyle => "false"}
                      %msub
                        %mo ∫
                        %mi E
                      %mi k
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi E
                      %mo ,
                      %mi k
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %msubsup
                    %mi ℂ
                    %mi conn
                    %mo ×
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mi exp
                      %mrow
                        %mo (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi i
                            %mi ℏ
                        %msub
                          %mo ∫
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo )
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi ℂ
                    %mi conn
                    %mo ×
                %annotation{:encoding => "application/x-tex"}
                  \\exp\left(
                  \\tfrac{i}{\hbar}
                  \\textstyle{\int}_{E} k \mathbf{L}
                  \\right)
                  \\;\colon\;
                  [E, \mathbf{B}G_{conn}]
                  \\stackrel{[E, k \mathbf{L}]}{\longrightarrow}
                  [E, \mathbf{B}^3 \mathbb{C}^\times_{conn}]
                  \\stackrel{\exp\left(\tfrac{i}{\hbar} \int_{E}(-)\right)}{\longrightarrow}
                  \\mathbf{B}\mathbb{C}^\times_{conn}
          %p
            which now defines a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
            %a.existingWikiWord{:href => "/nlab/show/bundle+with+connection"} bundle with connection
            on the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+connections"} moduli stack of connections
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+flat+connections"} moduli stack of flat connections
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hitchin+connection"} Hitchin connection
          %p
            Consider then a collection of tori
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            parameterized trivially over some parameter space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ×
                  %mi B
                  %mo →
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E \times B \to B
                  \\,.
          %p Then the above yields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi B
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mover
                    %mo ⟶
                    %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mo ,
                  %msup
                    %mi ℂ
                    %mo ×
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  (\Pi E) \times B, \mathbf{B}G
                  \\big]
                  \\stackrel{}{\longrightarrow}
                  \\mathbf{B}[B,\mathbb{C}^\times]
          %p
            hence yields a
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi B
                    %mo ,
                    %msup
                      %mi ℂ
                      %mo ×
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [B,\mathbb{C}^\times]
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            = succeed "-collections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            Now we want to consider this for the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a space in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spectral+geometry"} spectral geometry
          %p
            To that end, pass to the larger
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+E-%E2%88%9E+groupoids"} smooth E-∞ groupoids
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
            there denote the object which to a pair consisting of a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and an
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            assigns
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mi m
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %msup
                    %mi ℂ
                    %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{G}_m \;\colon\; (U, R) \mapsto GL_1(R) \otimes C^\infty(U,\mathbb{C}^\times)
          %p
            hence the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            with the underlying
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
          %p
            Let then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msub
                    %mi CAlg
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A \in CAlg_\infty
            be an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B = Spec(A)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  E \to Spec(A)
          %p
            for a
            = succeed "-collection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tori"} tori
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(A)
          %p
            Since for a
            %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            its
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            is
            %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            to its
            %a.existingWikiWord{:href => "/nlab/show/character+group"} character group
            (via the canonical non-degenrarate
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            on both), we take the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(E)
            now to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}[E, \mathbb{G}_m]
                  \\,.
          %p
            Then since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mo ×
                  %mo =
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times = \mathbb{G}_m
            is the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
            in this context, we have now (and there is a subtlety here…) that maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"}
                  Spec(A) \longrightarrow \mathbb{G}_m
          %p
            are equivalently elements in the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
            modulated by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\chi
                  \\,\colon\,
                  \\big[
                  \\mathbf{B}[E,\mathbb{G}_m], \mathbf{B}G
                  \\big]
                  \\longrightarrow
                  \\mathbf{B}GL_1(A)
                  \\,.
          %p
            Forming its space of co-sections yields, by the discussion at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            A-
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi χ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} [
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mi m
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A^\chi
                  \\big(
                  [ \mathbf{B}[E,\mathbb{G}_m], \mathbf{B}G ]
                  \\big)
                  \\,.
          %p
            And that should be the
            = succeed "-\u201Cequivariant\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %p (…)
          %h2#Properties Properties
          %h3#RelationToConformalBlocks Relation to conformal blocks of the WZW model
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a compact, simple and simply connected Lie group, consider the
            %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}^2 U(1) &amp;\to&amp; \mathbf{B}String
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
                  \\,.
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/higher+moduli+stacks"} higher moduli stacks
            of
            %a.existingWikiWord{:href => "/nlab/show/flat+%E2%88%9E-connections"} flat ∞-connections
            on an
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            form the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  [\Pi(T),\mathbf{B}^2 U(1)] &amp;\to&amp; [\Pi(T),\mathbf{B}String]
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; [\Pi(T), \mathbf{B}G]
                  }
                  \\,.
          %p
            Now passing to the
            %a.existingWikiWord{:href => "/nlab/show/0-truncation"} 0-truncation
            turns the bottom piece into the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+flat+connections"} moduli space of flat connections
            on the torus, which is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi G
                  %annotation{:encoding => "application/x-tex"} A_G
            = succeed "," do
              %a.maruku-ref{:href => "#TheModuliSpace"}
            = succeed "." do
              %a.maruku-ref{:href => "#ModuliSpaceOfFlatConnections"}
          %p
            By the discussion at
            %a{:href => "smooth+infinity-groupoid#StrucChernSimons"} smooth higher holonomy
            the 0-truncation of the top left piece is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mi τ
                            %mn 0
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi A
                            %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  U(1) &amp;\longrightarrow&amp; \tau_0 [\Pi(T),\mathbf{B}String]
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; A_G
                  }
                  \\,.
          %p
            This state of affairs is hinted at in (
            %a{:href => "#Lurie"}> Lurie, section 5.1
            ).
          %p
            More in detail, notice that the
            %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            extension is modulated by a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c} \;\colon\; \mathbf{B}G_{conn} \longrightarrow \mathbf{B}^3 U(1)_{conn}
          %p
            and the above circle-bundle is modulated by the
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mrow
                    %mo (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mi ℏ
                    %msub
                      %mo ∫
                      %mi T
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi T
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mi ℏ
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp\left(
                  \\tfrac{i}{\hbar}
                  \\int_{T} \mathbf{c}
                  \\right)
                  \\;\colon\;
                  [T, \mathbf{B}G_{conn}]
                  \\stackrel{[T,\mathbf{c}]}{\longrightarrow}
                  [T, \mathbf{B}^3 U(1)_{conn}]
                  \\stackrel{\exp(\tfrac{i}{\hbar} (-) )}{\longrightarrow}
                  \\mathbf{B}U(1)_{conn}
                  \\,.
          %p
            (By the discussion at
            = succeed ".)" do
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} dcct
          %p
            By the general discussion at
            %a.existingWikiWord{:href => "/nlab/show/quantization+of+Chern-Simons+theory"} quantization of Chern-Simons theory
            and the
            %a.existingWikiWord{:href => "/nlab/show/holography"} holograpic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2+and+CS-WZW+correspondence"} CS-WZW correspondence
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of this line bundle is the space of
            %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
            of the
            %a.existingWikiWord{:href => "/nlab/show/Wess-Zumino-Witten+model"} Wess-Zumino-Witten model
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            (This statement also appears as (
            %a{:href => "#Lurie"}> Lurie, remark 5.2
            )).
          %h3#RelationToLoopGroupRepresentations Relation to loop group representations
          %p
            When restricting the above general construction to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Tate+curve"} Tate curve
            %a.existingWikiWord{:href => "/nlab/show/loop+group+representations"} loop group representations
            (when over the complex numbers, at least,
            = succeed ")." do
              %a{:href => "#Ando00"} Ando00, theorem 10.10
          %p
            In terms of differential geometry (
            %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"}> dcct
            ) consider the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ⟶
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  G \longrightarrow [S^1, \mathbf{B}G_{conn}]
          %p
            which locally sends a group elemnent
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            to the constant
            %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
            on the circle with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            as its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
          %p This induces an inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [S^1, G]
                  \\hookrightarrow
                  [S^1, [S^1, \mathbf{B}G_{conn}]]
                  \\simeq
                  [T, \mathbf{B}G_{conn}]
          %p
            and pulling the above WZW circle bundle back along this inclusion yields the bundle on the
            %a.existingWikiWord{:href => "/nlab/show/loop+group"} loop group
            which is the
            %a.existingWikiWord{:href => "/nlab/show/prequantum+bundle"} prequantum bundle
            whose
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            yields the
            %a.existingWikiWord{:href => "/nlab/show/loop+group+representations"} loop group representations
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/positive+energy+representations"} positive energy
          %p
            Algebraically, this corresponds to evaluating equivariant elliptic cohomology on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Tate+curve"} Tate curve
            = succeed ")." do
              %a{:href => "#Lurie"} Lurie, theorem 5.1
          .num_remark
            %h6#remark_3 Remark
            %p
              In the full
              %a.existingWikiWord{:href => "/nlab/show/derived+algebraic+geometry"} derived algebraic geometry
              the space of sections of the line bundle on the moduli space has the structure of a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K((q))
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              (
              %a{:href => "#Lurie"}> Lurie, below remark 5.4
              ).
          %p (…)
          %h3#RelationToLineBundleOnBSpin
            Relation to the Chern-Simons
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with an oriented
            %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"} derived elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo →
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma \to Spec(A)
            there are a priori two different
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-line+bundles"} ∞-line bundles
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} B Spin
          %p On the one hand there is the bundle classified by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mi Spin
                  %mover
                    %mo ⟶
                    %mrow
                  %mi B
                  %mi O
                  %mover
                    %mo ⟶
                    %mi J
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  J_A
                  \\;\colon\;
                  B Spin
                  \\stackrel{}{\longrightarrow}
                  B O
                  \\stackrel{J}{\longrightarrow}
                  B GL_1(\mathbb{S})
                  \\longrightarrow
                  B GL_1(A)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} \mathbb{S}
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(-)
            the
            = succeed "-construction" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒜
                    %mi s
                %annotation{:encoding => "application/x-tex"} \mathcal{A}_s
            in
            = succeed ")." do
              %a{:href => "#Lurie"} Lurie, middle of p.38
            = succeed ")," do
              %a{:href => "#AndoBlumbergGepner10"} Ando-Blumberg-Gepner 10, section 8
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                %annotation{:encoding => "application/x-tex"} A =
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            this is equivalently the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-line+bundle"} ∞-line bundle
            %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated
            to the
            %a.existingWikiWord{:href => "/nlab/show/universal+Chern-Simons+line+3-bundle"} universal Chern-Simons line 3-bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mi Spin
                  %mover
                    %mo ⟶
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msub
                        %mi p
                        %mn 1
                  %msup
                    %mi B
                    %mn 4
                  %mi ℤ
                  %mover
                    %mo ⟶
                    %mover
                      %mi σ
                      %mo{:stretchy => "false"} ˜
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  A(\tfrac{1}{2}p_1)
                  \\;\colon\;
                  B Spin
                  \\stackrel{\tfrac{1}{2}p_1}{\longrightarrow}
                  B^4 \mathbb{Z}
                  \\stackrel{\tilde \sigma}{\longrightarrow}
                  B GL_1(A)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}p_1
            is the
            %a.existingWikiWord{:href => "/nlab/show/first+fractional+Pontryagin+class"} first fractional Pontryagin class
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi σ
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde \sigma
            is an
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+orientation+of+tmf"} string orientation of tmf
          %p
            In addition, by equivariant elliptic cohomology there is the
            %a.existingWikiWord{:href => "/nlab/show/theta+line-bundle"} theta line-bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Loc
                    %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi 𝔾
                    %mi m
                %annotation{:encoding => "application/x-tex"}
                  \\theta \;\colon\; Loc_{Spin}(\Sigma) \longrightarrow \mathbf{B} \mathbb{G}_m
          %p
            on the derived
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+flat+connections"} moduli stack of flat connections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Loc
                    %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Loc_{Spin}(\Sigma)
            (where in (
            %a{:href => "#Lurie"}> Lurie
            )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Loc
                    %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Loc_{Spin}(\Sigma)
            is denoted
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi Spin
                  %annotation{:encoding => "application/x-tex"} M_{Spin}
            %a.existingWikiWord{:href => "/nlab/show/global+points"} global points
            yields the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-line+bundle"} ∞-line bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Γ
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Loc
                    %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_{Spec(A)}(\theta) \;\colon\; \Gamma_{Spec(A)}(Loc_{Spin}(\Sigma))
                  \\longrightarrow B GL_1(A)
                  \\,.
          %p
            So there are a priori two
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-oine" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a{:href => "#Lurie"} Lurie, bottom of p. 38
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mi Spin
                  %mo ⟶
                  %msub
                    %mi Γ
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Loc
                    %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi \;\colon\; B Spin \longrightarrow \Gamma_{Spec(A)}(Loc_{Spin}(\Sigma))
                  \\,.
          %p
            Heuristically, this is the map that includes the trivial
            = succeed "-local" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} Spin
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            into the (points of the)
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of all local systems.
          %p
            Hence the pullback of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Loc
                    %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_{Spec(A)}(Loc_{Spin}(\Sigma))
            yields another
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mo *
                  %msub
                    %mi Γ
