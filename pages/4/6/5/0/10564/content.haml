            (to the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle 3-group
            = succeed "\u201D)" do
              %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"} global equivariant homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/n-group"} 3-groups
            such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
