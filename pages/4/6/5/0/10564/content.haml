              \/
              %a.existingWikiWord{:href => "/nlab/show/spin-orientation+of+Tate+K-theory"}> spin-orientation of Tate K-theory
              ):
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"}> Michael Hopkins
