          #CobarComplex.num_defn
            %h6#definition_2 Definition
            %p
              %strong (cobar complex)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebra"} commutative Hopf algebra
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              for which the left and right units coincide
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo ⟶
                        %mi η
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} A \overset{\eta}{\longrightarrow} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              be a left
              = succeed "-comodule." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            %p
              The
              %strong cobar complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet_\Gamma(N)
              is the
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
              of abelian groups with terms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi Γ
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %munder
                        %mrow
                          %mover
                            %mi Γ
                            %mo ¯
                          %msub
                            %mo ⊗
                            %mi A
                          %mi ⋯
                          %msub
                            %mo ⊗
                            %mi A
                          %mover
                            %mi Γ
                            %mo ¯
                        %mo ⏟
                      %mrow
                        %mi s
                        %mspace{:width => "thickmathspace"}
                        %mi factors
                    %msub
                      %mo ⊗
                      %mi A
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    C^s_\Gamma(N)
                    \\coloneqq
                    \\underset{s\; factors}{
                    \\underbrace{
                    \\overline{\Gamma}
                    \\otimes_A
                    \\cdots
                    \\otimes_A
                    \\overline{\Gamma}
                    }
                    }
                    \\otimes_A N
            %p
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\Gamma}
              the unit coideal of def.
              = succeed "," do
                %a.maruku-ref{:href => "#UnitCoidealInCommutativeHopfAlgebra"}
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed ")" do
                %a.maruku-ref{:href => "#PropertiesOfUnitCoideal"}
            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi s
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi C
                      %mi Γ
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi C
                      %mi Γ
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_s \colon C^s_\Gamma(N) \longrightarrow C^{s+1}_\Gamma(N)
              given by the alternating sum of the coproducts via lemma
              = succeed "." do
                %a.maruku-ref{:href => "#PropertiesOfUnitCoideal"}
          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, def. A1.2.11
            )
          #CobarComplexGivesExtGroupsOutOfA.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebra"} commutative Hopf algebra
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              for which the left and right units coincide
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo ⟶
                        %mi η
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} A \overset{\eta}{\longrightarrow} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              be a left
              = succeed "-comodule." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the cobar complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet_\Gamma(N)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CobarComplex"}
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (regarded as a left comodule via def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComoduleStructureOnGroundRing"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi C
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ext
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(C^\bullet_\Gamma(N))
                    \\;\simeq\;
                    Ext^\bullet_\Gamma(A,N)
                    \\,.
          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, cor. A1.2.12
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, prop. 5.2.1
          %h3#selfext_of_free_graded_commutative_coalgebras Self-Ext of free graded commutative coalgebras
          %p
            Throughout, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            be a graded
            %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebra
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Gamma,A)
            for this data.
          #CoModuleExtFromAToAForPrimitivelyGeneratedExteriorAlgebra.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              be a graded
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebra"} commutative Hopf algebra
              such that
            %ol
              %li
                %p the underlying algebra is free graded commutative;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \eta \colon A \to \Gamma
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/flat+morphism"} flat morphism
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  is generated by
                  %a.existingWikiWord{:href => "/nlab/show/primitive+elements"} primitive elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi x
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{x_i\}_{i\in I}
            %p
              then the
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              of
              = succeed "-comodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and itself is the (graded) polynomial algbra on these generators:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ext
                      %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    Ext_\Gamma(A,A) \simeq A[\{x_i\}_{i \in I}]
          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, lemma 3.1.9
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, prop. 3.7.5
          .proof
            %h6#proof_3 Proof
            %p
              Consider the co-free left
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")" do
                %a{:href => "commutative+Hopf+algebroid#CoFreeComodules"} prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \otimes_A A[\{y_i\}_{i \in I}]
            %p
              and regard it as a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of left comodules by defining a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi x
                      %mi i
                    %mo ↦
                    %msub
                      %mi y
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    d \colon x_i \mapsto y_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi y
                      %mi i
                    %mo ↦
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d \colon y_i \mapsto 0
            %p
              and extending as a graded
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %p
              We claim that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is a homomorphism of left comodules: Due to the assumption that all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              are primitive we have on generators that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %mo ⊗
                            %mn 1
                            %mo +
                            %mn 1
                            %mo ⊗
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mrow
                                %msub
                                  %mi x
                                  %mi i
                                %mo ⊗
                                %munder
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi d
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                                  %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo +
                            %munder
                              %mrow
                                %mn 1
                                %mo ⊗
                                %munder
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi d
                                    %msub
                                      %mi x
                                      %mi i
                                    %mo{:stretchy => "false"} )
                                  %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi y
                                  %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (id,d) ( \Psi(x_i)  )
                    \&amp; =
                    (id,d) ( x_i \otimes 1 + 1 \otimes x_i )
                    \\\
                    \&amp; =
                    \\underset{= 0}{x_i  \otimes \underbrace{(d 1)} }
                    +
                    \\underset{= y_i}{ 1 \otimes \underbrace{(d x_i)} }
                    \\\
                    \&amp; =
                    \\Psi( d x_i )
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi d
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (id,d)( \Psi(y_i) )
                    \&amp; =
                    (id,d) ( 1, y_i )
                    \\\
                    \&amp; =
                    (1, d y_i)
                    \\\
                    \&amp; =
                    0
                    \\\
                    \&amp; =
                    \\Psi( 0 )
                    \\\
                    \&amp; =
                    \\Psi(d y_i)
                    \\end{aligned}
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is a graded derivation on a free graded commutative algbra, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
              is an algebra homomorphism, this implies the statement for all other elements.
            %p
              Now observe that the canonical
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
