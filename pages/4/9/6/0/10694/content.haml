          #PropertiesOfUnitCoideal.num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
