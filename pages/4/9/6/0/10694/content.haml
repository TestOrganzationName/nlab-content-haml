                    %mi h
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  d_1( h_{2,1} )
                  \=
                  h_{2,1} \otimes \underset{= 0}{\underbrace{h_{0,n}}}
                  +
                  h_{1,2} \otimes h_{1,1}
                  +
                  \\underset{ = 0}{\underbrace{h_{0,3}}} \otimes h_{2,1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
