                    %mi h
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 0
                %annotation{:encoding => "application/x-tex"}
                  d_1(h_{2,0})
                  \=
                  h_{2,0} \otimes \underset{= 0}{\underbrace{h_{0,0}}}
                  +
                  h_{1,1} \otimes h_{1,0}
                  +
                  \\underset{= 0}{\underbrace{h_{0,2}}} h_{2,0}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi h
                    %mrow
                      %mn 2
