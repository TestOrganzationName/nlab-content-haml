                    \=
                    Ext_{gr_\bullet \Gamma}(gr_\bullet N_1, gr_\bullet N_2)
                    \\;\Rightarrow\;
                    Ext_{\Gamma}(N_1, N_2)
            %p
              converging to the
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} N_2
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              Hopf algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi gr
