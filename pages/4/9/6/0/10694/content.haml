          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, lemma 3.1.9
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, prop. 3.7.5
          .proof
            %h6#proof_4 Proof
            %p
              The filtering induces a filtering on the standard cobar complex (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CobarComplex"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cotor
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cotor(A,A)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
              = succeed ")." do
                %a{:href => "spectral+sequence+of+a+filtered+complex#FirstPages"} prop.
          %h2#construction_of_the_may_spectral_sequence Construction of the May spectral sequence
          %p
            Let now
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≔
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A \coloneqq \mathbb{F}_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ≔
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo •
                %annotation{:encoding => "application/x-tex"} \Gamma \coloneqq \mathcal{A}^\bullet_{\mathbb{F}_2}
            be the mod 2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dual+Steenrod+algebra"} dual Steenrod algebra
            = succeed "," do
              %a{:href => "Steenrod+algebra#MilnorTheoremOnDualSteenrodAlgebra"} Milnor’s theorem
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo •
                  %mo =
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ξ
                    %mn 1
                  %mo ,
                  %msub
                    %mi ξ
                    %mn 2
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{A}^\bullet_{\mathbb{F}_2}
                  \=
                  \\mathbb{F}_2[\xi_1, \xi_2, \cdots]
                  \\,.
          %p and the coproduct is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ψ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ξ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
