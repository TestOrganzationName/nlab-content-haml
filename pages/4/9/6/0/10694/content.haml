              is a
              %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
              it preserves cokernels, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mover
                      %mi Γ
                      %mo ¯
