                        %msub
                          %mi η
                          %mi R
                    %mi Γ
                    %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A \overset{\eta_R}{\longrightarrow} \Gamma \simeq \Gamma \otimes_A A
            %p and it becomes a right comodule with coaction given by the left unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
