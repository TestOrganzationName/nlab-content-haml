          #SpectralSequenceConvergingToExtForFilteredHopfAlgebra.num_lemma
            %h6#lemma_3 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/filtering"} filtering
              right/left
              = succeed "-comodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              are compatibly filtered, then there is a
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 1
                    %mo =
                    %msub
                      %mi Ext
                      %mrow
                        %msub
                          %mi gr
                          %mo •
                        %mi Γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi gr
                      %mo •
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi gr
                      %mo •
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ext
                      %mi Γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
