                      %mo ⊗
                      %mi A
                    %mover
                      %mi Γ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\Gamma} \;\colon\; \overline{\Gamma} \longrightarrow \overline{\Gamma} \otimes_A \overline{\Gamma}
              such that the projection intertwines the two coproducts.
          .proof
            %h6#proof_2 Proof
            %p
              For the first statement, consider the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi A
                                %mo ⊗
                                %mi η
                          %mtd
                            %mi A
