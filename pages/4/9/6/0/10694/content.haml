                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∃
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Γ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi Γ
                              %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes A
                    \&amp;\overset{A \otimes \eta}{\longrightarrow}&amp;
                    A \otimes \Gamma
                    \&amp;\longrightarrow&amp;
                    A \otimes \overline{\Gamma}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{\exists}}
                    \\\
                    A
                    \&amp;\underset{\eta}{\longrightarrow}&amp;
                    \\Gamma
                    \&amp;\longrightarrow&amp;
                    \\overline{\Gamma}
                    }
                    \\,,
            %p
              where the left
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              exhibits the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is a homomorphism of left
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
