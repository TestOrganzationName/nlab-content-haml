                  %annotation{:encoding => "application/x-tex"} gr_\bullet \Gamma
              between the associated graded modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
