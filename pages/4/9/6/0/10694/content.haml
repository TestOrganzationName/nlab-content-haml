                          %mn 2
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^\ast_{\mathbb{F}_2}
              takes the following simple form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi i
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo −
                        %mi k
                        %mo ,
                        %mi n
                        %mo +
                        %mi k
                    %mo ⊗
                    %msub
                      %mi h
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi(h_{i,n})
                    \\;=\;
                    \\underoverset{k = 0}{i}{\sum} h_{i-k,n+k}\otimes h_{k,n}
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              Using that the coproduct of a
              %a.existingWikiWord{:href => "/nlab/show/bialgebra"} bialgebra
              is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              for the algebra structure and using
              %a.existingWikiWord{:href => "/nlab/show/freshman%27s+dream"} freshman's dream
              arithmetic over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo ,
                                %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi Ψ
                            %mrow
                              %mo (
                              %msubsup
                                %mi ξ
                                %mi i
                                %mrow
                                  %msup
                                    %mn 2
                                    %mi n
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ξ
                              %mi i
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mn 2
                                %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %munderover
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                  %mrow
                                    %mi k
                                    %mo =
                                    %mn 0
                                  %mi i
                                %msubsup
                                  %mi ξ
                                  %mrow
                                    %mi i
                                    %mo −
                                    %mi k
                                  %mrow
                                    %msup
                                      %mn 2
                                      %mi k
                                %mo ⊗
                                %msub
                                  %mi ξ
                                  %mi k
                                %mo )
                              %mrow
                                %msup
                                  %mn 2
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mi i
                            %msup
                              %mrow
                                %mo (
                                %msubsup
                                  %mi ξ
                                  %mrow
                                    %mi i
                                    %mo −
                                    %mi k
                                  %mrow
                                    %msup
                                      %mn 2
                                      %mi k
                                %mo )
                              %mrow
                                %msup
                                  %mn 2
                                  %mi n
                            %mo ⊗
                            %msubsup
                              %mi ξ
                              %mi k
                              %mrow
                                %msup
                                  %mn 2
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mi i
                            %msubsup
                              %mi ξ
                              %mrow
                                %mi i
                                %mo −
                                %mi k
                              %mrow
                                %msup
                                  %mn 2
                                  %mi k
                                %mo ⋅
                                %msup
                                  %mn 2
                                  %mi n
                            %mo ⊗
                            %msubsup
                              %mi ξ
                              %mi k
                              %mrow
                                %msup
                                  %mn 2
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mi i
                            %msubsup
                              %mi ξ
                              %mrow
                                %mi i
                                %mo −
                                %mi k
                              %mrow
                                %msup
                                  %mn 2
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi k
                                    %mo +
                                    %mi n
                                    %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msubsup
                              %mi ξ
                              %mi k
                              %mrow
                                %msup
                                  %mn 2
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %mn 0
                              %mi i
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo −
                                %mi k
                                %mo ,
                                %mi n
                                %mo +
                                %mi k
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mi k
                                %mo ,
                                %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Psi(h_{i,n})
                    \&amp; =
                    \\Psi\left(\xi_i^{2^n}\right)
                    \\\
                    \&amp; = (\Psi(\xi_i))^{2n}
                    \\\
                    \&amp; =
                    \\left(\underoverset{k = 0}{i}{\sum} \xi_{i-k}^{2^k} \otimes \xi_k\right)^{2^n}
                    \\\
                    \&amp; = \underoverset{k = 0}{i}{\sum} \left(\xi_{i-k}^{2^k}\right)^{2^n} \otimes \xi^{2^n}_k
                    \\\
                    \&amp; = \underoverset{k = 0}{i}{\sum} \xi_{i-k}^{2^k \cdot 2^n} \otimes \xi^{2^n}_k
                    \\\
                    \&amp; = \underoverset{k = 0}{i}{\sum} \xi_{i-k}^{2^{(k+n)}} \otimes \xi^{2^n}_k
                    \\\
                    \&amp; = \underoverset{k = 0}{i}{\sum} h_{i-k,n+k}\otimes h_{k,n}
                    \\end{aligned}
                    \\,.
          %p
            Define a
            %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} grading
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo •
                %annotation{:encoding => "application/x-tex"} \mathcal{A}^\bullet_{\mathbb{F}_2}
            by setting (this is due to (
            %a{:href => "#Ravenel86"}> Ravenel 86, p.69
            ))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %mn 2
                  %mi i
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  {\vert h_{i,n} \vert}
                  \\coloneqq
                  2i-1
          %p and extending this additively to these unique representative.
          %p For instance
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} |
                          %msubsup
                            %mi ξ
                            %mi i
                            %mn 5
                          %msubsup
                            %mi ξ
                            %mi j
                            %mn 7
                          %mo{:stretchy => "false"} |
                        %mtd
                          %mo =
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo ,
                                %mn 0
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo ,
                                %mn 2
                            %msub
                              %mi h
                              %mrow
                                %mi j
                                %mo ,
                                %mn 0
                            %msub
                              %mi h
                              %mrow
                                %mi j
                                %mo ,
                                %mn 1
                            %msub
                              %mi h
                              %mrow
                                %mi j
                                %mo ,
                                %mn 2
                            %mo{:stretchy => "false"} |
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 2
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mi i
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 3
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mi j
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\vert \xi_i^5 \xi_j^7\vert
                  \&amp; =
                  {\vert h_{i,0} h_{i,2} h_{j,0} h_{j,1} h_{j,2} \vert}
                  \\\
                  \&amp; =
                  2(2i-1) + 3(2j-1)
                  \\end{aligned}
                  \\,.
          %p
            Consider the corresponding
            %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtering
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo ⊂
                  %msub
                    %mi F
                    %mi p
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo *
                  %mo ⊂
                  %msub
                    %mi F
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo *
                  %mo ⊂
                  %mi ⋯
                  %mo ⊂
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\subset
                  F_p \mathcal{A}^\ast_{\mathbb{F}_2}
                  \\subset
                  F_{p+1} \mathcal{A}^\ast_{\mathbb{F}_2}
                  \\subset
                  \\cdots
                  \\subset
                  \\mathcal{A}^\ast_{\mathbb{F}_2}
          %p
            with filtering stage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            containing all elements of total degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \leq p
          %p Observe that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi Ψ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ξ
                            %mi i
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %munder
                            %munder
                              %mrow
                                %msub
                                  %mi ξ
                                  %mi i
                                %mo ⊗
                                %mn 1
                              %mo ⏟
                            %mrow
                              %mi deg
                              %mo =
                              %mn 2
                              %mi i
                              %mo −
                              %mn 1
                          %mo +
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mn 0
                              %mo &lt;
                              %mi k
                              %mo &lt;
                              %mi i
                            %mrow
                          %munder
                            %munder
                              %mrow
                                %msubsup
                                  %mi ξ
                                  %mrow
                                    %mi i
                                    %mo −
                                    %mi k
                                  %mrow
                                    %msup
                                      %mi p
                                      %mi k
                                %mo ⊗
                                %msub
                                  %mi ξ
                                  %mi k
                              %mo ⏟
                            %mrow
                              %mi deg
                              %mo =
                              %mn 2
                              %mi i
                              %mo −
                              %mn 2
                          %mo +
                          %munder
                            %munder
                              %mrow
                                %mn 1
                                %mo ⊗
                                %msub
                                  %mi ξ
                                  %mi i
                              %mo ⏟
                            %mrow
                              %mi deg
                              %mo =
                              %mn 2
                              %mi i
                              %mo −
                              %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\Psi(\xi_i)
                  \&amp;
                  \=
                  \\underset{deg = 2i-1}{\underbrace{\xi_{i} \otimes 1}}
                  +
                  \\underoverset{0 \lt k \lt i}{}{\sum}
                  \\underset{deg = 2i-2}{\underbrace{\xi_{i-k}^{p^k} \otimes \xi_k}}
                  +
                  \\underset{deg = 2i-1}{\underbrace{1 \otimes \xi_i}}
                  \\end{aligned}
                  \\,.
          %p
            This means that after projection to the
            %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
            Hopf algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo *
                  %mo ⟶
                  %msub
                    %mi gr
                    %mo •
                  %msubsup
                    %mi 𝒜
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  F_\bullet \mathcal{A}^\ast_{\mathbb{F}_2}
                  \\longrightarrow
                  gr_\bullet \mathcal{A}^\ast_{\mathbb{F}_2}
          %p
            all the generators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"} h_{i,n}
            become
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/primitive+elements"} primitive elements
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi Ψ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi h
                            %mrow
                              %mi i
                              %mo ,
                              %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi h
                            %mrow
                              %mi i
                              %mo ,
                              %mi n
                          %mo ⊗
                          %mn 1
                          %mo +
                          %mn 1
                          %mo ⊗
                          %msub
                            %mi h
                            %mrow
                              %mi i
                              %mo ,
                              %mi n
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ∈
                          %msub
                            %mi gr
                            %mo •
                          %msubsup
                            %mi 𝒜
                            %mrow
                              %msub
                                %mi 𝔽
                                %mn 2
                            %mo *
                          %mo ⊗
                          %msub
                            %mi gr
                            %mo •
                          %msubsup
                            %mi 𝒜
                            %mrow
                              %msub
                                %mi 𝔽
                                %mn 2
                            %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\Psi(h_{i,n})
                  \&amp;
                  \=
                  h_{i,n}\otimes 1
                  +
                  1 \otimes h_{i,n}
                  \\;\;\;\;\;
                  \\in
                  gr_\bullet \mathcal{A}^\ast_{\mathbb{F}_2}
                  \\otimes
                  gr_\bullet \mathcal{A}^\ast_{\mathbb{F}_2}
                  \\end{aligned}
                  \\,.
          %p
            Hence lemma
            %a.maruku-ref{:href => "#CoModuleExtFromAToAForPrimitivelyGeneratedExteriorAlgebra"}
            applies and says that thet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                %annotation{:encoding => "application/x-tex"} Ext
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
            to itself over the
            %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
            Hopf algebra is the polynomial algebra in these generators:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ext
                    %mrow
                      %mi gr
                      %msubsup
                        %mi 𝒜
                        %mrow
                          %msub
                            %mi 𝔽
                            %mn 2
                        %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo ,
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mo ,
                      %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %mi i
                          %mo ≥
                          %mn 1
                          %mo ,
                      %mrow
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 0
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ext_{gr \mathcal{A}^\ast_{\mathbb{F}_2}}(\mathbb{F}_2,\mathbb{F}_2)
                  \=
                  \\mathbb{F}_2[\{h_{i,n}\}_{{i \geq 1,} \atop {n \geq 0}}]
                  \\,.
          %p
            Moreover, lemma
            %a.maruku-ref{:href => "#SpectralSequenceConvergingToExtForFilteredHopfAlgebra"}
            says that this is the first page of a spectral sequence that converges to the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                %annotation{:encoding => "application/x-tex"} Ext
            over the original Hopf algebra:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mn 1
                  %mo =
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mo ,
                      %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %mi i
                          %mo ≥
                          %mn 1
                      %mrow
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 0
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Ext
                    %mrow
                      %msubsup
                        %mi 𝒜
                        %mrow
                          %msub
                            %mi 𝔽
                            %mn 2
                        %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo ,
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{E}_1
                  \=
                  \\mathbb{F}_2[\{h_{i,n}\}_{{i \geq 1} \atop {n \geq 0}}]
                  \\;\Rightarrow\;
                  Ext_{\mathcal{A}^\ast_{\mathbb{F}_2}}(\mathbb{F}_2,\mathbb{F}_2)
                  \\,.
          %p
            This is the
            %em May spectral sequence
            for the computation of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ext
                      %mrow
                        %msubsup
                          %mi 𝒜
                          %mrow
                            %msub
                              %mi 𝔽
                              %mn 2
                          %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext_{\mathcal{A}^\ast_{\mathbb{F}_2}}(\mathbb{F}_2,\mathbb{F}_2)
            = succeed "-linear," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
            %a{:href => "spectral+sequence#ExtensionProblem"} extension problem
            is trivial.
          %p
            Moreover, again by lemma
            = succeed "," do
              %a.maruku-ref{:href => "#SpectralSequenceConvergingToExtForFilteredHopfAlgebra"}
            = succeed "-page" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "-almost" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed ")." do
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+I#DifferentialsOnAlmostChains"} prop.
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mrow
                        %msub
                          %mi 𝔽
                          %mn 2
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^\ast_{\mathbb{F}_2}
            %a.maruku-ref{:href => "#CoproductOnDualSteenrodInTermsOfAdaptedGenerators"}
            this is:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mo ,
                      %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %mi i
                  %msub
                    %mi h
                    %mrow
                      %mi i
                      %mo −
                      %mi k
                      %mo ,
                      %mi n
                      %mo +
                      %mi k
                  %mo ⊗
                  %msub
                    %mi h
                    %mrow
                      %mi k
                      %mo ,
                      %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_1 (h_{i,n})
                  \=
                  \\underoverset{k = 0}{i}{\sum} h_{i-k,n+k}\otimes h_{k,n}  \,.
          %h2#TheSecondPageOfTheClassicalAdamsSpectralSequence The second page of the classical Adams spectral sequence
          %p
            Now we use the above formula to explicitly compute the cohomology of the second page of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
          %p
            In doing so it is now crucial that the differential in the standard cobar complex (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#CobarComplex"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cotor
                %annotation{:encoding => "application/x-tex"} Cotor
            lands in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Γ
                    %mo ¯
                  %mo ≔
                  %mi coker
                  %mo{:stretchy => "false"} (
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{\Gamma} \coloneqq coker(\eta)
            where the generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mrow
                      %mn 0
                      %mo ,
                      %mi n
                  %mo =
                  %msub
                    %mi ξ
                    %mn 0
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} h_{0,n} = \xi_0 = 1
            disappears.
          %p Recall the further abbreviation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi n
                  %mo ≔
                  %msub
                    %mi h
                    %mrow
                      %mn 1
                      %mo ,
                      %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  h_n \coloneqq h_{1,n}
                  \\,.
          %p
            Hence we find using the formula from prop.
            = succeed "," do
              %a.maruku-ref{:href => "#CoproductOnDualSteenrodInTermsOfAdaptedGenerators"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi d
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi h
                            %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≔
                          %msub
                            %mi d
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi h
                            %mrow
                              %mn 1
                              %mo ,
                              %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mover
                            %mi Ψ
                            %mo ¯
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi h
                            %mrow
                              %mn 1
                              %mo ,
                              %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi h
                            %mrow
                              %mn 1
                              %mo ,
                              %mi n
                          %mo ⊗
                          %munder
                            %munder
                              %mrow
                                %msub
                                  %mi h
                                  %mrow
                                    %mn 0
                                    %mo ,
                                    %mi n
                              %mo ⏟
                            %mrow
                              %mo =
                              %mn 0
                          %mo +
                          %munder
                            %munder
                              %mrow
                                %msub
                                  %mi h
                                  %mrow
                                    %mn 0
                                    %mo ,
                                    %mi n
                                    %mo +
                                    %mn 1
                              %mo ⏟
                            %mrow
                              %mo =
                              %mn 0
                          %mo ⊗
                          %msub
                            %mi h
                            %mrow
                              %mn 1
                              %mo ,
                              %mi n
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  d_1(h_n)
                  \&amp; \coloneqq
                  d_1(h_{1,n})
                  \\\
                  \&amp; =
                  \\overline{\Psi}(h_{1,n})
                  \\\
                  \&amp; =
                  h_{1,n} \otimes \underset{= 0}{\underbrace{ h_{0,n} }}
                  +
                  \\underset{= 0}{\underbrace{ h_{0,n+1} }} \otimes h_{1,n}
                  \\\
                  \&amp; =
                  0
                  \\end{aligned}
          %p
            and hence all the elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi n
                %annotation{:encoding => "application/x-tex"} h_n
            are cocycles.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi h
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 0
                  %mo ⊗
                  %munder
                    %munder
                      %mrow
                        %msub
                          %mi h
                          %mrow
                            %mn 0
                            %mo ,
                            %mn 0
                      %mo ⏟
                    %mrow
                      %mo =
                      %mn 0
                  %mo +
                  %msub
                    %mi h
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo ⊗
                  %msub
                    %mi h
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 0
                  %mo +
                  %munder
                    %munder
