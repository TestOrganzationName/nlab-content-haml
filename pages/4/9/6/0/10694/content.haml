          .num_lemma
            %h6#lemma_4 Lemma
            %p
              In the range
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo −
                      %mi s
                      %mo ≤
                      %mn 13
                    %annotation{:encoding => "application/x-tex"} t - s \leq 13
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ext
                      %mrow
                        %msubsup
                          %mi 𝔸
                          %mrow
                            %msub
