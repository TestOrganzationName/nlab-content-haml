          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mrow
                      %mn 3
                      %mo ,
                      %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi h
