                          %mrow
                            %msub
                              %mi 𝔽
                              %mn 2
                          %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext_{\mathcal{A}^\ast_{\mathbb{F}_2}}(\mathbb{F}_2,\mathbb{F}_2)
              is spanned by the items in the following table
            %p
              %img{:src => "http://ncatlab.org/nlab/files/ClassicalAdamsSpectralSequence.jpg", :width => "600"}/
            %p
              (graphics taken from (
              %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"}> Schwede 12
              ))
          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, theorem 3.2.11
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, prop. 5.3.6
          %p
