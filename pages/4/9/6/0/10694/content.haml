            %p
              is an
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ⟶
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Psi \;\colon\; \Gamma \longrightarrow \Gamma \otimes_A \Gamma
              descends to a coproduct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
