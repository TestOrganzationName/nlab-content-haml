              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 4
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi b
                          %mrow
                            %mn 2
                            %mo ,
                            %mn 0
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msubsup
                          %mi h
                          %mn 0
                          %mn 4
                        %msub
                          %mi h
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} d_4(b_{2,0}^2) = h_0^4 h_3
                  \.
          %p
            e.g. (
            %a{:href => "#Ravenel86"}> Ravenel 86, lemma 3.2.8 and lemma 3.2.10
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, lemma 5.3.2 and lemma 5.3.3
          %p Hence this solves the May spectral sequence, hence gives the second page of the classical Adams spectral sequence. Inspection just of the degrees then shows that in this range there is no non-trivial differential in the Adams spectral sequece in this range. This way one arrives at:
          .num_theorem
            %h6#theorem Theorem
            %p
              In low
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo −
                    %mi s
                  %annotation{:encoding => "application/x-tex"} t-s
              the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ext
                      %mrow
