                    {\bot}
                    \\mathcal{D}
            %p
              be a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
