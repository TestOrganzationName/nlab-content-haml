              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              simply picks the component space in degree-0 and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves the component space in degree 0).
          #ExponentialModality.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/exponential+modality"} exponential modality
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
              (see there for more) the
              %a.existingWikiWord{:href => "/nlab/show/exponential+modality"} exponential modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo !
                  %annotation{:encoding => "application/x-tex"} !
              may have
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
              as the
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              induced by a monoidal adjunction.
