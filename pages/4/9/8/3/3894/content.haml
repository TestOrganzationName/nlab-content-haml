                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+structure+groups"} reduction of the structure group
            of the
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p There are many more explicit (and more abstract) equivalent ways to say this, which we discuss below. There are also many evident variants and generalizations.
          %p
            Notably one may consider reductions of the frames in the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            = succeed ")" do
              %a{:href => "#Alekseevskii"} Alekseevskii
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Moreover, the definition makes sense for generalized
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            modeled on other base spaces than just
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            and to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+manifolds"} complex manifolds
          %h3#InTermsOfSubbundlesOfTheFrameBundle In terms of subbundles of the frame bundle
          .num_defn
            %h6#definition_2 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              with
              %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fr
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Fr(X)
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⟶
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G \longrightarrow GL(\mathbb{R}^n)
            %p
              into the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              equipped with an inclusion of
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                          %mtd
                            %mo ↪
                          %mtd
                          %mtd
                            %mi Fr
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P &amp;&amp;\hookrightarrow&amp;&amp; Fr(X)
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; X
                    }
            %p
              which is
              = succeed "-equivariant." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            (
            %a{:href => "#Sternberg64"}> Sternberg 64, section VII, def. 2.1
            ).
          .num_remark
            %h6#remark Remark
            %p
              From this perspective, a
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/frame+field"} frames
              on a manifold. For instance for an
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
              it consists of all those frames which are pointwise an
              %a.existingWikiWord{:href => "/nlab/show/orthonormal+basis"} orthonormal basis
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              (with respect to the
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              which is defined by the orthonormal structure).
          %p Accordingly:
          #GStructureGeneratedByFrameField.num_defn
            %h6#definition_3 Definition
            %p
              Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \hookrightarrow GL(n)
              and given any one
              %a.existingWikiWord{:href => "/nlab/show/frame+field"} frame field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:lspace => "verythinmathspace"} :
