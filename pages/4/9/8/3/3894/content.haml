          %h2#idea Idea
          %p
            A
            %strong G-structure
            on an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/structure+group"} structure group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-subbundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            (of the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            Equivalently, this means that a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+structure+groups"} reduction
            of the canonical structure group
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} GL(n)
            of the
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            to which the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            is
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            along the given inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \hookrightarrow GL(n)
          %p
            More generally, one can consider the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is not a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            but equipped with any group homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \to GL(n)
            %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            one speaks of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lift+of+structure+groups"} lift of structure groups
          %p
            Both cases, in turn, can naturally be understood as special cases of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structures"} twisted differential c-structures
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundles"} principal infinity-bundles
          %p
            In this language, a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em
              in
              %a.existingWikiWord{:href => "/nlab/show/classifying+stacks"} classifying stacks
            (
            %a.existingWikiWord{:href => "/nlab/show/differentiable+stack"} differentiable
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
